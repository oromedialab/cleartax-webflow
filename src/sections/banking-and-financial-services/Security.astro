<style is:global>
  @keyframes rcsecFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ssr-support-dots {
    background-image: radial-gradient(
      var(--palette-lime-500) 1.1px,
      transparent 1.1px
    );
    background-size: 13px 13px;
    opacity: 0.5;
  }

  /* The support diagram's cards/circle sit at fixed % positions inside a
     canvas that scales with the column width (aspect-[858/382], anywhere
     from ~604px to its 858px design width on lg+ screens). Sizing this text
     in cqw instead of px keeps it proportional to the canvas at every width
     it can actually render at. clamp() keeps a legibility floor. */
  .ssr-support-canvas {
    container-type: inline-size;
  }

  .ssr-support-card-title {
    font-size: clamp(9px, 1.4cqw, 12px);
    line-height: clamp(12px, 1.87cqw, 16px);
  }

  .ssr-support-card-desc {
    font-size: clamp(8px, 1.17cqw, 10px);
    line-height: clamp(11px, 1.63cqw, 14px);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .ssr-support-center-heading {
    font-size: clamp(19px, 3.15cqw, 27px);
    line-height: clamp(25px, 4.2cqw, 36px);
  }

  /* Mobile tab bar — sliding-pill pattern */
  .gi-mtab-tab {
    transition: color 0.2s ease;
  }

  .gi-mtab-tab[aria-selected="true"] {
    color: var(--color-nova-blue);
  }

  .gi-mtab-thumb {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 0;
    width: 0;
    border-radius: 8px;
    background-color: var(--color-generic-00);
    box-shadow:
      0 1px 2px 0 rgba(16, 24, 40, 0.04),
      0 1px 2px 0 rgba(16, 24, 40, 0.04);
    opacity: 0;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }

  .gi-mtab-tablist.is-ready .gi-mtab-thumb {
    opacity: 1;
  }

  .gi-mtab-tablist:not(.is-ready) .gi-mtab-tab[aria-selected="true"] {
    background-color: var(--color-generic-00);
    box-shadow:
      0 1px 2px 0 rgba(16, 24, 40, 0.04),
      0 1px 2px 0 rgba(16, 24, 40, 0.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .gi-mtab-thumb {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script is:inline>
  // Desktop (lg+): vertical accordion list driving the shared visual pane.
  (function () {
    const root = document.querySelector("[data-rcsec-root]");
    if (!root) return;
    const items = root.querySelectorAll("[data-rcsec]");
    const graphics = document.querySelectorAll("[data-rcsec-graphic]");
    items.forEach((item) => {
      const header = item.firstElementChild;
      header?.addEventListener("click", () => {
        const key = item.getAttribute("data-rcsec");
        if (item.classList.contains("active")) return;
        items.forEach((i) => i.classList.remove("active"));
        graphics.forEach((g) => g.classList.remove("active"));
        item.classList.add("active");
        document
          .querySelector(`[data-rcsec-graphic="${key}"]`)
          ?.classList.add("active");
      });
    });
  })();

  // Mobile (<lg): sliding-pill tab bar
  (function () {
    const tablists = document.querySelectorAll(".gi-mtab-tablist");
    if (!tablists.length) return;

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    tablists.forEach((tablist) => {
      const tabs = Array.prototype.slice.call(
        tablist.querySelectorAll("[data-gi-mtab]"),
      );
      const thumb = tablist.querySelector(".gi-mtab-thumb");
      const panels = tabs.map((tab) =>
        document.getElementById(
          `gi-mtab-panel-${tab.getAttribute("data-gi-mtab")}`,
        ),
      );
      let activeTab = 0;

      function moveThumb(i, instant) {
        if (!thumb || !tabs[i]) return;
        if (instant) thumb.style.transition = "none";
        thumb.style.width = tabs[i].offsetWidth + "px";
        thumb.style.transform = "translateX(" + tabs[i].offsetLeft + "px)";
        tablist.classList.add("is-ready");
        if (instant) {
          thumb.offsetWidth; // flush the instant position before restoring the transition
          thumb.style.transition = "";
        }
      }

      function selectTab(i) {
        activeTab = i;
        tabs.forEach((tab, n) => {
          tab.setAttribute("aria-selected", n === i ? "true" : "false");
          tab.tabIndex = n === i ? 0 : -1;
          if (panels[n]) panels[n].style.display = n === i ? "block" : "none";
        });
        moveThumb(i);

        if (tablist.scrollWidth > tablist.clientWidth) {
          tablist.scrollTo({
            left:
              tabs[i].offsetLeft -
              (tablist.clientWidth - tabs[i].offsetWidth) / 2,
            behavior: reduceMotion ? "auto" : "smooth",
          });
        }
      }

      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => selectTab(i));
      });

      tablist.addEventListener("keydown", (e) => {
        let next;
        if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        else if (e.key === "ArrowRight") next = (activeTab + 1) % tabs.length;
        else if (e.key === "ArrowLeft")
          next = (activeTab - 1 + tabs.length) % tabs.length;
        else return;

        e.preventDefault();
        selectTab(next);
        tabs[next].focus();
      });

      moveThumb(0, true);
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => moveThumb(activeTab, true));
      }
      window.addEventListener("resize", () => moveThumb(activeTab, true));
    });
  })();
</script>
