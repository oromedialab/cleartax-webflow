---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div class="text-center">
      <h2
        class="text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] mb-12 mt-0 font-medium text-vault-navy font-heading tracking-[-0.5px]"
      >
        Highest levels of security and audit readiness.
      </h2>
    </div>

    <!-- Mobile (<lg): sliding-pill tab bar + single switched panel -->
    <div class="lg:hidden" data-mobile-tabs-root>
      <div
        class="gi-mtab-tablist relative flex w-full max-w-full items-center justify-around gap-1 overflow-x-auto rounded-xl bg-neutral-100 px-1 py-1.5"
        role="tablist"
        aria-label="Security and support by category"
      >
        <span
          class="gi-mtab-thumb pointer-events-none absolute"
          aria-hidden="true"></span>
        {
          mobileTabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`gi-mtab-tab-${t.key}`}
              class="gi-mtab-tab relative z-10 flex-1 min-w-max cursor-pointer whitespace-nowrap rounded-lg border-0 bg-transparent px-3 py-2 text-center font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-neutral-700"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`gi-mtab-panel-${t.key}`}
              tabindex={i === 0 ? 0 : -1}
              data-gi-mtab={t.key}
            >
              {t.label}
            </button>
          ))
        }
      </div>

      <div class="mt-5">
        <!-- Security Panel (active by default) -->
        <div
          id="gi-mtab-panel-security"
          role="tabpanel"
          aria-labelledby="gi-mtab-tab-security"
          data-gi-mtab-panel="security"
        >
          <p
            class="text-[length:var(--fs-body)]! font-normal! text-neutral-500! leading-[length:var(--lh-body)]! m-0! mb-4!"
          >
            Powering Global e-Invoicing Alongside Regulators
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
            {
              securityCards.map((card) => (
