---
/**
 * Pixel-exact flow diagram canvas for SourceOfTruth.astro — see that file's
 * doc comment for the pixel-coordinate provenance and the source-doc mockup
 * screenshots this section was built from. Factored out because the page
 * shows this same skeleton twice (Banking / Insurance), varying the source
 * and billing/tax-doc column content, wire routing, and the ERP GL
 * checklist; the ERP GL hub's fixed chrome (title, subtitle, footer
 * tagline) and the cleartax engine never change, so they live here as fixed
 * markup rather than being threaded through as props.
 *
 * Sized in a fixed CANVAS_W x CANVAS_H pixel space and scaled to fit its
 * container by SourceOfTruth.astro's own script (a uniform CSS
 * `transform: scale()`, not a reflow) — that is what lets every card and
 * connector below keep its literal Figma coordinate instead of being
 * converted to percentages.
 *
 * Ported from manufacturing/FlowCanvas.astro. Unlike that version (5 rows on
 * both tabs), the Insurance tab here has 6 source rows against Banking's 5,
 * so CANVAS_H is sized to the taller (Insurance) tab and the cleartax
 * engine card's height below is derived from CANVAS_H instead of a
 * hardcoded pixel value — see that card's own comment.
 */
export const CANVAS_W = 1239;
/** 1052 — Insurance's 6 stacked 144px source rows (5 plain + 1
 * `directToGL`) set the canvas height; Banking's 5-row tab reuses the same
 * canvas and just leaves the extra vertical room empty below its last card.
 * Gaps are 24px, except 40px directly above the flagged last row (same
 * badge-clearance math as real estate's FlowCanvas — see the badge's own
 * comment lower in this file): Insurance's rows sit at y = 52, 220, 388,
 * 556, 724, 908, so the last row's bottom (908 + 144) sets the canvas
 * height. */
export const CANVAS_H = 1052;

export type Flow = "purple" | "orange" | "green" | "grey";

export interface FlowCard {
  x: number;
  y: number;
  w: number;
  h: number;
  tag: Flow | "grey";
  title: string;
  desc: string;
  /** Shows the small "Direct → GL" note under the title — this source's
   * wire bypasses the middleware column entirely, straight to ERP GL. */
  directToGL?: boolean;
}

type Point = { x: number; y: number };
/**
 * `stage` groups every connector into the animation sequence
 * SourceOfTruth.astro's script plays on scroll-into-view: sources emit ->
 * feed billing -> billing emits -> feeds ERP GL -> ERP GL emits to
 * cleartax. `orange-full` is its own stage because a bypass source skips
 * the billing column entirely in one continuous wire — its tween just runs
 * longer so it lands at ERP GL in step with the other colors (see
 * STAGE_DURATION/ORANGE_STAGES in the script) rather than arriving early.
 */
type Stage = "src-entry" | "bill-exit" | "mid-feed" | "orange-full" | "final";

/** One connector from a source card to its billing/middleware card, or
 * (`stage: "orange-full"`) straight from a source to ERP GL. Each source
 * routes to its own destination point — unlike a shared trunk, this is what
 * lets two same-color sources both reach the same billing card (crossing
 * over a third source's wire in between) instead of every source
 * collapsing onto one merge point that only ever fed a single card.
 *
 * Two ways to describe the bend:
 *  - `from`/`to` (+ optional `turnX`) for a simple one-corner wire that
 *    turns entirely inside the empty gap between two columns (e.g. the
 *    46px gap between the source and middleware columns, or the 50px gap
 *    between the middleware column and ERP GL) — safe at any y since no
 *    card ever sits in that x range. `turnX` defaults to the midpoint, but
 *    is given explicitly (and staggered per wire) wherever two wires of
 *    different colours would otherwise turn at the exact same x and read
 *    as one merged line.
 *  - `points` for a wire that must cross THROUGH a column's x range (a
 *    "Direct → GL" bypass skipping the middleware column entirely) — it
 *    has to duck to a y that's clear of every card's vertical span first
 *    (below the bottom-most card), travel across at that safe y, and only
 *    then turn into its target — a plain from/to/turnX corner would put
 *    part of the wire directly underneath a card, hidden behind it.
 */
export interface FlowWire {
  flow: Flow;
  stage: Stage;
  from?: Point;
  to?: Point;
  turnX?: number;
  points?: Point[];
  /** "h" (default) turns once, horizontally out then vertically into the
   * target. "vh" is for a wire leaving a card's BOTTOM edge (a vertical
   * departure) that turns to arrive horizontally. */
  shape?: "h" | "vh";
}

interface Props {
  id: string;
  active?: boolean;
  /** Both manufacturing tabs use "Sources" (unlike real estate's
   * Sources/Marketplaces split), so this and `sourcesLabelX` just keep the
   * defaults below — kept as props rather than hard-coded only because
   * FlowCanvas.astro is shared scaffolding across sections. */
  sourcesLabel?: string;
  sourcesLabelX?: number;
  /** "BILLING // TAX-DOC" (Sell side & Dispatch) or "MOVEMENT // TAX-DOC"
   * (Procurement, Transfers & Group) — unlike real estate's fixed
   * "MIDDLEWARE", manufacturing's middleware column is labelled per tab. */
  middlewareLabel?: string;
  /** ERP GL's 5-item checklist — differs per tab (e.g. "Import VAT and
   * deferment" only applies to the procurement tab), so it's a prop here
   * instead of the fixed array real estate's version hard-coded. */
  erpChecklist?: string[];
  sourceCards: FlowCard[];
  billingCards: FlowCard[];
  wires: FlowWire[];
}

/* Defaults matter here beyond convenience: embed-build/[page]/[section].astro
   renders every .astro file in this folder standalone with no props at all
   (including primitives like this one — see docs/adding-a-new-page.md,
   "Props never reach Webflow"), so every array prop must default to
   something `.map`-able or that route's build crashes outright. */
const {
  id = "",
  active = false,
  sourcesLabel = "Sources",
  sourcesLabelX = 106,
  middlewareLabel = "Middleware",
  erpChecklist = [],
  sourceCards = [],
  billingCards = [],
  wires = [],
} = Astro.props;

const FLOW_COLOR: Record<FlowCard["tag"], string> = {
  purple: "bg-nova-blue",
  orange: "bg-warning-500",
  green: "bg-success-500",
  grey: "bg-neutral-500",
};

const receives = [
  { tag: "purple" as const, label: "Output VAT / GST" },
  { tag: "orange" as const, label: "Reverse charge" },
  { tag: "green" as const, label: "Input VAT • GL" },
];

/**
 * Connectors render as SVG, not absolutely-positioned `border-dashed`
 * <span>s — a CSS border is pixel-snapped for crispness, which is
 * inconsistent under this canvas's non-1:1 `transform: scale()`.
 *
 * The draw-in animation (SourceOfTruth.astro's script) does NOT use the
 * usual stroke-dasharray/dashoffset-through-a-<mask> technique for
 * revealing a dashed line progressively. Found by isolated repro: this
 * site applies `zoom: var(--page-zoom)` to `<body>` for 768–1439px
 * viewports (shared.css, for the 1280px-design-on-a-1280px-laptop problem),
 * and Chrome has a rendering bug where an SVG `<mask>` renders as only a
 * sliver near each masked line's endpoints whenever `zoom` is active
 * anywhere up the ancestor chain — with or without an additional
 * `transform: scale()` in the mix. Since `zoom` can't be turned off for
 * this one section, masking an SVG line/path here is never safe. Instead,
 * the script animates the actual geometry: a straight line's `x2`/`y2`
 * attributes grow from its `x1`/`y1`, and a bent wire's `d` is rebuilt every
 * frame from a length-truncated copy of its point list (`data-points`
 * below, walked by `roundedPolylineJS` in the script).
 *
 * Every `wires` entry becomes one bent 3-point wire (source -> corner ->
 * target), rounded at the corner via `roundedPolyline` so it gets an actual
 * 4px radius, not just `stroke-linejoin`'s subtle (~half-stroke-width)
 * round.
 */
const CORNER_RADIUS = 4;

/** A wire's midpoint corner: for a right-edge exit ("h"), the corner sits
 * halfway between source and target x, at the source's own y — a clean
 * "out, then turn, then in" L-bend. For a bottom-edge exit ("vh"), the
 * corner sits directly below the source at the target's y, then runs
 * straight across. */
function wirePoints(w: FlowWire): Point[] {
  if (w.points) return w.points;
  const { from, to } = w as { from: Point; to: Point };
  if (w.shape === "vh") {
    return [from, { x: from.x, y: to.y }, to];
  }
  const turnX = w.turnX ?? (from.x + to.x) / 2;
  return [from, { x: turnX, y: from.y }, { x: turnX, y: to.y }, to];
}

/** Builds an SVG path `d` for a polyline with each interior corner rounded
 * to `r` (clamped to half the shorter of its two adjacent segments, so a
 * short segment never gets a radius bigger than itself). Mirrored in plain
 * JS as `roundedPolylineJS` in SourceOfTruth.astro's script, which redraws
 * this same shape frame-by-frame from a shortening point list. */
function roundedPolyline(points: Point[], r: number): string {
  if (points.length < 2) return "";
  let d = `M ${points[0].x} ${points[0].y}`;
  for (let i = 1; i < points.length - 1; i++) {
    const prev = points[i - 1];
    const curr = points[i];
    const next = points[i + 1];
    const inLen = Math.hypot(curr.x - prev.x, curr.y - prev.y);
    const outLen = Math.hypot(next.x - curr.x, next.y - curr.y);
    const radius = Math.min(r, inLen / 2, outLen / 2);
    const inX = curr.x + ((prev.x - curr.x) / inLen) * radius;
    const inY = curr.y + ((prev.y - curr.y) / inLen) * radius;
    const outX = curr.x + ((next.x - curr.x) / outLen) * radius;
    const outY = curr.y + ((next.y - curr.y) / outLen) * radius;
    d += ` L ${inX} ${inY} Q ${curr.x} ${curr.y} ${outX} ${outY}`;
  }
  const last = points[points.length - 1];
  d += ` L ${last.x} ${last.y}`;
  return d;
}

const erpLeft = 668;
const erpRight = erpLeft + 275;

/** ERP GL -> the three RECEIVES rows on the cleartax card. */
const finalLines: { flow: Flow; x1: number; y1: number; x2: number; y2: number }[] = [
  { flow: "purple", x1: erpRight, y1: 348, x2: 991, y2: 348 },
  { flow: "orange", x1: erpRight, y1: 372, x2: 991, y2: 372 },
];

/** Billing output -> up -> right into the middleware feed / cleartax top. */
const midFeedPoints: Point[] = [
  { x: 619, y: 259 },
  { x: 643, y: 259 },
  { x: 643, y: 90 },
  { x: 991, y: 90 },
];

const FLOW_HEX: Record<Flow, string> = {
  purple: "#5446FF",
  orange: "#F59E0B",
  green: "#10B981",
  grey: "#4B5563"
};

const bentWires = wires.map((w) => ({ ...w, points: wirePoints(w) }));
---

<div class:list={["sot-canvas absolute inset-0", !active && "hidden"]} style={`width:${CANVAS_W}px;height:${CANVAS_H}px;`} data-sot-panel={id}>
  <p
    class="absolute top-[16px] m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)] tracking-[1px] uppercase whitespace-nowrap"
    style={`left:${sourcesLabelX}px;`}
  >
    {sourcesLabel}
  </p>
  <p class="absolute left-[401px] top-[184px] m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)] tracking-[1px] uppercase whitespace-nowrap">
    {middlewareLabel}
  </p>
  <p class="absolute left-[775px] top-[184px] m-0 font-body font-medium text-nova-blue text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
    ERP · GL
  </p>

  <!-- Connectors, drawn under the cards. data-sot-line + data-stage are the
       hooks the fit-to-width script's GSAP draw-in animation targets;
       data-shape tells it whether to grow x2/y2 (a line) or rebuild `d`
       from data-points (a bent wire) — see the doc comment above. -->
  <svg class="absolute inset-0 pointer-events-none" width={CANVAS_W} height={CANVAS_H} viewBox={`0 0 ${CANVAS_W} ${CANVAS_H}`} aria-hidden="true">
    {
      finalLines.map((seg) => (
        <line
          x1={seg.x1}
          y1={seg.y1}
          x2={seg.x2}
          y2={seg.y2}
          stroke={FLOW_HEX[seg.flow]}
          stroke-width="2"
          stroke-dasharray="6 5"
          stroke-linecap="round"
          data-flow={seg.flow}
          data-stage="final"
          data-shape="line"
          data-sot-line
        />
      ))
    }
    <path
      d={roundedPolyline(midFeedPoints, CORNER_RADIUS)}
      fill="none"
      stroke={FLOW_HEX.grey}
      stroke-width="2"
      stroke-dasharray="6 5"
      stroke-linecap="round"
      data-flow="grey"
      data-stage="mid-feed"
      data-shape="path"
      data-points={midFeedPoints.map((p) => `${p.x},${p.y}`).join(" ")}
      data-radius={CORNER_RADIUS}
      data-sot-line
    />
    {
      bentWires.map((w) => (
        <path
          d={roundedPolyline(w.points, CORNER_RADIUS)}
          fill="none"
          stroke={FLOW_HEX[w.flow]}
          stroke-width="2"
          stroke-dasharray="6 5"
          stroke-linecap="round"
          data-flow={w.flow}
          data-stage={w.stage}
          data-shape="path"
          data-points={w.points.map((p) => `${p.x},${p.y}`).join(" ")}
          data-radius={CORNER_RADIUS}
          data-sot-line
        />
      ))
    }
  </svg>

  <!-- Source cards -->
  {
    sourceCards.map((c) => (
      <div
        class="absolute flex gap-4 rounded-xl border border-neutral-200 bg-generic-00 p-6"
        style={`left:${c.x}px;top:${c.y}px;width:${c.w}px;height:${c.h}px;`}
      >
        <span class={`w-1 shrink-0 rounded-lg ${FLOW_COLOR[c.tag]}`} />
        <div class="flex flex-col gap-2">
          <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">{c.title}</p>
          <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)] whitespace-pre-line">{c.desc}</p>
        </div>
      </div>
    ))
  }

  <!-- "Direct → GL" tags: a floating 105x28 label above each flagged
       card's top edge, not a line item stacked inside its body. Rendered as
       its own pass (after the cards, so it sits on top) rather than inline
       in the card's flex column. The 144px-tall card above a flagged card
       sits a 40px gap away (not the usual 24px — see each tab's source
       array in SourceOfTruth.astro, which only widens the specific gap a
       badge falls in), so `c.y - 32` (28px badge + 4px margin below) clears
       its own card by 4px and the card above by a roomier 8px (40 - 28 - 4). -->
  {
    sourceCards
      .filter((c) => c.directToGL)
      .map((c) => (
        <span
          class="absolute flex items-center justify-center rounded-md border border-neutral-200 bg-generic-00 font-body text-[10px] font-medium uppercase tracking-[0.5px] text-neutral-500"
          style={`left:${c.x + 24}px;top:${c.y - 32}px;width:105px;height:28px;`}
        >
          Direct → GL
        </span>
      ))
  }

  <!-- Billing / tax-doc cards -->
  {
    billingCards.map((c) => (
      <div
        class="absolute flex gap-4 rounded-xl border border-neutral-200 bg-generic-00 p-6"
        style={`left:${c.x}px;top:${c.y}px;width:${c.w}px;height:${c.h}px;`}
      >
        <span class={`w-1 shrink-0 rounded-lg ${FLOW_COLOR[c.tag]}`} />
        <div class="flex flex-col gap-2">
          <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">{c.title}</p>
          <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)] whitespace-pre-line">{c.desc}</p>
        </div>
      </div>
    ))
  }

  <!-- Middleware badge. Its dashed border is an SVG rect (not a CSS
       `border-dashed`) so the dash length/gap and stroke width are
       identical to the connector lines' — a CSS border-dashed can't be
       tuned to match an SVG stroke-dasharray pixel for pixel. -->
  <div class="absolute flex items-center justify-center bg-generic-00 px-3" style="left:665px;top:69px;width:278px;height:40px;">
    <svg class="absolute inset-0" width="278" height="40" viewBox="0 0 278 40" aria-hidden="true">
      <rect x="1" y="1" width="276" height="38" rx="12" fill="none" stroke={FLOW_HEX.grey} stroke-width="2" stroke-dasharray="6 5" stroke-linecap="round" />
    </svg>
    <p class="relative m-0 font-body font-medium text-neutral-600 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] whitespace-nowrap">
      Middleware · feed as required
    </p>
  </div>

  <!-- ERP GL card -->
  <div class="absolute flex gap-4 rounded-lg border border-neutral-200 bg-generic-00 p-6" style="left:668px;top:220px;width:275px;">
    <span class="w-1 shrink-0 rounded-lg bg-nova-blue" />
    <div class="flex flex-col gap-3 flex-1">
      <div class="flex flex-col gap-2">
        <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">ERP GL</p>
        <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)]">SAP S/4HANA • Oracle Financials</p>
      </div>
      <ul class="m-0 flex flex-col gap-2 list-none p-0">
        {erpChecklist.map((item) => (
          <li class="flex items-center gap-2 font-body text-neutral-500 text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)]">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0" aria-hidden="true">
              <circle cx="8" cy="8" r="8" fill="#5446FF" />
              <path d="M4.5 8.2 6.8 10.5 11.5 5.5" stroke="white" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {item}
          </li>
        ))}
      </ul>
      <div class="h-px w-full bg-neutral-200" />
      <p class="m-0 font-body font-medium text-nova-blue text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)]">
        THE CONSTANT NODE · EVERY TXN SETTLES HERE
      </p>
    </div>
  </div>

  <!-- cleartax engine card. height is CANVAS_H - 52 (its own top offset) so
       it stays flush with the canvas bottom, same as each tab's last source
       row — see CANVAS_H's own comment for why that's 1052. Derived rather
       than hardcoded (manufacturing's version hardcodes 832) because
       Banking's 5-row tab and Insurance's 6-row tab share one canvas. -->
  <div class="absolute flex flex-col gap-6 justify-between rounded-lg border-2 border-neutral-400 bg-generic-00 p-6" style={`left:991px;top:52px;width:248px;height:${CANVAS_H - 52}px;`}>
    <div class="flex flex-col gap-3">
      <p class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">cleartax</p>
      <p class="m-0 font-body font-semibold text-nova-blue text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">multi-mandate engine</p>
      <div class="h-px w-full bg-neutral-200" />
    </div>
    <div class="flex flex-col gap-4">
      <div class="h-px w-full bg-neutral-200" />
      <div class="flex flex-col gap-1">
        <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)]">Single source of tax truth</p>
        <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)]">
          - Audit-proof<br />- Reconciled<br />- Archived
        </p>
      </div>
    </div>
    <!-- Positioned absolutely (not in the title/footer flex flow) so the
         middle row lands on the middle "final" connector stub above (y=372)
         — a flex `justify-between` with only 2 siblings above/below doesn't
         reproduce that whenever their heights differ (the footer block here
         runs taller than the title block, so naive centering lands this
         block ~45px too high). top is
         tuned empirically against the rendered row pitch (~32px), which
         runs a little looser than the 24px pitch the connectors assume, so
         the top/bottom rows land ~8px off their stubs while the middle row
         (and the lines' visual center of mass) lines up exactly. -->
    <div class="absolute flex flex-col gap-4" style="left:24px;top:240px;width:200px;">
      <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] tracking-[1px] uppercase">Receives</p>
      <ul class="m-0 flex flex-col gap-3 list-none p-0">
        {receives.map((r) => (
          <li class="flex items-center gap-2 font-body text-neutral-500 text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)]">
            <span class={`h-4 w-4 shrink-0 rounded-xs ${FLOW_COLOR[r.tag]}`} />
            {r.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
