---
/**
 * "BFSI invoicing is more than just connecting your ERP." Banking and
 * Financial Services variant of manufacturing/ExistingSystems.astro — same
 * three-category card layout, re-skinned for core banking / insurance
 * systems. None of these vendors have a hosted Webflow logo asset yet, so
 * every badge falls back to the neutral monogram swatch (same fallback
 * pattern manufacturing's version uses for plant/warehouse vendors without
 * art).
 */
interface Logo {
  name: string;
  src?: string;
}

interface Category {
  title: string;
  desc: string;
  logos: Logo[];
}

const categories: Category[] = [
  {
    title: "Core banking",
    desc: "Where millions of fees originate.",
    logos: [
      {
        name: "Finacle",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58f98ab3e0aafa57bedf_infosys.png",
      },
      {
        name: "Temenos",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59d0cd3f0f0be94c7f16_temenos.png",
      },
      {
        name: "Oracle FLEXCUBE",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594b2872eeb6348efacd_oracle-fusion.png",
      },
      {
        name: "Finastra",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58d1d8936e10e5138d3c_finastara.png",
      },
      {
        name: "BaNCS",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59cc1172d09e55319cb8_tcs.png",
      },
    ],
  },
  {
    title: "Policy systems",
    desc: "Where premiums and claims live.",
    logos: [
      {
        name: "Guidewire",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58e0427628a740fbc273_guidewire.png",
      },
      {
        name: "Duck Creek",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58bed8936e10e5137a9d_duck.png",
      },
      {
        name: "Sapiens",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59c3427628a740fc913d_sapiens.png",
      },
      {
        name: "Fineos",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58ccbf105356f0ac4e64_fin.png",
      },
      {
        name: "Oracle OIPA",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594b2872eeb6348efacd_oracle-fusion.png",
      },
    ],
  },
  {
    title: "Enterprise ERPs",
    desc: "Where group financials consolidate.",
    logos: [
      {
        name: "SAP S/4HANA",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59be2ddedbf4b5615765_sap.png",
      },
      {
        name: "SAP ECC",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59be2ddedbf4b5615765_sap.png",
      },
      {
        name: "Oracle EBS",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594b2872eeb6348efacd_oracle-fusion.png",
      },
      {
        name: "Oracle Financials",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594b2872eeb6348efacd_oracle-fusion.png",
      },
      {
        name: "MS Dynamics 365",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594489cb38a8fe58819d_ms.png",
      },
    ],
  },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div class="flex flex-col gap-12">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-left text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        BFSI invoicing is more than just connecting your ERP.
      </h2>

      <div
        class="grid grid-cols-1 lg:grid-cols-3 rounded-xl border border-neutral-200 divide-y divide-neutral-200 lg:divide-y-0 lg:divide-x"
      >
        {
          categories.map((cat) => (
            <div class="flex flex-col gap-12 p-6">
              <div class="flex flex-col gap-2">
                <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                  {cat.title}
                </p>
                <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                  {cat.desc}
                </p>
              </div>
              <div class="flex flex-wrap gap-2">
                {cat.logos.map((logo) => (
                  <span class="inline-flex items-center gap-x-3 gap-y-2 rounded-lg border border-neutral-200 px-3 py-1.5">
                    {logo.src ? (
                      <img
                        src={logo.src}
                        alt=""
                        class="max-h-6 w-full object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span
                        class="h-6 w-6 shrink-0 rounded-md bg-neutral-200"
                        aria-hidden="true"
                      />
                    )}
                    <span class="font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] whitespace-nowrap">
                      {logo.name}
                    </span>
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
