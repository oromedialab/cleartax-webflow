---
/**
 * "Solving the complexity of global finance." Banking and Financial
 * Services variant of manufacturing/GlobalTrade.astro's sticky scroll-jack
 * card track — same mechanism (see that file's doc comment for the shared
 * pattern across `_shared/UnderneathMandate.astro` /
 * `uae-regional/Network.astro` / `direct-tax-page/Filing.astro`),
 * re-skinned with the six BFSI edge cases from the source doc. Each card's
 * `trade-card-img` slot stays a placeholder, same as manufacturing — the
 * source doc's mockup screenshots (word/media/image1-5.png) are illustrative
 * UI, not hosted Webflow assets to paste in yet.
 */
interface TradeCard {
  icon: string;
  title: string;
  text: string;
}

const cards: TradeCard[] = [
  {
    icon: "/images/retail-consumer/glob-1.png",
    title: "Clear merchant fees at settlement speed",
    text: "Settlement files from your switch. Compliant invoices out in real time, fee categories intact per merchant.",
  },
  {
    icon: "/images/retail-consumer/glob-2.png",
    title: "Separate exempt income from taxable, at source",
    text: "Interest and FX spreads carry the exempt category and each market's reason code. Fees carry the standard rate. Split at SKU level.",
  },
  {
    icon: "/images/retail-consumer/glob-3.png",
    title: "Invoice millions of micro-fees without breaking the gateway",
    text: "ATM, SMS, swipe and transfer fees aggregate by customer and period. Line-level lineage survives inside every summary.",
  },
  {
    icon: "/images/retail-consumer/glob-4.png",
    title: "Tax the margin, not the sale price",
    text: "Repossessed assets sell under the margin scheme. Tax computes on the margin; the gross price still prints on the invoice.",
  },
  {
    icon: "/images/retail-consumer/glob-5.png",
    title: "Keep the bank and the insurer legally distinct",
    text: "Separate Peppol endpoints and isolated signing keys per entity, on one platform.",
  },
  {
    icon: "/images/retail-consumer/glob-6.png",
    title: "Validate every recipient before you send",
    text: "Peppol IDs bulk-scanned against the national registry. Live status flows back to your CRM.",
  },
];
---

<div class="trade-sticky-container">
  <section
    class="sticky top-0 flex flex-col justify-center bg-generic-00 border-t border-neutral-200 py-16 lg:py-20 overflow-hidden min-h-[calc(100vh-80px)]"
  >
    <div
      class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6 flex flex-col gap-12"
    >
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        Solving the complexity of global finance.
      </h2>

      <div class="flex flex-col gap-12">
        <div class="w-full h-auto">
          <div
            class="trade-track relative flex items-start gap-12 w-max transition-transform duration-[250ms] ease-out will-change-transform"
            data-trade-track
          >
            {
              cards.map((card, index) => (
                <div
                  class={`trade-card flex flex-col shrink-0 w-[85vw] sm:w-[480px] lg:w-[560px] max-sm:h-[340px] md:h-[310px] lg:h-[330px] rounded-xl border border-neutral-200 bg-generic-00 p-5 lg:p-6 select-none ${index === 0 ? "is-reached" : ""}`}
                >
                  <img
                    src={card.icon}
                    alt=""
                    width="64"
                    height="64"
                    class="w-16 h-16 shrink-0 object-contain pointer-events-none mb-6"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="flex flex-col max-w-[422px] pointer-events-none">
                    <p class="trade-card-title m-0 font-heading font-medium text-text-default text-xl lg:text-[24px] leading-[1.33] tracking-[-0.5px] mb-3 lg:mb-4">
                      {card.title}
                    </p>
                    <p class="trade-card-desc m-0 font-body text-[#6B7280] text-base lg:text-lg leading-normal">
                      {card.text}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="relative h-2 w-full rounded-lg bg-neutral-300 overflow-hidden"
          aria-hidden="true"
        >
          <div
            class="trade-progress-fill absolute inset-y-0 left-0 rounded-lg bg-nova-blue"
            data-trade-fill
          >
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    const initTradeScroll = () => {
      const containers = document.querySelectorAll(".trade-sticky-container");
      if (!containers.length) return;

      containers.forEach((container) => {
        const track = container.querySelector("[data-trade-track]");
        const section = container.querySelector("section");
        const fill = container.querySelector("[data-trade-fill]");
        if (!track || !section) return;

        const cards = track.querySelectorAll(".trade-card");

        const getHeaderHeight = () => {
          const header = document.querySelector("header, .navbar, .w-nav");
          return header ? header.offsetHeight : 80;
        };

        let maxTranslate = 0;
        let totalScrollable = 0;
        let stickyTop = 0;
        let cardOffsets = [];
        let totalTrackWidth = 0;

        const updateMeasurements = () => {
          const sectionHeight = section.offsetHeight;
          const windowHeight = window.innerHeight;
          const headerHeight = getHeaderHeight();

          const trackOffset =
            track.parentElement.getBoundingClientRect().top -
            section.getBoundingClientRect().top;
          const trackHeight = track.offsetHeight;
          const availableSpace = windowHeight - headerHeight;

          const idealTrackTop =
            headerHeight + Math.max(40, (availableSpace - trackHeight) / 2);
          const calculatedTop = idealTrackTop - trackOffset;

          // Position section flush under header when sticky, avoiding gap on large screens
          stickyTop = Math.min(headerHeight, calculatedTop);
          section.style.top = `${stickyTop}px`;

          const containerWidth =
            track.parentElement.getBoundingClientRect().width;
          maxTranslate = Math.max(0, track.scrollWidth - containerWidth);
          container.style.height = `${maxTranslate + windowHeight}px`;
          totalScrollable =
            container.getBoundingClientRect().height - sectionHeight;

          totalTrackWidth = track.scrollWidth;
          cardOffsets = Array.from(cards).map((c) => c.offsetLeft);
        };

        updateMeasurements();

        if (window.ResizeObserver) {
          const ro = new ResizeObserver(updateMeasurements);
          ro.observe(section);
          ro.observe(track);
        }
        window.addEventListener("resize", updateMeasurements);

        let ticking = false;

        const handleScroll = () => {
          if (ticking) return;
          window.requestAnimationFrame(() => {
            const containerRect = container.getBoundingClientRect();
            const scrolledDistance = Math.max(0, stickyTop - containerRect.top);

            let progress =
              totalScrollable > 0 ? scrolledDistance / totalScrollable : 0;
            progress = Math.max(0, Math.min(1, progress));

            track.style.transform = `translate3d(-${progress * maxTranslate}px, 0, 0)`;

            if (fill) {
              fill.style.width = `${progress * 100}%`;
            }

            if (cards.length && totalTrackWidth > 0) {
              const currentFilledDistance = progress * totalTrackWidth;
              cards.forEach((cardEl, i) => {
                if (i === 0) {
                  cardEl.classList.add("is-reached");
                  return;
                }
                const isReached =
                  currentFilledDistance >= (cardOffsets[i] || 0) - 2;
                cardEl.classList.toggle("is-reached", isReached);
              });
            }

            ticking = false;
          });
          ticking = true;
        };

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                window.addEventListener("scroll", handleScroll, {
                  passive: true,
                });
                handleScroll();
              } else {
                window.removeEventListener("scroll", handleScroll);
              }
            });
          },
          { rootMargin: "100% 0px 100% 0px" },
        );

        observer.observe(container);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTradeScroll);
    } else {
      initTradeScroll();
    }
  })();
</script>

<style is:global>
  .trade-card-title,
  .trade-card-desc {
    transition: opacity 300ms ease;
  }
  .trade-card:not(.is-reached) .trade-card-title,
  .trade-card:not(.is-reached) .trade-card-desc {
    opacity: 0.4;
  }
  .trade-card.is-reached .trade-card-title,
  .trade-card.is-reached .trade-card-desc {
    opacity: 1;
  }
</style>
