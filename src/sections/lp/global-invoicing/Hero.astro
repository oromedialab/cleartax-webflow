---
/**
 * LP hero — same bordered two-column card as the industry pages
 * (banking-and-financial-services/Hero.astro), with a HubSpot form where
 * those pages show an illustration.
 *
 * The form field and skeleton styles are a copy of those in
 * `_shared/ContactFormRb.astro`, which this page does not include.
 */
import Dotgrid from "../../_shared/Dotgrid.astro";

const videoId = "UX0Yt61EdfY";
const hubspotPortalId = "245744706";
const hubspotFormId = "55f43bf6-8819-4682-bf0c-83036044d4b1";
const hubspotRegion = "na2";

const logos: { src: string; alt: string }[] = [
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc5fd373e2872bd820152_brand-1-img.png", alt: "Schneider Electric logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc6046e7426adbd019ed6_brand-2-img.png", alt: "Acer logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc60a6c38dc1440e954cd_brand-3-img.png", alt: "3M logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc6116c38dc1440e9643c_brand-4-img.png", alt: "Coca-Cola logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc61609b3bd73c0f39c81_brand-5-img.png", alt: "Hitachi logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc61c3ca1726d5e2aa651_brand-6-img.png", alt: "Volvo logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc623c06d0a708d98acf5_brand-7-img.png", alt: "Standard Chartered logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc628ad92208b0c0d0bcf_brand-8-img.png", alt: "Abbott logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc62fe6176c452e670d85_brand-9-img.png", alt: "Carlsberg Group logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc63571c2777eb595fc0a_brand-10-img.png", alt: "IKEA logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc63b994e6f0061916071_brand-11-img.png", alt: "L'Oréal logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc6410183fdb4f4d5dc99_brand-12-img.png", alt: "Lufthansa logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc646a365fcbc02c11af3_brand-13-img.png", alt: "Bosch logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc64da365fcbc02c11de4_brand-14-img.png", alt: "Honda logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc654a4df647a7bb2f894_brand-15-img.png", alt: "Adidas logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc65af3eec20e67f5cd1c_brand-16-img.png", alt: "Hilton logo" },
  { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc661da8cceda23ec5615_brand-17-img.png", alt: "Dolce & Gabbana logo" },
];
const marqueeLogos = [...logos, ...logos];
---

<section
  id="hero"
  class="relative bg-generic-00 overflow-hidden pt-32 pb-16 lg:pt-[calc(var(--nav-clear)+32px)] lg:pb-20"
  data-video-id={videoId}
>
  <Dotgrid containerId="hero" baseColor="#C8F006" />

  <div
    class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"
  >
  </div>

  <div class="container relative z-10">
    <div
      class="relative overflow-hidden rounded-2xl border border-neutral-200 bg-generic-00 p-6 sm:p-8 lg:p-12"
    >
      <div
        class="relative flex flex-col lg:grid lg:grid-cols-2 gap-6 sm:gap-8 lg:gap-12 items-center"
      >
        <!-- Left column (unwrapped via max-lg:contents on mobile for re-ordering) -->
        <div class="flex flex-col gap-8 max-lg:contents">
          <div class="order-1 flex flex-col items-start gap-3.5 sm:gap-4 lg:gap-6">
            <h1
              class="m-0 font-heading font-semibold text-vault-navy text-[34px] lg:text-[length:var(--fs-display-lg)] leading-[1.17] lg:leading-[length:var(--lh-display-lg)] tracking-[-0.6px] lg:tracking-[-1px]"
            >
              E-Invoicing <span class="bg-flux-lime px-1 rounded-lg">Compliance</span> Today. Tax Assurance Tomorrow.
            </h1>
            <p
              class="m-0 font-body text-vault-navy text-[15px] sm:text-base lg:text-[length:var(--fs-body-lg)] leading-relaxed lg:leading-[length:var(--lh-body-lg)]"
            >
              ClearTax helps you do more than meet the e-invoicing deadline. We prepare you for a future of automated tax scrutiny and always-on global compliance.
            </p>
            <button
              type="button"
              data-video-open
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3.5 font-body rounded-lg font-medium text-nova-blue text-[length:var(--fs-body)] leading-[length:var(--lh-body)] cursor-pointer bg-transparent border border-nova-blue hover:bg-nova-50 transition-colors duration-150"
            >
              Watch Video
              <svg width="13" height="14" viewBox="0 0 13 14" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.75 1.69079C0.75 0.977723 1.5145 0.525696 2.1393 0.869336L11.7565 6.15877C12.4041 6.51495 12.4041 7.44549 11.7565 7.80167L2.1393 13.0911C1.5145 13.4347 0.75 12.9827 0.75 12.2697V1.69079Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>

          <!-- Trusted by (below the form on mobile) -->
          <div class="order-3 flex flex-col gap-3.5 sm:gap-4 pt-5 sm:pt-6 border-t border-neutral-200 w-full">
            <div class="flex flex-col gap-3 sm:gap-3.5 lg:flex-row lg:items-center lg:gap-6">
              <span
                class="shrink-0 font-heading font-medium text-vault-navy text-sm sm:text-base lg:font-body lg:text-[length:var(--fs-body)] lg:leading-[length:var(--lh-body)] lg:text-neutral-500"
              >
                Trusted by
              </span>
              <div class="gi-hero-marquee relative w-full overflow-hidden">
                <div class="gi-hero-marquee-track flex items-center gap-2 w-max motion-reduce:animate-none">
                  {
                    marqueeLogos.map((logo, i) => (
                      <span class="flex h-12 w-[104px] sm:w-[124px] shrink-0 items-center justify-center rounded-lg bg-neutral-100">
                        <img
                          src={logo.src}
                          alt={logo.alt}
                          aria-hidden={i >= logos.length}
                          class="h-[26px] w-[80px] sm:w-[86px] object-contain mix-blend-multiply"
                          loading="lazy"
                          decoding="async"
                        />
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- HubSpot form (second on mobile, right column on desktop) -->
        <div class="order-2 w-full min-w-0">
          <div
            id="gi-hero-form"
            data-lead-form
            class="gi-hero-form giwip-hs-form-wrap"
            data-portal-id={hubspotPortalId}
            data-form-id={hubspotFormId}
            data-region={hubspotRegion}
          >
            <div class="form-skeleton" data-form-skeleton>
              {[0, 1, 2, 3].map(() => (
                <div>
                  <div class="skeleton-label shimmer"></div>
                  <div class="skeleton-input shimmer"></div>
                </div>
              ))}
              <div class="skeleton-button shimmer"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Video Modal -->
    <div
        class="fixed inset-0 z-2000 hidden items-center justify-center bg-black/70 backdrop-blur-sm p-4"
        data-video-modal
        aria-hidden="true"
    >
        <div class="relative w-full max-w-4xl">
            <div class="relative w-full aspect-video bg-black rounded-xl overflow-hidden shadow-2xl">
                <div
                    class="absolute inset-0 [&_iframe]:absolute [&_iframe]:inset-0 [&_iframe]:w-full [&_iframe]:h-full [&_iframe]:border-0"
                    data-video-wrap
                >
                </div>
            </div>
            <button
                type="button"
                data-video-close
                aria-label="Close video"
                class="absolute -top-12 right-0 z-10 inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors cursor-pointer border-0"
            >
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13 1L1 13M1 1L13 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </button>
        </div>
    </div>
</section>

<script is:inline>
  // Watch Video modal logic
  (function () {
    const section = document.getElementById('hero');
    if (!section) return;
    const videoId = section.getAttribute('data-video-id') || 'UX0Yt61EdfY';
    const modal = section.querySelector('[data-video-modal]');
    const wrap = modal ? modal.querySelector('[data-video-wrap]') : null;
    const openBtns = section.querySelectorAll('[data-video-open]');
    const closeBtn = modal ? modal.querySelector('[data-video-close]') : null;

    function openModal() {
      if (!modal || !wrap) return;
      if (!wrap.innerHTML.trim()) {
        const iframe = document.createElement('iframe');
        const origin = window.location.origin;
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&enablejsapi=1&origin=${encodeURIComponent(origin)}`;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        wrap.appendChild(iframe);
      }
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal || !wrap) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.setAttribute('aria-hidden', 'true');
      wrap.innerHTML = '';
      document.body.style.overflow = '';
    }

    openBtns.forEach((btn) => btn.addEventListener('click', openModal));
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  })();

  // HubSpot form, with UTM prefill from the URL
  (function () {
    var mount = document.getElementById('gi-hero-form');
    if (!mount) return;
    var created = false;

    function createForm() {
      if (created || !window.hbspt || !window.hbspt.forms) return;
      created = true;
      window.hbspt.forms.create({
        portalId: mount.getAttribute('data-portal-id'),
        formId: mount.getAttribute('data-form-id'),
        region: mount.getAttribute('data-region'),
        target: '#gi-hero-form',
        onFormReady: function ($form) {
          var skeleton = mount.querySelector('[data-form-skeleton]');
          if (skeleton) skeleton.remove();

          var form = $form && $form[0] ? $form[0] : $form;
          if (!form || !form.querySelector) return;
          var params = new URLSearchParams(window.location.search);
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function (utm) {
            var value = params.get(utm);
            var input = form.querySelector('input[name="' + utm + '"]');
            if (value && input) input.value = value;
          });
        },
      });
    }

    if (window.hbspt && window.hbspt.forms) {
      createForm();
      return;
    }

    // Load the embed script ourselves if the page head doesn't already.
    var loader = document.querySelector('script[src*="hsforms.net"]');
    if (!loader) {
      loader = document.createElement('script');
      loader.src = 'https://js-na2.hsforms.net/forms/embed/v2.js';
      document.head.appendChild(loader);
    }
    loader.addEventListener('load', createForm);

    // Covers a loader that finished before the listener was attached.
    var polls = 0;
    var timer = setInterval(function () {
      polls++;
      if (created || polls > 100) return clearInterval(timer);
      createForm();
    }, 100);
  })();
</script>

<style is:global>
  .gi-hero-marquee {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%);
  }

  .gi-hero-marquee-track {
    animation: gi-hero-marquee-scroll 40s linear infinite;
  }

  .gi-hero-marquee:hover .gi-hero-marquee-track {
    animation-play-state: paused;
  }

  @keyframes gi-hero-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .giwip-hs-form-wrap {
    width: 100%;
    min-height: 260px;
  }
  .giwip-hs-form-wrap form {
    display: flex !important;
    flex-direction: column !important;
    gap: 20px !important;
  }
  .giwip-hs-form-wrap .hs-form-field {
    margin-bottom: 0 !important;
  }
  .giwip-hs-form-wrap .hs-form-field > label {
    display: block !important;
    font-size: var(--fs-body-sm) !important;
    line-height: var(--lh-body-sm) !important;
    font-weight: 500 !important;
    color: var(--color-vault-navy) !important;
    margin-bottom: 8px !important;
  }
  .giwip-hs-form-wrap .hs-form-field > label .hs-form-required {
    color: var(--palette-destructive-500) !important;
    margin-left: 2px !important;
  }
  .giwip-hs-form-wrap input[type="text"],
  .giwip-hs-form-wrap input[type="email"],
  .giwip-hs-form-wrap input[type="tel"],
  .giwip-hs-form-wrap input[type="number"],
  .giwip-hs-form-wrap select,
  .giwip-hs-form-wrap textarea {
    width: 100% !important;
    border-radius: 8px !important;
    border: 1px solid var(--palette-neutral-200) !important;
    background-color: #ffffff !important;
    background: #ffffff !important;
    padding: 8px 12px !important;
    height: 40px !important;
    font-size: var(--fs-body-sm) !important;
    line-height: var(--lh-body-sm) !important;
    color: var(--color-vault-navy) !important;
    outline: none !important;
    transition: all 0.2s ease !important;
    box-sizing: border-box !important;
    box-shadow: 0 1px 1px rgba(16, 24, 40, 0.04) !important;
  }
  .giwip-hs-form-wrap input::placeholder,
  .giwip-hs-form-wrap textarea::placeholder {
    color: #9ca3af !important;
  }
  .giwip-hs-form-wrap input:focus,
  .giwip-hs-form-wrap select:focus,
  .giwip-hs-form-wrap textarea:focus {
    border-color: var(--color-nova-blue) !important;
    box-shadow: 0 0 0 3px rgba(84, 70, 255, 0.12) !important;
  }
  .giwip-hs-form-wrap textarea {
    min-height: 80px !important;
    height: auto !important;
    resize: vertical !important;
  }
  .giwip-hs-form-wrap select {
    -webkit-appearance: none !important;
    appearance: none !important;
    background-color: #ffffff !important;
    background: #ffffff !important;
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%234B5563' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") !important;
    background-repeat: no-repeat !important;
    background-position: right 12px center !important;
    background-size: 10px 6px !important;
    padding-right: 28px !important;
  }
  .giwip-hs-form-wrap fieldset {
    max-width: none !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: row !important;
    gap: 20px !important;
  }
  @media (max-width: 640px) {
    .giwip-hs-form-wrap fieldset {
      flex-direction: column !important;
      gap: 20px !important;
    }
  }
  .giwip-hs-form-wrap fieldset .hs-form-field {
    flex: 1 !important;
  }
  /* Ensure phone fieldset and wrapper span 100% full width */
  .giwip-hs-form-wrap fieldset:has(.hs_phone),
  .giwip-hs-form-wrap fieldset:has([class*="hs-fieldtype-intl-phone"]),
  .giwip-hs-form-wrap fieldset:has(input[type="tel"]) {
    width: 100% !important;
    max-width: 100% !important;
  }
  .giwip-hs-form-wrap fieldset:has(.hs_phone) .hs_phone,
  .giwip-hs-form-wrap
    fieldset:has([class*="hs-fieldtype-intl-phone"])
    .hs-form-field:has(.hs-fieldtype-intl-phone),
  .giwip-hs-form-wrap
    fieldset:has(input[type="tel"])
    .hs-form-field:has(input[type="tel"]),
  .giwip-hs-form-wrap .hs_phone,
  .giwip-hs-form-wrap .hs-form-field:has(.hs-fieldtype-intl-phone),
  .giwip-hs-form-wrap .hs-form-field:has(input[type="tel"]) {
    width: 100% !important;
    max-width: 100% !important;
    flex: 1 1 100% !important;
  }

  /* Hide empty or hidden-only form fields so they don't consume column space */
  .giwip-hs-form-wrap .hs-form-field:empty,
  .giwip-hs-form-wrap .hs-form-field:has(input[type="hidden"]:only-child) {
    display: none !important;
  }

  .giwip-hs-form-wrap .hs_phone .input,
  .giwip-hs-form-wrap .hs-form-field:has(input[type="tel"]) .input {
    width: 100% !important;
    max-width: 100% !important;
    margin-right: 0 !important;
  }

  /* Phone input flex layout: country dropdown + phone number input */
  .giwip-hs-form-wrap fieldset.form-columns-1 .hs-fieldtype-intl-phone.hs-input,
  .giwip-hs-form-wrap fieldset.form-columns-1 .hs-fieldtype-intl-phone,
  .giwip-hs-form-wrap .hs-fieldtype-intl-phone.hs-input,
  .giwip-hs-form-wrap .hs-fieldtype-intl-phone,
  .giwip-hs-form-wrap .hs_phone .input > .hs-input:has(select) {
    display: flex !important;
    flex-direction: row !important;
    gap: 8px !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    background: transparent !important;
    height: auto !important;
    box-shadow: none !important;
    box-sizing: border-box !important;
    align-items: center !important;
  }
  .giwip-hs-form-wrap .hs-fieldtype-intl-phone select,
  .giwip-hs-form-wrap .hs_phone select {
    width: 135px !important;
    min-width: 100px !important;
    max-width: 38% !important;
    flex-shrink: 0 !important;
    -webkit-appearance: none !important;
    appearance: none !important;
    background-color: #ffffff !important;
    background: #ffffff !important;
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%234B5563' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") !important;
    background-repeat: no-repeat !important;
    background-position: right 10px center !important;
    background-size: 10px 6px !important;
    padding-right: 26px !important;
    cursor: pointer !important;
  }
  .giwip-hs-form-wrap .hs-fieldtype-intl-phone input[type="tel"],
  .giwip-hs-form-wrap .hs-fieldtype-intl-phone input,
  .giwip-hs-form-wrap .hs_phone input[type="tel"],
  .giwip-hs-form-wrap input[type="tel"] {
    flex: 1 1 auto !important;
    width: 100% !important;
    min-width: 0 !important;
  }
  .giwip-hs-form-wrap .hs-form-booleancheckbox label,
  .giwip-hs-form-wrap .legal-consent-container label {
