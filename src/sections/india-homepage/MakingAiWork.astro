                            d="M5.22425 0.600025L5.22426 13.4M0.424255 5.40002L5.22425 0.600025L10.0243 5.40002"
                            stroke="white"
                            stroke-width="1.2"
                            stroke-linejoin="round"></path>
                        </svg>
                      </button>
                    </div>
                  </div>

                  <!-- Floating Cursor for Frame 1 & 2 -->
                  <div
                    class="ih-maiw-cursor pointer-events-none absolute z-30 opacity-0 top-0 left-0"
                  >
                    <img
                      src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab26584bc5572adf499e114_marker.png"
                      alt=""
                      width="24"
                      height="24"
                      loading="lazy"
                      decoding="async"
                      class="w-6 h-6 object-contain"
                    />
                  </div>
