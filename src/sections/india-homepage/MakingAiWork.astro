<style is:global>
  [data-ih-maiw-overlay-card][hidden] {
    display: none !important;
  }

  [data-ih-maiw-image][hidden] {
    display: none !important;
  }

  .ih-maiw-chart.is-revealed,
  .ih-maiw-result-heading.is-revealed {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }

  .ih-maiw-input-pill {
    width: 100%;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .ih-maiw-chart img {
    width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .ih-maiw-bubble {
    right: 3rem !important; /* leaves clean space for cancel SVG in top-right */
  }

  @media (min-width: 768px) {
    .ih-maiw-bubble {
      right: 3.5rem !important;
    }
  }

  .ih-maiw-tab {
    transition: color 0.2s ease;
  }

  .ih-maiw-tab[aria-selected="true"] {
    color: var(--color-nova-blue);
  }

  /* The moving pill. Sliding one element beats cross-fading three backgrounds:
     the highlight reads as travelling to the team you picked. */
  .ih-maiw-thumb {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 0;
    width: 0;
    border-radius: 8px;
    background-color: var(--color-generic-00);
    box-shadow:
      0 1px 2px 0 rgba(16, 24, 40, 0.04),
      0 1px 2px 0 rgba(16, 24, 40, 0.04);
    opacity: 0;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }

  .ih-maiw-tablist.is-ready .ih-maiw-thumb {
    opacity: 1;
  }

  /* No JS, no thumb — so the current pill paints its own background instead.
     Suppressed the moment JS marks the bar ready, or the two would double up. */
  .ih-maiw-tablist:not(.is-ready) .ih-maiw-tab[aria-selected="true"] {
    background-color: var(--color-generic-00);
    box-shadow:
      0 1px 2px 0 rgba(16, 24, 40, 0.04),
      0 1px 2px 0 rgba(16, 24, 40, 0.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .ih-maiw-thumb {
      transition: opacity 0.2s ease;
    }
  }

  /* ===================================================================
   * PER-CARD OVERLAY STYLES
   * =================================================================
   * Each card overlay now has its own JSX block above:
   *   {i === 0 ? (...) : i === 1 ? (...) : ...}
   *
   * And each card has its own layout class:
   *   .ih-maiw-layout-0 (CFO Dashboard)
   *   .ih-maiw-layout-1 (Tax Governance)
   *   .ih-maiw-layout-2 (Audit and Advisory)
   *   .ih-maiw-layout-3 (Notice Dashboard)
   *   .ih-maiw-layout-4 (Litigation)
   *   .ih-maiw-layout-5 (Refund)
   *   .ih-maiw-layout-6 (180-Day Reversal)
   *   .ih-maiw-layout-7 (ERP Writeback)
   *   .ih-maiw-layout-8 (RCM & Ineligible)
   *   .ih-maiw-layout-9 (Advance Adjustment)
   *
   * You can change HTML structure directly in the {i === ?} conditions
   * above, and/or add specific CSS here.
   * ================================================================= */
</style>

<script is:inline>
  /* Pills filter the grid; a card opens the detail overlay, and the chevrons
     walk that card's own team without closing. */
  (function () {
    var tablist = document.querySelector(".ih-maiw-tablist");
    var overlay = document.getElementById("ih-maiw-overlay");
    if (!tablist || !overlay) return;

    var reduceMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ---- pills ---- */

    var tabs = Array.prototype.slice.call(
      tablist.querySelectorAll("[data-ih-maiw-tab]"),
    );
    var thumb = tablist.querySelector(".ih-maiw-thumb");
    var panels = tabs.map(function (tab) {
      return document.getElementById(
        "ih-maiw-panel-" + tab.getAttribute("data-ih-maiw-tab"),
      );
    });
    var activeTab = 0;

    function moveThumb(i) {
      if (!thumb) return;
      thumb.style.width = tabs[i].offsetWidth + "px";
      thumb.style.transform = "translateX(" + tabs[i].offsetLeft + "px)";
      tablist.classList.add("is-ready");
    }

    // Inline display, not a class swap: the utilities pasted into Webflow are
    // unlayered, so `grid` and a hiding class on one element would race on
    // source order. Inline always wins, and it is the same state the server
    // rendered, so nothing shifts on hydration.
    function selectTab(i) {
      activeTab = i;
      tabs.forEach(function (tab, n) {
        tab.setAttribute("aria-selected", n === i ? "true" : "false");
        tab.tabIndex = n === i ? 0 : -1;
        if (panels[n]) panels[n].style.display = n === i ? "grid" : "none";
      });
      moveThumb(i);

      // Narrow viewports scroll the bar rather than wrapping it, so a pill
      // chosen by keyboard could otherwise sit off-screen.
      if (tablist.scrollWidth > tablist.clientWidth) {
        tablist.scrollTo({
          left:
            tabs[i].offsetLeft -
            (tablist.clientWidth - tabs[i].offsetWidth) / 2,
          behavior: reduceMotion ? "auto" : "smooth",
        });
      }
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener("click", function () {
        selectTab(i);
      });
    });

    // Roving tabindex: `role="tablist"` promises arrow keys move between tabs
    // and Tab leaves the group entirely.
    tablist.addEventListener("keydown", function (e) {
      var next;
      if (e.key === "Home") next = 0;
      else if (e.key === "End") next = tabs.length - 1;
      else if (e.key === "ArrowRight") next = (activeTab + 1) % tabs.length;
      else if (e.key === "ArrowLeft")
        next = (activeTab - 1 + tabs.length) % tabs.length;
      else return;

      e.preventDefault();
      selectTab(next);
      tabs[next].focus();
    });

    moveThumb(0);
    // The bar can be laid out before its webfont arrives, which changes every
    // pill's width — remeasure rather than leave the thumb on stale geometry.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function () {
        moveThumb(activeTab);
      });
    }
    window.addEventListener("resize", function () {
      moveThumb(activeTab);
    });

    /* ---- detail overlay ---- */

    var panel = overlay.querySelector("[data-ih-maiw-panel-detail]");
    var overlayCards = overlay.querySelectorAll("[data-ih-maiw-overlay-card]");
    var closeBtn = overlay.querySelector("[data-ih-maiw-close]");
    if (!panel || !overlayCards.length) return;

    var count = overlayCards.length;
    var current = 0;
    var lastFocused = null;

    /* ---- stage animation logic ---- */
    var currentTl = null;
    var activeUpdatePillPath = null;

    function loadGsap(cb) {
      if (typeof window.gsap !== "undefined") {
        cb();
        return;
      }
      var s = document.createElement("script");
      s.src = "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js";
      s.onload = cb;
      document.head.appendChild(s);
    }

    function isOpen() {
      return overlay.style.display === "flex";
    }

    function resetCardStage(card) {
      if (!card) return;
      var stage = card.querySelector(".ih-maiw-stage-wrap");
      if (!stage) return;

      var glow = stage.querySelector(".ih-maiw-glow");
      var glowBottom = stage.querySelector(".ih-maiw-glow-bottom");
      var centerTitle = stage.querySelector(".ih-maiw-center-title");
      var bubble = stage.querySelector(".ih-maiw-bubble");
      var skeleton = stage.querySelector(".ih-maiw-skeleton");
      var checklist = stage.querySelector(".ih-maiw-checklist");
      var checkItems = stage.querySelectorAll(".ih-maiw-check-item");
      var chart = stage.querySelector(".ih-maiw-chart");
      var resultHeading = stage.querySelector(".ih-maiw-result-heading");
      var inputPill = stage.querySelector(".ih-maiw-input-pill");
      var pillPlaceholder = stage.querySelector(".ih-maiw-pill-placeholder");
      var pillTyped = stage.querySelector(".ih-maiw-pill-typed");
      var pillTypedText = stage.querySelector(".ih-maiw-pill-typed-text");
      var pillThinking = stage.querySelector(".ih-maiw-pill-thinking");
      var cursor = stage.querySelector(".ih-maiw-cursor");
      var borderPath = stage.querySelector(".ih-maiw-pill-border-path");
      var submitBtn = stage.querySelector(".ih-maiw-submit-btn");

      if (submitBtn) {
        submitBtn.style.transform = "none";
      }
      if (chart) {
        chart.classList.remove("is-revealed");
        chart.classList.add("hidden");
        chart.style.display = "none";
        chart.style.opacity = "0";
        chart.style.pointerEvents = "none";
        chart.style.transform = "none";
      }
      if (resultHeading) {
        resultHeading.classList.remove("is-revealed");
        resultHeading.classList.add("hidden");
        resultHeading.style.display = "none";
        resultHeading.style.opacity = "0";
        resultHeading.style.pointerEvents = "none";
        resultHeading.style.transform = "none";
      }
      if (glow) glow.style.opacity = "1";
      if (glowBottom) glowBottom.style.opacity = "0";
      if (centerTitle) {
        centerTitle.style.opacity = "1";
        centerTitle.style.transform = "none";
      }
      if (bubble) {
        bubble.classList.add("hidden");
        bubble.style.display = "none";
        bubble.style.opacity = "0";
        bubble.style.transform = "none";
      }
      if (skeleton) {
        skeleton.classList.add("hidden");
        skeleton.style.display = "none";
        skeleton.style.opacity = "0";
      }
      if (checklist) {
        checklist.classList.add("hidden");
        checklist.style.display = "none";
        checklist.style.opacity = "0";
      }
      if (checkItems) {
        checkItems.forEach(function (item) {
          item.style.opacity = "0";
          item.style.transform = "none";
        });
      }
      if (pillPlaceholder) {
        var initialPh = pillPlaceholder.getAttribute("data-initial-placeholder") || "Ask anything";
        pillPlaceholder.textContent = initialPh;
        pillPlaceholder.style.display = "flex";
        pillPlaceholder.style.opacity = "1";
      }
      if (pillTyped) {
        pillTyped.style.display = "none";
        pillTyped.style.opacity = "0";
      }
      if (pillTypedText) {
        pillTypedText.textContent = "";
      }
      if (pillThinking) {
        pillThinking.style.display = "none";
        pillThinking.style.opacity = "0";
        var resetStatusSpan = pillThinking.querySelector(".ih-maiw-pill-status-text") || pillThinking.querySelector("span:first-child");
        var initialStatus = pillThinking.getAttribute("data-status-1") || (resetStatusSpan ? resetStatusSpan.textContent : "Reading files");
        if (resetStatusSpan) resetStatusSpan.textContent = initialStatus;
      }
      if (cursor) {
        cursor.style.opacity = "0";
        cursor.style.transform = "none";
      }
      if (borderPath) {
        borderPath.style.opacity = "0";
      }
      if (inputPill) {
        inputPill.style.transform = "none";
        inputPill.style.maxWidth = "480px";
      }
    }

    function playAnimation(index) {
      if (currentTl) {
        currentTl.kill();
        currentTl = null;
      }

      var activeCard = overlayCards[index];
      // Only start animation if this card is currently active, overlay is open, and card is not hidden
      if (!activeCard || activeCard.hidden || !isOpen()) return;

      var stage = activeCard.querySelector(".ih-maiw-stage-wrap");
      if (!stage) return;

      // Cleanly reset this active card's elements before building the animation
      resetCardStage(activeCard);

      var glow = stage.querySelector(".ih-maiw-glow");
      var glowBottom = stage.querySelector(".ih-maiw-glow-bottom");
      var centerTitle = stage.querySelector(".ih-maiw-center-title");
      var bubble = stage.querySelector(".ih-maiw-bubble");
      var bubbleText = stage.querySelector(".ih-maiw-bubble-text");
      var skeleton = stage.querySelector(".ih-maiw-skeleton");
      var checklist = stage.querySelector(".ih-maiw-checklist");
      var checkItems = stage.querySelectorAll(".ih-maiw-check-item");
      var chart = stage.querySelector(".ih-maiw-chart");
      var resultHeading = stage.querySelector(".ih-maiw-result-heading");
      var inputPill = stage.querySelector(".ih-maiw-input-pill");
      var pillPlaceholder = stage.querySelector(".ih-maiw-pill-placeholder");
      var pillTyped = stage.querySelector(".ih-maiw-pill-typed");
      var pillTypedText = stage.querySelector(".ih-maiw-pill-typed-text");
      var pillThinking = stage.querySelector(".ih-maiw-pill-thinking");
      var pillStatusText = pillThinking ? (pillThinking.querySelector(".ih-maiw-pill-status-text") || pillThinking.querySelector("span:first-child")) : null;
      var status1 = pillThinking ? (pillThinking.getAttribute("data-status-1") || (pillStatusText ? pillStatusText.textContent : "Reading files")) : "Reading files";
      var status2 = pillThinking ? (pillThinking.getAttribute("data-status-2") || "Analyzing") : "Analyzing";
      var initialPh = pillPlaceholder ? (pillPlaceholder.getAttribute("data-initial-placeholder") || "Ask anything") : "Ask anything";
      var finalPh = pillPlaceholder ? (pillPlaceholder.getAttribute("data-final-placeholder") || initialPh) : initialPh;
      var submitBtn = stage.querySelector(".ih-maiw-submit-btn");
      var cursor = stage.querySelector(".ih-maiw-cursor");
      var borderPath = stage.querySelector(".ih-maiw-pill-border-path");

      // Skip animation on clicking stage
      stage.onclick = function () {
        if (currentTl && currentTl.isActive()) {
          currentTl.seek(currentTl.duration());
          if (inputPill) inputPill.style.maxWidth = "100%";
          if (pillPlaceholder) pillPlaceholder.textContent = finalPh;
          updatePillPath();
        }
      };

      // If this card is not an interactive animation stage, reveal its chart/image immediately
      if (!inputPill || !cursor || !chart) {
        if (chart) {
          chart.classList.remove("hidden");
          chart.classList.add("is-revealed");
          chart.style.display = "flex";
          chart.style.opacity = "1";
        }
        if (resultHeading) {
          resultHeading.classList.remove("hidden");
          resultHeading.classList.add("is-revealed");
          resultHeading.style.display = "flex";
          resultHeading.style.opacity = "1";
        }
        if (inputPill) {
          inputPill.style.maxWidth = "100%";
        }
        return;
      }

      function calcCenterOffset() {
        var sRect = stage.getBoundingClientRect();
        var pRect = inputPill.getBoundingClientRect();
        var stageH = stage.offsetHeight || sRect.height || 420;
        var pillH = inputPill.offsetHeight || pRect.height || 48;
        var pillTop = pRect.top - sRect.top;
        if (!pillTop || pillTop <= 0 || pillTop < stageH * 0.5) {
          pillTop = stageH - pillH - 24;
        }
        var targetCenter = stageH * 0.53 - pillH / 2;
        return targetCenter - pillTop;
      }

      function updatePillPath() {
        if (!borderPath || !inputPill) return 0;
        var w = inputPill.offsetWidth - 2;
        var h = inputPill.offsetHeight - 2;
        var r = h / 2;
        var x0 = 1;
        var y0 = 1;
        var d =
          "M " +
          x0 +
          " " +
          (y0 + r) +
          " A " +
          r +
          " " +
          r +
          " 0 0 1 " +
          (x0 + r) +
          " " +
          y0 +
          " H " +
          (x0 + w - r) +
          " A " +
          r +
          " " +
          r +
          " 0 0 1 " +
          (x0 + w) +
          " " +
          (y0 + r) +
          " A " +
          r +
          " " +
          r +
          " 0 0 1 " +
          (x0 + w - r) +
          " " +
          (y0 + h) +
          " H " +
          (x0 + r) +
          " A " +
          r +
          " " +
          r +
          " 0 0 1 " +
          x0 +
          " " +
          (y0 + r) +
          " Z";
        borderPath.setAttribute("d", d);
        var len = 0;
        try {
          len = borderPath.getTotalLength();
        } catch (e) {}
        if (!len || len <= 0) {
          len = 2 * (w - h) + Math.PI * h;
        }
        return len;
      }
      activeUpdatePillPath = updatePillPath;

      function getPillPos() {
        var cRect = stage.getBoundingClientRect();
        var pRect = inputPill.getBoundingClientRect();
        var scaleX = cRect.width / (stage.offsetWidth || 1) || 1;
        var scaleY = cRect.height / (stage.offsetHeight || 1) || 1;
        return {
          x:
            (pRect.left - cRect.left) / scaleX -
            (stage.clientLeft || 0) +
            (pRect.width / scaleX) * 0.38,
          y:
            (pRect.top - cRect.top) / scaleY -
            (stage.clientTop || 0) +
            (pRect.height / scaleY) * 0.58,
        };
      }

      function getSubmitBtnPos() {
        if (!submitBtn) return { x: 0, y: 0 };
        var cRect = stage.getBoundingClientRect();
        var bRect = submitBtn.getBoundingClientRect();
        var scaleX = cRect.width / (stage.offsetWidth || 1) || 1;
        var scaleY = cRect.height / (stage.offsetHeight || 1) || 1;
        return {
          x:
            (bRect.left - cRect.left) / scaleX -
            (stage.clientLeft || 0) +
            (bRect.width / scaleX) * 0.5,
          y:
            (bRect.top - cRect.top) / scaleY -
            (stage.clientTop || 0) +
            (bRect.height / scaleY) * 0.58,
        };
      }

      var sentQuery =
        (bubbleText && (bubbleText.getAttribute("data-query") || bubbleText.textContent.trim())) ||
        (stage && stage.getAttribute("data-query")) ||
        "Generate monthly CFO summary and variance analysis";

      var typedQuery =
        (pillTypedText && (pillTypedText.getAttribute("data-typed-query") || pillTypedText.textContent.trim())) ||
        (stage && stage.getAttribute("data-typed-query")) ||
        sentQuery;

      if (bubbleText) {
        if (!bubbleText.getAttribute("data-query")) bubbleText.setAttribute("data-query", sentQuery);
        bubbleText.textContent = sentQuery;
      }
      if (pillTypedText) {
        if (!pillTypedText.getAttribute("data-typed-query")) pillTypedText.setAttribute("data-typed-query", typedQuery);
        pillTypedText.textContent = "";
      }

      if (reduceMotion) {
        if (chart) {
          chart.classList.remove("hidden");
          chart.classList.add("is-revealed");
          chart.style.display = "flex";
          chart.style.opacity = "1";
        }
        if (resultHeading) {
          resultHeading.classList.remove("hidden");
          resultHeading.classList.add("is-revealed");
          resultHeading.style.display = "flex";
          resultHeading.style.opacity = "1";
        }
        if (centerTitle) centerTitle.style.opacity = "0";
        if (glow) glow.style.opacity = "0";
        if (glowBottom) glowBottom.style.opacity = "1";
        if (bubble) bubble.style.display = "none";
        if (skeleton) skeleton.style.display = "none";
        if (checklist) checklist.style.display = "none";
        if (pillPlaceholder) {
          pillPlaceholder.textContent = finalPh;
          pillPlaceholder.style.display = "flex";
          pillPlaceholder.style.opacity = "1";
        }
        if (pillTyped) pillTyped.style.display = "none";
        if (pillThinking) pillThinking.style.display = "none";
        if (inputPill) {
          inputPill.style.transform = "none";
          inputPill.style.maxWidth = "100%";
        }
        updatePillPath();
        return;
      }

      var gsap = window.gsap;
      if (!gsap) {
        loadGsap(function () {
          playAnimation(index);
        });
        return;
      }

      var centerOffset = calcCenterOffset();

      // Measure coordinates at docked bottom position (maxWidth 100%, y 0)
      inputPill.style.maxWidth = "100%";
      inputPill.style.transform = "none";
      var bottomPillPos = getPillPos();
      var bottomSubmitPos = getSubmitBtnPos();

      // Reset to centered position for Frame 1
      inputPill.style.maxWidth = "480px";
      inputPill.style.transform = "translateY(" + centerOffset + "px)";
      var centerPillPos = getPillPos();

      var tl = gsap.timeline({
        defaults: { ease: "power2.inOut" },
      });
      currentTl = tl;

      // Initial Frame 1 state
      var hideElements = [chart, bubble, skeleton, checklist, resultHeading].filter(Boolean);
      if (hideElements.length) tl.set(hideElements, { display: "none" });
      if (chart) {
        chart.classList.remove("is-revealed");
        chart.classList.add("hidden");
        tl.set(chart, { opacity: 0, y: 10, display: "none", pointerEvents: "none" });
      }
      if (resultHeading) {
        resultHeading.classList.remove("is-revealed");
        resultHeading.classList.add("hidden");
        tl.set(resultHeading, { opacity: 0, y: 6, display: "none", pointerEvents: "none" });
      }
      if (bubble) tl.set(bubble, { opacity: 0, scale: 0.9, y: 8, pointerEvents: "none" });
      if (skeleton) tl.set(skeleton, { opacity: 0, pointerEvents: "none" });
      if (checklist) tl.set(checklist, { opacity: 0, pointerEvents: "none" });
      if (checkItems && checkItems.length) tl.set(checkItems, { opacity: 0, x: -10 });
      if (borderPath) tl.set(borderPath, { opacity: 0 });

      if (glow) tl.set(glow, { opacity: 1 });
      if (glowBottom) tl.set(glowBottom, { opacity: 0 });
      if (centerTitle) tl.set(centerTitle, { opacity: 1, y: 0 });
      tl.set(inputPill, {
        maxWidth: 480,
        y: function () {
          return centerOffset;
        },
      });
      if (pillPlaceholder) tl.set(pillPlaceholder, { display: "flex", opacity: 1 });
      if (pillTyped) tl.set(pillTyped, { display: "none", opacity: 0 });
      if (pillThinking) tl.set(pillThinking, { display: "none", opacity: 0 });
      if (cursor) {
        tl.set(cursor, {
          opacity: 0,
          x: function () {
            return stage.offsetWidth * 0.65;
          },
          y: function () {
            return stage.offsetHeight * 0.65;
          },
          scale: 1,
          transformOrigin: "0% 0%",
        });
      }

      // Frame 1: Cursor appears & moves to pill at center
      if (cursor) {
        tl.to(cursor, { opacity: 1, duration: 0.35 }, "+=0.2");
        tl.to(
          cursor,
          {
            x: centerPillPos.x,
            y: centerPillPos.y,
            duration: 0.7,
            ease: "power2.out",
          },
          "-=0.1",
        );
        // Cursor clicks pill at center
        tl.to(cursor, { scale: 0.85, duration: 0.12, yoyo: true, repeat: 1 });
      }

      // Pill drops down: center title and center glow fade out, bottom ambient glow fades in
      if (centerTitle) {
        tl.to(
          centerTitle,
          { opacity: 0, y: -10, duration: 0.45, ease: "power2.in" },
          "+=0.08",
        );
      }
      if (glow) tl.to(glow, { opacity: 0, duration: 0.45 }, "<");
      if (glowBottom) {
        tl.to(
          glowBottom,
          { opacity: 1, duration: 0.6, ease: "power2.out" },
          "<",
        );
      }
      tl.to(
        inputPill,
        {
          y: 0,
          maxWidth: "100%",
          duration: 0.6,
          ease: "power3.inOut",
          onUpdate: updatePillPath,
        },
        "<",
      );
      if (cursor) {
        tl.to(
          cursor,
          {
            x: bottomPillPos.x,
            y: bottomPillPos.y,
            duration: 0.6,
            ease: "power3.inOut",
          },
          "<",
        );
      }

      // Frame 2: Once pill is below, placeholder fades and prompt writes in
      if (pillTyped) tl.set(pillTyped, { display: "flex" });
      if (pillPlaceholder) {
        tl.to(pillPlaceholder, { opacity: 0, duration: 0.15 }, "+=0.05");
        tl.set(pillPlaceholder, { display: "none" });
      }
      if (pillTyped) tl.to(pillTyped, { opacity: 1, duration: 0.15 }, "<");

      var typingObj = { charIndex: 0 };
      tl.to(
        typingObj,
        {
          charIndex: typedQuery.length,
          duration: 0.9,
          ease: "none",
          onUpdate: function () {
            if (pillTypedText) {
              pillTypedText.textContent = typedQuery.slice(
                0,
                Math.round(typingObj.charIndex),
              );
            }
          },
        },
        "<+=0.1",
      );

      // Frame 3: Cursor moves to submit arrow button at the bottom (glide & tactile click from WhyGenericAi)
      if (cursor && submitBtn) {
        tl.to(
          cursor,
          {
            x: function () {
              return getSubmitBtnPos().x;
            },
            y: function () {
              return getSubmitBtnPos().y;
            },
            duration: 0.7,
            ease: "power2.inOut",
          },
          "+=0.25",
        );
        // Click submit button (tactile press down & spring release)
        tl.to(cursor, { scale: 0.8, duration: 0.09, ease: "power2.in" }, "+=0.2");
        tl.to(submitBtn, { scale: 0.78, duration: 0.09, ease: "power2.in" }, "<");
        tl.to(cursor, { scale: 1, duration: 0.14, ease: "power2.out" });
        tl.to(submitBtn, { scale: 1, duration: 0.16, ease: "back.out(2.5)" }, "<");
        tl.to(cursor, { opacity: 0, duration: 0.25 }, "+=0.15");
      }

      // BORDER LOADER: Draws 1 full round
      if (borderPath) {
        tl.add(function () {
          var borderLen = updatePillPath();
          gsap.set(borderPath, {
            strokeDasharray: borderLen,
            strokeDashoffset: borderLen,
            opacity: 1,
          });
        });
        tl.addLabel("borderStart");
        tl.to(
          borderPath,
          {
            strokeDashoffset: 0,
            duration: 1.3,
            ease: "power1.inOut",
          },
          "borderStart",
        );
        tl.to(borderPath, { opacity: 0, duration: 0.2 }, "borderStart+=1.3");
      } else {
        tl.addLabel("borderStart");
      }

      // Reveal message bubble, skeleton, and switch pill to Thinking
      tl.addLabel("revealPoint", "borderStart+=0.4");
      if (bubble) tl.set(bubble, { display: "block" }, "revealPoint");
      if (skeleton) tl.set(skeleton, { display: "flex" }, "revealPoint");
      if (pillTyped) tl.to(pillTyped, { opacity: 0, duration: 0.12 }, "revealPoint");
      var toHide = [pillTyped, pillPlaceholder].filter(Boolean);
      if (toHide.length) tl.set(toHide, { display: "none" }, "revealPoint+=0.12");
      if (pillThinking) {
        tl.add(function () {
          if (pillStatusText) pillStatusText.textContent = status1;
        }, "revealPoint+=0.12");
        tl.set(pillThinking, { display: "flex" }, "revealPoint+=0.12");
        tl.to(pillThinking, { opacity: 1, duration: 0.12 }, "revealPoint+=0.12");
      }
      if (bubble) {
        tl.to(
          bubble,
          { opacity: 1, y: 0, scale: 1, duration: 0.28, ease: "back.out(1.5)" },
          "revealPoint",
        );
      }
      if (skeleton) {
        tl.to(
          skeleton,
          { opacity: 1, y: 0, duration: 0.18, ease: "power2.out" },
          "revealPoint",
        );
      }

      // Frame 4: Skeleton holds, then checklist appears & status transitions to status 2
      if (skeleton) {
        tl.to(skeleton, { opacity: 0, duration: 0.25 }, "revealPoint+=1.8");
        tl.set(skeleton, { display: "none" });
      }
      if (pillThinking && pillStatusText) {
        tl.to(pillThinking, { opacity: 0, duration: 0.15 }, "revealPoint+=1.8");
        tl.add(function () {
          if (pillStatusText) pillStatusText.textContent = status2;
        }, "revealPoint+=1.95");
        tl.to(pillThinking, { opacity: 1, duration: 0.15 }, "revealPoint+=1.95");
      }
      if (checklist) {
        tl.set(checklist, { display: "flex", opacity: 1 }, "revealPoint+=2.0");
        if (checkItems && checkItems.length) {
          tl.to(
            checkItems,
            {
              opacity: 1,
              x: 0,
              duration: 0.25,
              stagger: 0.15,
              ease: "power2.out",
            },
            "-=0.05",
          );
        }
      }

      // Hold on checklist (1.8s)
      tl.to({}, { duration: 1.8 });

      // Frame 5: Bubble & checklist exit, Chart image fades/slides in
      var exitGroup = [bubble, checklist].filter(Boolean);
      if (exitGroup.length) {
        tl.to(exitGroup, {
          opacity: 0,
          y: -10,
          duration: 0.35,
          ease: "power2.in",
        });
        tl.set(exitGroup, {
          display: "none",
          opacity: 0,
          pointerEvents: "none",
        });
      }

      if (chart) {
        tl.add(function () {
          chart.classList.remove("hidden");
          chart.classList.add("is-revealed");
        });
        tl.set(chart, { display: "flex" });
      }

      if (resultHeading) {
        tl.add(function () {
          resultHeading.classList.remove("hidden");
          resultHeading.classList.add("is-revealed");
        });
        tl.set(resultHeading, { display: "flex" });
      }

      if (pillThinking) {
        tl.to(pillThinking, { opacity: 0, duration: 0.2 }, "<");
        tl.set(pillThinking, { display: "none" });
      }
      if (pillTyped) tl.set(pillTyped, { display: "none", opacity: 0 });
      if (pillPlaceholder) {
        tl.add(function () {
          if (pillPlaceholder) pillPlaceholder.textContent = finalPh;
        }, "<");
        tl.set(pillPlaceholder, { display: "flex" });
        tl.to(pillPlaceholder, { opacity: 1, duration: 0.25 }, "<+=0.1");
      }
      tl.add(function () {
        if (pillTypedText) pillTypedText.textContent = "";
      });

      if (resultHeading) {
        tl.to(
          resultHeading,
          {
            opacity: 1,
            y: 0,
            duration: 0.45,
            ease: "power2.out",
          },
          "<+=0.1",
        );
      }

      if (chart) {
        tl.to(
          chart,
          {
            opacity: 1,
            y: 0,
            duration: 0.55,
            ease: "power2.out",
            pointerEvents: "auto",
          },
          resultHeading ? "<" : "<+=0.1",
        );
      }
    }

    window.addEventListener("resize", function () {
      if (activeUpdatePillPath) activeUpdatePillPath();
    });

    // The chevrons walk the card's OWN team, not all eleven — the overlay was
    // opened from a filtered grid, so stepping into a team whose pill is not
    // lit would be a jump with nothing on screen to explain it.
    function teamOf(index) {
      var group = overlayCards[index].getAttribute("data-ih-maiw-group");
      var members = [];
      for (var i = 0; i < count; i++) {
        if (overlayCards[i].getAttribute("data-ih-maiw-group") === group)
          members.push(i);
      }
      return members;
    }

    function show(index) {
      current = index;
      for (var i = 0; i < count; i++) {
        var isCurr = i === current;
        overlayCards[i].hidden = !isCurr;
        if (isCurr) {
          overlayCards[i].classList.add("is-active");
          overlayCards[i].setAttribute("data-ih-maiw-active", "true");
        } else {
          overlayCards[i].classList.remove("is-active");
          overlayCards[i].removeAttribute("data-ih-maiw-active");
          resetCardStage(overlayCards[i]);
        }
      }

      // The panel scrolls on short windows; a card further down the list would
      // otherwise open mid-way through its own copy.
      panel.scrollTop = 0;
    }

    // Wraps both ways within the team, so neither chevron is ever a dead
    // control — including on the three-card team.
    function step(delta) {
      var members = teamOf(current);
      var at = members.indexOf(current);
      var nextIdx = members[(at + delta + members.length) % members.length];
      show(nextIdx);
      requestAnimationFrame(function () {
        playAnimation(nextIdx);
      });
    }

    function open(index, opener) {
      lastFocused = opener || document.activeElement;
      show(index);
      overlay.style.display = "flex";
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
      requestAnimationFrame(function () {
        playAnimation(index);
      });
    }

    function close() {
      if (currentTl) {
        currentTl.kill();
        currentTl = null;
      }
      for (var i = 0; i < count; i++) {
        resetCardStage(overlayCards[i]);
        overlayCards[i].classList.remove("is-active");
        overlayCards[i].removeAttribute("data-ih-maiw-active");
      }
      overlay.style.display = "none";
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    // Delegated, so it does not matter which Embed mounts first or whether the
    // cards existed when this ran.
    document.addEventListener("click", function (e) {
      if (!e.target.closest) return;
      var opener = e.target.closest("[data-ih-maiw-open]");
      if (!opener) return;
      open(
        parseInt(opener.getAttribute("data-ih-maiw-index"), 10) || 0,
        opener,
      );
    });

    // Dedicated close button click
    if (closeBtn) {
      closeBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        close();
      });
    }

    // Delegated overlay clicks for close, prev, next buttons
    overlay.addEventListener("click", function (e) {
      if (e.target.closest("[data-ih-maiw-close]")) {
        close();
        return;
      }
      if (e.target.closest("[data-ih-maiw-prev]")) {
        step(-1);
        return;
      }
      if (e.target.closest("[data-ih-maiw-next]")) {
        step(1);
        return;
      }
      if (e.target === overlay) close();
    });

    document.addEventListener("keydown", function (e) {
      if (!isOpen()) return;

      if (e.key === "Escape") {
        close();
        return;
      }

      // Arrow keys drive the same walk the chevrons do. Nothing inside the
      // dialog is a native arrow-key control (no radio group, select or text
      // field), so there is no default behaviour to steal here — and the pill
      // bar's own arrow handling cannot fire, since focus is trapped below.
      if (e.key === "ArrowLeft") {
        step(-1);
        return;
      }
      if (e.key === "ArrowRight") {
        step(1);
        return;
      }

      // Keep Tab inside the dialog — `aria-modal` claims the rest is inert, so
      // focus must not walk out into the page behind it.
      if (e.key !== "Tab") return;
      var focusable = panel.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>
