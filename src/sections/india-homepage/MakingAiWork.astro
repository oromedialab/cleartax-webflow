/* The overlay holds one copy of every card's text, addressed by a FLAT index
   across every team — so the numbering has to be assigned once, here, and used
   by both the grid and the overlay. Panels render from `panels`, the overlay
   from `flat`, and the two agree by construction. */
const flat = groups.flatMap((group) =>
  group.cards.map((card) => ({
    card,
    group: group.id,
    layout: card.layout ?? 1,
  })),
);

let seq = 0;
const panels = groups.map((group) => ({
  ...group,
  cards: group.cards.map((card) => ({ card, index: seq++ })),
}));
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] mx-auto px-4 md:px-6 w-full">
    <div class="mb-8 flex flex-col items-center gap-6 text-center lg:mb-12">
      <div class="flex flex-col items-center gap-4">
        <h2
          class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
        >
          Clarity AI, by ClearTax: Making AI work for Finance
        </h2>
        <p
          class="m-0 max-w-[597px] font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
        >
          ClearTax gives you clean finance data and the business context AI
          needs, so your finance team can build and use AI with confidence.
        </p>
      </div>

      <!-- `overflow-x-auto` so the labels scroll rather than wrap on a narrow
           viewport — the bar must stay one row, or the thumb's `top`/`bottom`
           inset would stretch it across both. -->
      <div
        class="ih-maiw-tablist relative flex max-w-full items-center gap-1 overflow-x-auto rounded-xl bg-neutral-100 px-1 py-1.5"
        role="tablist"
        aria-label="Clarity AI agents by team"
      >
        <span class="ih-maiw-thumb" aria-hidden="true"></span>
        {
          groups.map((group, i) => (
            <button
              type="button"
              role="tab"
              id={`ih-maiw-tab-${group.id}`}
              class="ih-maiw-tab relative z-10 shrink-0 cursor-pointer whitespace-nowrap rounded-lg border-0 bg-transparent px-6 py-2 text-center font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-neutral-700"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`ih-maiw-panel-${group.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-ih-maiw-tab={group.id}
            >
              {group.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      panels.map((group, i) => (
        <div
          id={`ih-maiw-panel-${group.id}`}
          role="tabpanel"
          aria-labelledby={`ih-maiw-tab-${group.id}`}
          class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8"
          style={i === 0 ? undefined : "display:none"}
          data-ih-maiw-panel={group.id}
        >
          {group.cards.map(({ card, index }) => (
            <button
              type="button"
              class="group m-0 flex w-full cursor-pointer items-center gap-6 self-start rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue"
              aria-haspopup="dialog"
              data-ih-maiw-open
              data-ih-maiw-index={index}
            >
              {card.icon ? (
                <img
                  src={card.icon}
                  alt={card.title}
                  class="h-14 w-14 shrink-0 rounded-lg object-contain"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span
                  class="block h-14 w-14 shrink-0 self-stretch rounded-lg bg-visual-placeholder"
                  aria-hidden="true"
                />
              )}
              <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                {card.title}
              </span>
              <span
                class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg p-2 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
                aria-hidden="true"
              >
                <!-- The exported Figma glyph (Media / Icon / Unfilled / plus). -->
                <svg
                  width="40"
                  height="40"
                  viewBox="0 0 40 40"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M20 10V30"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                  <path
                    d="M30 20L10 20"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </span>
            </button>
          ))}
        </div>
      ))
    }
  </div>
</section>

<!-- Detail overlay. Lives outside the section's container so the scrim covers
     the viewport rather than the 1280px column.

     Rendered ONCE with every card's text inside it, `hidden` on all but the
     active one, rather than one panel per card: eleven copies of the chevrons,
     the close control and the image frame would be eleven copies of the same
     bytes, and every byte here is a Webflow Embed byte.

     The per-card blocks use the `hidden` ATTRIBUTE, which is safe only because
     none of them carries a display utility of its own — don't add one, or it
     will beat the UA rule and nothing will ever hide. That is also why the
     heading block spaces itself with `mb-*` rather than `flex gap-*`. -->
<div
  id="ih-maiw-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ih-maiw-overlay-title"
  aria-hidden="true"
  class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
>
  <div
    class="relative max-h-[90vh] w-full max-w-[1280px] overflow-y-auto rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6"
    data-ih-maiw-panel-detail
  >
    <!-- Anchored to the PANEL, not to the visual it sits over in the Figma:
         24px panel padding + the design's 20px inset lands at the same 44px on
         desktop, and it stays reachable once the visual moves below the copy on
         mobile. The glyph is the card's plus, turned 45°. -->
    <button
      type="button"
      aria-label="Close"
      class="absolute right-6 top-6 z-50 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-11 lg:top-11"
      data-ih-maiw-close
    >
      <svg
        width="40"
        height="40"
        viewBox="0 0 40 40"
        fill="none"
        class="rotate-45"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M20 10V30"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M30 20L10 20"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <!-- Overlay Cards: Each index has its own layout condition (i === 0 ? ... : i === 1 ? ...), exactly like WhyGenericAi -->
    <div class="ih-maiw-overlay-cards-container w-full">
      {
        flat.map(({ card, group }, i) => (
          <div
            class={`ih-maiw-overlay-card ih-maiw-overlay-card-${i} w-full`}
            data-ih-maiw-overlay-card
            data-ih-maiw-index={i}
            data-ih-maiw-group={group}
            hidden={i !== 0}
          >
            {i === 0 ? (
              <!-- ============================================================
                   INDEX 0: CFO Dashboard Agent
                   Customize this layout specifically for Card 0
                   ============================================================ -->
              <div class="ih-maiw-content ih-maiw-layout-0 flex flex-col items-start gap-6 lg:flex-row lg:gap-8 xl:gap-12">
                <!-- Text Column (Left) -->
                <div class="flex w-full flex-col justify-between gap-6 lg:w-[350px] xl:w-[416px] lg:shrink-0 lg:self-stretch">
                  <div class="flex flex-col gap-6">
                    <div>
                      <div class="mb-6">
                        {card.icon ? (
                          <img
                            src={card.icon}
                            alt=""
                            class="h-16 w-16 rounded-lg object-contain"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span
                            class="block h-16 w-16 rounded-lg bg-visual-placeholder"
                            aria-hidden="true"
                          />
                        )}
                      </div>
                      <h3 class="m-0 mb-2 pr-12 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px] lg:pr-0">
                        {card.title}
                      </h3>
                      <p class="m-0 font-body font-medium text-nova-blue text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                        {card.claim}
                      </p>
                    </div>
                  </div>

                  <div class="flex flex-col gap-6">
                    <p class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                      {card.caption}
                    </p>

                    <div class="flex items-center gap-2">
                      <button
                        type="button"
                        aria-label="Previous"
                        class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue"
                        data-ih-maiw-prev
                      >
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                          <path d="M12 15L7 10L12 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </button>
                      <button
                        type="button"
                        aria-label="Next"
                        class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue"
                        data-ih-maiw-next
                      >
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                          <path d="M7 5L12 10L7 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Stage / Visual Column (Right) -->
                <div
                  class="ih-maiw-stage-wrap relative flex w-full flex-col bg-generic-00 justify-between overflow-hidden rounded-xl border border-[#111827] p-3.5 sm:p-4 md:px-14 lg:px-6 xl:px-14 md:py-4 aspect-[1280/720] min-h-[320px] md:min-h-[420px] select-none bg-cover bg-center bg-no-repeat lg:w-auto lg:flex-1 cursor-pointer"
                  style="background-image:url('https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab399f1e2c6a1e38c91700f_dots-bg.png');"
                >
                  <!-- Ambient Center Glow for Frame 1 -->
                  <div
                    class="ih-maiw-glow pointer-events-none absolute inset-0 z-0 opacity-100"
                    style="background: radial-gradient(ellipse 65% 50% at 50% 50%, rgba(212, 248, 66, 0.22) 0%, rgba(212, 248, 66, 0) 70%);"
                  ></div>

                  <!-- Ambient Bottom Glow behind Input Pill (softer intensity) -->
                  <div
                    class="ih-maiw-glow-bottom pointer-events-none absolute inset-x-0 bottom-3 h-50 z-0 opacity-0"
                    style="background: radial-gradient(ellipse 75% 65% at 50% 92%, rgba(212, 248, 66, 0.14) 0%, rgba(212, 248, 66, 0) 70%);"
                  ></div>

                  <!-- Frame 1: Center Heading -->
                  <div
                    class="ih-maiw-center-title pointer-events-none absolute inset-x-0 top-[26%] z-10 flex flex-col items-center justify-center text-center opacity-100 px-4"
                  >
                    <h3
                      class="m-0 font-heading font-medium text-vault-navy text-base md:text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]"
                    >
                      What would you like to understand?
                    </h3>
                  </div>

                  <!-- Top Stage Area: Frame 3 & 4 Chat Bubble, Frame 5 Result Heading -->
                  <div
                    class="ih-maiw-top-stage relative z-10 w-full shrink-0 min-h-[42px] flex items-start"
                  >
                    <div
                      class="ih-maiw-bubble hidden absolute right-12 md:right-14 top-0 self-end max-w-fit rounded-2xl border border-dashed border-[#11182726] bg-generic-00 px-3 py-1.5 md:px-4 md:py-2.5 opacity-0 pointer-events-none"
                    >
                      <p
                        class="ih-maiw-bubble-text m-0 font-body text-[10px] md:text-xs lg:text-sm xl:text-[16px] font-normal leading-[1.35] md:leading-[1.7] lg:leading-[1.5] text-[#111827]"
