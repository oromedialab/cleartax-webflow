---
/**
 * "Clarity AI, by ClearTax: Making AI work for Finance" — Figma node
 * 13692:35487, with the card copy carried over from the sticky-deck version
 * this replaces (13275:28481 / 13091:18569).
 *
 * Structurally this is `france-regional/Supports.astro`: a grid of cards, each
 * one a button that opens ONE detail overlay with prev/next chevrons. The
 * difference is the pill bar above it — the cards are split by team and the
 * pills switch which set the grid shows.
 *
 * WHAT THE FIGMA SHOWS AND WHAT IT LEAVES OPEN. The frame draws one state: two
 * pills, six cards, each card a title + icon square + plus. It does not draw
 * the tab interaction or the overlay. Two readings were resolved here:
 *   - The pills FILTER the grid. With the scrolling deck gone they cannot mean
 *     "position in a stack" any more, and the frame's own card set spans both
 *     teams, so it is a WIP layout rather than a filtered state.
 *   - The plus opens the Supports overlay, carrying the claim and the caption.
 *     The card itself only has room for the title, and that copy has to land
 *     somewhere.
 *
 * PANELS ARE HIDDEN BY INLINE `display`, not by a class or the `hidden`
 * attribute. `hidden` is a UA-origin `display:none`, so an author `grid`
 * utility beats it and the panel stays visible; a `hidden` CLASS would race the
 * `grid` class on source order, which is unlayered once pasted into Webflow.
 * The initial `display:none` is rendered server-side rather than applied by the
 * script, so the page never paints every panel and then collapses to one.
 *
 * Consequence, and it is deliberate: without JS only the first team's cards are
 * reachable. The alternative — every card visible, then a jump — is worse, and
 * the overlay this section is built around needs JS regardless.
 *
 * The active pill is Nova Blue. Figma reports `--vault-navy/600` at #1200FF
 * there, which is an unresolved token in the export — the rendered design is
 * the brand's Nova Blue (#5446FF), so that is what this uses.
 *
 * The icon squares and the overlay visual are unfilled "Icon placeholder" /
 * "Image" frames in the Figma, so they render as `bg-visual-placeholder` — the
 * token is #E8FFE1, exactly the fill the design uses. Swap each for a
 * Webflow-hosted URL when the artwork lands — never a `data:` URI.
 *
 * "Audit and Advisory Agent" appearing under both For CFO and For Tax Teams is
 * the design's own repetition, not a copy-paste slip.
 *
 * Ids are `ih-maiw-` prefixed: embeds share one namespace per page.
 */
interface Card {
  title: string;
  /** The Nova Blue one-liner under the title in the overlay. */
  claim: string;
  caption: string;
}

interface Group {
  id: string;
  label: string;
  cards: Card[];
}

const groups: Group[] = [
  {
    id: "cfo",
    label: "For CFO",
    cards: [
      {
        title: "CFO Dashboard Agent",
        claim: "Walk into the monthly review with insights, not numbers.",
        caption:
          "Builds the CFO presentation from your data, in the format and narrative the tax team controls.",
      },
      {
        title: "Tax Governance Agent",
        claim: "An objective read on where you stand, not a self-assessment",
        caption:
          "Scores six dimensions: reconciliation health, ITC quality, notice exposure, invoice rejection rates, Table-4 accuracy and vendor compliance, with independent commentary on each, benchmarked against industry peers",
      },
      {
        title: "Audit and Advisory Agent",
        claim: "The monthly CA audit, on every entity, without adding headcount",
        caption:
          "Maps your GL, assess completeness, calculate an independent position and compare it to what you filed. Maps findings to known notice patterns to score risk.",
      },
      {
        title: "Notice Dashboard Agent",
        claim: "Notice tracking through your lens, not a generic dashboard",
        caption:
          "Combines ClearTax notice data with your own tracking rules. You define your own controls.",
      },
    ],
  },
  {
    id: "tax-teams",
    label: "For Tax Teams",
    cards: [
      {
        title: "Litigation Agent",
        claim:
          "Every notice type answered with the transactions behind it, inside the deadline",
        caption:
          "Drafts from the actual records: invoice, line item, date, counterparty, GSTIN and the rule in force on that date. At-scale reconciliation, case law from verified databases.",
      },
      {
        title: "Refund Agent",
        claim: "The bottleneck is data preparation, not filing",
        caption:
          "Reads your specific scenario, whether inverted duty, excess payment or unutilised balance, and prepares a complete dossier: refund quantum, supporting data and justification trail.",
      },
      {
        title: "Audit and Advisory Agent",
        claim: "The monthly CA audit, on every entity, without adding headcount",
        caption:
          "Maps your GL, assess completeness, calculate an independent position and compare it to what you filed. Maps findings to known notice patterns to score risk.",
      },
    ],
  },
];

/* The overlay holds one copy of every card's text, addressed by a FLAT index
   across every team — so the numbering has to be assigned once, here, and used
   by both the grid and the overlay. Panels render from `panels`, the overlay
   from `flat`, and the two agree by construction. */
const flat = groups.flatMap((group) =>
  group.cards.map((card) => ({ card, group: group.id })),
);

let seq = 0;
const panels = groups.map((group) => ({
  ...group,
  cards: group.cards.map((card) => ({ card, index: seq++ })),
}));
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="container mx-auto">
    <div class="mb-8 flex flex-col items-center gap-6 text-center lg:mb-12">
      <div class="flex flex-col items-center gap-4">
        <h2
          class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
        >
          Clarity AI, by ClearTax: Making AI work for Finance
        </h2>
        <p
          class="m-0 max-w-[597px] font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
        >
          ClearTax gives you clean finance data and the business context AI
          needs, so your finance team can build and use AI with confidence.
        </p>
      </div>

      <!-- `overflow-x-auto` so the labels scroll rather than wrap on a narrow
           viewport — the bar must stay one row, or the thumb's `top`/`bottom`
           inset would stretch it across both. -->
      <div
        class="ih-maiw-tablist relative flex max-w-full items-center gap-1 overflow-x-auto rounded-xl bg-neutral-100 px-1 py-1.5"
        role="tablist"
        aria-label="Clarity AI agents by team"
      >
        <span class="ih-maiw-thumb" aria-hidden="true"></span>
        {
          groups.map((group, i) => (
            <button
              type="button"
              role="tab"
              id={`ih-maiw-tab-${group.id}`}
              class="ih-maiw-tab relative z-10 shrink-0 cursor-pointer whitespace-nowrap rounded-lg border-0 bg-transparent px-6 py-2 text-center font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-neutral-700"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`ih-maiw-panel-${group.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-ih-maiw-tab={group.id}
            >
              {group.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      panels.map((group, i) => (
        <div
          id={`ih-maiw-panel-${group.id}`}
          role="tabpanel"
          aria-labelledby={`ih-maiw-tab-${group.id}`}
          class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8"
          style={i === 0 ? undefined : "display:none"}
          data-ih-maiw-panel={group.id}
        >
          {group.cards.map(({ card, index }) => (
            <button
              type="button"
              class="group m-0 flex w-full cursor-pointer items-center gap-6 self-start rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue"
              aria-haspopup="dialog"
              data-ih-maiw-open
              data-ih-maiw-index={index}
            >
              <span
                class="block h-14 w-14 shrink-0 self-stretch rounded-lg bg-visual-placeholder"
                aria-hidden="true"
              />
              <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                {card.title}
              </span>
              <span
                class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg p-2 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
                aria-hidden="true"
              >
                {/* The exported Figma glyph (Media / Icon / Unfilled / plus). */}
                <svg
                  width="40"
                  height="40"
                  viewBox="0 0 40 40"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M20 10V30"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M30 20L10 20"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </button>
          ))}
        </div>
      ))
    }
  </div>
</section>

<!-- Detail overlay. Lives outside the section's container so the scrim covers
     the viewport rather than the 1280px column.

     Rendered ONCE with every card's text inside it, `hidden` on all but the
     active one, rather than one panel per card: eleven copies of the chevrons,
     the close control and the image frame would be eleven copies of the same
     bytes, and every byte here is a Webflow Embed byte.

     The per-card blocks use the `hidden` ATTRIBUTE, which is safe only because
     none of them carries a display utility of its own — don't add one, or it
     will beat the UA rule and nothing will ever hide. That is also why the
     heading block spaces itself with `mb-*` rather than `flex gap-*`. -->
<div
  id="ih-maiw-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ih-maiw-overlay-title"
  aria-hidden="true"
  class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
>
  <div
    class="relative max-h-[90vh] w-full max-w-[1280px] overflow-y-auto rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6"
    data-ih-maiw-panel-detail
  >
    <!-- Anchored to the PANEL, not to the visual it sits over in the Figma:
         24px panel padding + the design's 20px inset lands at the same 44px on
         desktop, and it stays reachable once the visual moves below the copy on
         mobile. The glyph is the card's plus, turned 45°. -->
    <button
      type="button"
      aria-label="Close"
      class="absolute right-6 top-6 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-11 lg:top-11"
      data-ih-maiw-close
    >
      <svg
        width="40"
        height="40"
        viewBox="0 0 40 40"
        fill="none"
        class="rotate-45"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M20 10V30"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M30 20L10 20"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="flex flex-col items-start gap-6 lg:flex-row lg:gap-12">
      <!-- 416px = 1280 panel − 48 padding − 48 gap − the 768px the 16:9 visual
           takes at the design's 432px height. justify-between is what puts the
           caption and the chevrons on the visual's bottom edge. -->
      <div
        class="flex w-full flex-col justify-between gap-6 lg:w-[416px] lg:shrink-0 lg:self-stretch"
      >
        <div class="flex flex-col gap-6">
          <span
            class="block h-16 w-16 shrink-0 rounded-lg bg-visual-placeholder"
            aria-hidden="true"
          />
          <div id="ih-maiw-overlay-title">
            {
              flat.map(({ card, group }, i) => (
                <div hidden={i !== 0} data-ih-maiw-head data-ih-maiw-group={group}>
                  <h3 class="m-0 mb-2 pr-12 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px] lg:pr-0">
                    {card.title}
                  </h3>
                  <p class="m-0 font-body font-medium text-nova-blue text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                    {card.claim}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col gap-6">
          <div>
            {
              flat.map(({ card }, i) => (
                <p
                  class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                  hidden={i !== 0}
                  data-ih-maiw-body
                >
                  {card.caption}
                </p>
              ))
            }
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              aria-label="Previous"
              aria-controls="ih-maiw-overlay-title"
              class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue"
              data-ih-maiw-prev
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M12 15L7 10L12 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
            <button
              type="button"
              aria-label="Next"
              aria-controls="ih-maiw-overlay-title"
              class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue"
              data-ih-maiw-next
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M7 5L12 10L7 15"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div
        class="aspect-[1280/720] w-full rounded-lg bg-visual-placeholder lg:w-auto lg:flex-1"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</div>

<style is:global>
  .ih-maiw-tab {
    transition: color 0.2s ease;
  }

  .ih-maiw-tab[aria-selected="true"] {
    color: var(--color-nova-blue);
  }

  /* The moving pill. Sliding one element beats cross-fading three backgrounds:
     the highlight reads as travelling to the team you picked. */
  .ih-maiw-thumb {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 0;
    width: 0;
    border-radius: 8px;
    background-color: var(--color-generic-00);
    box-shadow:
      0 1px 2px 0 rgba(16, 24, 40, 0.04),
      0 1px 2px 0 rgba(16, 24, 40, 0.04);
    opacity: 0;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }

  .ih-maiw-tablist.is-ready .ih-maiw-thumb {
    opacity: 1;
  }

  /* No JS, no thumb — so the current pill paints its own background instead.
     Suppressed the moment JS marks the bar ready, or the two would double up. */
  .ih-maiw-tablist:not(.is-ready) .ih-maiw-tab[aria-selected="true"] {
    background-color: var(--color-generic-00);
    box-shadow:
      0 1px 2px 0 rgba(16, 24, 40, 0.04),
      0 1px 2px 0 rgba(16, 24, 40, 0.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .ih-maiw-thumb {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script is:inline>
  /* Pills filter the grid; a card opens the detail overlay, and the chevrons
     walk that card's own team without closing. */
  (function () {
    var tablist = document.querySelector(".ih-maiw-tablist");
    var overlay = document.getElementById("ih-maiw-overlay");
    if (!tablist || !overlay) return;

    var reduceMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ---- pills ---- */

    var tabs = Array.prototype.slice.call(
      tablist.querySelectorAll("[data-ih-maiw-tab]"),
    );
    var thumb = tablist.querySelector(".ih-maiw-thumb");
    var panels = tabs.map(function (tab) {
      return document.getElementById(
        "ih-maiw-panel-" + tab.getAttribute("data-ih-maiw-tab"),
      );
    });
    var activeTab = 0;

    function moveThumb(i) {
      if (!thumb) return;
      thumb.style.width = tabs[i].offsetWidth + "px";
      thumb.style.transform = "translateX(" + tabs[i].offsetLeft + "px)";
      tablist.classList.add("is-ready");
    }

    // Inline display, not a class swap: the utilities pasted into Webflow are
    // unlayered, so `grid` and a hiding class on one element would race on
    // source order. Inline always wins, and it is the same state the server
    // rendered, so nothing shifts on hydration.
    function selectTab(i) {
      activeTab = i;
      tabs.forEach(function (tab, n) {
        tab.setAttribute("aria-selected", n === i ? "true" : "false");
        tab.tabIndex = n === i ? 0 : -1;
        if (panels[n]) panels[n].style.display = n === i ? "grid" : "none";
      });
      moveThumb(i);

      // Narrow viewports scroll the bar rather than wrapping it, so a pill
      // chosen by keyboard could otherwise sit off-screen.
      if (tablist.scrollWidth > tablist.clientWidth) {
        tablist.scrollTo({
          left: tabs[i].offsetLeft - (tablist.clientWidth - tabs[i].offsetWidth) / 2,
          behavior: reduceMotion ? "auto" : "smooth",
        });
      }
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener("click", function () {
        selectTab(i);
      });
    });

    // Roving tabindex: `role="tablist"` promises arrow keys move between tabs
    // and Tab leaves the group entirely.
    tablist.addEventListener("keydown", function (e) {
      var next;
      if (e.key === "Home") next = 0;
      else if (e.key === "End") next = tabs.length - 1;
      else if (e.key === "ArrowRight") next = (activeTab + 1) % tabs.length;
      else if (e.key === "ArrowLeft") next = (activeTab - 1 + tabs.length) % tabs.length;
      else return;

      e.preventDefault();
      selectTab(next);
      tabs[next].focus();
    });

    moveThumb(0);
    // The bar can be laid out before its webfont arrives, which changes every
    // pill's width — remeasure rather than leave the thumb on stale geometry.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function () {
        moveThumb(activeTab);
      });
    }
    window.addEventListener("resize", function () {
      moveThumb(activeTab);
    });

    /* ---- detail overlay ---- */

    var panel = overlay.querySelector("[data-ih-maiw-panel-detail]");
    var closeBtn = overlay.querySelector("[data-ih-maiw-close]");
    var prevBtn = overlay.querySelector("[data-ih-maiw-prev]");
    var nextBtn = overlay.querySelector("[data-ih-maiw-next]");
    var heads = overlay.querySelectorAll("[data-ih-maiw-head]");
    var bodies = overlay.querySelectorAll("[data-ih-maiw-body]");
    if (!panel || !heads.length || heads.length !== bodies.length) return;

    var count = heads.length;
    var current = 0;
    var lastFocused = null;

    // The chevrons walk the card's OWN team, not all eleven — the overlay was
    // opened from a filtered grid, so stepping into a team whose pill is not
    // lit would be a jump with nothing on screen to explain it.
    function teamOf(index) {
      var group = heads[index].getAttribute("data-ih-maiw-group");
      var members = [];
      for (var i = 0; i < count; i++) {
        if (heads[i].getAttribute("data-ih-maiw-group") === group) members.push(i);
      }
      return members;
    }

    function show(index) {
      current = index;
      for (var i = 0; i < count; i++) {
        heads[i].hidden = i !== current;
        bodies[i].hidden = i !== current;
      }
      // The panel scrolls on short windows; a card further down the list would
      // otherwise open mid-way through its own copy.
      panel.scrollTop = 0;
    }

    // Wraps both ways within the team, so neither chevron is ever a dead
    // control — including on the three-card team.
    function step(delta) {
      var members = teamOf(current);
      var at = members.indexOf(current);
      show(members[(at + delta + members.length) % members.length]);
    }

    function open(index, opener) {
      lastFocused = opener || document.activeElement;
      show(index);
      overlay.style.display = "flex";
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
    }

    function close() {
      overlay.style.display = "none";
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function isOpen() {
      return overlay.style.display === "flex";
    }

    // Delegated, so it does not matter which Embed mounts first or whether the
    // cards existed when this ran.
    document.addEventListener("click", function (e) {
      if (!e.target.closest) return;
      var opener = e.target.closest("[data-ih-maiw-open]");
      if (!opener) return;
      open(parseInt(opener.getAttribute("data-ih-maiw-index"), 10) || 0, opener);
    });

    if (closeBtn) closeBtn.addEventListener("click", close);
    if (prevBtn)
      prevBtn.addEventListener("click", function () {
        step(-1);
      });
    if (nextBtn)
      nextBtn.addEventListener("click", function () {
        step(1);
      });

    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) close();
    });

    document.addEventListener("keydown", function (e) {
      if (!isOpen()) return;

      if (e.key === "Escape") {
        close();
        return;
      }

      // Arrow keys drive the same walk the chevrons do. Nothing inside the
      // dialog is a native arrow-key control (no radio group, select or text
      // field), so there is no default behaviour to steal here — and the pill
      // bar's own arrow handling cannot fire, since focus is trapped below.
      if (e.key === "ArrowLeft") {
        step(-1);
        return;
      }
      if (e.key === "ArrowRight") {
        step(1);
        return;
      }

      // Keep Tab inside the dialog — `aria-modal` claims the rest is inert, so
      // focus must not walk out into the page behind it.
      if (e.key !== "Tab") return;
      var focusable = panel.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>
