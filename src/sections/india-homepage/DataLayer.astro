---
/**
 * "Clarity AI is new; the data layer is not." — Figma node 13275:28483.
 *
 * Three blocks: the source-systems / platform / tax-portals diagram, a
 * prevent-automate-detect row, and a secondary CTA.
 *
 * LOGOS, TODO: three tiles have no artwork on the Webflow CDN yet — GSTN,
 * TRACES and the Income Tax Department emblem. Each renders its name as text
 * meanwhile, which is how the OMS and POS tiles are drawn in the design anyway,
 * so the column still reads correctly. To finish them, upload the files staged
 * in `public/images/india-homepage/` to Webflow assets and set `src` on the
 * matching entry below. Nothing else changes. (The emblem export is a 444 KB
 * traced SVG — rasterise it to a ~30px-tall PNG before uploading.)
 *
 * Oracle is the exception: its mark is a single 1.1 KB path, so it is inlined
 * as `mark: "oracle"` rather than parked on a CDN round trip. Anything heavier
 * than that belongs in Webflow assets — see the Embed budget in CLAUDE.md.
 * (`oracle-retail-logo.png` is already on the CDN, but it is the Oracle Retail
 * wordmark, not the plain Oracle mark this design shows.)
 *
 * HEXAGON: three nested hexagons, drawn as one inline SVG rather than three
 * exported vectors. The path data is Figma's own, so the rounded vertices and
 * the slightly-wider-than-regular proportions survive; each ring is #999999 and
 * separates by opacity and stroke weight (1.5/1 · 1/0.5 · 0.5/0.4), which is
 * what makes the innermost read as the solid one. Nested at Figma's sizes via
 * translate, so the SVG scales as a unit and the ring spacing holds.
 *
 * DOT COLUMNS: eight columns per side, 4px dots on a 26px pitch, in the same
 * #A6C705 the bridge dots in `Proven.astro` use. Drawn as one inline SVG per
 * fan — not images, and no longer CSS boxes; the note beside the first <svg>
 * explains why the body zoom rules boxes out. The heights below are all exactly
 * n×26−22, so each one is a whole number of dots and the count is derived
 * rather than stated twice.
 *
 * The recolour to Nova Blue is a SWEEP, not one event, and it waits until the
 * diagram's OWN CENTRE reaches the centre of the screen — see `.ih-dl-centre`
 * for why that needs a probe rather than a tighter observer margin. Then both
 * platform turns first and both fans open outward from it, dot by dot, ordered
 * by distance, so each front is an arc leaving the platform and the two outer
 * edges are the last to change. Scrolling back out unwinds it from the edges
 * inward, the exact reverse.
 *
 * It is timed PER DOT rather than per column, which is what lets each dot
 * change quickly and cleanly while the sweep as a whole stays continuous — the
 * frontmatter explains why the column-level version could not. No animation and
 * no script beyond the observer that was already here: one transition, one
 * inline moment per dot.
 *
 * "Yours Taxes" is verbatim from the Figma. It reads like a typo for "Your
 * Taxes" but changing approved copy is not this file's call — flag it with the
 * designer.
 */
interface Tile {
  name: string;
  /** Webflow asset URL. Absent → the tile renders `name` as text. */
  src?: string;
  /** Inline mark, for logos small enough not to be worth a CDN round trip. */
  mark?: "oracle";
}

const books: Tile[] = [
  {
    name: "SAP",
    src: "https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/6a06bfe3956ddb4d4f844ba3_sap-logo.png",
  },
  { name: "Oracle", mark: "oracle" },
  {
    name: "Microsoft Dynamics",
    src: "https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/6a06bfe11b9d1549ee39553a_microsoft-dynamics.png",
  },
  { name: "OMS" },
  { name: "POS" },
];

const portals: Tile[] = [
  {
    name: "NIC",
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9e5c40e26234b20c223960_NIC.png",
  },
  { name: "GSTN",
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9e5cf5da2e8ae853e88977_gstn.png"
   },
  { name: "TRACES",
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9e5c40615cfd7b88152a8c_traces.png"
   },
  { name: "Income Tax",
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9e5c40928141edd9f3050d_income-tax-department.svg"
   },
];

const platformPills = ["GL Data", "Govt Data & Notices", "Compliance Registers"];

/** Column heights, outermost first. Mirrored on the right-hand side. */
const dotColumns = [290, 264, 238, 212, 186, 160, 108, 82];

/* THE SWEEP. The recolour is not one event — the platform turns first and the
   colour spreads OUTWARD from it, both fans at once, reaching the two outer
   edges last. The platform is the source: it is what makes the data layer the
   data layer, so it is what the colour comes from.

   IT IS TIMED PER DOT, NOT PER COLUMN, and that is what makes it smooth without
   smearing. Staggering whole columns gives eight steps a side: to stop that
   reading as eight separate blinks the colour has to travel long enough that
   most columns are part-changed at any moment, and a fan of half-changed dots
   is a gradient — a muddy ramp between lime and blue spread across the artwork.
   Timing each dot individually gives a hundred and thirty-two steps instead, so
   each one can change quickly and cleanly and the sweep is still continuous.
   Every dot is one colour or the other; only the handful on the edge itself are
   ever in between.

   The order is by straight-line DISTANCE from the platform, nearest first, so
   each front is an arc opening out of it rather than a vertical bar sliding
   sideways. The dots at the top and bottom of a tall column are further from
   the platform than its middle ones, so they trail — which is what curves the
   edge. The PACING is by rank rather than by that distance — see the rings
   below for why. */
const DOT = 4;
/** Vertical: 4px dot on a 22px gap. Horizontal: 4px column on `gap-6`. */
const DOT_PITCH = 26;
const COL_PITCH = DOT + 24;
const HEX_GUTTER = 51;
const PLATFORM_W = 280;

const LAST = dotColumns.length - 1;
const FAN_W = dotColumns.length * DOT + LAST * (COL_PITCH - DOT);
/** The fan's box is its tallest column; the rest are centred inside it. */
const FAN_H = Math.max(...dotColumns);
/** Platform centre, measured from a fan's OUTER edge. */
const PLATFORM_X = FAN_W + HEX_GUTTER + PLATFORM_W / 2;

/** Figma's heights are all exactly n×26−22, so the count falls out of the height. */
const dotsIn = (h: number) => (h + DOT_PITCH - DOT) / DOT_PITCH;

/** Centre of dot `k` in a column of height `h`, in the fan's own coordinates. */
const dotY = (h: number, k: number) => (FAN_H - h) / 2 + DOT / 2 + k * DOT_PITCH;

/** `outer` counts from the fan's outer edge, so both fans share this. */
const dotDist = (outer: number, h: number, k: number) =>
  Math.hypot(
    PLATFORM_X - (outer * COL_PITCH + DOT / 2),
    k * DOT_PITCH + DOT / 2 - h / 2,
  );

const spread = dotColumns.flatMap((h, i) =>
  Array.from({ length: dotsIn(h) }, (_, k) => dotDist(i, h, k)),
);

/* RINGS. Every distinct distance is one step of the arc — a dot and its mirror
   below the axis are exactly equidistant, so they belong to the same ring and
   change together, which is what keeps each fan symmetric. NEAREST FIRST: ring
   0 is the dot closest to the platform, so the rank is also the running order.

   Timing is by a ring's RANK, not by its distance, and that is the difference
   between smooth and stuttering. The distances bunch and gap badly: a tall
   outer column contributes a dozen rings within a few px of each other while
   the short inner ones are far apart, so scaling time by distance left stalls
   of nearly two tenths of a second — longer than a dot's own fade, which the
   eye reads as the sweep catching. Ranking spaces every ring equally instead.
   Order is preserved, so the front still travels the same way; only the pacing
   changes, from "constant px per second" to "constant rings per second", and it
   is rings the eye is actually counting. */
const rings = [...new Set(spread.map((d) => Math.round(d * 100)))].sort((a, b) => a - b);
const ringOf = (outer: number, h: number, k: number) =>
  rings.indexOf(Math.round(dotDist(outer, h, k) * 100));

/** Seconds from the first ring to the last — the one dial for the pace. */
const SWEEP = 1.7;
const RING_STEP = SWEEP / (rings.length - 1);
/* The platform leads, and the fans leave it a beat later. Everything is
   measured from the platform at zero rather than shifting it negative, because
   a negative transition-delay does not wait — it starts the change already part
   way through, which would make the rings turn up mid-fade on the first frame.

   The fade in the styles is pinned at two ring steps; if SWEEP moves, it has to
   move with it, and the reason is on the rule. */
const HEX_T = 0;
const BEAT = RING_STEP * 3;
const MAX_T = BEAT + SWEEP;

const dotT = (outer: number, h: number, k: number) =>
  (BEAT + ringOf(outer, h, k) * RING_STEP).toFixed(3);

const stages = [
  {
    overline: "Prevent",
    title: "Fixed at source",
    body: "Every data point tagged by source, type and tax relevance. Formats standardised, de-duplicates and missing fields caught early.",
  },
  {
    overline: "Automate",
    title: "Transformed by rule",
    body: "Raw GL data lands in tax-compliant form every month.",
  },
  {
    overline: "Detect",
    title: "Caught early",
    body: "Comparison against your books, your data and the ecosystem data flags discrepancies as they appear",
  },
];
---

<section class="bg-generic-00 max-lg:py-12 lg:py-20" data-ih-datalayer>
  <div class="container mx-auto">
    <div class="flex flex-col items-center gap-12">
      <div class="flex flex-col items-center gap-4 text-center">
        <h2
          class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
        >
          Clarity AI is new; the data layer is not.
        </h2>
        <p
          class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] max-w-[572px]"
        >
          The data layer has been running your compliance for years on Clear
          Compliance Cloud. That is why Clarity AI works on day one.
        </p>
      </div>

      <!-- Diagram -->
      <div
        class="relative flex w-full items-stretch gap-10 max-lg:flex-col max-lg:items-center max-lg:gap-8"
        data-ih-lit
      >
        <span class="ih-dl-centre" aria-hidden="true"></span>
        <div
          class="flex flex-1 flex-col items-center gap-6 rounded-xl border border-[#CCCCCC] bg-generic-00 p-6 max-lg:w-full max-lg:max-w-[420px] lg:min-w-0"
        >
          <h3
            class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]"
          >
            Your Books
          </h3>
          <div class="flex w-full flex-col gap-2">
            {
              books.map((tile) => (
                <div class="flex h-14 items-center justify-center rounded-lg border border-[#CCCCCC] px-3">
                  {tile.src ? (
                    <img
                      src={tile.src}
                      alt={tile.name}
                      class="max-h-[30px] w-auto max-w-full object-contain"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : tile.mark === "oracle" ? (
                    /* Figma draws it 42.689 x 27 — kept exactly, so it sits the
                       same 30px-cap height as the raster marks beside it. */
                    <svg
                      width="42.689"
                      height="27"
                      viewBox="0 0 42.6894 27"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      role="img"
                      aria-label={tile.name}
                    >
                      <path
                        d="M13.8502 26.9955H29.5396C33.0582 26.9042 36.402 25.4423 38.8584 22.9213C41.3148 20.4004 42.6894 17.0198 42.6894 13.5C42.6894 9.98022 41.3148 6.59961 38.8584 4.07868C36.402 1.55774 33.0582 0.0958425 29.5396 0.00454269H13.8502C12.0485 -0.0422077 10.2556 0.272286 8.5774 0.929477C6.89918 1.58667 5.36953 2.57325 4.07868 3.83105C2.78782 5.08884 1.7619 6.59238 1.06139 8.25299C0.360892 9.91361 0 11.6977 0 13.5C0 15.3023 0.360892 17.0864 1.06139 18.747C1.7619 20.4076 2.78782 21.9112 4.07868 23.169C5.36953 24.4267 6.89918 25.4133 8.5774 26.0705C10.2556 26.7277 12.0485 27.0422 13.8502 26.9955ZM29.1853 22.2441H14.1954C11.9275 22.171 9.77693 21.2186 8.19851 19.5885C6.62009 17.9583 5.73757 15.7782 5.73757 13.5091C5.73757 11.24 6.62009 9.05985 8.19851 7.4297C9.77693 5.79955 11.9275 4.84721 14.1954 4.77406H29.1853C30.3561 4.7363 31.5226 4.93429 32.6153 5.35627C33.7081 5.77825 34.7049 6.4156 35.5464 7.23046C36.388 8.04531 37.0571 9.02103 37.5141 10.0996C37.9711 11.1782 38.2066 12.3377 38.2066 13.5091C38.2066 14.6805 37.9711 15.84 37.5141 16.9185C37.0571 17.9971 36.388 18.9729 35.5464 19.7877C34.7049 20.6026 33.7081 21.2399 32.6153 21.6619C31.5226 22.0839 30.3561 22.2819 29.1853 22.2441Z"
                        fill="#C74634"
                      />
                    </svg>
                  ) : (
                    <span class="font-body font-medium text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                      {tile.name}
                    </span>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        <!-- gap-[51px] is Figma's, and it is measured to the 280px content box,
             not to the hexagon. The hexagon is 334px wide and centred in that
             box, so it overhangs 27px each side and the dots clear its edge by
             the 24px the rest of the diagram is spaced on. At gap-6 the fans
             ran into the hexagon's side. -->
        <!-- --ih-dl-max is the last moment in the whole sweep, and it lives here
             because both fans and the hexagon need it: the resting rules derive
             each element's OUT delay as (max − its own), which is what makes
             leaving the exact reverse of arriving without a second value per
             dot. One number on the strip instead of a hundred and thirty-three.

             Reversing the sweep reversed the unwind for free — the outer edges
             now arrive last and so let go first, and the platform, which leads
             going in, is the last thing to drop back to grey. -->
        <div
          class="flex shrink-0 items-center gap-[51px] max-lg:hidden"
          style={`--ih-dl-max:${MAX_T.toFixed(3)}s`}
        >
          <!-- Index 0 is the OUTERMOST column of this fan, which makes it the
               furthest from the platform and so the LAST to turn. The right fan
               is reversed, so its own outermost column is the last in the array
               — see there. Both fans read the same rings, so both open outward
               at the same moment.

               ONE SVG PER FAN, not a hundred and thirty-two boxes. Each dot has
               to be its own element to carry its own moment in the sweep, and as
               CSS boxes that broke under the 0.85 body zoom: a box's paint rect
               is snapped to whole device pixels and each is snapped on its own,
               so 4px dots became 3.4px at sixteen different subpixel offsets and
               rendered at visibly different sizes. SVG geometry is rasterised as
               paths and is not snapped, so every dot antialiases identically.

               At zoom 1 nothing changes: every cx and cy below lands on a whole
               number, so the circles are as crisp as the boxes were.

               The circles carry no class — with this many of them a class
               attribute each would be kilobytes of the Embed budget for nothing
               a descendant selector cannot already say. -->
          <svg
            class="ih-dl-dots block shrink-0"
            width={FAN_W}
            height={FAN_H}
            viewBox={`0 0 ${FAN_W} ${FAN_H}`}
            aria-hidden="true"
          >
            {
              dotColumns.flatMap((h, i) =>
                Array.from({ length: dotsIn(h) }, (_, k) => (
                  <circle
                    cx={i * COL_PITCH + DOT / 2}
                    cy={dotY(h, k)}
                    r={DOT / 2}
                    style={`--ih-dl-t:${dotT(i, h, k)}s`}
                  />
                )),
              )
            }
          </svg>

          <div class="relative flex w-[280px] shrink-0 items-center justify-center">
            <!-- Figma's own path data, nested by translate rather than redrawn:
                 334.283x382.284, 316.963x362.147 and 297.913x340.382, each
                 centred in the outermost box. All three are unfilled — the
                 innermost carried a white fill before, which read the same on
                 this white section but would not on any other. -->
            <!-- Zero: the platform turns FIRST and the fans leave it a beat
                 later, because it is the source the colour spreads from. Its
                 OUT delay derives to --ih-dl-max, the largest there is, so it is
                 also the last thing to drop back — first to arrive, last to let
                 go, which is the mirror of what the outer edges do. -->
            <svg
              style={`--ih-dl-t:${HEX_T.toFixed(3)}s`}
              class="ih-dl-hex absolute left-1/2 top-1/2 h-[382px] w-[334px] -translate-x-1/2 -translate-y-1/2"
              viewBox="0 0 334.283 382.284"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M161.266 1.82426C164.902 -0.274626 169.381 -0.27452 173.016 1.82426L328.158 91.3955C331.793 93.4945 334.033 97.3735 334.033 101.571V280.713C334.033 284.911 331.793 288.79 328.158 290.889L173.016 380.46C169.381 382.559 164.902 382.559 161.266 380.46L6.12456 290.889C2.48933 288.79 0.249557 284.911 0.249557 280.713V101.571C0.249557 97.3736 2.48937 93.4945 6.12456 91.3955L161.266 1.82426Z"
                stroke="#999999"
                stroke-width="0.5"
                opacity="0.4"></path>
              <path
                transform="translate(8.66 10.069)"
                d="M152.51 2.09966C156.205 -0.0335411 160.758 -0.0335416 164.453 2.09966L310.492 86.4161C314.186 88.5493 316.462 92.4915 316.462 96.7579V265.39C316.462 269.656 314.186 273.598 310.492 275.731L164.453 360.048C160.758 362.181 156.205 362.181 152.51 360.048L6.47115 275.731C2.77635 273.598 0.500465 269.656 0.500443 265.39V96.7579C0.500443 92.4915 2.77633 88.5493 6.47115 86.4161L152.51 2.09966Z"
                stroke="#999999"
                opacity="0.5"></path>
              <path
                transform="translate(18.185 20.951)"
                d="M143.485 2.21632C146.871 0.261517 151.042 0.261518 154.428 2.21632L291.691 81.4644C295.077 83.4193 297.162 87.0329 297.162 90.9429V249.439C297.162 253.349 295.077 256.963 291.691 258.917L154.428 338.166C151.042 340.12 146.871 340.12 143.485 338.166L6.222 258.917C2.8359 256.963 0.75032 253.349 0.75032 249.439V90.9429C0.75032 87.0329 2.8359 83.4193 6.222 81.4644L143.485 2.21632Z"
                stroke="#999999"
                stroke-width="1.5"></path>
            </svg>

            <div class="relative z-10 flex flex-col items-center gap-3">
              <p
                class="m-0 text-center font-body font-medium text-vault-navy text-[22px] leading-[34px]"
              >
                Compliance<br />Data Platform
              </p>
              <div class="flex w-full flex-col gap-2.5">
                {
                  platformPills.map((pill) => (
                    <span class="flex items-center justify-center rounded-3xl border border-neutral-200 bg-generic-00 py-1.5 px-3 text-center font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-nova-blue">
                      {pill}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Reversed, so index 0 is the column nearest the platform and index
               7 is this fan's outer edge. The sweep orders are therefore the
               mirror of the left fan's, which is what makes the two run toward
               each other rather than both left to right. -->
          <svg
            class="ih-dl-dots block shrink-0"
            width={FAN_W}
            height={FAN_H}
            viewBox={`0 0 ${FAN_W} ${FAN_H}`}
            aria-hidden="true"
          >
            {
              [...dotColumns]
                .reverse()
                .flatMap((h, i) =>
                  Array.from({ length: dotsIn(h) }, (_, k) => (
                    <circle
                      cx={i * COL_PITCH + DOT / 2}
                      cy={dotY(h, k)}
                      r={DOT / 2}
                      style={`--ih-dl-t:${dotT(LAST - i, h, k)}s`}
                    />
                  )),
                )
            }
          </svg>
        </div>

        <div
          class="flex flex-1 flex-col items-center gap-6 rounded-xl border border-[#CCCCCC] bg-generic-00 p-6 max-lg:w-full max-lg:max-w-[420px] lg:min-w-0"
        >
          <h3
            class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]"
          >
            Yours Taxes
          </h3>
          <div class="flex w-full flex-1 flex-col gap-2">
            {
              portals.map((tile) => (
                <div class="flex h-14 flex-1 items-center justify-center rounded-lg border border-[#CCCCCC] px-3">
                  {tile.src ? (
                    <img
                      src={tile.src}
                      alt={tile.name}
                      class="max-h-[30px] w-auto max-w-full object-contain"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="font-body font-medium text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                      {tile.name}
                    </span>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Prevent / Automate / Detect. Still its own data-ih-lit so the styles
           can reach it, but it no longer carries a centre probe: the overlines
           take Nova Blue on the DIAGRAM's crossing, at the same instant as the
           dots, and hold it while this row is still on screen. The script has
           the reason that hold exists. -->
      <div class="flex w-full items-stretch max-lg:flex-col max-lg:gap-4" data-ih-lit>
        {
          stages.map((stage, i) => (
            <>
              {i > 0 && (
                <span
                  class="h-0.5 w-10 shrink-0 self-center bg-[#CCCCCC] max-lg:hidden"
                  aria-hidden="true"
                />
              )}
              <div class="flex flex-1 flex-col items-center gap-6 rounded-xl border border-[#CCCCCC] p-6 lg:min-w-0">
                <div class="flex w-full flex-col items-center gap-3 text-center">
                  <div class="flex w-full flex-col items-center gap-2">
                    <p class="ih-dl-overline m-0 font-body font-semibold uppercase tracking-[1px] text-neutral-500 text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)]">
                      {stage.overline}
                    </p>
                    <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                      {stage.title}
                    </p>
                  </div>
                  <p class="m-0 w-full font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                    {stage.body}
                  </p>
                </div>
              </div>
            </>
          ))
        }
      </div>

      <a
        href="https://cleartax.in/s/clear-compliance-cloud"
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-nova-blue bg-generic-00 px-5 py-3.5 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-blue no-underline shadow-[0px_2px_6px_rgba(16,24,40,0.06)] transition-opacity duration-200 hover:opacity-80"
      >
        Explore Clear Compliance Cloud
      </a>
    </div>
  </div>
</section>

<style is:global>
  /* One dot every 26px down a 4px column — the design's 4px dot on a 22px gap.
     The count comes off each column's Figma height in the frontmatter, and it
     is the counts that give the two fans their taper.

     THESE WERE ONE REPEATING radial-gradient PER COLUMN. The gradient was the
     cheaper drawing by a mile — two declarations against a hundred and
     thirty-two shapes — but it can only hold one colour at a time, and the
     sweep needs every dot to change on its own schedule. A column's worth of
     dots changing together is the coarse, smeary version of this; see the
     frontmatter.

     They are SVG circles rather than styled boxes because of the body zoom —
     the reason is on the markup, next to the <svg>.

     Geometry is unchanged: 4px round dots on a 26px pitch, so every column
     still occupies exactly the n×26−22 height Figma drew.

     #A6C705 is NOT Flux Lime (#C8F006) and must not become it. The brand allows
     one instance of Flux Lime per screen and this page already spends it on the
     hero's headline mark. */
  .ih-dl-dots circle {
    fill: #a6c705;

    /* EXACTLY TWICE THE RING STEP, which is not a coincidence and should not be
       tuned without recomputing it. The rings are 0.05s apart, so at 0.1s a dot
       finishes changing at the very moment the ring two behind it starts: the
       front is continuous with no overlap to spare, which is the narrowest a
       moving edge can be while still being an edge rather than a sequence of
       blinks. Two rings deep is around a dozen dots of the hundred and
       thirty-two — the other hundred and twenty are flatly one colour or the
       other, which is what keeps this a sweep and not a gradient.

       Shorter and the front breaks apart; longer and the part-coloured band
       widens into the ramp this is meant to avoid.

       The OUT delay is derived, not stored — (the sweep's last moment − this
       dot's own) is its mirror, so leaving unwinds from the platform back out
       to the edges. It belongs on this rule and not the lit one because a
       transition uses the delay declared on the state it is moving TO. */
    transition: fill 0.1s ease;
    transition-delay: calc(var(--ih-dl-max, 0s) - var(--ih-dl-t, 0s));
  }

  /* `stroke` is a genuinely animatable property, so the rings do not need the
     currentColor indirection the dots do — they ease from the resting grey
     straight to Nova Blue. The per-path `opacity` and `stroke-width` are left
     alone, which is what keeps the three rings reading as three depths in the
     lit state as well as the resting one.

     The `stroke="#999999"` presentation attributes stay on the paths: they are
     the lowest-priority source, so this rule wins, and they keep the hexagon
     drawn correctly if the section is ever rendered without its CSS.

     --ih-dl-t is set on the <svg>, not here; custom properties inherit, so the
     paths pick it up. It is set to --ih-dl-max itself, so this derived OUT
     delay comes out at zero: the platform is the last thing to arrive and the
     first to let go.

     Longer than a dot's 0.15s because this is one element rather than a front
     of many — nothing else is moving by the time it runs, so it is the sweep
     settling rather than part of the edge. */
  .ih-dl-hex path {
    stroke: #999999;
    transition: stroke 0.45s ease;
    transition-delay: calc(var(--ih-dl-max, 0s) - var(--ih-dl-t, 0s));
  }

  /* The stage overlines keep their resting grey from the `text-neutral-500`
     utility rather than restating it here — only the transition is ours, which
     is a different property so the two never fight. The lit rule below is
     (0,3,0) against the utility's (0,1,0), so it wins on specificity and does
     not depend on whether the embed or the page bundle is pasted first. */
  .ih-dl-overline {
    transition: color 0.6s ease;
  }

  /* Lit state — this block is in the middle of the viewport. Figma ships it as
     a second variant: the lime fans, the grey rings and the stage overlines all
     take Nova Blue, and nothing else moves. It is a state, not a one-way latch,
     so the same transition runs in reverse on the way back out.

     Scoped to [data-ih-lit] rather than the section because the diagram and the
     stage row hold the state separately — they are given it by the same
     crossing, but the stage row keeps it a little longer. See the script. */
  /* THE SWEEP, and the IN order. The platform turns first and both fans open
     outward from it at the same instant, dot by dot in order of how far each one
     is from it — so each front is an arc leaving the platform, and the two outer
     edges are the last thing to change.

     Every dot's own moment is inline as --ih-dl-t. Nothing here is a stagger
     step: the spacing between dots comes out of the geometry, which is why the
     front stays even where the columns get shorter. */
  [data-ih-lit].is-lit .ih-dl-dots circle {
    fill: var(--color-nova-blue);
    transition-delay: var(--ih-dl-t, 0s);
  }

  [data-ih-lit].is-lit .ih-dl-hex path {
    stroke: var(--color-nova-blue);
    transition-delay: var(--ih-dl-t, 0s);
  }

  [data-ih-lit].is-lit .ih-dl-overline {
    color: var(--color-nova-blue);
  }

  /* THE TRIGGER. A 1px probe pinned to the diagram's own vertical centre, and
     the only thing the centring observer watches. There is one of these in the
     section, not one per block: the diagram's crossing lights everything.

     Observing the block itself cannot express "centred". An IntersectionObserver
     reports overlap, so a block taller than the root band lights the moment its
     leading edge clips that band — with the old -25% margins the diagram was
     still sitting low on the screen, half of it below the fold, when the sweep
     had already run. Widening or narrowing the band does not fix it: for a tall
     target, ANY band still triggers on the edge.

     A zero-height probe has no edges to speak of, so "the probe is inside the
     band" and "the block's centre is within half a band of the viewport's
     centre" are the same statement. That is the trigger this needs.

     It is `left: 0; width: 1px` rather than a full-width bar because the block
     is a flex row: a stretched absolute child is still out of flow and cannot
     disturb it, but a 1px box makes that obvious to the next reader. */
  .ih-dl-centre {
    position: absolute;
    left: 0;
    top: 50%;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* Someone who asked for less motion still gets both states, just without the
     travel between them — and without the sweep, which becomes both states at
     once and nothing in between.

     The delays have to go as well as the transitions. Leave them and a reduced
     motion user gets no fade but still waits well over a second for the last
     column to snap, which is the same staggered effect delivered worse. */
  @media (prefers-reduced-motion: reduce) {
    .ih-dl-dots circle,
    [data-ih-lit].is-lit .ih-dl-dots circle,
    .ih-dl-hex path,
    [data-ih-lit].is-lit .ih-dl-hex path,
    .ih-dl-overline {
      transition: none;
      transition-delay: 0s;
    }
  }
</style>

<script is:inline>
  (function () {
    const root = document.querySelector("[data-ih-datalayer]");
    if (!root) return;

    const blocks = Array.from(root.querySelectorAll("[data-ih-lit]"));
    const probe = root.querySelector(".ih-dl-centre");

    // Without IntersectionObserver they land lit rather than stuck grey.
    if (!blocks.length) return;
    if (!("IntersectionObserver" in window) || !probe) {
      blocks.forEach((block) => block.classList.add("is-lit"));
      return;
    }

    // ONE crossing drives the whole section, and it is the diagram's. The
    // overlines used to watch their own row, which meant they turned blue a
    // screenful after the dots did — two versions of the same idea arriving
    // separately instead of one thing happening.
    const diagram = probe.closest("[data-ih-lit]");
    const followers = blocks.filter((block) => block !== diagram);

    // What is observed is the 1px probe at the diagram's CENTRE, not the block —
    // see .ih-dl-centre. Against a band this narrow, a probe crossing it means
    // the diagram's own middle is within 12% of the viewport's middle, which is
    // the "properly centred" this is meant to wait for. Observing the block
    // instead would fire on its leading edge however the band were tuned.
    let centred = false;
    // Whether the followers are still on screen, and whether they lit with the
    // diagram and have not left since.
    let inView = false;
    let held = false;

    // The HOLD is what makes one shared crossing safe. On its own, driving the
    // overlines straight off the diagram would drop them back to grey at the
    // exact moment you scrolled down to read them — the diagram leaves the
    // centre long before the stage row reaches it. So they light with the dots
    // and stay lit until their own row is gone.
    //
    // `held` can only ever be set by `centred`, never by visibility alone. That
    // is what keeps the two in step coming UP the page as well: arriving from
    // below, the stage row is on screen for a while before the diagram centres,
    // and without that rule the overlines would light first.
    function apply() {
      if (centred) held = true;
      if (!inView) held = false;
      diagram.classList.toggle("is-lit", centred);
      followers.forEach((block) => block.classList.toggle("is-lit", centred || held));
    }

    // Deliberately NOT the latch the stepped rail in `ClarityAi.astro` uses:
    // this tracks both ways, so the section lights on the way in and returns to
    // its resting colour on the way out, every pass. The observers stay
    // connected for the life of the page — which is cheap, because an
    // IntersectionObserver only wakes on a crossing and the page carries no
    // scroll listener either way.
    new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          centred = entry.isIntersecting;
        });
        apply();
      },
      // A band 24% of the viewport tall, centred: ±12% either side of the
      // middle. Tight enough that the diagram really is centred, loose enough
      // that stopping to read it lands inside rather than just past it.
      { rootMargin: "-38% 0px -38% 0px", threshold: 0 },
    ).observe(probe);

    if (followers.length) {
      // No margin here on purpose: this is "still on screen at all", not
      // "centred". It only ever extends a state the diagram already granted.
      const seen = new Set();
      const holder = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) seen.add(entry.target);
          else seen.delete(entry.target);
        });
        inView = seen.size > 0;
        apply();
      }, { threshold: 0 });
      followers.forEach((block) => holder.observe(block));
    }
  })();
</script>
