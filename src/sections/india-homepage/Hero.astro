                      <path d="M10.9044 1.87938C10.3179 1.28662 9.62009 0.81548 8.8511 0.492974C8.0821 0.170468 7.257 0.00294047 6.42313 0H6.375C4.68424 0 3.06274 0.67165 1.86719 1.86719C0.67165 3.06274 0 4.68424 0 6.375V9.875C0 10.2397 0.144866 10.5894 0.402728 10.8473C0.660591 11.1051 1.01033 11.25 1.375 11.25H2.375C2.73967 11.25 3.08941 11.1051 3.34727 10.8473C3.60513 10.5894 3.75 10.2397 3.75 9.875V7.375C3.75 7.01033 3.60513 6.66059 3.34727 6.40273C3.08941 6.14487 2.73967 6 2.375 6H0.7625C0.857629 4.57624 1.4903 3.24185 2.53238 2.26708C3.57447 1.2923 4.94807 0.749996 6.375 0.75H6.4175C7.83846 0.756307 9.20402 1.3019 10.2381 2.27647C11.2722 3.25105 11.8977 4.58191 11.9881 6H10.375C10.0103 6 9.66059 6.14487 9.40273 6.40273C9.14487 6.66059 9 7.01033 9 7.375V9.875C9 10.2397 9.14487 10.5894 9.40273 10.8473C9.66059 11.1051 10.0103 11.25 10.375 11.25H12V11.375C12 11.806 11.8288 12.2193 11.524 12.524C11.2193 12.8288 10.806 13 10.375 13H6.875C6.77554 13 6.68016 13.0395 6.60983 13.1098C6.53951 13.1802 6.5 13.2755 6.5 13.375C6.5 13.4745 6.53951 13.5698 6.60983 13.6402C6.68016 13.7105 6.77554 13.75 6.875 13.75H10.375C11.0049 13.75 11.609 13.4998 12.0544 13.0544C12.4998 12.609 12.75 12.0049 12.75 11.375V6.375C12.7531 5.54109 12.5917 4.71476 12.275 3.94333C11.9583 3.1719 11.4926 2.47052 10.9044 1.87938ZM2.375 6.75C2.54076 6.75 2.69973 6.81585 2.81694 6.93306C2.93415 7.05027 3 7.20924 3 7.375V9.875C3 10.0408 2.93415 10.1997 2.81694 10.3169C2.69973 10.4342 2.54076 10.5 2.375 10.5H1.375C1.20924 10.5 1.05027 10.4342 0.933058 10.3169C0.815848 10.1997 0.75 10.0408 0.75 9.875V6.75H2.375ZM9.75 9.875V7.375C9.75 7.20924 9.81585 7.05027 9.93306 6.93306C10.0503 6.81585 10.2092 6.75 10.375 6.75H12V10.5H10.375C10.2092 10.5 10.0503 10.4342 9.93306 10.3169C9.81585 10.1997 9.75 10.0408 9.75 9.875Z" fill="black"/>
