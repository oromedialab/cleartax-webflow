                      </svg>
                    )}
                    {b.icon === "robot" && (
                      <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M17.7598 7.19998H6.23982C5.17944 7.19998 4.31982 8.05959 4.31982 9.11998V18.08C4.31982 19.1404 5.17944 20 6.23982 20H17.7598C18.8202 20 19.6798 19.1404 19.6798 18.08V9.11998C19.6798 8.05959 18.8202 7.19998 17.7598 7.19998Z"
                          stroke="#05022A"
