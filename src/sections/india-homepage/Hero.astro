---
/**
 * India homepage hero — Figma node 13275:26865.
 *
 * Same construction as `global-homepage/Hero.astro`; the only content
 * difference is the middle badge, which reads "AI hallucinations" here rather
 * than "AI output you can't trust". Copied rather than shared because a page's
 * CSS entry only sources its own section folder, so a section imported across
 * folders would compile none of its utilities into this bundle.
 *
 * Background is the interactive stroke field from
 * `sections/global-invoicing/Hero.astro` (originally
 * `sections/blog-listing/Newsletter.astro`, which carries the full explanation of
 * the geometry): a plain grid of lime dots until a pointer enters, at which point
 * each dot draws out into a stroke aimed at the cursor, longest beside it and back
 * to a dot by `lengthRadius`. Same four gradient layers over it — page gradient,
 * radial wash behind the copy, a mobile-only top fade, and a bottom fade.
 *
 * Ids and the canvas id are `ih-`prefixed rather than the `hero` /
 * `hero-dots-canvas` those files use, because embeds share one namespace per page
 * and a bare `hero` is exactly the kind of name that collides later.
 *
 * The badge icons are the exported Figma vectors (HardDrives / Robot / Headset),
 * two-tone by design — navy body, Nova Blue accent. `black` in the export is the
 * unresolved brand token, so it maps to `currentColor` and the box sets the navy.
 */
interface Props {
  /** Stroke width, and so the diameter of the dot it becomes at rest. */
  lineWidth?: number;
  gap?: number;
  /** Must stay under the grid pitch or the field knits into a mesh. */
  maxLength?: number;
  lengthRadius?: number;
  /** Leave at 1 — a partial turn makes strokes flip as the cursor crosses them. */
  tilt?: number;
  baseColor?: string;
  cursorRadius?: number;
  pull?: number;
  fadeRadius?: number;
}

const {
  lineWidth = 2,
  gap = 24,
  maxLength = 6,
  lengthRadius = 260,
  tilt = 1,
  baseColor = "#C8F006",
  cursorRadius = 320,
  pull = 14,
  fadeRadius = 40,
} = Astro.props;

const badges = [
  { label: "Messy data", icon: "harddrives" },
  { label: "AI hallucinations", icon: "robot" },
  { label: "dependence on IT", icon: "headset" },
];
---

<section
  id="ih-hero"
  class="ih-hero relative overflow-hidden bg-[linear-gradient(180deg,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(242,_241,_240,_0.25)_87.79%,_#FFF_100%)]"
  data-line-width={String(lineWidth)}
  data-gap={String(gap)}
  data-max-length={String(maxLength)}
  data-length-radius={String(lengthRadius)}
  data-tilt={String(tilt)}
  data-base-color={baseColor}
  data-cursor-radius={String(cursorRadius)}
  data-pull={String(pull)}
  data-fade-radius={String(fadeRadius)}
>
  <!-- Interactive stroke field -->
  <div class="absolute inset-0 z-0 w-full h-full pointer-events-none">
    <canvas id="ih-hero-dots" class="absolute inset-0 w-full h-full"></canvas>
  </div>

  <!-- Radial wash, so the headline keeps its contrast over the field -->
  <div
    class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_rgba(255,255,255,1)_30%,_rgba(255,255,255,0.7)_40%,_rgba(255,255,255,0)_65%)] pointer-events-none"
  >
  </div>

  <!-- Narrow viewports get a top fade instead, where the radial is too tight -->
  <div
    class="absolute inset-0 z-0 bg-gradient-to-b from-white/85 via-white/50 to-transparent hidden max-[630px]:block pointer-events-none"
  >
  </div>

  <!-- Bottom fade, blending the field into the section below -->
  <div
    class="absolute bottom-0 inset-x-0 h-48 bg-gradient-to-t from-white via-white/50 to-transparent pointer-events-none z-0"
  >
  </div>

  <div class="container mx-auto relative z-10">
    <div
      class="flex flex-col items-center gap-6 text-center max-lg:pt-32 max-lg:pb-16 lg:pt-[257px] lg:pb-[161px]"
    >
      <div class="flex flex-col items-center gap-6 w-full">
        <h1
          class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-display-xl)] leading-[length:var(--lh-display-xl)] tracking-[-1px] max-w-[1280px]"
        >
          Close the gap between <br class="max-md:hidden" />AI’s promise and{" "}
          <span class="ih-hero-mark">finance reality</span>
        </h1>

        <div class="flex flex-col items-center gap-4">
          <p
            class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] max-w-[486px]"
          >
            Fix the three things holding AI back in finance
          </p>

          <div class="flex flex-wrap items-center justify-center gap-2">
            {
              badges.map((b) => (
                <span class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-neutral-200 bg-generic-00 px-3 py-1.5 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-neutral-700 font-body">
                  <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center text-vault-navy">
