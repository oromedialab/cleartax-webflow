                          stroke-width="1.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                        <path
                          d="M12 7.20003V4.00003"
                          stroke="#05022A"
                          stroke-width="1.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                        <path
                          d="M8.48002 12.3199C9.01021 12.3199 9.44002 11.8901 9.44002 11.3599C9.44002 10.8297 9.01021 10.3999 8.48002 10.3999C7.94983 10.3999 7.52002 10.8297 7.52002 11.3599C7.52002 11.8901 7.94983 12.3199 8.48002 12.3199Z"
                          fill="#5446FF"
                        />
                        <path
                          d="M15.5201 12.3199C16.0503 12.3199 16.4801 11.8901 16.4801 11.3599C16.4801 10.8297 16.0503 10.3999 15.5201 10.3999C14.9899 10.3999 14.5601 10.8297 14.5601 11.3599C14.5601 11.8901 14.9899 12.3199 15.5201 12.3199Z"
                          fill="#5446FF"
                        />
                      </svg>
                    )}
                    {b.icon === "headset" && (
                      <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M19.3845 16.9231V17.5384C19.3845 18.1913 19.1251 18.8174 18.6635 19.279C18.2019 19.7406 17.5758 20 16.9229 20H12.6152"
                          stroke="#5446FF"
                          stroke-width="1.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                        <path
                          d="M19.3845 11.3846H16.9229C16.5965 11.3846 16.2835 11.5143 16.0526 11.7451C15.8218 11.9759 15.6922 12.289 15.6922 12.6154V15.6923C15.6922 16.0187 15.8218 16.3318 16.0526 16.5626C16.2835 16.7934 16.5965 16.9231 16.9229 16.9231H19.3845V11.3846ZM19.3845 11.3846C19.3845 10.4149 19.1935 9.45459 18.8223 8.55865C18.4512 7.6627 17.9073 6.84863 17.2216 6.1629C16.5358 5.47718 15.7218 4.93323 14.8258 4.56212C13.9299 4.19101 12.9696 4 11.9999 4C11.0301 4 10.0698 4.19101 9.17388 4.56212C8.27794 4.93323 7.46386 5.47718 6.77814 6.1629C6.09241 6.84863 5.54847 7.6627 5.17735 8.55865C4.80624 9.45459 4.61523 10.4149 4.61523 11.3846M4.61523 11.3846V15.6923C4.61523 16.0187 4.7449 16.3318 4.97572 16.5626C5.20653 16.7934 5.51958 16.9231 5.846 16.9231H7.07677C7.40319 16.9231 7.71624 16.7934 7.94706 16.5626C8.17787 16.3318 8.30754 16.0187 8.30754 15.6923V12.6154C8.30754 12.289 8.17787 11.9759 7.94706 11.7451C7.71624 11.5143 7.40319 11.3846 7.07677 11.3846H4.61523Z"
