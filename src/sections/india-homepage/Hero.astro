                          stroke-linejoin="round"
                        />
                        <path
                          d="M11.9998 12C16.0499 12 19.3332 10.2091 19.3332 8C19.3332 5.79086 16.0499 4 11.9998 4C7.94975 4 4.6665 5.79086 4.6665 8C4.6665 10.2091 7.94975 12 11.9998 12Z"
                          stroke="#5446FF"
                          stroke-width="1.2"
