---
/**
 * Careers hero — Figma node 14052:30126.
 *
 * Centred headline with a cluster of three photo cards bleeding off each edge.
 * The two clusters are mirror images: sizes descend towards the centre of the
 * page, so the largest card is the one being clipped by the viewport edge.
 *
 * The three card sizes are NOT a CSS `scale()` — Figma scales the border and
 * padding along with the box (1px/8px/12px → 0.85px/6.8px/10.2px →
 * 0.723px/5.78px/8.67px), so each step carries its own explicit geometry. A
 * transform would also blur the 1px hairline border at the two smaller steps.
 *
 * MOTION. The cards are SHOWN by default — the Figma frame is the resting state
 * and nothing animates on load. They hold there for two seconds, then slide
 * INWARDS, pass under the centre copy, and stay there.
 *
 * IT PLAYS ITSELF, ON A TIMER, AND IS NOT CONNECTED TO SCROLLING. This is the
 * hero: it is on screen the moment the page opens and needs no cue to say so.
 * Earlier versions hung the move on a scroll threshold — first on the hero
 * leaving the viewport, which ran the whole thing above the top edge with nobody
 * watching, then on a short scroll distance, which still meant a reader who
 * never scrolled never saw the artwork move, and left the animation answering to
 * the wheel long after it had made its point.
 *
 * IT RUNS ONCE PER VISIT AND DOES NOT REVERSE. Once the cards are behind the
 * copy they stay there for the rest of the page view — see the script. So the
 * resting layout above is what someone sees for the first two seconds and never
 * again, and the section afterwards is the copy on its own. That is the intended
 * end state.
 *
 * The pacing is slow — a two second hold, then a little over 1.7s of travel,
 * staggered by depth. These cards are the only artwork on the section, so the
 * move exists to show them, not to clear them out of the way, and it gets a
 * single chance to do it.
 *
 * That direction is deliberate and is what makes the section flash-proof. The
 * extractor emits this section's <style> ahead of its markup, so the browser can
 * lay the cards out and paint them before any script in this file runs. While
 * the HIDDEN state was the default, that paint showed cards in the wrong place
 * for a frame on every refresh, and no amount of moving the script fixed it.
 * With the visible state as the default there is nothing to establish before
 * first paint, and the problem cannot occur.
 *
 * HIDING IS OCCLUSION, NOT FADING. Cards stay fully opaque throughout; the only
 * thing concealing them is the opaque background on `.cp-hero-copy`, which they
 * pass under. Nothing animates opacity anywhere in this section, and the copy
 * has no entrance of its own — see the note on `.cp-hero-copy`.
 *
 * Artwork is still the Figma "Visual Placeholder" tint — no photography exists
 * for this page yet. Swap `.cp-hero-media` for an <img> once assets land; the
 * boxes already carry the final dimensions.
 *
 * Clusters are hidden below 1280px: at 416px of centred copy they start
 * colliding with the headline, and there is nothing to gain from a half-visible
 * card sitting under the text.
 */
const HEADING_LINES = ["Make an Impact", "That Matters"];
const LEDE =
  "Join our team and contribute to shaping the future of millions of Indians and businesses worldwide.";
const CTA_LABEL = "View current openings";
const CTA_HREF = "https://clear.darwinbox.in/ms/candidatev2/main/careers/home";
---

<section
  class="cp-hero relative overflow-hidden border-b border-[#CCCCCC] bg-generic-00"
>
  <!-- Left cluster. Bleeds 92px past the viewport edge, per Figma — but that
       offset is set in CSS, not here, because the travel distance is built from
       it. See `--cp-hero-edge`.
       `--1/--2/--3` is depth: 1 is the largest and outermost. -->
  <div
    class="cp-hero-cluster cp-hero-cluster--left absolute top-1/2 hidden -translate-y-1/2 items-center gap-8 xl:flex"
    aria-hidden="true"
  >
    <div
      class="cp-hero-card cp-hero-card--1 shrink-0 overflow-hidden rounded-[12px] border border-[#CCCCCC] bg-generic-00 p-2"
    >
      <div class="cp-hero-media h-[221px] w-[170px] rounded-lg bg-visual-placeholder"></div>
    </div>
    <div
      class="cp-hero-card cp-hero-card--2 shrink-0 overflow-hidden rounded-[10.2px] border-[0.85px] border-[#CCCCCC] bg-generic-00 p-[6.8px]"
    >
      <div
        class="cp-hero-media h-[187.85px] w-[144.5px] rounded-[6.8px] bg-visual-placeholder"
      >
      </div>
    </div>
    <div
      class="cp-hero-card cp-hero-card--3 shrink-0 overflow-hidden rounded-[8.67px] border-[0.723px] border-[#CCCCCC] bg-generic-00 p-[5.78px]"
    >
      <div
        class="cp-hero-media h-[159.673px] w-[122.825px] rounded-[5.78px] bg-visual-placeholder"
      >
      </div>
    </div>
  </div>

  <!-- Right cluster — the mirror, so the order reverses: smallest nearest the
       copy. It bleeds 119px, NOT 92: the two clusters are not symmetric, which
       is why the edge offset has to be a variable the travel can read. -->
  <div
    class="cp-hero-cluster cp-hero-cluster--right absolute top-1/2 hidden -translate-y-1/2 items-center gap-8 xl:flex"
    aria-hidden="true"
  >
    <div
      class="cp-hero-card cp-hero-card--3 shrink-0 overflow-hidden rounded-[8.67px] border-[0.723px] border-[#CCCCCC] bg-generic-00 p-[5.78px]"
    >
      <div
        class="cp-hero-media h-[159.673px] w-[122.825px] rounded-[5.78px] bg-visual-placeholder"
      >
      </div>
    </div>
    <div
      class="cp-hero-card cp-hero-card--2 shrink-0 overflow-hidden rounded-[10.2px] border-[0.85px] border-[#CCCCCC] bg-generic-00 p-[6.8px]"
    >
      <div
        class="cp-hero-media h-[187.85px] w-[144.5px] rounded-[6.8px] bg-visual-placeholder"
      >
      </div>
    </div>
    <div
      class="cp-hero-card cp-hero-card--1 shrink-0 overflow-hidden rounded-[12px] border border-[#CCCCCC] bg-generic-00 p-2"
    >
      <div class="cp-hero-media h-[221px] w-[170px] rounded-lg bg-visual-placeholder"></div>
    </div>
  </div>

  <div
    class="container relative mx-auto flex min-h-[520px] flex-col items-center justify-center py-20 text-center xl:min-h-[720px]"
  >
    <div class="cp-hero-copy flex flex-col items-center gap-6">
      <h1
        class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-display-lg)] leading-[length:var(--lh-display-lg)] tracking-[-1px]"
      >
        {HEADING_LINES[0]}<br />{HEADING_LINES[1]}
      </h1>

      <div class="flex w-full flex-col items-center gap-4">
        <p
          class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
        >
          {LEDE}
        </p>
        <a
          href={CTA_HREF}
          class="cp-btn inline-flex items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 font-body font-medium text-nova-50 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)]"
        >
          {CTA_LABEL}
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Shared button treatment for this page. Defined once here rather than
     re-declared in JoinUs.astro — both embeds land on the same page, so the
     second copy would be dead bytes against the 50 KB cap. Prefixed `cp-`
     because section CSS is one flat namespace per Webflow page. */
  .cp-btn {
    box-shadow: 0 2px 3px rgba(16, 24, 40, 0.06);
    transition:
      background-color var(--transition-base, 250ms ease),
      border-color var(--transition-base, 250ms ease),
      transform var(--transition-fast, 150ms ease);
  }

  .cp-btn:hover {
    background-color: var(--color-nova-600, #5336f5);
    border-color: var(--color-nova-600, #5336f5);
    transform: translateY(-1px);
  }

  .cp-hero-copy {
    /* THIS BOX IS THE ONLY THING HIDING THE CARDS, so it must never be
       transparent or animated. It deliberately has NO entrance of its own: it
       used to fade in, and an opacity below 1 here makes the whole subtree —
       background included — see-through, so the parked cards showed straight
       through the "mask". Anything added here must keep it opaque.

       Invisible by design: white on a white section, exactly as the Figma frame
       draws it. Nothing is rendered; it only occludes. */
    background: var(--color-generic-00, #fff);
    /* Sized to hide a card rather than to fit the text. Figma's 416px is the
       CONTENT width and is preserved exactly — box-sizing is border-box
       site-wide, so 640 − 2x112 = 416. Every extra pixel goes into the padding,
       so the box grows outwards as a mask while the text wraps exactly where it
       did at Figma's own width. Nothing here is visible: white on a white
       section, so a wider box changes only what it covers.

       It has to be here rather than as a `max-w-[416px]` utility in the markup:
       the padding and the max-width have to move together — 416 is the invariant
       — and splitting them across the two would let one be changed without the
       other.

       WHY SO MUCH COVER. The widest card is 188px, so its centre landing on the
       page centre leaves 226px of clearance either side — far more than a mask
       needs. That margin is deliberate slack, not a fit. Since the cards never
       fade, anything they fail to clear is a solid grey corner sitting beside
       the headline rather than a soft edge, and the cost of the slack is zero:
       the box is white on a white section, so widening it changes only what it
       covers. It absorbs the half-scrollbar the `vw` in --cp-hero-half
       overshoots by, and leaves room for the card geometry to be revised — for
       real photography, say — without this having to be revisited.

       Do NOT narrow this back towards the card width to "tighten" it. It is the
       only thing hiding the cards, and it is invisible either way. */
    max-width: 640px;
    padding-block: 36px;
    padding-inline: 112px;
  }

  /* HALF THE PAGE, IN THE CARDS' OWN COORDINATES. Every card has to end up with
     its centre on the page centre, so the travel is built from this.

     It is NOT simply `50vw`. shared.css zooms `body` to --page-zoom between
     768px and 1439.98px, and `vw` keeps resolving against the UNZOOMED viewport
     while `translateX` moves the card through zoomed layout space. At 1280px —
     the width at which these clusters first appear — the page is 1505px wide in
     the coordinates the transform uses, so an uncorrected 50vw is 640px against
     a real half of 752px and every card stopped ~112px short, in plain sight
     beside the headline. Dividing by the zoom converts the one into the other.

     The bounds are the same literals as the rule in shared.css and have to stay
     in step with them; they cannot read --page-zoom because media query bounds
     are evaluated before custom properties resolve. The `, 1` fallback is what
     makes this safe to paste anywhere: --page-zoom ships in tokens.css, which is
     imported by the same shared.css that applies the zoom, so a page without it
     has no zoom to correct for and the divisor is 1.

     `vw` also counts the scrollbar, which the layout width does not, so this
     overshoots by half a scrollbar (~9px zoomed). Overshoot is free — the card
     is under an opaque box with 226px of clearance either side — whereas
     undershoot is the bug. */
  .cp-hero {
    --cp-hero-half: 50vw;
  }

  @media (min-width: 768px) and (max-width: 1439.98px) {
    .cp-hero {
      --cp-hero-half: calc(50vw / var(--page-zoom, 1));
    }
  }

  /* HOW FAR EACH CLUSTER BLEEDS. Declared here rather than as a `left-[-92px]`
     utility in the markup because the travel distance is measured from this
     edge — the two have to move together, exactly as --cp-hero-copy's padding
     and max-width do. Split across markup and CSS, changing the offset would
     silently leave the cards stopping short of centre again.

     THE CLUSTERS ARE NOT MIRRORS. 92 and 119 are what Figma draws, and the
     27px difference is real. Both clusters used to share one set of travel
     constants derived from the left one, so every right-hand card undershot by
     that 27px on top of the zoom error above. */
  .cp-hero-cluster--left {
    --cp-hero-edge: 92px;
    left: calc(var(--cp-hero-edge) * -1);
  }

  .cp-hero-cluster--right {
    --cp-hero-edge: 119px;
    right: calc(var(--cp-hero-edge) * -1);
  }

  /* Which way in. Left cluster tucks to the RIGHT, towards the centre; the right
     cluster mirrors it. */
  .cp-hero-cluster--left .cp-hero-card {
    --cp-hero-dir: 1;
  }

  .cp-hero-cluster--right .cp-hero-card {
    --cp-hero-dir: -1;
  }

  /* DEPTH. `--cp-o` is the resting opacity from the Figma frame, moved out of
     the markup (it was `opacity-80`/`opacity-40`) so it is declared alongside
     the rest of each card's depth. It is STATIC — nothing animates opacity in
     this section.

     `--cp-hero-depth` is how far this card's centre sits from the OUTER end of
     its own cluster: half its own width, plus every larger card and 32px gap
     outboard of it. Being measured from the cluster rather than from the
     viewport is the whole point — it is the one part of the geometry that is
     identical in both clusters and at every viewport width, so it composes with
     --cp-hero-edge to give a correct distance on both sides.

       card 1   188 / 2                                    =  94
       card 2   188 + 32 + 159.8 / 2                       = 299.9
       card 3   188 + 32 + 159.8 + 32 + 135.831 / 2        = 479.716

     The widths are border-box totals of the three geometries in the markup
     (170+16+2, 144.5+13.6+1.7, 122.825+11.56+1.446) and 32px is `gap-8`. Change
     a card's size, padding, border or the gap and these move with it.

     The delay runs innermost-first, so the group packs from the inside — the
     smallest card leaves first and the largest, outermost one last, which keeps
     the cluster reading as a cluster the whole way rather than as three cards
     that happen to move together. There is no unpacking; the move never
     reverses. */
  .cp-hero-card--1 {
    --cp-o: 1;
    --cp-hero-depth: 94px;
    --cp-delay: 0.28s;
  }

  .cp-hero-card--2 {
    --cp-o: 0.8;
    --cp-hero-depth: 299.9px;
    --cp-delay: 0.14s;
  }

  .cp-hero-card--3 {
    --cp-o: 0.4;
    --cp-hero-depth: 479.716px;
    --cp-delay: 0s;
  }

  /* SHOWN IS THE DEFAULT. No class, no transform — the cards render exactly
     where Figma puts them, from the first frame, with no script involved.

     The card's resting centre is `edge` outboard of the viewport edge and
     `depth` back inboard from there, so the distance from that centre to the
     page centre is half the page, plus the bleed, minus the depth. One
     expression covers all six cards; nothing here is per-card except the two
     variables it reads. */
  .cp-hero-card {
    --cp-hero-travel: calc(
      var(--cp-hero-half, 50vw) + var(--cp-hero-edge, 0px) - var(--cp-hero-depth, 0px)
    );
    opacity: var(--cp-o, 1);
    will-change: transform;
  }

  /* TUCKED BEHIND THE CENTRE BLOCK, AT FULL OPACITY AND FULL SIZE. Nothing
     fades: the card is out of sight because `.cp-hero-copy`'s background covers
     it, which is what "behind the content" means — so it stays completely solid
     the whole way and simply goes under the edge of that box. Fading was the
     wrong tool: with the block invisible (white on a white section) an opacity
     change is the ONLY thing you can see, so the card read as dissolving in mid
     air rather than sliding under something.

     Sideways travel is the ONLY thing that changes, for the same reason. This
     used to carry a `scale(0.94)`, and shrinking reads as receding — the card
     looked like it was being put away into the distance instead of slipping
     behind a nearer object. Anything that is not lateral movement turns a tuck
     into a departure. */
  .cp-hero.is-out .cp-hero-card {
    transform: translateX(calc(var(--cp-hero-travel, 0px) * var(--cp-hero-dir, 1)));
  }

  /* TRANSITIONS ARE GATED BEHIND `.is-animated`, which the script adds a couple
     of frames in, AFTER it has settled whether this page view gets the entrance
     at all. Nothing animates on arrival — a reload that lands below the hero
     finds its cards already tucked rather than playing a two-second entrance to
     an empty screen and finishing it mid-flight.

     The delay comes through a custom property because this is the `transition`
     SHORTHAND, which resets transition-delay to 0 — a separate
     `transition-delay` on the depth classes would be silently overwritten from
     here, and the innermost-first stagger would vanish.

     Only `transform` is listed, because only `transform` ever changes.

     THERE IS ONE TRANSITION, NOT TWO, because the move only ever runs one way.
     A transition is read from the style the element is moving TO, so this rule
     being on `.is-out` is what makes it the way IN. There used to be a matching
     `:not(.is-out)` rule owning the way back out; `.is-out` is now never removed
     (see the script), so that rule could never have applied and was deleted
     rather than left to look like live code.

     The curve leaves gently and holds its speed to the end. It is deliberately
     NOT an ease-out: decelerating into the copy makes a card look like it is
     parking next to the headline, when the whole point is that it carries on
     and goes under. It should still be moving when it disappears.

     THE DURATION IS DELIBERATELY UNHURRIED — this artwork is the only visual on
     the section, the move is the only thing that shows it off, and it now gets
     exactly one chance to do so. Together with the 0.14s step between depths a
     full pass runs a little over 1.7s, and the three cards read one at a time
     instead of as a single block sliding.

     Do not trim this to feel "snappier". A tuck that is over before the eye
     lands on it is the same as no artwork at all, which is what the section
     looked like when the cards were stopping short of the mask. */
  .cp-hero.is-animated.is-out .cp-hero-card {
    transition: transform 1.45s cubic-bezier(0.4, 0, 0.2, 1) var(--cp-delay, 0s);
  }

  /* DO NOT add a -50% Y offset to any transform here. `-translate-y-1/2` on the
     clusters does NOT compile to a transform in Tailwind v4 — it compiles to the
     separate `translate` property, which composes with `transform` rather than
     being overridden by it. Restating the centring would double it. Vertical
     centring belongs to `translate`; these rules touch X only. */

  @media (prefers-reduced-motion: reduce) {
    .cp-hero.is-out .cp-hero-card {
      transform: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var init = function () {
      var hero = document.querySelector(".cp-hero");
      if (!hero) return;

      // ON A TIMER, NOT ON SCROLL. This is the hero: it is already on screen
      // when the page opens, so the entrance plays itself. The cards hold in
      // their Figma positions for HOLD, then tuck away once and stay away.
      //
      // It used to be driven by a scroll threshold, and the two things a scroll
      // trigger cannot do are exactly what this section needs. It could not run
      // for someone who read the hero without scrolling — the artwork simply
      // never moved — and because scroll position is a LIVE value rather than an
      // event, every later scroll re-asked the question, so the move stayed
      // coupled to the wheel long after it had served its purpose. A timer is
      // the honest expression of "play once, on arrival": it has no input to
      // re-read and nothing to re-trigger it.
      //
      // HOLD is the beat before the move. It is not a delay to be tuned away —
      // it is the only time the cards are ever seen in the composition Figma
      // draws, so it has to be long enough to register as a layout rather than
      // as a frame that flickered past on the way to something else.
      var HOLD = 2000;

      // ARRIVING ALREADY PAST THE HERO. A reload part-way down the page, a
      // restored scroll position or a deep link all land with this section off
      // screen, and playing a two-second entrance to nobody would just mean the
      // cards are still mid-flight if the reader scrolls back up. In that case
      // jump straight to the end state, BEFORE transitions are armed below, so
      // it is a layout rather than an animation.
      var rect = hero.getBoundingClientRect();
      var onScreen = rect.bottom > 0 && rect.top < (window.innerHeight || 0);

      if (!onScreen) hero.classList.add("is-out");

      // Transitions stay off until the state above has been settled — adding
      // `is-animated` after `is-out` means the skipped case lands silently,
      // because the transform is already at its final value by the time there is
      // anything to transition.
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          hero.classList.add("is-animated");

          if (onScreen) {
            window.setTimeout(function () {
              hero.classList.add("is-out");
            }, HOLD);
          }
        });
      });

      // NOTHING IS LISTENED TO — no scroll, no resize, no observer. `is-out` is
      // written at most once per page view and never removed, so after the move
      // there is no state left to maintain. The travel distance still tracks a
      // resize on its own: `--cp-hero-travel` is resolved by CSS on every
      // layout, not cached by this script.
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
