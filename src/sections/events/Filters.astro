---
/**
 * "Watch our past Webinars & Events here" head + the Search / Type / Country /
 * Sort by bar — Figma node 14777:27059.
 *
 * THE HEAD AND THE BAR PIN TOGETHER, as one block, parked directly under the
 * navbar while the grid scrolls beneath them. The head is the title for that
 * grid, so it stays on screen for exactly as long as the grid it names — which
 * is also why both live in one section and inside one `[data-ev-filter-bar]`.
 *
 * The navbar is NOT hidden while this is pinned. It keeps `z-[1000]` and the
 * top of the screen; the block measures the navbar's bottom edge and parks
 * below it. Two fixed bars stacked, not one handing off to the other.
 *
 * Otherwise markup only. The filtering and sorting logic lives in
 * `Events.astro`, which owns the card grid, and reaches these controls through
 * the `data-ev-*` hooks below using document-level delegation — so it does not
 * matter which Embed element Webflow renders first.
 *
 * The Type and Country option lists must stay in sync with the `type` /
 * `country` values in `src/data/events.ts`. They are duplicated rather than
 * imported because this section is pasted into Webflow as an independent Embed
 * and a stale option is harmless (it just matches nothing) while a stale
 * *value* would make an event unreachable.
 *
 * Type, Country and Sort by are custom listboxes, not bare `<select>`s: a
 * native select paints its open list through the OS, so `appearance: none`
 * styles the closed control and nothing else — the list itself lands as Windows
 * chrome in the middle of the brand. The real `<select>` is still in the DOM,
 * screen-reader hidden, as the value store. Choosing an option writes to it and
 * fires a bubbling `change`, which is exactly what `Events.astro` already
 * listens for, so none of the grid logic knows this UI exists.
 */
const heading = 'Watch our past Webinars & Events here';
const subheading =
  'Revisit high-impact sessions covering critical trends, regulatory shifts, and transformation strategies';

/* Exactly the two values `EventItem.type` allows. This is a closed set, unlike
   Country — a third option here would be unreachable by construction. */
const types: string[] = ['Online', 'In person'];

const countries: string[] = [
  'Global',
  'India',
  'UAE',
  'Saudi Arabia',
  'Malaysia',
  'France',
  'Germany',
  'Singapore',
];

const fieldClass =
  'h-10 w-full rounded-lg border border-neutral-200 bg-generic-00 px-3 py-2 font-body font-normal text-[length:var(--fs-label)] leading-[var(--lh-label)] text-neutral-900 shadow-[0px_1px_2px_0px_rgba(16,24,40,0.04)] outline-none transition-colors duration-150 placeholder:text-neutral-400 focus:border-nova-blue';

const labelClass =
  'font-body font-medium text-[length:var(--fs-label)] leading-[var(--lh-label)] text-neutral-900';

/* The trigger has to line up with the search input to the pixel, so it starts
   from the same `fieldClass` and only adds what a button needs. */
const triggerClass = `${fieldClass} group flex cursor-pointer items-center justify-between gap-2 text-left aria-expanded:border-nova-blue data-[placeholder]:text-neutral-400`;

const panelClass =
  'absolute left-0 right-0 top-[calc(100%+6px)] z-20 hidden max-h-64 overflow-y-auto rounded-lg border border-neutral-200 bg-generic-00 p-1 shadow-[0px_12px_24px_-6px_rgba(16,24,40,0.12)]';

const optionClass =
  'group flex cursor-pointer items-center justify-between gap-2 rounded-md px-3 py-2 font-body font-normal text-[length:var(--fs-label)] leading-[var(--lh-label)] text-neutral-900 outline-none transition-colors duration-100 hover:bg-ledger-100 focus:bg-ledger-100 aria-selected:bg-nova-50 aria-selected:font-medium aria-selected:text-nova-blue';

/* One shape, rendered three times. `hook` carries the `data-ev-*` attribute the
   grid queries by, spread onto the native select.
 *
 * Topic and Country lead with an empty "Select" option — no choice means no
 * filter. Sort by has no empty state: the grid is always in one order or the
 * other, so its first option is also its default and the trigger never renders
 * in placeholder grey. */
type SelectOption = { value: string; label: string };

const selects: Array<{
  id: string;
  name: string;
  label: string;
  hook: Record<string, string>;
  options: SelectOption[];
  value: string;
  width: string;
}> = [
  {
    id: 'ev-filter-type',
    name: 'type',
    label: 'Type',
    hook: { 'data-ev-type': '' },
    options: [{ value: '', label: 'Select' }, ...types.map((t) => ({ value: t, label: t }))],
    value: '',
    width: 'md:flex-1 md:min-w-0',
  },
  {
    id: 'ev-filter-country',
    name: 'country',
    label: 'Country',
    hook: { 'data-ev-country': '' },
    options: [{ value: '', label: 'Select' }, ...countries.map((c) => ({ value: c, label: c }))],
    value: '',
    width: 'md:flex-1 md:min-w-0',
  },
  {
    id: 'ev-filter-sort',
    name: 'sort',
    label: 'Sort by',
    hook: { 'data-ev-sort': '' },
    options: [
      { value: 'new', label: 'New to old' },
      { value: 'old', label: 'Old to new' },
    ],
    value: 'new',
    width: 'md:flex-1 md:min-w-0',
  },
];
---

<!--
  THE SECTION IS A PURE SPACER; EVERY PIXEL OF THE BAND'S SPACING IS ON THE
  BLOCK INSIDE IT. The band's padding used to be split across the two (section
  pt-8/md:pt-20 + bar py-4) so the bar's height stayed constant while the head
  stayed behind.

  Now the head travels too, so the rule gets simpler and stricter: the
  block's box must be IDENTICAL pinned and unpinned, which means no
  `data-[pinned]:` padding, margin or border-width on it, ever. The section
  takes an explicit height the moment the block goes fixed, so the document
  height never changes and nothing below moves.

  It also means the pin threshold — the block's resting position, offset by the
  navbar's height — is the exact point where fixed and static render the block
  in the same place. The swap is a visual no-op, so jitter around the threshold
  cannot flicker. Shadow is the one thing that may change on pin: it paints
  outside the box and costs no layout.
-->
<section data-ev-filter-root class="bg-generic-00">
  <!-- The travelling block: head + controls, pinned as one unit.

       NOTHING MAY SIT ON THIS ELEMENT'S OUTSIDE — no `mt`, no `mb`. A fixed
       element is positioned by its MARGIN box, so a margin-top would park it
       that far below the navbar and leave a strip of grid scrolling through the
       gap. Spacing goes in the padding above, or on a child. -->
  <div
    data-ev-filter-bar
    class="bg-generic-00 border-b border-ledger-200 pt-12 pb-8 md:pt-20 md:pb-12 transition-shadow duration-200 data-[pinned]:shadow-[0px_2px_6px_0px_rgba(16,24,40,0.06)]"
  >
    <!-- The gap down to the controls is this element's `mb` — it is a child of
         the fixed block, not the block itself, so the margin-box rule above
         does not apply to it. -->
    <div class="container mb-6 md:mb-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between lg:gap-8">
        <h2
          class="font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[var(--lh-h1)] tracking-[var(--tracking-heading)] m-0 lg:max-w-[672px]"
        >
          {heading}
        </h2>
        <p
          class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[var(--lh-body-lg)] m-0 lg:max-w-[427px]"
        >
          {subheading}
        </p>
      </div>
    </div>

    <div class="container">
      <form
        data-ev-filter
        role="search"
        aria-label="Filter events"
        class="flex flex-col items-stretch justify-center gap-6 md:flex-row md:flex-wrap md:items-end md:gap-8"
      >
        <!-- Search -->
        <div class="flex w-full flex-col gap-2 md:w-[405px] md:shrink-0">
          <label class={labelClass} for="ev-filter-search">Search</label>
          <input
            id="ev-filter-search"
            name="search"
            type="search"
            autocomplete="off"
            placeholder="Enter"
            data-ev-search
            class={fieldClass}
          />
        </div>

        {
          selects.map((field) => (
            <div class={`flex w-full flex-col gap-2 ${field.width}`}>
              {/* A span, not a <label for>: the control it would point at is the
                  hidden select. The trigger names itself through aria-labelledby. */}
              <span class={labelClass} id={`${field.id}-label`}>
                {field.label}
              </span>

              <div class="relative" data-ev-select>
                <select
                  {...field.hook}
                  id={field.id}
                  name={field.name}
                  class="sr-only"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {field.options.map((option) => (
                    <option value={option.value} selected={option.value === field.value}>
                      {option.label}
                    </option>
                  ))}
                </select>

                <button
                  type="button"
                  data-select-trigger
                  data-placeholder={field.value === '' ? '' : undefined}
                  id={`${field.id}-button`}
                  role="combobox"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-controls={`${field.id}-list`}
                  aria-labelledby={`${field.id}-label ${field.id}-button`}
                  class={triggerClass}
                >
                  <span data-select-value class="truncate">
                    {field.options.filter((o) => o.value === field.value)[0].label}
                  </span>
                  <svg
                    class="shrink-0 text-neutral-500 transition-transform duration-150 group-aria-expanded:rotate-180"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>

                <div
                  data-select-panel
                  id={`${field.id}-list`}
                  role="listbox"
                  tabindex="-1"
                  aria-labelledby={`${field.id}-label`}
                  class={panelClass}
                >
                  {field.options.map((option) => (
                    <div
                      data-select-option
                      data-value={option.value}
                      role="option"
                      aria-selected={option.value === field.value ? 'true' : 'false'}
                      tabindex="-1"
                      class={optionClass}
                    >
                      <span class="truncate">{option.label}</span>
                      <svg
                        class="shrink-0 opacity-0 group-aria-selected:opacity-100"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </form>
    </div>
  </div>
</section>

<style is:global>
  /* THE STRIP ABOVE THE NAVBAR. `NavbarRb` is a floating card — `fixed top-4`
     — so there is a 16px gutter above it that the page scrolls through. On a
     normal page that gutter shows the page background and nobody notices. With
     this block pinned underneath, what slides through it is event cards, above
     the navbar, which reads as a rendering fault.

     So the block's white is extended upward to the top of the screen. The cap
     is `absolute` inside the `fixed` block, which is why it is safe: absolutely
     positioned boxes take no part in layout, so the block's own box stays
     byte-identical pinned and unpinned and the swap at the threshold is still a
     visual no-op. It exists only while `[data-pinned]` is set, and it paints
     under the navbar because the block carries z-index 900 to the navbar's
     1000.

     `50vh` rather than the measured navbar height: the excess simply extends
     off the top of the screen, and a fixed-element child cannot add scroll. No
     JS has to keep it in sync with a navbar it does not own. */
  [data-ev-filter-bar][data-pinned]::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    height: 50vh;
    background: var(--color-generic-00, #fff);
  }
</style>

<script is:inline>
  /* Custom listbox behaviour for Topic, Country and Sort by.

     The visible control is a button plus a panel of `role="option"` rows; the
     real `<select>` next to them stays the value store. Selecting writes to it
     and fires a bubbling `change`, so `Events.astro` filters and sorts exactly
     as it would have with native selects. */
  (function () {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
      var roots = document.querySelectorAll('[data-ev-select]');
      for (var i = 0; i < roots.length; i++) setup(roots[i]);
    }

    function setup(root) {
      var select = root.querySelector('select');
      var trigger = root.querySelector('[data-select-trigger]');
      var panel = root.querySelector('[data-select-panel]');
      var valueEl = root.querySelector('[data-select-value]');
      if (!select || !trigger || !panel || !valueEl) return;

      var options = panel.querySelectorAll('[data-select-option]');
      if (!options.length) return;

      // Inline display, not a class swap: the utilities pasted into Webflow are
      // unlayered, so `hidden` and `block` on one element would race on source
      // order. Inline always wins.
      function isOpen() {
        return trigger.getAttribute('aria-expanded') === 'true';
      }

      function open() {
        panel.style.display = 'block';
        trigger.setAttribute('aria-expanded', 'true');
        var current = panel.querySelector('[aria-selected="true"]') || options[0];
        if (current) {
          current.focus();
          // The selected row can be well down a scrolling panel.
          if (current.scrollIntoView) current.scrollIntoView({ block: 'nearest' });
        }
      }

      function close(returnFocus) {
        panel.style.display = 'none';
        trigger.setAttribute('aria-expanded', 'false');
        if (returnFocus) trigger.focus();
      }

      function choose(option) {
        var value = option.getAttribute('data-value');

        for (var i = 0; i < options.length; i++) {
          options[i].setAttribute('aria-selected', options[i] === option ? 'true' : 'false');
        }

        valueEl.textContent = option.textContent.trim();
        if (value) trigger.removeAttribute('data-placeholder');
        else trigger.setAttribute('data-placeholder', '');

        select.value = value;
        // Dispatched from the select, not the button, so the grid's delegated
        // listener sees the same event shape a native select would have sent.
        select.dispatchEvent(new Event('change', { bubbles: true }));

        close(true);
      }

      function step(from, delta) {
        var index = -1;
        for (var i = 0; i < options.length; i++) {
          if (options[i] === from) index = i;
        }
        var next = index + delta;
        if (next < 0) next = options.length - 1;
        if (next > options.length - 1) next = 0;
        options[next].focus();
        if (options[next].scrollIntoView) options[next].scrollIntoView({ block: 'nearest' });
      }

      trigger.addEventListener('click', function () {
        if (isOpen()) close(false);
        else open();
      });

      trigger.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault(); // or Space scrolls the page and Enter submits the form
          open();
        } else if (e.key === 'Escape') {
          close(false);
        }
      });

      panel.addEventListener('click', function (e) {
        if (!e.target.closest) return;
        var option = e.target.closest('[data-select-option]');
        if (option) choose(option);
      });

      panel.addEventListener('keydown', function (e) {
        if (!e.target.closest) return;
        var option = e.target.closest('[data-select-option]');
        if (!option) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          step(option, 1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          step(option, -1);
        } else if (e.key === 'Home') {
          e.preventDefault();
          options[0].focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          options[options.length - 1].focus();
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          choose(option);
        } else if (e.key === 'Escape') {
          e.preventDefault();
          close(true);
        } else if (e.key === 'Tab') {
          // Let focus go where it was heading, just don't leave the panel open
          // behind it.
          close(false);
        }
      });

      document.addEventListener('click', function (e) {
        if (!isOpen()) return;
        if (root.contains(e.target)) return;
        close(false);
      });
    }
  })();
</script>

<script is:inline>
  /* Pin the head + filter block directly under the navbar for the length of the
     event grid, then release it.

     `position: sticky` would be the obvious tool and is not available: Webflow
     wraps each pasted Embed in its own div, so a sticky section would be
     confined to a parent exactly its own height and never move at all. Hence
     the explicit fixed/static swap.

     Everything is queried from `document` and null-checked, because the navbar,
     this block and the grid are three separate Webflow Embeds and none of them
     can assume another is present or has mounted first. */
  (function () {
    // Deferred to DOM-ready on purpose. This Embed is pasted above the grid, so
    // at parse time `[data-ev-grid-root]` does not exist yet and setup would
    // bail every time.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
      var root = document.querySelector('[data-ev-filter-root]');
      if (!root) return;
      var block = root.querySelector('[data-ev-filter-bar]');
      var grid = document.querySelector('[data-ev-grid-root]');
      // No grid to scroll through means nothing to pin against — leave the
      // block in flow rather than sticking it to the top forever.
      if (!block || !grid) return;

      var navRoot = document.querySelector('[data-giwip-nav-root]');
      var navCard = navRoot ? navRoot.querySelector('[data-nav-card]') : null;

      // Stacked on a phone the head plus the form is most of a screen; pinning
      // it would leave no room for the grid it filters. Desktop layout only.
      var wideEnough = window.matchMedia('(min-width: 768px)');

      // Decelerating curve, not the symmetric material ease. The block enters
      // and leaves at the top of the screen where there is nothing to ease
      // against, so a slow finish reads as settling rather than stopping.
      var EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';
      var EXIT = 420;

      var reduceMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* TWO COORDINATE SPACES, AND MIXING THEM IS THE BUG THIS SECTION EXISTS
         TO AVOID. `shared.css` puts `zoom` on the body element between 768px and
         1439.98px — about 0.851 — and the two families of measurement do not
         agree about what a pixel is:

           getBoundingClientRect(), pageYOffset   VISUAL px (zoom applied)
           offsetHeight, style.top, translateY()  LAYOUT px (zoom applied after)

         So a value read from a rect and written straight into `style.top`
         lands at `value * zoom` — 15% too high, which put this block on top of
         the navbar instead of under it. Suffixes below are not decoration:
         `*Px` is visual, `*Css` is layout, and they are never interchanged. */
      var pinned = false;
      var releasedBelow = false; // left downwards, so re-entry must animate in
      var zoom = 1;
      var sectionHeight = 0; // layout px -> root.style.height
      var blockTop = 0; // visual px — the block's resting position in the document
      var blockHeightPx = 0; // visual px, cached — see update()
      var blockHeightCss = 0; // layout px -> translateY()
      var navBottomPx = 0; // visual px — threshold maths
      var pinTopCss = 0; // layout px -> block.style.top
      var releaseTimer = null;
      var ticking = false;

      function measure() {
        // Meaningless while the block is out of flow.
        if (pinned) return;

        // The block's own two heights give the zoom factor directly, with no
        // media query to keep in sync and no assumption about the breakpoint.
        blockHeightCss = block.offsetHeight;
        var rect = block.getBoundingClientRect();
        blockHeightPx = rect.height;
        zoom = blockHeightCss ? blockHeightPx / blockHeightCss : 1;

        sectionHeight = root.offsetHeight;
        blockTop = rect.top + window.pageYOffset;

        // The navbar is `fixed`, so its bottom edge is a constant in viewport
        // coordinates — read it rather than hard-coding, because the card is
        // `top-4` plus its own content height and that changes with the
        // breakpoint. No navbar on the page (a lone Embed in isolation) and the
        // block simply parks at the top of the screen.
        navBottomPx = navCard ? Math.max(0, navCard.getBoundingClientRect().bottom) : 0;
        pinTopCss = navBottomPx / zoom;
      }

      // Far enough up that the block's bottom edge clears the top of the
      // screen. `-100%` alone would leave the navbar's height showing, and the
      // navbar cannot hide it — it is a rounded card with gutters either side,
      // not a full-width bar. Layout px, because transforms scale with zoom
      // exactly as `top` does.
      function offscreen() {
        return 'translateY(-' + (blockHeightCss + pinTopCss) + 'px)';
      }

      function pin(animateIn) {
        if (pinned) return;
        if (releaseTimer) {
          clearTimeout(releaseTimer);
          releaseTimer = null;
        }
        pinned = true;
        releasedBelow = false;

        root.style.height = sectionHeight + 'px';
        root.setAttribute('data-pinned', '');
        block.setAttribute('data-pinned', '');
        block.style.position = 'fixed';
        block.style.top = pinTopCss + 'px';
        block.style.left = '0';
        block.style.right = '0';
        // BELOW the navbar's z-[1000], never over it. The navbar keeps the top
        // of the screen; this block parks under it and slides away behind it.
        block.style.zIndex = '900';
        // Promoted for the whole pinned stretch, not just while a transition is
        // running. Setting `will-change` at the moment the slide starts is too
        // late — the layer is created in the same frame that has to paint the
        // first step, which is exactly where the hitch shows.
        block.style.willChange = 'transform';

        // Entering from above, fixed and static put the block in the same
        // place, so there is nothing to animate — animating would invent motion
        // the scroll did not ask for. Only a re-entry from below needs to
        // travel.
        if (!animateIn || reduceMotion) {
          block.style.transition = '';
          block.style.transform = '';
          return;
        }

        block.style.transition = 'none';
        block.style.transform = offscreen();
        void block.offsetHeight; // flush, or both assignments collapse into one paint
        block.style.transition = 'transform ' + EXIT + 'ms ' + EASE;
        block.style.transform = 'translateY(0)';
      }

      function reset() {
        root.removeAttribute('data-pinned');
        block.removeAttribute('data-pinned');
        block.style.position = '';
        block.style.top = '';
        block.style.left = '';
        block.style.right = '';
        block.style.zIndex = '';
        block.style.transition = '';
        block.style.transform = '';
        block.style.willChange = ''; // a permanent layer on a static element is waste
        root.style.height = '';
        measure();
      }

      // Releasing upwards is a straight swap: the block's fixed and resting
      // positions coincide at the threshold, so there is nothing to animate.
      // Releasing downwards it has to leave the screen, so it slides.
      function unpin(animateOut) {
        if (!pinned) return;
        pinned = false;
        releasedBelow = !!animateOut;

        if (!animateOut || reduceMotion) {
          reset();
          return;
        }

        block.style.transition = 'transform ' + EXIT + 'ms ' + EASE;
        block.style.transform = offscreen();
        releaseTimer = setTimeout(function () {
          releaseTimer = null;
          if (pinned) return; // re-pinned mid-flight; leave it alone
          reset();
        }, EXIT);
      }

      function update() {
        ticking = false;

        if (!wideEnough.matches) {
          if (pinned) unpin(false);
          return;
        }

        var scrollY = window.pageYOffset;
        // The threshold is the block's resting slot MINUS the navbar height,
        // because that is where pinned and static coincide. Drop the offset and
        // the block would jump the navbar's height at the swap. All visual px:
        // `scrollY` and `blockTop` are, so `navBottomPx` must be too.
        var past = scrollY - (blockTop - navBottomPx);
        var gridBottom = grid.getBoundingClientRect().bottom + scrollY;
        // Release once the grid can no longer fill the space under the block —
        // otherwise it hangs over the footer filtering nothing.
        //
        // `blockHeightPx` is the cached measurement, deliberately. Reading
        // `offsetHeight` here would force a synchronous layout inside the
        // scroll frame, every frame, and that stutter is the one thing the
        // rAF throttle above cannot absorb.
        var stillOverGrid = gridBottom - scrollY > navBottomPx + blockHeightPx;

        if (past >= 0 && stillOverGrid) pin(releasedBelow);
        else if (pinned) unpin(past >= 0); // past the grid → slide out
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', function () {
        measure();
        onScroll();
      });

      measure();
      update();
    }
  })();
</script>
