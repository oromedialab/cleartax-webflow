---
/**
 * "Our upcoming webinars & events" — Figma node 14777:26976.
 *
 * CMS-DRIVEN. This section no longer carries any event content. In Webflow a
 * hidden Collection List (class `ct-ev-upcoming-source`, filtered to
 * Is Upcoming = on) holds one `.ct-ev-data` Div per event, with the fields in
 * custom attributes (`data-name`, `data-slug`, `data-date` ...) and the
 * thumbnail in an Image carrying the class `ct-f-thumbnail`. The script below
 * reads those items, sorts them soonest first, makes the first one the lead
 * card and puts the rest in the scrolling rail — the same markup and classes
 * the static version drew, so the design is unchanged.
 *
 * With no items the whole section stays hidden, so a page with no upcoming
 * events simply has no empty bordered panel.
 *
 * Attributes read from each `.ct-ev-data`:
 *   data-name  data-slug  data-type  data-country  data-date  data-display-time
 *   data-location  data-speaker-1-name  data-speaker-2-name  data-speaker-3-name
 *   data-popular ("yes" when the Popular switch is on)
 *
 * THE RAIL SCROLLS, IT DOES NOT PAGE, and the fades are overlays rather than a
 * mask on the scroller — see the notes on the scroll hint at the bottom.
 */
const heading = "Our upcoming webinars & events";
const subheading =
  "Stay ahead with expert-led sessions designed for enterprise leaders";
const ctaLabel = "Sign up to discover our upcoming sessions";
const ctaHref = "https://www.cleartax.com/contact-us";
---

<section class="bg-generic-00 py-12 md:py-20" data-ev-upcoming-root style="display: none">
  <!-- Icon sprite: defined once, referenced by the lead card and every rail
       row. Keeps the pasted Embed small — the globe path alone is ~700
       characters and this section draws it up to five times. -->
  <svg
    width="0"
    height="0"
    class="absolute"
    aria-hidden="true"
    focusable="false"
  >
    <symbol id="ct-ev-up-calendar" viewBox="0 0 20 20">
      <path
        d="M16.25 2.5H14.375V1.875C14.375 1.70924 14.3092 1.55027 14.1919 1.43306C14.0747 1.31585 13.9158 1.25 13.75 1.25C13.5842 1.25 13.4253 1.31585 13.3081 1.43306C13.1908 1.55027 13.125 1.70924 13.125 1.875V2.5H6.875V1.875C6.875 1.70924 6.80915 1.55027 6.69194 1.43306C6.57473 1.31585 6.41576 1.25 6.25 1.25C6.08424 1.25 5.92527 1.31585 5.80806 1.43306C5.69085 1.55027 5.625 1.70924 5.625 1.875V2.5H3.75C3.41848 2.5 3.10054 2.6317 2.86612 2.86612C2.6317 3.10054 2.5 3.41848 2.5 3.75V16.25C2.5 16.5815 2.6317 16.8995 2.86612 17.1339C3.10054 17.3683 3.41848 17.5 3.75 17.5H16.25C16.5815 17.5 16.8995 17.3683 17.1339 17.1339C17.3683 16.8995 17.5 16.5815 17.5 16.25V3.75C17.5 3.41848 17.3683 3.10054 17.1339 2.86612C16.8995 2.6317 16.5815 2.5 16.25 2.5ZM5.625 3.75V4.375C5.625 4.54076 5.69085 4.69973 5.80806 4.81694C5.92527 4.93415 6.08424 5 6.25 5C6.41576 5 6.57473 4.93415 6.69194 4.81694C6.80915 4.69973 6.875 4.54076 6.875 4.375V3.75H13.125V4.375C13.125 4.54076 13.1908 4.69973 13.3081 4.81694C13.4253 4.93415 13.5842 5 13.75 5C13.9158 5 14.0747 4.93415 14.1919 4.81694C14.3092 4.69973 14.375 4.54076 14.375 4.375V3.75H16.25V6.25H3.75V3.75H5.625ZM16.25 16.25H3.75V7.5H16.25V16.25Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-ev-up-clock" viewBox="0 0 20 20">
      <path
        d="M10 1.875C8.39303 1.875 6.82214 2.35152 5.486 3.24431C4.14985 4.1371 3.10844 5.40605 2.49348 6.8907C1.87852 8.37535 1.71762 10.009 2.03112 11.5851C2.34463 13.1612 3.11846 14.6089 4.25476 15.7452C5.39106 16.8815 6.8388 17.6554 8.41489 17.9689C9.99099 18.2824 11.6247 18.1215 13.1093 17.5065C14.594 16.8916 15.8629 15.8502 16.7557 14.514C17.6485 13.1779 18.125 11.607 18.125 10C18.1227 7.84581 17.266 5.78051 15.7427 4.25727C14.2195 2.73403 12.1542 1.87727 10 1.875ZM10 16.875C8.64026 16.875 7.31105 16.4718 6.18046 15.7164C5.04987 14.9609 4.16868 13.8872 3.64833 12.6309C3.12798 11.3747 2.99183 9.99237 3.2571 8.65875C3.52238 7.32513 4.17716 6.10013 5.13864 5.13864C6.10013 4.17715 7.32514 3.52237 8.65876 3.2571C9.99238 2.99183 11.3747 3.12798 12.631 3.64833C13.8872 4.16868 14.9609 5.04987 15.7164 6.18045C16.4718 7.31104 16.875 8.64025 16.875 10C16.8729 11.8227 16.1479 13.5702 14.8591 14.8591C13.5702 16.1479 11.8227 16.8729 10 16.875ZM15 10C15 10.1658 14.9342 10.3247 14.8169 10.4419C14.6997 10.5592 14.5408 10.625 14.375 10.625H10C9.83424 10.625 9.67527 10.5592 9.55806 10.4419C9.44085 10.3247 9.375 10.1658 9.375 10V5.625C9.375 5.45924 9.44085 5.30027 9.55806 5.18306C9.67527 5.06585 9.83424 5 10 5C10.1658 5 10.3247 5.06585 10.4419 5.18306C10.5592 5.30027 10.625 5.45924 10.625 5.625V9.375H14.375C14.5408 9.375 14.6997 9.44085 14.8169 9.55806C14.9342 9.67527 15 9.83424 15 10Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-ev-up-pin" viewBox="0 0 256 256">
      <path
        d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-ev-up-user" viewBox="0 0 256 256">
      <path
        d="M230.92,212c-15.23-26.33-38.7-45.21-66.09-54.16a72,72,0,1,0-73.66,0C63.78,166.78,40.31,185.66,25.08,212a8,8,0,1,0,13.85,8c18.84-32.56,52.14-52,89.07-52s70.23,19.44,89.07,52a8,8,0,1,0,13.85-8ZM72,96a56,56,0,1,1,56,56A56.06,56.06,0,0,1,72,96Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-ev-up-globe" viewBox="0 0 256 256">
      <path
        d="M128,24a104,104,0,1,0,104,104A104.11,104.11,0,0,0,128,24Zm88,104a87.61,87.61,0,0,1-3.33,24H174.16a157.44,157.44,0,0,0,0-48h38.51A87.61,87.61,0,0,1,216,128ZM102,168H154a115.11,115.11,0,0,1-26,45A115.27,115.27,0,0,1,102,168Zm-3.9-16a140.84,140.84,0,0,1,0-48h59.88a140.84,140.84,0,0,1,0,48ZM40,128a87.61,87.61,0,0,1,3.33-24H81.84a157.44,157.44,0,0,0,0,48H43.33A87.61,87.61,0,0,1,40,128ZM154,88H102a115.11,115.11,0,0,1,26-45A115.27,115.27,0,0,1,154,88Zm52.33,0H170.71a135.28,135.28,0,0,0-22.3-45.6A88.29,88.29,0,0,1,206.37,88ZM107.59,42.4A135.28,135.28,0,0,0,85.29,88H49.63A88.29,88.29,0,0,1,107.59,42.4ZM49.63,168H85.29a135.28,135.28,0,0,0,22.3,45.6A88.29,88.29,0,0,1,49.63,168Zm98.78,45.6a135.28,135.28,0,0,0,22.3-45.6h35.66A88.29,88.29,0,0,1,148.41,213.6Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-ev-up-arrow" viewBox="0 0 24 24">
      <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M8.25 3.75L19.5 3.75C19.6989 3.75 19.8897 3.82902 20.0303 3.96967C20.171 4.11032 20.25 4.30109 20.25 4.5V15.75C20.25 16.1642 19.9142 16.5 19.5 16.5C19.0858 16.5 18.75 16.1642 18.75 15.75V6.31066L5.03033 20.0303C4.73744 20.3232 4.26256 20.3232 3.96967 20.0303C3.67678 19.7374 3.67678 19.2626 3.96967 18.9697L17.6893 5.25L8.25 5.25C7.83579 5.25 7.5 4.91421 7.5 4.5C7.5 4.08579 7.83579 3.75 8.25 3.75Z"
        fill="currentColor"></path>
    </symbol>
  </svg>

  <div class="max-w-[var(--container-max)] mx-auto w-full px-4 md:px-6">
    <div class="rounded-xl border-2 border-ledger-200 bg-generic-00 p-6">
      <!-- Section head -->
      <div
        class="flex flex-col gap-6 border-b border-ledger-200 pb-6 lg:flex-row lg:items-center lg:justify-between lg:gap-8"
      >
        <div class="flex flex-col gap-4">
          <h2
            class="font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[var(--lh-h1)] tracking-[var(--tracking-heading)] m-0"
          >
            {heading}
          </h2>
          <p
            class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[var(--lh-body-lg)] m-0"
          >
            {subheading}
          </p>
        </div>
        <a
          href={ctaHref}
          target="_blank"
          class="shrink-0 self-start rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 text-center font-body font-medium text-nova-50 text-[length:var(--fs-label-lg)] leading-[var(--lh-label-lg)] no-underline transition-all ease-in-out duration-150 hover:bg-generic-00 hover:text-nova-blue lg:self-auto"
        >
          {ctaLabel}
        </a>
      </div>

      <!-- `items-start`: the rail is a fixed-height scroller and the lead card
           is as tall as its own title, so neither should stretch to the other. -->
      <div
        class="mt-8 grid grid-cols-1 items-start gap-8 lg:grid-cols-[689fr_507fr]"
      >
        <!-- Lead event, filled by the script -->
        <div data-ev-lead></div>

        <!-- Rail. The wrapper is the positioning context for the two fades; the
             scroller inside owns the overflow so they never move with it. -->
        <div class="relative">
          <div
            class="ev-rail flex max-h-[535px] flex-col gap-6 overflow-y-auto py-8 pr-4"
            data-ev-rail
          >
          </div>

          <!-- The fades. `right-4` clears the scrollbar gutter so the thumb
               stays crisp at both ends — it is the only thing telling a reader
               the list continues. -->
          <div
            class="pointer-events-none absolute inset-x-0 top-0 right-4 h-14 bg-gradient-to-b from-generic-00 to-transparent"
            aria-hidden="true"
          >
          </div>
          <div
            class="pointer-events-none absolute inset-x-0 bottom-0 right-4 h-14 bg-gradient-to-t from-generic-00 to-transparent"
            aria-hidden="true"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* The rail's scrollbar, styled to the brand rather than left as OS chrome —
     it sits inside a bordered white panel where a native Windows bar is the
     loudest thing on the section. 8px track and a pill thumb, per Figma.

     Both syntaxes are needed and neither is redundant: Firefox only understands
     `scrollbar-width` / `scrollbar-color`, WebKit and Blink only understand the
     pseudo-elements. Prefixed `ev-` because section CSS is one flat namespace
     per Webflow page. */
  .ev-rail {
    scrollbar-width: thin;
    scrollbar-color: var(--color-ledger-300, #d7d0d1) transparent;

    /* The scroll hint below writes `scrollTop` every frame, and a smooth
       scroll box animates each of those writes on its own — the two schedules
       fight and the peek stutters. `shared.css` only sets `smooth` on `html`
       and the property does not inherit, so this changes nothing today; it is
       here because Webflow's page settings can turn on smooth scrolling
       site-wide, and that would land as a bug with no obvious cause. */
    scroll-behavior: auto;
  }

  .ev-rail::-webkit-scrollbar {
    width: 8px;
  }

  .ev-rail::-webkit-scrollbar-track {
    background: transparent;
  }

  .ev-rail::-webkit-scrollbar-thumb {
    background: var(--color-ledger-300, #d7d0d1);
    border-radius: 999px;
  }

  /* The Webflow Collection List that feeds this section. Hidden by class so it
     never renders where it sits on the page. */
  .ct-ev-upcoming-source {
    display: none;
  }
</style>

<script is:inline>
  /* Builds the lead card and the rail from the hidden Collection List. Runs on
     DOMContentLoaded so the list can sit anywhere on the page, above or below
     this Embed. */
  (function () {
    var CHIP =
      "inline-flex items-center gap-2 rounded-lg bg-neutral-100 px-3 py-1.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[var(--lh-label)]";
    var CHIP_OUTLINED = CHIP + " border border-ledger-300";
    var RAIL_CHIP =
      "inline-flex items-center gap-1 rounded border border-ledger-300 bg-neutral-100 px-1.5 py-0.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label-sm)] leading-[var(--lh-label-sm)]";
    var META =
      "flex items-center gap-2 font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)] m-0";
    var DIVIDER =
      '<span class="h-4 w-px shrink-0 rounded-full bg-ledger-300" aria-hidden="true"></span>';
    var MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

    function ready(fn) {
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", fn);
      else fn();
    }

    function esc(s) {
      return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    function parseDate(s) {
      if (!s) return null;
      var m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
      var d = m ? new Date(+m[1], +m[2] - 1, +m[3]) : new Date(s);
      return isNaN(d.getTime()) ? null : d;
    }

    function pad(n) {
      return (n < 10 ? "0" : "") + n;
    }

    function svg(size, id, extra) {
      return '<svg width="' + size + '" height="' + size + '" class="' + (extra || "shrink-0") + '" aria-hidden="true" focusable="false"><use href="#' + id + '"></use></svg>';
    }

    function read() {
      var base = location.pathname.replace(/\/$/, "");
      var nodes = document.querySelectorAll(".ct-ev-upcoming-source .ct-ev-data");
      var items = [];
      Array.prototype.forEach.call(nodes, function (node) {
        function a(k) {
          return (node.getAttribute("data-" + k) || "").trim();
        }
        if (!a("name") || !a("slug")) return;
        var img = node.querySelector(".ct-f-thumbnail");
        var d = parseDate(a("date"));
        items.push({
          name: a("name"),
          href: base + "/" + a("slug"),
          online: /webinar|online/i.test(a("type")),
          type: a("type"),
          date: d,
          dateText: d ? MONTHS[d.getMonth()] + " " + d.getDate() + ", " + d.getFullYear() : a("date"),
          iso: d ? d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()) : "",
          time: a("display-time"),
          location: a("location"),
          speakers: [a("speaker-1-name"), a("speaker-2-name"), a("speaker-3-name")].filter(Boolean),
          popular: /^(yes|true|1|on)$/i.test(a("popular")),
          image: img ? img.getAttribute("src") || "" : "",
        });
      });
      // Soonest first; an event with no date goes last.
      items.sort(function (x, y) {
        if (!x.date && !y.date) return 0;
        if (!x.date) return 1;
        if (!y.date) return -1;
        return x.date - y.date;
      });
      return items;
    }

    function lead(e) {
      var shown = e.speakers.slice(0, 2);
      var chips = shown.map(function (n) { return '<span class="' + CHIP + '">' + esc(n) + "</span>"; }).join("");
      if (e.speakers.length > shown.length) chips += '<span class="' + CHIP + '">+' + (e.speakers.length - shown.length) + "</span>";
      var meta = ['<p class="' + META + '">' + svg(20, "ct-ev-up-calendar") + '<time datetime="' + esc(e.iso) + '">' + esc(e.dateText) + "</time></p>"];
      if (e.time) meta.push('<p class="' + META + '">' + svg(20, "ct-ev-up-clock") + esc(e.time) + "</p>");
      if (e.location) meta.push('<p class="' + META + '">' + svg(20, "ct-ev-up-pin") + esc(e.location) + "</p>");
      return (
        '<a href="' + esc(e.href) + '" class="group flex flex-col gap-6 no-underline">' +
          '<div class="relative aspect-video w-full overflow-hidden rounded-xl border border-ledger-300 bg-visual-placeholder">' +
            (e.image ? '<img src="' + esc(e.image) + '" alt="' + esc(e.name) + '" width="1280" height="720" loading="eager" decoding="async" class="h-full w-full object-cover" />' : "") +
            '<span class="absolute left-5 top-5 flex flex-wrap items-center gap-2">' +
              '<span class="rounded-lg bg-flux-lime px-3 py-1.5 font-body font-medium text-vault-navy text-[length:var(--fs-label)] leading-[var(--lh-label)]">Upcoming</span>' +
              (e.type ? '<span class="' + CHIP_OUTLINED + '">' + svg(16, e.online ? "ct-ev-up-globe" : "ct-ev-up-user") + esc(e.type) + "</span>" : "") +
            "</span>" +
            '<span class="absolute right-5 top-5 flex h-10 w-10 items-center justify-center rounded-lg bg-ledger-white text-vault-navy transition-colors duration-200 group-hover:bg-nova-blue group-hover:text-ledger-white">' + svg(20, "ct-ev-up-arrow", "") + "</span>" +
            (chips ? '<span class="absolute bottom-5 left-5 right-5 flex flex-wrap gap-2">' + chips + "</span>" : "") +
          "</div>" +
          '<div class="flex flex-col gap-4">' +
            '<h3 class="font-heading font-medium text-vault-navy text-[length:var(--fs-h3)] leading-[var(--lh-h3)] tracking-[var(--tracking-heading)] m-0 transition-colors duration-200 group-hover:text-nova-blue">' + esc(e.name) + "</h3>" +
            '<div class="flex flex-wrap items-center gap-3">' + meta.join(DIVIDER) + "</div>" +
          "</div>" +
        "</a>"
      );
    }

    function row(e) {
      var meta = ['<span class="flex items-center gap-2">' + svg(20, "ct-ev-up-calendar") + '<time datetime="' + esc(e.iso) + '">' + esc(e.dateText) + "</time></span>"];
      if (e.time) meta.push('<span class="flex items-center gap-2">' + svg(20, "ct-ev-up-clock") + esc(e.time) + "</span>");
      return (
        '<a href="' + esc(e.href) + '" class="group flex items-center gap-6 no-underline">' +
          '<span class="relative block h-[116px] w-[140px] shrink-0 overflow-hidden rounded-lg border border-ledger-300 bg-visual-placeholder sm:w-[206px]">' +
            (e.image ? '<img src="' + esc(e.image) + '" alt="' + esc(e.name) + '" width="1280" height="720" loading="lazy" decoding="async" class="h-full w-full object-cover" />' : "") +
            '<span class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">' +
              '<span class="flex h-9 w-9 items-center justify-center text-vault-navy">' + svg(20, "ct-ev-up-arrow", "") + "</span>" +
            "</span>" +
          "</span>" +
          '<span class="flex min-w-0 flex-1 flex-col gap-3">' +
            '<span class="flex flex-col gap-2">' +
              '<span class="line-clamp-2 font-body font-medium text-vault-navy text-[length:var(--fs-label-lg)] leading-[var(--lh-label-lg)] transition-colors duration-200 group-hover:text-nova-blue">' + esc(e.name) + "</span>" +
              (e.speakers[0] ? '<span class="truncate font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)]">' + esc(e.speakers[0]) + "</span>" : "") +
            "</span>" +
            '<span class="flex flex-wrap items-center gap-2 font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)]">' + meta.join(DIVIDER) + "</span>" +
            '<span class="flex flex-wrap items-center gap-1">' +
              (e.type ? '<span class="' + RAIL_CHIP + '">' + svg(16, e.online ? "ct-ev-up-globe" : "ct-ev-up-user") + esc(e.type) + "</span>" : "") +
              (e.popular ? '<span class="inline-flex items-center rounded bg-flux-lime px-1.5 py-0.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label-sm)] leading-[var(--lh-label-sm)]">Popular</span>' : "") +
            "</span>" +
          "</span>" +
        "</a>"
      );
    }

    ready(function () {
      var root = document.querySelector("[data-ev-upcoming-root]");
      if (!root) return;
      var items = read();
      if (!items.length) return; // nothing upcoming: the panel stays hidden
      root.querySelector("[data-ev-lead]").innerHTML = lead(items[0]);
      root.querySelector("[data-ev-rail]").innerHTML = items.slice(1).map(row).join("");
      root.style.display = "";
    });
  })();
</script>

<script is:inline>
  /* Scroll hint — plays ONCE, the first time the rail is on screen.
     The rail is a plain overflow region (see the note at the top of this file),
     so nothing but the scrollbar says there are more sessions below. On a
     trackpad that bar is hidden until you already scroll, which is exactly the
     reader who needs telling. So the list glides down a fraction of a row —
     the rows move, which no static affordance can fake.

     ONE WAY. It drifts down and stays there; it does not spring back. Coming
     back up would undo the only thing the move proves, and a there-and-back
     reads as a glitch on a list a reader did not ask to move.

     Deliberately not a CSS animation — `transform` would slide the rows past
     the fades without moving the scrollbar thumb, and the thumb moving is half
     the message. This drives `scrollTop`, so it is the real scroll position.

     Rules it holds to:
     - once per page load, and only if the content actually overflows;
     - never against the reader — any wheel/touch/key/pointer input during the
       hint stops it where it is and hands the scroller straight back;
     - silent under `prefers-reduced-motion`;
     - starts when the rail enters the viewport, not at DOMContentLoaded, so a
       reader who lands further down the page has not already missed it. */
  (function () {
    // Registered after the builder above, so on DOMContentLoaded the rail has
    // its rows by the time this measures whether it overflows.
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    function init() {
      var rails = document.querySelectorAll("[data-ev-rail]");
      for (var i = 0; i < rails.length; i++) setup(rails[i]);
    }

    function setup(rail) {
      // Roughly half a row: enough that the row below rises into view and the
      // thumb visibly leaves the top, not so far that row one leaves the frame.
      var PEEK = 72;

      /* Slow on purpose. Smoothness here is per-frame distance, not easing
         cleverness: 72px over 1400ms is ~0.85px a frame at 60Hz, small enough
         that the rows read as drifting rather than stepping. Halve the duration
         and each frame doubles its jump — the same curve starts to judder on
         low-refresh panels. */
      var DOWN = 1400;

      /* A beat before it starts. The observer can fire while the reader is
         still flicking the page down, and a rail that moves inside a moving
         viewport reads as a rendering fault rather than an invitation. */
      var DELAY = 320;

      var reduce =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce) return;

      // Nothing to hint at if everything already fits, or if the browser
      // restored a scroll position on reload — then the reader is mid-list and
      // an animation would fight them.
      if (rail.scrollHeight - rail.clientHeight < PEEK + 8) return;
      if (rail.scrollTop > 0) return;

      if (!("IntersectionObserver" in window)) {
        play();
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (!entries[i].isIntersecting) continue;
            observer.disconnect();
            play();
          }
        },
        // A third of the rail showing — below that the peek happens off screen.
        { threshold: 0.33 },
      );
      observer.observe(rail);

      function play() {
        animate(rail, PEEK, DOWN, DELAY);
      }
    }

    function animate(rail, PEEK, DOWN, DELAY) {
      var start = null;
      var frame = 0;
      var cancelled = false;

      var events = ["wheel", "touchstart", "pointerdown", "keydown"];

      function stop() {
        if (cancelled) return;
        cancelled = true;
        if (frame) cancelAnimationFrame(frame);
        for (var i = 0; i < events.length; i++) {
          rail.removeEventListener(events[i], stop);
        }
      }

      for (var i = 0; i < events.length; i++) {
        // Passive: none of these handlers prevent anything, and a non-passive
        // `wheel`/`touchstart` listener on a scroller costs scroll performance.
        rail.addEventListener(events[i], stop, { passive: true });
      }

      // Note there is no `scroll` listener here — this animation writes
      // `scrollTop` every frame and would cancel itself on the first one.

      /* easeInOutSine. Velocity is zero at both ends AND its rate of change is
         a half-cosine with no corners anywhere — the gentlest of the standard
         curves, which is the whole brief for this move. Cubic is snappier at
         the midpoint; snappy is what a hint should not be. */
      function ease(t) {
        return 0.5 * (1 - Math.cos(Math.PI * t));
      }

      function step(now) {
        if (cancelled) return;
        if (start === null) start = now;

        var elapsed = now - start - DELAY;
        if (elapsed < 0) {
          frame = requestAnimationFrame(step);
          return;
        }

        if (elapsed >= DOWN) {
          rail.scrollTop = PEEK;
          stop();
          return;
        }

        // Fractional scrollTop is kept, not rounded — browsers render
        // sub-pixel scroll offsets, and rounding here would quantise the drift
        // back into the 1px steps the long duration exists to avoid.
        rail.scrollTop = PEEK * ease(elapsed / DOWN);
        frame = requestAnimationFrame(step);
      }

      frame = requestAnimationFrame(step);
    }
  })();
</script>
