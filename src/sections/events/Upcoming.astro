    <symbol id="ct-ev-up-arrow" viewBox="0 0 24 24">
      <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M8.25 3.75L19.5 3.75C19.6989 3.75 19.8897 3.82902 20.0303 3.96967C20.171 4.11032 20.25 4.30109 20.25 4.5V15.75C20.25 16.1642 19.9142 16.5 19.5 16.5C19.0858 16.5 18.75 16.1642 18.75 15.75V6.31066L5.03033 20.0303C4.73744 20.3232 4.26256 20.3232 3.96967 20.0303C3.67678 19.7374 3.67678 19.2626 3.96967 18.9697L17.6893 5.25L8.25 5.25C7.83579 5.25 7.5 4.91421 7.5 4.5C7.5 4.08579 7.83579 3.75 8.25 3.75Z"
        fill="currentColor"></path>
    </symbol>
  </svg>

  <div class="container">
    <div class="rounded-xl border-2 border-ledger-200 bg-generic-00 p-6">
      <!-- Section head -->
      <div
        class="flex flex-col gap-6 border-b border-ledger-200 pb-6 lg:flex-row lg:items-center lg:justify-between lg:gap-8"
      >
        <div class="flex flex-col gap-4">
          <h2
            class="font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[var(--lh-h1)] tracking-[var(--tracking-heading)] m-0"
          >
            {heading}
          </h2>
          <p
            class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[var(--lh-body-lg)] m-0"
          >
            {subheading}
          </p>
        </div>
        <a
          href={ctaHref} target="_blank"
          class="shrink-0 self-start rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 text-center font-body font-medium text-nova-50 text-[length:var(--fs-label-lg)] leading-[var(--lh-label-lg)] no-underline transition-all ease-in-out duration-150 hover:bg-generic-00 hover:text-nova-blue lg:self-auto"
        >
          {ctaLabel}
        </a>
      </div>

      <!-- `items-start`: the rail is a fixed-height scroller and the lead card
           is as tall as its own title, so neither should stretch to the other. -->
      <div class="mt-8 grid grid-cols-1 items-start gap-8 lg:grid-cols-[689fr_507fr]">
        <!-- Lead event -->
        <a href={eventPath(lead.slug)} class="group flex flex-col gap-6 no-underline">
          <div
            class="relative aspect-video w-full overflow-hidden rounded-xl border border-ledger-300 bg-visual-placeholder"
          >
            {
              lead.image && (
                <img
                  src={lead.image}
                  alt={lead.title}
                  width="1280"
                  height="720"
                  loading="eager"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              )
            }

            <span class="absolute left-5 top-5 flex flex-wrap items-center gap-2">
              <!-- FLUX LIME, AND NOT THE ONLY ONE ON THIS SCREEN — the rail's
                   "Popular" chip is lime too. docs/brand/colour.md says one
                   instance per screen; Figma 14777:26976 draws both, so the
                   design is followed here and the conflict is left visible
                   rather than silently resolved. If the rule wins, this badge
                   is the one to keep: it marks the lead session, where the
                   accent is doing the most work. -->
              <span
                class="rounded-lg bg-flux-lime px-3 py-1.5 font-body font-medium text-vault-navy text-[length:var(--fs-label)] leading-[var(--lh-label)]"
              >
                Upcoming
              </span>
              <span class={chipOutlined}>
                <svg width="16" height="16" class="shrink-0" aria-hidden="true" focusable="false"
                  ><use href={lead.type === 'Online' ? '#ct-ev-up-globe' : '#ct-ev-up-user'}
                  ></use></svg
                >
                {lead.type}
              </span>
            </span>

            <span
              class="absolute right-5 top-5 flex h-10 w-10 items-center justify-center rounded-lg bg-ledger-white text-vault-navy transition-colors duration-200 group-hover:bg-nova-blue group-hover:text-ledger-white"
            >
              <svg width="20" height="20" aria-hidden="true" focusable="false"
                ><use href="#ct-ev-up-arrow"></use></svg
              >
            </span>

            <span class="absolute bottom-5 left-5 right-5 flex flex-wrap gap-2">
              {leadSpeakers.map((speaker) => <span class={chipClass}>{speaker}</span>)}
              {extraSpeakers > 0 && <span class={chipClass}>+{extraSpeakers}</span>}
            </span>
          </div>

          <div class="flex flex-col gap-4">
            <h3
              class="font-heading font-medium text-vault-navy text-[length:var(--fs-h3)] leading-[var(--lh-h3)] tracking-[var(--tracking-heading)] m-0 transition-colors duration-200 group-hover:text-nova-blue"
            >
              {lead.title}
            </h3>

            <div class="flex flex-wrap items-center gap-3">
              <p class={metaClass}>
                <svg width="20" height="20" class="shrink-0" aria-hidden="true" focusable="false"
                  ><use href="#ct-ev-up-calendar"></use></svg
                >
                <time datetime={lead.datetime}>{lead.date}</time>
              </p>
              <span class="h-4 w-px shrink-0 rounded-full bg-ledger-300" aria-hidden="true"></span>
              <p class={metaClass}>
                <svg width="20" height="20" class="shrink-0" aria-hidden="true" focusable="false"
                  ><use href="#ct-ev-up-clock"></use></svg
                >
                {lead.time}
              </p>
              <span class="h-4 w-px shrink-0 rounded-full bg-ledger-300" aria-hidden="true"></span>
              <p class={metaClass}>
                <svg width="20" height="20" class="shrink-0" aria-hidden="true" focusable="false"
                  ><use href="#ct-ev-up-pin"></use></svg
                >
                {lead.location}
              </p>
            </div>
          </div>
        </a>

        <!-- Rail. The wrapper is the positioning context for the two fades; the
             scroller inside owns the overflow so they never move with it. -->
        <div class="relative">
          <div
            class="ev-rail flex max-h-[535px] flex-col gap-6 overflow-y-auto py-8 pr-4"
            data-ev-rail
          >
            {
              rail.map((event) => (
                <a href={eventPath(event.slug)} class="group flex items-center gap-6 no-underline">
                  <span class="relative block h-[116px] w-[140px] shrink-0 overflow-hidden rounded-lg border border-ledger-300 bg-visual-placeholder sm:w-[206px]">
                    {event.image && (
                      <img
                        src={event.image}
                        alt={event.title}
                        width="1280"
                        height="720"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover"
                      />
                    )}

                    {/* Hover affordance. The lead card wears its arrow
                        permanently because it has the room; a 116px rail
                        thumbnail does not, so the arrow only appears over the
                        image on hover. Kept in the SAME white chip as the lead
                        rather than as a bare glyph: the placeholder is a flat
                        tint today, but once real `image` URLs land a navy arrow
                        drawn straight onto a photo is a coin toss to read.

                        `group-focus-visible` as well as `group-hover` — the row
                        is a link, so keyboard users reach it and get nothing
                        from hover. `pointer-events-none` keeps the overlay out
                        of the anchor's own hit test. */}
                    <span class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
                      <span class="flex h-9 w-9 items-center justify-center text-vault-navy">
                        <svg width="20" height="20" aria-hidden="true" focusable="false">
                          <use href="#ct-ev-up-arrow" />
                        </svg>
                      </span>
                    </span>
                  </span>

                  <span class="flex min-w-0 flex-1 flex-col gap-3">
                    <span class="flex flex-col gap-2">
                      {/* Clamped: the rail column is narrow and a third line on
                          one row would push the whole list out of step. */}
                      <span class="line-clamp-2 font-body font-medium text-vault-navy text-[length:var(--fs-label-lg)] leading-[var(--lh-label-lg)] transition-colors duration-200 group-hover:text-nova-blue">
                        {event.title}
                      </span>
                      <span class="truncate font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)]">
                        {event.speakers[0]}
                      </span>
                    </span>

                    <span class="flex flex-wrap items-center gap-2 font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)]">
                      <span class="flex items-center gap-2">
                        <svg width="20" height="20" class="shrink-0" aria-hidden="true" focusable="false">
                          <use href="#ct-ev-up-calendar" />
                        </svg>
                        <time datetime={event.datetime}>{event.date}</time>
                      </span>
                      <span class="h-4 w-px shrink-0 rounded-full bg-ledger-300" aria-hidden="true" />
                      <span class="flex items-center gap-2">
                        <svg width="20" height="20" class="shrink-0" aria-hidden="true" focusable="false">
                          <use href="#ct-ev-up-clock" />
                        </svg>
                        {event.time}
                      </span>
                    </span>

                    <span class="flex flex-wrap items-center gap-1">
                      <span class={railChip}>
                        <svg width="16" height="16" class="shrink-0" aria-hidden="true" focusable="false">
                          <use href={event.type === 'Online' ? '#ct-ev-up-globe' : '#ct-ev-up-user'} />
                        </svg>
                        {event.type}
                      </span>
                      {event.popular && (
                        <span class="inline-flex items-center rounded bg-flux-lime px-1.5 py-0.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label-sm)] leading-[var(--lh-label-sm)]">
                          Popular
                        </span>
                      )}
                    </span>
                  </span>
                </a>
              ))
            }
          </div>

          <!-- The fades. `right-4` clears the scrollbar gutter so the thumb
               stays crisp at both ends — it is the only thing telling a reader
               the list continues. -->
          <div
            class="pointer-events-none absolute inset-x-0 top-0 right-4 h-14 bg-gradient-to-b from-generic-00 to-transparent"
            aria-hidden="true"
          >
          </div>
          <div
            class="pointer-events-none absolute inset-x-0 bottom-0 right-4 h-14 bg-gradient-to-t from-generic-00 to-transparent"
            aria-hidden="true"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* The rail's scrollbar, styled to the brand rather than left as OS chrome —
     it sits inside a bordered white panel where a native Windows bar is the
     loudest thing on the section. 8px track and a pill thumb, per Figma.

     Both syntaxes are needed and neither is redundant: Firefox only understands
     `scrollbar-width` / `scrollbar-color`, WebKit and Blink only understand the
     pseudo-elements. Prefixed `ev-` because section CSS is one flat namespace
     per Webflow page. */
  .ev-rail {
    scrollbar-width: thin;
    scrollbar-color: var(--color-ledger-300, #d7d0d1) transparent;

    /* The scroll hint below writes `scrollTop` every frame, and a smooth
       scroll box animates each of those writes on its own — the two schedules
       fight and the peek stutters. `shared.css` only sets `smooth` on `html`
       and the property does not inherit, so this changes nothing today; it is
       here because Webflow's page settings can turn on smooth scrolling
       site-wide, and that would land as a bug with no obvious cause. */
    scroll-behavior: auto;
  }

  .ev-rail::-webkit-scrollbar {
    width: 8px;
  }

  .ev-rail::-webkit-scrollbar-track {
    background: transparent;
  }

  .ev-rail::-webkit-scrollbar-thumb {
    background: var(--color-ledger-300, #d7d0d1);
    border-radius: 999px;
  }
</style>

<script is:inline>
  /* Scroll hint — plays ONCE, the first time the rail is on screen.
     The rail is a plain overflow region (see the note at the top of this file),
     so nothing but the scrollbar says there are more sessions below. On a
     trackpad that bar is hidden until you already scroll, which is exactly the
     reader who needs telling. So the list glides down a fraction of a row —
     the rows move, which no static affordance can fake.

     ONE WAY. It drifts down and stays there; it does not spring back. Coming
     back up would undo the only thing the move proves, and a there-and-back
     reads as a glitch on a list a reader did not ask to move.

     Deliberately not a CSS animation — `transform` would slide the rows past
     the fades without moving the scrollbar thumb, and the thumb moving is half
     the message. This drives `scrollTop`, so it is the real scroll position.

     Rules it holds to:
     - once per page load, and only if the content actually overflows;
     - never against the reader — any wheel/touch/key/pointer input during the
       hint stops it where it is and hands the scroller straight back;
     - silent under `prefers-reduced-motion`;
     - starts when the rail enters the viewport, not at DOMContentLoaded, so a
       reader who lands further down the page has not already missed it. */
  (function () {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
      var rails = document.querySelectorAll('[data-ev-rail]');
      for (var i = 0; i < rails.length; i++) setup(rails[i]);
    }

    function setup(rail) {
      // Roughly half a row: enough that the row below rises into view and the
      // thumb visibly leaves the top, not so far that row one leaves the frame.
      var PEEK = 72;

      /* Slow on purpose. Smoothness here is per-frame distance, not easing
         cleverness: 72px over 1400ms is ~0.85px a frame at 60Hz, small enough
         that the rows read as drifting rather than stepping. Halve the duration
         and each frame doubles its jump — the same curve starts to judder on
         low-refresh panels. */
      var DOWN = 1400;

      /* A beat before it starts. The observer can fire while the reader is
         still flicking the page down, and a rail that moves inside a moving
         viewport reads as a rendering fault rather than an invitation. */
      var DELAY = 320;

      var reduce =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;

      // Nothing to hint at if everything already fits, or if the browser
      // restored a scroll position on reload — then the reader is mid-list and
      // an animation would fight them.
      if (rail.scrollHeight - rail.clientHeight < PEEK + 8) return;
      if (rail.scrollTop > 0) return;

      if (!('IntersectionObserver' in window)) {
        play();
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (!entries[i].isIntersecting) continue;
            observer.disconnect();
            play();
          }
        },
        // A third of the rail showing — below that the peek happens off screen.
        { threshold: 0.33 }
      );
      observer.observe(rail);

      function play() {
        animate(rail, PEEK, DOWN, DELAY);
      }
    }

    function animate(rail, PEEK, DOWN, DELAY) {
      var start = null;
      var frame = 0;
      var cancelled = false;

      var events = ['wheel', 'touchstart', 'pointerdown', 'keydown'];

      function stop() {
        if (cancelled) return;
        cancelled = true;
        if (frame) cancelAnimationFrame(frame);
        for (var i = 0; i < events.length; i++) {
          rail.removeEventListener(events[i], stop);
        }
      }

      for (var i = 0; i < events.length; i++) {
        // Passive: none of these handlers prevent anything, and a non-passive
        // `wheel`/`touchstart` listener on a scroller costs scroll performance.
        rail.addEventListener(events[i], stop, { passive: true });
      }

      // Note there is no `scroll` listener here — this animation writes
      // `scrollTop` every frame and would cancel itself on the first one.

      /* easeInOutSine. Velocity is zero at both ends AND its rate of change is
         a half-cosine with no corners anywhere — the gentlest of the standard
         curves, which is the whole brief for this move. Cubic is snappier at
         the midpoint; snappy is what a hint should not be. */
      function ease(t) {
        return 0.5 * (1 - Math.cos(Math.PI * t));
      }

      function step(now) {
        if (cancelled) return;
        if (start === null) start = now;

        var elapsed = now - start - DELAY;
        if (elapsed < 0) {
          frame = requestAnimationFrame(step);
          return;
        }

        if (elapsed >= DOWN) {
          rail.scrollTop = PEEK;
          stop();
          return;
        }

        // Fractional scrollTop is kept, not rounded — browsers render
        // sub-pixel scroll offsets, and rounding here would quantise the drift
        // back into the 1px steps the long duration exists to avoid.
        rail.scrollTop = PEEK * ease(elapsed / DOWN);
        frame = requestAnimationFrame(step);
      }

      frame = requestAnimationFrame(step);
    }
  })();
</script>
