---
/**
 * "Our upcoming webinars & events" — Figma node 14777:26976.
 *
 * One bordered panel holding a section head, a lead event on the left and a
 * scrolling rail of the rest on the right. Content comes from `upcomingEvents`
 * in `src/data/events.ts`; the lead is the first entry and the rail is
 * everything after it, so reordering that array is the editorial control.
 *
 * THE RAIL SCROLLS, IT DOES NOT PAGE. Figma draws a scrollbar and a gradient
 * that clips the first and last rows mid-card, which is the design telling you
 * it is a plain overflow region rather than a carousel — so it is one, and the
 * section needs no script at all. The stepper and the "Load more" button in the
 * frame are both hidden there; they are not built.
 *
 * THE FADES ARE OVERLAYS, NOT A MASK ON THE SCROLLER. Figma has them as a
 * "Gradient - overlay" frame sitting above the list, and that is also the only
 * version that works: masking the scroll container fades its scrollbar along
 * with its content, and the scrollbar is the thing telling you there is more to
 * see. Two absolutely-positioned gradients stop short of the scrollbar instead.
 *
 * `image: ''` renders the Figma "Visual Placeholder" tint on its own, which is
 * what the mockup shows. Drop in a Webflow asset URL to replace it — never a
 * `data:` URI, that alone can blow the 50 KB Embed budget.
 */
/* Cards link to the detail route, NOT to `event.href`. `href` is still the
   registration / recording link — the detail page's "Register now" button is
   what uses it now. Going through `eventPath` means a card can only ever point
   at a slug `events/[slug].astro` has generated a page for. */
import { upcomingEvents, eventPath } from '../../data/events';

const heading = 'Our upcoming webinars & events';
const subheading = 'Stay ahead with expert-led sessions designed for enterprise leaders';
const ctaLabel = 'Sign up to discover our upcoming sessions';
const ctaHref = 'https://www.cleartax.com/contact-us';

const lead = upcomingEvents[0];
const rail = upcomingEvents.slice(1);

/* Two speaker chips over the lead image; everyone else rolls into the "+N"
   chip beside them. Names here run long ("Vivek Menon, Solutions Architect"),
   and at three chips a row of them wraps onto a second line that then collides
   with the image's bottom edge. The count is the knob — `extraSpeakers` follows
   it, so changing this number is the only edit needed. */
const SPEAKERS_SHOWN = 2;
const leadSpeakers = lead.speakers.slice(0, SPEAKERS_SHOWN);
const extraSpeakers = lead.speakers.length - leadSpeakers.length;

/* Over the lead image: the type chip is outlined, speaker chips are not. */
const chipClass =
  'inline-flex items-center gap-2 rounded-lg bg-neutral-100 px-3 py-1.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[var(--lh-label)]';
const chipOutlined = `${chipClass} border border-ledger-300`;

/* On rail cards everything is a size down — 12px type in a 4px-radius chip. */
const railChip =
  'inline-flex items-center gap-1 rounded border border-ledger-300 bg-neutral-100 px-1.5 py-0.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label-sm)] leading-[var(--lh-label-sm)]';

const metaClass =
  'flex items-center gap-2 font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)] m-0';
---

<section class="bg-generic-00 py-12 md:py-20">
  <!-- Icon sprite: defined once, referenced by the lead card and every rail
       row. Keeps the pasted Embed small — the globe path alone is ~700
       characters and this section draws it up to five times. -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <symbol id="ct-ev-up-calendar" viewBox="0 0 20 20">
      <path
        d="M16.25 2.5H14.375V1.875C14.375 1.70924 14.3092 1.55027 14.1919 1.43306C14.0747 1.31585 13.9158 1.25 13.75 1.25C13.5842 1.25 13.4253 1.31585 13.3081 1.43306C13.1908 1.55027 13.125 1.70924 13.125 1.875V2.5H6.875V1.875C6.875 1.70924 6.80915 1.55027 6.69194 1.43306C6.57473 1.31585 6.41576 1.25 6.25 1.25C6.08424 1.25 5.92527 1.31585 5.80806 1.43306C5.69085 1.55027 5.625 1.70924 5.625 1.875V2.5H3.75C3.41848 2.5 3.10054 2.6317 2.86612 2.86612C2.6317 3.10054 2.5 3.41848 2.5 3.75V16.25C2.5 16.5815 2.6317 16.8995 2.86612 17.1339C3.10054 17.3683 3.41848 17.5 3.75 17.5H16.25C16.5815 17.5 16.8995 17.3683 17.1339 17.1339C17.3683 16.8995 17.5 16.5815 17.5 16.25V3.75C17.5 3.41848 17.3683 3.10054 17.1339 2.86612C16.8995 2.6317 16.5815 2.5 16.25 2.5ZM5.625 3.75V4.375C5.625 4.54076 5.69085 4.69973 5.80806 4.81694C5.92527 4.93415 6.08424 5 6.25 5C6.41576 5 6.57473 4.93415 6.69194 4.81694C6.80915 4.69973 6.875 4.54076 6.875 4.375V3.75H13.125V4.375C13.125 4.54076 13.1908 4.69973 13.3081 4.81694C13.4253 4.93415 13.5842 5 13.75 5C13.9158 5 14.0747 4.93415 14.1919 4.81694C14.3092 4.69973 14.375 4.54076 14.375 4.375V3.75H16.25V6.25H3.75V3.75H5.625ZM16.25 16.25H3.75V7.5H16.25V16.25Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-ev-up-clock" viewBox="0 0 20 20">
      <path
        d="M10 1.875C8.39303 1.875 6.82214 2.35152 5.486 3.24431C4.14985 4.1371 3.10844 5.40605 2.49348 6.8907C1.87852 8.37535 1.71762 10.009 2.03112 11.5851C2.34463 13.1612 3.11846 14.6089 4.25476 15.7452C5.39106 16.8815 6.8388 17.6554 8.41489 17.9689C9.99099 18.2824 11.6247 18.1215 13.1093 17.5065C14.594 16.8916 15.8629 15.8502 16.7557 14.514C17.6485 13.1779 18.125 11.607 18.125 10C18.1227 7.84581 17.266 5.78051 15.7427 4.25727C14.2195 2.73403 12.1542 1.87727 10 1.875ZM10 16.875C8.64026 16.875 7.31105 16.4718 6.18046 15.7164C5.04987 14.9609 4.16868 13.8872 3.64833 12.6309C3.12798 11.3747 2.99183 9.99237 3.2571 8.65875C3.52238 7.32513 4.17716 6.10013 5.13864 5.13864C6.10013 4.17715 7.32514 3.52237 8.65876 3.2571C9.99238 2.99183 11.3747 3.12798 12.631 3.64833C13.8872 4.16868 14.9609 5.04987 15.7164 6.18045C16.4718 7.31104 16.875 8.64025 16.875 10C16.8729 11.8227 16.1479 13.5702 14.8591 14.8591C13.5702 16.1479 11.8227 16.8729 10 16.875ZM15 10C15 10.1658 14.9342 10.3247 14.8169 10.4419C14.6997 10.5592 14.5408 10.625 14.375 10.625H10C9.83424 10.625 9.67527 10.5592 9.55806 10.4419C9.44085 10.3247 9.375 10.1658 9.375 10V5.625C9.375 5.45924 9.44085 5.30027 9.55806 5.18306C9.67527 5.06585 9.83424 5 10 5C10.1658 5 10.3247 5.06585 10.4419 5.18306C10.5592 5.30027 10.625 5.45924 10.625 5.625V9.375H14.375C14.5408 9.375 14.6997 9.44085 14.8169 9.55806C14.9342 9.67527 15 9.83424 15 10Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-ev-up-pin" viewBox="0 0 256 256">
      <path
        d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"
