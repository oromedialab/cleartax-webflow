---
/**
 * Past event grid + Load more — Figma node 14777:27048.
 *
 * This section owns the behaviour; the controls it reads live in
 * `Filters.astro`, a separate Embed, so the script binds its listeners on
 * `document` instead of on the form: delegation makes the wiring independent of
 * which Embed Webflow renders first, and of whether the filter bar is present
 * at all. That section also carries the heading this grid sits under.
 *
 * Content comes from `pastEvents` in `src/data/events.ts`. The upcoming block
 * above reads a different array, so nothing can appear in both.
 *
 * `image: ''` falls back to the Figma "Visual Placeholder" tint.
 */
/* Cards link to the detail route, NOT to `event.href`. `href` is still the
   recording link — the detail page's CTA is what uses it now. Going through
   `eventPath` means a card can only ever point at a slug
   `events/[slug].astro` has generated a page for. */
import { pastEvents, eventPath } from '../../data/events';

const chipClass =
  'inline-flex items-center gap-2 rounded-lg bg-neutral-100 px-3 py-1.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[var(--lh-label)]';

const metaClass =
  'flex items-center gap-2 font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)] m-0';
---

<section class="bg-generic-00 py-12 md:pt-20 md:pb-10" data-ev-grid-root>
  <!-- Icon sprite: defined once, referenced by all cards. Keeps the pasted
       Embed small — the globe path alone is ~700 characters. -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <symbol id="ct-ev-card-calendar" viewBox="0 0 20 20">
      <path
        d="M16.25 2.5H14.375V1.875C14.375 1.70924 14.3092 1.55027 14.1919 1.43306C14.0747 1.31585 13.9158 1.25 13.75 1.25C13.5842 1.25 13.4253 1.31585 13.3081 1.43306C13.1908 1.55027 13.125 1.70924 13.125 1.875V2.5H6.875V1.875C6.875 1.70924 6.80915 1.55027 6.69194 1.43306C6.57473 1.31585 6.41576 1.25 6.25 1.25C6.08424 1.25 5.92527 1.31585 5.80806 1.43306C5.69085 1.55027 5.625 1.70924 5.625 1.875V2.5H3.75C3.41848 2.5 3.10054 2.6317 2.86612 2.86612C2.6317 3.10054 2.5 3.41848 2.5 3.75V16.25C2.5 16.5815 2.6317 16.8995 2.86612 17.1339C3.10054 17.3683 3.41848 17.5 3.75 17.5H16.25C16.5815 17.5 16.8995 17.3683 17.1339 17.1339C17.3683 16.8995 17.5 16.5815 17.5 16.25V3.75C17.5 3.41848 17.3683 3.10054 17.1339 2.86612C16.8995 2.6317 16.5815 2.5 16.25 2.5ZM5.625 3.75V4.375C5.625 4.54076 5.69085 4.69973 5.80806 4.81694C5.92527 4.93415 6.08424 5 6.25 5C6.41576 5 6.57473 4.93415 6.69194 4.81694C6.80915 4.69973 6.875 4.54076 6.875 4.375V3.75H13.125V4.375C13.125 4.54076 13.1908 4.69973 13.3081 4.81694C13.4253 4.93415 13.5842 5 13.75 5C13.9158 5 14.0747 4.93415 14.1919 4.81694C14.3092 4.69973 14.375 4.54076 14.375 4.375V3.75H16.25V6.25H3.75V3.75H5.625ZM16.25 16.25H3.75V7.5H16.25V16.25Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-ev-card-clock" viewBox="0 0 20 20">
      <path
        d="M10 1.875C8.39303 1.875 6.82214 2.35152 5.486 3.24431C4.14985 4.1371 3.10844 5.40605 2.49348 6.8907C1.87852 8.37535 1.71762 10.009 2.03112 11.5851C2.34463 13.1612 3.11846 14.6089 4.25476 15.7452C5.39106 16.8815 6.8388 17.6554 8.41489 17.9689C9.99099 18.2824 11.6247 18.1215 13.1093 17.5065C14.594 16.8916 15.8629 15.8502 16.7557 14.514C17.6485 13.1779 18.125 11.607 18.125 10C18.1227 7.84581 17.266 5.78051 15.7427 4.25727C14.2195 2.73403 12.1542 1.87727 10 1.875ZM10 16.875C8.64026 16.875 7.31105 16.4718 6.18046 15.7164C5.04987 14.9609 4.16868 13.8872 3.64833 12.6309C3.12798 11.3747 2.99183 9.99237 3.2571 8.65875C3.52238 7.32513 4.17716 6.10013 5.13864 5.13864C6.10013 4.17715 7.32514 3.52237 8.65876 3.2571C9.99238 2.99183 11.3747 3.12798 12.631 3.64833C13.8872 4.16868 14.9609 5.04987 15.7164 6.18045C16.4718 7.31104 16.875 8.64025 16.875 10C16.8729 11.8227 16.1479 13.5702 14.8591 14.8591C13.5702 16.1479 11.8227 16.8729 10 16.875ZM15 10C15 10.1658 14.9342 10.3247 14.8169 10.4419C14.6997 10.5592 14.5408 10.625 14.375 10.625H10C9.83424 10.625 9.67527 10.5592 9.55806 10.4419C9.44085 10.3247 9.375 10.1658 9.375 10V5.625C9.375 5.45924 9.44085 5.30027 9.55806 5.18306C9.67527 5.06585 9.83424 5 10 5C10.1658 5 10.3247 5.06585 10.4419 5.18306C10.5592 5.30027 10.625 5.45924 10.625 5.625V9.375H14.375C14.5408 9.375 14.6997 9.44085 14.8169 9.55806C14.9342 9.67527 15 9.83424 15 10Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-ev-card-user" viewBox="0 0 256 256">
      <path
        d="M230.92,212c-15.23-26.33-38.7-45.21-66.09-54.16a72,72,0,1,0-73.66,0C63.78,166.78,40.31,185.66,25.08,212a8,8,0,1,0,13.85,8c18.84-32.56,52.14-52,89.07-52s70.23,19.44,89.07,52a8,8,0,1,0,13.85-8ZM72,96a56,56,0,1,1,56,56A56.06,56.06,0,0,1,72,96Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-ev-card-globe" viewBox="0 0 256 256">
      <path
        d="M128,24a104,104,0,1,0,104,104A104.11,104.11,0,0,0,128,24Zm88,104a87.61,87.61,0,0,1-3.33,24H174.16a157.44,157.44,0,0,0,0-48h38.51A87.61,87.61,0,0,1,216,128ZM102,168H154a115.11,115.11,0,0,1-26,45A115.27,115.27,0,0,1,102,168Zm-3.9-16a140.84,140.84,0,0,1,0-48h59.88a140.84,140.84,0,0,1,0,48ZM40,128a87.61,87.61,0,0,1,3.33-24H81.84a157.44,157.44,0,0,0,0,48H43.33A87.61,87.61,0,0,1,40,128ZM154,88H102a115.11,115.11,0,0,1,26-45A115.27,115.27,0,0,1,154,88Zm52.33,0H170.71a135.28,135.28,0,0,0-22.3-45.6A88.29,88.29,0,0,1,206.37,88ZM107.59,42.4A135.28,135.28,0,0,0,85.29,88H49.63A88.29,88.29,0,0,1,107.59,42.4ZM49.63,168H85.29a135.28,135.28,0,0,0,22.3,45.6A88.29,88.29,0,0,1,49.63,168Zm98.78,45.6a135.28,135.28,0,0,0,22.3-45.6h35.66A88.29,88.29,0,0,1,148.41,213.6Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-ev-card-arrow" viewBox="0 0 24 24">
      <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M8.25 3.75L19.5 3.75C19.6989 3.75 19.8897 3.82902 20.0303 3.96967C20.171 4.11032 20.25 4.30109 20.25 4.5V15.75C20.25 16.1642 19.9142 16.5 19.5 16.5C19.0858 16.5 18.75 16.1642 18.75 15.75V6.31066L5.03033 20.0303C4.73744 20.3232 4.26256 20.3232 3.96967 20.0303C3.67678 19.7374 3.67678 19.2626 3.96967 18.9697L17.6893 5.25L8.25 5.25C7.83579 5.25 7.5 4.91421 7.5 4.5C7.5 4.08579 7.83579 3.75 8.25 3.75Z"
        fill="currentColor"></path>
    </symbol>
  </svg>

  <div class="container">
    <div class="flex flex-col items-center gap-20">
      <div
        class="grid w-full grid-cols-1 gap-x-8 gap-y-20 sm:grid-cols-2 lg:grid-cols-3"
        data-ev-grid
      >
        {
          pastEvents.map((event, index) => (
            <a
              href={eventPath(event.slug)}
              data-ev-card
              data-type={event.type}
              data-country={event.country}
              data-datetime={event.datetime}
              data-search={`${event.title} ${event.speakers.join(' ')} ${event.type} ${event.country} ${event.location}`.toLowerCase()}
              class="group flex flex-col gap-6 self-start rounded-xl no-underline"
            >
              <div class="relative aspect-video w-full overflow-hidden rounded-xl border border-ledger-300 bg-visual-placeholder">
                {event.image && (
                  <img
                    src={event.image}
                    alt={event.title}
                    width="1280"
                    height="720"
                    loading={index < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                )}

                <span class="absolute left-4 top-4 flex flex-wrap items-center gap-2">
                  <span class={`${chipClass} border border-ledger-300`}>
                    <svg width="16" height="16" class="shrink-0" aria-hidden="true" focusable="false">
                      <use href={event.type === 'Online' ? '#ct-ev-card-globe' : '#ct-ev-card-user'} />
                    </svg>
                    {event.type}
                  </span>
                </span>

                <span class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-lg bg-ledger-white text-vault-navy transition-colors duration-200 group-hover:bg-nova-blue group-hover:text-ledger-white">
                  <svg width="16" height="16" aria-hidden="true" focusable="false">
                    <use href="#ct-ev-card-arrow" />
                  </svg>
                </span>

                <span class="absolute bottom-4 left-4 right-4 flex flex-wrap gap-2">
                  <span class={chipClass}>{event.speakers[0]}</span>
                </span>
              </div>

              <div class="flex flex-col gap-3">
                {/* Clamped so a long title can't leave one card in the row
                    taller than its neighbours. */}
                <h3 class="line-clamp-2 font-body font-medium text-vault-navy text-[length:var(--fs-label-lg)] leading-[var(--lh-label-lg)] tracking-[var(--tracking-body)] m-0 transition-colors duration-200 group-hover:text-nova-blue">
                  {event.title}
                </h3>

                <div class="flex items-center gap-3">
                  <p class={metaClass}>
                    <svg width="20" height="20" class="shrink-0" aria-hidden="true" focusable="false">
                      <use href="#ct-ev-card-calendar" />
                    </svg>
                    <time datetime={event.datetime}>{event.date}</time>
                  </p>
                  <span class="h-4 w-px shrink-0 rounded-full bg-ledger-300" aria-hidden="true" />
                  <p class={metaClass}>
                    <svg width="20" height="20" class="shrink-0" aria-hidden="true" focusable="false">
                      <use href="#ct-ev-card-clock" />
                    </svg>
                    {event.time}
                  </p>
                </div>
              </div>
            </a>
          ))
        }
      </div>

      {/* Hidden inline, NOT with `hidden`. `setVisible` shows an element by
          clearing its inline display, which hands control back to the class —
          and a `hidden` class would put it straight back to display:none, so
          this message could never appear. Inline start, inline finish. */}
      <p
        data-ev-empty
        role="status"
        style="display: none"
        class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[var(--lh-body-lg)] text-center m-0"
      >
        No events match those filters yet. Try a broader search.
      </p>

      <button
        type="button"
        data-ev-load-more
        class="rounded-lg border border-nova-blue bg-generic-00 px-5 py-3.5 font-body font-medium text-nova-blue text-[length:var(--fs-label-lg)] leading-[var(--lh-label-lg)] shadow-[0px_2px_6px_0px_rgba(16,24,40,0.06)] cursor-pointer transition-colors duration-150 hover:bg-nova-50"
      >
        Load more
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-ev-grid-root]');
    if (!root) return;

    var grid = root.querySelector('[data-ev-grid]');
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-ev-card]'));
    var moreBtn = root.querySelector('[data-ev-load-more]');
    var empty = root.querySelector('[data-ev-empty]');

    var PAGE_SIZE = 9;
    var shown = PAGE_SIZE;

    // Visibility is toggled inline, not with a class: the utilities pasted into
    // Webflow are unlayered, so a `.hidden` class would have to out-order
    // `.flex` on the same element. An inline style always wins.
    function setVisible(el, visible) {
      if (!el) return;
      el.style.display = visible ? '' : 'none';
    }

    function readFilters() {
      var form = document.querySelector('[data-ev-filter]');
      // No filter bar on the page is a valid state — show everything, newest
      // first, which is what the markup order already is.
      if (!form) return { q: '', type: '', country: '', sort: 'new' };
      var search = form.querySelector('[data-ev-search]');
      var type = form.querySelector('[data-ev-type]');
      var country = form.querySelector('[data-ev-country]');
      var sort = form.querySelector('[data-ev-sort]');
      return {
        q: search ? search.value.trim().toLowerCase() : '',
        type: type ? type.value : '',
        country: country ? country.value : '',
        sort: sort && sort.value ? sort.value : 'new',
      };
    }

    function matches(card, f) {
      if (f.type && card.getAttribute('data-type') !== f.type) return false;
      if (f.country && card.getAttribute('data-country') !== f.country) return false;
      if (f.q && (card.getAttribute('data-search') || '').indexOf(f.q) === -1) return false;
      return true;
    }

    function render() {
      var f = readFilters();
      var hits = [];

      cards.forEach(function (card) {
        if (matches(card, f)) hits.push(card);
        setVisible(card, false);
      });

      // ISO dates, so a string compare is a date compare.
      hits.sort(function (a, b) {
        var x = a.getAttribute('data-datetime') || '';
        var y = b.getAttribute('data-datetime') || '';
        if (x === y) return 0;
        if (f.sort === 'old') return x < y ? -1 : 1;
        return x > y ? -1 : 1;
      });

      // Reordering the DOM rather than juggling CSS `order`: the grid is a
      // plain flow container, so append order IS reading order, and screen
      // readers and Tab follow it. Hidden cards stay where they are — they
      // occupy no space, so their position can't be seen.
      if (grid) {
        hits.forEach(function (card) {
          grid.appendChild(card);
        });
      }

      hits.slice(0, shown).forEach(function (card) {
        setVisible(card, true);
      });

      setVisible(empty, hits.length === 0);
      setVisible(moreBtn, hits.length > shown);
    }

    function reset() {
      shown = PAGE_SIZE;
      render();
    }

    // Delegated on `document` so the filter bar can live in a different Webflow
    // Embed, mount later, or not exist at all.
    document.addEventListener('input', function (e) {
      if (e.target.closest && e.target.closest('[data-ev-filter]')) reset();
    });

    document.addEventListener('change', function (e) {
      if (e.target.closest && e.target.closest('[data-ev-filter]')) reset();
    });

    document.addEventListener('submit', function (e) {
      if (e.target.closest && e.target.closest('[data-ev-filter]')) {
        e.preventDefault();
        reset();
      }
    });

    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('[data-ev-load-more]')) {
        shown += PAGE_SIZE;
        render();
      }
    });

    render();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', render);
    }
  })();
</script>
