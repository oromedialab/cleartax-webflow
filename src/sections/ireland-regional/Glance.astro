    <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
        <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-stretch"
        >
            <!-- Left Column: Title, Description & Dot Matrix -->
            <div class="lg:col-span-6 xl:col-span-6 flex flex-col h-full">
