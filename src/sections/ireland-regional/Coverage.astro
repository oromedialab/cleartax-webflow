---
/**
 * "How ClearTax keeps you compliant with ZATCA's e-invoicing mandate" — Figma
 * node 18377:73253 ("Fold 10"). Eight rows, title + sub-line on the left, the
 * longer explanation on the right, divided by hairlines.
 *
 * Every row is drawn at 50% opacity in the Figma: it is the resting state of a
 * scroll-spotlight. A small script lifts the row nearest the middle of the
 * viewport to full opacity as the section scrolls past; without script (or with
 * reduced motion) all rows stay fully legible.
 *
 * The icon squares are unfilled "Visual placeholder" frames in the Figma, so
 * they render as `bg-visual-placeholder` (#E8FFE1). Swap for Webflow-hosted
 * artwork when it lands — never a `data:` URI.
 *
 * Classes and ids are `ksa-cov-` prefixed: embeds share one namespace per page.
 */
interface Row {
    title: string;
    lead: string;
    body: string;
}

const rows: Row[] = [
    {
        title: "Full Ireland mandate coverage",
        lead: "Send and receive Peppol BIS 3.0 invoices and credit notes through ClearTax's Peppol Access Point.",
        body: "B2G invoices to Irish public bodies and long-term archiving run in the same flow.",
    },
    {
        title: "Real-time reporting, handled",
        lead: "When Revenue publishes its reporting specifications, ClearTax builds them into the platform.",
        body: "Your ERP stays as it is, and rule changes arrive as cloud updates at no extra cost.",
    },
    {
        title: "Catch errors before your buyer or Revenue does",
        lead: "AI-powered checks validate every mandatory field, VAT rate and rounding rule before an invoice leaves your ERP.",
        body: "Fewer rejections, faster payments and clean data in every report.",
    },
    {
        title: "Receive-ready from day one",
        lead: "Take in Peppol invoices from any supplier, validate them and post them straight to your ERP.",
        body: "One dashboard tracks every sent and received invoice, its status and any exception, before month-end close.",
    },
    {
        title: "Integrates with any ERP or POS",
        lead: "2,500+ integrations across 50+ ERP and POS systems, including SAP, Oracle, Microsoft Dynamics and NetSuite.",
        body: "AI-driven connectors and structured UAT cut onboarding from weeks to days.",
    },
    {
        title: "Ireland now. Phase Two and ViDA next.",
        lead: "One platform and one API for 50+ countries.",
        body: "Your Irish entities reuse the same integration as Belgium, France, Germany and the rest of your footprint, ready for Ireland's expanded domestic B2B reporting in November 2029 and intra-EU reporting under ViDA in July 2030.",
    },
    {
        title: "Audit-ready books and expert support",
        lead: "Automated reconciliation across invoice, books and VAT data keeps your records clean.",
        body: "A dedicated success manager, 750+ integration engineers and in-house tax experts back you from planning to go-live and beyond.",
    },
];
---

<section id="ksa-cov" class="bg-generic-00 py-16 lg:py-20">
    <div
        class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12"
    >
        <div class="flex flex-col items-center gap-4 text-center">
            <h2
                class="m-0 max-w-156 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
            >
                How ClearTax gets you ready for Ireland's e-invoicing mandate
            </h2>
            <p
                class="m-0 max-w-162 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]"
            >
                One Peppol platform to create, validate, send, receive, report
                and archive every B2B invoice, with Revenue's real-time
                reporting built into the roadmap.
            </p>
        </div>

        <div class="flex w-full flex-col">
            {
                rows.map((r) => (
                    <div class="ksa-cov-row grid grid-cols-1 gap-4 py-6 lg:grid-cols-2 lg:gap-12">
                        <div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-3 lg:gap-y-2">
                            <span
                                class="size-[53px] shrink-0 rounded-lg bg-visual-placeholder self-center lg:self-start lg:row-span-2"
                            />
                            <h3
                                class="m-0 font-heading font-medium text-[19px] leading-[26.6px] text-vault-navy self-center lg:self-start max-w-[370px]"
                            >
                                {r.title}
                            </h3>
                            <p
                                class="m-0 font-body text-[13.3px] leading-[19px] text-vault-navy col-span-2 lg:col-span-1 lg:col-start-2 max-w-[370px]"
                            >
                                {r.lead}
                            </p>
                        </div>
                        <p class="m-0 self-center font-body text-neutral-500 text-[13.3px] leading-[19px]">
                            {r.body}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style is:global>
    .ksa-cov-row + .ksa-cov-row {
        border-top: 1px solid var(--palette-ledger-white);
    }
    .ksa-cov-js .ksa-cov-row {
        opacity: 0.5;
        scale: 0.95;
        transition: all 0.3s ease-in-out;
    }
    .ksa-cov-js .ksa-cov-row.is-active {
        opacity: 1;
        scale: 1;
        transition: all 0.3s ease-in-out;
    }
</style>

<script is:inline>
    (function () {
        var section = document.getElementById("ksa-cov");
        if (!section) return;
        if (
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        )
            return;
        var rows = section.querySelectorAll(".ksa-cov-row");
        if (!rows.length) return;

        section.classList.add("ksa-cov-js");

        // The row whose centre is closest to the middle of the viewport is "on".
        function update() {
            var mid = window.innerHeight / 2;
            var best = null;
            var bestDist = Infinity;
            rows.forEach(function (row) {
                var rect = row.getBoundingClientRect();
                var dist = Math.abs(rect.top + rect.height / 2 - mid);
                if (dist < bestDist) {
                    bestDist = dist;
                    best = row;
                }
            });
            rows.forEach(function (row) {
                row.classList.toggle("is-active", row === best);
            });
        }

        var ticking = false;
        function onScroll() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(function () {
                ticking = false;
                update();
            });
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();
    })();
</script>
