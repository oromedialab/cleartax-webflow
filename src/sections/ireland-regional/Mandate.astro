---
/**
 * "Saudi Arabia e-invoicing at a glance" — Figma node 18377:72678. Heading and lede,
 * then a 2x2 grid of cards that each carry a plus control.
 *
 * A card is a button: clicking it opens ONE overlay dialog showing that card's
 * heading and body, with prev/next chevrons to walk the other three without
 * closing. Pattern and mechanics copied from `spain-regional/Supports.astro`;
 * the overlay renders its layout once and swaps only the heading / body /
 * visual that differ per card.
 *
 * The Figma shows the cards collapsed only, so the body copy is drafted from the
 * FAQ and steps on this page. Review with content before staging.
 *
 * The card icons and the overlay visual are unfilled placeholder frames in the
 * Figma, so they render as `bg-visual-placeholder` (#E8FFE1). Swap for
 * Webflow-hosted artwork when it lands — never a `data:` URI.
 *
 * Ids and data attributes are `ir-glance-` prefixed: embeds share one
 * namespace per page.
 */
interface Card {
    heading: string;
    body: string;
    img: string;
    image?: string;
}

const cards: Card[] = [
    {
        heading: "EN 16931 e-invoices, not PDFs",
        body: "Every in-scope B2B invoice must be a structured, machine-readable file that complies with EN 16931, typically Peppol BIS Billing 3.0 in UBL XML. PDFs, scans and emailed attachments won't count. Invoices must still carry every field the VAT Consolidation Act 2010 requires.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aec914d818a73f351a82eae_icon-1.png",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b055d28bd928b593f33e7aa_ir-img-1.png",
    },
    {
        heading: "Exchanged over Peppol",
        body: "Ireland builds on the Peppol network public bodies have used since 2019. You send and receive through an accredited Peppol Access Point, not email. The Office of Government Procurement is Ireland's Peppol Authority; Revenue leads the B2B mandate.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccb069772fdea8e04033_ir-icon-5.png",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b055d2ec31816d9354ee0ae_ir-img-2.png",
    },
    {
        heading: "Near-real-time reporting to Revenue",
        body: "In-scope businesses must also report a subset of invoice data to Revenue in near real time, adding Revenue as a 'fifth corner' to the Peppol exchange. Revenue will publish the data fields and technical specifications before each phase.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccb50312b33243ae8407_ir-icon-6.png",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b055d332c095c7a3d2928d0_ir-img-3.png",
    },
    {
        heading: "Everyone must be able to receive",
        body: "From 1 November 2028, every VAT-registered business in Ireland must be able to receive structured e-invoices, even if it isn't yet required to issue them. Your AP team needs a way to take Peppol invoices in and post them to your ERP.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccb995f64f9f15666e9d_ir-icon-7.png",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b055d391c4c4804c31dec4d_ir-img-4.png",
    },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
    <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12">
        <div class="flex flex-col items-center gap-6 text-center">
            <h2 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]">
                What Ireland's mandate asks of your finance team
            </h2>
        </div>

        <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-8">
            {cards.map((card, i) => (
                <button
                    type="button"
                    class="group m-0 flex w-full cursor-pointer items-center justify-between gap-3 sm:gap-4 md:gap-5 rounded-xl border border-neutral-300 bg-generic-00 p-4 sm:p-5 md:p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue"
                    aria-haspopup="dialog"
                    data-ir-glance-open
                    data-ir-glance-index={i}
                >
                    <img
                        src={card.img}
                        alt=""
                        height="56"
                        width="56"
                        loading="lazy"
                        class="shrink-0 h-14 w-14 object-contain rounded-lg"
                    />
                    <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)] md:text-[length:var(--fs-body-lg)] md:leading-[length:var(--lh-body-lg)] lg:text-[length:var(--fs-h6)] lg:leading-[length:var(--lh-h6)]">
                        {card.heading}
                    </span>
                    <span
                        class="ml-auto flex h-10 w-10 sm:h-12 sm:w-12 lg:h-14 lg:w-14 shrink-0 items-center justify-center rounded-lg p-1.5 sm:p-2 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
                        aria-hidden="true"
                    >
                        <svg
                            class="h-6 w-6 sm:h-8 sm:w-8 lg:h-10 lg:w-10"
                            viewBox="0 0 40 40"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M20 10V30"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                            <path
                                d="M30 20L10 20"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </span>
                </button>
            ))}
        </div>
    </div>
</section>

<!-- Detail overlay -->
<div
    id="ir-glance-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ir-glance-overlay-title"
    aria-hidden="true"
    class="fixed inset-0 z-[2000] hidden items-center justify-center p-4 backdrop-blur-sm"
    style="background-color: rgba(0, 0, 0, 0.7);"
>
    <div
        class="relative max-h-[90vh] w-full max-w-[630px] overflow-y-auto rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6"
        data-ir-glance-panel
    >
        <button
            type="button"
            aria-label="Close"
            class="absolute right-6 top-6 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-5 lg:top-5"
            data-ir-glance-close
        >
            <svg
                width="40"
                height="40"
                viewBox="0 0 40 40"
                fill="none"
                class="rotate-45"
                aria-hidden="true"
                focusable="false"
            >
                <path
                    d="M20 10V30"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                ></path>
                <path
                    d="M30 20L10 20"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                ></path>
            </svg>
        </button>

        <div class="flex flex-col items-start gap-6">
            <div class="flex w-full flex-col justify-between gap-6">
                <div class="flex items-center gap-4">
                    <div class="size-[56px] shrink-0">
                        {cards.map((card, i) => (
                            <span
                                class="size-[56px] shrink-0 items-center justify-center"
                                style={
                                    i === 0
                                        ? "display: flex;"
                                        : "display: none;"
                                }
                                hidden={i !== 0}
                                data-ir-glance-icon
                            >
                                <img
                                    src={card.img}
                                    alt={card.heading}
                                    class="object-contain size-[56px] shrink-0"
                                />
                            </span>
                        ))}
                    </div>
                    <div id="ir-glance-overlay-title">
                        {cards.map((card, i) => (
                            <h3
                                class="m-0 pr-12 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px] text-balance"
                                style={
                                    i === 0
                                        ? "display: block;"
                                        : "display: none;"
                                }
                                hidden={i !== 0}
                                data-ir-glance-heading
                            >
                                {card.heading}
                            </h3>
                        ))}
                    </div>
                </div>

                <div class="aspect-[574/322] w-full max-w-[574px] rounded-lg overflow-hidden bg-visual-placeholder mx-auto flex items-center justify-center">
                    {cards.map((card, i) =>
                        card.image ? (
                            <img
                                src={card.image}
                                alt={card.heading}
                                class="h-full w-full object-contain"
                                style={
                                    i === 0
                                        ? "display: block;"
                                        : "display: none;"
                                }
                                hidden={i !== 0}
                                data-ir-glance-image
                            />
                        ) : (
                            <div
                                class="w-full h-full bg-visual-placeholder flex items-center justify-center"
                                style={
                                    i === 0
                                        ? "display: block;"
                                        : "display: none;"
                                }
                                hidden={i !== 0}
                                data-ir-glance-image
                            />
                        ),
                    )}
                </div>

                <div class="flex flex-col gap-6">
                    <div>
                        {cards.map((card, i) => (
                            <p
                                class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                                style={
                                    i === 0
                                        ? "display: block;"
                                        : "display: none;"
                                }
                                hidden={i !== 0}
                                data-ir-glance-body
                            >
                                {card.body}
                            </p>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style is:global>
    #ir-glance-overlay {
        background-color: rgba(0, 0, 0, 0.7);
    }
    [data-ir-glance-heading][hidden],
    [data-ir-glance-body][hidden],
    [data-ir-glance-icon][hidden],
    [data-ir-glance-image][hidden] {
        display: none !important;
    }
</style>

<script is:inline>
    (function () {
        var overlay = document.getElementById("ir-glance-overlay");
        if (!overlay) return;

        var panel = overlay.querySelector("[data-ir-glance-panel]");
        var closeBtn = overlay.querySelector("[data-ir-glance-close]");
        var headings = overlay.querySelectorAll("[data-ir-glance-heading]");
        var bodies = overlay.querySelectorAll("[data-ir-glance-body]");
        var icons = overlay.querySelectorAll("[data-ir-glance-icon]");
        var images = overlay.querySelectorAll("[data-ir-glance-image]");
        if (!panel || !headings.length) return;

        var count = headings.length;
        var current = 0;
        var lastFocused = null;

        function show(index) {
            current = ((index % count) + count) % count;
            for (var i = 0; i < count; i++) {
                headings[i].hidden = i !== current;
                headings[i].style.display = i === current ? "block" : "none";
                if (bodies[i]) {
                    bodies[i].hidden = i !== current;
                    bodies[i].style.display = i === current ? "block" : "none";
                }
                if (icons[i]) {
                    icons[i].hidden = i !== current;
                    icons[i].style.display = i === current ? "flex" : "none";
                }
                if (images[i]) {
                    images[i].hidden = i !== current;
                    images[i].style.display = i === current ? "block" : "none";
                }
            }
            panel.scrollTop = 0;
        }

        function open(index, opener) {
            lastFocused = opener || document.activeElement;
            show(index);
            overlay.style.display = "flex";
            overlay.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
            if (closeBtn) closeBtn.focus();
        }

        function close() {
            overlay.style.display = "none";
            overlay.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
            if (lastFocused && lastFocused.focus) lastFocused.focus();
        }

        function isOpen() {
            return overlay.style.display === "flex";
        }

        document.addEventListener("click", function (e) {
            if (!e.target.closest) return;
            var opener = e.target.closest("[data-ir-glance-open]");
            if (!opener) return;
            open(
                parseInt(opener.getAttribute("data-ir-glance-index"), 10) || 0,
                opener,
            );
        });

        if (closeBtn) closeBtn.addEventListener("click", close);

        overlay.addEventListener("click", function (e) {
            if (e.target === overlay) close();
        });

        document.addEventListener("keydown", function (e) {
            if (!isOpen()) return;

            if (e.key === "Escape") {
                close();
                return;
            }

            if (e.key === "ArrowLeft") {
                show(current - 1);
                return;
            }
            if (e.key === "ArrowRight") {
                show(current + 1);
                return;
            }

            if (e.key !== "Tab") return;
            var focusable = panel.querySelectorAll(
                'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
            );
            if (!focusable.length) return;
            var first = focusable[0];
            var last = focusable[focusable.length - 1];

            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });
    })();
</script>
