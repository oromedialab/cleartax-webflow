---
/**
 * "Real life examples" — Figma node 16104:38824
 * ("Container: We speak the language of your existing systems." — the Figma
 * frame name is stale/mismatched; the rendered heading and content is
 * "Real life examples").
 *
 * Bordered two-column card: left is a worked example with a bullet list of
 * findings, right is a visual placeholder carrying a floating result callout.
 */
const findings = [
  "Duplicate invoice bookings",
  "Vendor master discrepancies",
  "Delayed accounting",
  "MSME payment breaches",
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] mx-auto w-full px-4 md:px-6">
    <div
      class="flex flex-col lg:flex-row gap-6 lg:gap-8 border border-neutral-200 rounded-xl p-6"
    >
      <div class="flex flex-col gap-6 flex-1">
        <div class="flex flex-col gap-4">
          <h2
            class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
          >
            Real life examples
          </h2>
          <p
            class="m-0 font-body text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
          >
            12 automated controls. 6 entities. $13M of exposure surfaced
          </p>
        </div>

        <div class="h-px w-full bg-ledger-100"></div>

        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-4">
            <p
              class="m-0 font-body text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)] max-w-88"
            >
              Clarity AI tested every invoice, vendor record and GL entry across
              six entities, not a sample.
            </p>
            <div class="flex flex-col gap-2">
              <p
                class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
              >
                It surfaced 16 observations, including:
              </p>
              <ul class="list-none m-0 p-0 flex flex-col gap-2">
                {
                  findings.map((f) => (
                    <li class="flex items-center gap-2">
                      <span
                        class="shrink-0 w-2 h-2 rounded-full bg-nova-blue"
                        aria-hidden="true"
                      />
                      <span class="font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                        {f}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <p
            class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] max-w-87.5"
          >
            And because the controls run every month, the same issue doesn't
            wait until year-end to be discovered.
          </p>
        </div>
      </div>

      <div class="flex-1 flex items-center justify-center">
        <img
          src="/images/account-payable/account.png"
          alt="Duplicate revenue postings detected"
          width="598"
          height="406"
          class="w-full h-auto object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
