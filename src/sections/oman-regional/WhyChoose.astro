---
/**
 * "Why Choose ClearTax?" — Figma node 15121:20972 ("Fold 4" in the main page
 * flow).
 *
 * Left: five-row accordion with animated progress line loader and autoplay.
 * Clicking a row selects it and restarts the progress timer.
 * Responsive (<lg): the visual placeholder is nested inside the open accordion
 * item so mobile users see the corresponding graphic.
 * Desktop (lg+): the right-hand visual panel displays the active slide.
 */
interface Row {
  heading: string;
  body: string;
  image?: string;
}

const rows: Row[] = [
  {
    heading: "Fast Implementation",
    body: "Seamlessly integrate with any ERP or POS Systems in just 7 days",
  },
  {
    heading: "Local Compliance Expertise",
    body: "Stay aligned with Oman Tax Authority requirements with real-time alerts.",
  },
  {
    heading: "Scalable Global Platform",
    body: "Manage Oman and 50+ countries' mandates on a single unified platform.",
  },
  {
    heading: "Seamless Integration",
    body: "One-time integration with all govt updates incorporated in the platform.",
  },
  {
    heading: "AI-Powered Accuracy",
    body: "Prevent errors and ensure smooth invoice processing with smart error correction & VAT reconciliation.",
  },
];
---

<section class="om-why bg-generic-00 py-12 lg:py-20">
  <div class="max-w-[var(--container-max)] mx-auto px-6 w-full">
    <div class="flex flex-col items-center gap-12">
      <h2
        class="m-0 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] max-w-[737px]"
      >
        Why Choose ClearTax?
      </h2>

      <div class="grid w-full grid-cols-1 items-center gap-8 lg:grid-cols-[540px_1fr] lg:gap-[120px]">
        <div class="flex flex-col" data-why-root id="om-why-tabs">
          {
            rows.map((row, i) => (
              <div
                class:list={[
                  "om-why-item group py-6 first:pt-0 last:pb-0 cursor-pointer flex flex-col",
                  i === 0 && "active",
                ]}
                data-why-item
                data-why-index={i}
              >
                <p class="m-0 font-heading font-medium text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] text-neutral-500 transition-colors duration-300 group-[.active]:text-vault-navy">
                  {row.heading}
                </p>
                <div
                  class="om-why-desc overflow-hidden transition-all duration-300 ease-in-out"
                  style={i === 0 ? "" : "max-height: 0px; opacity: 0;"}
                >
                  <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] max-w-[480px] pt-4">
                    {row.body}
                  </p>

                  <!-- Mobile Visual (appears inside open tab on responsive/mobile) -->
                  <div
                    class="lg:hidden w-full aspect-[16/10] rounded-lg bg-visual-placeholder border border-neutral-200/60 mt-4 mb-3 overflow-hidden"
                    aria-hidden="true"
                  />
                </div>

                <!-- Progress line loader -->
                <div class="relative w-full h-[2px] bg-neutral-200 mt-6 rounded-full overflow-hidden">
                  <!-- Active blue line (fills up) -->
                  <div
                    class="om-why-progress absolute left-0 top-0 h-full bg-nova-blue rounded-full transition-none"
                    style="width: 0%;"
                  />
                </div>
              </div>
            ))
          }
        </div>

        <!-- Desktop Visual (Right side slider with visible gap between slides) -->
        <div
          class="hidden lg:flex relative min-h-[300px] w-full self-stretch lg:min-h-[460px] overflow-hidden rounded-lg"
          data-why-thumbs
        >
          <div
            id="om-why-track"
            class="flex w-full h-full transition-transform duration-500 gap-6 ease-in-out will-change-transform"
            style="transform: translateX(0%);"
          >
            {
              rows.map((row, i) => (
                <div
                  class="w-full h-full shrink-0 rounded-lg bg-visual-placeholder border border-neutral-200/60 flex items-center justify-center"
                  data-why-panel
                  data-why-index={i}
                  aria-hidden={i !== 0}
                >
                  {row.image && (
                    <img
                      src={row.image}
                      alt={row.heading}
                      class="w-full h-full object-contain"
                    />
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const init = () => {
      const tabsContainer = document.getElementById("om-why-tabs");
      if (!tabsContainer) return;
      const items = tabsContainer.querySelectorAll("[data-why-item]");
      const track = document.getElementById("om-why-track");
      const panels = track
        ? track.querySelectorAll("[data-why-panel]")
        : [];
      if (!items.length) return;

      let currentIndex = 0;
      let timer = null;
      const duration = 5000; // 5 seconds per tab

      const activateTab = (index, instant = false) => {
        currentIndex = index;

        if (track) {
          const gap = parseFloat(window.getComputedStyle(track).gap) || 24;
          if (instant) {
            track.style.transition = "none";
            track.style.transform = `translateX(calc(-${index} * (100% + ${gap}px)))`;
            void track.offsetWidth;
            track.style.transition = "transform 500ms ease-in-out";
          } else {
            track.style.transition = "transform 500ms ease-in-out";
            track.style.transform = `translateX(calc(-${index} * (100% + ${gap}px)))`;
          }
        }

        items.forEach((item, i) => {
          const desc = item.querySelector(".om-why-desc");
          const progress = item.querySelector(".om-why-progress");
          const panel = panels[i];

          if (i === index) {
            item.classList.add("active");
            if (desc) {
              desc.style.maxHeight = desc.scrollHeight + "px";
              desc.style.opacity = "1";
            }
            if (panel) {
              panel.setAttribute("aria-hidden", "false");
            }
            if (progress) {
              progress.style.transition = "none";
              progress.style.width = "0%";
              void progress.offsetWidth; // Force reflow
              if (!instant) {
                progress.style.transition = `width ${duration}ms linear`;
                progress.style.width = "100%";
              }
            }
          } else {
            item.classList.remove("active");
            if (desc) {
              desc.style.maxHeight = "0px";
              desc.style.opacity = "0";
            }
            if (panel) {
              panel.setAttribute("aria-hidden", "true");
            }
            if (progress) {
              progress.style.transition = "width 0.2s ease";
              progress.style.width = "0%";
            }
          }
        });
      };

      const nextTab = () => {
        const next = (currentIndex + 1) % items.length;
        activateTab(next);
      };

      const startTimer = () => {
        clearInterval(timer);
        activateTab(currentIndex);
        timer = setInterval(nextTab, duration);
      };

      items.forEach((item, i) => {
        item.addEventListener("click", () => {
          clearInterval(timer);
          activateTab(i);
          timer = setInterval(nextTab, duration);
        });
      });

      window.addEventListener("resize", () => {
        const activeDesc = items[currentIndex]?.querySelector(".om-why-desc");
        if (activeDesc) {
          activeDesc.style.maxHeight = activeDesc.scrollHeight + "px";
        }
        if (track) {
          const gap = parseFloat(window.getComputedStyle(track).gap) || 24;
          track.style.transform = `translateX(calc(-${currentIndex} * (100% + ${gap}px)))`;
        }
      });

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          clearInterval(timer);
        } else {
          startTimer();
        }
      });

      startTimer();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
