---
/**
 * "Oman E-Invoicing Mandate at a Glance" — Figma node 15121:20929 ("Fold 3 alt").
 *
 * Six-row compliance checklist: an icon placeholder + label on the left, a
 * one-line description on the right, a divider between rows.
 *
 * TODO CONTENT NEEDS LEGAL/SME REVIEW BEFORE STAGING. The Figma source copy for
 * this section is broken — it's leftover/misaligned text from another
 * country's mandate page (the "Transmission model" row referenced the
 * Philippines' BIR clearance process, and the "Archival"/"Penalties" rows had
 * their descriptions swapped). The six descriptions below are neutral
 * placeholder copy consistent with facts already established elsewhere in this
 * repo (Fawtara, OTA accreditation, Peppol, PINT OM validation — see
 * `sections/v1-oman-product/Mandate.astro`), NOT verified Omani tax law. Get
 * these confirmed by legal/compliance before this page ships.
 */
interface Row {
  heading: string;
  body: string;
}

const rows: Row[] = [
  {
    heading: "Transmission model",
    body: "Invoices are validated and transmitted through an OTA-accredited Access Point before reaching the buyer.",
  },
  {
    heading: "Applicability",
    body: "Large taxpayers and enterprises using ERP or accounting software are in scope from the initial phase, with rollout extending by taxpayer segment.",
  },
  {
    heading: "Acceptable formats",
    body: "Structured electronic invoices validated against the PINT OM format — PDFs and scanned copies do not qualify.",
  },
  {
    heading: "Transmission methods",
    body: "Invoices are transmitted via Peppol-based Access Points connected to OTA's Fawtara platform.",
  },
  {
    heading: "Archival",
    body: "Issued and received e-invoices must be retained for the period set by Omani tax law.",
  },
  {
    heading: "Penalties",
    body: "Non-compliance may result in invoice rejection and penalties under OTA regulations; exact enforcement details are to be confirmed.",
  },
];
---

<section class="bg-generic-00 py-12 lg:py-20">
  <div class="max-w-[var(--container-max)] mx-auto px-6 w-full">
    <div class="flex flex-col gap-12">
      <h2
        class="m-0 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        Oman E-Invoicing Mandate at a Glance
      </h2>

      <div class="flex flex-col gap-12">
        <p
          class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]"
        >
          What you must comply with:
        </p>

        <div class="flex flex-col">
          {
            rows.map((row, i) => (
              <div
                class:list={[
                  "grid grid-cols-1 gap-4 py-8 lg:grid-cols-[1fr_547px] lg:items-center lg:gap-8",
                  i < rows.length - 1 && "border-b border-[var(--border-divider,#f2f1f0)]",
                  i === 0 && "pt-0",
                ]}
              >
                <div class="flex items-center gap-6">
                  <span
                    class="block h-10 w-10 shrink-0 rounded-[6px] bg-visual-placeholder"
                    aria-hidden="true"
                  />
                  <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">
                    {row.heading}
                  </p>
                </div>
                <p class="m-0 font-body text-neutral-500/80 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                  {row.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
