---
/**
 * Oman regional hero — Figma node 15121:19306 ("Container - Hero").
 *
 * Background: the Figma shows a wall of scrolling partner-logo tiles across
 * eight staggered columns. Deliberately NOT reproduced pixel-for-pixel — every
 * other brand v2 regional hero built so far (`france-regional/Hero.astro`,
 * `uae-regional/Hero.astro`) substitutes the same interactive stroke field for
 * whatever the Figma shows in this slot, and neither of those took the literal
 * marquee either. Reusing that established pattern keeps this hero consistent
 * with its siblings and avoids sourcing eight columns of partner logos that
 * aren't identified anywhere in the design metadata. Copied from
 * `france-regional/Hero.astro`; only the copy and badges changed.
 *
 * Same four gradient layers over the field — page gradient, radial wash behind
 * the copy, a mobile-only top fade, and a bottom fade.
 *
 * Ids and the canvas id are `om-` prefixed — embeds share one namespace per
 * page and a bare `hero` is exactly the kind of name that collides later.
 *
 * The three badges carry a 37px `bg-visual-placeholder` square where the Figma
 * has an unfilled "Icon placeholder" frame. Swap each for a Webflow-hosted asset
 * once the icons exist — never a `data:` URI, which would blow the paste cap.
 */
interface Props {
  /** Stroke width, and so the diameter of the dot it becomes at rest. */
  lineWidth?: number;
  gap?: number;
  /** Must stay under the grid pitch or the field knits into a mesh. */
  maxLength?: number;
  lengthRadius?: number;
  /** Leave at 1 — a partial turn makes strokes flip as the cursor crosses them. */
  tilt?: number;
  baseColor?: string;
  cursorRadius?: number;
  pull?: number;
  fadeRadius?: number;
}

const {
  lineWidth = 3,
  gap = 24,
  maxLength = 6,
  lengthRadius = 260,
  tilt = 1,
  baseColor = "#C8F006",
  cursorRadius = 320,
  pull = 14,
  fadeRadius = 40,
} = Astro.props;

const badges = [
  {
    label: "FTA-approved Accredited Service Provider (ASP) in the UAE",
    width: "sm:max-w-[320px]",
  },
  {
    label: "AI-powered seamless integration with any ERP/POS systems",
    width: "sm:max-w-[320px]",
  },
  {
    label: "Single global e-Invoicing API supporting 50+ country mandates",
    width: "sm:max-w-[320px]",
  },
];
---

<section
  id="om-hero"
  class="om-hero relative overflow-hidden bg-generic-00"
  data-line-width={String(lineWidth)}
  data-gap={String(gap)}
  data-max-length={String(maxLength)}
  data-length-radius={String(lengthRadius)}
  data-tilt={String(tilt)}
  data-base-color={baseColor}
  data-cursor-radius={String(cursorRadius)}
  data-pull={String(pull)}
  data-fade-radius={String(fadeRadius)}
>
  <!-- Interactive stroke field -->
  <div class="absolute inset-0 z-0 w-full h-full pointer-events-none">
    <canvas id="om-hero-dots" class="absolute inset-0 w-full h-full"></canvas>
  </div>

  <!-- Radial wash, so the headline keeps its contrast over the field -->
  <div
    class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"
  >
  </div>
  <div
    class="absolute inset-0 z-0 bg-[linear-gradient(180deg,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(242,_241,_240,_0.25)_87.79%,_#FFF_100%)] pointer-events-none"
  >
  </div>

  <div class="container mx-auto relative z-10">
    <div
      class="flex flex-col items-center gap-6 text-center max-lg:pt-32 max-lg:pb-16 lg:pt-[257px] lg:pb-[177px]"
    >
      <div class="flex flex-col items-center gap-8 w-full">
        <div class="flex flex-col items-center gap-4">
          <h1
            class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h1)] md:text-[length:var(--fs-display-sm)] lg:text-[length:var(--fs-display-lg)] leading-[length:var(--lh-h1)] md:leading-[length:var(--lh-display-sm)] lg:leading-[length:var(--lh-display-lg)] tracking-[-1px] max-w-[606px]"
          >
            Are You Ready for Fawtara <span class="om-hero-mark">
              E-Invoicing</span
            > in Oman?
          </h1>
          <p
            class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] max-w-252"
          >
