---
/**
 * Closing CTA band — same content as accounts-payable/CtaBand.astro; the doc
 * for this page repeats the same closing copy verbatim.
 *
 * Interactive Dotgrid, same pattern as Hero.astro, but tinted Nova Blue
 * rather than Flux Lime — the brand rule is lime once per screen, and the
 * Hero already spent it.
 *
 * "Book a Demo" opens the HubSpot modal in `DemoModal.astro` (data-demo-open),
 * same as Hero.astro and NavbarRb's CTA.
 */
import Dotgrid from "../_shared/Dotgrid.astro";
---

<section
  id="fp-cta"
  class="relative overflow-hidden bg-[linear-gradient(180deg,_#FFF_0%,_rgba(255,_255,_255,_0.00)_100%)] bg-generic-00 max-lg:py-16 lg:py-[121px]"
>
  <Dotgrid containerId="fp-cta" baseColor="rgba(84, 70, 255, 0.5)" />

  <!-- Radial wash, so the headline keeps its contrast over the field -->
  <div
    class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_20%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"
  >
  </div>

  <div class="container relative z-10">
    <div class="mx-auto flex max-w-205.25 flex-col items-center gap-6 text-center">
      <div class="flex flex-col items-center gap-4">
        <h2 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)]">
          Ready to put AI in the hands of your finance team?
        </h2>
        <p class="m-0 font-body text-vault-navy/60 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
          Trusted data is the prerequisite. More than four in five finance leaders have hit an AI hallucination, and only one in seven fully trusts an AI answer even after review.
        </p>
      </div>

      <a
        href="https://www.cleartax.com/contact-us"
        data-demo-open
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-50 no-underline shadow-[0px_2px_3px_rgba(16,24,40,0.06)] transition-all duration-200 hover:bg-generic-00 hover:text-nova-blue"
      >
        Book a Demo
      </a>
    </div>
  </div>
</section>
