---
/**
 * "Same AI model. Two different answers." — Figma node 16433:50203
 * ("Container - Clarity AI produces outputs generic tools structurally
 * cannot"). Three-column comparison table: question, Generic AI, and
 * Clarity AI, with the Clarity AI column highlighted in Flux Lime.
 */
interface ComparisonCard {
  question: string;
  clarityAi: string;
  genericAi: string;
}

const cards: ComparisonCard[] = [
  {
    question: "What it reads",
    clarityAi: "Every transaction in your payables systems, live",
    genericAi: "Whatever you attach — a payables dump, a vendor list. Sampling isn't a choice it made, it's a limit it has",
  },
  {
    question: "What it checks against",
    clarityAi: "Each invoice matched to its contract, its order and its goods receipt",
    genericAi: "Exact matches on amount and date inside the files. An invoice on its own is just arithmetic",
  },
  {
    question: "What it carries over",
    clarityAi: "Vendor behaviour over time — bank-detail changes and resubmitted duplicates",
    genericAi: "Nothing. Every question starts from zero",
  },
  {
    question: "What comes back",
    clarityAi: "Exceptions that carry the documents that triggered them and the amount at stake",
    genericAi: "A handful of possible duplicates, drawn from a sample of the file",
  },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="container">
    <div class="text-center mx-auto mb-8 md:mb-12 flex flex-col items-center gap-3">
      <h2 class="m-0 font-heading font-medium text-vault-navy text-center text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]">
        Same AI model. Two different answers.
      </h2>
      <p class="m-0 font-body text-neutral-500 text-center text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)]">
        The model isn't what's missing. Four things around it are.
      </p>
    </div>

    <div class="border border-neutral-200 rounded-xl overflow-hidden divide-y divide-neutral-200">
      <div class="grid grid-cols-[110px_1fr_1fr] sm:grid-cols-[160px_1fr_1fr] md:grid-cols-[320px_1fr_1fr] divide-x divide-neutral-200">
        <div></div>
        <div class="flex items-center p-3 md:p-6">
          <p class="m-0 font-body font-medium text-neutral-500 text-[length:var(--fs-body-sm)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-sm)] md:leading-[length:var(--lh-body-lg)]">
            Generic AI
          </p>
        </div>
        <div class="flex items-center p-3 md:p-6 bg-flux-lime">
          <p class="m-0 font-body font-medium text-vault-navy text-[length:var(--fs-body-sm)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-sm)] md:leading-[length:var(--lh-body-lg)]">
            Clarity AI
          </p>
        </div>
      </div>

      {cards.map((card) => (
        <div class="grid grid-cols-[110px_1fr_1fr] sm:grid-cols-[160px_1fr_1fr] md:grid-cols-[320px_1fr_1fr] divide-x divide-neutral-200">
          <div class="flex items-center p-3 md:p-6">
            <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] md:text-[length:var(--fs-h5)] leading-[length:var(--lh-h6)] md:leading-[length:var(--lh-h5)] tracking-[-0.5px]">
              {card.question}
            </p>
          </div>
          <div class="flex items-center p-3 md:p-6">
            <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-sm)] md:text-[length:var(--fs-body)] leading-[length:var(--lh-body-sm)] md:leading-[length:var(--lh-body)]">
              {card.genericAi}
            </p>
          </div>
          <div class="flex items-center p-3 md:p-6 bg-lime-50">
            <p class="m-0 font-body text-vault-navy text-[length:var(--fs-body-sm)] md:text-[length:var(--fs-body)] leading-[length:var(--lh-body-sm)] md:leading-[length:var(--lh-body)]">
              {card.clarityAi}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
