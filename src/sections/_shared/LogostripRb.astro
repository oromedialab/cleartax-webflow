---
/**
 * Shared Logos Marquee component — supporting both simple marquee with H2 title
 * and achievements strip with tile logos.
 */

export interface Achievement {
  label: string;
  emphasis?: boolean;
}

/** A bare URL renders decorative (alt=""). Pass {src, alt} for a real, brand-specific alt. */
export interface LogoItem {
  src: string;
  alt?: string;
}

export interface Props {
  logos?: (string | LogoItem)[];
  achievements?: Achievement[];
  title?: string | null;
  mobileTitle?: string | null;
  variant?: 'default' | 'tiles';
  bgClass?: string;
  containerClass?: string;
  speed?: string;
  pauseOnHover?: boolean;
}

const {
  logos = [],
  achievements = [],
  variant = achievements.length > 0 ? 'tiles' : 'default',
  title = null,
  mobileTitle = null,
  bgClass = 'bg-generic-00 py-6',
  containerClass = 'max-w-[var(--container-max)] w-full px-4 md:px-6 mx-auto',
  speed = '60s',
  pauseOnHover = true,
} = Astro.props;

const normalizedLogos: LogoItem[] = logos.map((l) =>
  typeof l === 'string' ? { src: l, alt: '' } : { src: l.src, alt: l.alt ?? '' }
);
const doubled = [...normalizedLogos, ...normalizedLogos];

const computedMobileTitle =
  mobileTitle ||
  achievements.find((a) => a.emphasis)?.label ||
  (achievements.length > 0 ? 'Trusted by 5000+ enterprises' : null);
---

<section class:list={[bgClass, "overflow-hidden w-full"]}>
  {
    variant === 'tiles' ? (
      <div class:list={[containerClass]}>
        <div class="flex flex-col items-center gap-6">
          {/* Main title if provided */}
          {title && (
            <h2
              class="v2-logos-title text-center text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] font-medium text-vault-navy mb-2 tracking-[-0.5px]"
              set:html={title}
            />
          )}

          {/* Achievements strip */}
          {achievements.length > 0 && (
            <div class="sp-achievements relative w-full">
              {/* Mobile heading */}
              {computedMobileTitle && (
                <h2 class="m-0 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h4)] leading-[length:var(--lh-h4)] md:hidden">
                  {computedMobileTitle}
                </h2>
              )}

              {/* Desktop achievements list */}
              <ul class="hidden md:flex items-center justify-center gap-x-8 list-none m-0 p-0">
                {achievements.map((a, i) => (
                  <>
                    {i > 0 && (
                      <li
                        class="h-4 w-px shrink-0 rounded-full bg-[#CCCCCC]"
                        aria-hidden="true"
                      />
                    )}
                    <li
                      class:list={[
                        "text-center font-body text-vault-navy",
                        a.emphasis
                          ? "text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] font-medium"
                          : "text-[length:var(--fs-body)] leading-[length:var(--lh-body)]",
                      ]}
                    >
                      {a.label}
                    </li>
                  </>
                ))}
              </ul>
            </div>
          )}

          {/* Logo tiles marquee */}
          <div class="sp-marquee relative w-full overflow-hidden">
            <div
              class:list={[
                "sp-track flex w-max items-center gap-2 motion-reduce:animate-none",
                pauseOnHover ? "hover:[animation-play-state:paused]" : "",
              ]}
              style={`--sp-speed: ${speed};`}
            >
              {doubled.map((logo, i) => (
                <span class="flex h-12 w-[124px] shrink-0 items-center justify-center rounded-lg bg-[#F5F5F5]">
                  <img
                    src={logo.src}
                    alt={logo.alt || (i < normalizedLogos.length ? "Customer logo" : "")}
                    aria-hidden={i >= normalizedLogos.length}
                    width="86"
                    height="26"
                    class="h-[26px] w-[86px] object-contain mix-blend-multiply"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class:list={[containerClass]}>
        {title && (
          <h2
            class="v2-logos-title text-center text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] font-medium text-vault-navy mb-8 tracking-[-0.5px] max-lg:mb-11 max-sm:mb-9"
            set:html={title}
          />
        )}
        <div class="relative w-full overflow-hidden bg-transparent [mask-image:linear-gradient(to_right,transparent_0%,black_4%,black_96%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_4%,black_96%,transparent_100%)] group">
          <div class="flex items-center gap-16 [zoom:1.3] w-max origin-left animate-[scroll-logos-global_45s_linear_infinite] py-2 group-hover:[animation-play-state:paused] max-lg:gap-16 max-sm:gap-12 motion-reduce:animate-none">
            {doubled.map((logo, i) => (
              <img
                src={logo.src}
                alt={logo.alt || (i < normalizedLogos.length ? "Customer logo" : "")}
                aria-hidden={i >= normalizedLogos.length}
                width="86"
                height="26"
                class="shrink-0 h-[26px] w-[86px] object-contain mix-blend-multiply transition-all duration-150 ease-in-out hover:scale-105 max-lg:h-[26px] max-lg:w-[76px] max-sm:h-14 max-sm:w-[60px]"
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        </div>
      </div>
    )
  }
</section>

<style is:global>
  /* Standard / V2 logo strip styles */
  .v2-logos-title {
    text-align: center !important;
    font-weight: 500 !important;
    color: var(--color-vault-navy) !important;
    margin-bottom: 32px !important;
    letter-spacing: -0.5px !important;
  }
  @media (max-width: 1024px) {
    .v2-logos-title {
      margin-bottom: 44px !important;
    }
  }
  @media (max-width: 640px) {
    .v2-logos-title {
      margin-bottom: 36px !important;
    }
  }

  @keyframes scroll-logos-global {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Achievements / Tiles logo strip styles */
  .sp-achievements::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      #ffffff 0%,
      rgba(255, 255, 255, 0) 5%,
      rgba(255, 255, 255, 0) 95%,
      #ffffff 100%
    );
  }

  .sp-marquee {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 6%,
      #000 94%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 6%,
      #000 94%,
      transparent 100%
    );
  }

  .sp-track {
    animation: sp-scroll var(--sp-speed, 60s) linear infinite;
  }

  .sp-marquee:hover .sp-track {
    animation-play-state: paused;
  }

  @keyframes sp-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-track {
      animation: none;
    }
  }
</style>
