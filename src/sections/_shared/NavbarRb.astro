---
/**
 * Navbar — brand v2 primitive. Figma "Navbar - 4": a white pill floating over
 * the hero, with link dropdowns and a country switcher.
 *
 * TAKES PROPS AND IS NEVER PASTED DIRECTLY. The embed route renders sections
 * with no props, so the paste unit is a per-page wrapper that supplies content:
 *
 *   <page>/Navbar.astro  ->  <NavbarRb links={…} countries={…} />
 *
 * `Rb` suffix only because `Navbar.astro` is the v1 component and both
 * generations must live in _shared/. Rename once the last v1 page is gone.
 */
export interface NavLink {
  label: string;
  href?: string;
  dropdown?: { label: string; href: string }[];
}

export interface CountryOption {
  name: string;
  flag: string;
  href: string;
  lang?: string;
}

interface Props {
  links?: NavLink[];
  countries?: CountryOption[];
  countryLabel?: string;
  ctaLabel?: string;
  ctaHref?: string;
  logoSrc?: string;
  logoAlt?: string;
  homeHref?: string;
  idPrefix?: string;
}

const {
  links = [],
  countries = [],
  countryLabel = 'Global',
  ctaLabel = 'Request a demo',
  ctaHref = '#gi-signup',
  logoSrc = '',
  logoAlt = 'cleartax',
  homeHref = '/',
  idPrefix = 'rbnav',
} = Astro.props;
---


<header class="rb-nav">
  <div class="container">
    <div class="rb-nav-bar">
      <a class="rb-nav-logo" href={homeHref} aria-label={logoAlt}>
        {logoSrc ? <img src={logoSrc} alt={logoAlt} /> : <span>cleartax</span>}
      </a>

      <nav class="rb-nav-links" aria-label="Primary">
        {links.map((l, i) => (
          l.dropdown ? (
            <div class="rb-nav-item">
              <button
                class="rb-nav-trigger"
                type="button"
                aria-expanded="false"
                aria-controls={`${idPrefix}-menu-${i}`}
              >
                {l.label}<span class="rb-nav-caret" aria-hidden="true"></span>
              </button>
              <div class="rb-nav-drop" id={`${idPrefix}-menu-${i}`}>
                {l.dropdown.map((d) => <a href={d.href}>{d.label}</a>)}
              </div>
            </div>
          ) : (
            <a class="rb-nav-item" href={l.href}>{l.label}</a>
          )
        ))}
      </nav>

      {countries.length > 0 && (
        <div class="rb-nav-item rb-nav-country">
          <button
            class="rb-nav-trigger"
            type="button"
            aria-expanded="false"
            aria-controls={`${idPrefix}-country`}
          >
            <span class="rb-nav-globe" aria-hidden="true"></span>
            {countryLabel}<span class="rb-nav-caret" aria-hidden="true"></span>
          </button>
          <div class="rb-nav-drop rb-nav-drop-wide" id={`${idPrefix}-country`}>
            {countries.map((c) => (
              <a href={c.href}>
                <img src={c.flag} alt="" loading="lazy" />
                <span>
                  {c.name}
                  {c.lang && <em>{c.lang}</em>}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <a class="rb-nav-cta" href={ctaHref}>
        {ctaLabel}<span class="rb-arrow" aria-hidden="true">\u2192</span>
      </a>

      <button class="rb-nav-toggle" type="button" aria-expanded="false" aria-controls={`${idPrefix}-mobile`} aria-label="Open menu">
        <span aria-hidden="true"></span>
      </button>
    </div>

    <div class="rb-nav-menu" id={`${idPrefix}-mobile`} hidden>
      {links.map((l) => (
        l.dropdown
          ? l.dropdown.map((d) => <a href={d.href}>{d.label}</a>)
          : <a href={l.href}>{l.label}</a>
      ))}
      <a class="rb-nav-cta" href={ctaHref}>{ctaLabel}</a>
    </div>
  </div>
</header>

<style is:global>
  .rb-nav {
    position: absolute;
    inset-inline: 0;
    top: var(--spacing-x-big);
    z-index: 50;
  }

  .rb-nav-bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-x-big);
    min-height: 64px;
    padding-inline: var(--spacing-x-big);
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--palette-generic-00);
    box-shadow: 0 1px 2px rgb(5 2 42 / 0.04);
  }

  .rb-nav-logo {
    font-family: var(--font-heading);
    font-size: var(--fs-h6);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
  }

  .rb-nav-logo img { height: 26px; width: auto; display: block; }

  .rb-nav-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-x-big);
    margin-inline-start: auto;
  }

  .rb-nav-item {
    position: relative;
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
  }

  .rb-nav-item:hover,
  .rb-nav-trigger:hover { color: var(--color-nova-blue); }

  .rb-nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xx-sm);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .rb-nav-caret {
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--transition-fast);
  }

  .rb-nav-trigger[aria-expanded='true'] .rb-nav-caret { transform: translateY(1px) rotate(225deg); }

  .rb-nav-globe {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }

  .rb-nav-drop {
    position: absolute;
    inset-inline-start: 0;
    top: calc(100% + var(--spacing-sm));
    display: none;
    flex-direction: column;
    min-width: 220px;
    padding: var(--spacing-x-sm);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--palette-generic-00);
    box-shadow: 0 8px 24px rgb(5 2 42 / 0.08);
  }

  .rb-nav-drop.is-open { display: flex; }

  .rb-nav-drop a {
    padding: var(--spacing-x-sm) var(--spacing-sm);
    border-radius: 8px;
    font-size: var(--fs-label);
    color: var(--color-text);
    white-space: nowrap;
  }

  .rb-nav-drop a:hover { background: var(--color-surface); color: var(--color-nova-blue); }

  .rb-nav-country { margin-inline-start: 0; }

  .rb-nav-drop-wide {
    inset-inline-start: auto;
    inset-inline-end: 0;
    display: none;
    min-width: 460px;
    max-height: 60vh;
    overflow-y: auto;
  }

  .rb-nav-drop-wide.is-open {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-xx-sm);
  }

  .rb-nav-drop-wide a {
    display: flex;
    align-items: center;
    gap: var(--spacing-x-sm);
  }

  .rb-nav-drop-wide img { width: 20px; height: 14px; object-fit: cover; border-radius: 2px; }

  .rb-nav-drop-wide em {
    display: block;
    font-style: normal;
    font-size: var(--fs-label-xs);
    color: var(--color-text-muted);
  }

  .rb-nav-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-x-sm);
    min-height: 40px;
    padding-inline: var(--spacing-md);
    border-radius: 999px;
    background: var(--color-nova-blue);
    color: var(--palette-generic-00);
    font-size: var(--fs-label);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  .rb-nav-cta:hover { background: var(--palette-nova-600); }

  .rb-arrow { font-size: 0.9em; }

  .rb-nav-toggle { display: none; }

  @media (width < 1100px) {
    .rb-nav-links,
    .rb-nav-country,
    .rb-nav-bar > .rb-nav-cta { display: none; }

    .rb-nav-toggle {
      display: block;
      margin-inline-start: auto;
      width: 40px;
      height: 40px;
      background: none;
      border: 0;
      cursor: pointer;
    }

    .rb-nav-toggle span,
    .rb-nav-toggle span::before,
    .rb-nav-toggle span::after {
      display: block;
      height: 2px;
      background: var(--color-text);
      content: '';
    }

    .rb-nav-toggle span::before { transform: translateY(-7px); }
    .rb-nav-toggle span::after  { transform: translateY(5px); }

    .rb-nav-menu {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      margin-top: var(--spacing-x-sm);
      padding: var(--spacing-x-big);
      border-radius: 20px;
      border: 1px solid var(--color-border);
      background: var(--palette-generic-00);
      font-size: var(--fs-label);
    }

    .rb-nav-menu[hidden] { display: none; }
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.rb-nav').forEach(function (nav) {
      var triggers = nav.querySelectorAll('.rb-nav-trigger');

      function closeAll(except) {
        triggers.forEach(function (t) {
          if (t === except) return;
          t.setAttribute('aria-expanded', 'false');
          var d = document.getElementById(t.getAttribute('aria-controls'));
          if (d) d.classList.remove('is-open');
        });
      }

      triggers.forEach(function (t) {
        t.addEventListener('click', function (e) {
          e.stopPropagation();
          var drop = document.getElementById(t.getAttribute('aria-controls'));
          if (!drop) return;
          var open = t.getAttribute('aria-expanded') === 'true';
          closeAll(t);
          t.setAttribute('aria-expanded', String(!open));
          drop.classList.toggle('is-open', !open);
        });
      });

      document.addEventListener('click', function (e) {
        if (!nav.contains(e.target)) closeAll(null);
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeAll(null);
      });

      var toggle = nav.querySelector('.rb-nav-toggle');
      var menu = toggle && document.getElementById(toggle.getAttribute('aria-controls'));
      if (toggle && menu) {
        toggle.addEventListener('click', function () {
          var open = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!open));
          toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
          menu.hidden = open;
        });
      }
    });
  })();
</script>
