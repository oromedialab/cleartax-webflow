---



export interface Testimonial {
  img: string;
  desc: string;
  name: string;
  role: string;
  place: string;
}

export interface Props {
  Leaders?: Testimonial[];
}

const {
  Leaders = [],
} = Astro.props;


---

<section class="bg-generic-00 py-12 lg:py-20">
    <div class="mx-auto lg:container w-full px-4 lg:px-6">

        <div class="text-center mb-12 max-w-195 mx-auto">
            <h2 class="text-[length:var(--fs-h1)] font-medium leading-[length:var(--lh-h1)]">Trusted by industry leaders across the world</h2>
        </div>

        <div class="swiper trusted-swiper" style="mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);">
            <div class="swiper-wrapper !items-stretch">
                {
                    Leaders.map((items) => (
                        <div class="swiper-slide !h-auto !flex">
                            <div class="flex flex-col p-6 lg:p-8 bg-generic-00 w-full h-full border border-neutral-300 rounded-xl">
                                <img src={items.img} alt={items.name} loading="lazy" decoding="async" class="h-[80px] w-[80px] rounded-[16px] mb-8" />
                                <p class="text-[rgb(5_2_42_/_0.7)] font-normal text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] mb-6">{items.desc}</p>
                                <div class="mt-auto">
                                    <h3 class="text-vault-navy font-semibold text-[length:var(--fs-body)] leading-[length:var(--lh-body)] mb-1">{items.name}</h3>
                                    <p class="text-[rgb(5_2_42_/_0.7)] font-medium text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] mb-1">{items.role}</p>
                                    <p class="text-[rgb(5_2_42_/_0.7)] font-medium text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">{items.place}</p>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<style is:inline>
    .trusted-swiper .swiper-wrapper {
        transition-timing-function: linear !important;
        will-change: transform;
    }
    .trusted-swiper .swiper-slide {
        transform: translateZ(0);
        backface-visibility: hidden;
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
        new Swiper('.trusted-swiper', {
            slidesPerView: 1.2,
            spaceBetween: 16,
            loop: true,
            speed: 5000,
            freeMode: true,
            autoplay: {
                delay: 0,
                disableOnInteraction: false,
                pauseOnMouseEnter: true,
            },
            grabCursor: true,
            breakpoints: {
                640: {
                    slidesPerView: 2.2,
                    spaceBetween: 20,
                },
                1024: {
                    slidesPerView: 3,
                    spaceBetween: 24,
                }
            }
        });
    });
</script>