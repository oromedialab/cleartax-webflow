---
export interface Testimonial {
    img: string;
    desc: string;
    name: string;
    role: string;
    place: string;
}

export interface Props {
    Leaders?: Testimonial[];
    /** Section heading. Defaults to the string every existing page already
     *  renders, so adding this prop changes no shipped embed. */
    title?: string;
}

const { Leaders = [], title = "Trusted by industry leaders across the world" } =
    Astro.props;
---

<section class="bg-generic-00 py-12 lg:py-20">
    <div class="mx-auto lg:container w-full px-4 lg:px-6">
        <div class="text-center mb-12 max-w-195 mx-auto">
            <h2
                class="text-[length:var(--fs-h1)] font-medium leading-[length:var(--lh-h1)]"
            >
                {title}
            </h2>
        </div>

        <div class="relative">
            <div
                class="swiper trusted-swiper"
                style="mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);"
            >
                <div class="swiper-wrapper !items-stretch">
                    {
                        Leaders.map((items) => (
                            <div class="swiper-slide !h-auto !flex">
                                <div class="flex flex-col p-4 md:p-6 bg-generic-00 w-full h-full border border-neutral-300 rounded-xl">
                                    <img
                                        src={items.img}
                                        alt={items.name}
                                        loading="lazy"
                                        decoding="async"
                                        class="h-[80px] w-[80px] rounded-[16px] mb-5"
                                    />
                                    <p class="text-vault-navy/70 max-w-100 font-normal text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                                        {items.desc}
                                    </p>
                                    <div class="mt-auto pt-3">
                                        <h3 class="text-vault-navy font-semibold text-[length:var(--fs-body)] leading-[length:var(--lh-body)] mb-1">
                                            {items.name}
                                        </h3>
                                        <p class="text-vault-navy/70 font-medium text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] mb-1">
                                            {items.role}
                                        </p>
                                        <p class="text-vault-navy/70 font-medium text-[length:var(--fs-body-xs)] leading-[length:var(--lh-body-xs)]">
                                            {items.place}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Navigation Buttons -->
            <button
                type="button"
                class="swiper-button-prev-custom absolute left-2 sm:left-4 md:left-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-11 sm:h-11 rounded-lg bg-generic-00 border border-neutral-300 shadow-sm flex items-center justify-center text-vault-navy cursor-pointer"
                aria-label="Previous testimonial"
            >
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M15 18l-6-6 6-6"></path>
                </svg>
            </button>
            <button
                type="button"
                class="swiper-button-next-custom absolute right-2 sm:right-4 md:right-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-11 sm:h-11 rounded-lg bg-generic-00 border border-neutral-300 shadow-sm flex items-center justify-center text-vault-navy cursor-pointer"
                aria-label="Next testimonial"
            >
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M9 18l6-6-6-6"></path>
                </svg>
            </button>
        </div>
    </div>
</section>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>
<script
    is:inline
    src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<style is:inline>
    .trusted-swiper .swiper-slide {
        transform: translateZ(0);
        backface-visibility: hidden;
    }
    .swiper-button-prev-custom.swiper-button-disabled,
    .swiper-button-next-custom.swiper-button-disabled {
        opacity: 0.35;
        cursor: not-allowed;
        pointer-events: none;
    }
</style>

<script is:inline>
    (function () {
        const initSwiper = () => {
            if (typeof Swiper === "undefined") return;
            new Swiper(".trusted-swiper", {
                slidesPerView: 1.2,
                spaceBetween: 16,
                loop: true,
                speed: 500,
                navigation: {
                    prevEl: ".swiper-button-prev-custom",
                    nextEl: ".swiper-button-next-custom",
                },
                grabCursor: true,
                breakpoints: {
                    640: {
                        slidesPerView: 2.2,
                        spaceBetween: 20,
                    },
                    1024: {
                        slidesPerView: 3,
                        spaceBetween: 24,
                    },
                },
            });
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initSwiper);
        } else {
            initSwiper();
        }
    })();
</script>
