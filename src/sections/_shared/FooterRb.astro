---
/**
 * global-invoicing-wip footer — light theme per Figma (node 12239:15601),
 * distinct from the dark _shared/Footer.astro used elsewhere on the site.
 */
export interface BadgeItem {
  alt: string;
  src: string;
}

export interface LinkItem {
  label: string;
  href: string;
}
export interface LinkBlock {
  title: string;
  items: LinkItem[];
}

export interface Props {
  companyLinks?: LinkItem[];
  socialLinks?: LinkItem[];
  productLinks?: LinkItem[];
  resourceLinks?: LinkItem[];
  toolLinks?: LinkItem[];
  regionGroups?: LinkBlock[];
  complianceBadges?: BadgeItem[];
}

const {
  companyLinks = [],
  socialLinks = [],
  productLinks = [],
  resourceLinks = [],
  toolLinks = [],
  regionGroups = [],
  complianceBadges = [],
} = Astro.props;
---

<footer class="bg-generic-00 border-t border-neutral-300">
  <div
    class="max-w-[var(--container-max)] w-full mx-auto flex flex-col gap-12 py-12 px-8"
  >
    <div
      class="grid grid-cols-1 md:grid-cols-3 xl:grid-cols-5 gap-x-12.5 gap-y-0 md:gap-y-10"
    >
      <!-- Company + Social -->
      <div class="flex flex-col gap-0 md:gap-6 w-full md:w-40">
        <div
          class="footer-acc group flex flex-col border-b border-neutral-200 py-4 md:border-0 md:py-0 md:gap-4"
        >
          <button
            type="button"
            class="footer-acc-trigger flex w-full items-center justify-between gap-3 border-0 bg-transparent p-0 text-left cursor-pointer md:cursor-default"
            aria-expanded="false"
          >
            <span
              class="m-0 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-vault-navy"
              >Company</span
            >
            <span
              class="footer-acc-icon md:hidden shrink-0 text-[18px] leading-none font-normal text-neutral-500"
              aria-hidden="true">+</span
            >
          </button>
          <div
            class="footer-acc-panel grid grid-rows-[0fr] md:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-in-out group-[.is-open]:grid-rows-[1fr]"
          >
            <div class="overflow-hidden">
              <div class="flex flex-col gap-3 pt-4 md:pt-0">
                {
                  companyLinks.map((it) => (
                    <a
                      href={it.href}
                      class="text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors"
                    >
                      {it.label}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
        <div
          class="footer-acc group flex flex-col border-b border-neutral-200 py-4 md:border-0 md:py-0 md:gap-4"
        >
          <button
            type="button"
            class="footer-acc-trigger flex w-full items-center justify-between gap-3 border-0 bg-transparent p-0 text-left cursor-pointer md:cursor-default"
            aria-expanded="false"
          >
            <span
              class="m-0 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-vault-navy"
              >Social</span
            >
            <span
              class="footer-acc-icon md:hidden shrink-0 text-[18px] leading-none font-normal text-neutral-500"
              aria-hidden="true">+</span
            >
          </button>
          <div
            class="footer-acc-panel grid grid-rows-[0fr] md:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-in-out group-[.is-open]:grid-rows-[1fr]"
          >
            <div class="overflow-hidden">
              <div class="flex flex-col gap-3 pt-4 md:pt-0">
                {
                  socialLinks.map((it) => (
                    <a
                      href={it.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors"
                    >
                      {it.label}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Product -->
      <div
        class="footer-acc group flex flex-col border-b border-neutral-200 py-4 md:border-0 md:py-0 md:gap-4 w-full md:w-65"
      >
        <button
          type="button"
          class="footer-acc-trigger flex w-full items-center justify-between gap-3 border-0 bg-transparent p-0 text-left cursor-pointer md:cursor-default"
          aria-expanded="false"
        >
          <span
            class="m-0 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-vault-navy"
            >Product</span
          >
          <span
            class="footer-acc-icon md:hidden shrink-0 text-[18px] leading-none font-normal text-neutral-500"
            aria-hidden="true">+</span
          >
        </button>
        <div
          class="footer-acc-panel grid grid-rows-[0fr] md:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-in-out group-[.is-open]:grid-rows-[1fr]"
        >
          <div class="overflow-hidden">
            <div class="flex flex-col gap-3 pt-4 md:pt-0">
              {
                productLinks.map((it) => (
                  <a
                    href={it.href}
                    class="text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors"
                  >
                    {it.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Resources & Guides -->
      <div
        class="footer-acc group flex flex-col border-b border-neutral-200 py-4 md:border-0 md:py-0 md:gap-4 w-full md:w-59"
      >
        <button
          type="button"
          class="footer-acc-trigger flex w-full items-center justify-between gap-3 border-0 bg-transparent p-0 text-left cursor-pointer md:cursor-default"
          aria-expanded="false"
        >
          <span
            class="m-0 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-vault-navy"
            >Resources &amp; Guides</span
          >
          <span
            class="footer-acc-icon md:hidden shrink-0 text-[18px] leading-none font-normal text-neutral-500"
            aria-hidden="true">+</span
          >
        </button>
        <div
          class="footer-acc-panel grid grid-rows-[0fr] md:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-in-out group-[.is-open]:grid-rows-[1fr]"
        >
          <div class="overflow-hidden">
            <div class="flex flex-col gap-3 pt-4 md:pt-0">
              {
                resourceLinks.map((it) => (
                  <a
                    href={it.href}
                    class="text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors"
                  >
                    {it.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Tools -->
      <div
        class="footer-acc group flex flex-col border-b border-neutral-200 py-4 md:border-0 md:py-0 md:gap-4 w-full md:w-48.75"
      >
        <button
          type="button"
          class="footer-acc-trigger flex w-full items-center justify-between gap-3 border-0 bg-transparent p-0 text-left cursor-pointer md:cursor-default"
          aria-expanded="false"
        >
          <span
            class="m-0 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-vault-navy"
            >Tools</span
          >
          <span
            class="footer-acc-icon md:hidden shrink-0 text-[18px] leading-none font-normal text-neutral-500"
            aria-hidden="true">+</span
          >
        </button>
        <div
          class="footer-acc-panel grid grid-rows-[0fr] md:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-in-out group-[.is-open]:grid-rows-[1fr]"
        >
          <div class="overflow-hidden">
            <div class="flex flex-col gap-3 pt-4 md:pt-0">
              {
                toolLinks.map((it) => (
                  <a
                    href={it.href}
                    class="text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors"
                  >
                    {it.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Region groups -->
      <div class="flex flex-col gap-0 md:gap-6">
        {
          regionGroups.map((group) => (
            <div class="footer-acc group flex flex-col border-b border-neutral-200 py-4 md:border-0 md:py-0 md:gap-4 w-full md:w-39.5">
              <button
                type="button"
                class="footer-acc-trigger flex w-full items-center justify-between gap-3 border-0 bg-transparent p-0 text-left cursor-pointer md:cursor-default"
                aria-expanded="false"
              >
                <span class="m-0 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-vault-navy">
                  {group.title}
                </span>
                <span
                  class="footer-acc-icon md:hidden shrink-0 text-[18px] leading-none font-normal text-neutral-500"
                  aria-hidden="true"
                >
                  +
                </span>
              </button>
              <div class="footer-acc-panel grid grid-rows-[0fr] md:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-in-out group-[.is-open]:grid-rows-[1fr]">
                <div class="overflow-hidden">
                  <div class="flex flex-col gap-3 pt-4 md:pt-0">
                    {group.items.map((it) => (
                      <a
                        href={it.href}
                        class="text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors"
                      >
                        {it.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-t border-neutral-200 pt-6"
    >
      <div class="flex flex-col gap-4 max-sm:items-center">
        <div class="flex items-center gap-3">
          <a
            href="https://www.clear.in/s/legal"
            class="text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors"
            >Legal</a
          >
          <a
            href="https://www.clear.in/meta/privacy"
            class="text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors"
            >Privacy Policy</a
          >
        </div>
        <p
          class="m-0 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] text-neutral-500"
        >
          ClearTax is a product by Defmacro Software Pvt. Ltd.
        </p>
      </div>
      <div class="flex flex-col items-center sm:items-end gap-3">
        <div class="flex items-center gap-2.5">
          {
            complianceBadges.map((b) => (
              <img
                src={b.src}
                alt={b.alt}
                class="w-12 h-12 object-contain"
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </div>
        <p
          class="m-0 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] text-neutral-500"
        >
          Your data security and privacy matter most to us.
        </p>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    document.querySelectorAll(".footer-acc").forEach(function (item) {
      var trigger = item.querySelector(".footer-acc-trigger");
      var icon = item.querySelector(".footer-acc-icon");
      if (!trigger) return;
      trigger.addEventListener("click", function () {
        var isOpen = item.classList.toggle("is-open");
        trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
        if (icon) icon.textContent = isOpen ? "−" : "+";
      });
    });
  })();
</script>
