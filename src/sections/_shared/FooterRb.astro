---
/**
 * global-invoicing-wip footer — light theme per Figma (node 12239:15601),
 * distinct from the dark _shared/Footer.astro used elsewhere on the site.
 */
export interface BadgeItem {
  alt: string;
  src: string;
}

export interface LinkItem {
  label: string;
  href: string;
}
export interface LinkBlock {
  title: string;
  items: LinkItem[];
}















export interface Props {
  companyLinks?: LinkItem[];
  socialLinks?: LinkItem[];
  productLinks?: LinkItem[];
  resourceLinks?: LinkItem[];
  toolLinks?: LinkItem[];
  regionGroups?: LinkBlock[];
  complianceBadges?: BadgeItem[];
}

const {
  companyLinks = [],
  socialLinks = [],
  productLinks = [],
  resourceLinks = [],
  toolLinks = [],
  regionGroups = [],
  complianceBadges = [],
} = Astro.props;

---

<footer class="bg-white border-t border-neutral-300">
  <div class="max-w-[var(--container-max)] mx-auto flex flex-col gap-12 py-12 px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 xl:grid-cols-5 gap-x-12.5 gap-y-10">
      <!-- Company + Social -->
      <div class="flex flex-col gap-6 w-40">
        <div class="flex flex-col gap-4">
          <p class="m-0 text-sm font-medium text-vault-navy">Company</p>
          <div class="flex flex-col gap-3">
            {companyLinks.map((it) => (
              <a href={it.href} class="text-sm font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors">
                {it.label}
              </a>
            ))}
          </div>
        </div>
        <div class="flex flex-col gap-4">
          <p class="m-0 text-sm font-medium text-vault-navy">Social</p>
          <div class="flex flex-col gap-3">
            {socialLinks.map((it) => (
              <a href={it.href} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors">
                {it.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Product -->
      <div class="flex flex-col gap-4 w-65">
        <p class="m-0 text-sm font-medium text-vault-navy">Product</p>
        <div class="flex flex-col gap-3">
          {productLinks.map((it) => (
            <a href={it.href} class="text-sm font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors">
              {it.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Resources & Guides -->
      <div class="flex flex-col gap-4 w-59">
        <p class="m-0 text-sm font-medium text-vault-navy">Resources &amp; Guides</p>
        <div class="flex flex-col gap-3">
          {resourceLinks.map((it) => (
            <a href={it.href} class="text-sm font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors">
              {it.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Tools -->
      <div class="flex flex-col gap-4 w-48.75">
        <p class="m-0 text-sm font-medium text-vault-navy">Tools</p>
        <div class="flex flex-col gap-3">
          {toolLinks.map((it) => (
            <a href={it.href} class="text-sm font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors">
              {it.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Region groups -->
      <div class="flex flex-col gap-6">
        {regionGroups.map((group) => (
          <div class="flex flex-col gap-4 w-39.5">
            <p class="m-0 text-sm font-medium text-vault-navy">{group.title}</p>
            <div class="flex flex-col gap-3">
              {group.items.map((it) => (
                <a href={it.href} class="text-sm font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors">
                  {it.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-t border-neutral-200 pt-6">
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <a href="https://www.cleartax.com/s/legal" class="text-sm font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors">Legal</a>
          <a href="https://www.cleartax.com/meta/privacy" class="text-sm font-medium text-neutral-500 no-underline hover:text-vault-navy transition-colors">Privacy Policy</a>
        </div>
        <p class="m-0 text-sm text-neutral-500">ClearTax is a product by Defmacro Software Pvt. Ltd.</p>
      </div>
      <div class="flex flex-col items-start sm:items-end gap-3">
        <div class="flex items-center gap-2.5">
          {complianceBadges.map((b) => (
            <img src={b.src} alt={b.alt} class="w-12 h-12 object-contain" loading="lazy" decoding="async" />
          ))}
        </div>
        <p class="m-0 text-sm text-neutral-500">Your data security and privacy matter most to us.</p>
      </div>
    </div>
  </div>
</footer>
