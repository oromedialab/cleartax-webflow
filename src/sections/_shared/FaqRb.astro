---
/**
 * Global E-Invoicing FAQ accordion.
 * Content and accordion/load-more logic ported from src/sections/global/FAQ.astro
 * (same 11 questions), restyled as a flat single-column list per the
 * global-invoicing-wip Figma design (node 12064:8238).
 */
interface FaqItem {
  q: string;
  a:
    | string
    | Array<
        { kind: "p"; html: string } | { kind: "ul" | "ol"; items: string[] }
      >;
}



interface Props {
  items?: FaqItem[];
}

const {
  items = [],
} = Astro.props;


// Generate JSON-LD Schema
const schemaData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map(item => {
    let answerText = "";
    if (typeof item.a === "string") {
      answerText = item.a;
    } else {
      answerText = item.a.map(block => {
        if (block.kind === "p") {
          return block.html;
        } else {
          return block.items.map(li => `- ${li}`).join("\n");
        }
      }).join("\n\n");
    }
    const plainText = answerText.replace(/<\/?[^>]+(>|$)/g, "");
    return {
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": plainText
      }
    };
  })
};
---

<section class="faq-section bg-white py-16 lg:py-20" id="faq">
  <div class="max-w-[var(--container-max)] mx-auto px-4">
    <div class="max-w-155 mx-auto flex flex-col items-center gap-4 text-center mb-8">
      <h2 class="m-0 text-[28px] sm:text-[36px] lg:text-[40px] leading-[1.2] font-medium text-vault-navy">
        Frequently Asked Questions
      </h2>
      <p class="m-0 text-base lg:text-lg leading-[1.55] text-neutral-500">
        Everything you need to know about global e-invoicing mandates, compliance, and the ClearTax platform.
      </p>
    </div>

    <div class="">
      <div class="flex flex-col" data-faq-root>
        {
          items.map((it, i) => (
            <div
              class={`faq-item group border p-3 mb-3 rounded-xl border-neutral-200 ${i === 0 ? "faq-open" : ""} ${i >= 5 ? "hidden hidden-faq" : ""}`}
            >
              <button
                class="faq-trigger flex w-full appearance-none items-center justify-between gap-3 border-0 bg-transparent py-4 text-left cursor-pointer"
                type="button"
                aria-expanded={i === 0 ? "true" : "false"}
              >
                <h4 class="faq-question min-w-0 flex-1 text-base font-medium text-vault-navy">
                  {it.q}
                </h4>
                <span class="faq-icon flex size-5 shrink-0 items-center justify-center transition-transform duration-300 ease-in-out group-[.faq-open]:rotate-180" aria-hidden="true">
                  <svg width="12" height="7" viewBox="0 0 11.5 6.5" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10.75 0.75L5.75 5.75L0.75 0.75" stroke="var(--palette-neutral-500)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </button>
              <div class={`faq-panel overflow-hidden transition-[height] duration-[320ms] [transition-timing-function:cubic-bezier(.4,0,.2,1)] ${i === 0 ? "h-auto" : "h-0"}`}>
                <div class="faq-answer pb-4 text-sm text-neutral-500 leading-[1.6] [&_li]:mb-2 [&_ol]:m-0 [&_ol]:pl-5 [&_p:last-child]:mb-0 [&_p]:mb-3 [&_p]:mt-0 [&_strong]:text-vault-navy [&_ul]:m-0 [&_ul]:pl-5">
                  {typeof it.a === "string" ? (
                    <p set:html={it.a} />
                  ) : (
                    it.a.map((block) =>
                      block.kind === "p" ? (
                        <p set:html={block.html} />
                      ) : block.kind === "ul" ? (
                        <ul class="list-disc pl-5">
                          {block.items.map((li) => (
                            <li set:html={li} />
                          ))}
                        </ul>
                      ) : (
                        <ol class="list-decimal pl-5">
                          {block.items.map((li) => (
                            <li set:html={li} />
                          ))}
                        </ol>
                      ),
                    )
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {
        items.length > 5 && (
          <div class="mt-8 flex items-center justify-center" id="faq-load-more-container">
            <button
              id="faq-load-more-btn"
              class="inline-flex items-center font-body justify-center gap-2 rounded-lg border border-navy-400 bg-white px-5 py-3.5 text-base font-medium text-navy-400 shadow-[0_2px_6px_rgba(16,24,40,0.06)] outline-none transition-opacity duration-200 hover:opacity-80 cursor-pointer"
            >
              Load more
            </button>
          </div>
        )
      }
    </div>
  </div>
</section>

<!-- Inject FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<script is:inline>
  (function () {
    const root = document.querySelector("[data-faq-root]");
    if (!root) return;
    const items = root.querySelectorAll(".faq-item");

    const loadMoreBtn = document.getElementById("faq-load-more-btn");
    const loadMoreContainer = document.getElementById("faq-load-more-container");
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener("click", function () {
        const hiddenItems = root.querySelectorAll(".hidden-faq");
        hiddenItems.forEach(function (item) {
          item.classList.remove("hidden", "hidden-faq");
        });
        if (loadMoreContainer) {
          loadMoreContainer.style.display = "none";
        }
      });
    }
    function closeItem(item, panel, trigger) {
      panel.style.height = panel.scrollHeight + "px";
      requestAnimationFrame(function () {
        panel.style.height = "0px";
      });
      item.classList.remove("faq-open");
      trigger.setAttribute("aria-expanded", "false");
    }

    function openItem(item, panel, trigger) {
      panel.style.height = panel.scrollHeight + "px";
      item.classList.add("faq-open");
      trigger.setAttribute("aria-expanded", "true");
      panel.addEventListener("transitionend", function handler(e) {
        if (e.propertyName !== "height") return;
        panel.removeEventListener("transitionend", handler);
        if (item.classList.contains("faq-open"))
          panel.style.height = "auto";
      });
    }

    items.forEach(function (item) {
      const trigger = item.querySelector(".faq-trigger");
      const panel = item.querySelector(".faq-panel");
      if (!trigger || !panel) return;

      trigger.addEventListener("click", function () {
        const isOpen = item.classList.contains("faq-open");
        if (isOpen) {
          closeItem(item, panel, trigger);
          return;
        }

        items.forEach(function (other) {
          if (other === item || !other.classList.contains("faq-open")) return;
          const otherPanel = other.querySelector(".faq-panel");
          const otherTrigger = other.querySelector(".faq-trigger");
          if (otherPanel && otherTrigger) closeItem(other, otherPanel, otherTrigger);
        });

        openItem(item, panel, trigger);
      });

      window.addEventListener("resize", function () {
        if (item.classList.contains("faq-open")) panel.style.height = "auto";
      });
    });
  })();
</script>
