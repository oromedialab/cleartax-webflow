---
interface Props {
    title?: string;
    items?: {
        title: string;
        desc: string;
        img?: string;
    }[];
}

const {
    title = "",
    items = []
} = Astro.props;
---

<section class="pt-16 md:pt-20 bg-generic-00">
    <div class="mx-auto lg:container px-4 md:px-6">
        {title && (
            <div class="text-center mb-8 md:mb-12">
                <h2 class="font-heading text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium max-w-[800px] mx-auto m-0 text-text-default">{title}</h2>
            </div>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            {
                items.map((item) => (
                    <div class="flex items-start gap-4 p-6 md:p-8 border border-neutral-200 rounded-xl bg-generic-00">
                        <div class="w-8 h-8 shrink-0 bg-visual-placeholder rounded mt-1"></div>
                        <div class="flex flex-col gap-2 md:gap-3">
                            <h3 class="font-heading text-[length:var(--fs-h6)] md:text-[length:var(--fs-h5)] leading-[length:var(--lh-h6)] md:leading-[length:var(--lh-h5)] font-medium text-text-default m-0">{item.title}</h3>
                            <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] font-normal m-0">{item.desc}</p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
