                      style="background: radial-gradient(ellipse 75% 65% at 50% 92%, rgba(212, 248, 66, 0.14) 0%, rgba(212, 248, 66, 0) 70%);"
                    ></div>

                    <!-- Frame 1: Center Heading -->
                    <div class="gh-card0-center-title pointer-events-none absolute inset-x-0 top-[26%] z-10 flex flex-col items-center justify-center text-center opacity-100 px-4">
                      <h3 class="m-0 font-heading font-medium text-vault-navy text-base md:text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                        What would you like to analyze?
                      </h3>
                    </div>

                    <!-- Top Stage Area: Frame 3 & 4 Chat Bubble, Frame 5 Chart Header -->
                    <div class="gh-card0-top-stage relative z-10 w-full shrink-0 min-h-[42px] flex items-start">
                      <!-- Frame 3 & 4: User query bubble at top-right -->
                      <div class="gh-card0-bubble absolute right-0 top-0 self-end max-w-fit rounded-2xl border border-[#1118271F] bg-[#EDEDED] px-3.5 py-1.5 md:px-4 md:py-2 opacity-0 pointer-events-none shadow-xs">
