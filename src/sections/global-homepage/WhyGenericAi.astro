<style is:global>
  /* Which header shows is a question of available HEIGHT, not just width, so it
     cannot be a plain Tailwind breakpoint. Driving both copies from one rule
     here also means there is no specificity race between a `hidden` utility in
     the head bundle and an override in this block, which is pasted later.

     Above 860px tall the header rides inside the first sticky wrapper (the
     Figma layout). Below that, its ~200px would push the card's captions under
     the fold, so it reverts to scrolling away like the mobile copy does. */
  .gh-why-header-stuck {
    display: none;
  }
  .gh-why-sticky {
    --gh-why-header-offset: 0px;
  }

  @media (min-width: 768px) and (min-height: 860px) {
    .gh-why-header-flow {
      display: none;
    }
    .gh-why-header-stuck {
      display: block;
    }
    .gh-why-sticky {
      --gh-why-header-offset: 180px;
    }
  }

  /* Card height budget. The whole stack has to fit in the viewport or the
     captions at the bottom of the front card are unreachable — it is sticky, so
     you cannot scroll to them.

       top offset (--nav-clear, clears the fixed navbar) + header + card
         + 16px sliver x 4 cards behind  <=  100vh

     The top offset is subtracted as the token rather than folded into the
     constant, so raising the site-wide clearance shrinks this budget by the
     same amount instead of silently pushing the card past the fold.

     The stuck-header regime therefore subtracts the clearance + 280px: ~212
     header + 64 slivers. The old flat 300px under-counted by ~76px, which is
     why the card overflowed the window at every height below ~940px. With the
     header scrolled away there is no header to pay for, so 90px is enough. */
  .gh-why-card-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .gh-why-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto minmax(0, 1fr) auto;
      column-gap: 2rem;
    }
  }

  .gh-why-card {
    --gh-why-card-h: clamp(
      510px,
      calc(100vh - var(--nav-clear, 112px) - 70px),
      610px
    );
  }

  @media (min-height: 860px) {
    .gh-why-card {
      --gh-why-card-h: clamp(
        530px,
        calc(100vh - var(--nav-clear, 112px) - 240px),
        620px
      );
    }
  }

  /* Sticky and the scroll-driven shrink are both enhancements. Switched off, the
     cards read as a plain stack — so the huge scroll gaps that exist only to give
     the stack travel have to go with them. */
  @media (prefers-reduced-motion: reduce) {
    .gh-why-stack {
      gap: 2rem !important;
    }
    .gh-why-sticky {
      position: static !important;
    }
    .gh-why-card {
      transform: none !important;
      height: auto !important;
    }
  }
</style>

<script is:inline>
  (() => {
    function initWhyGenericSection() {
      let genericCard0Complete = false;
      initCard0Flow();
      initClearTaxCard0Flow();

      const stack = document.getElementById("gh-why-stack");
      if (!stack) return;

    const textEl = document.getElementById("gh-why-header");
    // Outers are never transformed, so their rects are always safe to measure.
    const outers = Array.from(stack.querySelectorAll(".gh-why-sticky"));
    const inners = Array.from(stack.querySelectorAll(".gh-why-card"));
    if (!outers.length || outers.length !== inners.length) return;

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) return;

    const STACK_OFFSET = 16; // visible sliver of each card behind the next
    const REVEAL_DISTANCE = 260; // scroll px the shrink takes once the next card closes in

    // Navbar clearance, from the shared token rather than a number of its own —
    // every pinned section on the site reads the same one. The fallback matches
    // the token so a missing shared.css degrades to the same offset.
    const NAV_CLEAR =
      parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue(
          "--nav-clear",
        ),
      ) || 112;

    // Card 0 shrinks most, each subsequent one less; the last never shrinks.
    const targetScaleFor = (i) => 0.88 + i * 0.03;

    // TWO UNITS, and they are not the same one under `zoom`.
    // getBoundingClientRect() and window.innerHeight/innerWidth are RENDERED
    // pixels — what is on the glass. getComputedStyle().top, NAV_CLEAR,
    // STACK_OFFSET and anything written to `style.top` are CSS pixels.
    // shared.css puts `zoom` on the `body` element between tablet and 1440px, so the two
    // differ by that factor and this file mixes them in both directions: it
    // compares a rect against a computed top, and it derives a style.top from
    // rect measurements. Unconverted, the stack pinned at the wrong offsets and
    // the shrink triggered at the wrong scroll position.
    //
    // Walked rather than read off the `body` element, because zoom multiplies down the tree.
    const zoomFactor = () => {
      let z = 1;
      for (let n = stack; n && n.nodeType === 1; n = n.parentElement) {
        const v = parseFloat(getComputedStyle(n).zoom);
        // Unsupported -> NaN, unset -> 1. Both mean "no scaling here".
        if (v && v !== 1) z *= v;
      }
      return z;
    };

    // Recomputed by handleLayoutShift, which covers crossing the 1440px bound
    // where the zoom switches off.
    let zoom = zoomFactor();

    const setTops = () => {
      zoom = zoomFactor();

      // Clear the transform first, or the measured offset includes the scale.
      const originalTransform = inners[0].style.transform;
      inners[0].style.transform = "none";

      // Measure how far the card actually sits inside its wrapper, rather than
      // assuming — this absorbs a wrapped heading, late fonts, anything.
      // Converted to CSS px at the point of measurement, so everything below
      // this line is CSS px and matches what style.top expects.
      const outerTop = outers[0].getBoundingClientRect().top;
      const innerTop = inners[0].getBoundingClientRect().top;
      const cardOffset = (innerTop - outerTop) / zoom;

      inners[0].style.transform = originalTransform;

      let firstTop = NAV_CLEAR;

      // Centre the whole stack vertically once there is room for it. The
      // breakpoint test stays in RENDERED px — it is asking about the window,
      // not the layout, the same question a media query asks.
      if (window.innerWidth >= 1280) {
        const cardHeight = inners[0].getBoundingClientRect().height / zoom;
        const totalStackHeight =
          cardOffset + cardHeight + (outers.length - 1) * STACK_OFFSET;
        const viewportCss = window.innerHeight / zoom;
        firstTop = Math.max(NAV_CLEAR, (viewportCss - totalStackHeight) / 2);
      }

      outers[0].style.top = firstTop + "px";

      // Wrapper 0 sticks at firstTop, so card 0's true visual top is firstTop
      // plus whatever sits above it inside the wrapper.
      const baseTop = firstTop + cardOffset;
      for (let i = 1; i < outers.length; i++) {
        outers[i].style.top = baseTop + i * STACK_OFFSET + "px";
      }
    };

    let ticking = false;

    const update = () => {
      // Read every wrapper position BEFORE writing any transform, so a write
      // can't invalidate a later read in the same frame.
      const tops = outers.map((el) => el.getBoundingClientRect().top);

      inners.forEach((inner, i) => {
        if (i === inners.length - 1) {
          inner.style.transform = "scale(1)";
          return;
        }

        // sticky clamps rect.top at the element's own `top` once stuck and keeps
        // decreasing before that, so this distance falls to 0 and stays there
        // the moment card i+1 is fully stuck. No extra bookkeeping needed.
        // Scaled into RENDERED px to match `tops`, which came from rects.
        const nextStickyTopPx =
          (parseFloat(getComputedStyle(outers[i + 1]).top) || 0) * zoom;
        const distanceToStick = tops[i + 1] - nextStickyTopPx;

        // REVEAL_DISTANCE is a scroll distance, and scrolling is in rendered px,
        // so both sides of this ratio are already in the same unit.
        const progress = Math.min(
          1,
          Math.max(0, 1 - distanceToStick / REVEAL_DISTANCE),
        );
        const scale = 1 - progress * (1 - targetScaleFor(i));
        inner.style.transform = `scale(${scale.toFixed(4)})`;
      });

      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const handleLayoutShift = () => {
      setTops();
      update();
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", handleLayoutShift);
    window.addEventListener("load", handleLayoutShift, { once: true });

    if (textEl && typeof ResizeObserver !== "undefined") {
      new ResizeObserver(handleLayoutShift).observe(textEl);
    }

    setTops();
    update();

    // --- CARD 0 GSAP ANIMATION SEQUENCE ---
    function initCard0Flow() {
      const card = document.querySelector(".gh-why-generic-card-0");
      if (!card) return;

      const glow = card.querySelector(".gh-card0-glow");
      const glowBottom = card.querySelector(".gh-card0-glow-bottom");
      const centerTitle = card.querySelector(".gh-card0-center-title");
      const bubble = card.querySelector(".gh-card0-bubble");
      const chartHeader = card.querySelector(".gh-card0-chart-header");
      const skeleton = card.querySelector(".gh-card0-skeleton");
      const checklist = card.querySelector(".gh-card0-checklist");
      const checkItems = card.querySelectorAll(".gh-card0-check-item");
      const chart = card.querySelector(".gh-card0-chart");
      const inputPill = card.querySelector(".gh-card0-input-pill");
      const pillPlaceholder = card.querySelector(".gh-card0-pill-placeholder");
      const pillTyped = card.querySelector(".gh-card0-pill-typed");
      const pillThinking = card.querySelector(".gh-card0-pill-thinking");
      const submitBtn = card.querySelector(".gh-card0-submit-btn");
      const cursor = card.querySelector(".gh-card0-cursor");
      const borderPath = card.querySelector(".gh-card0-pill-border-path");

      if (!inputPill || !cursor || !chart) return;

      const reduceMotion =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Accessible static fallback for users preferring reduced motion
      if (reduceMotion) {
        if (chartHeader) {
          chartHeader.classList.remove("hidden");
          chartHeader.style.display = "flex";
          chartHeader.style.opacity = "1";
        }
        if (chart) {
          chart.classList.remove("hidden");
          chart.style.display = "flex";
          chart.style.opacity = "1";
        }
        if (centerTitle) centerTitle.style.opacity = "0";
        if (glow) glow.style.opacity = "0";
        if (glowBottom) glowBottom.style.opacity = "1";
        return;
      }

      // Calculate vertical offset to center the pill in Frame 1
      const calcCenterOffset = () => {
        const cardH = card.offsetHeight || 380;
        const pillH = inputPill.offsetHeight || 48;
        const pillTop = inputPill.offsetTop || (cardH - pillH - 24);
        const targetCenter = cardH * 0.53 - pillH / 2;
        return targetCenter - pillTop;
      };

      let centerOffset = calcCenterOffset();
      // Apply immediate center transform to prevent layout pop
      inputPill.style.transform = `translateY(${centerOffset}px)`;

      // Dynamically compute exact SVG path for rounded pill border
      const updatePillPath = () => {
        if (!borderPath || !inputPill) return 0;
        const w = inputPill.offsetWidth - 2;
        const h = inputPill.offsetHeight - 2;
        const r = h / 2;
        const x0 = 1;
        const y0 = 1;
        // Start at left-center (9 o'clock) and proceed clockwise up and around (matches Figma Vector 1)
        const d = `M ${x0} ${y0 + r} A ${r} ${r} 0 0 1 ${x0 + r} ${y0} H ${x0 + w - r} A ${r} ${r} 0 0 1 ${x0 + w} ${y0 + r} A ${r} ${r} 0 0 1 ${x0 + w - r} ${y0 + h} H ${x0 + r} A ${r} ${r} 0 0 1 ${x0} ${y0 + r} Z`;
        borderPath.setAttribute("d", d);
        let len = 0;
        try {
          len = borderPath.getTotalLength();
        } catch (e) {}
        if (!len || len <= 0) {
          len = 2 * (w - h) + Math.PI * h;
        }
        return len;
      };

      let borderLen = updatePillPath();

      window.addEventListener("resize", () => {
        centerOffset = calcCenterOffset();
        borderLen = updatePillPath();
      });

      const getPillPos = () => {
        const cRect = card.getBoundingClientRect();
        const pRect = inputPill.getBoundingClientRect();
        return {
          x: pRect.left - cRect.left + pRect.width * 0.38,
          y: pRect.top - cRect.top + pRect.height * 0.5,
        };
      };

      const getSubmitBtnPos = () => {
        const cRect = card.getBoundingClientRect();
        const bRect = submitBtn.getBoundingClientRect();
        return {
          x: bRect.left - cRect.left + bRect.width * 0.5,
          y: bRect.top - cRect.top + bRect.height * 0.5,
        };
      };

      const startGsap = () => {
        const gsap = window.gsap;
        if (!gsap) {
          setTimeout(startGsap, 60);
          return;
        }

        const tl = gsap.timeline({
          paused: true,
          defaults: { ease: "power2.inOut" },
        });

        // Frame 1: Initial state
        tl.set([chartHeader, chart, bubble, skeleton, checklist], { display: "none" });
        tl.set(chartHeader, { opacity: 0, y: 8, pointerEvents: "none" });
        tl.set(chart, { opacity: 0, y: 10, pointerEvents: "none" });
        tl.set(bubble, { opacity: 0, scale: 0.9, y: 8, pointerEvents: "none" });
        tl.set(skeleton, { opacity: 0, pointerEvents: "none" });
        tl.set(checklist, { opacity: 0, pointerEvents: "none" });
        tl.set(checkItems, { opacity: 0, x: -10 });
        if (borderPath) {
          tl.set(borderPath, { opacity: 0 });
        }

        tl.set(glow, { opacity: 1 });
        if (glowBottom) {
          tl.set(glowBottom, { opacity: 0 });
        }
        tl.set(centerTitle, { opacity: 1, y: 0 });
        tl.set(inputPill, { y: () => centerOffset });
        tl.set(pillPlaceholder, { opacity: 1 });
        tl.set(pillTyped, { opacity: 0, clipPath: "inset(0 100% 0 0)" });
        tl.set(pillThinking, { opacity: 0 });
        tl.set(cursor, {
          opacity: 0,
          x: () => card.offsetWidth * 0.65,
          y: () => card.offsetHeight * 0.65,
          scale: 1,
        });

        // Frame 1: Cursor appears & moves to pill
        tl.to(cursor, { opacity: 1, duration: 0.35 }, "+=0.3");
        tl.to(
          cursor,
          {
            x: () => getPillPos().x,
            y: () => getPillPos().y,
            duration: 0.75,
            ease: "power2.out",
          },
          "-=0.1"
        );

        // Frame 2: Cursor clicks pill, prompt types out
        tl.to(cursor, { scale: 0.85, duration: 0.12, yoyo: true, repeat: 1 });
        tl.to(pillPlaceholder, { opacity: 0, duration: 0.15 }, "<+=0.05");
        tl.to(pillTyped, { opacity: 1, duration: 0.15 }, "<");
        tl.to(
          pillTyped,
          {
            clipPath: "inset(0 0% 0 0)",
            duration: 0.95,
            ease: "steps(36)",
          },
          "<+=0.1"
        );

        // Cursor moves to submit arrow button (relaxed human-like glide)
        tl.to(
          cursor,
          {
            x: () => getSubmitBtnPos().x,
            y: () => getSubmitBtnPos().y,
            duration: 1.35,
            ease: "power2.inOut",
          },
          "+=0.35"
        );
        // Click submit button (brief pause on hover before clicking)
        tl.to(cursor, { scale: 0.85, duration: 0.12, yoyo: true, repeat: 1 }, "+=0.2");
        tl.to(submitBtn, { scale: 0.88, duration: 0.12, yoyo: true, repeat: 1 }, "<");
        tl.to(cursor, { opacity: 0, duration: 0.25 }, "+=0.2");

        // Pill drops down: center title and center glow fade out, bottom ambient glow fades in behind pill (softer glow)
        tl.to(centerTitle, { opacity: 0, y: -10, duration: 0.45, ease: "power2.in" }, "-=0.1");
        tl.to(glow, { opacity: 0, duration: 0.45 }, "<");
        if (glowBottom) {
          tl.to(glowBottom, { opacity: 1, duration: 0.65, ease: "power2.out" }, "<");
        }
        tl.to(inputPill, { y: 0, duration: 0.65, ease: "power3.inOut" }, "<");

        // --- BORDER LOADER: Draws 1 full round ---
        tl.add(() => {
          borderLen = updatePillPath();
          gsap.set(borderPath, {
            strokeDasharray: borderLen,
            strokeDashoffset: borderLen,
            opacity: 1,
          });
        });
        tl.addLabel("borderStart");
        tl.to(borderPath, {
          strokeDashoffset: 0,
          duration: 1.4,
          ease: "power1.inOut",
        }, "borderStart");
        tl.to(borderPath, { opacity: 0, duration: 0.2 }, "borderStart+=1.4");

        // Immediately reveal message bubble, skeleton, and switch pill to Thinking
        tl.set(bubble, { display: "block" }, "borderStart+=0.1");
        tl.set(skeleton, { display: "flex" }, "borderStart+=0.1");
        tl.to(pillTyped, { opacity: 0, duration: 0.12 }, "borderStart+=0.1");
        tl.to(pillThinking, { opacity: 1, duration: 0.12 }, "<");
        tl.to(
          bubble,
          { opacity: 1, y: 0, scale: 1, duration: 0.28, ease: "back.out(1.5)" },
          "<"
        );
        tl.to(
          skeleton,
          { opacity: 1, y: 0, duration: 0.18, ease: "power2.out" },
          "<"
        );

        // Frame 4: Skeleton fades out quickly (after ~0.8s) and checklist appears in seconds
        tl.to(skeleton, { opacity: 0, duration: 0.18 }, "borderStart+=0.9");
        tl.set(skeleton, { display: "none" });
        tl.set(checklist, { display: "flex", opacity: 1 });
        tl.to(
          checkItems,
          {
            opacity: 1,
            x: 0,
            duration: 0.22,
            stagger: 0.15,
            ease: "power2.out",
          },
          "-=0.05"
        );

        // Hold on checklist (1.3s)
        tl.to({}, { duration: 1.3 });

        // Frame 5: Bubble & checklist exit, Chart header & chart image fade/slide in
        tl.to([bubble, checklist], { opacity: 0, y: -10, duration: 0.35, ease: "power2.in" });
        tl.set([bubble, checklist], { display: "none" });
        tl.set(chartHeader, { display: "flex" });
        tl.set(chart, { display: "flex" });
        tl.to(pillThinking, { opacity: 0, duration: 0.2 }, "<");
        tl.to(pillPlaceholder, { opacity: 1, duration: 0.25 }, "<+=0.1");

        tl.to(
          chartHeader,
          { opacity: 1, y: 0, duration: 0.5, ease: "power2.out", pointerEvents: "auto" },
          "-=0.05"
        );
        tl.to(
          chart,
          {
            opacity: 1,
            y: 0,
            duration: 0.55,
            ease: "power2.out",
            pointerEvents: "auto",
            onComplete: () => {
              genericCard0Complete = true;
              window.dispatchEvent(new CustomEvent("gh-card0-generic-complete"));
            },
          },
          "<+=0.1"
        );

        // Animation completes and stays on final result (Frame 5)

        // Viewport IntersectionObserver: Trigger once when entering viewport
        const triggerEl = card.closest(".grid") || card;
        if (typeof IntersectionObserver !== "undefined") {
          let hasPlayed = false;
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting && !hasPlayed) {
                  hasPlayed = true;
                  tl.play();
                  observer.disconnect();
                }
              });
            },
            { threshold: 0.25 }
          );
          observer.observe(triggerEl);
        } else {
          tl.play();
        }
      };

      if (typeof window.gsap === "undefined") {
        const s = document.createElement("script");
        s.src = "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js";
        s.onload = startGsap;
        document.head.appendChild(s);
      } else {
        startGsap();
      }
    }

    // --- CARD 0 GSAP ANIMATION SEQUENCE ---
    function initClearTaxCard0Flow() {
      const card = document.querySelector(".gh-why-animation-card-0");
      if (!card) return;

      const resultGroup = card.querySelector(".gh-ct-card0-result-group");
      const resultHeader = card.querySelector(".gh-ct-card0-result-header");
      const resultParagraphs = card.querySelectorAll(".gh-ct-card0-result-p");
      const sentGroup = card.querySelector(".gh-ct-card0-sent-group");
      const spinner = card.querySelector(".gh-ct-card0-spinner");
      const inputBox = card.querySelector(".gh-ct-card0-input-box");
      const chipWrapper = card.querySelector(".gh-ct-card0-chip-wrapper");
      const inputChip = card.querySelector(".gh-ct-card0-input-chip");
      const inputTyped = card.querySelector(".gh-ct-card0-input-typed");
      const typedText = card.querySelector(".gh-ct-card0-typed-text");
      const pillPlaceholder = card.querySelector(".gh-ct-card0-pill-placeholder");
      const pillThinking = card.querySelector(".gh-ct-card0-pill-thinking");
      const submitBtn = card.querySelector(".gh-ct-card0-submit-btn");
      const cursor = card.querySelector(".gh-ct-card0-cursor");

      if (!submitBtn || !cursor || !sentGroup) return;

      const queryText = typedText
        ? typedText.textContent.trim().replace(/\s+/g, " ")
        : "Using the attached invoice aging report, which invoices cross 180 days this month?";

      const reduceMotion =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Accessible static fallback for users preferring reduced motion
      if (reduceMotion) {
        if (resultGroup) {
          resultGroup.style.display = "flex";
          resultGroup.style.opacity = "1";
          resultGroup.style.pointerEvents = "auto";
        }
        if (resultHeader) resultHeader.style.opacity = "1";
        resultParagraphs.forEach((p) => {
          p.style.opacity = "1";
          p.style.transform = "none";
        });
        if (typedText) typedText.textContent = queryText;
        if (inputBox) {
          inputBox.classList.remove("rounded-2xl");
          inputBox.classList.add("rounded-full");
        }
        if (chipWrapper) chipWrapper.style.display = "none";
        if (inputChip) inputChip.style.display = "none";
        return;
      }

      const getSubmitBtnPos = () => {
        const cRect = card.getBoundingClientRect();
        const bRect = submitBtn.getBoundingClientRect();
        return {
          x: bRect.left - cRect.left + bRect.width * 0.45,
          y: bRect.top - cRect.top + bRect.height * 0.45,
        };
      };

      const getInputAreaPos = () => {
        const cRect = card.getBoundingClientRect();
        const bRect = submitBtn.getBoundingClientRect();
        return {
          x: cRect.width * 0.35,
          y: bRect.top - cRect.top + bRect.height * 0.5,
        };
      };

      const startGsap = () => {
        const gsap = window.gsap;
        if (!gsap) {
          setTimeout(startGsap, 60);
          return;
        }

        const tl = gsap.timeline({
          paused: true,
          defaults: { ease: "power2.inOut" },
        });

        // Frame 1: Initial state
        tl.set([resultGroup, sentGroup, spinner], { display: "none" });
        tl.set(resultGroup, { opacity: 0, pointerEvents: "none" });
        tl.set(resultHeader, { opacity: 0, y: 6 });
        tl.set(resultParagraphs, { opacity: 0, y: 8 });
        tl.set(sentGroup, { opacity: 0, y: 15, scale: 0.95, pointerEvents: "none" });
        tl.set(spinner, { opacity: 0, y: 8, pointerEvents: "none" });
        if (inputBox) {
          inputBox.classList.remove("rounded-full");
          inputBox.classList.add("rounded-2xl");
          inputBox.style.borderRadius = "";
        }
        tl.add(() => {
          if (inputBox) {
            inputBox.classList.remove("rounded-full");
            inputBox.classList.add("rounded-2xl");
            inputBox.style.borderRadius = "";
          }
        }, 0);
        tl.set(chipWrapper, { display: "none", height: 0, marginBottom: 0 });
        tl.set(inputChip, {
          opacity: 0,
          scale: 0.85,
          y: -6,
          transformOrigin: "left center",
          height: "auto",
          minHeight: "auto",
          paddingTop: "",
          paddingBottom: "",
          marginTop: "",
          marginBottom: "",
          display: "inline-flex",
        });
        tl.set(inputTyped, { opacity: 0, height: 0, display: "none" });
        if (typedText) {
          typedText.textContent = "";
        }
        tl.set(pillPlaceholder, { opacity: 1 });
        tl.set(pillThinking, { opacity: 0 });
        tl.set(cursor, {
          opacity: 0,
          x: () => card.offsetWidth * 0.65,
          y: () => card.offsetHeight * 0.65,
          scale: 1,
        });

        // Frame 1: Input gets bigger (box smoothly expands to accommodate incoming attachment)
        tl.set(chipWrapper, { display: "block", height: 0, marginBottom: -8 });
        tl.to(
          chipWrapper,
          {
            height: 42,
            marginBottom: 0,
            duration: 0.35,
            ease: "power2.out",
          },
          "+=0.2"
        );
        if (inputBox) {
          tl.add(() => {
            inputBox.classList.remove("rounded-full");
            inputBox.classList.add("rounded-2xl");
          }, "<");
        }
        tl.set(chipWrapper, { height: "auto" });

        // Frame 1: Then PDF / spreadsheet chip comes in
        tl.to(
          inputChip,
          {
            opacity: 1,
            scale: 1,
            y: 0,
            duration: 0.35,
            ease: "back.out(1.5)",
          },
          "+=0.04"
        );

        // Frame 1 -> Frame 2: Marker cursor appears & glides to input box
        tl.to(cursor, { opacity: 1, duration: 0.35 }, "+=0.25");
        tl.to(
          cursor,
          {
            x: () => getInputAreaPos().x,
            y: () => getInputAreaPos().y,
            duration: 0.75,
            ease: "power2.out",
          },
          "-=0.1"
        );

        // Frame 2: Cursor clicks input box, placeholder fades, prompt types out character by character ("one by one")
        const typingObj = { charIndex: 0 };
        tl.to(cursor, { scale: 0.85, duration: 0.12, yoyo: true, repeat: 1 });
        tl.to(pillPlaceholder, { opacity: 0, duration: 0.15 }, "<+=0.05");
        tl.set(inputTyped, { display: "block", height: "auto", minHeight: "40px", opacity: 1 }, "<");
        tl.to(
          typingObj,
          {
            charIndex: queryText.length,
            duration: 0.95,
            ease: "none",
            onUpdate: () => {
              if (typedText) {
                typedText.textContent = queryText.slice(0, Math.round(typingObj.charIndex));
              }
            },
          },
          "<+=0.1"
        );

        // Cursor glides to submit button (MATCHES CARD 1 EXACTLY: +=0.35, duration: 1.35)
        tl.to(
          cursor,
          {
            x: () => getSubmitBtnPos().x,
            y: () => getSubmitBtnPos().y,
            duration: 1.35,
            ease: "power2.inOut",
          },
          "+=0.35"
        );

        // Click submit button (MATCHES CARD 1 EXACTLY: +=0.2, scale 0.85 & 0.88, fade cursor +=0.2, duration: 0.25)
        tl.to(cursor, { scale: 0.85, duration: 0.12, yoyo: true, repeat: 1 }, "+=0.2");
        tl.to(submitBtn, { scale: 0.88, duration: 0.12, yoyo: true, repeat: 1 }, "<");
        tl.to(cursor, { opacity: 0, duration: 0.25 }, "+=0.2");

        // Frame 2 -> Frame 3: Input box collapses chip & typed text, switches to "Thinking..."
        // Step 1: Promptly fade out chip and typed text so neither end looks cluttered during rounding
        tl.to(
          [inputChip, inputTyped],
          {
            opacity: 0,
            duration: 0.18,
            ease: "power2.out",
          },
          "-=0.1"
        );

        // Step 2: Smoothly collapse the wrappers down to compact pill height
        tl.to(
          [chipWrapper, inputTyped],
          {
            height: 0,
            minHeight: 0,
            paddingTop: 0,
            paddingBottom: 0,
            marginTop: 0,
            marginBottom: 0,
            duration: 0.35,
            ease: "power2.inOut",
          },
          "<+=0.04"
        );

        // Step 3: As the box settles into compact pill height, both ends morph to rounded-full together at the same pace
        if (inputBox) {
          tl.add(() => {
            inputBox.classList.remove("rounded-2xl");
            inputBox.classList.add("rounded-full");
          }, "-=0.15");
        }

        tl.set([chipWrapper, inputChip, inputTyped], { display: "none" });
        tl.to(pillThinking, { opacity: 1, duration: 0.25, ease: "power2.out" }, "<");

        // Top-right sent group (chip + dashed bubble) springs into view
        tl.set(sentGroup, { display: "flex" });
        tl.to(
          sentGroup,
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.45,
            ease: "back.out(1.4)",
            pointerEvents: "auto",
          },
          "<+=0.05"
        );

        // Spinner ("Analyzing uploaded file…") fades in
        tl.set(spinner, { display: "flex" });
        tl.to(
          spinner,
          {
            opacity: 1,
            y: 0,
            duration: 0.35,
            ease: "power2.out",
            pointerEvents: "auto",
          },
          "<+=0.1"
        );

        // Hold on Frame 3 (Analyzing uploaded file) and wait until 1st animation overall displayed!
        tl.add(() => {
          if (!genericCard0Complete) {
            tl.pause();
            let safetyTimeout;
            const onGenericComplete = () => {
              window.removeEventListener("gh-card0-generic-complete", onGenericComplete);
              clearTimeout(safetyTimeout);
              tl.play();
            };
            window.addEventListener("gh-card0-generic-complete", onGenericComplete);
            safetyTimeout = setTimeout(() => {
              window.removeEventListener("gh-card0-generic-complete", onGenericComplete);
              tl.play();
            }, 12000);
          }
        });

        // Breathing room (0.2s) once 1st animation overall displayed
        tl.to({}, { duration: 0.2 });

        // Frame 3 -> Frame 4: Sent group and spinner exit
        tl.to(
          [sentGroup, spinner],
          { opacity: 0, y: -10, duration: 0.35, ease: "power2.in" }
        );
        tl.set([sentGroup, spinner], { display: "none" });

        // Frame 4: Result group ("Analysis completed" + 3 insight paragraphs) animates in
        tl.set(resultGroup, { display: "flex", opacity: 1, pointerEvents: "auto" });
        tl.to(
          resultHeader,
          { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" },
          "-=0.05"
        );
        // Stagger paragraphs one by one like transcript on 1st card
        tl.to(
          resultParagraphs,
          {
            opacity: 1,
            y: 0,
            duration: 0.35,
            stagger: 0.28,
            ease: "power2.out",
          },
          "+=0.1"
        );

        // In input box: "Thinking..." fades out, "Ask anything..." returns
        tl.to(pillThinking, { opacity: 0, duration: 0.2 }, "<");
        tl.to(pillPlaceholder, { opacity: 1, duration: 0.25 }, "<+=0.1");

        // Viewport IntersectionObserver: Trigger once when entering viewport
        const triggerEl = card.closest(".grid") || card;
        if (typeof IntersectionObserver !== "undefined") {
          let hasPlayed = false;
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting && !hasPlayed) {
                  hasPlayed = true;
                  tl.play();
                  observer.disconnect();
                }
              });
            },
            { threshold: 0.25 }
          );
          observer.observe(triggerEl);
        } else {
          tl.play();
        }
      };

      if (typeof window.gsap === "undefined") {
        const s = document.createElement("script");
        s.src = "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js";
        s.onload = startGsap;
        document.head.appendChild(s);
      } else {
        startGsap();
      }
    }
  }

  initWhyGenericSection();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      window.dispatchEvent(new Event("resize"));
    }, { once: true });
  }
})();
</script>
