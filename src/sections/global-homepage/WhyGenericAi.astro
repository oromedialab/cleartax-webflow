---
/**
 * "Why Generic AI Fails for Finance" — Figma node 13049:22785.
 *
 * Card stack, built on the same implementation as
 * `sections/delivery-page/Invoice.astro`:
 *
 *   - Two layers per card. The OUTER wrapper (`.gh-why-sticky`) is what
 *     `position: sticky` acts on and is NEVER transformed, so measuring it with
 *     getBoundingClientRect is always accurate. The INNER card (`.gh-why-card`)
 *     is the only thing JS scales — measuring a transformed element would feed
 *     its own transform back into the next frame.
 *   - Each wrapper sticks 16px below the previous one, with a rising z-index, so
 *     the stack leaves a visible sliver of every card behind it.
 *   - A card shrinks as the next one closes in, most for the earliest card, and
 *     the last one never shrinks.
 *   - `setTops()` measures the real offset of the card inside its wrapper rather
 *     than assuming one, so wrapped headings or late-loading fonts can't push
 *     the stack out of alignment.
 *
 * IMPORTANT: no ancestor of a `.gh-why-sticky` may set `overflow` to anything
 * but `visible` — that silently kills `position: sticky`.
 *
 * The header is duplicated (mobile copy scrolls away, desktop copy rides inside
 * the first sticky wrapper), matching Invoice.astro. That does put two <h2>s in
 * the DOM; it is how the existing stack does it, so the two stay consistent.
 *
 * Card copy is per-card, taken from Figma node 13091:15387. The image holders
 * are still the Figma placeholders — no artwork exists for them yet.
 */
interface Card {
  title: string;
  genericCaption: string;
  cleartaxCaption: string;
}

const cards: Card[] = [
  {
    title: "Financial Planning & Analysis",
    genericCaption: "It can extract trends from your spreadsheet.",
    cleartaxCaption:
      "Builds the forecast from live actuals, with embedded context such as your entity structure and cost drivers.",
  },
  {
    title: "Fraud Prevention",
    genericCaption:
      "Flags duplicates across whatever files you upload. Can only analyse a sample of your transactions, not all.",
    cleartaxCaption:
      "Flags unusual things that you are likely to miss, because it looks at every transaction and compares it to the specific contract, invoice, and shipping details.",
  },
  {
    title: "CFO Insights",
    genericCaption:
      "Summarises the file you paste in or translates data inside your ERP into a visual graph or trend line.",
    cleartaxCaption:
      "Meaningfully answers why and how metrics changed, because it's connected to live systems with your business context.",
  },
  {
    title: "Tax Automation",
    genericCaption: "Matches invoice number, date, amount, and formats a return.",
    cleartaxCaption:
      "Computes return at line item level, reconciled against all your systems, based on statutory rules for each country",
  },
  {
    title: "Accounts Payable",
    genericCaption:
      "Reads each invoice PDF, extracts fields, and uploads to your ERP/AP/AR systems",
    cleartaxCaption:
      "Receives from Peppol, email and vendor portals. De-duplicates, links documents, checks for fraud, and keeps the full trail.",
  },
];

const HEADING = "General Purpose AI was not built to solve Finance Use-Cases";
const LEDE =
  "ClearTax gives you clean finance data and the business context AI needs, so your finance team can build and use AI with confidence.";
---

<section class="bg-generic-00 py-16 md:py-20">
  <div class="container mx-auto">
    <!-- Scroll-away header — gives the stack the full viewport. Used on mobile
         AND on any short window; see .gh-why-header-* in the style block. -->
    <div class="gh-why-header-flow text-center w-full mx-auto mb-8 bg-generic-00">
      <h2
        class="m-0 mb-3 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] tracking-[-0.5px]"
      >
        {HEADING}
      </h2>
      <p
        class="m-0 mx-auto max-w-[628px] font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
      >
        {LEDE}
      </p>
    </div>

    <div
      id="gh-why-stack"
      class="gh-why-stack mx-auto flex w-full flex-col gap-[30vh] md:gap-[50vh]"
    >
      {
        cards.map((card, i) => (
          <div class="gh-why-sticky sticky" style={`top:${100 + i * 16}px;z-index:${i};`}>
            {i === 0 && (
              <div
                id="gh-why-header"
                class="gh-why-header-stuck text-center w-full mx-auto mb-8 lg:mb-12 bg-generic-00"
              >
                <h2 class="m-0 mb-3 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]">
                  {HEADING}
                </h2>
                <p class="m-0 mx-auto max-w-[628px] font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                  {LEDE}
                </p>
              </div>
            )}

            <article
              class="gh-why-card flex w-full flex-col gap-6 rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6 will-change-transform md:h-(--gh-why-card-h)"
              style="transform-origin: top center;"
            >
              <h3 class="m-0 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                {card.title}
              </h3>

              {/* One grid, not two flex columns. The two image holders share a
                  grid row, so they are always exactly the same height — as flex
                  columns a caption that wrapped to three lines stole the height
                  from its own image, which only showed up once the two sides
                  stopped carrying identical copy. Row 2 is auto, sized by the
                  taller caption, so the captions share a baseline too.
                  minmax(0,1fr) + min-h-0 is what lets the image row absorb the
                  card's height clamp instead of overflowing it. */}
              <div class="grid w-full flex-1 grid-cols-1 gap-y-6 md:min-h-0 md:grid-cols-2 md:grid-rows-[minmax(0,1fr)_auto] md:gap-x-8">
                <div class="relative w-full overflow-hidden rounded-lg bg-visual-placeholder max-md:aspect-[600/400] md:col-start-1 md:row-start-1 md:min-h-0">
                  <span class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-lg border border-neutral-200 bg-generic-00 px-3 py-1.5 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-neutral-700 font-body">
                    <span class="block h-4 w-4 shrink-0 rounded-[3px] bg-neutral-900 opacity-20" />
                    GENERIC AI
                  </span>
                </div>
                <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] md:col-start-1 md:row-start-2">
                  {card.genericCaption}
                </p>

                <div class="relative w-full overflow-hidden rounded-lg bg-visual-placeholder max-md:aspect-[600/400] md:col-start-2 md:row-start-1 md:min-h-0">
                  <span class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-lg bg-nova-blue px-3 py-1.5 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-generic-00 font-body">
                    <span class="block h-4 w-4 shrink-0 rounded-[3px] bg-generic-00 opacity-20" />
                    CLEARTAX AI
                  </span>
                </div>
                <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] md:col-start-2 md:row-start-2">
                  {card.cleartaxCaption}
                </p>
              </div>
            </article>
          </div>
        ))
      }

      <!-- Tail room so the last card can finish sticking before the next section -->
      <div style="height: 80px;"></div>
    </div>
  </div>
</section>

<style is:global>
  /* Which header shows is a question of available HEIGHT, not just width, so it
     cannot be a plain Tailwind breakpoint. Driving both copies from one rule
     here also means there is no specificity race between a `hidden` utility in
     the head bundle and an override in this block, which is pasted later.

     Above 860px tall the header rides inside the first sticky wrapper (the
     Figma layout). Below that, its ~200px would push the card's captions under
     the fold, so it reverts to scrolling away like the mobile copy does. */
  .gh-why-header-stuck {
    display: none;
  }

  @media (min-width: 768px) and (min-height: 860px) {
    .gh-why-header-flow {
      display: none;
    }
    .gh-why-header-stuck {
      display: block;
    }
  }

  /* Card height budget. The whole stack has to fit in the viewport or the
     captions at the bottom of the front card are unreachable — it is sticky, so
     you cannot scroll to them.

       top offset (100px, clears the fixed navbar) + header + card
         + 16px sliver x 4 cards behind  <=  100vh

     The stuck-header regime therefore subtracts 380px, not 300px: 100 top + ~212
     header + 64 slivers. The old 300px under-counted by ~76px, which is why the
     card overflowed the window at every height below ~940px. With the header
     scrolled away there is no header to pay for, so 190px is enough. */
  .gh-why-card {
    --gh-why-card-h: clamp(300px, calc(100vh - 190px), 560px);
  }

  @media (min-height: 860px) {
    .gh-why-card {
      --gh-why-card-h: clamp(380px, calc(100vh - 380px), 560px);
    }
  }

  /* Sticky and the scroll-driven shrink are both enhancements. Switched off, the
     cards read as a plain stack — so the huge scroll gaps that exist only to give
     the stack travel have to go with them. */
  @media (prefers-reduced-motion: reduce) {
    .gh-why-stack {
      gap: 2rem !important;
    }
    .gh-why-sticky {
      position: static !important;
    }
    .gh-why-card {
      transform: none !important;
      height: auto !important;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const stack = document.getElementById("gh-why-stack");
    if (!stack) return;

    const textEl = document.getElementById("gh-why-header");
    // Outers are never transformed, so their rects are always safe to measure.
    const outers = Array.from(stack.querySelectorAll(".gh-why-sticky"));
    const inners = Array.from(stack.querySelectorAll(".gh-why-card"));
    if (!outers.length || outers.length !== inners.length) return;

    const reduceMotion =
      window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) return;

    const STACK_OFFSET = 16; // visible sliver of each card behind the next
    const REVEAL_DISTANCE = 260; // scroll px the shrink takes once the next card closes in

    // Card 0 shrinks most, each subsequent one less; the last never shrinks.
    const targetScaleFor = (i) => 0.88 + i * 0.03;

    const setTops = () => {
      // Clear the transform first, or the measured offset includes the scale.
      const originalTransform = inners[0].style.transform;
      inners[0].style.transform = "none";

      // Measure how far the card actually sits inside its wrapper, rather than
      // assuming — this absorbs a wrapped heading, late fonts, anything.
      const outerTop = outers[0].getBoundingClientRect().top;
      const innerTop = inners[0].getBoundingClientRect().top;
      const cardOffset = innerTop - outerTop;

      inners[0].style.transform = originalTransform;

      let firstTop = 100;

      // Centre the whole stack vertically once there is room for it.
      if (window.innerWidth >= 1280) {
        const cardHeight = inners[0].getBoundingClientRect().height;
        const totalStackHeight =
          cardOffset + cardHeight + (outers.length - 1) * STACK_OFFSET;
        firstTop = Math.max(100, (window.innerHeight - totalStackHeight) / 2);
      }

      outers[0].style.top = firstTop + "px";

      // Wrapper 0 sticks at firstTop, so card 0's true visual top is firstTop
      // plus whatever sits above it inside the wrapper.
      const baseTop = firstTop + cardOffset;
      for (let i = 1; i < outers.length; i++) {
        outers[i].style.top = baseTop + i * STACK_OFFSET + "px";
      }
    };

    let ticking = false;

    const update = () => {
      // Read every wrapper position BEFORE writing any transform, so a write
      // can't invalidate a later read in the same frame.
      const tops = outers.map((el) => el.getBoundingClientRect().top);

      inners.forEach((inner, i) => {
        if (i === inners.length - 1) {
          inner.style.transform = "scale(1)";
          return;
        }

        // sticky clamps rect.top at the element's own `top` once stuck and keeps
        // decreasing before that, so this distance falls to 0 and stays there
        // the moment card i+1 is fully stuck. No extra bookkeeping needed.
        const nextStickyTopPx = parseFloat(getComputedStyle(outers[i + 1]).top) || 0;
        const distanceToStick = tops[i + 1] - nextStickyTopPx;

        const progress = Math.min(1, Math.max(0, 1 - distanceToStick / REVEAL_DISTANCE));
        const scale = 1 - progress * (1 - targetScaleFor(i));
        inner.style.transform = `scale(${scale.toFixed(4)})`;
      });

      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const handleLayoutShift = () => {
      setTops();
      update();
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", handleLayoutShift);
    window.addEventListener("load", handleLayoutShift, { once: true });

    if (textEl && typeof ResizeObserver !== "undefined") {
      new ResizeObserver(handleLayoutShift).observe(textEl);
    }

    setTops();
    update();
  });
</script>
