<style is:global>
  /* Dot bridge between the two comparison cards — the Figma's 29×80 block,
     Nova Blue here rather than lime because this pair is an interactive
     comparison, matching the screenshot. */
  .gh-ei-bridge {
    display: block;
    width: 29.1px;
    height: 79.54px;
    flex-shrink: 0;
    /* `at 1.94px 1.94px` anchors the dot to the tile's top-left rather than its
       centre, which is what yields two columns inside 29.1px and four rows
       inside 79.54px — the Figma's 2×4 arrangement. Centred dots give one
       column, because the second would fall outside the box. */
    background-image: radial-gradient(
      circle at 1.94px 1.94px,
      var(--color-nova-blue) 1.94px,
      transparent 2px
    );
    background-size: 25.22px 25.22px;
    background-repeat: repeat;
  }
</style>
