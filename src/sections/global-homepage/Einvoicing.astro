              ))
            }
            <li class="inline-flex items-center rounded-lg border border-neutral-200 bg-generic-00 px-3 py-2.5 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-neutral-500 font-body">
              + more
            </li>
          </ul>
        </div>

<!-- The design's light wireframe globe with country pins, now on Webflow
             assets. Kept at the placeholder's box (447x400, and full-width
             capped at 447 below lg) so swapping it in did not move the panel;
             object-contain lets the artwork letterbox inside that box rather
             than stretch to it. -->
        <img
          src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9a89e8579f5458d64f606e_globe.png"
          alt="Globe with pins marking the countries ClearTax supports e-invoicing in"
          class="h-[400px] w-[447px] shrink-0 rounded-lg object-contain max-lg:h-64 max-lg:w-full max-lg:max-w-[447px]"
          loading="lazy"
          decoding="async"
        />
      </div>
