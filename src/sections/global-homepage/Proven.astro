---
/**
 * "Proven to work in the real world" — Figma node 13049:22787.
 *
 * Six rows, each a use-case card joined to an outcome card by a dot bridge.
 *
 * Row focus is a second IntersectionObserver, independent of the reveal one
 * below. Figma node 12745:19646 specimens the two states as component variants:
 *
 *   Default  (resting) — opacity 50%, bridge dots #A6C705
 *   Variant2 (focused) — full opacity, bridge dots #5446FF Nova Blue
 *
 * The focused row additionally scales to 1.02. That is ours, not the Figma's —
 * the specimen only varies opacity and dot colour.
 *
 * The row at the middle of the viewport gets Variant2, so scrolling walks the
 * focus down the list.
 *
 * ON THE 50% DIM: an earlier note here rejected the Figma's `opacity: 50%`,
 * reading it as a WIP artifact, because at ~2.4:1 the body copy fails WCAG AA.
 * That reasoning held while every row was permanently dim. It no longer does:
 * the dim is now the RESTING half of a focus pair, and the row being read is
 * always the full-opacity one. Rows you are not looking at are de-emphasised;
 * the row you are looking at is not. If it still reads too faint on a real
 * screen, `.gh-proven-row > *` is the single place to raise it.
 *
 * Without JS, or with reduced motion, every row renders focused — full opacity
 * and lit bridge — rather than the whole list sitting dimmed.
 */
interface Row {
  title: string;
  desc: string;
  stats: { value: string; label: string }[];
  attribution: string;
}

const rows: Row[] = [
  {
    title: "Sourcing & supply chain",
    desc: "Where orders stall and what the delay costs, daily.",
    stats: [
      { value: "6 days", label: "cut from order to delivery" },
      { value: "18%", label: "less stock in transit" },
    ],
    attribution: "Multi-site distributor, GCC",
  },
  {
    title: "Audit and tax litigation",
    desc: "Every notice type, answered with the transactions behind it.",
    stats: [
      { value: "7×", label: "faster end to end" },
      { value: "3 days", label: "vs 20–30 days before" },
    ],
    attribution: "Large multi-entity enterprise, India",
  },
  {
    title: "Pricing and revenue integrity",
    desc: "Every contract checked against every transaction.",
    stats: [
      { value: "4%", label: "of SKUs selling off-contract" },
      { value: "800", label: "contracts checked continuously" },
    ],
    attribution: "Manufacturer, KSA",
  },
  {
    title: "Fraud detection",
    desc: "Duplicate payments and ghost vendors caught before payout.",
    stats: [
      { value: "0.4%", label: "of payment value recovered" },
      { value: "100%", label: "of invoices screened, daily" },
    ],
    attribution: "Retail group, UAE",
  },
  {
    title: "Vendor and procurement",
    desc: "Every vendor ranked on cost, quality and delivery.",
    stats: [
      { value: "12,000+", label: "vendors scored on live data" },
      { value: "3%", label: "of spend redirected" },
    ],
    attribution: "Diversified conglomerate, India",
  },
  {
    title: "Plant and controls",
    desc: "Output, downtime and yield in one view.",
    stats: [
      { value: "9%", label: "less unplanned downtime" },
      { value: "100%", label: "of control breaks with a named owner" },
    ],
    attribution: "Industrial group, Malaysia",
  },
];
---

<section class="bg-generic-00 max-lg:py-12 lg:py-20" data-gh-proven>
  <div class="container mx-auto">
    <div class="flex flex-col gap-12">
      <div class="flex flex-col items-center gap-4 text-center">
        <p
          class="m-0 font-body font-medium uppercase text-neutral-400 text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)] tracking-[1px]"
        >
          Data already flows in. Finance logic already built.
        </p>
        <div class="flex flex-col items-center gap-4">
          <h2
            class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] tracking-[-0.5px]"
          >
            Proven to work in the real world
          </h2>
          <p
            class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
          >
            Live with enterprise customers today.
          </p>
        </div>
      </div>

      <ul class="m-0 flex list-none flex-col gap-8 p-0">
        {
          rows.map((row) => (
            <li class="gh-proven-row premium-reveal flex items-center justify-center gap-8 max-lg:flex-col max-lg:gap-4">
              <div class="flex flex-1 items-center gap-6 self-stretch rounded-xl border border-[#CCCCCC] bg-generic-00 p-6 max-lg:w-full">
                <span class="h-20 w-20 shrink-0 rounded-xl bg-visual-placeholder" aria-hidden="true" />
                <div class="flex min-w-0 flex-col gap-3">
                  <h3 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px]">
                    {row.title}
                  </h3>
                  <p class="m-0 font-body font-medium text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                    {row.desc}
                  </p>
                </div>
              </div>

              <span class="gh-proven-bridge shrink-0 max-lg:hidden" aria-hidden="true" />

              <div class="flex flex-1 items-start rounded-xl border border-[#CCCCCC] bg-generic-00 p-6 max-lg:w-full">
                <div class="flex min-w-0 flex-1 flex-col gap-6">
                  <div class="flex items-start gap-6">
                    {row.stats.map((s) => (
                      <div class="flex min-w-0 flex-1 flex-col gap-3">
                        <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px]">
                          {s.value}
                        </p>
                        <p class="m-0 font-body font-medium text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                          {s.label}
                        </p>
                      </div>
                    ))}
                  </div>
                  <p class="m-0 font-body text-vault-navy text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)]">
                    {row.attribution}
                  </p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style is:global>
  /* Row focus, per Figma node 12745:19646, which specimens the two states side
     by side. The row at the middle of the viewport is the "Variant2" instance —
     full opacity, Nova Blue dots. Every other row is "Default" — 50% opacity,
     #A6C705 dots. Scrolling therefore walks the focus down the list.

     The focused row also lifts slightly. Both the dim and the scale sit on the
     row's CHILDREN, not the row: shared.css ends the premium-reveal with
     `opacity: 1 !important` AND `transform: translateY(0) !important` on the
     <li>, so either property set there would be wiped the moment the row
     reveals. Each child scales about its own centre, so the dot bridge stays
     centred between the two cards.

     scale(1.02) is deliberately small. At 1440 it grows each card by ~6px per
     side, which stays inside the container's 24px gutter — anything larger
     starts pushing the cards past the page edge. */
  .gh-proven-row > * {
    opacity: 0.5;
    transform: scale(0.95);
    transition: all 0.35s ease;
  }

  .gh-proven-row.is-centered > * {
    opacity: 1;
    transform: scale(1);
  }

  /* The 30×82 dot bridge between the two cards: two columns, four rows,
     3.88px dots on a 25.22px pitch — the Figma's Frame 2147225847.

     #A6C705 is a one-off in this component, not a brand token — it is the fill
     Figma exports for the resting bridge. Painted from currentColor because
     `color` is transitionable and a background-image is not; a fixed colour
     stop would snap between states while the opacity eased. */
  .gh-proven-bridge {
    display: block;
    width: 29.1px;
    height: 79.54px;
    color: #a6c705;
    /* `at 1.94px 1.94px` anchors the dot to the tile's top-left rather than its
       centre, so two columns fit inside 29.1px and four rows inside 79.54px.
       A centred dot renders only one column — the second falls outside the box. */
    background-image: radial-gradient(
      circle at 1.94px 1.94px,
      currentColor 1.94px,
      transparent 2px
    );
    background-size: 25.22px 25.22px;
    background-repeat: repeat;
    transition: color 0.35s ease;
  }

  .gh-proven-row.is-centered .gh-proven-bridge {
    color: var(--color-nova-blue);
  }
</style>

<script is:inline>
  (function () {
    const root = document.querySelector("[data-gh-proven]");
    if (!root) return;
    const items = Array.from(root.querySelectorAll(".premium-reveal"));
    if (!items.length) return;

    if (
      !("IntersectionObserver" in window) ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      // No observer, or motion is unwelcome: show every row and light every
      // bridge, rather than leaving the whole list dimmed to #EFEFEF.
      items.forEach((el) => {
        el.classList.add("is-visible");
        el.classList.add("is-centered");
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
    );

    items.forEach((el) => observer.observe(el));

    // ---- Centred row -----------------------------------------------------
    // A thin 1% band pinned across the middle of the viewport, so "centred"
    // means the row the centre line is actually inside. That matters: the
    // observer only fires when a row enters or leaves the band, and nothing
    // recomputes in between. A wide band would let the nearest row change with
    // no crossing to trigger it, leaving the accent a row behind. Kept thin,
    // every change of row IS a crossing, so the two can never drift apart.
    //
    // `inBand` holds the running set because two rows can straddle the line for
    // a frame; pick() resolves that by distance rather than callback order.
    let centred = null;
    const inBand = new Set();

    const pick = () => {
      // Nothing in the band means the middle has landed in a gap between rows.
      // Hold the last choice instead of clearing, so the accent never blinks off.
      if (!inBand.size) return;

      const middle = window.innerHeight / 2;
      let best = null;
      let bestDistance = Infinity;

      inBand.forEach((el) => {
        const r = el.getBoundingClientRect();
        const distance = Math.abs((r.top + r.bottom) / 2 - middle);
        if (distance < bestDistance) {
          bestDistance = distance;
          best = el;
        }
      });

      if (!best || best === centred) return;
      if (centred) centred.classList.remove("is-centered");
      centred = best;
      centred.classList.add("is-centered");
    };

    const centreObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) inBand.add(entry.target);
          else inBand.delete(entry.target);
        });
        pick();
      },
      { rootMargin: "-49.5% 0px -49.5% 0px", threshold: 0 },
    );

    items.forEach((el) => centreObserver.observe(el));
  })();
</script>
