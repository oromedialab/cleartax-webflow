---
/**
 * Navbar for the Global homepage — the paste unit.
 *
 * Structure, styling and behaviour live in `_shared/NavbarRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file, because
 * the embed route renders sections with no props.
 *
 * Taxonomy is the four-column menu from the open-state design: AI Platform /
 * Enterprise Solution / Resources / Company. No Country group — NavbarRb ships
 * its own globe country panel, so listing countries here would duplicate it.
 *
 * TODO Ten of these have no known live URL and are parked on "#". Fill them in
 * before this goes to staging:
 *   Clarity AI · Identity Solutions · Delivery · By role · By use case ·
 *   Events · Knowledge Hub · Experience Centre · Podcast · Careers
 *
 * Four items carry a `children` sub-list — Global e-invoicing, Compliance
 * Automation, Knowledge Hub and Experience Centre. NavbarRb renders those
 * expanded by default with a chevron to collapse, which is how the design shows
 * them. None of the sub-item URLs are known yet either; they are on "#" too.
 */
import NavbarRb from '../_shared/NavbarRb.astro';
import type { NavLink } from '../_shared/NavbarRb.astro';

const links: NavLink[] = [
  {
    label: "AI Platform",
    dropdown: [
      { label: "Clarity AI", href: "#" },
      {
        label: "Global e-invoicing",
        href: "https://www.cleartax.com/global/e-invoicing-solution",
        children: [
          { label: "Retail and Consumer", href: "#" },
          { label: "Manufacturing", href: "#" },
          { label: "Banking and Financial Services", href: "#" },
          { label: "Travel and Hospitality", href: "#" },
          { label: "Software and Professional Services", href: "#" },
        ],
      },
      {
        label: "Compliance Automation",
        href: "https://www.cleartax.com/global/compliance",
        children: [
          { label: "Direct Tax Compliance", href: "#" },
          { label: "Indirect Tax Compliance", href: "#" },
          { label: "Board Governance", href: "#" },
        ],
      },
      { label: "Identity Solutions", href: "#" },
    ],
  },
  {
    label: "Enterprise Solution",
    dropdown: [
      {
        label: "Scale & Security",
        href: "https://www.cleartax.com/global/scale-security",
      },
      { label: "Delivery", href: "#" },
      {
        label: "Integration",
        href: "https://www.cleartax.com/global/erp-integration",
      },
      { label: "By role", href: "#" },
      { label: "By use case", href: "#" },
    ],
  },
  {
    label: "Resources",
    dropdown: [
      {
        label: "Blogs",
        href: "https://www.cleartax.com/electronic-invoicing#country-select",
      },
      { label: "Events", href: "#" },
      {
        label: "Knowledge Hub",
        href: "#",
        children: [
          { label: "White papers", href: "#" },
          { label: "Opinion notes", href: "#" },
          { label: "Reports", href: "#" },
          { label: "Case studies", href: "https://www.cleartax.com/case-studies" },
        ],
      },
      {
        label: "Experience Centre",
        href: "#",
        children: [
          { label: "Global mandate tracker", href: "#" },
          { label: "ROI Calculator", href: "#" },
          { label: "VAT Calculator", href: "#" },
        ],
      },
      { label: "Podcast", href: "#" },
    ],
  },
  {
    label: "Company",
    dropdown: [
      { label: "About us", href: "https://www.cleartax.com/about-us" },
      {
        label: "Partner program",
        href: "https://www.cleartax.com/global/partner-program",
      },
      { label: "Press", href: "https://www.cleartax.com/ae/press" },
      { label: "Trust Center", href: "https://cleartax.in/s/trust" },
      { label: "Careers", href: "#" },
      { label: "Contact us", href: "https://www.cleartax.com/contact-us" },
    ],
  },
];
---

<NavbarRb links={links} ctaOpensModal />
