---
/**
 * Closing CTA band — Figma node 13049:22871 ("Container - Partner program").
 *
 * Same seven-column dot grid as the hero, but tinted Nova Blue and pitched a
 * little wider, with the wash pulled toward the centre so the copy stays legible.
 */
const COLUMN_OFFSETS = ["-205px", "-153px", "-101px", "-49px", "-101px", "-153px", "-205px"];
---

<section class="gh-cta relative overflow-hidden bg-generic-00 max-lg:py-16 lg:py-[121px]">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    {
      COLUMN_OFFSETS.map((top, i) => (
        <div
          class="gh-cta-col absolute top-0 bottom-0"
          style={`left:${(i * 100) / 7}%;width:${100 / 7}%;background-position-y:${top}`}
        />
      ))
    }
    <div class="gh-cta-wash absolute inset-0"></div>
  </div>

  <div class="container mx-auto relative">
    <div class="mx-auto flex max-w-[791px] flex-col items-center gap-6 text-center">
      <div class="flex flex-col items-center gap-4">
        <h2
          class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] tracking-[-0.5px]"
        >
          Ready to put AI in the hands of your finance team?
        </h2>
        <p
          class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
        >
          No spam. A 30-minute call to help you unlock the first finance use-case you
          can solve.
        </p>
      </div>

      <a
        href="https://www.cleartax.com/contact-us"
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-50 no-underline shadow-[0px_2px_3px_rgba(16,24,40,0.06)] transition-opacity duration-200 hover:opacity-90"
      >
        Book a demo
      </a>
    </div>
  </div>
</section>

<style is:global>
  .gh-cta-col {
    background-image: radial-gradient(
      circle,
      rgba(84, 70, 255, 0.28) 1.6px,
      transparent 1.7px
    );
    background-size: 26px 26px;
    background-repeat: repeat;
  }

  .gh-cta-wash {
    background: radial-gradient(
      ellipse 45% 65% at 50% 50%,
      #ffffff 0%,
      rgba(255, 255, 255, 0.9) 50%,
      rgba(255, 255, 255, 0) 85%
    );
  }
</style>
