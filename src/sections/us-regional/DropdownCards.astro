---
/**
 * US Regional Compliance Exposure Card with Country Dropdown.
 * Built on top of the shared Dropdown component (`_shared/dropdown.astro`).
 */
import Dropdown from "../_shared/dropdown.astro";
import type {
    DropdownCardItem,
    Props as DropdownProps,
} from "../_shared/dropdown.astro";

export type { DropdownCardItem, DropdownProps };

const COUNTRIES: DropdownCardItem[] = [
    {
        id: "us",
        label: "United States",
        status: "No federal B2B mandate; federal agency procurement requires digital invoicing via IPP",
        means: "Low direct pressure today, but DBNAlliance-based exchange is expanding fast",
        icon: "/images/us-regional/logo-1.png",
    },
    {
        id: "eu",
        label: "France, Belgium, Germany, Poland",
        title: "European Union (France, Belgium, Germany, Poland)",
        status: "Mandatory or phasing in through 2026–2028 under domestic mandates (ahead of ViDA's 2030 cross-border requirement)",
        means: "Any EU subsidiary or EU-based supplier relationship puts you in scope now",
        icon: "/images/us-regional/logo-2.png",
    },
    {
        id: "saudi",
        label: "Saudi Arabia",
        status: "Live clearance/reporting mandates, phased rollout continuing through 2026",
        means: "Regional offices must integrate with ZATCA — or the UAE's Peppol-based model",
        icon: "/images/us-regional/logo-3.png",
    },
    {
        id: "sea",
        label: "Malaysia & Singapore",
        status: "Real-time reporting (MyInvois) and Peppol-based InvoiceNow, phasing by revenue threshold",
        means: "Entities crossing the revenue threshold face imminent go-live dates",
        icon: "/images/us-regional/logo-4.png",
    },
    {
        id: "india",
        label: "India",
        status: "Real-time IRN generation mandatory for B2B",
        means: "No IRN, no valid input tax credit — a direct cash-flow hit",
        icon: "/images/us-regional/logo-5.png",
    },
    {
        id: "latam",
        label: "Latin America",
        status: "Expanding or long-established clearance/reporting systems",
        means: "Growing markets where non-compliance carries real penalties",
        icon: "/images/us-regional/logo-6.png",
    },
];

const HEADING = "The US Isn't Mandated. Your Global Entities Might Already Be.";
const LEDE =
    'US federal procurement already requires structured digital invoicing. Beyond that, there\'s no national B2B mandate yet. But "no mandate at home" doesn\'t mean "no exposure." If your enterprise has a subsidiary, branch, or trading partner in any of the markets below, e-invoicing compliance is already someone\'s job.';
const COUNTRY_SELECT = "Select a country where your business operates";
const DEFAULT_COUNTRY = "United States";
const CLOSING_NOTE =
    "Different rules. Different formats. Different tax authorities. One team at HQ trying to keep track of all of it — unless that team has one platform instead of fifteen vendors.";

const props = Astro.props;
---

<Dropdown
    heading={props.heading ?? HEADING}
    lede={props.lede ?? LEDE}
    selectLabel={props.selectLabel ?? COUNTRY_SELECT}
    items={props.items ?? COUNTRIES}
    defaultLabel={props.defaultLabel ?? DEFAULT_COUNTRY}
    statusLabel={props.statusLabel ?? "Status"}
    meansLabel={props.meansLabel ?? "What It Means for a US Parent Company"}
    closingNote={props.closingNote ?? CLOSING_NOTE}
    {...props}
/>
