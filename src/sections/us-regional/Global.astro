---
const DataPoints = [
    {
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aba06eacc0f7e435f705640_D-recovery.png",
        title: "Global visibility, local execution",
        desc: "Monitor every subsidiary's compliance status from one console, while each market runs its own validation rules under the hood",
    },
    {
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aba06f34c7299bd389e8e67_D-sovereignity.png",
        title: "Peppol-ready by default",
        desc: "Peppol-ready by default, with parallel readiness for the DBNAlliance exchange as it matures in the US.",
    },
    {
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aba06fea677752c97beaca7_D-performance.png",
        title: "Future-proof for the US",
        desc: "As domestic e-invoicing infrastructure matures, you're already running the standards the rest of the world runs on.",
    },
];

const BLUE_DOT_ROWS = [8, 8, 16, 16, 24, 24, 24];
---

<section class="bg-generic-00 py-16 md:py-20">
    <div class="mx-auto w-full min-[1400px]:container px-4 md:px-6">
        <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start"
        >
            <!-- Left Column: Title, Description & Dot Matrix -->
            <div
                class="lg:col-span-6 xl:col-span-6 flex flex-col h-full justify-between"
            >
                <div>
                    <h2
                        class="text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] m-0 font-medium text-text-default max-w-120 mb-4 md:mb-6"
                    >
                        Built Global. Enforced Local.
                    </h2>
                    <p
                        class="text-neutral-500 font-normal text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] max-w-122 m-0"
                    >
                        ClearTax operates as a single, unified platform, but
                        every invoice is generated, validated, and formatted to
                        the exact legal and technical standards of the country
                        in which it's issued. Your finance team gets one
                        dashboard. Each local entity gets full compliance with
                        its own tax authority, automatically.
                    </p>
                </div>

                <!-- Blue Dot Matrix -->
                <div
                    class="hidden lg:flex flex-col gap-3.5 select-none mt-auto"
                >
                    {
                        BLUE_DOT_ROWS.map((count) => (
                            <div class="flex items-center gap-3.5">
                                {Array.from({ length: count }).map(() => (
                                    <span class="w-1 h-1 rounded-full bg-nova-blue shrink-0 inline-block aspect-square" />
                                ))}
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Right Column: Feature List -->
            <div
                class="lg:col-span-6 xl:col-span-6 flex flex-col divide-y divide-neutral-200"
            >
                {
                    DataPoints.map((item) => (
                        <div class="py-8 first:pt-0 last:pb-0">
                            <div
                                class={`w-10 h-10  rounded-lg shrink-0 bg-visual-placeholder`}
                            />
                            <div class="flex flex-col justify-center mt-4">
                                <h3 class="text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] font-medium text-vault-navy mb-4 font-heading m-0">
                                    {item.title}
                                </h3>
                                <p class="text-vault-navy/70 font-normal text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-body max-w-140 m-0">
                                    {item.desc}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
