---
/**
 * "Build your Qatar readiness plan in five steps" — Qatar regional page.
 *
 * Implements sticky horizontal scroll container matching regional specs:
 * - Section pins to viewport as reader scrolls down the page
 * - Translates horizontal track smoothly across the 5 implementation step cards
 * - Blue connecting progress line connects all cards together and fills dynamically with scroll progress
 */

interface Step {
  number: number;
  title: string;
  bullets: string[];
}

const steps: Step[] = [
  {
    number: 1,
    title: "Assess your Qatar invoice landscape",
    bullets: [
      "List your entities, invoice types, customers, suppliers, source systems and transaction volumes.",
      "Identify which teams own each stage of the invoice lifecycle.",
    ],
  },
  {
    number: 2,
    title: "Confirm what applies to your business",
    bullets: [
      "Review official guidance and any instructions issued directly to your organisation. Confirm the relevant tax regime and distinguish participant-specific instructions from wider obligations.",
    ],
  },
  {
    number: 3,
    title: "Prepare and map your invoice data",
    bullets: [
      "Review supplier and customer records, invoice identifiers, dates, descriptions, amounts and references. Document data gaps and assign owners to correct them.",
    ],
  },
  {
    number: 4,
    title: "Scope integration and testing",
    bullets: [
      "Bring finance and IT together to assess data extraction, validation, exception handling and reconciliation. Define the deployment test plan once the applicable requirements and interfaces are confirmed.",
    ],
  },
  {
    number: 5,
    title: "Maintain a change-ready plan",
    bullets: [
      "Track official updates, record decisions and keep implementation responsibilities clear. Revisit scope and timing when new requirements are confirmed.",
    ],
  },
];

