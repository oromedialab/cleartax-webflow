---
/**
 * Poland regional hero — Figma node 18377:71036 ("Container - Hero").
 *
 * Copied from `slovakia-regional/Hero.astro`: same stroke-field background in
 * place of the Figma's partner-logo wall, same single Flux Lime mark. Here the
 * "Hightlight" rectangle sits behind "e-invoicing" in a two-line headline, and
 * the Figma adds an overline above it and a row of three proof badges below
 * the body copy.
 *
 * The badge squares are unfilled "Icon placeholder" frames in the Figma, so
 * they render as `bg-visual-placeholder` (#E8FFE1). Swap for Webflow-hosted
 * artwork when it lands — never a `data:` URI.
 *
 * Ids and the canvas id are `qa-` prefixed — embeds share one namespace per
 * page and a bare `hero` is exactly the kind of name that collides later.
 */
interface Props {
    /** Stroke width, and so the diameter of the dot it becomes at rest. */
    lineWidth?: number;
    gap?: number;
    /** Must stay under the grid pitch or the field knits into a mesh. */
    maxLength?: number;
    lengthRadius?: number;
    /** Leave at 1 — a partial turn makes strokes flip as the cursor crosses them. */
    tilt?: number;
    baseColor?: string;
    cursorRadius?: number;
    pull?: number;
    fadeRadius?: number;
}

const {
    lineWidth = 3,
    gap = 24,
    maxLength = 6,
    lengthRadius = 260,
    tilt = 1,
    baseColor = "#C8F006",
    cursorRadius = 320,
    pull = 14,
    fadeRadius = 40,
} = Astro.props;

const stats: { value: string; label: string; width: string }[] = [
    {
        value: "Map your ERP and billing systems",
        label: "through integration options aligned with EN 16931 and Revenue's VAT modernisation roadmap",
        width: "md:max-w-[368px]",
    },
    {
        value: "Validate invoice data",
        label: "and submit through a KSeF-integrated platform.",
        width: "md:max-w-[368px]",
    },
    {
        value: "Monitor invoice statuses",
        label: "and reconcile records with your ERP.",
        width: "md:max-w-[368px]",
    },
];
---

<section
    id="qa-hero"
    class="qa-hero relative overflow-hidden bg-generic-00"
    data-line-width={String(lineWidth)}
    data-gap={String(gap)}
    data-max-length={String(maxLength)}
    data-length-radius={String(lengthRadius)}
    data-tilt={String(tilt)}
    data-base-color={baseColor}
    data-cursor-radius={String(cursorRadius)}
    data-pull={String(pull)}
    data-fade-radius={String(fadeRadius)}
>
    <!-- Interactive stroke field -->
    <div class="absolute inset-0 z-0 w-full h-full pointer-events-none">
        <canvas id="qa-hero-dots" class="absolute inset-0 w-full h-full"
        ></canvas>
    </div>

    <!-- Radial wash, so the headline keeps its contrast over the field -->
    <div
        class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"
    >
    </div>
    <div
        class="absolute inset-0 z-0 bg-[linear-gradient(180deg,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(242,_241,_240,_0.25)_87.79%,_#FFF_100%)] pointer-events-none"
    >
    </div>

    <div class="container mx-auto relative z-10">
        <div
            class="flex flex-col items-center gap-6 text-center max-lg:pt-32 max-lg:pb-16 lg:pt-[257px] lg:pb-[177px]"
        >
            <div class="flex flex-col items-center gap-8 w-full">
                <div class="flex flex-col items-center gap-4">
                    <p
                        class="m-0 font-body font-semibold uppercase tracking-[1px] text-nova-blue text-[length:var(--fs-label)] leading-[length:var(--lh-body-sm)]"
                    >
                        Poland e-invoicing
                    </p>
                    <h1
                        class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h1)] md:text-[length:var(--fs-display-sm)] lg:text-[length:var(--fs-display-lg)] leading-[length:var(--lh-h1)] md:leading-[length:var(--lh-display-sm)] lg:leading-[length:var(--lh-display-lg)] tracking-[-1px] max-w-252"
                    >
                        Plan your KSeF workflow around your ERP.
                    </h1>
                    <p
                        class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] max-w-200"
                    >
                        ClearTax e-invoicing solution fits your entities,
                        invoice flows and existing systems. Integrate your
                        existing systems, automate invoice validation and
                        submission, and track the issues that need your team’s
                        attention.
                    </p>
                </div>

                  <ul
                    class="m-0 flex w-full max-w-[1130px] list-none flex-col overflow-hidden rounded-xl border border-neutral-300 bg-generic-00 p-0 md:flex-row"
                >
                    {
                        stats.map((st, i) => (
                            <>
                                {i > 0 && (
                                    <li
                                        aria-hidden="true"
                                        class="h-px w-auto bg-neutral-100 max-md:mx-4 md:h-[60px] md:w-[2px] md:shrink-0 md:self-center"
                                    />
                                )}
                                <li class="flex flex-1 items-center gap-3 p-4 text-left">
                                    <div class="size-11 sm:size-12 shrink-0 rounded-xl flex items-center justify-center">
                                        {i === 0 && (
                                            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect x="0.5" y="0.5" width="55" height="55" rx="7.5" stroke="#CCCCCC"/>
                                                <path d="M27.9999 35.8815V32.0171M37.9151 35.9323V34.051C37.9151 32.9277 37.0044 32.0171 35.8812 32.0171H32.0168M18.0847 35.9323V34.051C18.0847 32.9277 18.9953 32.0171 20.1186 32.0171H23.983M30.4914 28.2036H25.5084M25.966 37.9662C25.966 39.0894 26.8766 40.0001 27.9999 40.0001C29.1231 40.0001 30.0338 39.0894 30.0338 37.9662C30.0338 36.8429 29.1231 35.9323 27.9999 35.9323C26.8766 35.9323 25.966 36.8429 25.966 37.9662ZM18.0339 35.9323C19.1571 35.9323 20.0678 36.8429 20.0678 37.9662C20.0678 39.0894 19.1571 40.0001 18.0339 40.0001C16.9106 40.0001 16 39.0894 16 37.9662C16 36.8429 16.9106 35.9323 18.0339 35.9323ZM37.9659 35.9323C39.0892 35.9323 39.9998 36.8429 39.9998 37.9662C39.9998 39.0894 39.0892 40.0001 37.9659 40.0001C36.8426 40.0001 35.932 39.0894 35.932 37.9662C35.932 36.8429 36.8426 35.9323 37.9659 35.9323Z" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#05022A"/>
                                                <path d="M34.0547 22.1017V18.5424C34.0547 17.1383 32.9164 16.0001 31.5124 16.0001H24.4955C23.0914 16.0001 21.9531 17.1383 21.9531 18.5424V22.1017C21.9531 23.5058 23.0914 24.6441 24.4955 24.6441H31.5124C32.9164 24.6441 34.0547 23.5058 34.0547 22.1017Z" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#5446FF"/>
                                            </svg>

                                        )}
                                        {i === 1 && (
                                           <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect x="0.5" y="0.5" width="55" height="55" rx="7.5" stroke="#CCCCCC"/>
                                                <path d="M21.4194 22.1017H23.4533M21.4194 26.1695H25.4872M33.6227 24.1356V22.1017L27.5211 16L19.3855 16C18.2621 16 17.3516 16.9106 17.3516 18.0339L17.3516 37.9661C17.3516 39.0893 18.2621 40 19.3855 40H25.4872M27.5211 16V20.0678C27.5211 21.1911 28.4317 22.1017 29.555 22.1017L33.6227 22.1017" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#05022A"/>
                                                <path d="M31.4844 33.5445L32.6457 34.7236L34.959 31.7122" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#5446FF"/>
                                                <path d="M38.254 29.9605C37.6523 29.6793 36.5179 29.0213 36.2476 27.9619C36.1772 27.686 35.9134 27.4919 35.6109 27.4919L29.8147 27.4919C29.5123 27.4919 29.2484 27.686 29.178 27.9619C28.9078 29.0213 27.7734 29.6793 27.1717 29.9605C26.929 30.0738 26.7739 30.3048 26.7734 30.5591C26.771 31.9159 27.2007 36.1388 32.2789 39.3882C32.4068 39.47 32.558 39.5137 32.7128 39.5137C32.8676 39.5137 33.0189 39.47 33.1468 39.3882C38.225 36.1388 38.6547 31.9159 38.6523 30.5591C38.6518 30.3048 38.4967 30.0738 38.254 29.9605Z" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#5446FF"/>
                                            </svg>

                                        )}
                                        {i === 2 && (
                                            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect x="0.5" y="0.5" width="55" height="55" rx="7.5" stroke="#CCCCCC"/>
                                                <path d="M32.4632 21.1949V16L20.5432 16L16 20.3274L16 36.8939H32.4632V32.5141M16 20.3274H20.5432V16M22.5254 36.8974V40H38.343V37.4205" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#05022A"/>
                                                <path d="M32.4609 17.481H38.3429V33.1509" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#05022A"/>
                                                <path d="M34.885 26.0946C34.885 29.5008 32.1178 32.2621 28.7042 32.2621C25.2907 32.2621 22.5234 29.5008 22.5234 26.0946C22.5234 22.6885 25.2907 19.9272 28.7042 19.9272C32.1178 19.9272 34.885 22.6885 34.885 26.0946Z" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#5446FF"/>
                                                <path d="M31.5246 31.5829L33.9731 34.026M33.9731 34.026L36.8317 36.8785C37.5558 37.6009 38.7296 37.6009 39.4537 36.8785C40.1777 36.156 40.1777 34.9847 39.4537 34.2622L34.1643 28.9844M33.9731 34.026L33.9726 34.0265M33.9731 34.026L36.5945 31.4103M23.1328 28.7706L27.5175 25.854L29.0493 27.973L31.841 25.854" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#5446FF"/>
                                                <path d="M19.2422 28.0001L22.5281 25.8577" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#5446FF"/>
                                            </svg>

                                        )}
                                    </div>
                                    <div class="flex flex-col w-full">
                                       <div class={`flex flex-col ${st.width}`}>
                                        <span class="font-body text-text-default font-medium text-sm leading-[1.42]">
                                            {st.value}
                                        </span>
                                    </div>
                                    <div class={`flex flex-col ${st.width}`}>
                                        <span class="font-body text-[#6B7280] font-normal text-xs leading-[1.42]">
                                            {st.label}
                                        </span>
                                    </div> 
                                    </div>
                                    
                                </li>
                            </>
                        ))
                    }
                </ul>
            </div>

            <!-- Scrolls to the closing contact band (`ContactForm.astro`, id
           "contactForm") instead of opening the modal. No `data-demo-open`, so
           the modal's delegated handler ignores it. The href is the same anchor,
           so the CTA still lands there if script is blocked; if that section is
           absent, onclick lets the browser follow the href as normal. -->
            <a
                href="javascript:void(0)"
                onclick="document.getElementById('contactForm').scrollIntoView({behavior:'smooth'})"
                class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-10 py-3.5 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-50 no-underline transition-all duration-200 hover:bg-generic-00 hover:text-nova-blue"
            >
                Book a Demo
            </a>
        </div>
    </div>
</section>

<script is:inline>
    /* Interactive stroke field — the one from `sections/global-homepage/Hero.astro`,
     which took it from `sections/blog-listing/Newsletter.astro`. That file carries
     the full explanation of the geometry; the numbers here come off the section's
     data-* attributes so there is a single source for each. */
    function initQaHeroGrid() {
        const section = document.getElementById("qa-hero");
        if (!section) return;
        const canvas = document.getElementById("qa-hero-dots");
        if (!canvas || !canvas.getContext) return;
        const ctx = canvas.getContext("2d");

        function num(name, fallback) {
            const value = parseFloat(section.getAttribute(name));
            return isNaN(value) ? fallback : value;
        }

        const config = {
            lineWidth: num("data-line-width", 2),
            gap: num("data-gap", 24),
            maxLength: num("data-max-length", 6),
            lengthRadius: num("data-length-radius", 260),
            tilt: num("data-tilt", 1),
            baseColor: section.getAttribute("data-base-color") || "#C8F006",
            cursorRadius: num("data-cursor-radius", 320),
            pull: num("data-pull", 14),
            fadeRadius: num("data-fade-radius", 40),
            fadeSpeed: 12,
            followSpeed: 7,
            engageSpeed: 4,
            focusSpeed: 5,
        };

        const HALF_PI = Math.PI / 2; // straight down — the resting angle

        let width = 0;
        let height = 0;
        let dots = [];
        const mouse = { x: -9999, y: -9999, prevX: -9999, prevY: -9999 };
        let hover = false;
        let speed = 0; // smoothed cursor travel, px per frame
        let engagement = 0; // 0–1, how awake the field is
        let presence = 0; // 0–1, whether a pointer is over the section at all
        let focusX = 0;
        let focusY = 0;

        function initGrid() {
            const parent = canvas.parentElement;
            width = parent.offsetWidth;
            height = parent.offsetHeight;
            if (!width || !height) return;

            const dpr = window.devicePixelRatio || 1;
            canvas.width = Math.round(width * dpr);
            canvas.height = Math.round(height * dpr);
            // setTransform, not scale: scale() multiplies the existing matrix, so
            // every resize would compound the DPR and shrink the grid.
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

            dots = [];
            const spacing = config.lineWidth + config.gap;
            const cols = Math.floor(width / spacing);
            const rows = Math.floor(height / spacing);
            const startX = (width - cols * spacing) / 2 + config.lineWidth / 2;
            const startY = (height - rows * spacing) / 2 + config.lineWidth / 2;

            for (let y = 0; y <= rows; y++) {
                for (let x = 0; x <= cols; x++) {
                    const cx = startX + x * spacing;
                    const cy = startY + y * spacing;
                    // ox/oy is the stroke's home and the point it is drawn centred on;
                    // x/y is where that centre is now; hx/hy is half its segment vector.
                    dots.push({
                        x: cx,
                        y: cy,
                        ox: cx,
                        oy: cy,
                        alpha: 1,
                        hx: 0,
                        hy: 0,
                    });
                }
            }

            if (!hover) {
                focusX = width / 2;
                focusY = height / 2;
            }
            aim();
            paint();
        }

        // Length and angle, both straight off the focus. The focus and `presence`
        // are already eased, so neither needs easing here.
        function aim() {
            const longest = config.maxLength / 2;
            const turn = presence * config.tilt;

            for (let i = 0; i < dots.length; i++) {
                const dot = dots[i];
                const dx = focusX - dot.ox;
                const dy = focusY - dot.oy;
                const dist = Math.sqrt(dx * dx + dy * dy);

                // 1 at the pointer, 0 by `lengthRadius`. Scaled by `presence`, so with
                // no cursor on the section every stroke is a plain dot.
                let t = dist / config.lengthRadius;
                if (t > 1) t = 1;
                const grow = 1 - t;
                let reach = longest * grow * grow * (3 - 2 * grow) * presence;
                // A canvas subpath of exactly zero length is not reliably painted, even
                // with a round cap. A quarter pixel is a dot and is always drawn.
                if (reach < 0.25) reach = 0.25;

                let ux = 0;
                let uy = 1;

                if (turn > 0.001 && dist > 0.01) {
                    // Folded into a quarter turn either side: a segment drawn about its
                    // centre looks the same pointed either way, so this takes the short
                    // way round. Only seamless because `turn` reaches 1 — scaling the
                    // angle by any fraction makes strokes flip as the cursor crosses them.
                    let off = Math.atan2(dy, dx) - HALF_PI;
                    while (off > HALF_PI) off -= Math.PI;
                    while (off < -HALF_PI) off += Math.PI;

                    const angle = HALF_PI + off * turn;
                    ux = Math.cos(angle);
                    uy = Math.sin(angle);
                }

                dot.hx = ux * reach;
                dot.hy = uy * reach;
            }
        }

        function paint() {
            ctx.clearRect(0, 0, width, height);
            ctx.strokeStyle = config.baseColor;
            ctx.lineWidth = config.lineWidth;
            ctx.lineCap = "round"; // so a stroke shrunk to nothing reads as a dot

            // Two passes. Only the strokes the cursor is touching have an alpha of
            // their own; the rest of the field goes down as one path in one stroke
            // call. Setting globalAlpha per stroke across the whole grid stutters.
            ctx.globalAlpha = 1;
            ctx.beginPath();
            for (let i = 0; i < dots.length; i++) {
                const dot = dots[i];
                if (dot.alpha < 0.995) continue;
                ctx.moveTo(dot.x - dot.hx, dot.y - dot.hy);
                ctx.lineTo(dot.x + dot.hx, dot.y + dot.hy);
            }
            ctx.stroke();

            for (let j = 0; j < dots.length; j++) {
                const fading = dots[j];
                if (fading.alpha >= 0.995 || fading.alpha < 0.01) continue;
                ctx.globalAlpha = fading.alpha;
                ctx.beginPath();
                ctx.moveTo(fading.x - fading.hx, fading.y - fading.hy);
                ctx.lineTo(fading.x + fading.hx, fading.y + fading.hy);
                ctx.stroke();
            }

            ctx.globalAlpha = 1;
        }

        const reduceMotion =
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (reduceMotion) {
            // Static dot grid. No animation loop, no cursor reaction.
            initGrid();
            paint();
            window.addEventListener("resize", () => {
                initGrid();
                paint();
            });
            return;
        }

        let lastTime = performance.now();
        let isFirstFrame = true;

        function draw(time) {
            if (dots.length === 0) {
                initGrid();
            }

            let dt = (time - lastTime) / 1000;
            if (dt > 0.05) dt = 0.05; // cap so a backgrounded tab can't jolt the grid
            lastTime = time;

            const fadeEase = Math.min(1, config.fadeSpeed * dt);
            const followEase = Math.min(1, config.followSpeed * dt);
            const engageEase = Math.min(1, config.engageSpeed * dt);
            const focusEase = Math.min(1, config.focusSpeed * dt);

            const travelX = mouse.x - mouse.prevX;
            const travelY = mouse.y - mouse.prevY;
            mouse.prevX = mouse.x;
            mouse.prevY = mouse.y;
            speed +=
                (Math.sqrt(travelX * travelX + travelY * travelY) - speed) *
                0.5;
            if (speed < 0.01) speed = 0;

            engagement +=
                ((hover ? Math.min(speed / 6, 1) : 0) - engagement) *
                engageEase;
            if (engagement < 0.001) engagement = 0;

            // A parked cursor still holds the field open, just more gently.
            const grip = hover ? 0.4 + 0.6 * engagement : 0;

            const wantX = hover ? mouse.x : width / 2;
            const wantY = hover ? mouse.y : height / 2;
            const swungX = wantX - focusX;
            const swungY = wantY - focusY;
            let swung =
                swungX > 0.05 ||
                swungX < -0.05 ||
                swungY > 0.05 ||
                swungY < -0.05;
            if (swung) {
                focusX += swungX * focusEase;
                focusY += swungY * focusEase;
            } else if (focusX !== wantX || focusY !== wantY) {
                focusX = wantX;
                focusY = wantY;
                swung = true;
            }

            const wantPresence = hover ? 1 : 0;
            const presenceDiff = wantPresence - presence;
            if (presenceDiff > 0.002 || presenceDiff < -0.002) {
                presence += presenceDiff * focusEase;
                swung = true;
            } else if (presence !== wantPresence) {
                presence = wantPresence;
                swung = true;
            }

            // Length and angle hang off those two, so they only need recomputing on
            // the frames one of them actually moved.
            if (swung) aim();

            const crSq = config.cursorRadius * config.cursorRadius;
            let moving = swung;

            for (let i = 0; i < dots.length; i++) {
                const dot = dots[i];

                // Measured from the stroke's home, not its current position, or one
                // that has moved toward the focus reads as closer and runs away into it.
                const dx = focusX - dot.ox;
                const dy = focusY - dot.oy;
                const distSq = dx * dx + dy * dy;

                let targetAlpha = 1;
                let targetX = dot.ox;
                let targetY = dot.oy;

                if (distSq < crSq) {
                    const dist = Math.sqrt(distSq);

                    if (grip > 0.001) {
                        const t = 1 - dist / config.cursorRadius;
                        let push = t * t * config.pull * grip;
                        // A stroke must never reach the cursor: past it, it crosses to the
                        // far side and the field knots up around the pointer.
                        if (push > dist * 0.75) push = dist * 0.75;
                        const step = dist > 0.01 ? push / dist : 0;
                        targetX += dx * step;
                        targetY += dy * step;
                    }

                    if (dist < config.fadeRadius) {
                        const ft = dist / config.fadeRadius;
                        const hole = ft * ft * (3 - 2 * ft);
                        // Also the pointer's doing, so the resting grid keeps every dot.
                        targetAlpha = 1 - (1 - hole) * presence;
                    }
                }

                const offX = targetX - dot.x;
                const offY = targetY - dot.y;
                if (
                    offX > 0.05 ||
                    offX < -0.05 ||
                    offY > 0.05 ||
                    offY < -0.05
                ) {
                    dot.x += offX * followEase;
                    dot.y += offY * followEase;
                    moving = true;
                } else if (dot.x !== targetX || dot.y !== targetY) {
                    dot.x = targetX;
                    dot.y = targetY;
                    moving = true;
                }

                const diff = targetAlpha - dot.alpha;
                if (diff > 0.002 || diff < -0.002) {
                    dot.alpha += diff * fadeEase;
                    moving = true;
                } else if (dot.alpha !== targetAlpha) {
                    dot.alpha = targetAlpha;
                    moving = true;
                }
            }

            // A settled field is repainted zero times a second, not sixty.
            if (moving || isFirstFrame) {
                paint();
                isFirstFrame = false;
            }
            requestAnimationFrame(draw);
        }

        window.addEventListener("resize", initGrid);
        initGrid();
        requestAnimationFrame(draw);

        section.addEventListener("mousemove", (e) => {
            const rect = canvas.getBoundingClientRect();
            const sx = rect.width ? width / rect.width : 1;
            const sy = rect.height ? height / rect.height : 1;
            const nx = (e.clientX - rect.left) * sx;
            const ny = (e.clientY - rect.top) * sy;
            if (!hover) {
                // Re-entering: seed prev with the entry point, or the jump from the last
                // position would register as a colossal cursor speed.
                mouse.prevX = nx;
                mouse.prevY = ny;
            }
            hover = true;
            mouse.x = nx;
            mouse.y = ny;
        });

        section.addEventListener("mouseleave", () => {
            // Dropping `hover` is what matters: the focus starts its swing back to the
            // centre, the strokes reel in and the pull lets go. Nothing reads the
            // parked coordinates while `hover` is false, and re-entry reseeds them.
            hover = false;
            speed = 0;
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initQaHeroGrid);
    } else {
        initQaHeroGrid();
    }
</script>
