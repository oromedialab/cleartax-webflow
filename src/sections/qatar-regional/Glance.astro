---
/**
 * Qatar e-invoicing at a glance
 *
 * Four cards in a 2-column grid. A card is a button: clicking it opens ONE
 * overlay dialog showing that card's heading and body.
 *
 * Ids and data attributes are `qa-supports-` prefixed: embeds share one
 * namespace per page.
 */
interface Card {
    heading: string;
    body: string;
    icon?: string;
    img?: string;
}

const cards: Card[] = [
    {
        heading: "A GTA-led digital transformation initiative",
        body: `The GTA’s public announcement places its e-invoicing project within wider work to modernise tax systems and electronic documentation. Use official GTA publications as the starting point for your Qatar readiness plan.`,
    },
    {
        heading: "Start with your invoice data",
        body: `Map where invoice information is created, checked, approved and stored. Identify incomplete master data, inconsistent references and manual handoffs before selecting an implementation approach.`,
    },
    {
        heading: "Qatar needs a Qatar-specific plan",
        body: `Do not use another country’s rollout or technical model as your Qatar implementation brief. Confirm the requirements applicable to your entities and transactions before defining formats, transmission routes or testing criteria.`,
    },
    {
        heading: "E-invoicing and VAT are not interchangeable",
        body: `The GTA states that Qatar has not applied VAT. Keep any future VAT assessment separate from invoice-process improvement and e-invoicing readiness.`,
    },
];

interface TimelineItem {
    status: string;
    development: string;
    meaning: string;
}

const timeline: TimelineItem[] = [
    {
        status: "25 June 2025",
        development: "GTA public announcement discusses the e-invoicing project.",
        meaning: "Official evidence of project activity; not a nationwide compliance deadline.",
    },
    {
        status: "Current GTA published position",
        development: "Qatar has not applied VAT.",
        meaning: "E-invoicing is not currently an existing VAT compliance requirement in Qatar.",
    },
    {
        status: "Before implementation",
        development: "Confirm the latest applicable official instructions.",
        meaning: "Verify scope, effective dates and technical requirements before committing to deployment.",
    },
];
---

<section class="bg-generic-00 pt-16 pb-12 lg:pt-20">
    <div
        class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12"
    >
        <div class="flex flex-col items-center gap-6 text-center">
            <h2
                class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] max-w-191 tracking-[-0.5px] max-w-127"
            >
                Qatar e-invoicing at a glance
            </h2>
            <p
                class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] max-w-235"
            >
                The General Tax Authority (GTA) has publicly identified e-invoicing as part of its digital transformation work. Its <span class="text-nova-blue">June 2025 announcement</span> describes cooperation on the e-invoicing project and the technical and regulatory challenges of electronic documentation. Prepare by reviewing your invoice landscape, data quality and system ownership.
            </p>
        </div>

        <div
            class="grid w-full grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-8"
        >
            {
                cards.map((card, i) => (
                    <button
                        type="button"
                        class="group m-0 flex h-full w-full cursor-pointer items-center justify-between gap-3 sm:gap-4 md:gap-5 rounded-xl border border-neutral-300 bg-generic-00 p-4 sm:p-5 md:p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue"
                        aria-haspopup="dialog"
                        data-qa-supports-open
                        data-qa-supports-index={i}
                    >
                        <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)] md:text-[length:var(--fs-body-lg)] md:leading-[length:var(--lh-body-lg)] lg:text-[length:var(--fs-h6)] lg:leading-[length:var(--lh-h6)]">
                            {card.heading}
                        </span>
                        <span
                            class="ml-auto flex h-10 w-10 sm:h-12 sm:w-12 lg:h-14 lg:w-14 shrink-0 items-center justify-center rounded-lg p-1.5 sm:p-2 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
                            aria-hidden="true"
                        >
                            <svg
                                class="h-6 w-6 sm:h-8 sm:w-8 lg:h-10 lg:w-10"
                                viewBox="0 0 40 40"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20 10V30"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                                <path
                                    d="M30 20L10 20"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </span>
                    </button>
                ))
            }
        </div>

        <!-- Key developments and planning checkpoints -->
        <div class="flex flex-col items-center w-full mt-12 lg:mt-16">
            <h3
                class="m-0 mb-8 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h4)] leading-[length:var(--lh-h4)] tracking-[-0.5px]"
            >
                Key developments and planning checkpoints
            </h3>
            <div
                class="w-full overflow-hidden rounded-xl border border-neutral-300 bg-generic-00"
            >
                <div
                    class="hidden lg:grid grid-cols-[280px_1fr_1.1fr] gap-x-12 items-center p-6 border-b border-neutral-300 font-heading font-medium text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
                >
                    <span>Status / date</span>
                    <span>Development</span>
                    <span>What it means</span>
                </div>
                {
                    timeline.map((item) => (
                        <div class="grid grid-cols-1 gap-2 p-6 lg:grid-cols-[280px_1fr_1.1fr] lg:gap-x-12 lg:items-center [&:not(:first-of-type)]:border-t [&:not(:first-of-type)]:border-[#F2F1F0]">
                            <span class="font-body font-medium text-vault-navy text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]">
                                {item.status}
                            </span>
                            <span class="qa-tl-cell font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-left">
                                {item.development}
                            </span>
                            <span class="qa-tl-cell font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-left">
                                {item.meaning}
                            </span>
                        </div>
                    ))
                }
            </div>

            <div class="w-full max-w-[1280px] mt-12 flex flex-col items-center">
                <div class="w-full mx-auto flex flex-col gap-4 rounded-xl border-2 border-[#ff8000] p-8 text-left bg-generic-00">
                    <h3
                        class="m-0 mx-auto font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px]"
                    >
                        What disconnected invoicing leaves on your team’s desk
                    </h3>
                    <p
                        class="m-0 mx-auto max-w-[742px] text-center font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                    >
                        Where invoice data sits across multiple systems and spreadsheets, start by identifying duplicate entry, missing information, unclear exception ownership and difficult retrieval. These are useful process-improvement priorities regardless of a future mandate’s timing.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Detail overlay. Lives outside the section's container so the scrim covers
     the viewport rather than the 1280px column. -->
<div
    id="qa-supports-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="qa-supports-overlay-title"
    aria-hidden="true"
    class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
>
    <div 
        class="relative max-h-[90vh] w-full max-w-[630px] overflow-y-auto rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6"
        data-qa-supports-panel
    >
        <button
            type="button"
            aria-label="Close"
            class="absolute right-6 top-6 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-5 lg:top-5"
            data-qa-supports-close
        >
            <svg
                width="40"
                height="40"
                viewBox="0 0 40 40"
                fill="none"
                class="rotate-45"
                aria-hidden="true"
                focusable="false"
            >
                <path
                    d="M20 10V30"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                <path
                    d="M30 20L10 20"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </button>

        <div class="flex flex-col items-start gap-6">
            <div class="flex w-full flex-col justify-between gap-6">
                <div class="flex items-center gap-4">
                    <div id="qa-supports-overlay-title">
                        {
                            cards.map((card, i) => (
                                <h3
                                    class="m-0 pr-12 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px] text-balance"
                                    style={
                                        i === 0
                                            ? "display: block;"
                                            : "display: none;"
                                    }
                                    hidden={i !== 0}
                                    data-qa-supports-heading
                                >
                                    {card.heading}
                                </h3>
                            ))
                        }
                    </div>
                </div>

                <div
                    class="aspect-[574/323] w-full max-w-[574px] rounded-lg overflow-hidden bg-visual-placeholder mx-auto"
                >
                    {
                        cards.map((card, i) => (
                            <div
                                class="h-full w-full bg-visual-placeholder"
                                style={i === 0 ? "display: block;" : "display: none;"}
                                hidden={i !== 0}
                                data-qa-supports-image
                                aria-hidden="true"
                            />
                        ))
                    }
                </div>

                <div class="flex flex-col gap-6">
                    <div>
                        {
                            cards.map((card, i) => (
                                <p
                                    class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                                    style={
                                        i === 0
                                            ? "display: block;"
                                            : "display: none;"
                                    }
                                    hidden={i !== 0}
                                    data-qa-supports-body
                                >
                                    {card.body}
                                </p>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style is:global>
    [data-qa-supports-heading][hidden],
    [data-qa-supports-body][hidden],
    [data-qa-supports-icon][hidden],
    [data-qa-supports-image][hidden] {
        display: none !important;
    }
</style>

<script is:inline>
    /* Card -> detail overlay, with the chevrons walking the eight without closing. */
    (function () {
        var overlay = document.getElementById("qa-supports-overlay");
        if (!overlay) return;

        var panel = overlay.querySelector("[data-qa-supports-panel]");
        var closeBtn = overlay.querySelector("[data-qa-supports-close]");
        var prevBtn = overlay.querySelector("[data-qa-supports-prev]");
        var nextBtn = overlay.querySelector("[data-qa-supports-next]");
        var headings = overlay.querySelectorAll("[data-qa-supports-heading]");
        var bodies = overlay.querySelectorAll("[data-qa-supports-body]");
        var icons = overlay.querySelectorAll("[data-qa-supports-icon]");
        var images = overlay.querySelectorAll("[data-qa-supports-image]");
        if (!panel || !headings.length || headings.length !== bodies.length)
            return;

        var count = headings.length;
        var current = 0;
        var lastFocused = null;

        function show(index) {
            current = ((index % count) + count) % count;
            for (var i = 0; i < count; i++) {
                headings[i].hidden = i !== current;
                headings[i].style.display = i === current ? "block" : "none";
                bodies[i].hidden = i !== current;
                bodies[i].style.display = i === current ? "block" : "none";
                if (icons[i]) {
                    icons[i].hidden = i !== current;
                    icons[i].style.display = i === current ? "flex" : "none";
                }
                if (images[i]) {
                    images[i].hidden = i !== current;
                    images[i].style.display = i === current ? "block" : "none";
                }
            }
            panel.scrollTop = 0;
        }

        function open(index, opener) {
            lastFocused = opener || document.activeElement;
            show(index);
            overlay.style.display = "flex";
            overlay.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
            if (closeBtn) closeBtn.focus();
        }

        function close() {
            overlay.style.display = "none";
            overlay.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
            if (lastFocused && lastFocused.focus) lastFocused.focus();
        }

        function isOpen() {
            return overlay.style.display === "flex";
        }

        document.addEventListener("click", function (e) {
            if (!e.target.closest) return;
            var opener = e.target.closest("[data-qa-supports-open]");
            if (!opener) return;
            open(
                parseInt(opener.getAttribute("data-qa-supports-index"), 10) ||
                    0,
                opener,
            );
        });

        if (closeBtn) closeBtn.addEventListener("click", close);
        if (prevBtn)
            prevBtn.addEventListener("click", function () {
                show(current - 1);
            });
        if (nextBtn)
            nextBtn.addEventListener("click", function () {
                show(current + 1);
            });

        overlay.addEventListener("click", function (e) {
            if (e.target === overlay) close();
        });

        document.addEventListener("keydown", function (e) {
            if (!isOpen()) return;

            if (e.key === "Escape") {
                close();
                return;
            }

            if (e.key === "ArrowLeft") {
                show(current - 1);
                return;
            }
            if (e.key === "ArrowRight") {
                show(current + 1);
                return;
            }

            if (e.key !== "Tab") return;
            var focusable = panel.querySelectorAll(
                'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
            );
            if (!focusable.length) return;
            var first = focusable[0];
            var last = focusable[focusable.length - 1];

            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });
    })();
</script>
