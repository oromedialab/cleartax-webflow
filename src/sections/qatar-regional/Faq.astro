---
/**
 * FAQ for the Qatar regional page.
 *
 * Structure, styling and behaviour live in `_shared/FaqRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file,
 * because the embed route renders sections with no props.
 *
 * The Figma has no subtitle under the heading, so an empty one is passed —
 * `FaqRb` omits the paragraph when it is empty. Nine questions, first open,
 * remaining behind "Load more" after five.
 */
import FaqRb from "../_shared/FaqRb.astro";
import type { FaqItem } from "../_shared/FaqRb.astro";

const items: FaqItem[] = [
    {
        q: "What is the current status of e-invoicing in Qatar?",
        a: [
            {
                kind: "p",
                html: "The GTA has publicly discussed its e-invoicing project as part of digital transformation work. The June 2025 announcement is evidence of project activity, not a published nationwide mandate date. Check current GTA instructions for obligations applicable to your business.",
            },
        ],
    },
    {
        q: "Is there a confirmed nationwide e-invoicing deadline?",
        a: [
            {
                kind: "p",
                html: "The GTA sources reviewed so far don’t confirm a nationwide e-invoicing deadline. Before setting a go-live date, check the latest GTA updates or any instructions issued directly to your organisation.",
            },
        ],
    },
    {
        q: "Has Qatar implemented VAT?",
        a: [
            {
                kind: "p",
                html: "No. The GTA’s published investor guide states that Qatar has not applied Value Added Tax. Do not assume that invoice process changes introduce a VAT obligation.",
            },
        ],
    },
    {
        q: "Should we copy the e-invoicing setup used in another GCC country?",
        a: [
            {
                kind: "p",
                html: "Use your existing implementation experience as an input to planning, not as proof of Qatar’s requirements. Confirm the applicable Qatar instructions before selecting a format or submission workflow.",
            },
        ],
    },
    {
        q: "Which businesses and transactions will be covered?",
        a: [
            {
                kind: "p",
                html: "Nationwide coverage has not been confirmed. Check the latest official publications and any instructions issued directly to your organisation to understand which requirements apply to your business.",
            },
        ],
    },
    {
        q: "What can we prepare before detailed requirements are confirmed?",
        a: [
            {
                kind: "p",
                html: "Analyse your invoice flows, improve master data, identify manual handoffs and assign finance and IT owners. Keep the integration design flexible until the applicable requirements are confirmed.",
            },
        ],
    },
    {
        q: "Can we connect our ERP to ClearTax for Qatar?",
        a: [
            {
                kind: "p",
                html: "Discuss your ERP and invoice-flow requirements with the ClearTax team. Before implementation, clarify Qatar capability, integration options, testing requirements, and delivery scope.",
            },
        ],
    },
    {
        q: "Is ClearTax an approved Qatar e-invoicing provider?",
        a: [
            {
                kind: "p",
                html: "We do not claim GTA accreditation or approval. Please check the latest official GTA publications to verify the current status before relying on any such claim.",
            },
        ],
    },
    {
        q: "Does this page provide QFC-specific tax advice?",
        a: [
            {
                kind: "p",
                html: "No. This page covers Qatar e-invoicing readiness, not QFC-specific tax matters. For questions relating to QFC taxes, contact the QFC Tax Department.",
            },
        ],
    },
];
---

<FaqRb items={items} subtitle="" />

