---
const mandates = [
    {
        name: "KSA",
        status: "Live",
        flagUrl:
            "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5d917bc9a2a6b5bd4e_tax-live-ksa.png",
    },
    {
        name: "France",
        status: "Live 2026",
        flagUrl:
            "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5d567d2e2d1613e721_tax-live-france.png",
    },
    {
        name: "Germany",
        status: "Live 2027",
        flagUrl:
            "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5dc8e9320a2037eb0d_tax-live-germany.png",
    },
    {
        name: "Malaysia",
        status: "Live",
        flagUrl:
            "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5dd6a34ed2f49f885a_tax-live-malaysia.png",
    },
    {
        name: "Oman",
        status: "Live 2026",
        flagUrl:
            "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5ddfac4df487891014_tax-live-oman.png",
    },
    {
        name: "Poland",
        status: "Live 2026",
        flagUrl:
            "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5d22a81ad28a27d8ac_tax-live-poland.png",
    },
    {
        name: "Croatia",
        status: "Live",
        flagUrl:
            "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5dc05fbaba634a0995_tax-live-croatia.png",
    },
    {
        name: "UAE",
        status: "Live 2027",
        flagUrl:
            "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5dc761d4d31839b3d0_tax-live-uae.png",
    },
];

const Data = [
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad20722710181fdb42f9c70_svg-1.png",
        title: "Core business systems",
        desc: "SAP, Oracle, D365, Billing, POS, OMS, WMS",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad20731f579635fd95ef1f4_svg-3.png",
        title: "CUSTOMER DATA LAKES",
        desc: "Snowflake, Databricks",
    },
];

const Connector = [
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad2072c9bf608d04ca2110b_svg-2.png",
        title: "GOVERNMENT, BANKING & PAYMENTS",
        desc: "Tax portals, Bank feeds, Payment gateways",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad207452a34e104c800ee17_svg-4.png",
        title: "DOCUMENTS & MAIL",
        desc: "Excel, PDFs, Statements, Shared inboxes",
    },
];

// Dot counts per column, matching the Figma source exactly (wide near the card, tapering toward the hub).
const DOT_COUNTS = [12, 11, 10, 9, 8, 7, 5, 4];
const DOT_COLOR = "#A6C705";
---

<section
    class="int-integrate-section py-20 overflow-hidden bg-[linear-gradient(to_left,#FFFFFF_0%,rgba(242,241,240,0.25)_100%)]"
>
    <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
        <div class="text-center mb-8 lg:mb-12">
            <h2
                class="text-[length:var(--fs-h2)]! md:text-[length:var(--fs-h1)]! leading-[length:var(--lh-h2)]! md:leading-[length:var(--lh-h1)]! font-medium! max-w-190 mx-auto text-text-default! mb-4 m-0"
            >
                If Your Data Lives There, We <span
                    class="text-generic-100 bg-flux-lime px-1 rounded-lg"
                    >Connect</span
                > To it
            </h2>
            <p
                class="text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-lg)] sm:leading-[length:var(--lh-body-lg)] max-w-225 text-neutral-500 font-normal mx-auto font-body mb-6 text-center"
            >
                Your data sits in more places than one platform can reach.
                ClearTax pulls from all of them – core systems, data platforms,
                external portals, even the inbox – and delivers wherever it
                needs to land.
            </p>
        </div>

        <div
            class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:items-stretch gap-10"
        >
            <!-- Your System Column -->
            <div
                class="w-full flex flex-col justify-between gap-5 sm:min-h-0 lg:min-h-140 lg:w-67.25 shrink-0"
            >
                {
                    Data.map((item) => (
                        <div class="bg-generic-00 rounded-xl border border-neutral-300 py-6 px-4 h-full flex flex-col items-start max-h-50 w-full mx-auto">
                            <img
                                src={item.icon}
                                alt={item.title}
                                class="w-8 h-8 object-contain"
                            />
                            <h3 class="text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium mt-4 m-0">
                                {item.title}
                            </h3>
                            <p class="text-sm text-neutral-500 mt-2 m-0">
                                {item.desc}
                            </p>
                        </div>
                    ))
                }
            </div>

            <!-- Connector / Hub -->
            <div
                class="w-full lg:flex-1 lg:min-w-0 flex items-center justify-center overflow-hidden"
            >
                <div
                    class="flex flex-col lg:flex-row items-center justify-center gap-6 xl:gap-10"
                >
                    <!-- Desktop: wide column nearest the card, tapering toward the hub -->
                    <div class="hidden lg:flex items-center gap-6">
                        {
                            DOT_COUNTS.map((count) => (
                                <div class="flex flex-col items-center gap-5.5">
                                    {Array.from({ length: count }).map(() => (
                                        <span
                                            class="w-1 h-1 rounded-full shrink-0"
                                            style={`background-color:${DOT_COLOR}`}
                                        />
                                    ))}
                                </div>
                            ))
                        }
                    </div>
                    <!-- Mobile: wide row nearest the card above, tapering toward the hub below -->
                    <div class="flex lg:hidden flex-col items-center gap-6">
                        {
                            DOT_COUNTS.map((count) => (
                                <div class="flex flex-row items-center gap-5.5">
                                    {Array.from({ length: count }).map(() => (
                                        <span
                                            class="w-1 h-1 rounded-full shrink-0"
                                            style={`background-color:${DOT_COLOR}`}
                                        />
                                    ))}
                                </div>
                            ))
                        }
                    </div>

                    <!-- Global Unified API label + logo -->
                    <div class="flex flex-col items-center gap-2 shrink-0">
                        <img
                            src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c2363dbd39f65f659c31a_cleartax-logo.png"
                            alt="ClearTax"
                            class="h-8 lg:h-9 w-auto object-contain"
                            loading="lazy"
                            decoding="async"
                        />
                        <span
                            class="text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] text-vault-navy font-medium"
                            >one platform</span
                        >
                    </div>

                    <!-- Desktop: mirrored, so the wide column sits nearest the Tax Authorities card -->
                    <div class="hidden lg:flex items-center gap-6 scale-x-[-1]">
                        {
                            DOT_COUNTS.map((count) => (
                                <div class="flex flex-col items-center gap-5.5">
                                    {Array.from({ length: count }).map(() => (
                                        <span
                                            class="w-1 h-1 rounded-full shrink-0"
                                            style={`background-color:${DOT_COLOR}`}
                                        />
                                    ))}
                                </div>
                            ))
                        }
                    </div>
                    <!-- Mobile: mirrored, so the wide row sits nearest the Tax Authorities card below -->
                    <div
                        class="flex lg:hidden flex-col items-center gap-6 scale-y-[-1]"
                    >
                        {
                            DOT_COUNTS.map((count) => (
                                <div class="flex flex-row items-center gap-5.5">
                                    {Array.from({ length: count }).map(() => (
                                        <span
                                            class="w-1 h-1 rounded-full shrink-0"
                                            style={`background-color:${DOT_COLOR}`}
                                        />
                                    ))}
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- Tax Authorities Column -->
            <div
                class="w-full flex flex-col justify-between gap-5 sm:min-h-0 lg:min-h-140 lg:w-66.75 shrink-0"
            >
                {
                    Connector.map((item) => (
                        <div class="bg-generic-00 rounded-xl border border-neutral-300 py-6 px-4 h-full flex flex-col items-start max-h-50 w-full mx-auto">
                            <img
                                src={item.icon}
                                alt={item.title}
                                class="w-8 h-8 object-contain"
                            />
                            <h3 class="text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium mt-4 m-0">
                                {item.title}
                            </h3>
                            <p class="text-sm text-neutral-500 mt-2 m-0">
                                {item.desc}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
        <!-- Bottom Summary Banner -->
        <div
            class="max-w-7xl w-full mx-auto mt-8 lg:mt-12 bg-generic-00 rounded-xl border border-neutral-300 py-3.5 sm:py-4 px-6 sm:px-8 flex items-center justify-center xl:justify-between gap-4 sm:gap-6 md:gap-8 overflow-hidden"
        >
            <!-- Left Dots Pattern (11 top dots, 3 bottom dots closest to text) -->
            <svg
                class="hidden xl:block shrink-0"
                width="273"
                height="30"
                viewBox="0 0 273 30"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <circle cx="18.3599" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="43.5799" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="68.8001" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="94.0201" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="119.24" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="144.46" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="169.68" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="194.9" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="220.12" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="245.34" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="270.56" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="220.12" cy="27.16" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="245.34" cy="27.16" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="270.56" cy="27.16" r="1.94" fill="#EFEFEF"></circle>
            </svg>

            <!-- Centered Text -->
            <p
                class="m-0 text-center font-body text-vault-navy font-medium text-[length:var(--fs-body)] leading-[length:var(--lh-body)] lg:whitespace-nowrap xl:text-[length:var(--fs-h6)] xl:leading-[length:var(--lh-h6)] max-w-md lg:max-w-none"
            >
                100+ source systems connected today. One setup covers all of
                them.
            </p>

            <!-- Right Dots Pattern (11 top dots, 3 bottom dots closest to text) -->
            <svg
                class="hidden xl:block shrink-0"
                width="273"
                height="30"
                viewBox="0 0 273 30"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <circle cx="1.94" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="27.16" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="52.3799" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="77.5999" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="102.82" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="128.04" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="153.26" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="178.48" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="203.7" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="228.92" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="254.14" cy="1.94" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="1.94" cy="27.16" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="27.16" cy="27.16" r="1.94" fill="#EFEFEF"></circle>
                <circle cx="52.3799" cy="27.16" r="1.94" fill="#EFEFEF"
                ></circle>
            </svg>
        </div>
    </div>
</section>
