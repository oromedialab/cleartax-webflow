---
const erpLogos = [
    'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c03b3ca5a4e9c5f2a75dc_logo-mandate-1.png',
    'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c03b35e841506fe93ca61_logo-mandate-2.png',
    'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c03b3d1814377dfd2db31_logo-mandate-3.png',
    'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c03b3963e6b03d4317dfc_logo-mandate-4.png'
];

const mandates = [
    { name: 'KSA', status: 'Live', flagUrl: 'https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5d917bc9a2a6b5bd4e_tax-live-ksa.png' },
    { name: 'France', status: 'Live 2026', flagUrl: 'https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5d567d2e2d1613e721_tax-live-france.png' },
    { name: 'Germany', status: 'Live 2027', flagUrl: 'https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5dc8e9320a2037eb0d_tax-live-germany.png' },
    { name: 'Malaysia', status: 'Live', flagUrl: 'https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5dd6a34ed2f49f885a_tax-live-malaysia.png' },
    { name: 'Oman', status: 'Live 2026', flagUrl: 'https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5ddfac4df487891014_tax-live-oman.png' },
    { name: 'Poland', status: 'Live 2026', flagUrl: 'https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5d22a81ad28a27d8ac_tax-live-poland.png' },
    { name: 'Croatia', status: 'Live', flagUrl: 'https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5dc05fbaba634a0995_tax-live-croatia.png' },
    { name: 'UAE', status: 'Live 2027', flagUrl: 'https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb6c5dc761d4d31839b3d0_tax-live-uae.png' },
];

// Dot counts per column, matching the Figma source exactly (wide near the card, tapering toward the hub).
const DOT_COUNTS = [12, 11, 10, 9, 8, 7, 5, 4];
const DOT_COLOR = '#A6C705';
---
<section class="int-integrate-section bg-generic-00 py-20 overflow-hidden">
    <div class="min-[1400px]:max-w-[1328px] mx-auto px-4 md:px-6">
        <div class="text-center mb-8 lg:mb-12">
            <h2 class="text-[length:var(--fs-h2)]! md:text-[length:var(--fs-h1)]! leading-[length:var(--lh-h2)]! md:leading-[length:var(--lh-h1)]! font-medium! max-w-180 mx-auto text-text-default! mb-4 m-0">
              From ERP Data To <span class="text-generic-100 bg-flux-lime px-1 rounded-lg">Compliant E-Invoices</span>
            </h2>
            <p class="text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-lg)] sm:leading-[length:var(--lh-body-lg)] max-w-170 text-neutral-500 font-normal mx-auto font-body mb-6 text-center">GL Stream reads your ERP data, sends it securely to ClearTax, and converts it into the required compliance-ready format. </p>
        </div>

        <div class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:items-stretch gap-10">
            <!-- Your System Column -->
            <div class="w-full lg:w-67.25 shrink-0">
                <div class="bg-generic-00 rounded-xl border-2 border-neutral-300 p-6 h-full flex flex-col items-center gap-3 max-w-120 w-full mx-auto">
                    <h3 class="text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium m-0">Your System</h3>
                    <div class="flex-1 min-h-0 w-full flex flex-col gap-4 md:gap-4">
                        {erpLogos.map((logo, i) => (
                            <div class="flex-1 min-h-0 bg-generic-00 rounded-lg border border-neutral-300 flex items-center justify-center px-4 py-3">
                                <img src={logo} alt={`ERP Logo ${i + 1}`} class="max-h-9 w-auto object-contain" loading="lazy" decoding="async" />
                            </div>
                        ))}
                        <div class="flex-1 min-h-0 bg-generic-00 rounded-lg border border-nova-blue flex items-center justify-center px-4 py-3">
                            <div class="w-5 h-5 rounded-full bg-nova-blue flex items-center justify-center">
                                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M5 1V9M1 5H9" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Connector / Hub -->
            <div class="w-full lg:flex-1 lg:min-w-0 flex items-center justify-center overflow-hidden">
                <div class="flex flex-col lg:flex-row items-center justify-center gap-6 xl:gap-10">
                    <!-- Desktop: wide column nearest the card, tapering toward the hub -->
                    <div class="hidden lg:flex items-center gap-6">
                        {DOT_COUNTS.map((count) => (
                            <div class="flex flex-col items-center gap-5.5">
                                {Array.from({ length: count }).map(() => (
                                    <span class="w-1 h-1 rounded-full shrink-0" style={`background-color:${DOT_COLOR}`}></span>
                                ))}
                            </div>
                        ))}
                    </div>
                    <!-- Mobile: wide row nearest the card above, tapering toward the hub below -->
                    <div class="flex lg:hidden flex-col items-center gap-6">
                        {DOT_COUNTS.map((count) => (
                            <div class="flex flex-row items-center gap-5.5">
                                {Array.from({ length: count }).map(() => (
                                    <span class="w-1 h-1 rounded-full shrink-0" style={`background-color:${DOT_COLOR}`}></span>
                                ))}
                            </div>
                        ))}
                    </div>

                    <!-- Global Unified API label + logo -->
                    <div class="flex flex-col items-center gap-2 shrink-0">
                        <span class="text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] text-vault-navy font-medium">GL Stream</span>
                        <img
                            src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c2363dbd39f65f659c31a_cleartax-logo.png"
                            alt="ClearTax"
                            class="h-8 lg:h-9 w-auto object-contain"
                            loading="lazy"
                            decoding="async"
                        />
                    </div>

                    <!-- Desktop: mirrored, so the wide column sits nearest the Tax Authorities card -->
                    <div class="hidden lg:flex items-center gap-6 scale-x-[-1]">
                        {DOT_COUNTS.map((count) => (
                            <div class="flex flex-col items-center gap-5.5">
                                {Array.from({ length: count }).map(() => (
                                    <span class="w-1 h-1 rounded-full shrink-0" style={`background-color:${DOT_COLOR}`}></span>
                                ))}
                            </div>
                        ))}
                    </div>
                    <!-- Mobile: mirrored, so the wide row sits nearest the Tax Authorities card below -->
                    <div class="flex lg:hidden flex-col items-center gap-6 scale-y-[-1]">
                        {DOT_COUNTS.map((count) => (
                            <div class="flex flex-row items-center gap-5.5">
                                {Array.from({ length: count }).map(() => (
                                    <span class="w-1 h-1 rounded-full shrink-0" style={`background-color:${DOT_COLOR}`}></span>
                                ))}
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Tax Authorities Column -->
            <div class="w-full lg:w-66.75 shrink-0">
                <div class="bg-visual-placeholder rounded-xl border-2 border-neutral-300 p-5 h-full flex flex-col items-center max-w-120 w-full mx-auto">
                </div>
            </div>
        </div>

    </div>
</section>
