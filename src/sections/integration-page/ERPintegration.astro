---
/**
 * ERP Integration section for Integration page.
 * Implements isolated sticky horizontal scroll container matching Figma specs (628x512 cards),
 * clean vertical rhythm, single-line titles, and responsive handling.
 */

const cards = [
    {
        title: "Fast, non-disruptive setup",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad20a9dc03b6a7ad0122195_icons-1.png",
        desc: "Connect SAP, Microsoft Dynamics, or other systems without changing existing workflows.",
    },
    {
        title: "Updates managed automatically",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad20aa178f7b0b7f077717d_icons-2.png",
        desc: "ClearTax manages rule changes, so your system connection stays intact.",
    },
    {
        title: "Zero IT dependency",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad20aa6c277e4f2b41bc48b_icons-3.png",
        desc: "AI-assisted mapping reduces setup effort and speeds up go-live.",
    },
    {
        title: "One integration, any geography",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad20aac0d9d2e9840a60fea_icons-4.png",
        desc: "Use one ClearTax setup across all supported geographies.",
    },
];
---

<div class="erp-sticky-container">
    <section
        class="sticky top-0 flex flex-col justify-center bg-generic-00 py-12 md:py-16 xl:py-20 overflow-hidden min-h-[calc(100vh-80px)]"
    >
        <div class="max-w-[var(--container-max)] mx-auto w-full px-4 md:px-6">
            <!-- Header -->
            <div class="erp-header-wrapper text-center mx-auto mb-8 md:mb-12">
                <h2
                    class="erp-section-title font-heading font-medium text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] text-text-default max-w-216 mx-auto mb-3 sm:mb-4 m-0"
                >
                    Built For Fast, Low-Effort System Integration
                </h2>
                <p
                    class="erp-section-desc font-body font-normal text-neutral-500 text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] max-w-148 mx-auto m-0"
                >
                    ClearTax removes the usual complexity of compliance
                    integrations – from IT dependency to country-wise rework.
                </p>
            </div>

            <!-- Cards Track -->
            <div class="w-full h-auto">
                <div
                    class="erp-scroll-track flex items-stretch gap-6 w-max transition-transform duration-[250ms] ease-out will-change-transform"
                >
                    {
                        cards.map((item) => (
                            <div class="erp-card-item bg-generic-00 rounded-2xl p-6 sm:p-7 lg:p-8 w-[calc(100vw-32px)] sm:w-[500px] md:w-[560px] lg:w-[628px] h-[460px] sm:h-[480px] lg:h-[512px] shrink-0 flex flex-col justify-between border border-neutral-300 rounded-xl select-none">
                                <h3 class="erp-card-title font-heading text-[22px] sm:text-[24px] lg:text-[26px] leading-[1.3] font-medium text-text-default pointer-events-none m-0">
                                    {item.title}
                                </h3>
                                <div class="w-full h-[270px] sm:h-[290px] lg:h-[316px] rounded-xl overflow-hidden flex items-center justify-center my-auto pointer-events-none">
                                    <img
                                        class="w-full h-full object-contain"
                                        src={item.img}
                                        alt={item.title}
                                    />
                                </div>
                                <p class="erp-card-desc font-body text-neutral-500 font-normal text-sm lg:text-[15px] leading-relaxed max-w-[540px] pointer-events-none m-0">
                                    {item.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>
</div>

<style is:global>
    @media (max-height: 750px) {
        .erp-sticky-container section {
            padding-top: var(--spacing-big, 1.25rem) !important;
            padding-bottom: var(--spacing-big, 1.25rem) !important;
        }
        .erp-header-wrapper {
            margin-bottom: var(--spacing-md, 1rem) !important;
        }
        .erp-card-item {
            padding: var(--spacing-x-big, 1.25rem) !important;
            height: 400px !important;
            min-height: 420px !important;
            max-width: calc(100vw - 32px) !important;
        }
        @media (min-width: 768px) {
            .erp-card-item {
                width: 520px !important;
                height: 460px !important;
                min-height: 440px !important;
            }
        }
        .erp-card-title {
            font-size: var(--fs-h5, 22px) !important;
            line-height: var(--lh-h5, 28px) !important;
        }
        .erp-card-desc {
            font-size: var(--fs-body-sm, 14px) !important;
            line-height: var(--lh-body-sm, 20px) !important;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const containers = document.querySelectorAll(".erp-sticky-container");
        if (!containers.length) return;

        containers.forEach((container) => {
            const track = container.querySelector(".erp-scroll-track");
            const section = container.querySelector("section");
            if (!container || !track || !section) return;

            const getHeaderHeight = () => {
                const header = document.querySelector(
                    "header, .navbar, .w-nav",
                );
                return header ? header.offsetHeight : 80;
            };

            let maxTranslate = 0;
            let totalScrollable = 0;
            let stickyTop = 0;

            const updateMeasurements = () => {
                const sectionHeight = section.offsetHeight;
                const windowHeight = window.innerHeight;
                const headerHeight = getHeaderHeight();

                const trackOffset =
                    track.parentElement.getBoundingClientRect().top -
                    section.getBoundingClientRect().top;
                const trackHeight = track.offsetHeight;
                const availableSpace = windowHeight - headerHeight;

                const idealTrackTop =
                    headerHeight +
                    Math.max(40, (availableSpace - trackHeight) / 2);
                let calculatedTop = idealTrackTop - trackOffset;

                // Position section flush under header when sticky, avoiding gap on large screens
                stickyTop = Math.min(headerHeight, calculatedTop);
                section.style.top = `${stickyTop}px`;

                const containerWidth =
                    track.parentElement.getBoundingClientRect().width;
                maxTranslate = Math.max(0, track.scrollWidth - containerWidth);
                container.style.height = `${maxTranslate + windowHeight}px`;
                totalScrollable =
                    container.getBoundingClientRect().height - sectionHeight;
            };

            updateMeasurements();

            if (window.ResizeObserver) {
                const ro = new ResizeObserver(updateMeasurements);
                ro.observe(section);
                ro.observe(track);
            }
            window.addEventListener("resize", updateMeasurements);

            let ticking = false;

            const handleScroll = () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const containerRect = container.getBoundingClientRect();
                        const scrolledDistance = Math.max(
                            0,
                            stickyTop - containerRect.top,
                        );

                        let progress =
                            totalScrollable > 0
                                ? scrolledDistance / totalScrollable
                                : 0;
                        progress = Math.max(0, Math.min(1, progress));

                        track.style.transform = `translate3d(-${progress * maxTranslate}px, 0, 0)`;

                        ticking = false;
                    });
                    ticking = true;
                }
            };

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            window.addEventListener("scroll", handleScroll, {
                                passive: true,
                            });
                            handleScroll();
                        } else {
                            window.removeEventListener("scroll", handleScroll);
                        }
                    });
                },
                {
                    rootMargin: "100% 0px 100% 0px",
                },
            );

            observer.observe(container);
        });
    });
</script>
