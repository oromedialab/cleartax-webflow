---
const DataPoints = [
    {
        icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9e9654857beeed95f30ab7_icon-1.png',
        title: 'One-time install',
        desc: 'IT approves once. Automation runs after go-live.'
    },
    {
        icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9e965a20c0bdeae56e77a5_icon-2.png',
        title: 'Expand globally',
        desc: 'One connection supports every country.'
    },
    {
        icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9e9660c3224e1df0b3f0cd_icon-3.png',
        title: 'Go live faster',
        desc: 'AI-assisted mapping helps reduce setup from weeks to days.'
    },
    {
        icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9e966b2036a65f6202b82c_icon-4.png',
        title: 'We handle updates',
        desc: 'Rule changes are managed by us, not your ERP.'
    }
];

const BLUE_DOT_ROWS = [8, 8, 16, 16, 24, 24, 24];
---

<section class="bg-generic-00 py-16 md:py-24 border-t border-neutral-200/80">
    <div class="mx-auto w-full min-[1400px]:max-w-[1328px] px-4 md:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
            
            <!-- Left Column: Title, Description & Dot Matrix -->
            <div class="lg:col-span-6 xl:col-span-6 flex flex-col h-full justify-between">
                <div>
                    <h2 class="text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-text-default mb-4 md:mb-6">
                        Your ERP Stays Untouched.
                    </h2>
                    <p class="text-neutral-500 font-normal text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] max-w-[460px]">
                        GL Stream sits between your ERP and ClearTax to read invoice data, transform it for compliance, and submit it to tax authorities – without ongoing IT effort.
                    </p>
                </div>

                <!-- Blue Dot Matrix -->
                <div class="hidden lg:flex flex-col gap-3.5 select-none mt-auto">
                    {BLUE_DOT_ROWS.map((count) => (
                        <div class="flex items-center gap-3.5">
                            {Array.from({ length: count }).map(() => (
                                <span class="w-1 h-1 rounded-full bg-nova-blue shrink-0 inline-block aspect-square" />
                            ))}
                        </div>
                    ))}
                </div>
            </div>

            <!-- Right Column: 2x2 Feature Grid -->
            <div class="lg:col-span-6 xl:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-12 md:gap-x-12 md:gap-y-14">
                {DataPoints.map((item) => (
                    <div class="flex flex-col items-start h-full min-h-[160px]">
                        <div class="w-10 h-10">
                        <img 
                            src={item.icon} 
                            alt={item.title} 
                            class="w-full h-full object-contain" 
                            loading="lazy" 
                            decoding="async" 
                        />
                        </div>
                        <div class="flex flex-col mt-auto">
                            <h3 class="text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] font-medium text-text-default mb-2">
                                {item.title}
                            </h3>
                            <p class="text-vault-navy/70 font-normal text-[length:var(--fs-body)] leading-[length:var(--lh-body)] max-w-[280px]">
                                {item.desc}
                            </p>
                        </div>
                    </div>
                ))}
            </div>

        </div>
    </div>
</section>