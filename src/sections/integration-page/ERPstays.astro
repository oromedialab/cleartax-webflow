---
const DataPoints = [
    {
        icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa1556c3a678980e8e77f9c_icon-1.png',
        title: 'One-time install',
        desc: 'IT approves once. Automation runs after go-live.'
    },
    {
        icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9e965a20c0bdeae56e77a5_icon-2.png',
        title: 'Expand globally',
        desc: 'One connection supports every country.'
    },
    {
        icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9e9660c3224e1df0b3f0cd_icon-3.png',
        title: 'Go live faster',
        desc: 'AI-assisted mapping helps reduce setup from weeks to days.'
    },
    {
        icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a9e966b2036a65f6202b82c_icon-4.png',
        title: 'We handle updates',
        desc: 'Rule changes are managed by us, not your ERP.'
    }
];

---

<section class="bg-generic-00 py-16 md:py-24 border-t border-neutral-200/80">
    <div class="mx-auto w-full min-[1400px]:max-w-[1328px] px-4 md:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
            
            <!-- Left Column: Title, Description & Dot Matrix -->
            <div class="lg:col-span-6 xl:col-span-6 flex flex-col h-full justify-between max-lg:items-center max-lg:text-center">
                <div class="max-lg:flex max-lg:flex-col max-lg:items-center max-lg:text-center">
                    <h2 class="text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-text-default mb-4 md:mb-6 max-lg:text-center">
                        Your ERP Stays Untouched.
                    </h2>
                    <p class="text-neutral-500 font-normal text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-lg)] sm:leading-[length:var(--lh-body-lg)] max-w-[460px] max-lg:mx-auto max-lg:text-center">
                        GL Stream sits between your ERP and ClearTax to read invoice data, transform it for compliance, and submit it to tax authorities – without ongoing IT effort.
                    </p>
                </div>

                <!-- Blue Dot Matrix -->
