---
/**
 * Philippines Product: "Non-compliance isn't a technicality" (NonCompliance / Risk Assessment)
 * 3-Column card highlighting Audit & Penalty Risk, Technology Risk, and Scalability Risk.
 */
interface RiskItem {
    riskNumber: string;
    title: string;
    description: string;
}

const risks: RiskItem[] = [
    {
        riskNumber: "Risk 1",
        title: "Audit & Penalty Risk",
        description:
            "The BIR lifted its audit suspension, and tax authorities will automatically cross-reference EIS transmission data against VAT returns. Gaps surface as notices. Businesses that haven't integrated by December 2026 will be the first ones flagged.",
    },
    {
        riskNumber: "Risk 2",
        title: "Technology Risk",
        description:
            "E-invoicing regulations evolve significantly after go-live. Without a purpose-built compliance platform, every regulatory update becomes an IT project. Patchwork integrations break exactly when you need them most.",
    },
    {
        riskNumber: "Risk 3",
        title: "Scalability Risk",
        description:
            "If your business operates across multiple countries, each new mandate across countries multiplies complexity. Creating custom integrations per market drives up development costs. Choose a scalable platform designed for future mandates.",
    },
];
---

<section id="non-compliance" class="bg-generic-00 py-16 lg:py-20">
    <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-10 md:gap-12">
        <!-- Header: Title & Subtitle -->
        <div class="flex flex-col items-center gap-4 text-center">
            <h2 class="m-0 font-heading font-medium max-w-[653px] text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] tracking-[-0.5px]">
                Non-compliance isn't a technicality. It's a financial and
                operational liability.
            </h2>
            <p class="m-0 max-w-[968px] font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                Countries like India, Saudi Arabia, Malaysia, and France all
                went through this transition. The lesson every CFO took away:
                the risks arrive before you expect them, and they compound fast.
                The Philippines is following the same playbook.
            </p>
        </div>

        <!-- 3-Column Risk Card with Orange Border -->
        <div class="w-full rounded-2xl border border-[#ff8000] bg-generic-00 p-6 lg:p-8">
            <div class="flex flex-col md:flex-row items-stretch">
                {risks.map((risk, index) => (
                    <>
                        {index > 0 && (
                            <>
                                {/* Desktop vertical divider */}
                                <div
                                    class="hidden md:block w-px bg-neutral-200 mx-6 lg:mx-8 shrink-0 self-stretch"
                                    aria-hidden="true"
                                />
                                {/* Mobile horizontal divider */}
                                <div
                                    class="block md:hidden h-px bg-neutral-200 w-full my-6 shrink-0"
                                    aria-hidden="true"
                                />
                            </>
                        )}
                        <div class="flex-1 flex flex-col items-start text-left">
                            <span class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h4)] leading-[length:var(--lh-h4)] mb-3">
                                {risk.riskNumber}
                            </span>
                            <h3 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] mb-3">
                                {risk.title}
                            </h3>
                            <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                                {risk.description}
                            </p>
                        </div>
                    </>
                ))}
            </div>
        </div>
    </div>
</section>
