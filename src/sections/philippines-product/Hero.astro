---
/**
 * Hero section for Indirect Tax page.
 * Uses interactive Dotgrid in Flux Lime with high-contrast radial wash,
 * brand typography, and tailored copy.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

interface Props {
    lineWidth?: number;
    gap?: number;
    maxLength?: number;
    lengthRadius?: number;
    tilt?: number;
    baseColor?: string;
    cursorRadius?: number;
    pull?: number;
    fadeRadius?: number;
    titlePrefix?: string;
    titleHighlight?: string;
    titleSuffix?: string;
    description?: string;
}

const {
    lineWidth = 3,
    gap = 24,
    maxLength = 6,
    lengthRadius = 260,
    tilt = 1,
    baseColor = "#C8F006",
    cursorRadius = 320,
    pull = 14,
    fadeRadius = 40,
    titlePrefix = "Want an EIS",
    titleHighlight = "readiness",
    titleSuffix = "walkthrough for your business?",
    description = "ClearTax converts your ERP invoice data into BIR-compliant structured JSON, transmits data to the EIS, and keeps your business audit-ready;  automatically.",
} = Astro.props;

const badges = [
    {
        value: "100% compliant with the Philippines",
        label: "Electronic Invoicing/Receipting System (EIS)",
    },
    {
        value: "AI-powered integration",
        label: "with any ERP or POS system",
    },
    {
        value: "Single unified Global e-Invoicing API,",
        label: "supporting 50+ country mandates",
    },
];
---

<section
    class="de-hero-section relative bg-generic-00 overflow-hidden flex flex-col max-lg:pt-32 max-lg:pb-16 lg:pt-[257px] lg:pb-[161px]"
    id="hero"
>
    <!-- Interactive Dot Grid Background -->
    <Dotgrid
        containerId="hero"
        lineWidth={lineWidth}
        gap={gap}
        maxLength={maxLength}
        lengthRadius={lengthRadius}
        tilt={tilt}
        baseColor={baseColor}
        cursorRadius={cursorRadius}
        pull={pull}
        fadeRadius={fadeRadius}
    />

    <!-- Radial wash, so the headline keeps its contrast over the field -->
    <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"></div>

    <div class="relative z-10 mx-auto lg:container w-full h-full flex flex-col px-4 md:px-6 pointer-events-auto">
        <div class="flex justify-center w-full h-full">
            <!-- Hero Content -->
            <div class="hero-content flex flex-col items-center mx-auto text-center w-full h-full">
                <!-- Headline -->
                <h1 class="text-[length:var(--fs-h1)] sm:text-[length:var(--fs-display-sm)] lg:text-[length:var(--fs-display-lg)] leading-[length:var(--lh-h1)] sm:leading-[length:var(--lh-display-sm)] lg:leading-[length:var(--lh-display-lg)] text-generic-100 font-semibold font-heading max-w-223 mx-auto mb-4 m-0 text-center">
                    {titlePrefix}
                    {titleHighlight && (
                        <span class="text-generic-100 bg-flux-lime partner-hero-mark rounded-lg">
                            {titleHighlight}
                        </span>
                    )}
                    {titleSuffix}
                </h1>

                <!-- Description -->
                <p class="text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-base)] sm:leading-[length:var(--lh-body-lg)] max-w-184 text-neutral-500 font-medium font-body text-center">
                    {description}
                </p>
                <ul
                    aria-label="Germany e-invoicing highlights"
                    class="m-0 mt-4 lg:mt-8 flex w-full max-w-[1100px] list-none flex-col overflow-hidden rounded-xl border border-neutral-300 bg-generic-00 p-0 md:flex-row"
                >
                    {badges.map((badge, index) => (
                        <>
                            {index > 0 && (
                                <li
                                    aria-hidden="true"
                                    class="h-px w-auto bg-neutral-100 max-md:mx-4 md:h-[60px] md:w-[2px] md:shrink-0 md:self-center"
                                />
                            )}
