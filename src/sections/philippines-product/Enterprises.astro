---

---

<section class="py-20 lg:py-25 bg-[#F3F1F9]">
    <div class="lg:container mx-auto px-4">
        <div class="text-center mb-12">
            <h2
                class="text-[26px] md:text-[36px] lg:text-[44px] max-w-189 mx-auto font-semibold text-[#000000] leading-[1.18] m-0"
            >
                100+ clients in the EU.
                <span class="block text-[#655DFF]"
                    >5,000+ enterprises worldwide.</span
                >
            </h2>
            <p
                class="text-base md:text-[18px] text-[#000000]/80 mt-4 max-w-170 mx-auto leading-[1.5]"
            >
                From global conglomerates to EU-headquartered enterprises,
                finance teams trust ClearTax to keep them compliant, across
                every mandate, in every market.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-6 gap-5">
            <!-- Card 1: Peppol BIS 3.0 -->
            <div
                class="group flex flex-row items-center bg-[#E7E2F3] gap-5 rounded-[14px] min-h-[160px] p-8 border border-[#0F0E13]/[0.06] shadow-sm hover:shadow-md transition-all duration-300 md:col-span-2"
            >
                <div
                    class="w-24 h-16 flex-shrink-0 flex items-center justify-center"
                >
                    <img
                        src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a3a44f0e2e7d26264cc5505_logo-2.png"
                        alt="Peppol BIS 3.0"
                        class="max-h-[80px] max-w-[80px] w-auto h-auto object-contain"
                    />
                </div>
                <div class="items-center w-full">
                    <h3 class="text-lg font-medium text-black mb-3">
                        Peppol BIS 3.0
                    </h3>
                    <p class="text-lg font-normal text-black leading-[1.5]">
                        Fully Peppol BIS 3.0 compliant.
                    </p>
                </div>
            </div>

            <!-- Card 2: ISO 27001:2022 -->
            <div
                class="group flex flex-row items-center bg-[#E7E2F3] gap-5 rounded-[14px] min-h-[160px] p-8 border border-[#0F0E13]/[0.06] shadow-sm hover:shadow-md transition-all duration-300 md:col-span-2"
            >
                <div
                    class="w-24 h-16 flex-shrink-0 flex items-center justify-center"
                >
                    <img
                        src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a3a44f85ca6a21f4da3745c_logo-3.png"
                        alt="ISO 27001:2022"
                        class="max-h-[80px] max-w-[102px] w-auto h-auto object-contain"
                    />
                </div>
                <div class="items-center w-full">
                    <h3 class="text-lg font-medium text-black mb-3">
                        ISO 27001:2022
                    </h3>
                    <p class="text-lg font-normal text-black leading-[1.5]">
                        Certified information security management.
                    </p>
                </div>
            </div>

            <!-- Card 3: SOC 2 Type II -->
            <div
                class="group flex flex-row items-center bg-[#E7E2F3] gap-5 rounded-[14px] min-h-[160px] p-8 border border-[#0F0E13]/[0.06] shadow-sm hover:shadow-md transition-all duration-300 md:col-span-2"
            >
                <div
                    class="w-24 h-16 flex-shrink-0 flex items-center justify-center"
                >
                    <img
                        src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a3a45006078291fafc211bc_logo-4.png"
                        alt="SOC 2 Type II"
                        class="max-h-[80px] max-w-[80px] w-auto h-auto object-contain"
                    />
                </div>
                <div class="items-center w-full">
                    <h3 class="text-lg font-medium text-black mb-3">
                        SOC 2 Type II
                    </h3>
                    <p class="text-lg font-normal text-black leading-[1.5]">
                        Independently audited security & availability.
                    </p>
                </div>
            </div>

            <!-- Card 4: BIR EIS Compliance -->
            <div
                class="group flex flex-row items-center bg-[#E7E2F3] gap-5 rounded-[14px] min-h-[160px] p-8 border border-[#0F0E13]/[0.06] shadow-sm hover:shadow-md transition-all duration-300 md:col-span-3"
            >
                <div
                    class="w-24 h-16 flex-shrink-0 flex items-center justify-center"
                >
                    <img
                        src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a3a44e648916bf40cbc2b5a_logo-1.png"
                        alt="BIR EIS Compliance"
                        class="max-h-[90px] max-w-[80px] w-auto h-auto object-contain"
                    />
                </div>
                <div class="items-center w-full">
                    <h3 class="text-lg font-medium text-black mb-3">
                        BIR EIS Compliance
                    </h3>
                    <p class="text-lg font-normal text-black leading-[1.5]">
                        100% compliant with the Philippines e-invoicing mandate.
                    </p>
                </div>
            </div>

            <!-- Card 5: Peppol Access Point -->
            <div
                class="group flex flex-row items-center bg-[#E7E2F3] gap-5 rounded-[14px] min-h-[160px] p-8 border border-[#0F0E13]/[0.06] shadow-sm hover:shadow-md transition-all duration-300 md:col-span-3"
            >
                <div
                    class="w-24 h-16 flex-shrink-0 flex items-center justify-center"
                >
                    <img
                        src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a3a44f0e2e7d26264cc5505_logo-2.png"
                        alt="Peppol Access Point"
                        class="max-h-[80px] max-w-[80px] w-auto h-auto object-contain"
                    />
                </div>
                <div class="items-center w-full">
                    <h3 class="text-lg font-medium text-black mb-3">
                        Peppol Access Point
                    </h3>
                    <p class="text-lg font-normal text-black leading-[1.5]">
                        for compliant e-invoicing exchange.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
