---
/**
 * "Here's what should be on your list right now" — Figma node 18261:64970
 * ("Fold 14").
 *
 * Three equal outlined cards: a 48px icon placeholder over the title, then a
 * list whose items are separated by hairline dividers. The 48px squares are
 * the Figma's unfilled icon placeholders — swap for Webflow-hosted assets once
 * the icons exist, never a `data:` URI.
 */
interface Card {
  title: string;
  items: string[];
}

const cards: Card[] = [
  {
    title: "System readiness",
    items: [
      "Identify every system that generates sales invoices — ERP, POS, billing, e-commerce, subscriptions",
      "Run a gap analysis on missing data fields — buyer TRN, item classification, tax category codes",
      "Assess the impact on upstream master data (customer, item, tax) and downstream reporting",
    ],
  },
  {
    title: "Compliance",
    items: [
      "Review NBR's compliance requirements as soon as the technical spec is published",
      "Assess the impact on invoice numbering, cancellations and credit-note workflows",
      "If engaging a third-party provider, plan for the NDA with NBR before receiving pilot materials",
    ],
  },
  {
    title: "Team & timeline",
    items: [
      "Assign a team spanning finance, IT and a business sponsor to own this change",
      "Have a compliant solution live before pilot readiness closes at end of August 2026",
    ],
  },
];
---

<section class="bg-generic-00 py-12 lg:py-[100px]">
  <div class="container mx-auto">
    <div class="flex flex-col items-center gap-12">
      <div class="flex flex-col items-center gap-4 text-center">
        <h2
          class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
        >
          Here's what should be on your list right now
        </h2>
        <p
          class="m-0 max-w-[666px] font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
        >
          Both remaining NBR deadlines fall in the next few weeks. This is the
          checklist ClearTax runs through with every Bahrain customer.
        </p>
      </div>

      <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-3">
        {
          cards.map((card) => (
            <div class="flex flex-col gap-8 rounded-xl border border-neutral-300 p-8">
              <div class="flex flex-col justify-center gap-4">
                <span
                  class="block h-12 w-12 shrink-0 rounded-md bg-visual-placeholder"
                  aria-hidden="true"
                />
                <h3 class="m-0 font-heading font-normal text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">
                  {card.title}
                </h3>
              </div>
              <ul class="m-0 flex list-none flex-col gap-6 p-0">
                {
                  card.items.map((item, i) => (
                    <li
                      class:list={[
                        "font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]",
                        i < card.items.length - 1 &&
                          "border-b border-neutral-300 pb-6",
                      ]}
                    >
                      {item}
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
