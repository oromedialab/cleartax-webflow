---
/**
 * "Saudi Arabia e-invoicing at a glance" — Figma node 18377:72678. Heading and lede,
 * then a 2x2 grid of cards that each carry a plus control.
 *
 * A card is a button: clicking it opens ONE overlay dialog showing that card's
 * heading and body, with prev/next chevrons to walk the other three without
 * closing. Pattern and mechanics copied from `spain-regional/Supports.astro`;
 * the overlay renders its layout once and swaps only the heading / body /
 * visual that differ per card.
 *
 * The Figma shows the cards collapsed only, so the body copy is drafted from the
 * FAQ and steps on this page. Review with content before staging.
 *
 * The card icons and the overlay visual are unfilled placeholder frames in the
 * Figma, so they render as `bg-visual-placeholder` (#E8FFE1). Swap for
 * Webflow-hosted artwork when it lands — never a `data:` URI.
 *
 * Ids and data attributes are `ksa-glance-` prefixed: embeds share one
 * namespace per page.
 */
interface Card {
  heading: string;
  img: string;
  image?: string;
  bullets: string[];
}

const cards: Card[] = [
  {
    heading: "Structured XML, not PDFs",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aec914d818a73f351a82eae_icon-1.png",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af18dcb1e3dcbcb1654b45e_ksa-img-1.png",
    bullets: [
      "Every tax invoice, credit & debit note must be generated in UBL 2.1 XML (or PDF/A-3 with XML embedded), in Arabic, from a ZATCA-compliant solution.",
      "Each needs UUID, QR code & a cryptographic stamp & is chained to previous invoice by its hash. Handwritten, Word or Excel invoices are not valid.",
    ],
  },
  {
    heading: "Clearance for B2B, reporting for B2C",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac776e909e9bc8ba8a13933_icon-5.png",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af18dd65b34a2ad9b7a23f2_ksa-img-2.png",
    bullets: [
      "Standard (B2B & B2G) invoices go to Fatoora for real-time clearance; ZATCA validates & stamps them before you can share them with your buyer.",
      "Simplified (B2C) invoices are issued at the till & reported to ZATCA within 24hrs. Invoices that fails is not a valid tax invoice, so your buyer can't claim the input VAT.",
    ],
  },
  {
    heading: "Onboard every invoicing device",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1752b9ef6174e2d084604_ksa-icon-3.png",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af18dda6b21085c30567754_ksa-img-3.png",
    bullets: [
      "Each ERP, billing system or POS that issues invoices must be onboarded to Fatoora and hold its own Cryptographic Stamp Identifier (CSID).",
      "Groups with many branches, tills and systems need to onboard, renew and track every one.",
    ],
  },
  {
    heading: "Keep up with rule changes",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1752faf24c8e93a253fae_ksa-icon-4.png",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af18dde364311ae81d80724_ksa-img-4.png",
    bullets: [
      "ZATCA updates its SDK & validation rules regularly. Recent changes added B2G invoice flags, continuous-supply identification & mandatory contract ID for B2G invoices (BR-KSA-92).",
      "Archive every invoice inside Saudi Arabia for at least six years.",
    ],
  },
];
---

<section class="bg-generic-00 pt-16 pb-12 lg:pt-20">
  <div
    class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12"
  >
    <div class="flex flex-col items-center gap-6 text-center">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        Saudi Arabia e-invoicing at a glance
      </h2>
      <p
        class="m-0 max-w-[916px] font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]"
      >
        Since 4 December 2021, every VAT-registered business in Saudi Arabia
        must issue invoices from a compliant electronic solution. Under Phase 2,
        those systems connect to ZATCA's Fatoora platform: B2B and B2G invoices
        must be cleared by ZATCA before they reach the buyer, and B2C invoices
        must be reported within 24 hours. ZATCA has rolled this out in waves
        since January 2023, and Wave 25 now reaches businesses with revenue
        above SAR 187,500.
      </p>
    </div>

    <div
      class="grid w-full max-w-[1280px] mx-auto grid-cols-1 md:grid-cols-2 gap-6 items-start"
    >
      {
        cards.map((card, i) => {
          const isDefaultOpen = i === 0 || i === 1;
          return (
            <div
              class="group/card flex flex-col rounded-xl border border-neutral-300 w-full bg-generic-00 overflow-hidden"
              data-ksa-glance-card={i}
            >
              <button
                type="button"
                class={`group flex w-full cursor-pointer items-center justify-between gap-4 p-5 sm:p-6 text-left transition-all duration-150 ease-in-out bg-generic-00 border-0 outline-none focus:outline-none ${isDefaultOpen ? "pb-3 sm:pb-4" : ""}`}
                data-ksa-glance-toggle={i}
                aria-expanded={isDefaultOpen ? "true" : "false"}
              >
                <img
                  src={card.img}
                  alt=""
                  height="56"
                  width="56"
                  loading="lazy"
                  class="shrink-0 h-14 w-14 object-contain rounded-lg"
                />
                <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                  {card.heading}
                </span>
                <span
                  class="flex h-10 w-10 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-lg text-vault-navy transition-transform duration-200 ease-in-out"
                  data-ksa-glance-icon={i}
                  style={
                    isDefaultOpen
                      ? "transform: rotate(45deg);"
                      : "transform: rotate(0deg);"
                  }
                  aria-hidden="true"
                >
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    class="h-6 w-6 sm:h-7 sm:w-7"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M12 5V19"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M5 12H19"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </button>

              <div
                class="grid overflow-hidden transition-[grid-template-rows,opacity] duration-300 ease-out border-0 flex-1"
                style={
                  isDefaultOpen
                    ? "grid-template-rows: 1fr; opacity: 1;"
                    : "grid-template-rows: 0fr; opacity: 0;"
                }
                data-ksa-glance-content={i}
                data-open={isDefaultOpen ? "true" : "false"}
              >
                <div class="overflow-hidden border-0 flex flex-col h-full">
                  <div class="px-5 pb-5 sm:px-6 sm:pb-6 pt-0 flex flex-col gap-4 flex-1">
                    <div class="w-full aspect-[574/322] overflow-hidden flex items-center justify-center">
                      {card.image ? (
                        <img
                          src={card.image}
                          alt={card.heading}
                          class="w-full h-full object-contain"
                          loading="lazy"
                        />
                      ) : (
                        <div class="w-full h-full bg-visual-placeholder flex items-center justify-center" />
                      )}
                    </div>

                    <ul class="m-0 p-0 list-none flex flex-col gap-2.5 pt-1">
                      {card.bullets.map((bullet) => (
                        <li class="flex items-start gap-2.5 font-body font-normal text-neutral-500 text-[13px] sm:text-[14px] lg:text-[15px] leading-[20px] sm:leading-[22px]">
                          <span class="text-neutral-400 select-none text-[18px] leading-[20px] shrink-0">
                            •
                          </span>
                          <span class="flex-1">{bullet}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function syncRowHeights() {
      if (window.innerWidth < 768) {
        for (var i = 0; i < 4; i++) {
          var c = document.querySelector('[data-ksa-glance-card="' + i + '"]');
          if (c) c.style.height = "";
        }
        return;
      }

      var rows = [
        [0, 1],
        [2, 3],
      ];

      rows.forEach(function (pair) {
        var cardA = document.querySelector(
          '[data-ksa-glance-card="' + pair[0] + '"]',
        );
        var cardB = document.querySelector(
          '[data-ksa-glance-card="' + pair[1] + '"]',
        );
        var contentA = document.querySelector(
          '[data-ksa-glance-content="' + pair[0] + '"]',
        );
        var contentB = document.querySelector(
          '[data-ksa-glance-content="' + pair[1] + '"]',
        );

        if (!cardA || !cardB || !contentA || !contentB) return;

        var openA = contentA.getAttribute("data-open") === "true";
        var openB = contentB.getAttribute("data-open") === "true";

        cardA.style.height = "";
        cardB.style.height = "";

        if (openA && openB) {
          var h = Math.max(cardA.offsetHeight, cardB.offsetHeight);
          cardA.style.height = h + "px";
          cardB.style.height = h + "px";
        }
      });
    }

    function openCard(index) {
      var content = document.querySelector(
        '[data-ksa-glance-content="' + index + '"]',
      );
      var btn = document.querySelector(
        '[data-ksa-glance-toggle="' + index + '"]',
      );
      var icon = document.querySelector(
        '[data-ksa-glance-icon="' + index + '"]',
      );
      if (!content || !btn) return;

      var num = Number(index);
      var pairIndex = num % 2 === 0 ? num + 1 : num - 1;
      var thisCard = document.querySelector(
        '[data-ksa-glance-card="' + num + '"]',
      );
      var siblingCard = document.querySelector(
        '[data-ksa-glance-card="' + pairIndex + '"]',
      );
      if (thisCard) thisCard.style.height = "";
      if (siblingCard) siblingCard.style.height = "";

      content.style.gridTemplateRows = "1fr";
      content.style.opacity = "1";
      content.setAttribute("data-open", "true");
      btn.setAttribute("aria-expanded", "true");
      btn.classList.add("pb-3", "sm:pb-4");
      if (icon) icon.style.transform = "rotate(45deg)";

      setTimeout(syncRowHeights, 320);
    }

    function closeCard(index) {
      var content = document.querySelector(
        '[data-ksa-glance-content="' + index + '"]',
      );
      var btn = document.querySelector(
        '[data-ksa-glance-toggle="' + index + '"]',
      );
      var icon = document.querySelector(
        '[data-ksa-glance-icon="' + index + '"]',
      );
      if (!content || !btn) return;

      var num = Number(index);
      var pairIndex = num % 2 === 0 ? num + 1 : num - 1;
      var thisCard = document.querySelector(
        '[data-ksa-glance-card="' + num + '"]',
      );
      var siblingCard = document.querySelector(
        '[data-ksa-glance-card="' + pairIndex + '"]',
      );
      if (thisCard) thisCard.style.height = "";
      if (siblingCard) siblingCard.style.height = "";

      content.style.gridTemplateRows = "0fr";
      content.style.opacity = "0";
      content.setAttribute("data-open", "false");
      btn.setAttribute("aria-expanded", "false");
      btn.classList.remove("pb-3", "sm:pb-4");
      if (icon) icon.style.transform = "rotate(0deg)";

      setTimeout(syncRowHeights, 320);
    }

    function toggle(index) {
      var content = document.querySelector(
        '[data-ksa-glance-content="' + index + '"]',
      );
      if (!content) return;

      var isOpen = content.getAttribute("data-open") === "true";
      if (isOpen) {
        closeCard(index);
      } else {
        openCard(index);
      }
    }

    document.addEventListener("click", function (e) {
      if (!e.target.closest) return;
      var toggleBtn = e.target.closest("[data-ksa-glance-toggle]");
      if (!toggleBtn) return;
      var index = toggleBtn.getAttribute("data-ksa-glance-toggle");
      toggle(index);
    });

    window.addEventListener("resize", syncRowHeights);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", syncRowHeights);
    } else {
      syncRowHeights();
    }
    window.addEventListener("load", syncRowHeights);
  })();
</script>
