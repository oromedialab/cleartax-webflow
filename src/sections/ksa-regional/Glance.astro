---
/**
 * "Saudi Arabia e-invoicing at a glance" — Figma node 18377:72678. Heading and lede,
 * then a 2x2 grid of cards that each carry a plus control.
 *
 * A card is a button: clicking it opens ONE overlay dialog showing that card's
 * heading and body, with prev/next chevrons to walk the other three without
 * closing. Pattern and mechanics copied from `spain-regional/Supports.astro`;
 * the overlay renders its layout once and swaps only the heading / body /
 * visual that differ per card.
 *
 * The Figma shows the cards collapsed only, so the body copy is drafted from the
 * FAQ and steps on this page. Review with content before staging.
 *
 * The card icons and the overlay visual are unfilled placeholder frames in the
 * Figma, so they render as `bg-visual-placeholder` (#E8FFE1). Swap for
 * Webflow-hosted artwork when it lands — never a `data:` URI.
 *
 * Ids and data attributes are `ksa-glance-` prefixed: embeds share one
 * namespace per page.
 */
interface Card {
  heading: string;
  img: string;
  image?: string;
  bullets: string[];
}

const cards: Card[] = [
  {
    heading: "Structured XML, not PDFs",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aec914d818a73f351a82eae_icon-1.png",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b05500be0ba5e817a0fb004_ksa-img-1.png",
    bullets: [
      "Every tax invoice, credit & debit note must be generated in UBL 2.1 XML (or PDF/A-3 with XML embedded), in Arabic, from a ZATCA-compliant solution.",
      "Each needs UUID, QR code & a cryptographic stamp & is chained to previous invoice by its hash. Handwritten, Word or Excel invoices are not valid.",
    ],
  },
  {
    heading: "Clearance for B2B, reporting for B2C",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac776e909e9bc8ba8a13933_icon-5.png",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b05500fee69e02bf43bb231_ksa-img-2.png",
    bullets: [
      "Standard (B2B & B2G) invoices go to Fatoora for real-time clearance; ZATCA validates & stamps them before you can share them with your buyer.",
      "Simplified (B2C) invoices are issued at the till & reported to ZATCA within 24hrs. Invoices that fails is not a valid tax invoice, so your buyer can't claim the input VAT.",
    ],
  },
  {
    heading: "Onboard every invoicing device",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1752b9ef6174e2d084604_ksa-icon-3.png",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b055014fdad897df86698d7_ksa-img-3.png",
    bullets: [
      "Each ERP, billing system or POS that issues invoices must be onboarded to Fatoora and hold its own Cryptographic Stamp Identifier (CSID).",
      "Groups with many branches, tills and systems need to onboard, renew and track every one.",
    ],
  },
  {
    heading: "Keep up with rule changes",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1752faf24c8e93a253fae_ksa-icon-4.png",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b0550194eadc02ad7541cfe_ksa-img-4.png",
    bullets: [
      "ZATCA updates its SDK & validation rules regularly. Recent changes added B2G invoice flags, continuous-supply identification & mandatory contract ID for B2G invoices (BR-KSA-92).",
      "Archive every invoice inside Saudi Arabia for at least six years.",
    ],
  },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12">
    <div class="flex flex-col items-center gap-6 text-center">
      <h2 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]">
        Saudi Arabia e-invoicing at a glance
      </h2>
      <p class="m-0 max-w-[916px] font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]">
        Since 4 December 2021, every VAT-registered business in Saudi Arabia
        must issue invoices from a compliant electronic solution. Under Phase 2,
        those systems connect to ZATCA's Fatoora platform: B2B and B2G invoices
        must be cleared by ZATCA before they reach the buyer, and B2C invoices
        must be reported within 24 hours. ZATCA has rolled this out in waves
        since January 2023, and Wave 25 now reaches businesses with revenue
        above SAR 187,500.
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-8">
      {cards.map((card, i) => (
        <button
          type="button"
          class="group m-0 flex h-full w-full cursor-pointer items-center justify-between gap-3 sm:gap-4 md:gap-5 rounded-xl border border-neutral-300 bg-generic-00 p-4 sm:p-5 md:p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue"
          aria-haspopup="dialog"
          data-ksa-glance-open
          data-ksa-glance-index={i}
        >
          <img
            src={card.img}
            alt=""
            height="56"
            width="56"
            loading="lazy"
            class="shrink-0 h-14 w-14 object-contain rounded-lg"
          />
          <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)] md:text-[length:var(--fs-body-lg)] md:leading-[length:var(--lh-body-lg)] lg:text-[length:var(--fs-h6)] lg:leading-[length:var(--lh-h6)]">
            {card.heading}
          </span>
          <span
            class="ml-auto flex h-10 w-10 sm:h-12 sm:w-12 lg:h-14 lg:w-14 shrink-0 items-center justify-center rounded-lg p-1.5 sm:p-2 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
            aria-hidden="true"
          >
            <svg
              class="h-6 w-6 sm:h-8 sm:w-8 lg:h-10 lg:w-10"
              viewBox="0 0 40 40"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M20 10V30"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M30 20L10 20"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Detail overlay -->
<div
  id="ksa-glance-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ksa-glance-overlay-title"
  aria-hidden="true"
  class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
>
  <div
    class="relative max-h-[90vh] w-full max-w-[630px] overflow-y-auto rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6"
    data-ksa-glance-panel
  >
    <button
      type="button"
      aria-label="Close"
      class="absolute right-6 top-6 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-5 lg:top-5"
      data-ksa-glance-close
    >
      <svg
        width="40"
        height="40"
        viewBox="0 0 40 40"
        fill="none"
        class="rotate-45"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M20 10V30"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
        <path
          d="M30 20L10 20"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </button>

    <div class="flex flex-col items-start gap-6">
      <div class="flex w-full flex-col justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class="size-[56px] shrink-0">
            {cards.map((card, i) => (
              <span
                class="size-[56px] shrink-0 items-center justify-center"
                style={i === 0 ? "display: flex;" : "display: none;"}
                hidden={i !== 0}
                data-ksa-glance-icon
              >
                <img
                  src={card.img}
                  alt={card.heading}
                  class="object-contain size-[56px] shrink-0"
                />
              </span>
            ))}
          </div>
          <div id="ksa-glance-overlay-title">
            {cards.map((card, i) => (
              <h3
                class="m-0 pr-12 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px] text-balance"
                style={i === 0 ? "display: block;" : "display: none;"}
                hidden={i !== 0}
                data-ksa-glance-heading
              >
                {card.heading}
              </h3>
            ))}
          </div>
        </div>

        <div class="aspect-[574/322] w-full max-w-[574px] rounded-lg overflow-hidden bg-visual-placeholder mx-auto flex items-center justify-center">
          {cards.map((card, i) =>
            card.image ? (
              <img
                src={card.image}
                alt={card.heading}
                class="h-full w-full object-contain"
                style={i === 0 ? "display: block;" : "display: none;"}
                hidden={i !== 0}
                data-ksa-glance-image
              />
            ) : (
              <div
                class="w-full h-full bg-visual-placeholder flex items-center justify-center"
                style={i === 0 ? "display: block;" : "display: none;"}
                hidden={i !== 0}
                data-ksa-glance-image
              />
            ),
          )}
        </div>

        <div class="flex flex-col gap-6">
          <div>
            {cards.map((card, i) => (
              <ul
                class="m-0 p-0 list-none flex flex-col gap-2.5 pt-1"
                style={i === 0 ? "display: flex;" : "display: none;"}
                hidden={i !== 0}
                data-ksa-glance-bullets
              >
                {card.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 font-body font-normal text-neutral-500 text-[13px] sm:text-[14px] lg:text-[15px] leading-[20px] sm:leading-[22px]">
                    <span class="text-neutral-400 select-none text-[18px] leading-[20px] shrink-0">
                      •
                    </span>
                    <span class="flex-1">{bullet}</span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  [data-ksa-glance-heading][hidden],
  [data-ksa-glance-bullets][hidden],
  [data-ksa-glance-icon][hidden],
  [data-ksa-glance-image][hidden] {
    display: none !important;
  }
</style>

<script is:inline>
  (function () {
    var overlay = document.getElementById("ksa-glance-overlay");
    if (!overlay) return;

    var panel = overlay.querySelector("[data-ksa-glance-panel]");
    var closeBtn = overlay.querySelector("[data-ksa-glance-close]");
    var headings = overlay.querySelectorAll("[data-ksa-glance-heading]");
    var bulletsList = overlay.querySelectorAll("[data-ksa-glance-bullets]");
    var icons = overlay.querySelectorAll("[data-ksa-glance-icon]");
    var images = overlay.querySelectorAll("[data-ksa-glance-image]");
    if (!panel || !headings.length) return;

    var count = headings.length;
    var current = 0;
    var lastFocused = null;

    function show(index) {
      current = ((index % count) + count) % count;
      for (var i = 0; i < count; i++) {
        headings[i].hidden = i !== current;
        headings[i].style.display = i === current ? "block" : "none";
        if (bulletsList[i]) {
          bulletsList[i].hidden = i !== current;
          bulletsList[i].style.display = i === current ? "flex" : "none";
        }
        if (icons[i]) {
          icons[i].hidden = i !== current;
          icons[i].style.display = i === current ? "flex" : "none";
        }
        if (images[i]) {
          images[i].hidden = i !== current;
          images[i].style.display = i === current ? "block" : "none";
        }
      }
      panel.scrollTop = 0;
    }

    function open(index, opener) {
      lastFocused = opener || document.activeElement;
      show(index);
      overlay.style.display = "flex";
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
    }

    function close() {
      overlay.style.display = "none";
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function isOpen() {
      return overlay.style.display === "flex";
    }

    document.addEventListener("click", function (e) {
      if (!e.target.closest) return;
      var opener = e.target.closest("[data-ksa-glance-open]");
      if (!opener) return;
      open(
        parseInt(opener.getAttribute("data-ksa-glance-index"), 10) || 0,
        opener,
      );
    });

    if (closeBtn) closeBtn.addEventListener("click", close);

    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) close();
    });

    document.addEventListener("keydown", function (e) {
      if (!isOpen()) return;

      if (e.key === "Escape") {
        close();
        return;
      }

      if (e.key === "ArrowLeft") {
        show(current - 1);
        return;
      }
      if (e.key === "ArrowRight") {
        show(current + 1);
        return;
      }

      if (e.key !== "Tab") return;
      var focusable = panel.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>
