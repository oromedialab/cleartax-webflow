---
/**
 * FAQ for the KSA regional page — Figma node 18377:74883 ("FAQ"). The
 * paste unit.
 *
 * Structure, styling and behaviour live in `_shared/FaqRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file,
 * because the embed route renders sections with no props.
 *
 * The Figma has no subtitle under the heading, so an empty one is passed —
 * `FaqRb` omits the paragraph when it is empty. Seven questions, first open,
 * the last two behind "Load more" after five — the primitive's standard
 * behaviour, and the "Load more" button the Figma draws.
 */
import FaqRb from '../_shared/FaqRb.astro';
import type { FaqItem } from '../_shared/FaqRb.astro';

const items: FaqItem[] = [
  {
    q: "Who must comply with e-invoicing in Saudi Arabia?",
    a: [
      {
        kind: "p",
        html: "All resident VAT-registered businesses, and anyone issuing tax invoices on a VAT-registered supplier's behalf. Phase 1 applies to all of them. Phase 2 applies wave by wave, based on VAT-subject revenue; Wave 25 covers revenue above SAR 187,500 in any year from 2022 to 2025. Non-resident businesses are exempt from e-invoicing.",
      },
    ],
  },
  {
    q: "What is the difference between Phase 1 and Phase 2?",
    a: [
      {
        kind: "p",
        html: "Phase 1 (from 4 December 2021) requires invoices to be generated and stored electronically by a compliant solution. Phase 2 (from 1 January 2023) adds integration with ZATCA's Fatoora platform, stricter XML formats, cryptographic stamps and real-time clearance or reporting.",
      },
    ],
  },
  {
    q: "What is the difference between clearance and reporting?",
    a: [
      {
        kind: "p",
        html: "Standard (B2B and B2G) invoices must be cleared by ZATCA in real time before you share them with the buyer. Simplified (B2C) invoices are issued straight away and reported to ZATCA within 24 hours.",
      },
    ],
  },
  {
    q: "How do I know which wave I'm in?",
    a: [
      {
        kind: "p",
        html: "ZATCA notifies targeted taxpayers at least six months before their deadline, through the ZATCA portal and email. If your revenue crossed SAR 187,500 in any year from 2022 to 2025 and you haven't integrated yet, you must get ready for the 1 February 2027 deadline.",
      },
    ],
  },
  {
    q: "What are the penalties for non-compliance?",
    a: [
      {
        kind: "p",
        html: "E-invoicing violations can draw fines of up to SAR 50,000 per violation, and repeat violations can be doubled. Buyers also can't claim input VAT on invoices that weren't cleared. The fines cancellation initiative runs until 31 December 2026 but won't cover violations occurring after 30 June 2026.",
      },
    ],
  },
  {
    q: "How long must e-invoices be archived?",
    a: [
      {
        kind: "p",
        html: "At least six years, stored inside Saudi Arabia, in their original XML form.",
      },
    ],
  },
  {
    q: "How do I choose the right e-invoicing software for Saudi Arabia?",
    a: [
      {
        kind: "p",
        html: "Look for proven Phase 2 volumes, integration with your ERP and POS, validation before sending, CSID management, fast handling of ZATCA SDK updates and local support. If you also file VAT and process supplier invoices, one platform for all three cuts costs and errors.",
      },
    ],
  },
];
---

<FaqRb
  items={items}
  subtitle=""
/>
