---
/**
 * KSA regional hero — Figma node 18377:71036 ("Container - Hero").
 *
 * Copied from `slovakia-regional/Hero.astro`: same stroke-field background in
 * place of the Figma's partner-logo wall, same single Flux Lime mark. Here the
 * "Hightlight" rectangle sits behind "e-invoicing" in a two-line headline, and
 * the Figma adds an overline above it and a row of three proof badges below
 * the body copy.
 *
 * The badge squares are unfilled "Icon placeholder" frames in the Figma, so
 * they render as `bg-visual-placeholder` (#E8FFE1). Swap for Webflow-hosted
 * artwork when it lands — never a `data:` URI.
 *
 * Ids and the canvas id are `ksa-` prefixed — embeds share one namespace per
 * page and a bare `hero` is exactly the kind of name that collides later.
 */
interface Props {
  /** Stroke width, and so the diameter of the dot it becomes at rest. */
  lineWidth?: number;
  gap?: number;
  /** Must stay under the grid pitch or the field knits into a mesh. */
  maxLength?: number;
  lengthRadius?: number;
  /** Leave at 1 — a partial turn makes strokes flip as the cursor crosses them. */
  tilt?: number;
  baseColor?: string;
  cursorRadius?: number;
  pull?: number;
  fadeRadius?: number;
}

const {
  lineWidth = 3,
  gap = 24,
  maxLength = 6,
  lengthRadius = 260,
  tilt = 1,
  baseColor = "#C8F006",
  cursorRadius = 320,
  pull = 14,
  fadeRadius = 40,
} = Astro.props;

const stats: { value: string; label: string; width: string }[] = [
  {
    value: "400M+",
    label: "Phase 2 e-invoices processed in KSA, at a 99.8% success rate",
    width: "md:max-w-[181px]",
  },
  {
    value: "2,000+",
    label:
      "Integrations with ERP and POS systems, including SAP, Oracle and Microsoft",
    width: "md:max-w-[228px]",
  },
  {
    value: "24/7",
    label:
      "support from a KSA team, with every ZATCA rule change shipped as a cloud update",
    width: "md:max-w-[256px]",
  },
];
---

<section
  id="ksa-hero"
  class="ksa-hero relative overflow-hidden bg-generic-00"
  data-line-width={String(lineWidth)}
  data-gap={String(gap)}
  data-max-length={String(maxLength)}
  data-length-radius={String(lengthRadius)}
  data-tilt={String(tilt)}
  data-base-color={baseColor}
  data-cursor-radius={String(cursorRadius)}
  data-pull={String(pull)}
  data-fade-radius={String(fadeRadius)}
