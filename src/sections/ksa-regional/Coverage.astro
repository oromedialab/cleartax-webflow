---
/**
 * "How ClearTax keeps you compliant with ZATCA's e-invoicing mandate" — Figma
 * node 18377:73253 ("Fold 10"). Eight rows, title + sub-line on the left, the
 * longer explanation on the right, divided by hairlines.
 *
 * Every row is drawn at 50% opacity in the Figma: it is the resting state of a
 * scroll-spotlight. A small script lifts the row nearest the middle of the
 * viewport to full opacity as the section scrolls past; without script (or with
 * reduced motion) all rows stay fully legible.
 *
 * The icon squares are unfilled "Visual placeholder" frames in the Figma, so
 * they render as `bg-visual-placeholder` (#E8FFE1). Swap for Webflow-hosted
 * artwork when it lands — never a `data:` URI.
 *
 * Classes and ids are `ksa-cov-` prefixed: embeds share one namespace per page.
 */
interface Row {
  title: string;
  lead: string;
  img?: string;
  body: string;
}

const rows: Row[] = [
  {
    title: "Full Phase 1 and Phase 2 coverage",
    lead: "Clear B2B and B2G invoices in real time and report B2C invoices within 24 hours",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1753c5f4e751ca08a8893_ksa-icon-5.png",
    body: "with UBL 2.1 XML, QR codes, cryptographic stamps and CSID management handled for you. Credit notes, debit notes and continuous supplies run in the same flow.",
  },
  {
    title: "Built for enterprise volumes",
    lead: "Generate up to 15,000 e-invoices a minute at a 99.8% success rate.",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1753f10bad5e8d3678812_ksa-icon-6.png",
    body: "Month-end peaks, retail sale days and multi-entity groups run without queues or timeouts.",
  },
  {
    title: "Catch errors before ZATCA does",
    lead: "AI-powered checks validate every mandatory field",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccc5de9b225f084c5057_ir-icon-10.png",
    body: "VAT code and Arabic value before an invoice is sent. Error alerts, suggested fixes and bulk resubmission clear rejections in minutes, not days.",
  },
  {
    title: "Integrates with any ERP or POS",
    lead: "2000+ integrations, including SAP, Oracle ERP and Retail, Microsoft Dynamics, Toshiba, LS Retail and Cegid.",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccced00effec3a6c3bff_ir-icon-12.png",
    body: "Your ERP stays as it is, and an offline POS app keeps unconnected stores compliant.",
  },
  {
    title: "ZATCA updates, handled",
    lead: "When ZATCA changes its SDK or validation rules, the update ships to you as a cloud release at no extra cost.",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1752faf24c8e93a253fae_ksa-icon-4.png",
    body: "You get notified of every change before it affects an invoice.",
  },
  {
    title: "VAT reconciliation, not just e-invoicing",
    lead: "Match your sales and purchase registers with ZATCA e-invoice data at 95%+ accuracy.",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccd7758a3c30559f9cda_ir-icon-14.png",
    body: "Teams cut post-invoicing work by up to 80% and file VAT returns with fewer surprises.",
  },
  {
    title: "AP automation for incoming e-invoices",
    lead: "Receive and process supplier e-invoices from Phase 1 and Phase 2 vendors digitally.",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af175523bceb5d03791270e_ksa-icon-11.png",
    body: "Plan payments, cut manual entry and keep input VAT claims clean.",
  },
  {
    title: "KSA now. GCC and 50+ countries next.",
    lead: "One platform and one API for Saudi Arabia, the UAE mandate and 50+ other countries.",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af17555f4fce136162b3928_ksa-icon-12.png",
    body: "Your KSA team gets 24/7 support, a dedicated success manager and in-house tax experts.",
  },
];
---

<section id="ksa-cov" class="bg-generic-00 py-16 lg:py-20">
  <div
    class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12"
  >
    <div class="flex max-w-[626px] flex-col items-center gap-4 text-center">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        How ClearTax keeps you compliant with ZATCA's e-invoicing mandate
      </h2>
      <p
        class="m-0 max-w-[586px] font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]"
      >
        One platform to generate, validate, report and reconcile every invoice
        in Saudi Arabia, proven on 400 million Phase 2 e-invoices.
      </p>
    </div>

    <div class="flex w-full flex-col">
      {
        rows.map((r) => (
          <div class="ksa-cov-row grid grid-cols-1 gap-4 py-6 lg:grid-cols-2 lg:gap-12">
            <div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 lg:gap-y-2">
              <img
                src={r.img}
                alt="ksa-icons"
                loading="lazy"
                height="56"
                width="56"
                class="size-[56px] shrink-0 object-contain rounded-lg self-center lg:row-span-2"
              />
              <h3 class="m-0 font-heading font-medium text-[19px] leading-[26.6px] text-vault-navy self-center lg:self-start max-w-[370px]">
                {r.title}
              </h3>
              <p class="m-0 font-body text-[13.3px] leading-[19px] text-vault-navy col-span-2 lg:col-span-1 lg:col-start-2 max-w-[370px]">
                {r.lead}
              </p>
            </div>
            <p class="m-0 self-center font-body text-neutral-500 text-[13.3px] leading-[19px]">
              {r.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .ksa-cov-row + .ksa-cov-row {
    border-top: 1px solid var(--palette-ledger-white);
  }
  .ksa-cov-js .ksa-cov-row {
    opacity: 0.5;
    scale: 0.95;
    transition: all 0.3s ease-in-out;
  }
  .ksa-cov-js .ksa-cov-row.is-active {
    opacity: 1;
    scale: 1;
    transition: all 0.3s ease-in-out;
  }
</style>

<script is:inline>
  (function () {
    var section = document.getElementById("ksa-cov");
    if (!section) return;
    if (
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;
    var rows = section.querySelectorAll(".ksa-cov-row");
    if (!rows.length) return;

    section.classList.add("ksa-cov-js");

    // The row whose centre is closest to the middle of the viewport is "on".
    function update() {
      var mid = window.innerHeight / 2;
      var best = null;
      var bestDist = Infinity;
      rows.forEach(function (row) {
        var rect = row.getBoundingClientRect();
        var dist = Math.abs(rect.top + rect.height / 2 - mid);
        if (dist < bestDist) {
          bestDist = dist;
          best = row;
        }
      });
      rows.forEach(function (row) {
        row.classList.toggle("is-active", row === best);
      });
    }

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        update();
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  })();
</script>
