        typedText && (typedText.dataset.text || typedText.textContent.trim())
          ? (typedText.dataset.text || typedText.textContent.trim()).replace(
              /\s+/g,
              " ",
            )
          : idx === 1
            ? "Can we pay Kestrel Facility Services today?"
            : idx === 2
              ? "What's holding up today's invoices?"
              : idx === 3
                ? "Compute this month’s tax returns across all entities."
                : idx === 4
                  ? "Extract the attached invoices for AP."
                  : idx === 5
                    ? "How do we reply to this VAT notice?"
                    : "Using the attached invoice aging report, which invoices cross 180 days this month?";

      const reduceMotion =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Accessible static fallback for users preferring reduced motion
      if (reduceMotion) {
        if (resultGroup) {
          resultGroup.classList.remove("hidden");
          resultGroup.style.display = "flex";
          resultGroup.style.opacity = "1";
          resultGroup.style.pointerEvents = "auto";
