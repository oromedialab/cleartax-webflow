              if (placeholder && !textWrap.contains(placeholder))
                textWrap.appendChild(placeholder);
              if (typed && !textWrap.contains(typed))
                textWrap.appendChild(typed);
              if (thinking && !textWrap.contains(thinking))
                textWrap.appendChild(thinking);
            }
          }
          if (pill && submitBtn && !pill.contains(submitBtn)) {
            pill.appendChild(submitBtn);
          }

          // Also reattach ClearTax AI input box text elements if orphaned across embeds
          const ctPill = document.querySelector(`.gh-ct-card${i}-input-box`);
          if (ctPill) {
            const ctTextWrap = ctPill.querySelector(".min-w-0.flex-1");
            const ctPlaceholder = document.querySelector(
              `.gh-ct-card${i}-pill-placeholder`,
            );
            const ctTyped = document.querySelector(
              `.gh-ct-card${i}-typed-text`,
            );
            const ctThinking = document.querySelector(
              `.gh-ct-card${i}-pill-thinking`,
            );
            const ctSubmitBtn = document.querySelector(
              `.gh-ct-card${i}-submit-btn`,
            );
            const ctRow =
              ctPill.querySelector(".flex.w-full.items-center.gap-2") || ctPill;
            if (ctTyped && !ctTyped.dataset.cached) {
              ctTyped.dataset.text = ctTyped.textContent.trim();
              ctTyped.dataset.cached = "true";
              ctTyped.textContent = "";
            }
            if (i === 0) {
              const ctInputTyped = document.querySelector(
                ".gh-ct-card0-input-typed",
              );
              if (ctInputTyped && ctTyped && !ctInputTyped.contains(ctTyped)) {
                ctInputTyped.appendChild(ctTyped);
              }
            } else {
              if (ctTextWrap && ctTyped && !ctTextWrap.contains(ctTyped)) {
                ctTextWrap.appendChild(ctTyped);
              }
            }
            if (ctTextWrap) {
              if (ctPlaceholder && !ctTextWrap.contains(ctPlaceholder))
                ctTextWrap.appendChild(ctPlaceholder);
              if (ctThinking && !ctTextWrap.contains(ctThinking))
                ctTextWrap.appendChild(ctThinking);
            }
            if (ctSubmitBtn && !ctRow.contains(ctSubmitBtn)) {
              ctRow.appendChild(ctSubmitBtn);
            }
          }

          // Reattach any orphaned thinking dots and remove empty .w-embed wrappers inside the pill
          const thinking = document.querySelector(`.gh-card${i}-pill-thinking`);
          const dotsWrap = thinking && thinking.querySelector(".inline-flex");
          if (thinking && dotsWrap) {
            const card = document.querySelector(`.gh-why-generic-card-${i}`);
            const scopeEl = card || pill || document;
            const strayDots = Array.from(
              scopeEl.querySelectorAll(".animate-bounce"),
            ).filter((dot) => !thinking.contains(dot));
            strayDots.forEach((dot) => {
              if (dotsWrap.querySelectorAll(".animate-bounce").length < 3) {
                dotsWrap.appendChild(dot);
              } else {
                dot.remove();
              }
            });

            if (pill) {
              const innerEmbeds = pill.querySelectorAll(":scope > .w-embed");
              innerEmbeds.forEach((we) => {
                if (
                  !we.textContent.trim() &&
                  !we.querySelector("button, svg, input, span")
                ) {
                  we.remove();
                }
