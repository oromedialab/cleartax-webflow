          if (pill) {
            const textWrap = pill.querySelector(".min-w-0.flex-1");
            const placeholder = document.querySelector(
              `.gh-card${i}-pill-placeholder`,
            );
            const typed = document.querySelector(`.gh-card${i}-pill-typed`);
            const thinking = document.querySelector(
              `.gh-card${i}-pill-thinking`,
            );
