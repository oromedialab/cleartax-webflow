      function stitchWebflowEmbeds() {
        for (let i = 0; i < 6; i++) {
          // 1. Ensure bottom-stage contains both spinner and input-box so spinner isn't spaced to center by justify-between
          const animCard = document.querySelector(
            `.gh-why-animation-card-${i}`,
