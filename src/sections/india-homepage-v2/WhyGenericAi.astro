          const submitBtn = document.querySelector(`.gh-card${i}-submit-btn`);

          // Ensure ClearTax inputContainer and pill are kept cleanly inside genCard
          if (genCard) {
            if (inputContainer && !genCard.contains(inputContainer)) {
