          // Reattach any orphaned sent bubbles or submit buttons across all cards
          const sentGroup = document.querySelector(
            `.gh-ct-card${i}-sent-group`,
          );
          const sentBubble = document.querySelector(
            `.gh-ct-card${i}-sent-bubble`,
          );
