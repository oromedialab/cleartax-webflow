          if (bottomStage) {
            bottomStage.style.setProperty("margin-top", "auto", "important");
            if (spinner) {
              spinner.classList.remove("is-active");
              spinner.style.display = "none";
              spinner.style.opacity = "0";
              if (!bottomStage.contains(spinner)) {
                bottomStage.insertBefore(spinner, bottomStage.firstChild);
              }
            }
            if (inputBox && !bottomStage.contains(inputBox)) {
              bottomStage.appendChild(inputBox);
            }
            if (animCard && !animCard.contains(bottomStage)) {
              animCard.appendChild(bottomStage);
            }
          }

          // 2. Ensure ClearTax dot-grid card center-title wraps the "What would you like to analyze?" heading
          const genCard = document.querySelector(`.gh-why-generic-card-${i}`);
          if (genCard) {
            let centerTitle =
              genCard.querySelector(`.gh-card${i}-center-title`) ||
              document.querySelector(`.gh-card${i}-center-title`);
            let analyzeH3 = null;
            genCard.querySelectorAll("h3").forEach((h) => {
              if (
                h.textContent
                  .trim()
                  .toLowerCase()
                  .includes("what would you like to analyze")
              ) {
                analyzeH3 = h;
              }
            });
            if (!centerTitle && analyzeH3) {
              centerTitle = document.createElement("div");
              centerTitle.className = `gh-card${i}-center-title pointer-events-none absolute inset-x-0 top-[26%] z-10 flex flex-col items-center justify-center text-center opacity-100 px-4`;
              analyzeH3.parentNode.insertBefore(centerTitle, analyzeH3);
              centerTitle.appendChild(analyzeH3);
            } else if (
              centerTitle &&
              analyzeH3 &&
              !centerTitle.contains(analyzeH3)
            ) {
              centerTitle.appendChild(analyzeH3);
            }
            if (centerTitle && !genCard.contains(centerTitle)) {
              genCard.insertBefore(centerTitle, genCard.firstChild);
