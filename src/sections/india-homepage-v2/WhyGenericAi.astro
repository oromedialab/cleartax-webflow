          const topStage = animCard
            ? animCard.querySelector(`.gh-ct-card${i}-top-stage`)
            : document.querySelector(`.gh-ct-card${i}-top-stage`);
          const bottomStage = animCard
            ? animCard.querySelector(`.gh-ct-card${i}-bottom-stage`)
            : document.querySelector(`.gh-ct-card${i}-bottom-stage`);
          const spinner = document.querySelector(`.gh-ct-card${i}-spinner`);
          const inputBox = document.querySelector(`.gh-ct-card${i}-input-box`);
          if (animCard) {
            animCard.style.justifyContent = "flex-end";
            animCard.querySelectorAll(":scope > .w-embed").forEach((we) => {
