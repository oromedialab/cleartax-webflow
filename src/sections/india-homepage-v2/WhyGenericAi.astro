        if (resultHeader) resultHeader.style.opacity = "1";
        resultParagraphs.forEach((p) => {
          p.style.opacity = "1";
          p.style.transform = "none";
        });
        if (sentGroup) {
          sentGroup.style.display = "none";
          sentGroup.style.opacity = "0";
        }
        if (sentBubble) {
          sentBubble.style.display = "none";
          sentBubble.style.opacity = "0";
        }
        if (spinner) {
          spinner.style.display = "none";
          spinner.style.opacity = "0";
        }
        if (pillPlaceholder) {
          pillPlaceholder.style.display = "flex";
          pillPlaceholder.style.opacity = "1";
        }
        if (pillThinking) {
          pillThinking.style.display = "none";
          pillThinking.style.opacity = "0";
        }
        if (typedText) typedText.textContent = "";
        if (inputBox) {
          inputBox.classList.remove("rounded-2xl");
          inputBox.classList.add("rounded-full");
        }
        if (chipWrapper) chipWrapper.style.display = "none";
        chipsToAnimate.forEach((c) => {
          c.style.display = "none";
        });
        return;
      }

      const plusIcon = inputBox
        ? inputBox.querySelector(
            ".flex.w-full.items-center svg.text-vault-navy",
          ) ||
          inputBox.querySelector(".flex.w-full.items-center svg.shrink-0") ||
          inputBox.querySelector(".flex.w-full.items-center svg")
        : null;

      const getSubmitBtnPos = () => {
        const cRect = card.getBoundingClientRect();
        const bRect = submitBtn.getBoundingClientRect();
        const scaleX = cRect.width / (card.offsetWidth || 1) || 1;
        const scaleY = cRect.height / (card.offsetHeight || 1) || 1;
        return {
          x:
            (bRect.left - cRect.left) / scaleX -
            (card.clientLeft || 0) +
            (bRect.width / scaleX) * 0.5,
          y:
            (bRect.top - cRect.top) / scaleY -
            (card.clientTop || 0) +
            (bRect.height / scaleY) * 0.58,
        };
      };

      const getPlusIconPos = () => {
        const cRect = card.getBoundingClientRect();
        if (plusIcon) {
          const pRect = plusIcon.getBoundingClientRect();
          const scaleX = cRect.width / (card.offsetWidth || 1) || 1;
          const scaleY = cRect.height / (card.offsetHeight || 1) || 1;
          return {
            x:
              (pRect.left - cRect.left) / scaleX -
              (card.clientLeft || 0) +
              (pRect.width / scaleX) * 0.45,
            y:
              (pRect.top - cRect.top) / scaleY -
              (card.clientTop || 0) +
              (pRect.height / scaleY) * 0.5,
          };
        }
        return getInputAreaPos();
      };

      const getInputAreaPos = () => {
        const cRect = card.getBoundingClientRect();
        const targetEl = pillPlaceholder || submitBtn;
        const tRect = targetEl.getBoundingClientRect();
        const scaleX = cRect.width / (card.offsetWidth || 1) || 1;
        const scaleY = cRect.height / (card.offsetHeight || 1) || 1;
        return {
          x: pillPlaceholder
            ? (tRect.left - cRect.left) / scaleX - (card.clientLeft || 0) + 16
            : (card.offsetWidth || 400) * 0.35,
          y:
            (tRect.top - cRect.top) / scaleY -
            (card.clientTop || 0) +
            (tRect.height / scaleY) * 0.58,
        };
      };

      const startGsap = () => {
        const gsap = window.gsap;
        if (!gsap) {
          setTimeout(startGsap, 60);
          return;
        }

        const initialSpinnerText = spinnerText
          ? spinnerText.textContent
          : "Analyzing uploaded file…";
        const typingObj = { charIndex: 0 };
        const tl = gsap.timeline({
          paused: true,
          defaults: { ease: "power2.inOut" },
        });

        // Frame 1: Initial state
        tl.add(() => {
          if (spinner) spinner.classList.remove("is-active");
        });
        tl.set([resultGroup, sentGroup, sentBubble, spinner].filter(Boolean), {
          display: "none",
        });
        tl.set(resultGroup, { opacity: 0, pointerEvents: "none" });
        tl.set(resultHeader, { opacity: 0, y: 6 });
        tl.set(resultParagraphs, { opacity: 0, y: 8 });
        tl.set([sentGroup, sentBubble].filter(Boolean), {
          opacity: 0,
          y: 15,
          scale: 0.95,
          pointerEvents: "none",
        });
        tl.set(spinner, { opacity: 0, y: 8, pointerEvents: "none" });
        tl.set(pillPlaceholder, { display: "flex", opacity: 1 });
        tl.set(pillThinking, { display: "none", opacity: 0 });
        if (inputBox) {
          inputBox.classList.remove("rounded-full");
          inputBox.classList.add("rounded-2xl");
          inputBox.style.borderRadius = "";
        }
        tl.add(() => {
          typingObj.charIndex = 0;
          if (typedText) typedText.textContent = "";
          if (spinner) {
            spinner.classList.remove("is-active");
            spinner.classList.add("hidden");
            spinner.style.display = "none";
            spinner.style.opacity = "0";
          }
          if (spinnerText) {
            spinnerText.textContent = initialSpinnerText;
          }
          if (inputBox) {
            inputBox.classList.remove("rounded-full");
            inputBox.classList.add("rounded-2xl");
            inputBox.style.borderRadius = "";
          }
          if (resultGroup) {
            resultGroup.classList.add("hidden");
            resultGroup.style.display = "none";
            resultGroup.style.opacity = "0";
          }
          if (sentGroup) {
            sentGroup.classList.add("hidden");
            sentGroup.style.display = "none";
            sentGroup.style.opacity = "0";
          }
          if (sentBubble) {
            sentBubble.classList.add("hidden");
            sentBubble.style.display = "none";
            sentBubble.style.opacity = "0";
          }
        }, 0);

        if (plusIcon) {
          tl.set(plusIcon, {
            transformOrigin: "center center",
            scale: 1,
          });
        }

        // Frame 1: Chip starts collapsed, hidden
        tl.set(chipWrapper, {
          display: "none",
          height: 0,
          marginBottom: 0,
        });
        tl.set(chipsToAnimate, {
          opacity: 0,
          scale: 0.8,
          y: -4,
          transformOrigin: "left center",
          height: "auto",
          minHeight: "auto",
          paddingTop: "",
          paddingBottom: "",
          marginTop: "",
          marginBottom: "",
          display: "inline-flex",
        });

        if (inputTyped) {
          tl.set(inputTyped, {
            opacity: 0,
            height: 0,
            display: "none",
          });
        }
        if (typedText) {
          typedText.textContent = "";
        }
        tl.set(pillPlaceholder, { opacity: 1 });
        tl.set(pillThinking, { opacity: 0 });
        tl.set(cursor, {
          opacity: 0,
          x: () => card.offsetWidth * 0.6,
          y: () => card.offsetHeight * 0.8,
          scale: 1,
          transformOrigin: "0% 0%",
        });

        // Step 1: Marker cursor appears and glides to Plus (+) attachment trigger
        tl.to(cursor, { opacity: 1, duration: 0.3 }, "+=0.25");
        tl.to(
          cursor,
          {
            x: () => getPlusIconPos().x,
            y: () => getPlusIconPos().y,
            duration: 0.65,
            ease: "power2.out",
          },
          "-=0.05",
        );

        // Step 2: First click on Plus button — input opens & 1st PDF / spreadsheet chip appears
        tl.to(cursor, {
          scale: 0.8,
          duration: 0.1,
          yoyo: true,
          repeat: 1,
        });
        if (plusIcon) {
          tl.to(
            plusIcon,
            { scale: 0.88, duration: 0.1, yoyo: true, repeat: 1 },
            "<",
          );
        }

        // Input box smoothly expands open
        tl.set(chipWrapper, {
          display: idx >= 1 ? "flex" : "block",
          height: 0,
          marginBottom: -6,
        });
        tl.to(
          chipWrapper,
          {
            height: "auto",
            marginBottom: 0,
            duration: 0.32,
            ease: "power2.out",
          },
          "<+=0.04",
        );
        // Track plus icon as wrapper expands
        tl.to(
          cursor,
          {
            x: () => getPlusIconPos().x,
            y: () => getPlusIconPos().y,
            duration: 0.32,
            ease: "power2.out",
          },
          "<",
        );
        tl.set(chipWrapper, { height: "auto" });

        // 1st PDF / chip appears
        if (chipsToAnimate.length > 0) {
          tl.to(
            chipsToAnimate[0],
            {
              opacity: 1,
              scale: 1,
              y: 0,
              duration: 0.3,
              ease: "back.out(1.5)",
            },
            "<+=0.04",
          );
        }

        // Step 3: For each additional PDF, marker clicks again and the chip appears
        for (let c = 1; c < chipsToAnimate.length; c++) {
          tl.to(
            cursor,
            { scale: 0.8, duration: 0.1, yoyo: true, repeat: 1 },
            "+=0.22",
          );
          if (plusIcon) {
            tl.to(
              plusIcon,
              {
                scale: 0.88,
                duration: 0.1,
                yoyo: true,
                repeat: 1,
              },
              "<",
            );
          }
          tl.to(
            chipsToAnimate[c],
            {
              opacity: 1,
              scale: 1,
              y: 0,
              duration: 0.3,
              ease: "back.out(1.5)",
            },
            "<+=0.04",
          );
        }

        // Step 4: After all PDFs are attached ("after full"), cursor glides to text line
        tl.to(
          cursor,
          {
            x: () => getInputAreaPos().x,
            y: () => getInputAreaPos().y,
            duration: 0.5,
            ease: "power2.inOut",
          },
          "+=0.25",
        );

        // Click to focus text input
        tl.to(cursor, {
          scale: 0.85,
          duration: 0.1,
          yoyo: true,
          repeat: 1,
        });
        tl.to(pillPlaceholder, { opacity: 0, duration: 0.15 }, "<+=0.04");
        tl.set(pillPlaceholder, { display: "none" });
        if (inputTyped) {
          tl.set(
            inputTyped,
            {
              display: "block",
              height: "auto",
              minHeight: "auto",
              opacity: 1,
            },
            "<",
          );
        }

        // Text prompt types out character by character
        typingObj.charIndex = 0;
        tl.to(
          typingObj,
          {
            charIndex: queryText.length,
            duration: 0.95,
            ease: "none",
            onUpdate: () => {
              if (typedText) {
                typedText.textContent = queryText.slice(
                  0,
                  Math.round(typingObj.charIndex),
                );
              }
            },
          },
          "<+=0.06",
        );

        // Cursor glides to submit button
        tl.to(
          cursor,
          {
            x: () => getSubmitBtnPos().x,
            y: () => getSubmitBtnPos().y,
            duration: 1.25,
            ease: "power2.inOut",
          },
          "+=0.35",
        );

        // Click submit button (tactile press down & spring release)
        tl.to(
          cursor,
          { scale: 0.8, duration: 0.09, ease: "power2.in" },
          "+=0.2",
        );
        tl.to(
          submitBtn,
          { scale: 0.78, duration: 0.09, ease: "power2.in" },
          "<",
        );
        tl.to(cursor, { scale: 1, duration: 0.14, ease: "power2.out" });
        tl.to(
          submitBtn,
          { scale: 1, duration: 0.16, ease: "back.out(2.5)" },
          "<",
        );
        tl.to(cursor, { opacity: 0, duration: 0.25 }, "+=0.15");

        // Frame 2 -> Frame 3: Input box collapses chip & typed text, switches to "Thinking..."
        // Step 1: Promptly fade out chip(s) and typed text
        const elementsToFade = [...chipsToAnimate];
        if (inputTyped) elementsToFade.push(inputTyped);
        tl.to(
          elementsToFade,
          {
            opacity: 0,
            duration: 0.18,
            ease: "power2.out",
          },
          "-=0.1",
        );

        // Step 2: Smoothly collapse the wrappers down to compact pill height
        const wrappersToCollapse = [chipWrapper];
        if (inputTyped) wrappersToCollapse.push(inputTyped);
        tl.to(
          wrappersToCollapse,
          {
            height: 0,
            minHeight: 0,
            paddingTop: 0,
            paddingBottom: 0,
            marginTop: 0,
            marginBottom: 0,
            duration: 0.35,
            ease: "power2.inOut",
          },
          "<+=0.04",
        );

        // Clear typed text so placeholder or thinking is clear
        tl.set(typedText, { textContent: "" });

        // Step 3: As the box settles into compact pill height, morph to rounded-full
        if (inputBox) {
          tl.add(() => {
            inputBox.classList.remove("rounded-2xl");
            inputBox.classList.add("rounded-full");
          }, "-=0.15");
        }

        tl.set([chipWrapper, ...chipsToAnimate], { display: "none" });
        if (inputTyped) tl.set(inputTyped, { display: "none" });
        tl.set(pillThinking, { display: "flex" });
        tl.to(
          pillThinking,
          { opacity: 1, duration: 0.25, ease: "power2.out" },
          "<",
        );

        // Top-right sent group (chip + dashed bubble) springs into view
        tl.add(() => {
          if (sentGroup) sentGroup.classList.remove("hidden");
          if (sentBubble) sentBubble.classList.remove("hidden");
        });
        tl.set([sentGroup, sentBubble].filter(Boolean), {
          display: "flex",
        });
        tl.to(
          [sentGroup, sentBubble].filter(Boolean),
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.45,
            ease: "back.out(1.4)",
            pointerEvents: "auto",
          },
          "<+=0.05",
        );

        // Spinner ("Analyzing uploaded file…") fades in
        tl.add(() => {
          if (spinner) spinner.classList.add("is-active");
        });
        tl.set(spinner, { display: "flex" });
        tl.to(
          spinner,
          {
            opacity: 1,
            y: 0,
            duration: 0.35,
            ease: "power2.out",
            pointerEvents: "auto",
          },
          "<+=0.1",
        );

        // Progressive status steps for cards with multiple attached documents
        // Progressive status steps — kept short (0.6s each) so the ClearTax
        // animation never appears stuck waiting for the generic card to finish.
        if (idx === 0 && spinnerText) {
          const steps = [
            "Matching invoice numbers to ERP rows",
            "Checking posting status per invoice",
            "Summarizing closed invoices",
          ];
          steps.forEach((stepText) => {
            tl.to(spinnerText, { opacity: 0, y: -4, duration: 0.18 }, "+=0.6");
            tl.set(spinnerText, { textContent: stepText, y: 4 });
            tl.to(spinnerText, { opacity: 1, y: 0, duration: 0.2 });
          });
        } else if (idx === 1 && spinnerText) {
          const steps = [
            "Searching for the KFS/1203 tax ID",
            "Checking address and bank details",
            "Summarizing vendor status",
          ];
          steps.forEach((stepText) => {
            tl.to(spinnerText, { opacity: 0, y: -4, duration: 0.18 }, "+=0.6");
            tl.set(spinnerText, { textContent: stepText, y: 4 });
            tl.to(spinnerText, { opacity: 1, y: 0, duration: 0.2 });
          });
        } else if (idx === 2 && spinnerText) {
          const steps = [
            "Grouping exceptions by reason",
            "Counting open items",
            "Summarizing the queue",
          ];
          steps.forEach((stepText) => {
            tl.to(spinnerText, { opacity: 0, y: -4, duration: 0.18 }, "+=0.6");
            tl.set(spinnerText, { textContent: stepText, y: 4 });
            tl.to(spinnerText, { opacity: 1, y: 0, duration: 0.2 });
          });
        } else if (idx === 3 && spinnerText) {
          const steps = [
            "Listing countries and vendors",
            "Checking each country's mandate",
            "Summarizing compliance status",
          ];
          steps.forEach((stepText) => {
            tl.to(spinnerText, { opacity: 0, y: -4, duration: 0.18 }, "+=0.6");
            tl.set(spinnerText, { textContent: stepText, y: 4 });
            tl.to(spinnerText, { opacity: 1, y: 0, duration: 0.2 });
          });
        } else if (idx === 4 && spinnerText) {
          const steps = [
            "Comparing sales and purchase registers",
            "Looking for mismatched entries",
            "Summarizing the mismatches",
          ];
          steps.forEach((stepText) => {
            tl.to(spinnerText, { opacity: 0, y: -4, duration: 0.18 }, "+=0.6");
            tl.set(spinnerText, { textContent: stepText, y: 4 });
            tl.to(spinnerText, { opacity: 1, y: 0, duration: 0.2 });
          });
        } else if (idx === 5 && spinnerText) {
          const steps = [
            "Reading the notice",
            "Looking for the questioned amount",
            "Summarizing what's needed",
          ];
          steps.forEach((stepText) => {
            tl.to(spinnerText, { opacity: 0, y: -4, duration: 0.18 }, "+=0.6");
            tl.set(spinnerText, { textContent: stepText, y: 4 });
            tl.to(spinnerText, { opacity: 1, y: 0, duration: 0.2 });
          });
        }

        // Hold on Frame 3 (Analyzing uploaded file) and wait until corresponding generic animation completes!
        tl.add(() => {
          const state = window.__ghWhy && window.__ghWhy.genericCardComplete;
          const isComplete =
            (state && state[idx]) ||
            (idx === 0 && state && state[0]) ||
            (idx === 1 && state && state[1]);

          if (!isComplete) {
            tl.pause();
            let safetyTimeout;
            const onGenericComplete = () => {
              window.removeEventListener(
                `gh-card${idx}-generic-complete`,
                onGenericComplete,
              );
              clearTimeout(safetyTimeout);
              tl.play();
            };
            window.addEventListener(
              `gh-card${idx}-generic-complete`,
              onGenericComplete,
            );
            safetyTimeout = setTimeout(() => {
              window.removeEventListener(
                `gh-card${idx}-generic-complete`,
                onGenericComplete,
              );
              tl.play();
            }, 12000);
          }
        });

        // Breathing room (0.2s)
        tl.to({}, { duration: 0.2 });

        // Frame 3 -> Frame 4: Sent group, sent bubble and spinner exit
        tl.to([sentGroup, sentBubble, spinner].filter(Boolean), {
          opacity: 0,
          y: -10,
          duration: 0.35,
          ease: "power2.in",
        });
        tl.set([sentGroup, sentBubble, spinner].filter(Boolean), {
          display: "none",
          opacity: 0,
          pointerEvents: "none",
        });
        tl.add(() => {
          if (spinner) spinner.classList.remove("is-active");
          if (sentGroup) sentGroup.classList.add("hidden");
          if (sentBubble) sentBubble.classList.add("hidden");
          if (resultGroup) resultGroup.classList.remove("hidden");
        });

        // Frame 4: Result group ("Analysis completed" + insight paragraphs) animates in
        tl.set(resultGroup, {
          display: "flex",
          opacity: 1,
          pointerEvents: "auto",
        });
        tl.to(
          resultHeader,
          { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" },
          "-=0.05",
        );
        // Stagger paragraphs one by one
        tl.to(
          resultParagraphs,
          {
            opacity: 1,
            y: 0,
            duration: 0.35,
            stagger: 0.28,
            ease: "power2.out",
          },
          "+=0.1",
        );

        // In input box: "Thinking..." fades out, "Ask anything..." returns
        tl.to(pillThinking, { opacity: 0, duration: 0.2 }, "<");
        tl.set(pillThinking, { display: "none" });
        tl.set(pillPlaceholder, { display: "flex" });
        tl.to(pillPlaceholder, { opacity: 1, duration: 0.25 }, "<+=0.1");

        // Hold on final result (Frame 7) for 3.0 seconds so the viewer can read the comparison output
        tl.to({}, { duration: 3.0 });

        // Seamless continuous loop: Restart both Left (Generic/ClearTax AI) and Right (Most AP Tools) animations together
        tl.add(() => {
          if (window.__ghWhy && window.__ghWhy.genericCardComplete) {
            window.__ghWhy.genericCardComplete[idx] = false;
          }
          const genTl =
            window.__ghWhy &&
            window.__ghWhy.genericTimelines &&
            window.__ghWhy.genericTimelines[idx];
          const isVisible = card.dataset.visible === "true";
          if (isVisible) {
            if (genTl) genTl.restart();
            tl.restart();
          } else {
            if (genTl) genTl.pause(0);
            tl.pause(0);
          }
        });

        // Register timeline for synchronized loop control
        window.__ghWhy = window.__ghWhy || {};
        window.__ghWhy.clearTaxTimelines =
          window.__ghWhy.clearTaxTimelines || [];
        window.__ghWhy.clearTaxTimelines[idx] = tl;

        // Viewport IntersectionObserver: start only when visible, pause when hidden, resume when re-entering
        const triggerEl = card.closest(".gh-why-card") || card;
        if (typeof IntersectionObserver !== "undefined") {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  card.dataset.visible = "true";
                  tl.play();
                } else {
                  card.dataset.visible = "false";
                  tl.pause();
                }
              });
            },
            { threshold: 0.15 },
          );
          observer.observe(triggerEl);
        } else {
          card.dataset.visible = "true";
          tl.play();
        }
      };

      if (typeof window.gsap === "undefined") {
        const s = document.createElement("script");
        s.src =
          "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js";
        s.onload = startGsap;
        document.head.appendChild(s);
      } else {
        startGsap();
      }
    }

    function initAllCardFlows() {
      // Chart frames sit in display:none containers, where loading="lazy" images
      // never start downloading — they would pop in blank when a frame is
      // revealed. Force them to fetch now, ahead of the animation.
      document
        .querySelectorAll(
          '#gh-why img[loading="lazy"], .gh-why-sticky img[loading="lazy"]',
        )
        .forEach(function (img) {
          img.loading = "eager";
        });
      for (let i = 0; i < 6; i++) {
        if (window.__ghWhy && window.__ghWhy.initGenericCardFlow) {
          window.__ghWhy.initGenericCardFlow(i);
        }
        initClearTaxCardFlow(i);
      }
    }

    const whyRoot =
      document.getElementById("gh-why") ||
      document.querySelector(".gh-why-sticky");
    if (whyRoot && typeof IntersectionObserver !== "undefined") {
      let flowsInited = false;
      const flowObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !flowsInited) {
              flowsInited = true;
              initAllCardFlows();
              flowObserver.disconnect();
            }
          });
        },
        { rootMargin: "600px 0px" },
      );
      flowObserver.observe(whyRoot);
      setTimeout(() => {
        if (!flowsInited) {
          flowsInited = true;
          initAllCardFlows();
          flowObserver.disconnect();
        }
      }, 3500);
    } else {
      setTimeout(initAllCardFlows, 1500);
    }
  })();
</script>
