          }
        }

        stitchCard4Dom();
      }

      stitchWebflowEmbeds();

      const stack = document.getElementById("gh-why-stack");
      if (!stack) return;

      const textEl = document.getElementById("gh-why-header");
      // Outers are never transformed, so their rects are always safe to measure.
      const outers = Array.from(stack.querySelectorAll(".gh-why-sticky"));
      const inners = Array.from(stack.querySelectorAll(".gh-why-card"));
      if (!outers.length || outers.length !== inners.length) return;

      const reduceMotion =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion) return;

      const STACK_OFFSET = 16; // visible sliver of each card behind the next
      const REVEAL_DISTANCE = 260; // scroll px the shrink takes once the next card closes in

      // Navbar clearance, from the shared token rather than a number of its own —
      // every pinned section on the site reads the same one. The fallback matches
      // the token so a missing shared.css degrades to the same offset.
      const NAV_CLEAR =
        parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue(
            "--nav-clear",
          ),
        ) || 112;

      // Card 0 shrinks most (0.88), each subsequent one less; the last never shrinks (1.0).
      // Dynamically distributes across outers.length cards so every card shrinks
      // evenly behind the final card rather than stopping at card 4.
      const minScale = 0.88;
      const targetScaleFor = (i) =>
        minScale + (i / Math.max(1, outers.length - 1)) * (1 - minScale);

      // TWO UNITS, and they are not the same one under `zoom`.
      // getBoundingClientRect() and window.innerHeight/innerWidth are RENDERED
      // pixels — what is on the glass. getComputedStyle().top, NAV_CLEAR,
      // STACK_OFFSET and anything written to `style.top` are CSS pixels.
      // shared.css puts `zoom` on the `body` element between tablet and 1440px, so the two
      // differ by that factor and this file mixes them in both directions: it
      // compares a rect against a computed top, and it derives a style.top from
      // rect measurements. Unconverted, the stack pinned at the wrong offsets and
      // the shrink triggered at the wrong scroll position.
      //
      // Walked rather than read off the `body` element, because zoom multiplies down the tree.
      const zoomFactor = () => {
        let z = 1;
        for (let n = stack; n && n.nodeType === 1; n = n.parentElement) {
          const v = parseFloat(getComputedStyle(n).zoom);
          // Unsupported -> NaN, unset -> 1. Both mean "no scaling here".
          if (v && v !== 1) z *= v;
        }
        return z;
      };

      // Recomputed by handleLayoutShift, which covers crossing the 1440px bound
      // where the zoom switches off.
      let zoom = zoomFactor();
      let lastNavClear = 0;

      const setTops = () => {
        zoom = zoomFactor();

        // Measure how far the card sits inside its wrapper. When the header is
        // hidden (screens < 860px tall), the card sits right at the top (offset = 0),
        // so we avoid touching inners[0].style.transform to eliminate any reflow jitter.
        let cardOffset = 0;
        const stuckHeader = document.getElementById("gh-why-header");
        if (stuckHeader && getComputedStyle(stuckHeader).display !== "none") {
          const originalTransform = inners[0].style.transform;
          inners[0].style.transform = "none";
          const outerTop = outers[0].getBoundingClientRect().top;
          const innerTop = inners[0].getBoundingClientRect().top;
          cardOffset = Math.max(0, (innerTop - outerTop) / zoom);
          inners[0].style.transform = originalTransform;
        }

        // Dynamically measure the bottom of the fixed navbar to account for
        // any top announcement banner / webinar bar that pushes it down.
        const navEl =
          document.querySelector("[data-nav-card]") ||
          document.querySelector("[data-giwip-nav-root]") ||
          document.querySelector("nav") ||
          document.querySelector(".nav-wrap");

        let effectiveNavClear = NAV_CLEAR;
        if (navEl) {
          const navBottom = navEl.getBoundingClientRect().bottom / zoom;
          // Keep at least 24px breathing clearance below the navbar
          effectiveNavClear = Math.max(NAV_CLEAR, Math.round(navBottom + 24));
        }

        // Only write to root style if the clearance actually changed by >= 1px
        // to avoid triggering repeated DOM style recalculation loops.
        if (Math.abs(effectiveNavClear - lastNavClear) >= 1) {
          lastNavClear = effectiveNavClear;
          document.documentElement.style.setProperty(
            "--nav-clear",
            `${effectiveNavClear}px`,
          );
        }

        let firstTop = effectiveNavClear;

        // Centre the whole stack vertically once there is room for it. The
        // breakpoint test stays in RENDERED px — it is asking about the window,
        // not the layout, the same question a media query asks.
        if (window.innerWidth >= 1280) {
          const cardHeight = inners[0].getBoundingClientRect().height / zoom;
          const totalStackHeight =
            cardOffset + cardHeight + (outers.length - 1) * STACK_OFFSET;
          const viewportCss = window.innerHeight / zoom;
          firstTop = Math.max(
            effectiveNavClear,
            (viewportCss - totalStackHeight) / 2,
          );
        }

        outers[0].style.top = firstTop + "px";

        // Wrapper 0 sticks at firstTop, so card 0's true visual top is firstTop
        // plus whatever sits above it inside the wrapper.
        const baseTop = firstTop + cardOffset;
        for (let i = 1; i < outers.length; i++) {
          outers[i].style.top = baseTop + i * STACK_OFFSET + "px";
        }
      };

      let ticking = false;

      const update = () => {
        // Read every wrapper position BEFORE writing any transform, so a write
        // can't invalidate a later read in the same frame.
        const tops = outers.map((el) => el.getBoundingClientRect().top);

        inners.forEach((inner, i) => {
          if (i === inners.length - 1) {
            inner.style.transform = "scale(1)";
            return;
          }

          // sticky clamps rect.top at the element's own `top` once stuck and keeps
          // decreasing before that, so this distance falls to 0 and stays there
          // the moment card i+1 is fully stuck. No extra bookkeeping needed.
          // Scaled into RENDERED px to match `tops`, which came from rects.
          const nextStickyTopPx =
            (parseFloat(getComputedStyle(outers[i + 1]).top) || 0) * zoom;
          const distanceToStick = tops[i + 1] - nextStickyTopPx;

          // REVEAL_DISTANCE is a scroll distance, and scrolling is in rendered px,
          // so both sides of this ratio are already in the same unit.
          const progress = Math.min(
            1,
            Math.max(0, 1 - distanceToStick / REVEAL_DISTANCE),
          );
          const scale = 1 - progress * (1 - targetScaleFor(i));
          inner.style.transform = `scale(${scale.toFixed(4)})`;
        });

        ticking = false;
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      let lastNavBottomMeasured = -1;
      const handleLayoutShift = () => {
        stitchWebflowEmbeds();
        setTops();
        update();
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", handleLayoutShift);
      window.addEventListener("load", handleLayoutShift, { once: true });

      if (textEl && typeof ResizeObserver !== "undefined") {
        new ResizeObserver(handleLayoutShift).observe(textEl);
      }

      const navElToObserve =
        document.querySelector("[data-nav-card]") ||
        document.querySelector("[data-giwip-nav-root]") ||
        document.querySelector("nav");
      if (navElToObserve && typeof ResizeObserver !== "undefined") {
        new ResizeObserver(() => {
          const bottom = navElToObserve.getBoundingClientRect().bottom;
          if (Math.abs(bottom - lastNavBottomMeasured) >= 1) {
            lastNavBottomMeasured = bottom;
            handleLayoutShift();
          }
        }).observe(navElToObserve);
      }

      setTimeout(handleLayoutShift, 300);
      setTimeout(handleLayoutShift, 1000);

      setTops();
      update();

      // --- GENERIC CARDS GSAP ANIMATION SEQUENCE ---
      function initGenericCardFlow(idx) {
        stitchWebflowEmbeds();
        const card = document.querySelector(`.gh-why-generic-card-${idx}`);
        if (!card) return;

        const glow = card.querySelector(`.gh-card${idx}-glow`);
        const glowBottom = card.querySelector(`.gh-card${idx}-glow-bottom`);
        const centerTitle = card.querySelector(`.gh-card${idx}-center-title`);
        const bubble = card.querySelector(`.gh-card${idx}-bubble`);
        const chartHeader = card.querySelector(`.gh-card${idx}-chart-header`);
        const skeleton = card.querySelector(`.gh-card${idx}-skeleton`);
        const checklist = card.querySelector(`.gh-card${idx}-checklist`);
        const checkItems = card.querySelectorAll(`.gh-card${idx}-check-item`);
        const chart =
          card.querySelector(`.gh-card${idx}-chart`) ||
          document.querySelector(`.gh-card${idx}-chart`);
        const chartImg =
          card.querySelector(`.gh-card${idx}-chart-img`) ||
          card.querySelector(`.gh-card${idx}-chart img`) ||
          document.querySelector(`.gh-card${idx}-chart-img`) ||
          (idx === 4
            ? document.querySelector(
                '.gh-card4-chart-img, img[src*="6ab6579339baafb1fa1a60a5_linked.png"]',
              )
            : null);
        const chartBottom =
          card.querySelector(`.gh-card${idx}-bottom-area`) ||
          document.querySelector(`.gh-card${idx}-bottom-area`) ||
          (idx === 4 ? document.querySelector(".gh-card4-bottom-area") : null);
        // chartImg is the img inside chart for cards 0-3; only card 4 has it as a standalone element.
        // When it is a child of chart, we must NOT separately animate it — the parent div
        // controls display, and double GSAP inline-style on parent+child causes the img to stay hidden.
        const chartImgIsChildOfChart = !!(
          chartImg &&
          chart &&
          chart.contains(chartImg)
        );
        const inputPill =
          card.querySelector(`.gh-card${idx}-input-pill`) ||
          document.querySelector(`.gh-card${idx}-input-pill`);
        const pillPlaceholder =
          card.querySelector(`.gh-card${idx}-pill-placeholder`) ||
          document.querySelector(`.gh-card${idx}-pill-placeholder`);
        const pillTyped =
          card.querySelector(`.gh-card${idx}-pill-typed`) ||
          document.querySelector(`.gh-card${idx}-pill-typed`);
        const pillTypedText =
          card.querySelector(`.gh-card${idx}-pill-typed-text`) ||
          document.querySelector(`.gh-card${idx}-pill-typed-text`) ||
          pillTyped;
        const genericQueryText =
          pillTypedText && pillTypedText.textContent.trim()
            ? pillTypedText.textContent.trim().replace(/\s+/g, " ")
            : idx === 1
              ? "Flag unusual transactions across invoices, contracts & shipping."
              : idx === 2
                ? "Did we hit revenue plan this month? What drove margin change?"
                : idx === 3
                  ? "Compute this month’s tax returns across all entities."
                  : idx === 4
                    ? "Process this month’s incoming invoices."
                    : "Which invoices cross 180 days this month?";
        const pillThinking =
          card.querySelector(`.gh-card${idx}-pill-thinking`) ||
          document.querySelector(`.gh-card${idx}-pill-thinking`);
        const submitBtn =
          card.querySelector(`.gh-card${idx}-submit-btn`) ||
          document.querySelector(`.gh-card${idx}-submit-btn`);
        const cursor =
          card.querySelector(`.gh-card${idx}-cursor`) ||
          document.querySelector(`.gh-card${idx}-cursor`);
        const borderPath =
          card.querySelector(`.gh-card${idx}-pill-border-path`) ||
          document.querySelector(`.gh-card${idx}-pill-border-path`);

        if (!inputPill || !cursor || !chart) return;

        // Card 4 chart elements are hidden via the .hidden Tailwind class and the
        // .gh-card4-chart:not(.is-revealed) CSS rule. No extra inline style needed—
        // and setting one here would escape GSAP's cleanup for child elements.

        const reduceMotion =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Accessible static fallback for users preferring reduced motion
        if (reduceMotion) {
          if (chartHeader) {
            chartHeader.classList.remove("hidden");
            chartHeader.style.display = "flex";
            chartHeader.style.opacity = "1";
            restoreCard4SvgPaths();
          }
          if (chart) {
            chart.classList.remove("hidden");
            chart.style.display = "flex";
            chart.style.opacity = "1";
          }
          if (chartImg) {
            chartImg.classList.remove("hidden");
            chartImg.style.display = "block";
            chartImg.style.opacity = "1";
          }
          if (chartBottom) {
            chartBottom.classList.remove("hidden");
            chartBottom.style.display = "inline-flex";
            chartBottom.style.opacity = "1";
          }
          if (centerTitle) centerTitle.style.opacity = "0";
          if (glow) glow.style.opacity = "0";
          if (glowBottom) glowBottom.style.opacity = "1";
          if (bubble) {
            bubble.style.display = "none";
            bubble.style.opacity = "0";
          }
          if (checklist) {
            checklist.style.display = "none";
            checklist.style.opacity = "0";
          }
          if (skeleton) {
            skeleton.style.display = "none";
            skeleton.style.opacity = "0";
          }
          if (pillPlaceholder) {
            pillPlaceholder.style.display = "flex";
            pillPlaceholder.style.opacity = "1";
          }
          if (pillTyped) {
            pillTyped.style.display = "none";
            pillTyped.style.opacity = "0";
          }
          if (pillThinking) {
            pillThinking.style.display = "none";
            pillThinking.style.opacity = "0";
          }
          if (pillTypedText) pillTypedText.textContent = "";
          return;
        }

        // Calculate vertical offset to center the pill in Frame 1
        const calcCenterOffset = () => {
          const cardH = card.offsetHeight || 380;
          const pillH = inputPill.offsetHeight || 48;
          const pillTop = inputPill.offsetTop || cardH - pillH - 24;
          const targetCenter = cardH * 0.53 - pillH / 2;
          return targetCenter - pillTop;
        };

        let centerOffset = calcCenterOffset();
        // Apply immediate center transform to prevent layout pop
        inputPill.style.transform = `translateY(${centerOffset}px)`;

        // Dynamically compute exact SVG path for rounded pill border
        const updatePillPath = () => {
          if (!borderPath || !inputPill) return 0;
          const w = inputPill.offsetWidth - 2;
          const h = inputPill.offsetHeight - 2;
          const r = h / 2;
          const x0 = 1;
          const y0 = 1;
          // Start at left-center (9 o'clock) and proceed clockwise up and around (matches Figma Vector 1)
          const d = `M ${x0} ${y0 + r} A ${r} ${r} 0 0 1 ${x0 + r} ${y0} H ${x0 + w - r} A ${r} ${r} 0 0 1 ${x0 + w} ${y0 + r} A ${r} ${r} 0 0 1 ${x0 + w - r} ${y0 + h} H ${x0 + r} A ${r} ${r} 0 0 1 ${x0} ${y0 + r} Z`;
          borderPath.setAttribute("d", d);
          let len = 0;
          try {
            len = borderPath.getTotalLength();
          } catch (e) {}
          if (!len || len <= 0) {
            len = 2 * (w - h) + Math.PI * h;
          }
          return len;
        };

        let borderLen = updatePillPath();

        window.addEventListener("resize", () => {
          centerOffset = calcCenterOffset();
          borderLen = updatePillPath();
          if (window.__ghWhy.genericCardComplete[idx]) {
            if (chartHeader) {
              chartHeader.classList.remove("hidden");
              chartHeader.style.removeProperty("display");
              chartHeader.style.display = "flex";
              chartHeader.style.opacity = "1";
              restoreCard4SvgPaths();
            }
            if (chart) {
              chart.classList.remove("hidden");
              chart.classList.add("is-revealed");
              chart.style.removeProperty("display");
              chart.style.display = "flex";
              chart.style.opacity = "1";
            }
            if (chartImg) {
              chartImg.classList.remove("hidden");
              chartImg.style.removeProperty("display");
              chartImg.style.display = "block";
              chartImg.style.opacity = "1";
            }
            if (chartBottom) {
              chartBottom.classList.remove("hidden");
              chartBottom.style.removeProperty("display");
              chartBottom.style.display = "inline-flex";
              chartBottom.style.opacity = "1";
            }
          }
        });

        const getPillPos = () => {
          const cRect = card.getBoundingClientRect();
          const pRect = inputPill.getBoundingClientRect();
          const scaleX = cRect.width / (card.offsetWidth || 1) || 1;
          const scaleY = cRect.height / (card.offsetHeight || 1) || 1;
          return {
            x:
              (pRect.left - cRect.left) / scaleX -
              (card.clientLeft || 0) +
              (pRect.width / scaleX) * 0.38,
            y:
              (pRect.top - cRect.top) / scaleY -
              (card.clientTop || 0) +
              (pRect.height / scaleY) * 0.58,
          };
        };

        const getSubmitBtnPos = () => {
          const cRect = card.getBoundingClientRect();
          const bRect = submitBtn.getBoundingClientRect();
          const scaleX = cRect.width / (card.offsetWidth || 1) || 1;
          const scaleY = cRect.height / (card.offsetHeight || 1) || 1;
          return {
            x:
              (bRect.left - cRect.left) / scaleX -
              (card.clientLeft || 0) +
              (bRect.width / scaleX) * 0.5,
            y:
              (bRect.top - cRect.top) / scaleY -
              (card.clientTop || 0) +
              (bRect.height / scaleY) * 0.58,
          };
        };

        const startGsap = () => {
          const gsap = window.gsap;
          if (!gsap) {
            setTimeout(startGsap, 60);
            return;
          }

          const typingObj = { charIndex: 0 };
          const tl = gsap.timeline({
            paused: true,
            defaults: { ease: "power2.inOut" },
          });

          // Frame 1: Initial state — hide all animated layers
          // NOTE: chartImg is intentionally excluded if it is the <img> inside chart (cards 0–3).
          // Setting display:none on both a parent and its child img causes the img to stay hidden
          // even after the parent is shown, because GSAP's inline style on the child isn't cleared.
          tl.set(
            [
              chartHeader,
              chart,
              chartBottom,
              bubble,
              skeleton,
              checklist,
            ].filter(Boolean),
            { display: "none" },
          );
          if (chartImg && !chartImgIsChildOfChart)
            tl.set(chartImg, { display: "none" });
          tl.set(chartHeader, {
            opacity: 0,
            y: 8,
            pointerEvents: "none",
          });
          tl.set([chart].filter(Boolean), {
            opacity: 0,
            y: 10,
            pointerEvents: "none",
          });
          if (chartBottom)
            tl.set(chartBottom, {
              opacity: 0,
              y: 10,
              pointerEvents: "none",
            });
          if (chartImg && !chartImgIsChildOfChart)
            tl.set(chartImg, {
              opacity: 0,
              y: 10,
              pointerEvents: "none",
            });
          tl.set(bubble, {
            opacity: 0,
            scale: 0.9,
            y: 8,
            pointerEvents: "none",
          });
          tl.set(skeleton, { opacity: 0, pointerEvents: "none" });
          tl.set(checklist, { opacity: 0, pointerEvents: "none" });
          tl.set(checkItems, { opacity: 0, x: -10 });
          if (borderPath) {
            tl.set(borderPath, { opacity: 0 });
          }

          if (glow) {
            tl.set(glow, { opacity: 0 });
          }
          if (glowBottom) {
            tl.set(glowBottom, { opacity: 1 });
          }
          tl.set(centerTitle, { opacity: 1, y: 0 });
          tl.set(inputPill, { y: () => centerOffset });
          tl.set(pillPlaceholder, { display: "flex", opacity: 1 });
          tl.set(pillTyped, { display: "none", opacity: 0 });
          if (pillTypedText) {
            pillTypedText.textContent = "";
          }
          tl.add(() => {
            typingObj.charIndex = 0;
            if (pillTypedText) pillTypedText.textContent = "";
            if (chart) {
              chart.classList.remove("is-revealed");
              chart.classList.add("hidden");
            }
            if (chartHeader) chartHeader.classList.add("hidden");
            if (chartImg && !chartImgIsChildOfChart)
              chartImg.classList.add("hidden");
            if (chartBottom) chartBottom.classList.add("hidden");
            if (bubble) bubble.classList.add("hidden");
            if (checklist) checklist.classList.add("hidden");
            if (skeleton) skeleton.classList.add("hidden");
            if (borderPath) {
              gsap.set(borderPath, { opacity: 0 });
            }
          }, 0);
          tl.set(pillThinking, { display: "none", opacity: 0 });
          tl.set(cursor, {
            opacity: 0,
            x: () => card.offsetWidth * 0.65,
            y: () => card.offsetHeight * 0.65,
            scale: 1,
            transformOrigin: "0% 0%",
          });

          // Frame 1: Cursor appears & moves to pill
          tl.to(cursor, { opacity: 1, duration: 0.35 }, "+=0.3");
          tl.to(
            cursor,
            {
              x: () => getPillPos().x,
              y: () => getPillPos().y,
              duration: 0.75,
              ease: "power2.out",
            },
            "-=0.1",
          );

          // Frame 2: Cursor clicks pill, prompt types out
          tl.to(cursor, {
            scale: 0.85,
            duration: 0.12,
            yoyo: true,
            repeat: 1,
          });
          tl.set(pillTyped, { display: "flex" });
          tl.to(pillPlaceholder, { opacity: 0, duration: 0.15 }, "<+=0.05");
          tl.set(pillPlaceholder, { display: "none" });
          tl.to(pillTyped, { opacity: 1, duration: 0.15 }, "<");
          typingObj.charIndex = 0;
          tl.to(
            typingObj,
            {
              charIndex: genericQueryText.length,
              duration: 0.95,
              ease: "none",
              onUpdate: () => {
                if (pillTypedText) {
                  pillTypedText.textContent = genericQueryText.slice(
                    0,
                    Math.round(typingObj.charIndex),
                  );
                }
              },
            },
            "<+=0.1",
          );

          // Cursor moves to submit arrow button (relaxed human-like glide)
          tl.to(
            cursor,
            {
              x: () => getSubmitBtnPos().x,
              y: () => getSubmitBtnPos().y,
              duration: 1.35,
              ease: "power2.inOut",
            },
            "+=0.35",
          );
          // Click submit button (tactile press down & spring release)
          tl.to(
            cursor,
            { scale: 0.8, duration: 0.09, ease: "power2.in" },
            "+=0.2",
          );
          tl.to(
            submitBtn,
            { scale: 0.78, duration: 0.09, ease: "power2.in" },
            "<",
          );
          tl.to(cursor, {
            scale: 1,
            duration: 0.14,
            ease: "power2.out",
          });
          tl.to(
            submitBtn,
            { scale: 1, duration: 0.16, ease: "back.out(2.5)" },
            "<",
          );
          tl.to(cursor, { opacity: 0, duration: 0.25 }, "+=0.15");

          // Pill drops down: center title fades out; glow stays behind input
          tl.to(
            centerTitle,
            {
              opacity: 0,
              y: -10,
              duration: 0.45,
              ease: "power2.in",
            },
            "-=0.1",
          );
          if (glow) {
            tl.to(glow, { opacity: 0, duration: 0.45 }, "<");
          }
          tl.to(inputPill, { y: 0, duration: 0.65, ease: "power3.inOut" }, "<");

          // --- BORDER LOADER: Draws 1 full round ---
          tl.add(() => {
            borderLen = updatePillPath();
            gsap.set(borderPath, {
              strokeDasharray: borderLen,
              strokeDashoffset: borderLen,
              opacity: 1,
            });
          });
          tl.addLabel("borderStart");
          tl.to(
            borderPath,
            {
              strokeDashoffset: 0,
              duration: 1.4,
              ease: "power1.inOut",
            },
            "borderStart",
          );
          tl.to(borderPath, { opacity: 0, duration: 0.2 }, "borderStart+=1.4");

          // Reveal message bubble, skeleton, and switch pill to Thinking at 30% border loader progress (0.42s)
          tl.addLabel("revealPoint", "borderStart+=0.42");
          tl.set(bubble, { display: "block" }, "revealPoint");
          tl.set(skeleton, { display: "flex" }, "revealPoint");
          tl.to(pillTyped, { opacity: 0, duration: 0.12 }, "revealPoint");
          tl.set(
            [pillTyped, pillPlaceholder].filter(Boolean),
            { display: "none" },
            "revealPoint+=0.12",
          );
          tl.set(pillThinking, { display: "flex" }, "revealPoint+=0.12");
          tl.to(
            pillThinking,
            { opacity: 1, duration: 0.12 },
            "revealPoint+=0.12",
          );
          tl.to(
            bubble,
            {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: 0.28,
              ease: "back.out(1.5)",
            },
            "revealPoint",
          );
          tl.to(
            skeleton,
            {
              opacity: 1,
              y: 0,
              duration: 0.18,
              ease: "power2.out",
            },
            "revealPoint",
          );

          // Frame 4: Skeleton holds for 2.0s from revealPoint, then fades out and checklist appears
          tl.to(skeleton, { opacity: 0, duration: 0.25 }, "revealPoint+=2.0");
          tl.set(skeleton, { display: "none" });
          tl.set(checklist, { display: "flex", opacity: 1 });
          tl.to(
            checkItems,
            {
              opacity: 1,
              x: 0,
              duration: 0.25,
              stagger: 0.15,
              ease: "power2.out",
            },
            "-=0.05",
          );

          // Hold on checklist (2.0s)
          tl.to({}, { duration: 2.0 });

          // Frame 5: Bubble & checklist exit, Chart header & chart image fade/slide in
          tl.to([bubble, checklist].filter(Boolean), {
            opacity: 0,
            y: -10,
            duration: 0.35,
            ease: "power2.in",
          });
          tl.set([bubble, checklist].filter(Boolean), {
            display: "none",
            opacity: 0,
            pointerEvents: "none",
          });
          tl.add(() => {
            if (chartHeader) {
              chartHeader.classList.remove("hidden");
              restoreCard4SvgPaths();
            }
            if (chart) {
              chart.classList.remove("hidden");
              chart.classList.add("is-revealed");
            }
            if (chartImg) chartImg.classList.remove("hidden");
            if (chartBottom) chartBottom.classList.remove("hidden");
          });
          tl.set(chartHeader, { display: "flex" });
          // Keep opacity at the GSAP-set 0 so tl.to() can animate the fade-in cleanly.
          // Setting opacity:1 here would cause the element to pop at full opacity instantly.
          tl.set(chart, { display: "flex" });
          if (chartBottom) tl.set(chartBottom, { display: "inline-flex" });
          tl.to(pillThinking, { opacity: 0, duration: 0.2 }, "<");
          tl.set(pillThinking, { display: "none" });
          tl.set(pillTyped, { display: "none", opacity: 0 });
          tl.set(pillPlaceholder, { display: "flex" });
          tl.to(pillPlaceholder, { opacity: 1, duration: 0.25 }, "<+=0.1");
          tl.add(() => {
            if (pillTypedText) pillTypedText.textContent = "";
          });

          tl.to(
            chartHeader,
            {
              opacity: 1,
              y: 0,
              duration: 0.5,
              ease: "power2.out",
              pointerEvents: "auto",
            },
            "-=0.05",
          );
          // Only animate chart + chartBottom (and standalone chartImg for card4).
          // For cards 0-3, the <img> is inside chart — animating the parent is enough.
          const chartAnimTargets = [chart, chartBottom];
          if (chartImg && !chartImgIsChildOfChart)
            chartAnimTargets.push(chartImg);
          tl.to(
            chartAnimTargets.filter(Boolean),
            {
              opacity: 1,
              y: 0,
              duration: 0.55,
              ease: "power2.out",
              pointerEvents: "auto",
              onComplete: () => {
                if (window.__ghWhy && window.__ghWhy.genericCardComplete) {
                  window.__ghWhy.genericCardComplete[idx] = true;
                }
                window.dispatchEvent(
                  new CustomEvent(`gh-card${idx}-generic-complete`),
                );
              },
            },
            "<+=0.1",
          );

          // Register timeline for synchronized loop control
          window.__ghWhy = window.__ghWhy || {};
          window.__ghWhy.genericTimelines =
            window.__ghWhy.genericTimelines || [];
          window.__ghWhy.genericTimelines[idx] = tl;

          // Safety fallback: if ClearTax card flow doesn't restart after 12s, loop generic independently
          tl.to({}, { duration: 12.0 });
          tl.add(() => {
            const isVisible = card.dataset.visible === "true";
            if (isVisible) {
              tl.restart();
            } else {
              tl.pause(0);
            }
          });

          // Viewport IntersectionObserver: start only when visible, pause when hidden, resume when re-entering
          const triggerEl = card.closest(".gh-why-card") || card;
          if (typeof IntersectionObserver !== "undefined") {
            const observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    card.dataset.visible = "true";
                    tl.play();
                  } else {
                    card.dataset.visible = "false";
                    tl.pause();
                  }
                });
              },
              { threshold: 0.15 },
            );
            observer.observe(triggerEl);
          } else {
            card.dataset.visible = "true";
            tl.play();
          }
        };

        if (typeof window.gsap === "undefined") {
          const s = document.createElement("script");
          s.src =
            "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js";
          s.onload = startGsap;
          document.head.appendChild(s);
        } else {
          startGsap();
        }
      }

      window.__ghWhy.initGenericCardFlow = initGenericCardFlow;
      window.__ghWhy.stitchWebflowEmbeds = stitchWebflowEmbeds;
      window.__ghWhy.stitchCard4Dom = stitchCard4Dom;
      window.__ghWhy.restoreCard4SvgPaths = restoreCard4SvgPaths;
    }

    initWhyGenericSection();
    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        () => {
          window.dispatchEvent(new Event("resize"));
        },
        { once: true },
      );
    }
  })();
</script>

<script is:inline>
  (() => {
    const stitchWebflowEmbeds = () => {
      if (window.__ghWhy && window.__ghWhy.stitchWebflowEmbeds) {
        window.__ghWhy.stitchWebflowEmbeds();
      }
    };

    // --- CLEARTAX CARDS GSAP ANIMATION SEQUENCE ---
    function initClearTaxCardFlow(idx) {
      stitchWebflowEmbeds();
      const card = document.querySelector(`.gh-why-animation-card-${idx}`);
      if (!card) return;

      const resultGroup = card.querySelector(`.gh-ct-card${idx}-result-group`);
      const resultHeader = card.querySelector(
        `.gh-ct-card${idx}-result-header`,
      );
      const resultParagraphs = card.querySelectorAll(
        `.gh-ct-card${idx}-result-p`,
      );
      const sentGroup = card.querySelector(`.gh-ct-card${idx}-sent-group`);
      const sentBubble =
        card.querySelector(`.gh-ct-card${idx}-sent-bubble`) ||
        document.querySelector(`.gh-ct-card${idx}-sent-bubble`);
      const spinner = card.querySelector(`.gh-ct-card${idx}-spinner`);
      const spinnerText = card.querySelector(`.gh-ct-card${idx}-spinner-text`);
      const inputBox = card.querySelector(`.gh-ct-card${idx}-input-box`);
      const chipWrapper = card.querySelector(`.gh-ct-card${idx}-chip-wrapper`);
      const inputChips = card.querySelectorAll(`.gh-ct-card${idx}-input-chip`);
      const inputChip = card.querySelector(`.gh-ct-card${idx}-input-chip`);
      const inputTyped = card.querySelector(`.gh-ct-card${idx}-input-typed`);
      const typedText = card.querySelector(`.gh-ct-card${idx}-typed-text`);
      const pillPlaceholder =
        card.querySelector(`.gh-ct-card${idx}-pill-placeholder`) ||
        document.querySelector(`.gh-ct-card${idx}-pill-placeholder`);
      const pillThinking =
        card.querySelector(`.gh-ct-card${idx}-pill-thinking`) ||
        document.querySelector(`.gh-ct-card${idx}-pill-thinking`);
      const submitBtn = card.querySelector(`.gh-ct-card${idx}-submit-btn`);
      const cursor = card.querySelector(`.gh-ct-card${idx}-cursor`);

      if (!submitBtn || !cursor || !sentGroup) return;

      const chipsToAnimate =
        inputChips.length > 0
          ? Array.from(inputChips)
          : inputChip
            ? [inputChip]
            : [];

