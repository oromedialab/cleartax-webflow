---
/**
 * "Belgium e-invoicing at a glance" — Figma node 18357:62499. Heading and lede,
 * then a 2x2 grid of cards that each carry a plus control.
 *
 * A card is a button: clicking it opens ONE overlay dialog showing that card's
 * heading and body, with prev/next chevrons to walk the other three without
 * closing. Pattern and mechanics copied from `spain-regional/Supports.astro`;
 * the overlay renders its layout once and swaps only the heading / body /
 * visual that differ per card.
 *
 * The Figma shows the cards collapsed only, so the body copy is lifted from the
 * FAQ answers on this page — nothing is stated here that the FAQ does not
 * already say. Review with content before staging.
 *
 * The card icons and the overlay visual are unfilled placeholder frames in the
 * Figma, so they render as `bg-visual-placeholder` (#E8FFE1). Swap for
 * Webflow-hosted artwork when it lands — never a `data:` URI.
 *
 * Ids and data attributes are `be-glance-` prefixed: embeds share one
 * namespace per page.
 */
interface Card {
  heading: string;
  body: string;
  icon: string;
  link: string;
}

const cards: Card[] = [
  {
    heading: "Automate the entire invoice lifecycle",
    body: "Unlike most AP tools, we don’t stop at ERP posting. Clarity AI handles the entire invoice lifecycle: Arrival, validation, processing, ERP posting, e-invoice filing and tax compliance reporting.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1752faf24c8e93a253fae_ksa-icon-4.png",
    link: "#",
  },
  {
    heading: "Improved Vendor Relations",
    body: "Clarity AI doesn’t get stuck because of messy vendor master data. It actively resolves it by looking up vendor tax IDs, their addresses, SKUs, and verify bank accounts. It even grades vendors based on delivery and quality parameters to aid decision making.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6afc251985a8e9fdd36121ef_in-icon-2.png",
    link: "#",
  },
  {
    heading: "Eliminates manual lookups and chasing",
    body: "Clarity AI reviews every invoice, every day. It understands approval layers, exception rules, historical actions, and even out-of-office responses. It follows up with your team members or vendors and fixes incorrect data, incomplete information, and mismatches.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6afc2523f6ed53ca6263a086_in-icon-3.png",
    link: "#",
  },
  {
    heading: "Global eInvoicing, tax reporting, and ViDA",
    body: "One API for eInvoicing and reporting compliance across 50+ countries. Avoid the needless complexity of managing multiple vendors and projects across countries.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6afc252a3c03b14008cfa3aa_in-icon-4.png",
    link: "#",
  },
  {
    heading: "Automate GST operations",
    body: "Clarity AI automates your entire GST operations. From ERP data extraction to filing, reconciliation, e-invoicing, and audit readiness — all in one place",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af175523bceb5d03791270e_ksa-icon-11.png",
    link: "#",
  },
  {
    heading: "Automate TDS operations",
    body: "Clarity AI automates your entire direct tax operations. From ERP data extraction to TDS filing, expense rationalisation, and 26AS reconciliation.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6abb82478a474f0459c88db6_ai-icon-6.png",
    link: "#",
  },
  {
    heading: "Keeps your VAT position clean",
    body: "Clarity AI compares your sales and purchase register against e-invoicing data, flags mismatches by severity, and tells your team what to fix, everyday.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6afc25448710dcaa8ab52290_in-icon-7.png",
    link: "#",
  },
  {
    heading: "Manage tax notices and replies",
    body: "When a tax notice arrives, Clarity AI reads it, maps it to the specific tax filings, and general ledger records, looks up case-laws for historical precedence and returns a filing-ready reply, with annexures as evidence.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6afc2548613dd5754fd4f67f_in-icon-8.png",
    link: "#",
  },
];
---

<section class="bg-generic-00 pt-16 pb-12 lg:pt-20">
  <div
    class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12"
  >
    <div class="flex flex-col items-center gap-6 text-center">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        Clarity AI: Purpose built for finance work
      </h2>
      <p
        class="m-0 max-w-[916px] font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]"
      >
        Reliable, auditable, and production-ready agents which handle Accounts Payable and Tax Compliance
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-5 sm:grid-cols-2 lg:gap-8">
      {
        cards.map((card, i) => (
          <button
            type="button"
            class="group m-0 flex w-full cursor-pointer items-center justify-between gap-5 self-start rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue"
            aria-haspopup="dialog"
            data-be-glance-open
            data-be-glance-index={i}
          >
            <img src={card.icon} alt="" class="h-14 w-14 shrink-0" />
            <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-balance max-w-[414px] text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-h6)] sm:leading-[length:var(--lh-h6)]">
              {card.heading}
            </span>
            <span
              class="ml-auto flex h-14 w-14 shrink-0 items-center justify-center rounded-lg p-2 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
              aria-hidden="true"
            >
              <svg
                width="40"
                height="40"
                viewBox="0 0 40 40"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M20 10V30"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M30 20L10 20"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<!-- Detail overlay. Lives outside the section's container so the scrim covers
     the viewport rather than the 1280px column. -->
<div
  id="be-glance-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="be-glance-overlay-title"
  aria-hidden="true"
  class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
>
  <div
    class="relative max-h-[90vh] w-full max-w-[1280px] overflow-y-auto rounded-xl border border-neutral-300 bg-generic-00 p-6"
    data-be-glance-panel
  >
    <!-- Close button -->
    <button
      type="button"
      aria-label="Close"
      class="absolute right-6 top-6 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-10 lg:top-10"
      data-be-glance-close
    >
      <svg
        width="40"
        height="40"
        viewBox="0 0 40 40"
        fill="none"
        class="rotate-45"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M20 10V30"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M30 20L10 20"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="flex flex-col items-start gap-6 lg:flex-row lg:gap-12">
      <!-- Left column: Icon, Heading, Body, Learn more, Chevrons -->
      <div
        class="flex w-full flex-col justify-between gap-6 lg:w-[416px] lg:shrink-0 lg:self-stretch"
      >
        <!-- Top group: Icon and Heading -->
        <div class="flex flex-col gap-6">
          <div class="h-16 w-16 shrink-0">
            {
              cards.map((card, i) => (
                <img
                  src={card.icon}
                  alt=""
                  class="h-full w-full object-contain"
                  style={i === 0 ? "display: block;" : "display: none;"}
                  hidden={i !== 0}
                  data-be-glance-icon
                  aria-hidden="true"
                />
              ))
            }
          </div>
          <div id="be-glance-overlay-title">
            {
              cards.map((card, i) => (
                <h3
                  class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px]"
                  hidden={i !== 0}
                  data-be-glance-heading
                >
                  {card.heading}
                </h3>
              ))
            }
          </div>
        </div>

        <!-- Bottom group: Body, Learn More, and Buttons (with 24px spacing) -->
        <div class="flex flex-col gap-6">
          <div>
            {
              cards.map((card, i) => (
                <p
                  class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                  hidden={i !== 0}
                  data-be-glance-body
                >
                  {card.body}
                </p>
              ))
            }
          </div>
          <div>
            {
              cards.map((card, i) => (
                <a
                  href={card.link}
                  class="font-body text-neutral-500 underline underline-offset-4 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] hover:text-nova-blue transition-colors duration-150 inline-block"
                  style={i === 0 ? "display: inline-block;" : "display: none;"}
                  hidden={i !== 0}
                  data-be-glance-link
                >
                  Learn more
                </a>
              ))
            }
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              aria-label="Previous"
              aria-controls="be-glance-overlay-title"
              class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue"
              data-be-glance-prev
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M12 15L7 10L12 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
            <button
              type="button"
              aria-label="Next"
              aria-controls="be-glance-overlay-title"
              class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue"
              data-be-glance-next
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M7 5L12 10L7 15"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Right column: Large Visual Frame -->
      <div
        class="aspect-[760/428] w-full rounded-lg bg-visual-placeholder overflow-hidden lg:w-auto lg:flex-1 lg:self-stretch"
        aria-hidden="true"
      >
        {
          cards.map((card, i) => (
            <div
              class="h-full w-full bg-visual-placeholder"
              style={i === 0 ? "display: block;" : "display: none;"}
              hidden={i !== 0}
              data-be-glance-image
              aria-hidden="true"
            />
          ))
        }
      </div>
    </div>
  </div>
</div>

<style is:global>
  [data-be-glance-icon][hidden],
  [data-be-glance-image][hidden],
  [data-be-glance-link][hidden] {
    display: none !important;
  }
</style>

<script is:inline>
  /* Card -> detail overlay, with the chevrons walking the eight without closing. */
  (function () {
    var overlay = document.getElementById("be-glance-overlay");
    if (!overlay) return;

    var panel = overlay.querySelector("[data-be-glance-panel]");
    var closeBtn = overlay.querySelector("[data-be-glance-close]");
    var prevBtn = overlay.querySelector("[data-be-glance-prev]");
    var nextBtn = overlay.querySelector("[data-be-glance-next]");
    var headings = overlay.querySelectorAll("[data-be-glance-heading]");
    var bodies = overlay.querySelectorAll("[data-be-glance-body]");
    var icons = overlay.querySelectorAll("[data-be-glance-icon]");
    var images = overlay.querySelectorAll("[data-be-glance-image]");
    var links = overlay.querySelectorAll("[data-be-glance-link]");
    if (!panel || !headings.length || headings.length !== bodies.length) return;

    var count = headings.length;
    var current = 0;
    var lastFocused = null;

    function show(index) {
      current = ((index % count) + count) % count;
      for (var i = 0; i < count; i++) {
        headings[i].hidden = i !== current;
        bodies[i].hidden = i !== current;
        if (links[i]) {
          links[i].hidden = i !== current;
          links[i].style.display = i === current ? "inline-block" : "none";
        }
        if (icons[i]) {
          icons[i].hidden = i !== current;
          icons[i].style.display = i === current ? "flex" : "none";
        }
        if (images[i]) {
          images[i].hidden = i !== current;
          images[i].style.display = i === current ? "block" : "none";
        }
      }
      panel.scrollTop = 0;
    }

    function open(index, opener) {
      lastFocused = opener || document.activeElement;
      show(index);
      overlay.style.display = "flex";
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
    }

    function close() {
      overlay.style.display = "none";
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function isOpen() {
      return overlay.style.display === "flex";
    }

    document.addEventListener("click", function (e) {
      if (!e.target.closest) return;
      var opener = e.target.closest("[data-be-glance-open]");
      if (!opener) return;
      open(
        parseInt(opener.getAttribute("data-be-glance-index"), 10) || 0,
        opener,
      );
    });

    if (closeBtn) closeBtn.addEventListener("click", close);
    if (prevBtn)
      prevBtn.addEventListener("click", function () {
        show(current - 1);
      });
    if (nextBtn)
      nextBtn.addEventListener("click", function () {
        show(current + 1);
      });

    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) close();
    });

    document.addEventListener("keydown", function (e) {
      if (!isOpen()) return;

      if (e.key === "Escape") {
        close();
        return;
      }

      if (e.key === "ArrowLeft") {
        show(current - 1);
        return;
      }
      if (e.key === "ArrowRight") {
        show(current + 1);
        return;
      }

      if (e.key !== "Tab") return;
      var focusable = panel.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>
