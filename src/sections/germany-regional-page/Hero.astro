<path d="M35.5003 29.1249V26.8749L33.7976 26.4492C33.6619 25.9408 33.4596 25.4526 33.1959 24.9974L34.0991 23.492L32.5081 21.901L31.0028 22.8042C30.5475 22.5405 30.0593 22.3382 29.5509 22.2026L29.1252 20.4998H26.8752L26.4495 22.2026C25.9412 22.3382 25.453 22.5405 24.9977 22.8042L23.4924 21.901L21.9013 23.492L22.8045 24.9974C22.5408 25.4526 22.3385 25.9408 22.2029 26.4492L20.5001 26.8749V29.1249L22.2029 29.5506C22.3385 30.059 22.5408 30.5471 22.8045 31.0024L21.9013 32.5078L23.4924 34.0988L24.9977 33.1956C25.453 33.4593 25.9412 33.6616 26.4495 33.7972L26.8752 35.5H29.1252L29.5509 33.7972C30.0593 33.6616 30.5475 33.4593 31.0028 33.1956L32.5081 34.0988L34.0991 32.5078L33.1959 31.0024C33.4596 30.5471 33.6619 30.059 33.7976 29.5506L35.5003 29.1249Z" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#05022A"/>
<path d="M31.0003 28C31.0003 29.6568 29.6572 31 28.0003 31C26.3434 31 25.0002 29.6568 25.0002 28C25.0002 26.3431 26.3434 24.9999 28.0003 24.9999C29.6572 24.9999 31.0003 26.3431 31.0003 28Z" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#05022A"/>
</svg>


                                        )}
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="font-heading font-medium text-vault-navy text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                                            {badge.value}
                                        </span>
                                        <span class="font-body text-neutral-500 font-normal text-[length:var(--fs-body-xs)] leading-[length:var(--lh-body-xs)]">
                                            {badge.label}
                                        </span>
                                    </div>
                                </li>
                        ))
                    }
                </ul>
                <!-- demo btn -->
                <div class="mt-6 w-full md:w-auto">
                    <a
                        href="javascript:void(0)"
                        onclick="document.getElementById('contactForm').scrollIntoView({behavior:'smooth'})"
                        class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-10 py-3.5 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-50 no-underline transition-all duration-200 hover:bg-nova-50 hover:text-nova-blue md:w-auto"
                    >
                        Book a demo
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style is:global>
    /* The single Flux Lime instance on this screen. Keeps the highlight intact
       with proportional horizontal padding and clearance from adjacent text. */
    .partner-hero-mark {
        display: inline-block;
        background-color: var(--color-flux-lime);
        padding: 4px 13px;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
        border-radius: 12px;
        vertical-align: baseline;
    }
</style>
