                            <defs>
                                <clipPath id="clip0_1748_19951">
                                    <rect width="40" height="40" fill="white"
                                    ></rect>
                                </clipPath>
                            </defs>
                        </svg>

                        <p
                            class="text-start font-body font-medium text-neutral-500 max-w-57"
                        >
                            New revenue streams with co-sell opportunities
                        </p>
                    </div>
                    <div
                        class="flex items-center gap-3 bg-generic-00/70 p-3 rounded-xl"
                    >
                        <svg
                            width="40"
                            height="40"
                            viewBox="0 0 40 40"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <g clip-path="url(#clip0_1748_19964)">
                                <path
                                    d="M8.67188 23.3355L13.9684 19.4038C14.6962 18.8634 15.6489 18.7298 16.4974 19.0491L21.8957 21.0804C22.4326 21.2824 22.7614 21.8258 22.6914 22.3951C22.608 23.0726 21.9937 23.556 21.3156 23.4778L16.8354 22.9608"
