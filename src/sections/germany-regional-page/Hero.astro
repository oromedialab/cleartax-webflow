                                stroke-linejoin="round"></path>
                            <path
                                d="M11.9226 19.2799H27.8337"
                                stroke="black"
                                stroke-width="0.9375"
                                stroke-miterlimit="10"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                        </svg>

                        <p
                            class="text-start font-body font-medium text-neutral-500 max-w-57"
                        >
                            Access global compliance + local expertise
                        </p>
                    </div>
                    <div class="flex gap-3 bg-generic-00/70 p-3 rounded-xl">
                        <svg
                            width="40"
                            height="40"
                            viewBox="0 0 40 40"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
