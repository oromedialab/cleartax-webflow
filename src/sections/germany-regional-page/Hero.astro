<style is:global>
    /* The single Flux Lime instance on this screen. Keeps the highlight intact
       with proportional horizontal padding and clearance from adjacent text. */
    .partner-hero-mark {
        display: inline-block;
        background-color: var(--color-flux-lime);
        padding: 4px 13px;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
        border-radius: 12px;
        vertical-align: baseline;
    }
</style>
