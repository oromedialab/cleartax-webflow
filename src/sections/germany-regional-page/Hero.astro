---
/**
 * Hero section for Indirect Tax page.
 * Uses interactive Dotgrid in Flux Lime with high-contrast radial wash,
 * brand typography, and tailored copy.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

interface Props {
    lineWidth?: number;
    gap?: number;
    maxLength?: number;
    lengthRadius?: number;
    tilt?: number;
    baseColor?: string;
    cursorRadius?: number;
    pull?: number;
    fadeRadius?: number;
    titlePrefix?: string;
    titleHighlight?: string;
    titleSuffix?: string;
    description?: string;
}

const {
    lineWidth = 3,
    gap = 24,
    maxLength = 6,
    lengthRadius = 260,
    tilt = 1,
    baseColor = "#C8F006",
    cursorRadius = 320,
    pull = 14,
    fadeRadius = 40,
    titlePrefix = "Get Ready for 2027 Germany",
    titleHighlight = "E-Invoicing",
    titleSuffix = "with ClearTax",
    description = "Best e-Invoicing software in Germany with XRechnung & ZUGFeRD support",
} = Astro.props;

const icons = [
    {
        id: 1,
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa240210b95e62dd7b6ab39_innovice-icon.png",
        desc: "Listed on VeR, Germany's leading e-invoicing association",
    },
    {
        id: 2,
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa2394447fb2cc739a96af1_10k-peak-icon.png",
        desc: "100% compliant e-invoicing solution with FeRD",
    },
    {
        id: 3,
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa2401b2f1bebbb77f908e6_countries.png",
        desc: "AI-powered seamless integration with any ERP/POS systems",
    },
];
---

<section
    class="de-hero-section relative bg-generic-00 overflow-hidden flex flex-col max-lg:pt-32 max-lg:pb-16 lg:pt-[257px] lg:pb-[161px]"
    id="hero"
>
    <!-- Interactive Dot Grid Background -->
    <Dotgrid
        containerId="hero"
        lineWidth={lineWidth}
        gap={gap}
        maxLength={maxLength}
        lengthRadius={lengthRadius}
        tilt={tilt}
        baseColor={baseColor}
        cursorRadius={cursorRadius}
        pull={pull}
        fadeRadius={fadeRadius}
    />

    <!-- Radial wash, so the headline keeps its contrast over the field -->
    <div
        class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"
    >
    </div>

    <div
        class="relative z-10 mx-auto lg:container w-full h-full flex flex-col px-4 md:px-6 pointer-events-auto"
    >
        <div class="flex justify-center w-full h-full">
            <!-- Hero Content -->
            <div
                class="hero-content flex flex-col items-center mx-auto text-center w-full h-full"
            >
                <!-- Headline -->
                <h1
                    class="text-[length:var(--fs-h1)] sm:text-[length:var(--fs-display-sm)] lg:text-[length:var(--fs-display-lg)] leading-[length:var(--lh-h1)] sm:leading-[length:var(--lh-display-sm)] lg:leading-[length:var(--lh-display-lg)] text-generic-100 font-semibold font-heading max-w-170.25 mx-auto mb-4 m-0 text-center"
                >
                    {titlePrefix}
                    {
                        titleHighlight && (
                            <span class="text-generic-100 bg-flux-lime partner-hero-mark  rounded-lg">
                                {titleHighlight}
                            </span>
                        )
                    }
                    {titleSuffix}
                </h1>

                <!-- Description -->
                <p
                    class="text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-base)] sm:leading-[length:var(--lh-body-lg)] max-w-160 text-neutral-500 font-normal font-body mb-6 text-center"
                >
                    {description}
                </p>
                <!-- stats -->
                <ul
                    class="flex flex-wrap items-stretch justify-center gap-2 list-none m-0 p-0 w-full"
                >
                    {
                        icons.map((icon) => (
                            <li class="flex basis-[330px] grow-0 shrink items-center gap-3 rounded-xl border border-neutral-300 bg-generic-00 p-4 text-left">
                                <span
                                    class="block h-9 w-9 shrink-0 rounded-lg bg-visual-placeholder"
                                    aria-hidden="true"
                                />
                                <span class="font-body text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] text-vault-navy max-w-60">
                                    {icon.desc}
                                </span>
                            </li>
                        ))
                    }
                </ul>
                <!-- demo btn -->
                <div class="mt-6">
                    <a
                        href="https://www.cleartax.com/contact-us"
                        data-demo-open
                        class="inline-flex items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-50 no-underline transition-all duration-200 hover:bg-nova-50 hover:text-nova-blue"
                    >
                        Book a demo
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style is:global>
    /* The single Flux Lime instance on this screen. Keeps the highlight intact
       with proportional horizontal padding and clearance from adjacent text. */
    .partner-hero-mark {
        display: inline-block;
        background-color: var(--color-flux-lime);
        padding: 4px 13px;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
        border-radius: 12px;
        vertical-align: baseline;
    }
</style>
