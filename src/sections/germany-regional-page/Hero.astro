<path d="M33.6732 35.0786H27.7772" stroke-width="1.2" stroke-miterlimit="10" stroke="#05022A"/>
<path d="M29.6964 26.306L26.3076 29.6948" stroke-width="1.2" stroke-miterlimit="10" stroke="#05022A"/>
<path d="M39.2975 35.0786C39.2975 36.6319 38.0383 37.8911 36.485 37.8911C34.9317 37.8911 33.6725 36.6319 33.6725 35.0786C33.6725 33.5253 34.9317 32.2661 36.485 32.2661C38.0383 32.2661 39.2975 33.5253 39.2975 35.0786Z" stroke-width="1.2" stroke-miterlimit="10" stroke="#05022A"/>
<path d="M35.7819 35.0786H37.1881" stroke-width="1.2" stroke-miterlimit="10" stroke="#5446FF"/>
</g>
</svg>


                                        )}
                                        {index === 1 && (
                                            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect x="0.5" y="0.5" width="55" height="55" rx="7.5" stroke="#CCCCCC"/>
<path d="M21.0134 30.3295H27.1714M21.0134 34.9889H27.1714M21.0134 25.6701H23.6121M21.0134 21.0107H23.6121" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#05022A"/>
