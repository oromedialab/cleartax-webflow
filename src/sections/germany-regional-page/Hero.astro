<path d="M38.1767 34.2686V38.7728C38.1767 39.7597 37.0696 40.3416 36.2567 39.7819L35.0551 38.9547L33.8535 39.7819C33.0406 40.3416 31.9335 39.7597 31.9335 38.7728V34.2686" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#5446FF"/>
</svg>


                                        )}
                                        {index === 2 && (
                                            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect x="0.5" y="0.5" width="55" height="55" rx="7.5" stroke="#CCCCCC"/>
<path d="M20.639 37.4782C25.3468 41.144 32.1578 40.8133 36.4858 36.4854C40.8136 32.1575 41.1444 25.3465 37.4786 20.6387" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#5446FF"/>
