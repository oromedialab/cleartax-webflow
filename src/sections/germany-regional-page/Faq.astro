---
/**
 * FAQ for the Germany regional page — content mirrors cleartax.com/de/en. The paste unit.
 *
 * Structure, styling and behaviour live in `_shared/FaqRb.astro`;
 * this file owns the content. Props must be supplied here, inside a section
 * file, because the embed route renders sections with no props.
 *
 * Questions and answers are copied verbatim from the FAQ on cleartax.com/de/en.
 */
import FaqRb from "../_shared/FaqRb.astro";
import type { FaqItem } from "../_shared/FaqRb.astro";

const items: FaqItem[] = [
    {
        q: "Does ClearTax e-Invoicing support e-Reporting and ViDA's DRR obligations?",
        a: [
            {
                kind: "p",
                html: "Yes. ClearTax's one platform covers both e-invoicing and e-reporting across 50+ countries. It is built for ViDA's Digital Reporting Requirements, mandatory from July 2030, where intra-EU B2B invoices must reach the EU VIES database within 10 days. It is also ready for Germany's anticipated domestic e-reporting layer and the updated EN 16931 DRR fields.",
            },
        ],
    },
    {
        q: "Which e-Invoice formats does ClearTax support for Germany?",
        a: [
            {
                kind: "p",
                html: "ClearTax supports all EN 16931-compliant formats accepted in Germany: XRechnung (XML), ZUGFeRD 2.x (PDF with embedded XML) and Peppol BIS 3.0. Invoices can be exchanged over email, Peppol or EDI, with deep validation applied before each invoice reaches the buyer.",
            },
        ],
    },
    {
        q: "Does ClearTax integrate with SAP, Microsoft Dynamics and other ERPs?",
        a: [
            {
                kind: "p",
                html: "Yes. ClearTax integrates with any ERP, billing, OMS or POS system, including SAP, through pre-built connectors. Where no connector exists, you can connect via the unified global API, SFTP or database, or manual upload. AI-led mapping helps most enterprises go live up to 4x faster.",
            },
        ],
    },
    {
        q: "What happens if Germany's e-Invoicing regulations change?",
        a: [
            {
                kind: "p",
                html: "ClearTax absorbs regulatory and format changes on the platform side, so you avoid IT effort or ERP rework each time the mandate evolves. Government and product updates are managed for you, giving continuous compliance through e-reporting, ViDA and beyond.",
            },
        ],
    },
    {
        q: "Can ClearTax handle e-Invoicing for multi-entity or cross-border B2B operations in Germany?",
        a: [
            {
                kind: "p",
                html: "Yes. A single platform and dashboard give control and visibility across multiple entities, with country-level configuration on one global API. As a registered Peppol Access Point, ClearTax supports cross-border exchange and is already built for intra-EU ViDA reporting from July 2030.",
            },
        ],
    },
    {
        q: "How does ClearTax ensure GoBD-compliant archiving of e-Invoices?",
        a: [
            {
                kind: "p",
                html: "ClearTax archives the original structured invoice file in an audit-ready form for the 8-year period required under §147 AO. Data is held with EU data residency on AWS Europe, encrypted at rest with AES 256-bit and protected by role-based access, supporting the GoBD principles of completeness, integrity and retrievability.",
            },
        ],
    },
    {
        q: "Can ClearTax support an in-house e-Invoicing setup without outsourcing our IT?",
        a: [
            {
                kind: "p",
                html: "Yes. ClearTax connects to your existing ERP and your team runs everything from one dashboard, so nothing leaves your control. What it removes is the maintenance burden: it absorbs BMF guidance and format updates on the platform side, so you build the integration once rather than rebuilding for every change.",
            },
        ],
    },
    {
        q: "How is ClearTax different if we already receive e-Invoices by email and are compliant?",
        a: [
            {
                kind: "p",
                html: "Email keeps you compliant on receipt, but leaves invoices fragmented across email, Peppol and EDI with no single view, which is where missed input tax credits and non-compliance creep in. From January 2027, issuing structured invoices also becomes mandatory. ClearTax unifies every channel and format into one validated dashboard.",
            },
        ],
    },
    {
        q: "Can ClearTax work with SAP DRC, and what does it offer in addition?",
        a: [
            {
                kind: "p",
                html: "ClearTax is a dedicated e-invoicing platform, not an SAP DRC implementation service. DRC handles the basics but carries per-country costs, needs an IT cycle for each update, and does not consolidate Germany's three channels into one view. ClearTax connects to SAP via pre-built connectors and unifies every channel, format and mandate on a single platform.",
            },
        ],
    },
    {
        q: "Is ClearTax a BMF-approved e-Invoicing service provider?",
        a: [
            {
                kind: "p",
                html: "Germany follows a decentralised model with no central clearance portal, and the BMF does not approve or accredit e-invoicing providers, so no such approval exists to hold. What matters is meeting the EN 16931 standard. ClearTax is a registered Peppol Access Point compliant with Peppol BIS 3.0 and listed on VeR, Germany's leading e-invoicing association.",
            },
        ],
    },
];
---

<FaqRb items={items} />
