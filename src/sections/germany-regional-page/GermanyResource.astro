---
/**
 * "Germany e-invoicing resource centre" — six cards in a 3-column grid.
 * Each is a category chip, a title and a link; the whole card is the link.
 * Content mirrors the resources on cleartax.com/de/en.
 */
interface Resource {
    category: string;
    isNew: boolean;
    title: string;
    desc: string;
    href: string;
}

const resources: Resource[] = [
    {
        category: "Whitepaper",
        isNew: false,
        title: "Germany E-Invoicing Mandate Readiness Checklist",
        desc: "A practical checklist to get your business ready for Germany's e-invoicing mandate",
        href: "https://drive.google.com/file/d/1CP4Zq8j9Vy8u4PxezycuRn9Yuo8SVRSY/view?usp=sharing",
    },
    {
        category: "Case study",
        isNew: false,
        title: "Transforming E-Invoicing for Belgium's Largest Conglomerate",
        desc: "See how a large enterprise modernised its e-invoicing with ClearTax",
        href: "https://assets1.cleartax-cdn.com/finfo/wg-utils/retool/1f63e347-6f0d-4210-b96c-0d9a011a100d.pdf",
    },
    {
        category: "Whitepaper",
        isNew: false,
        title: "The hidden risks of Germany's e-Invoicing mandate most enterprises miss",
        desc: "The compliance gaps to watch for before the mandate takes effect",
        href: "https://files.clear.in/aXmEtGNpG2N",
    },
    {
        category: "Whitepaper",
        isNew: false,
        title: "ViDA CFO Playbook",
        desc: "What ViDA's digital reporting requirements mean for finance leaders",
        href: "https://drive.google.com/file/d/1fYpG7ZRu4ApfyUlALdyqPLPYpyIvCZOf/view",
    },
    {
        category: "Whitepaper",
        isNew: false,
        title: "Build vs Buy",
        desc: "Weigh building an in-house e-invoicing setup against buying a platform",
        href: "https://drive.google.com/file/d/1a8h8qYBjSzaoobzYnQn7QWZHXh8YqA4X/view?usp=sharing",
    },
    {
        category: "Blog",
        isNew: false,
        title: "E-Invoicing in Germany: Obligations, Timeline, Requirements, Format & Examples",
        desc: "A complete guide to Germany's obligations, timelines and formats",
        href: "https://www.cleartax.com/de/en/e-invoicing-germany",
    },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
    <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
        <h2
            class="m-0 mb-8 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] lg:mb-12"
        >
            Germany e-invoicing resource centre
        </h2>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
                resources.map((r) => (
                    <a
                        href={r.href}
                        class="flex flex-col gap-4 rounded-xl border border-neutral-300 bg-generic-00 p-6 no-underline transition-all duration-200 ease-in-out hover:border-nova-blue"
                    >
                        <div class="flex items-start justify-between gap-3">
                            <span class="inline-flex items-center justify-center rounded-lg bg-neutral-100 px-3 py-1.5 font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-neutral-700">
                                {r.category}
                            </span>
                            {r.isNew && (
                                <span class="inline-flex items-center justify-center rounded-lg bg-nova-blue px-3 py-1.5 font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-generic-00">
                                    New
                                </span>
                            )}
                        </div>

                        <div class="flex flex-col gap-2.5">
                            <h3 class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                                {r.title}
                            </h3>
                            {r.desc && (
                                <p class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                                    {r.desc}
                                </p>
                            )}
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</section>
