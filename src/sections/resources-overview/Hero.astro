---
/**
 * Global invoicing delivery Hero section — modern Astro component
 * Matches reference layout and screenshot with hero-bg.png as background,
 */
---

<section
    class="hero-section relative min-h-[700px] overflow-hidden flex items-center pt-28 pb-12 md:pt-30 md:pb-16 lg:pt-35 lg:pb-25"
    id="hero"
>
    <style is:global>
      .hero-swiper .swiper-slide {
        opacity: var(--custom-opacity, 1) !important;
      }
    </style>
    <!-- Sunset Skyline Background with dark to soft fade overlays -->
    <div
        class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7d62aaca8c3dfdf8ffe7c5_bg.png');"
    >
    </div>

    <div class="relative z-10 mx-auto lg:container w-full px-4 lg:px-8">
        <div
            class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.9fr] 2xl:grid-cols-2 gap-12 lg:gap-8 items-center"
        >
            <!-- Hero Left Column -->
            <div class="hero-left-content flex flex-col items-start">
                <!-- Badge Capsule -->
                <h1
                    class="inline-flex items-center gap-1.5 m-0 bg-[linear-gradient(90deg,_rgba(144,_68,_169,_0.2)_0%,_rgba(184,_126,_200,_0.2)_100%)] text-[#9144AB] leading-[1] text-xs font-normal px-4 py-2 rounded-full mb-4"
                >
                    Cleartax Resources
                </h1>
                <!-- Headline -->
                <h2
                    class="text-[36px] lg:text-[44px] xl:text-[56px] max-w-138 text-black font-medium font-['Nohemi'] leading-[1.14] mb-4 m-0 bg-clip text-transparent" style="background-image: linear-gradient(180deg, #AA50C8 0%, #030203 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                >
                    Your Hub for ClearTax Insights and Resources
                </h2>

                <!-- Description -->
                <p
                    class="text-base sm:text-lg max-w-138 text-[#291952] leading-normal mb-7"
                >
                    Explore webinars, case studies, whitepapers, blogs, newsroom updates, and product guides designed to simplify tax, compliance, and finance.
                </p>
            </div>

            <div
                class="flex-1 flex flex-col items-center justify-center premium-reveal [transition-delay:500ms] w-full max-w-full relative"
            >
                <!-- Swiper container takes fixed width and allows overflow for side slides -->
                <div class="swiper hero-swiper w-full max-w-[240px] md:max-w-[280px] lg:max-w-[320px] xl:max-w-[380px] !overflow-visible">
                    <div class="swiper-wrapper items-center">
                        <!-- Slide 1: Webinar -->
                        <div class="swiper-slide w-full transition-transform duration-500 relative">
                            <img
                                src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7dbb133b6910f27f9e35de_swiper-img-3.png"
                                alt="Trigger"
                                class="w-full h-auto object-contain drop-shadow-2xl rounded-2xl"
                            />

                            <div class="absolute top-[8%] left-[5%] right-[5%] flex flex-col">
                              <h2 class="text-[32px] font-semibold font-['Nohemi'] text-white max-w-[216px] leading-[1.14]">5 New Notice Triggers in FY27</h2>
                              <p class="text-lg font-normal mt-4 font-['Nohemi'] text-white/70 max-w-[233px] leading-[1.14]">How AI Helps Stop Them Early</p>
                            </div>
                            
                            <!-- Profiles Side List -->
                            <div class="absolute right-[4%] top-[42%] -translate-y-1/2 flex flex-col gap-y-2 z-10">
                                <!-- Profile 1 -->
                                <div class="flex flex-row items-center gap-3 pl-2">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7eb5423ee1302d26e6cf8a_swiper-1-img-1.png" alt="Expert" class="w-12 h-12 object-cover rounded-full border-[1.5px] border-white/80" />
                                    <span class="text-white text-sm font-semibold tracking-wide">cleartax</span>
                                </div>
                                <!-- Separator -->
                                <div class="w-[60px] h-px bg-white/50 self-end mr-4"></div>
                                <!-- Profile 2 -->
                                <div class="flex flex-row items-center gap-3 pl-2">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7eb56825815f4164bff67c_swiper-1-img-2.png" alt="Expert" class="w-12 h-12 object-cover rounded-full border-[1.5px] border-white/80" />
                                    <div class="relative flex flex-col items-center justify-center">
                                        <span class="text-white text-[15px] font-bold tracking-tight leading-none mt-1">aws</span>
                                       <svg width="19" height="5" viewBox="0 0 19 5" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M17.0932 1.9093C15.0215 3.43169 12.0081 4.24782 9.43416 4.24782C5.80868 4.24782 2.54417 2.91376 0.0800958 0.68511C-0.108241 0.512468 0.064401 0.277047 0.299822 0.402604C2.96793 1.95638 6.24813 2.88237 9.65389 2.88237C11.9453 2.88237 14.4722 2.41153 16.795 1.42276C17.1246 1.28151 17.4228 1.65818 17.0932 1.9093Z" fill="#FF9900"/>
                                            <path d="M17.9407 0.936323C17.6739 0.591039 16.1986 0.779376 15.5237 0.857849C15.3197 0.889239 15.2883 0.700902 15.4766 0.575344C16.6537 -0.256478 18.5999 -0.0210565 18.8196 0.261449C19.0393 0.543954 18.7568 2.4901 17.6582 3.41609C17.4856 3.55734 17.3286 3.47887 17.4071 3.29053C17.6582 2.66274 18.2075 1.26591 17.9407 0.936323Z" fill="#FF9900"/>
                                        </svg>
                                    </div>
                                </div>
                                <!-- Separator -->
                                <div class="w-[60px] h-px bg-white/50 self-end mr-4"></div>
                                <!-- Profile 3 -->
                                <div class="flex flex-row items-center gap-3 pl-2">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7eb5700dc56e4e407ed790_swiper-1-img-3.png" alt="Expert" class="w-12 h-12 object-cover rounded-full border-[1.5px] border-white/80" />
                                    <span class="text-white text-sm font-semibold tracking-wide">cleartax</span>
                                </div>
                                <!-- Separator -->
                                <div class="w-[60px] h-px bg-white/50 self-end mr-4"></div>
                                <!-- Profile 4 -->
                                <div class="flex flex-row items-center gap-3 pl-2">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7eb5423ee1302d26e6cf8a_swiper-1-img-1.png" alt="Expert" class="w-12 h-12 object-cover rounded-full border-[1.5px] border-white/80" />
                                    <span class="text-white text-sm font-semibold tracking-wide">cleartax</span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Slide 2: Notices -->
                        <div class="swiper-slide w-full transition-transform duration-500 relative">
                            <img
                                src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7dbb06aa585f9a2e59b68f_swiper-img-1.png"
                                alt="Webinar"
                                class="w-full h-auto object-contain drop-shadow-2xl rounded-2xl"
                            />

                            <div class="absolute top-[8%] left-[5%] right-[5%] flex flex-col">
                              <h2 class="text-[32px] font-semibold font-['Nohemi'] text-white max-w-[216px] leading-[1.14]">5 New Notice Triggers in FY27</h2>
                              <p class="text-lg font-normal mt-4 font-['Nohemi'] text-white/70 max-w-[233px] leading-[1.14]">How AI Helps Stop Them Early</p>
                            </div>
                            
                            <!-- Profile Pic Placeholders Overlay -->
                            <div class="absolute bottom-[8%] left-[5%] right-[5%] flex items-center min-h-[75px] justify-between border border-white/20 rounded-2xl px-1 bg-white/5 backdrop-blur-sm shadow-inner">
                                <!-- Profile 1 -->
                                <div class="flex-1 flex flex-col items-center justify-center p-1">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7da211d1b9e4f49b3fbfe9_Expert%204%20Container.png" alt="Expert" class="w-14 h-auto object-contain -mt-5 relative z-10" />
                                </div>
                                <!-- Separator -->
                                <div class="w-px h-10 bg-white/20"></div>
                                <!-- Profile 2 -->
                                <div class="flex-1 flex flex-col items-center justify-center p-1">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7da21a24a8ab2de288abd3_Expert%203%20Container.png" alt="Expert" class="w-14 h-auto object-contain -mt-3 relative z-10" />
                                </div>
                                <!-- Separator -->
                                <div class="w-px h-10 bg-white/20"></div>
                                <!-- Profile 3 -->
                                <div class="flex-1 flex flex-col items-center justify-center p-1">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7da2211b4494486178542d_Expert%202%20Container.png" alt="Expert" class="w-14 h-auto object-contain -mt-5 relative z-10" />
                                </div>
                                <!-- Separator -->
                                <div class="w-px h-10 bg-white/20"></div>
                                <!-- Profile 4 -->
                                <div class="flex-1 flex flex-col items-center justify-center p-1">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7da211d1b9e4f49b3fbfe9_Expert%204%20Container.png" alt="Expert" class="w-14 h-auto object-contain -mt-5 relative z-10" />
                                </div>
                            </div>
                        </div>
                        
                        <!-- Slide 3: Trigger -->
                        <div class="swiper-slide w-full transition-transform duration-500 relative">
                            <img
                                src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7dbb0b8865d9839cbff268_swiper-img-2.png"
                                alt="Notices"
                                class="w-full h-auto object-contain drop-shadow-2xl rounded-2xl"
                            />

                            <div class="absolute top-[8%] left-[5%] right-[5%] flex flex-col">
                              <h2 class="text-[32px] font-semibold font-['Nohemi'] text-white max-w-[216px] leading-[1.14]">5 New Notice Triggers in FY27</h2>
                              <p class="text-lg font-normal mt-4 font-['Nohemi'] text-white/70 max-w-[233px] leading-[1.14]">How AI Helps Stop Them Early</p>
                            </div>
                            
                            <!-- Profile Pic Placeholders Overlay -->
                            <div class="absolute bottom-[8%] w-full left-0 right-0 flex items-center min-h-[75px] justify-between border-y border-white/20 px-2 bg-white/5 backdrop-blur-sm shadow-inner">
                                <!-- Profile 1 -->
                                <div class="flex-1 flex flex-col items-center justify-center p-1">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7da211d1b9e4f49b3fbfe9_Expert%204%20Container.png" alt="Expert" class="w-14 h-auto object-contain -mt-5 relative z-10" />
                                </div>
                                <!-- Separator -->
                                <div class="w-px h-10 bg-white/20 mt-3"></div>
                                <!-- Profile 2 -->
                                <div class="flex-1 flex flex-col items-center justify-center p-1">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7da21a24a8ab2de288abd3_Expert%203%20Container.png" alt="Expert" class="w-14 h-auto object-contain -mt-3 relative z-10" />
                                </div>
                                <!-- Separator -->
                                <div class="w-px h-10 bg-white/20 mt-3"></div>
                                <!-- Profile 3 -->
                                <div class="flex-1 flex flex-col items-center justify-center p-1">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7da2211b4494486178542d_Expert%202%20Container.png" alt="Expert" class="w-14 h-auto object-contain -mt-5 relative z-10" />
                                </div>
                                <!-- Separator -->
                                <div class="w-px h-10 bg-white/20 mt-3"></div>
                                <!-- Profile 4 -->
                                <div class="flex-1 flex flex-col items-center justify-center p-1">
                                    <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7da211d1b9e4f49b3fbfe9_Expert%204%20Container.png" alt="Expert" class="w-14 h-auto object-contain -mt-5 relative z-10" />
                                </div>
                                <!-- Separator -->
                                <div class="w-px h-10 bg-white/20 mt-3"></div>
                                <!-- Profile 5 (+2) -->
                                <div class="flex-1 flex flex-col items-center justify-center p-1">
                                    <div class="w-12 h-12 md:w-14 md:h-14 rounded-full border border-dashed border-white/80 flex items-center justify-center -mt-5 relative z-10">
                                        <span class="text-white text-base md:text-lg font-semibold">+2</span>
                                    </div>
                                    <span class="text-white text-[8px] md:text-[10px] font-medium leading-[1.1] text-center mt-1">industry<br/>experts</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Navigation buttons -->
                    <div class="swiper-button-prev !w-10 !h-10 !bg-white rounded-full !text-black shadow-md after:!text-sm !-left-16 z-20"></div>
                    <div class="swiper-button-next !w-10 !h-10 !bg-white rounded-full !text-black shadow-md after:!text-sm !-right-16 z-20"></div>
                </div>
                
                <!-- Slide Text Content -->
                <div class="mt-8 flex flex-col items-center text-center">
                    <h2 class="text-[22px] leading-[1.4] font-medium text-[#1C0976] mb-3 max-w-[400px]">
                        5 New Notice Triggers in FY27 and How AI Helps Stop Them Early
                    </h2>
                    <a href="#" class="text-[#1C0976] font-semibold text-base transition-colors flex items-center gap-1">
                        <span class="underline decoration-1">Read Blog</span> <span class="text-lg leading-none">↗</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    function initHeroSwiper() {
      if (typeof Swiper === 'undefined') {
        setTimeout(initHeroSwiper, 50);
        return;
      }
      
      // Swiper needs more than 3 slides to smoothly loop a layout where 3 slides are visible at once.
      // We duplicate the existing 3 slides purely in the DOM so the HTML source stays clean.
      const wrapper = document.querySelector('.hero-swiper .swiper-wrapper');
      if (wrapper && wrapper.children.length === 3) {
        const slides = Array.from(wrapper.children);
        slides.forEach(slide => {
          wrapper.appendChild(slide.cloneNode(true));
        });
      }

      new Swiper('.hero-swiper', {
        effect: 'creative',
        grabCursor: true,
        centeredSlides: true,
        slidesPerView: 'auto',
        initialSlide: 1,
        loop: true,
        speed: 500,
        creativeEffect: {
          prev: {
            translate: ['-38%', 0, -150],
            scale: 0.85,
          },
          next: {
            translate: ['38%', 0, -150],
            scale: 0.85,
          },
        },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        on: {
          setTranslate: function (swiper) {
            swiper.slides.forEach(slide => {
              const progress = Math.abs(slide.progress);
              // Keep center and immediate side cards fully visible
              // Fade out anything that goes beyond the first adjacent position
              let opacity = 1;
              if (progress > 1) {
                opacity = Math.max(0, 2 - progress);
              }
              slide.style.setProperty('--custom-opacity', opacity);
            });
          }
        }
      });
    }
    initHeroSwiper();
  });
</script>