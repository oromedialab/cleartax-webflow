---

<section class="w-full bg-[#FFFFFF] py-16 md:py-20 lg:py-25">
    <div class="lg:container mx-auto px-4 lg:px-6">
        
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
            <div class="max-w-2xl">
                <h2 class="text-[26px] sm:text-[36px] lg:text-[44px] font-semibold text-[#000000] leading-tight mb-3">
                    Read Latest Blogs
                </h2>
                <p class="text-[#000000]/80 max-w-170 text-lg font-normal">
                    Discover practical insights on tax, compliance, technology, & business finance.
                </p>
            </div>
            <a href="#" class="inline-flex items-center text-base text-[#1C0976] font-semibold hover:opacity-80 transition-opacity">
                View More 
                <svg class="w-3.5 h-3.5 ml-1.5" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.91602 11.084L11.0827 2.91732M11.0827 2.91732H4.66602M11.0827 2.91732V9.33398" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>
        
        <!-- Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {blogs.map((blog) => (
                <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow duration-300 flex flex-col border border-gray-100">
                    
                    <!-- Top Image Area -->
                    <div class="w-full relative overflow-hidden">
                        <img 
                            src={blog.imageSrc} 
                            class="w-full h-auto object-contain"
                        />
                    </div>
                    
                    <!-- Content Area -->
                    <div class="p-5 lg:py-6 lg:px-8 flex flex-col flex-1">
                        <!-- Tag -->
                        <div class="mb-5">
                            <span class="inline-flex px-5 py-1.5 bg-[#3A428D] text-white text-base font-semibold rounded-full">
                                {blog.tag}
                            </span>
                        </div>
                        
                        <!-- Title -->
                        <h3 class="text-lg font-medium text-[#000000] leading-[1.4] mb-2">
                            {blog.title}
                        </h3>

                        <!-- Date -->
                        {blog.date && (
                            <div class="flex items-center gap-1.5 text-base text-[#808080] font-medium">
                                <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
                                </svg>
                                {blog.date}
                            </div>
                        )}

                        <!-- Footer Area -->
                        <div class="mt-auto flex items-center justify-between pt-1">
                            <!-- Author -->
                            {blog.authorName && (
                                <div class="flex items-center gap-2.5">
                                    <img src={blog.authorImg} alt={blog.authorName} class="w-9 h-9 rounded-full object-cover border border-gray-200" />
                                    <span class="text-base text-[#000000] font-medium">{blog.authorName}</span>
                                </div>
                            )}
                            
                            <!-- Read Blog Link -->
                            <a href={blog.link} class="inline-flex items-center text-[#0E74FB] font-semibold text-base ml-auto">
                                Read Blog 
                                <svg class="w-3.5 h-3.5 ml-1.5" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M2.91602 11.084L11.0827 2.91732M11.0827 2.91732H4.66602M11.0827 2.91732V9.33398" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>