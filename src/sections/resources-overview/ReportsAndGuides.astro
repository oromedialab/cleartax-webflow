---
import { date } from "astro:schema"

const guides = [
    {
        bgImage: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7edf05c51b3199cd83822a_webinar-2.png",
        imageTextTitle: "The Enterprise Guide to<br/>Peppol Readiness",
        imageTextDesc: "How AI Helps Stop Them Early",
        tag: "Peppol",
        title: "The Enterprise Guide to Peppol Readiness And The Steps Needed To Prepare Confidently",
        date: "22 April 2026",
        readTime: "12 min read",
        linkText: "Read Guide",
        linkIcon: "arrow"
    },
    {
        bgImage: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7edf0e68e849b7ba485030_webinar-3.png",
        imageTextTitle: "The Complete GST<br/>Reconciliation Playbook",
        imageTextDesc: "Reconcile returns with<br/>confidence",
        tag: "Playbook",
        title: "The Complete GST Reconciliation Playbook. A Practical Guide To Staying Audit Ready",
        date: "22 April 2026",
        readTime: "18 min read",
        linkText: "Explore Playbook",
        linkIcon: "arrow"
    },
    {
        bgImage: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7edef18ff320d61a9cfcd2_webinar-1.png",
        imageTextTitle: "State of Global E-<br/>Invoicing 2026",
        imageTextDesc: "Mandates, Trends, and Global<br/>Updates",
        tag: "Report",
        title: "State of Global E-Invoicing 2026 And How It Shapes the future of electronic invoicing",
        date: "22 April 2026",
        readTime: "32 pages",
        linkText: "Download Report",
        linkIcon: "download"
    }
]
---

<section class="w-full bg-[#F9FAFB] py-16 md:py-20 lg:py-25">
    <div class="lg:container mx-auto px-4 lg:px-6">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
            <div class="max-w-198">
                <h2 class="text-[26px] sm:text-[36px] lg:text-[44px] font-semibold text-[#000000] leading-tight mb-3">
                    Reports & Guides
                </h2>
                <p class="text-[#000000]/80 max-w-198 text-lg font-normal">
                    Access in-depth research, practical guides, and playbooks for confident compliance decisions.
                </p>
            </div>
            <a href="#" class="inline-flex items-center text-base text-[#1C0976] font-semibold hover:opacity-80 transition-opacity whitespace-nowrap">
                View More 
                <svg class="w-3.5 h-3.5 ml-1.5" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.91602 11.084L11.0827 2.91732M11.0827 2.91732H4.66602M11.0827 2.91732V9.33398" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>

        <!-- Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {guides.map((guide) => (
                <div class="bg-white rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.08)] transition-shadow duration-300 flex flex-col border border-gray-100">
                    <!-- Top Image Area -->
                    <div class="w-full relative overflow-hidden h-[220px] sm:h-[240px]">
                        <img 
                            src={guide.bgImage} 
                            alt="" 
                            class="absolute inset-0 w-full h-full object-cover"
                        />
                        
                        <div class="absolute inset-0 p-4 lg:p-5 flex flex-col justify-start z-10">
                            <h3 class="text-[22px] sm:text-[24px] font-medium text-white mb-2 leading-[1.41] tracking-tight" set:html={guide.imageTextTitle}></h3>
                            <p class="text-base text-white/70 font-normal leading-[1.4]" set:html={guide.imageTextDesc}></p>
                        </div>
                    </div>

                    <!-- Bottom Content Area -->
                    <div class="p-6 lg:p-8 flex flex-col flex-1 bg-white relative z-10">
                        <span class="inline-flex items-center justify-center bg-[#3A428D] text-white text-base font-semibold px-4 py-2 rounded-full w-max mb-4">
                            {guide.tag}
                        </span>

                        <h4 class="text-lg font-medium text-[#000000] leading-[1.4] mb-2">
                            {guide.title}
                        </h4>

                        <div class="flex items-center gap-4 text-[#808080] text-base font-medium mb-7">
                            <div class="flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                {guide.date}
                            </div>
                            <div class="flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
                                </svg>
                                {guide.readTime}
                            </div>
                        </div>

                        <!-- Action Link -->
                        <div class="mt-auto">
                            <a href="#" class="inline-flex items-center text-[#0E74FB] font-semibold text-base transition-colors hover:text-blue-700">
                                {guide.linkText}
                                {guide.linkIcon === 'arrow' ? (
                                    <svg class="w-4 h-4 ml-1.5" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M2.91602 11.084L11.0827 2.91732M11.0827 2.91732H4.66602M11.0827 2.91732V9.33398" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                ) : (
                                    <svg class="w-4 h-4 ml-1.5" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M7 1.16666V10.5M7 10.5L3.5 7M7 10.5L10.5 7M1.16669 12.8333H12.8334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                )}
                            </a>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>