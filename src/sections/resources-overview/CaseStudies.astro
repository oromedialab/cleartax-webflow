---

<section class="w-full bg-[#F9FAFB] py-16 md:py-20 lg:py-25">
    <div class="lg:container mx-auto px-4 lg:px-6">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
            <div class="max-w-2xl">
                <h2 class="text-[26px] sm:text-[36px] lg:text-[44px] font-semibold text-[#000000] leading-tight mb-3">
                    Discover Case Studies
                </h2>
                <p class="text-[#000000]/80 max-w-170 text-lg font-normal">
                    See how leading businesses improve compliance with ClearTax.
                </p>
            </div>
            <a href="#" class="inline-flex items-center text-base text-[#1C0976] font-semibold hover:opacity-80 transition-opacity whitespace-nowrap">
                View More 
                <svg class="w-3.5 h-3.5 ml-1.5" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.91602 11.084L11.0827 2.91732M11.0827 2.91732H4.66602M11.0827 2.91732V9.33398" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>

        <!-- Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {caseStudies.map((study) => (
                <div class="bg-white rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.08)] transition-shadow duration-300 flex flex-col border border-gray-100">
                    <!-- Top Image Area -->
                    <div class="w-full relative overflow-hidden h-[220px] sm:h-[240px]">
                        <img 
                            src={study.bgImage} 
                            alt="" 
                            class="absolute inset-0 w-full h-full object-cover"
                        />
                        
                        <div class="absolute inset-0 p-6 lg:p-8 flex flex-col justify-start z-10">
                            <h3 class="text-[22px] sm:text-[24px] font-medium text-white mb-2 leading-[1.25] tracking-tight" set:html={study.imageTextTitle}></h3>
                            <p class="text-[14px] sm:text-[15px] text-white/90 font-light leading-[1.4] max-w-[85%]" set:html={study.imageTextDesc}></p>
                        </div>
                    </div>

                    <!-- Bottom Content Area -->
                    <div class="p-6 lg:p-8 flex flex-col flex-1 bg-white relative z-10">
                        <span class="inline-flex items-center justify-center bg-[#3A428D] text-white text-base font-medium px-4 py-1.5 rounded-full w-max mb-6 tracking-wide">
                            {study.tag}
                        </span>

                        <h4 class="text-lg font-medium text-[#000000] leading-[1.3] mb-8">
                            {study.title}
                        </h4>

                        <!-- Action Link -->
                        <div class="mt-auto">
                            <a href="#" class="inline-flex items-center text-[#0E74FB] font-semibold text-[14px] sm:text-[15px] transition-colors hover:text-blue-700">
                                {study.linkText}
                                <svg class="w-4 h-4 ml-1.5" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M2.91602 11.084L11.0827 2.91732M11.0827 2.91732H4.66602M11.0827 2.91732V9.33398" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
