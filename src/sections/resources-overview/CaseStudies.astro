        imageTextTitle: "Scaling ZATCA-<br/>Compliant Invoicing",
        imageTextDesc: "How a healthcare network<br/>stayed compliant",
        tag: "Manufacturing",
        title: "Scaling ZATCA-Compliant Invoicing Across a Growing Network",
        linkText: "Read Case Study"
    },
    {
        bgImage: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7edef18ff320d61a9cfcd2_webinar-1.png",
        imageTextTitle: "Scaling ZATCA-<br/>Compliant Invoicing",
        imageTextDesc: "How a healthcare network<br/>stayed compliant",
        tag: "Manufacturing",
        title: "Scaling ZATCA-Compliant Invoicing Across a Growing Network",
        linkText: "Read Case Study"
    },
    {
        bgImage: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7edf0e68e849b7ba485030_webinar-3.png",
        imageTextTitle: "Automating High-<br/>Volume E-Invoicing",
        imageTextDesc: "How a leading retailer<br/>streamlined invoice<br/>workflows",
        tag: "Retail",
        title: "How a Leading Retailer Automated High-Volume E-Invoicing",
        linkText: "Read Case Study"
    },
    {
        bgImage: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7edf05c51b3199cd83822a_webinar-2.png",
        imageTextTitle: "Centralising VAT<br/>Compliance",
