---
/**
 * Legal hero — same composition as `trust-centre/Hero.astro`: the shared
 * Flux Lime stroke field, a radial white wash for headline contrast, centred
 * headline with the page's single Flux Lime highlight on "Legal".
 *
 * Shorter than the Trust Centre hero — this is a reading page, so the body
 * (tab bar + agreements) starts right below.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

/* Grid geometry — identical to trust-centre/Hero.astro. */
const lineWidth = 3;
const gap = 24;
const maxLength = 6;
const lengthRadius = 260;
const tilt = 1;
const baseColor = "#C8F006";
const cursorRadius = 320;
const pull = 14;
const fadeRadius = 40;

const titleHighlight = "Legal";
const description =
  "The agreements that govern your use of ClearTax services.";
---

<section
  id="legal-hero"
  class="relative flex flex-col overflow-hidden bg-generic-00 max-lg:pt-32 max-lg:pb-12 lg:pt-[216px] lg:pb-20"
>
  <Dotgrid
    containerId="legal-hero"
    lineWidth={lineWidth}
    gap={gap}
    maxLength={maxLength}
    lengthRadius={lengthRadius}
    tilt={tilt}
    baseColor={baseColor}
    cursorRadius={cursorRadius}
    pull={pull}
    fadeRadius={fadeRadius}
  />

  <!-- Radial wash, so the headline keeps its contrast over the field -->
  <div
    class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)]"
  >
  </div>

  <div class="container pointer-events-auto relative z-10 mx-auto">
    <div class="mx-auto flex max-w-[688px] flex-col items-center gap-6 text-center">
      <h1
        class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] lg:text-[length:var(--fs-display-lg)] lg:leading-[length:var(--lh-display-lg)] tracking-[-1px]"
      >
        <span class="rounded-xl px-1 text-vault-navy"
          >{titleHighlight}</span
        >
      </h1>
      <p
        class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-lg)] sm:leading-[length:var(--lh-body-lg)]"
      >
        {description}
      </p>
    </div>
  </div>
</section>
