---

const Leaders = [
    {
        img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c38e1ba10b568d7349d1c_Logo-1.png',
        desc: "ClearTax has transformed the way we handle GST compliance. Real-time creation of e-Invoices and e-Way bills plays a significant role in providing us with critical insight into our business.",
        name: "Pratush Kumar",
        role: "DGM-IT, JK Tyre",
        place: "India"
    },
    {
        img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c38e8493b8aa05903e536_Logo-2.png',
        desc: "ClearTax is simplifying e-Invoicing They enabled us to implement the e-Invoicing system in time and handled all our business complexities with ease. Thank you for the effort and good job!",
        name: "Raj Kiran",
        role: "Head, Taxation & Retail Finance, Puma",
        place: "India"
    },
    {
        img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c38eeb29d8c48e4fac8f1_Logo-3.png',
        desc: "We appreciate ClearTax for successfully completing the complex ZATCA E-Invoicing Phase II Integration project. Their platform enabled seamless management of multiple business units. Kudos to the team for their timely delivery.",
        name: "Abdulbary Atassi",
        role: "DIRECTOR OF IT, Zamil Industrial",
        place: "Saudi Arabia"
    },
    {
        img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8d25ef944ad3a1f9ed2d7f_Logo-4.png',
        desc: "Collaborating with ClearTax was an exceptional experience. They streamlined the entire process, even under tight deadlines, worked closely to address the unique challenges of e-invoice integration with our diverse ERP systems.",
        name: "V Bharathy",
        role: "Manager, Finance Applications, Gamuda Land",
        place: "Malaysia"
    },
    {
        img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8d25ef2309578fd6d29736_Logo-5.png',
        desc: "Salam's search for a reliable partner ended with ClearTax. Their tailored solutions ensured a smooth transition for all 8 of our systems in just 3 months.",
        name: "Arslan Choudhary",
        role: "Director of Enterprise Enablement, Salam Telco",
        place: "Saudi Arabia"
    }
];

---

<section class="bg-[#FEFEFE] py-12 lg:py-20">
    <div class="mx-auto lg:container w-full px-4 lg:px-6">

        <div class="text-center mb-12 max-w-195 mx-auto">
            <h2 class="text-[26px] sm:text-[32px] lg:text-[40px] font-medium leading-[1.2]">Trusted by industry leaders across the world</h2>
        </div>

        <div class="swiper trusted-swiper" style="mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);">
            <div class="swiper-wrapper !items-stretch">
                {
                    Leaders.map((items) => (
                        <div class="swiper-slide !h-auto !flex">
                            <div class="flex flex-col p-6 lg:p-8 bg-white w-full h-full border border-[#CCCCCC] rounded-xl">
                                <img src={items.img} alt={items.name} loading="lazy" decoding="async" class="h-[80px] w-[80px] rounded-[16px] mb-8" />
                                <p class="text-[#05022AB2] font-normal text-lg leading-[1.55] mb-6">{items.desc}</p>
                                <div class="mt-auto">
                                    <h3 class="text-[#05022A] font-semibold text-[16px] mb-1">{items.name}</h3>
                                    <p class="text-[#05022AB2] font-medium text-[14px] mb-1">{items.role}</p>
                                    <p class="text-[#05022AB2] font-medium text-[14px]">{items.place}</p>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
        new Swiper('.trusted-swiper', {
            slidesPerView: 1.2,
            spaceBetween: 16,
            loop: true,
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
            },
            grabCursor: true,
            breakpoints: {
                640: {
                    slidesPerView: 2.2,
                    spaceBetween: 20,
                },
                1024: {
                    slidesPerView: 3,
                    spaceBetween: 24,
                }
            }
        });
    });
</script>