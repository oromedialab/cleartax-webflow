/* Cards shown before "Load more", and how many each click adds. */
const batch = 6;
---

<section id="press-leadership" class="bg-generic-00 py-12 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div class="flex flex-col items-center gap-12">
      <h2
        class="m-0 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[var(--lh-h1)] tracking-[var(--tracking-heading)]"
      >
        Leadership perspectives
      </h2>

      <div
        data-lead-grid
        data-batch={batch}
        class="grid w-full grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
      >
        {
          perspectives.map((item) => (
            <a
              href={item.href || undefined}
              target={item.href ? "_blank" : undefined}
              rel={item.href ? "noopener noreferrer" : undefined}
              data-lead-card
              class="flex flex-col gap-4 rounded-xl border border-neutral-300 bg-generic-00 p-6 no-underline hover:border-nova-blue transition-all ease-in-out duration-150 cursor-pointer"
            >
              <span class="font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[var(--lh-body)]">
                {item.date}
              </span>
              <div class="flex flex-col gap-2.5">
                <span class="font-body font-semibold uppercase text-nova-blue text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)] tracking-[var(--tracking-overline)]">
                  {item.source}
                </span>
                <span class="line-clamp-2 min-h-14 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[var(--lh-body-lg)]">
                  {item.title}
                </span>
                {/* Clamped so a long excerpt can't leave one card in the row
                    taller than its neighbours. `line-clamp-*` sets
                    `display: -webkit-box`, which is what lets it work on a
                    span. */}
                <span class="line-clamp-2 min-h-12 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[var(--lh-body)]">
                  {item.excerpt}
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <button
        type="button"
        data-lead-more
        class="inline-flex h-10 cursor-pointer items-center justify-center gap-2 rounded-lg border border-neutral-200 bg-generic-00 px-4 py-2.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[var(--lh-label)] no-underline shadow-[0px_1px_2px_0px_rgba(16,24,40,0.04)] transition-all ease-in-out duration-150 hover:border-neutral-400 hover:bg-neutral-50"
      >
        Load more
      </button>
    </div>
  </div>
</section>

<style is:global>
  /* `hidden` alone loses to the `flex` / `inline-flex` utilities on these. */
  [data-lead-card][hidden],
  [data-lead-more][hidden] {
    display: none;
  }
</style>

<script is:inline>
  (function () {
    function initPressLeadership() {
      var root = document.getElementById("press-leadership");
      if (!root || root.dataset.leadReady) return;
      root.dataset.leadReady = "true";
      var grid = root.querySelector("[data-lead-grid]");
      var more = root.querySelector("[data-lead-more]");
      var cards = grid.querySelectorAll("[data-lead-card]");
      var batch = parseInt(grid.getAttribute("data-batch"), 10) || 6;
      var shown = batch;
      // `hidden` attribute, so with no script every card still shows.
      function render() {
        for (var i = 0; i < cards.length; i++) cards[i].hidden = i >= shown;
        more.hidden = shown >= cards.length;
      }
      more.addEventListener("click", function () {
        shown += batch;
        render();
      });
      render();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPressLeadership);
    } else {
      initPressLeadership();
    }
  })();
</script>
