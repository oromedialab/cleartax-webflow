  },
  {
    date: "16 April, 2023",
    source: "The Economic Times",
    title: "Crypto taxation in India: What NRIs needs to know",
    excerpt:
      "India has clarified the tax implications of Virtual Digital Assets (VDAs), including cryptocurrencies and non-fungible tokens, brought under...",
    href: "https://economictimes.indiatimes.com/nri/invest/crypto-taxation-in-india-what-nris-needs-to-know/articleshow/99531108.cms",
  },
  {
    date: "15 April, 2023",
    source: "ET CIO",
    title:
      "Clear takes an ambitious leap to build a connected finance ecosystem",
    excerpt:
      "Clear's founder-CEO, Archit Gupta, outlines how clear is attempting to create a connected finance ecosystem that will help organizations...",
    href: "https://cio.economictimes.indiatimes.com/news/next-gen-technologies/clear-takes-an-ambitious-leap-to-build-a-connected-finance-ecosystem/99507474",
  },
  {
    date: "3 April, 2023",
    source: "News18",
    title: "These 5 GST changes have become applicable from April 1",
