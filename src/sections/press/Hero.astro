---

<!-- No `overflow-hidden` anywhere on the way down to the sticky elements: an
     ancestor with a non-visible overflow becomes the scroll container and
     `position: sticky` silently stops working. The wash below is `inset-0`, so
     there is nothing to clip anyway.

     Top padding: the fixed navbar's bottom edge lands at 82px (`--nav-clear` is
     112px, which includes its breathing room), so 128px left the card almost
     touching the bar. 160px is the gap the mock reads as; the mock's own 200px
     was measured in a frame that draws no navbar at all. -->
<section
  id="press-hero"
  class="press-hero relative bg-generic-00 pt-28 pb-12 md:pt-40 md:pb-16"
>
  <!-- Cap above the floating navbar. The bar sits 16px below the viewport top,
       so without this the cards scroll through that strip in plain sight.
       Hidden until the page scrolls so it does not sit as a white bar over the
       wash at the top. Just under the navbar's z-[1000]. -->
  <div
    class="press-nav-cap pointer-events-none fixed inset-x-0 top-0 z-[999] h-10 bg-generic-00 opacity-0 transition-opacity duration-150"
    aria-hidden="true"
  >
  </div>

  <!-- Vertical wash standing in for the exported BG gradient. -->
  <div
    class="absolute inset-0 z-0 pointer-events-none bg-[linear-gradient(180deg,_rgba(242,241,240,0.6)_0%,_rgba(255,255,255,0)_45%,_rgba(255,255,255,0)_100%)]"
  >
  </div>

  <div
    class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6 relative z-10"
  >
    <!-- Auto-height, NOT the mock's fixed 722px. The card is as tall as the
         longer list, the page scrolls through it normally, and the left column
         sticks so it stays alongside the whole way down. Nothing intercepts
         the wheel and there is no inner scrollbar. -->
    <div
      class="grid grid-cols-1 rounded-xl border border-neutral-200 bg-generic-00 lg:grid-cols-2 lg:gap-8"
    >
      <!-- Each half runs flush to the 32px gutter between them — that is where
           the marquee fade and the rule under it are meant to die out, so the
           inner padding is dropped on the facing edge. -->
      <!-- ============ Left: opener, marquee, testimonial (sticky) ========= -->
      <div class="p-6 md:pt-8 lg:pr-0">
        <div class="flex flex-col gap-6 lg:sticky lg:top-28">
          <div class="flex flex-col gap-6">
            <h1
              class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h1)] leading-[var(--lh-h1)] lg:text-[length:var(--fs-display-lg)] lg:leading-[var(--lh-display-lg)] tracking-[var(--tracking-heading)]"
            >
              Press
            </h1>
            <p
              class="m-0 max-w-[498px] font-heading font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[var(--lh-body-lg)] lg:text-[length:var(--fs-h5)] lg:leading-[var(--lh-h5)]"
            >
              The latest stories, press coverage, and media resources from the
              fastest-growing financial technology platform.
            </p>
          </div>

          <!-- Fixed height at every width: the column is sticky, so there is no
               card height left over for the strip to absorb. -->
          <div class="press-marquee relative h-[218px] w-full overflow-hidden">
            <div class="press-marquee-track">
              {
                [...visuals, ...visuals].map((visual, index) => (
                  <div
                    class="press-marquee-item h-full w-[200px] shrink-0 overflow-hidden rounded-lg"
                    aria-hidden={index >= visuals.length ? "true" : undefined}
                  >
                    <img
                      src={visual.image}
                      alt={visual.alt}
                      width="200"
                      height="218"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  </div>
                ))
              }
            </div>
          </div>

          <div class="flex flex-col gap-6">
            <div
              aria-hidden="true"
              class="h-0.5 w-full rounded-full bg-ledger-200"
            >
            </div>
            <div class="flex flex-col gap-4">
              <p
                class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[var(--lh-body)]"
              >
                {testimonial.quote}
              </p>
              <div class="flex flex-col gap-1">
                <span
                  class="font-body font-medium text-vault-navy text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)]"
                  >{testimonial.name}</span
                >
                <span
                  class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-xs)] leading-[var(--lh-body-xs)]"
                  >{testimonial.role}</span
                >
                <span
                  class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-xs)] leading-[var(--lh-body-xs)]"
                  >{testimonial.place}</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ============ Right: tabbed index (thumbs -> panels) ============ -->
      <div class="flex flex-col gap-6 p-6 lg:pl-0">
        <!-- Sticky dock for the pill. The white backdrop is the point: with a
             bare sticky pill, cards scrolled through the band between the
             floating navbar's bottom edge and the top of the pill, in plain
             sight.

             `pt-6 -mt-6` is what makes the backdrop safe. The padding grows the
             white box upward by exactly the column's own 24px top padding, and
             the negative margin pulls the box up by the same 24px — so the pill
             stays put, and the backdrop's top edge lands exactly on the card's
             padding box. Not a pixel higher, so at rest it covers only the
             card's own white and never paints over the section wash above it.

             It sticks at 82px, the navbar's bottom edge (`--nav-clear` is that
             82 plus 30px of breathing room). Anything larger reopens the band
             the backdrop exists to close. -->
        <div
          class="press-tabs-dock sticky top-[82px] z-10 -mt-6 bg-generic-00 pt-6"
        >
          <div
            class="swiper press-tabs-swiper w-full shrink-0 rounded-xl bg-neutral-100 !px-1 !py-1.5"
            role="tablist"
            aria-label="Newsroom categories"
          >
            <div class="swiper-wrapper">
              {
                panels.map((panel, index) => (
                  <div class="swiper-slide">
                    <button
                      type="button"
                      role="tab"
                      id={`press-tab-${panel.key}`}
                      aria-controls={`press-panel-${panel.key}`}
                      aria-selected={index === 0 ? "true" : "false"}
                      data-press-tab={panel.key}
                      class="press-tab w-full cursor-pointer rounded-lg border-0 bg-transparent px-6 py-2 font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[var(--lh-label)] transition-colors duration-150"
                    >
                      {panel.tab}
                    </button>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Main swiper: one slide per list, at its natural full height. No
             inner scrollbar — the page scroll IS the list's scroll, and the
             "Load more" button is the last thing in it. -->
        <div class="swiper press-panels-swiper w-full">
          <div class="swiper-wrapper">
            {
              panels.map((panel) => (
                <div
                  class="swiper-slide !h-auto"
                  id={`press-panel-${panel.key}`}
                  role="tabpanel"
                  aria-labelledby={`press-tab-${panel.key}`}
                >
                  <div class="flex flex-col gap-6" data-batch={batch}>
                    {/* An <a> with no href is valid, inert markup — so an item
                        can be listed before its URL exists. */}
                    {panel.items.map((item) => (
                      <a
                        href={item.href || undefined}
                        target={item.href ? "_blank" : undefined}
                        rel={item.href ? "noopener noreferrer" : undefined}
                        class="press-card"
                      >
                        <div class="press-card-top">
                          <span>{item.date}</span>
                          <span class="press-card-badge">{panel.badge}</span>
                        </div>
                        <div class="press-card-body">
                          <span class="press-card-src">{item.source}</span>
                          <span class="press-card-title">{item.title}</span>
                          <span class="press-card-text">{item.excerpt}</span>
                        </div>
                      </a>
                    ))}

                    <button
                      type="button"
                      data-press-more
                      class="mx-auto cursor-pointer inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-lg border border-neutral-200 bg-generic-00 px-4 py-2.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[var(--lh-label)] no-underline shadow-[0px_1px_2px_0px_rgba(16,24,40,0.04)] transition-all ease-in-out duration-150 hover:border-neutral-400 hover:bg-neutral-50"
                    >
                      Load more
                    </button>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<style is:global>
  /* Index cards. Written as classes, not utilities, on purpose: the lists now
     hold ~60 cards, and the utility strings alone pushed this Embed past the
     50 KB cap into three pastes. Values are the utilities they replace. */
  .press-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border: 1px solid var(--color-neutral-300);
    border-radius: 12px;
    background: var(--color-generic-00);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-neutral-500);
  }
  .press-card[hidden],
  [data-press-more][hidden] {
    display: none;
  }
  .press-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .press-card-badge {
    flex-shrink: 0;
    border-radius: 8px;
    background: var(--color-nova-blue);
    padding: 6px 12px;
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    color: var(--color-generic-00);
  }
  .press-card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .press-card-src {
    font-weight: 600;
    text-transform: uppercase;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    letter-spacing: var(--tracking-overline);
    color: var(--color-nova-blue);
  }
  .press-card-title {
    font-weight: 600;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--color-vault-navy);
  }

  /* Marquee. The gap lives on each tile as a right margin rather than on the
     track, so the duplicated half is exactly 50% of the track width and
     translateX(-50%) loops seamlessly with no gap arithmetic. */
  .press-nav-cap.is-on {
    opacity: 1;
  }

  .press-marquee-track {
    display: flex;
    width: max-content;
    height: 100%;
    animation: press-marquee-scroll 32s linear infinite;
  }

  .press-marquee-item {
    margin-right: 16px;
  }

  .press-marquee:hover .press-marquee-track {
    animation-play-state: paused;
  }

  @keyframes press-marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .press-marquee-track {
      animation: none;
    }
  }

  /* Edge fade — the rotated white overlay in the mock. */
  .press-marquee {
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  /* Selected tab. Three classes (0,3,0) so it outranks both the unlayered
     Tailwind utilities on the element and anything the Swiper stylesheet sets
     from inside the Embed. */
  .press-tabs-swiper .swiper-slide-thumb-active .press-tab {
    background-color: var(--color-generic-00);
    color: var(--palette-navy-600);
    box-shadow:
      0 1px 2px 0 rgba(16, 24, 40, 0.04),
      0 1px 2px 0 rgba(16, 24, 40, 0.04);
  }

  /* Swiper sets `height: 100%` on `.swiper-slide`, which would collapse a
     natural-height list to nothing. `autoHeight` in the init sizes the wrapper
     to the active slide; this lets the slide size to its own content first.
     One class each, so it wins on source order — the section's <style> ships
     inside the Embed, i.e. after both the page bundle in the <head> and the
     Swiper CDN stylesheet above. */
  .press-panels-swiper .swiper-slide {
    height: auto;
    align-self: flex-start;
  }
</style>

<script is:inline>
  (function () {
    function initPressHero() {
      if (typeof Swiper === "undefined") return;
      var root = document.getElementById("press-hero");
      if (!root || root.dataset.pressReady) return;
      root.dataset.pressReady = "true";

      var cap = root.querySelector(".press-nav-cap");
      function syncCap() {
        cap.classList.toggle("is-on", window.pageYOffset > 8);
      }
      window.addEventListener("scroll", syncCap, { passive: true });
      syncCap();

      // Thumbs first — the panels swiper takes the instance as a prop.
      var tabs = new Swiper(".press-tabs-swiper", {
        slidesPerView: 2,
        spaceBetween: 4,
        allowTouchMove: false, // a control, not a rail
        slideToClickedSlide: true,
        watchSlidesProgress: true, // required by the thumbs module
      });

      var panels = new Swiper(".press-panels-swiper", {
        slidesPerView: 1,
        spaceBetween: 24,
        // The two lists are different lengths; without this the wrapper would
        // size to the taller one and the shorter tab would end in dead space.
        autoHeight: true,
        grabCursor: true,
        thumbs: { swiper: tabs },
      });

      // Swiper owns the tab's visual state; this only mirrors it onto the ARIA
      // attributes. Switching to a shorter list while scrolled deep would drop
      // you into the section below, so pull back to the top of the list — but
      // only when the switch happened from past that point.
      // "Load more": each list starts at `data-batch` cards and reveals that many
      // more per click. Cards are hidden with the `hidden` attribute, so with no
      // script every card still shows. autoHeight must be told the list grew.
      var lists = root.querySelectorAll("[data-batch]");
      for (var l = 0; l < lists.length; l++) {
        (function (list) {
          var batch = parseInt(list.getAttribute("data-batch"), 10) || 5;
          var cards = list.querySelectorAll(".press-card");
          var more = list.querySelector("[data-press-more]");
          var shown = batch;
          function render() {
            for (var c = 0; c < cards.length; c++) cards[c].hidden = c >= shown;
            more.hidden = shown >= cards.length;
            panels.updateAutoHeight(0);
          }
          more.addEventListener("click", function () {
            shown += batch;
            render();
          });
          render();
        })(lists[l]);
      }

      panels.on("slideChange", function () {
        var buttons = root.querySelectorAll("[data-press-tab]");
        for (var i = 0; i < buttons.length; i++) {
          buttons[i].setAttribute(
            "aria-selected",
            i === panels.activeIndex ? "true" : "false",
          );
        }

        var navClear =
          parseFloat(
            getComputedStyle(document.documentElement).getPropertyValue(
              "--nav-clear",
            ),
          ) || 112;
        var top = panels.el.getBoundingClientRect().top;
        if (top < navClear) {
          window.scrollTo({
            top: window.pageYOffset + top - navClear,
            behavior: "smooth",
          });
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPressHero);
    } else {
      initPressHero();
    }
  })();
</script>
