---
/**
 * Navbar for the French France regional page — the paste unit.
 *
 * Same shape as the Germany regional navbar: About / Product / Resources /
 * Contact, no Country group (NavbarRb ships its own country panel). Labels are
 * French; resource links are the ones on the live cleartax.com/fr menu.
 *
 * Structure, styling and behaviour live in `_shared/NavbarRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file, because
 * the embed route renders sections with no props.
 *
 * TODO Press, Careers and Partner program keep the cleartax.com URLs from the
 * Germany menu — confirm they are right for the French site.
 */
import NavbarRb from "../_shared/NavbarRb.astro";
import type { NavLink } from "../_shared/NavbarRb.astro";

const links: NavLink[] = [
  { label: "À propos", href: "https://www.cleartax.com/about-us" },
  {
    label: "Produit",
    dropdown: [
      {
        label: "Facturation électronique en France",
        href: "https://www.cleartax.com/fr/en/e-invoicing-software",
      },
      {
        label: "Facturation électronique mondiale",
        href: "https://www.cleartax.com/global/e-invoicing-solution",
      },
    ],
  },
  {
    label: "Ressources",
    dropdown: [
      {
        label: "Blogue",
        href: "https://www.cleartax.com/fr/facturation-electronique-france",
      },
      { label: "Webinaire", href: "https://7giy8.app.link/e/o0RuZugLMZb" },
      { label: "Étude de cas", href: "https://files.clear.in/xuJE2vFf4nT" },
      { label: "Livre blanc", href: "https://files.clear.in/Qe54U6OabS8" },
    ],
  },
  {
    label: "Contact",
    dropdown: [
      { label: "Presse", href: "https://www.cleartax.com/press" },
      { label: "Carrières", href: "https://www.cleartax.com/careers" },
      {
        label: "Programme partenaires",
        href: "https://www.cleartax.com/global/partner-program",
      },
      {
        label: "Contactez-nous",
        href: "https://www.cleartax.com/contact-us",
      },
    ],
  },
];
---

<NavbarRb
  links={links}
  ctaLabel="Réserver une démo"
  countryLabel="France"
  countrySelectLabel="Choisir un pays"
  comingSoonLabel="bientôt disponible"
  countryNames={{
    Bahrain: "Bahreïn",
    Belgium: "Belgique",
    Germany: "Allemagne",
    India: "Inde",
    KSA: "Arabie saoudite",
    Malaysia: "Malaisie",
    Norway: "Norvège",
    Oman: "Oman",
    Philippines: "Philippines",
    Singapore: "Singapour",
    Slovakia: "Slovaquie",
    Spain: "Espagne",
    UAE: "Émirats arabes unis",
  }}
  countryFlag="https://cdn.prod.website-files.com/6141e3720a248d2024615d96/64999768870655432964457d_france_flag.png"
  ctaOpensModal
/>
