---
/**
 * "How ClearTax supports e-invoicing & e-reporting" — Figma node 13600:29579,
 * with the detail overlay from node 13692:38201 and the card copy from
 * node 13692:28442.
 *
 * Six cards in a 2-column grid. A card is a button: clicking it opens ONE
 * overlay dialog showing that card's heading, body and visual, with prev/next
 * chevrons to walk the other five without closing.
 *
 * The overlay renders the layout ONCE and swaps only the parts that differ per
 * card — the six headings and six bodies sit in the DOM with `hidden` on all but
 * the active one. Repeating the whole panel six times would ship six copies of
 * the chevrons, the close control and the image frame for no gain, and every
 * byte here is a Webflow Embed byte.
 *
 * Modal mechanics follow `france-regional/DemoModal.astro`: display is swapped
 * INLINE rather than by toggling a `hidden` class, because the utilities pasted
 * into Webflow are unlayered and `flex` vs `hidden` on one element would race on
 * source order. The per-card headings and bodies use the `hidden` ATTRIBUTE
 * instead, which is safe there only because those elements carry no display
 * utility of their own — don't add one.
 *
 * The icon squares and the overlay visual are unfilled "Icon placeholder" /
 * "Image" frames in the Figma, so they render as `bg-visual-placeholder` — the
 * token is #E8FFE1, exactly the fill the design uses. Swap each for a
 * Webflow-hosted URL when the artwork lands — never a `data:` URI.
 *
 * Ids are `fr-supports-` prefixed: embeds share one namespace per page.
 */
interface SupportCard {
  heading: string;
  body: string;
  icon: string;
  img: string;
}

const cards: SupportCard[] = [
  {
    heading: "Une architecture prête pour le rôle de PA et conforme au modèle en Y",
    body: "Le modèle en Y français répartit clairement les rôles (acheminement, validation, mises à jour de statuts et déclaration fiscale) via des plateformes certifiées. Le cycle de vie complet en 14 statuts, du dépôt au paiement, est pris en charge.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acc750e1199ab5fcce6583c_icon-1.png",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af41925f39751ac97e8ed33_pa-img.png",
  },
  {
    heading: "Assistance 24h/24, 7j/7",
    body: "Des Customer Success Managers dédiés, une assistance technique et fonctionnelle disponible à tout moment, et des experts fiscaux en interne qui analysent les évolutions de la DGFiP et les traduisent en mises à jour du produit.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acc751cf993e067e02a2ce1_icon-2.png",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acc75ddfc112b443e1753e6_image-5.png",
  },
  {
    heading: "Une plateforme mondiale unique, des API unifiées",
    body: "Une seule plateforme et une API unifiée pour plus de 50 pays, pour que vos entités françaises puissent réutiliser la même intégration. Les évolutions de l’obligation en France ne nécessitent en général que des mises à jour côté cloud, sans retouche de l’ERP, ce qui réduit les coûts et les risques IT à long terme.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acc751ff2094eb23a6a4344_icon-3.png",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acc75e1ee76a28b31800567_Image-6.png",
  },
  {
    heading: "Une expérience d’intégration éprouvée et des accélérateurs",
    body: "Plus de 2 500 intégrations réalisées et plus de 100 ERP et systèmes sources connectés (SAP ECC/S4, Oracle, MS Dynamics, NetSuite, caisses, retail, télécoms, etc.). Un agent d’intégration piloté par l’IA, des connecteurs légers et des checklists de recette structurées réduisent le délai de mise en route de plusieurs semaines à quelques jours.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acc75231199ab5fcce668c8_icon-4.png",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acc75e538881bba417152e1_image-7.png",
  },
  {
    heading: "Sécurité, disponibilité et analyses de niveau entreprise",
    body: "ISO 27001, SOC 2, conformité RGPD, hébergement régional, tests d’intrusion et d’analyse de vulnérabilités (VAPT), gestion des accès par rôles (RBAC), et aucune faille de sécurité signalée. Supervision quasi temps réel, disponibilité supérieure à 99,8 %, et tableaux de bord MIS détaillés pour le suivi des erreurs, la prévention des avis de l’administration fiscale et le rapprochement TVA/factures électroniques.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acc7528b4d5b0c8166478b6_icon-5.png",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acc75e94f1bfe253bdcc4eb_image-8.png",
  },
  {
    heading: "Conformité assurée, prête pour l’audit et pérenne",
    body: "Un dispositif de conformité couvrant le rapprochement pour éviter les écarts de TVA et intégrant les évolutions futures de l’obligation, afin de réduire les risques de pénalités et de contrôles fiscaux.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acc752cb4d5b0c8166479b1_icon-6.png",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af4191e0dcdd5aa14528113_cmp-image.png",
  },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full px-4 md:px-6 mx-auto">
    <h2
      class="m-0 mb-8 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] lg:mb-12"
    >
      Comment ClearTax vous accompagne pour la facturation électronique et l’e-reporting
    </h2>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
      {
        cards.map((card, i) => (
          <button
            type="button"
            class="group m-0 flex w-full cursor-pointer items-center justify-between gap-4 md:gap-6 self-start rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue"
            aria-haspopup="dialog"
            data-fr-supports-open
            data-fr-supports-index={i}
          >
            <img
              src={card.icon}
              alt=""
              width="56"
              height="56"
              class="block h-14 w-14 shrink-0 rounded-lg object-contain"
              loading="lazy"
              decoding="async"
            />
            <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
              {card.heading}
            </span>
            <span
              class="ml-auto flex h-14 w-14 shrink-0 items-center justify-center rounded-lg p-2 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
              aria-hidden="true"
            >
              {/* The exported Figma glyph (Media / Icon / Unfilled / plus). */}
              <svg
                width="40"
                height="40"
                viewBox="0 0 40 40"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M20 10V30"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M30 20L10 20"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<!-- Detail overlay. Lives outside the section's container so the scrim covers
     the viewport rather than the 1280px column. -->
<div
  id="fr-supports-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="fr-supports-overlay-title"
  aria-hidden="true"
  inert
  class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
>
  <div
    class="relative max-h-[90vh] w-full max-w-[1280px] overflow-y-auto rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6"
    data-fr-supports-panel
  >
    <!-- Anchored to the PANEL, not to the visual it sits over in the Figma:
         24px panel padding + the design's 20px inset lands at the same 44px on
         desktop, and it stays reachable once the visual moves below the copy on
         mobile. The glyph is the plus above, turned 45°, which is how the Figma
         draws it (the export is the same plus component). -->
    <button
      type="button"
      aria-label="Fermer"
      class="absolute right-6 top-10 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-11 lg:top-11"
      data-fr-supports-close
    >
      <svg
        width="40"
        height="40"
        viewBox="0 0 40 40"
        fill="none"
        class="rotate-45"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M20 10V30"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M30 20L10 20"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="flex flex-col items-start gap-6 lg:flex-row lg:gap-12">
      <!-- 416px = 1280 panel − 48 padding − 48 gap − the 768px the 16:9 visual
           takes at the design's 432px height. justify-between is what puts the
           body and the chevrons on the visual's bottom edge. -->
      <div
        class="flex w-full flex-col justify-between gap-6 lg:w-[416px] lg:shrink-0 lg:self-stretch max-lg:contents"
      >
        <div class="order-1 flex w-full flex-col gap-6">
          <div class="h-16 w-16 shrink-0">
            {
              cards.map((card, i) => (
                <img
                  src={card.icon}
                  alt=""
                  width="64"
                  height="64"
                  class="h-16 w-16 rounded-lg object-contain"
                  style={i === 0 ? "display: block;" : "display: none;"}
                  data-fr-supports-icon
                  loading="lazy"
                  decoding="async"
                />
              ))
            }
          </div>
          <div id="fr-supports-overlay-title">
            {
              cards.map((card, i) => (
                <h3
                  class="m-0 pr-12 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px] lg:pr-0 max-w-[300px]"
                  hidden={i !== 0}
                  data-fr-supports-heading
                >
                  {card.heading}
                </h3>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col order-2 gap-6 max-lg:contents">
          <div class="order-2 w-full">
            {
              cards.map((card, i) => (
                <p
                  class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                  hidden={i !== 0}
                  data-fr-supports-body
                >
                  {card.body}
                </p>
              ))
            }
          </div>

          <div class="order-4 flex items-center gap-2">
            <button
              type="button"
              aria-label="Précédent"
              aria-controls="fr-supports-overlay-title"
              class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-neutral-300"
              data-fr-supports-prev
              disabled
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M12 15L7 10L12 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
            <button
              type="button"
              aria-label="Suivant"
              aria-controls="fr-supports-overlay-title"
              class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-neutral-300"
              data-fr-supports-next
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M7 5L12 10L7 15"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="order-3 w-full lg:order-none">
        {
          cards.map((card, i) => (
            <img
              src={card.img}
              alt={card.heading}
              width="760"
              height="428"
              class="w-full h-auto "
              style={i === 0 ? "display: block;" : "display: none;"}
              data-fr-supports-img
              loading="lazy"
              decoding="async"
            />
          ))
        }
      </div>
    </div>
  </div>
</div>

<script is:inline>
  /* Card -> detail overlay, with the chevrons walking the six without closing. */
  (function () {
    var overlay = document.getElementById("fr-supports-overlay");
    if (!overlay) return;

    var panel = overlay.querySelector("[data-fr-supports-panel]");
    var closeBtn = overlay.querySelector("[data-fr-supports-close]");
    var prevBtn = overlay.querySelector("[data-fr-supports-prev]");
    var nextBtn = overlay.querySelector("[data-fr-supports-next]");
    var headings = overlay.querySelectorAll("[data-fr-supports-heading]");
    var bodies = overlay.querySelectorAll("[data-fr-supports-body]");
    var images = overlay.querySelectorAll("[data-fr-supports-img]");
    var icons = overlay.querySelectorAll("[data-fr-supports-icon]");
    if (!panel || !headings.length || headings.length !== bodies.length) return;

    var count = headings.length;
    var current = 0;
    var lastFocused = null;

    function updateNav() {
      if (prevBtn) {
        prevBtn.disabled = current <= 0;
      }
      if (nextBtn) {
        nextBtn.disabled = current >= count - 1;
      }
    }

    function show(index) {
      if (index < 0) index = 0;
      if (index >= count) index = count - 1;
      current = index;
      for (var i = 0; i < count; i++) {
        headings[i].hidden = i !== current;
        bodies[i].hidden = i !== current;
        if (images[i]) {
          images[i].style.display = i === current ? "block" : "none";
        }
        if (icons[i]) {
          icons[i].style.display = i === current ? "block" : "none";
        }
      }
      updateNav();
      // The panel scrolls on short windows; a card further down the list would
      // otherwise open mid-way through its own copy.
      panel.scrollTop = 0;
    }

    // Inline display, not a class swap: the utilities pasted into Webflow are
    // unlayered, so `flex` and `hidden` on one element would race on source
    // order. Inline always wins.
    function open(index, opener) {
      lastFocused = opener || document.activeElement;
      show(index);
      overlay.removeAttribute("inert");
      overlay.style.display = "flex";
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
    }

    function close() {
      overlay.style.display = "none";
      overlay.setAttribute("aria-hidden", "true");
      overlay.setAttribute("inert", "");
      document.body.style.overflow = "";
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function isOpen() {
      return overlay.style.display === "flex";
    }

    // Delegated, so it does not matter which Embed mounts first or whether the
    // cards existed when this ran.
    document.addEventListener("click", function (e) {
      if (!e.target.closest) return;
      var opener = e.target.closest("[data-fr-supports-open]");
      if (!opener) return;
      open(
        parseInt(opener.getAttribute("data-fr-supports-index"), 10) || 0,
        opener,
      );
    });

    if (closeBtn) closeBtn.addEventListener("click", close);
    if (prevBtn)
      prevBtn.addEventListener("click", function () {
        if (current > 0) {
          show(current - 1);
        }
      });
    if (nextBtn)
      nextBtn.addEventListener("click", function () {
        if (current < count - 1) {
          show(current + 1);
        }
      });

    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) close();
    });

    document.addEventListener("keydown", function (e) {
      if (!isOpen()) return;

      if (e.key === "Escape") {
        close();
        return;
      }

      // Arrow keys drive the same walk the chevrons do. Nothing inside the
      // dialog is a native arrow-key control (no radio group, select or text
      // field), so there is no default behaviour to steal here.
      if (e.key === "ArrowLeft") {
        if (current > 0) {
          show(current - 1);
        }
        return;
      }
      if (e.key === "ArrowRight") {
        if (current < count - 1) {
          show(current + 1);
        }
        return;
      }

      // Keep Tab inside the dialog — `aria-modal` claims the rest is inert, so
      // focus must not walk out into the page behind it.
      if (e.key !== "Tab") return;
      var focusable = panel.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>
