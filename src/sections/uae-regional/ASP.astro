---
interface FeatureItem {
    iconBg?: string;
    title: string;
    desc: string;
}

const features: FeatureItem[] = [
    {
        iconBg: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1b926c360443b11979518_uae-icon-1.png',
        title: 'Advanced Dashboards & Reports',
        desc: 'Leverage AI-driven insights for a complete view of your e-invoicing processes via comprehensive MIS dashboards and customised reports.'
    },
    {
        iconBg: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1b92afd7e7b3781669382_uae-icon-2.png',
        title: 'End-to-End E-Invoicing Solution',
        desc: 'ClearTax provides a complete solution for issuing, submitting, and receiving e-invoices. It tracks the status of submitted invoices and sends email notifications for e-invoices.'
    },
    {
        iconBg: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1b92d59f52156c6ff95a1_uae-icon-3.png',
        title: 'Peppol-Ready',
        desc: "ClearTax follows the Peppol specifications for data exchange, ensuring compliance with the UAE's Continuous Transaction Controls (CTC) model."
    },
    {
        iconBg: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1b9329fd38ed8cc7f768e_uae-icon-4.png',
        title: 'Automated Error Management',
        desc: 'Identify and resolve e-invoicing errors in real time with intuitive alerts, bulk resubmission options, and guided correction tools.'
    },
    {
        iconBg: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1b9374e8958ae08940c83_uae-icon-5.png',
        title: 'Dedicated customer support',
        desc: 'Our local support team is available 24/7 to help with any e-invoicing or integration-related queries.'
    }
];
---

<section id="asp" class="bg-generic-00 py-16 md:py-20" data-uae-asp>
    <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
        
        <!-- Section Header -->
        <div class="text-center max-w-239 mx-auto mb-12">
            <h2 class="text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-vault-navy font-heading mb-4">
                How ClearTax Supports the UAE's E-Invoicing Mandate
            </h2>
            <p class="text-neutral-500 font-normal text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] font-body max-w-213 mx-auto">
                ClearTax is a pre-approved FTA and MoF-compliant Accredited Service Provider (ASP) that can help your business comply with the UAE's e-invoicing requirements.
            </p>
        </div>

        <!-- Features List -->
        <div class="flex flex-col divide-y divide-neutral-200">
            {features.map((item) => (
                <div class="uae-asp-row grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-center py-7 md:pb-9 md:pt-8 first:pt-0 last:pb-0">
                    
                    <!-- Left Column: Icon & Title -->
                    <div class="md:col-span-6 flex items-center gap-5 sm:gap-6">
                        <img src={item.iconBg} alt="icons-uae" class="uae-asp-icon shrink-0" loading="lazy" decoding="async" width="48" height="48" />
                        <h3 class="text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] font-medium text-vault-navy font-heading">
                            {item.title}
                        </h3>
                    </div>

                    <!-- Right Column: Description -->
                    <div class="md:col-span-6">
                        <p class="text-vault-navy/70 font-normal text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-body max-w-xl">
                            {item.desc}
                        </p>
                    </div>

                </div>
            ))}
        </div>

    </div>
</section>

<style is:global>
    .uae-asp-row {
        opacity: 0.5;
        transition:
            opacity 0.35s ease-in-out,
            transform 0.35s ease-in-out;
    }

    .uae-asp-row.is-centered {
        opacity: 1;
    }

    .uae-asp-row.is-scaled {
        transform: scale(1.02);
    }

    .uae-asp-icon {
        transition: transform 0.35s ease-in-out;
    }

    .uae-asp-row.is-scaled .uae-asp-icon {
        transform: scale(1.125);
    }
</style>

<script is:inline>
    (function () {
        const root = document.querySelector("[data-uae-asp]");
        if (!root) return;
        const rows = Array.from(root.querySelectorAll(".uae-asp-row"));
        if (!rows.length) return;

        if (
            !("IntersectionObserver" in window) ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
            rows.forEach((el) => el.classList.add("is-centered"));
            return;
        }

        let centered = null;
        const inBand = new Set();

        const pick = () => {
            if (!inBand.size) return;

            const middle = window.innerHeight / 2;
            let best = null;
            let bestDistance = Infinity;

            inBand.forEach((el) => {
                const rect = el.getBoundingClientRect();
                const distance = Math.abs((rect.top + rect.bottom) / 2 - middle);
                if (distance < bestDistance) {
                    bestDistance = distance;
                    best = el;
                }
            });

            if (!best || best === centered) return;
            if (centered) centered.classList.remove("is-centered", "is-scaled");
            centered = best;
            centered.classList.add("is-centered", "is-scaled");
        };

        const centerObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) inBand.add(entry.target);
                    else inBand.delete(entry.target);
                });
                pick();
            },
            { rootMargin: "-49.5% 0px -49.5% 0px", threshold: 0 },
        );

        rows.forEach((el) => centerObserver.observe(el));
    })();
</script>
