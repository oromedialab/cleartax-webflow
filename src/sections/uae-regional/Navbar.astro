---
/**
 * Navbar for the UAE regional page — the paste unit.
 *
 * Structure, styling and behaviour live in `_shared/NavbarRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file, because
 * the embed route renders sections with no props.
 *
 * Menu: About Us (standalone link) / Product / Resources / Contact Us. No
 * Country group — NavbarRb ships its own globe country panel.
 *
 * TODO Events, Knowledge Hub, Experience Centre, Podcast and Careers keep the
 * cleartax.com URLs from the previous menu — confirm they are the right ones
 * for the UAE site.
 */
import NavbarRb from "../_shared/NavbarRb.astro";
import type { NavLink } from "../_shared/NavbarRb.astro";

const links: NavLink[] = [
    { label: "About Us", href: "https://www.cleartax.com/about-us" },
    {
        label: "Product",
        dropdown: [
            {
                label: "UAE e-invoicing",
                href: "https://www.cleartax.com/ae/e-invoicing-software",
            },
            {
                label: "Global e-invoicing",
                href: "https://www.cleartax.com/global/e-invoicing-solution",
            },
        ],
    },
    {
        label: "Resources",
        dropdown: [
            { label: "Blogs", href: "https://www.cleartax.com/ae/e-invoicing-uae" },
            {
                label: "Experience Centre",
                href: "https://www.cleartax.com/experience-centre",
            },
            { label: "Podcast", href: "https://www.cleartax.com/podcast" },
        ],
    },
    {
        label: "Contact Us",
        dropdown: [
            { label: "Press", href: "https://www.cleartax.com/press" },
            { label: "Careers", href: "https://www.cleartax.com/careers" },
            {
                label: "Partner program",
                href: "https://www.cleartax.com/global/partner-program",
            },
            {
                label: "Contact us",
                href: "https://www.cleartax.com/contact-us",
            },
        ],
    },
];
---

<NavbarRb links={links} ctaOpensModal />
