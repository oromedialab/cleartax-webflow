---
/**
 * Partnership section
 */
---

<section class="py-16 md:py-24 bg-white w-full">
  <div class="max-w-[var(--container-max)] mx-auto px-4 md:px-6">
    
    <!-- Title -->
    <h2 class="text-[26px] sm:text-[32px] lg:text-[40px] font-medium text-center text-[#05022A] mb-12">
      Built on long-term partnerships
    </h2>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-0 max-w-5xl mx-auto mb-16 md:mb-20 text-center md:divide-x md:divide-black/10">
      <div class="px-4 flex flex-col items-center justify-center">
        <div class="text-[36px] md:text-[40px] font-semibold text-[#171E28] mb-1 leading-[1.2]">50+</div>
        <div class="text-[14px] md:text-[15px] text-[#6B7280] font-medium">countries</div>
      </div>
      
      <div class="px-4 flex flex-col items-center justify-center">
        <div class="text-[36px] md:text-[40px] font-semibold text-[#171E28] mb-1 leading-[1.2]">5000+</div>
        <div class="text-[14px] md:text-[15px] text-[#6B7280] font-medium">enterprises</div>
      </div>
      
      <div class="px-4 flex flex-col items-center justify-center">
        <div class="text-[36px] md:text-[40px] font-semibold text-[#171E28] mb-1 leading-[1.2]">1B+</div>
        <div class="text-[14px] md:text-[15px] text-[#6B7280] font-medium">e-Invoices generated annually</div>
      </div>
      
      <div class="px-4 flex flex-col items-center justify-center">
        <div class="text-[36px] md:text-[40px] font-semibold text-[#171E28] mb-1 leading-[1.2]">$500B+</div>
        <div class="text-[14px] md:text-[15px] text-[#6B7280] font-medium">worth invoices processed</div>
      </div>
    </div>

    <!-- Video/Image Placeholder -->
    <div class="relative w-full max-w-[1080px] mx-auto rounded-[16px] overflow-hidden bg-gray-900 group cursor-pointer aspect-video md:aspect-[2/1] lg:aspect-[2.2/1] shadow-xl">
      <!-- Placeholder image -->
      <img 
        src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8bdf45c79b5448f45895fc_Testimonial.png" 
        alt="Video Placeholder" 
        class="w-full h-full object-cover opacity-90" 
      />
    </div>

  </div>
</section>
