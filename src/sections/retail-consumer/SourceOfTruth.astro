</style>

<script is:inline>
  (function () {
    /**
     * Connector draw-in: no <mask>, no stroke-dashoffset-through-a-mask —
     * see FlowCanvas.astro's doc comment on `straightLines`/`bentWires` for
     * why (a real Chrome bug: `zoom` — this site's `--page-zoom`, shared.css
     * — breaks SVG masks outright). Instead GSAP animates the actual
     * geometry: a straight <line>'s `x2`/`y2` attributes grow from its
     * `x1`/`y1` (its own `6 5` dasharray is never touched, so the dots you
     * see are the same dots throughout — just more of them as the line
     * extends); a bent <path>'s `d` is rebuilt every frame from a
     * length-truncated copy of its point list (`data-points`), re-rounded
     * with the same `roundedPolylineJS` FlowCanvas.astro's build-time
     * `roundedPolyline` mirrors.
     *
     * Staged in the order data actually moves through the diagram (see
     * FlowCanvas.astro's `Stage` type for the exact grouping) — sources
     * emit, merge onto the purple bus, feed billing; billing emits, merges
     * onto the green bus (and taps the middleware feed), feeds ERP GL; ERP
     * GL emits to cleartax. Procurement/AP's `orange-full` wire bypasses
     * billing entirely in one continuous path, so it gets a longer duration
     * instead of its own stage, timed to land at ERP GL together with the
     * other two colors rather than arriving early.
     *
     * Plays once, on first scroll into view. GSAP loads from the same CDN
     * this codebase already uses elsewhere (global-homepage/WhyGenericAi.astro),
     * self-injected here rather than assumed already present on the page,
     * so this section works even if pasted somewhere that doesn't load it.
     */
    const STAGE_DURATION = 0.45;
    const EASE = "sine.out";
    const STAGE_ORDER = [
      "src-entry",
      "src-trunk",
      "src-exit",
      "bill-entry",
      "bill-trunk",
      "bill-exit",
      "final",
    ];

    const prefersReducedMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function loadGsap(onReady) {
      if (window.gsap) return onReady();
      const existing = document.querySelector("script[data-gsap-cdn]");
      if (existing) {
        existing.addEventListener("load", onReady, { once: true });
        return;
      }
      const s = document.createElement("script");
      s.src = "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js";
      s.dataset.gsapCdn = "true";
      s.onload = onReady;
      document.head.appendChild(s);
    }

    // Mirrors FlowCanvas.astro's build-time `roundedPolyline` exactly.
    function roundedPolylineJS(points, r) {
      if (points.length < 2) return "";
      let d = `M ${points[0].x} ${points[0].y}`;
      for (let i = 1; i < points.length - 1; i++) {
        const prev = points[i - 1];
        const curr = points[i];
        const next = points[i + 1];
        const inLen = Math.hypot(curr.x - prev.x, curr.y - prev.y);
        const outLen = Math.hypot(next.x - curr.x, next.y - curr.y);
        const radius = Math.min(r, inLen / 2, outLen / 2);
        const inX = curr.x + ((prev.x - curr.x) / inLen) * radius;
        const inY = curr.y + ((prev.y - curr.y) / inLen) * radius;
        const outX = curr.x + ((next.x - curr.x) / outLen) * radius;
        const outY = curr.y + ((next.y - curr.y) / outLen) * radius;
        d += ` L ${inX} ${inY} Q ${curr.x} ${curr.y} ${outX} ${outY}`;
      }
      const last = points[points.length - 1];
      d += ` L ${last.x} ${last.y}`;
      return d;
    }

    function parsePoints(str) {
      return str.split(" ").map((pair) => {
        const [x, y] = pair.split(",").map(Number);
        return { x, y };
      });
    }

    function polylineLength(points) {
      let len = 0;
      for (let i = 0; i < points.length - 1; i++)
        len += Math.hypot(
          points[i + 1].x - points[i].x,
          points[i + 1].y - points[i].y,
        );
      return len;
    }

    // Points from the wire's start up to `targetLen` along it — the
    // truncated shape `roundedPolylineJS` re-rounds every frame.
    function pointsUpToLength(points, targetLen) {
      let acc = 0;
      const result = [points[0]];
      for (let i = 0; i < points.length - 1; i++) {
        const a = points[i];
        const b = points[i + 1];
        const segLen = Math.hypot(b.x - a.x, b.y - a.y);
        if (acc + segLen >= targetLen) {
          const t = segLen === 0 ? 0 : (targetLen - acc) / segLen;
          result.push({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t });
          return result;
        }
        result.push(b);
        acc += segLen;
      }
      return result;
    }

    function prepareLine(gsap, el) {
      const x1 = Number(el.getAttribute("x1"));
      const y1 = Number(el.getAttribute("y1"));
      const x2 = Number(el.getAttribute("x2"));
      const y2 = Number(el.getAttribute("y2"));
      gsap.set(el, { attr: { x2: x1, y2: y1 } });
      return { type: "line", el, final: { x2, y2 } };
    }

    function preparePath(el) {
      const points = parsePoints(el.getAttribute("data-points"));
      const radius = Number(el.getAttribute("data-radius"));
      const total = polylineLength(points);
      el.setAttribute("d", `M ${points[0].x} ${points[0].y}`);
      return { type: "path", el, points, radius, total };
    }

    function tweenItem(tl, item, duration, position) {
      if (item.type === "line") {
        tl.to(
          item.el,
          {
            attr: { x2: item.final.x2, y2: item.final.y2 },
            duration,
            ease: EASE,
          },
          position,
        );
      } else {
        const proxy = { p: 0 };
        tl.to(
          proxy,
          {
            p: 1,
            duration,
            ease: EASE,
            onUpdate: () =>
              item.el.setAttribute(
                "d",
                roundedPolylineJS(
                  pointsUpToLength(item.points, proxy.p * item.total),
                  item.radius,
                ),
              ),
          },
          position,
        );
      }
    }

    function animatePanel(panel) {
      if (!panel || panel.dataset.sotAnimated === "true") return;
      panel.dataset.sotAnimated = "true";
      const lines = Array.from(panel.querySelectorAll("[data-sot-line]"));
      if (!lines.length) return;

      if (prefersReducedMotion) return; // leave the static dashed lines as-is

      const gsap = window.gsap;
      const byStage = {};
      lines.forEach((line) => {
        const item =
          line.getAttribute("data-shape") === "line"
            ? prepareLine(gsap, line)
            : preparePath(line);
        const stage = line.getAttribute("data-stage");
        if (!byStage[stage]) byStage[stage] = [];
        byStage[stage].push(item);
      });

      const tl = gsap.timeline();
      STAGE_ORDER.forEach((stage, i) => {
        const group = byStage[stage];
        if (!group) return;
        group.forEach((item) =>
          tweenItem(tl, item, STAGE_DURATION, i * STAGE_DURATION),
        );
      });

      // Procurement/AP bypasses billing in one continuous wire — stretch its
      // draw to land at ERP GL (stage index of "final") in step with the
      // other two colors instead of finishing after just one stage.
      const orangeGroup = byStage["orange-full"];
      if (orangeGroup) {
        const finalIndex = STAGE_ORDER.indexOf("final");
        orangeGroup.forEach((item) =>
          tweenItem(tl, item, STAGE_DURATION * finalIndex, 0),
        );
      }

      // The middleware feed taps off the billing bus, so it plays alongside
      // that merge rather than getting its own place in STAGE_ORDER.
      const midFeedGroup = byStage["mid-feed"];
      if (midFeedGroup) {
        const billTrunkIndex = STAGE_ORDER.indexOf("bill-trunk");
        midFeedGroup.forEach((item) =>
          tweenItem(tl, item, STAGE_DURATION, billTrunkIndex * STAGE_DURATION),
        );
      }
    }

    function animateMobileLines(panel) {
      if (!panel || panel.dataset.sotAnimated === "true") return;
      panel.dataset.sotAnimated = "true";
      if (prefersReducedMotion) return;

      const gsap = window.gsap;
      if (!gsap) return;

      const lines = Array.from(panel.querySelectorAll("[data-sot-mobile-line]"));
      if (!lines.length) return;

      lines.forEach((line) => {
        const y1 = Number(line.getAttribute("y1"));
        const y2 = Number(line.getAttribute("y2"));
        line.dataset.finalY2 = String(y2);
        gsap.set(line, { attr: { y2: y1 } });
      });

      const tl = gsap.timeline({ delay: 0.15 });

      // Group 1: Connector 1 (Sources -> Billing)
      const conn1 = panel.querySelector("[data-sot-conn='1'] [data-sot-mobile-line]");
      if (conn1) {
        tl.to(conn1, {
          attr: { y2: Number(conn1.dataset.finalY2) },
          duration: 0.35,
          ease: EASE,
        });
      }

      // Group 2: Connector 2 (Billing -> ERP GL)
      const conn2 = panel.querySelector("[data-sot-conn='2'] [data-sot-mobile-line]");
      if (conn2) {
        tl.to(
          conn2,
          {
            attr: { y2: Number(conn2.dataset.finalY2) },
            duration: 0.35,
            ease: EASE,
          },
          "+=0.1",
        );
      }

      // Group 3: Connector 3 (ERP GL -> cleartax: 3 arrows)
      const conn3 = panel.querySelectorAll("[data-sot-conn='3'] [data-sot-mobile-line]");
      if (conn3.length) {
        tl.to(
          conn3,
          {
            attr: { y2: (i, target) => Number(target.dataset.finalY2) },
            duration: 0.35,
            stagger: 0.08,
            ease: EASE,
          },
          "+=0.1",
        );
      }
    }

    document.querySelectorAll("[data-sot-stage]").forEach((stage) => {
      const track = stage.querySelector("[data-sot-track]");
      if (!track) return;
      const designWidth = track.offsetWidth;
      const designHeight = track.offsetHeight;

      const resize = () => {
        if (!stage.offsetParent) return;
        const scale = stage.clientWidth / designWidth;
        track.style.transform = `scale(${scale})`;
        track.style.transformOrigin = "top left";
        stage.style.height = `${designHeight * scale}px`;
      };

      window.addEventListener("resize", resize);
      resize();

      const cardContainer = stage.parentElement;
      const tabsRoot = cardContainer.querySelector("[data-sot-tabs]");
      const tabs = tabsRoot ? tabsRoot.querySelectorAll("[data-sot-tab]") : [];
      const panels = track.querySelectorAll("[data-sot-panel]");
      const mobilePanels = cardContainer.querySelectorAll("[data-sot-mobile-panel]");

      let hasEnteredView = false;
      const activePanel = () =>
        Array.from(panels).find((p) => !p.classList.contains("hidden"));
      const activeMobilePanel = () =>
        Array.from(mobilePanels).find((p) => !p.classList.contains("hidden"));

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            hasEnteredView = true;
            loadGsap(() => {
              if (window.innerWidth >= 768) {
                animatePanel(activePanel());
              } else {
                animateMobileLines(activeMobilePanel());
              }
            });
            observer.disconnect();
          });
        },
        { threshold: 0.15 },
      );
      observer.observe(cardContainer);

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const key = tab.getAttribute("data-sot-tab");
          tabs.forEach((t) =>
            t.setAttribute("aria-selected", t === tab ? "true" : "false"),
          );
          panels.forEach((p) =>
            p.classList.toggle(
              "hidden",
              p.getAttribute("data-sot-panel") !== key,
            ),
          );
          mobilePanels.forEach((p) =>
            p.classList.toggle(
              "hidden",
              p.getAttribute("data-sot-mobile-panel") !== key,
            ),
          );
          // If the diagram was already visible before this switch, play draw-in
          if (hasEnteredView) {
            loadGsap(() => {
              if (window.innerWidth >= 768) {
                animatePanel(activePanel());
              } else {
                animateMobileLines(activeMobilePanel());
              }
            });
          }
        });
      });
    });
  })();
</script>
