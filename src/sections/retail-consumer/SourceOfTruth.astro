---
/**
 * "From every selling channel to one source of truth." Figma node
 * 15389:33433 / instance 15389:33440 ("Source of truth - item").
 *
 * The actual diagram (cards + connectors) lives in ./FlowCanvas.astro — see
 * that file's doc comment for the pixel-coordinate provenance. This file
 * owns the two tab datasets and the interaction:
 *
 * - Scale-to-fit, not scroll: FlowCanvas is a fixed 1239x700 px design, so
 *   `data-sot-stage` measures its own width on load/resize and applies a
 *   uniform `transform: scale()` to `data-sot-track` (which holds both
 *   panels). A uniform transform keeps every card, line and font size in
 *   the exact proportion Figma drew, which plain CSS reflow (or letting it
 *   overflow-x: scroll) can't — the earlier version scrolled horizontally
 *   below ~1239px, which is the "scrollable" behaviour this replaces.
 * - Selling channels / Marketplaces tabs: both are real Figma frames —
 *   "Selling channels" is node 15389:33433/15389:33440, "Marketplaces" is
 *   node 15432:48377. Same card/connector skeleton, different content: the
 *   Marketplaces sources column is headed "MARKETPLACES" (not "SOURCES")
 *   and left-shifted to 81px (vs 106px) since it's a longer word — see
 *   FlowCanvas.astro's `sourcesLabel`/`sourcesLabelX` props.
 */
import FlowCanvas, {
  CANVAS_W,
  CANVAS_H,
  type FlowCard,
  FLOW_COLOR,
  erpChecklist,
  receives,
} from "./FlowCanvas.astro";

