---
/**
 * "We speak the language of your existing systems." Figma node 15389:33361.
 *
 * Three category cards (Enterprise ERPs / Retail POS & engines /
 * E-commerce & middleware), each a wrap of small logo badges. Badges without
 * an already-hosted Webflow asset render a neutral monogram swatch instead of
 * a fabricated logo image — same fallback pattern NavbarRb uses for a country
 * with no flag asset yet.
 */
interface Logo {
  name: string;
  src?: string;
}

interface Category {
  title: string;
  desc: string;
  logos: Logo[];
}

const categories: Category[] = [
  {
    title: "Enterprise ERPs",
    desc: "Where your transactions originate.",
    logos: [
      {
        name: "SAP S/4HANA & ECC",
        src: "https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/6a06bfe3956ddb4d4f844ba3_sap-logo.png",
      },
      {
        name: "Oracle Fusion & EBS",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae094df91e8019ab1e7902d_icon-2.png",
      },
      {
        name: "Microsoft D365",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae094f291e8019ab1e79422_icon-1.png",
      },
    ],
  },
  {
    title: "Retail POS & engines",
    desc: "Where the customer sees the receipt.",
    logos: [
      {
        name: "Mirnah",
        src: "https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/6a06bfe33fae32c5e4a5d5b0_mirnah-logo.png",
      },
      {
        name: "LS Retail",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae09506b96f99de16dd5ece_icon-3.png",
      },
      {
        name: "Sentinel POS",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae0954f2ac3f09774b44782_icon-9.png",
      },
      {
        name: "TC POS",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae0950d51dca4409d6e5cbf_icon-4.png",
      },
      {
        name: "POS Malaysia",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae0954f2ac3f09774b44782_icon-9.png",
      },
    ],
  },
  {
    title: "E-commerce & middleware",
    desc: "Where the online order reaches you.",
    logos: [
      {
        name: "Shopify",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae09554476d016dc69a65fd_icon-10.png",
      },
      {
        name: "Magento",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae09513476d016dc69a4668_icon-5.png",
      },
      {
        name: "Salesforce Commerce",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59b8c6c71064ad1ea30d_salesforce.png",
      },
      {
        name: "Hybris",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae0952a72d01937f11ea42d_icon-7.png",
      },
      {
        name: "TIBCO",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae09531d1990f9fbc9a407b_icon-8.png",
      },
    ],
  },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div class="flex flex-col gap-12">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-left leading-[1.2] text-[28px] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        We speak the language of your existing systems.
      </h2>

      <div
        class="grid grid-cols-1 lg:grid-cols-3 rounded-xl border border-neutral-200 divide-y divide-neutral-200 lg:divide-y-0 lg:divide-x"
      >
        {
          categories.map((cat) => (
            <div class="flex flex-col gap-12 p-6">
              <div class="flex flex-col gap-2">
                <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                  {cat.title}
                </p>
                <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                  {cat.desc}
                </p>
              </div>
              <div class="flex flex-wrap gap-2">
                {cat.logos.map((logo) => (
                  <span class="inline-flex items-center gap-x-3 gap-y-2 rounded-lg border border-neutral-200 px-3 py-1.5">
                    {logo.src ? (
                      <img
                        src={logo.src}
                        alt=""
                        class="max-h-6 w-full object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span
                        class="h-6 w-6 shrink-0 rounded-md bg-neutral-200"
                        aria-hidden="true"
                      />
                    )}
                    <span class="font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] whitespace-nowrap">
                      {logo.name}
                    </span>
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
