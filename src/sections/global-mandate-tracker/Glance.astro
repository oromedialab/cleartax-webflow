---
/**
 * Mandates at a glance — Figma node 19809:56131. Country chips are grouped by
 * the status Tracker.astro publishes; clicking one opens its dialog.
 *
 * The timeline track fills with Vault Navy as the page scrolls: the script
 * sets --gmt-draw (0–1) on each stage's track.
 *
 * The 3D globe (markup, styles, script) is a copy of the one in
 * global-homepage/Einvoicing.astro.
 */
const groups = [
    { status: "live", title: "Already live — pre 2025" },
    { status: "2025", title: "2025" },
    { status: "2026", title: "2026" },
    { status: "2027", title: "2027 and beyond" },
];
---

<section id="gmt-glance" class="scroll-mt-24 bg-generic-00 py-12 lg:py-20">
    <div class="container mx-auto">
        <div class="gmt-glance-card grid gap-10 rounded-xl border border-solid border-neutral-300 p-5 md:p-12 lg:grid-cols-[minmax(0,447fr)_minmax(0,657fr)] lg:gap-20">
            <div class="flex flex-col gap-6">
                <div class="flex flex-col gap-3">
                    <h2 class="m-0 font-heading font-medium tracking-[-0.5px] text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] md:text-[length:var(--fs-h1)] md:leading-[length:var(--lh-h1)]">Mandates at a Glance</h2>
                    <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">Click any country chip to open its full details.</p>
                </div>
                <div class="flex flex-1 items-center">
                    <div
                      class="gmt-presence-globe relative h-[337px] lg:h-[400px] w-full max-w-[447px] mx-auto overflow-hidden rounded-xl shrink-0"
                    >
                      <img
                        src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa916426f59ce0239f6282f_globe.png"
                        alt="Dotted globe marking the countries ClearTax supports e-invoicing in"
                        loading="lazy"
                        decoding="async"
                        class="gmt-globe-poster absolute left-[7.88%] top-[-6.59%] h-[113.18%] w-[84.24%] max-w-none object-contain"
                      />
                      <div
                        class="gmt-globe-stage absolute inset-0"
                        aria-hidden="true"
                      >
                        <div class="gmt-globe-canvas"></div>
                        <div class="gmt-globe-tags"></div>
                      </div>
                    </div>
                </div>
            </div>
            <ol class="m-0 flex list-none flex-col p-0">
                {groups.map((g) => (
                    <li class="group flex gap-4 md:gap-6">
                        <div class="flex w-4 shrink-0 flex-col items-center pt-1.5" aria-hidden="true" data-gmt-track>
                            <span class="gmt-track-dot relative size-4 shrink-0 rounded-sm bg-neutral-200"></span>
                            <span class="gmt-track-line relative w-[3px] flex-1 bg-neutral-200"></span>
                        </div>
                        <div class="flex min-w-0 flex-1 flex-col gap-3 pb-12 group-last:pb-0">
                            <h3 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">{g.title}</h3>
                            <ul class="m-0 flex min-h-10 list-none flex-wrap gap-2 p-0" data-gmt-chips={g.status}></ul>
                        </div>
                    </li>
                ))}
            </ol>
        </div>
    </div>

    <template data-gmt-chip>
        <li>
            <button type="button" aria-haspopup="dialog" class="flex cursor-pointer items-center gap-2 rounded-lg border border-solid border-neutral-300 bg-generic-00 px-3 py-2 font-body font-medium text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)] transition-colors hover:border-nova-blue">
                <img alt="" width="24" height="18" loading="lazy" class="h-[18px] w-6 rounded-xs object-cover" />
                <span></span>
            </button>
        </li>
    </template>
</section>

<style is:global>
    .gmt-glance-card {
        background-color: var(--color-generic-00);
        background-image:
            radial-gradient(ellipse at center, var(--color-generic-00) 45%, transparent 100%),
            radial-gradient(circle, var(--color-nova-200) 1.5px, transparent 2px);
        background-size: 100% 100%, 26px 26px;
    }
    /* Navy overlay on the timeline track, driven by --gmt-draw. */
    .gmt-track-dot::after,
    .gmt-track-line::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: var(--color-vault-navy);
        transition:
            opacity 0.4s ease-out,
            transform 0.4s ease-out;
    }
    .gmt-track-dot::after {
        opacity: min(1, calc(var(--gmt-draw, 0) * 4));
    }
    .gmt-track-line::after {
        transform: scaleY(var(--gmt-draw, 0));
        transform-origin: top;
        opacity: calc(0.3 + var(--gmt-draw, 0) * 0.7);
    }
    @media (prefers-reduced-motion: reduce) {
        .gmt-track-dot::after,
        .gmt-track-line::after {
            transition: none;
        }
    }

  /* Crossfade between the poster <img> (default fallback) and the
     Three.js canvas stage (enhancement, mounted lazily by script). */
  .gmt-globe-poster {
    transition: opacity 0.3s ease-out;
  }

  .gmt-globe-poster.gmt-globe-hidden {
    opacity: 0;
  }

  .gmt-globe-stage {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease-out;
  }

  .gmt-globe-stage.gmt-globe-visible {
    opacity: 1;
  }

  .gmt-globe-canvas {
    position: absolute;
    inset: 0;
    touch-action: none;
  }

  .gmt-globe-canvas canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gmt-globe-tags {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 10;
  }

  .gmt-globe-tag-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .gmt-globe-tags.gmt-globe-animated .gmt-globe-tag-wrapper {
    transition: opacity 0.25s ease-out;
  }

  .gmt-globe-tag-wrapper.gmt-globe-visible {
    opacity: 1;
  }

  .gmt-globe-tag-content {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Nova Blue at 40% opacity. */
    border: 1px solid rgba(84, 70, 255, 0.4);
    border-radius: 50%;
    padding: 3px;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 2px 8px rgba(48, 65, 76, 0.1);
    backdrop-filter: blur(4px);
  }

  .gmt-globe-tag-content img {
    display: block;
    width: 28px;
    height: 28px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    background-color: #eee;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .gmt-globe-tag-content {
      padding: 2px;
    }

    .gmt-globe-tag-content img {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script is:inline>
    (function () {
        var root = document.getElementById("gmt-glance");
        if (!root) return;
        var tpl = root.querySelector("[data-gmt-chip]");
        function paint(rows) {
            root.querySelectorAll("[data-gmt-chips]").forEach(function (list) {
                var status = list.getAttribute("data-gmt-chips");
                list.textContent = "";
                rows.filter(function (r) { return r.status === status; }).forEach(function (row) {
                    var node = tpl.content.cloneNode(true);
                    node.querySelector("img").src = "https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/flags/4x3/" + encodeURIComponent(row.code) + ".svg";
                    node.querySelector("span").textContent = row.name;
                    node.querySelector("button").addEventListener("click", function () {
                        document.dispatchEvent(new CustomEvent("gmt:open", { detail: row.code }));
                    });
                    list.appendChild(node);
                });
            });
        }
        /* Each stage fills as it passes a line 65% down the viewport. */
        var tracks = root.querySelectorAll("[data-gmt-track]");
        var still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var queued = false;
        function draw() {
            queued = false;
            var mark = window.innerHeight * 0.65;
            tracks.forEach(function (track) {
                var box = track.getBoundingClientRect();
                var done = still ? 1 : Math.min(1, Math.max(0, (mark - box.top) / box.height));
                track.style.setProperty("--gmt-draw", done.toFixed(3));
            });
        }
        function queue() {
            if (queued) return;
            queued = true;
            requestAnimationFrame(draw);
        }
        window.addEventListener("scroll", queue, { passive: true });
        window.addEventListener("resize", queue);
        queue();

        if (window.gmtRows) paint(window.gmtRows);
        document.addEventListener("gmt:data", function (e) {
            paint(e.detail);
            queue();
        });
    })();
</script>

<script is:inline>
  /* Interactive globe — lazy-mounted Three.js enhancement over the poster <img>.
     Copy of the globe in global-homepage/Einvoicing.astro. */
  (function () {
    var THREE_SRC =
      "https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js";
    var threePromise = null;

    function loadThree() {
      if (window.THREE) return Promise.resolve(window.THREE);
      if (threePromise) return threePromise;
      threePromise = new Promise(function (resolve, reject) {
        var script = document.createElement("script");
        script.src = THREE_SRC;
        script.async = true;
        script.onload = function () {
          resolve(window.THREE);
        };
        script.onerror = reject;
        document.head.appendChild(script);
      });
      return threePromise;
    }

    var LAND_MASK_B64 =
      "";

    var COUNTRY_TAGS = [
      { name: "Argentina", code: "ar", lat: -38.4, lon: -63.6 },
      { name: "Australia", code: "au", lat: -25.2, lon: 133.7 },
      { name: "Brazil", code: "br", lat: -14.2, lon: -51.9 },
      { name: "Canada", code: "ca", lat: 56.1, lon: -106.3 },
      { name: "China", code: "cn", lat: 35.8, lon: 104.1 },
      { name: "Costa Rica", code: "cr", lat: 9.7, lon: -83.7 },
      { name: "European Union", code: "eu", lat: 49.5, lon: 12.0 },
      { name: "Hong Kong", code: "hk", lat: 22.3, lon: 114.1 },
      { name: "India", code: "in", lat: 20.5, lon: 78.9 },
      { name: "Israel", code: "il", lat: 31.0, lon: 34.8 },
      { name: "Japan", code: "jp", lat: 36.2, lon: 138.2 },
      { name: "Malaysia", code: "my", lat: 4.2, lon: 109.2 },
      { name: "Mauritius", code: "mu", lat: -20.3, lon: 57.5 },
      { name: "Mexico", code: "mx", lat: 23.6, lon: -102.5 },
      { name: "New Zealand", code: "nz", lat: -40.9, lon: 174.8 },
      { name: "Oman", code: "om", lat: 21.4, lon: 55.9 },
      { name: "Peru", code: "pe", lat: -9.1, lon: -75.0 },
      { name: "Philippines", code: "ph", lat: 12.8, lon: 121.7 },
      { name: "Puerto Rico", code: "pr", lat: 18.2, lon: -66.5 },
      { name: "Qatar", code: "qa", lat: 25.3, lon: 51.1 },
      { name: "Russia", code: "ru", lat: 61.5, lon: 105.3 },
      { name: "Saudi Arabia", code: "sa", lat: 23.8, lon: 45.0 },
      { name: "Singapore", code: "sg", lat: 1.3, lon: 103.8 },
      { name: "South Africa", code: "za", lat: -30.5, lon: 22.9 },
      { name: "South Korea", code: "kr", lat: 35.9, lon: 127.7 },
      { name: "Taiwan", code: "tw", lat: 23.6, lon: 120.9 },
      { name: "Turkey", code: "tr", lat: 38.9, lon: 35.2 },
      { name: "UAE", code: "ae", lat: 23.4, lon: 53.8 },
      { name: "UK", code: "gb", lat: 55.3, lon: -3.4 },
      { name: "USA", code: "us", lat: 37.0, lon: -95.7 },
    ];

    function initContinentDots(THREE, globeGroup, GLOBE_RADIUS) {
      var bin = atob(LAND_MASK_B64);
      var dotColumns = 376;
      var dotRows = 188;
      var dotRadius = GLOBE_RADIUS - 0.01;
      var positions = [];

      for (var row = 0; row < dotRows; row++) {
        var v = (row + 0.5) / dotRows;
        var phi = v * Math.PI;
        var cosPhi = Math.cos(phi);
        var sinPhi = Math.sin(phi);
        var y = dotRadius * cosPhi;
        var rSinPhi = -dotRadius * sinPhi;
        var rowOffset = row * dotColumns;

        for (var col = 0; col < dotColumns; col++) {
          var bitIdx = rowOffset + col;
          if ((bin.charCodeAt(bitIdx >> 3) & (1 << (bitIdx & 7))) === 0) continue;

          var theta = ((col + 0.5) / dotColumns) * (Math.PI * 2);
          positions.push(
            rSinPhi * Math.cos(theta),
            y,
            -rSinPhi * Math.sin(theta)
          );
        }
      }

      var dotCount = positions.length / 3;
      var dotGeometry = new THREE.CylinderGeometry(0.0112, 0.0112, 0.006, 6);
      dotGeometry.translate(0, 0.003, 0);

      var extrudedDotMaterial = new THREE.RawShaderMaterial({
        vertexShader:
          "precision highp float;\n" +
          "uniform mat4 modelViewMatrix;\n" +
          "uniform mat4 projectionMatrix;\n" +
          "attribute vec3 position;\n" +
          "attribute mat4 instanceMatrix;\n" +
          "void main() {\n" +
          "  gl_Position = projectionMatrix * modelViewMatrix * instanceMatrix * vec4(position, 1.0);\n" +
          "}",
        fragmentShader:
          "precision mediump float;\n" +
          "void main() {\n" +
          "  gl_FragColor = vec4(0.4196, 0.4471, 0.5020, 1.0);\n" +
          "}",
      });

      var dotMesh = new THREE.InstancedMesh(
        dotGeometry,
        extrudedDotMaterial,
        dotCount
      );
      var instanceMatrix = new THREE.Matrix4();
      var instanceQuaternion = new THREE.Quaternion();
      var cylinderAxis = new THREE.Vector3(0, 1, 0);
      var tempPos = new THREE.Vector3();
      var tempNorm = new THREE.Vector3();
      var scaleOne = new THREE.Vector3(1, 1, 1);

      for (var i = 0; i < dotCount; i++) {
        var idx = i * 3;
        tempPos.set(positions[idx], positions[idx + 1], positions[idx + 2]);
        tempNorm.copy(tempPos).normalize();
        instanceQuaternion.setFromUnitVectors(cylinderAxis, tempNorm);
        instanceMatrix.compose(tempPos, instanceQuaternion, scaleOne);
        dotMesh.setMatrixAt(i, instanceMatrix);
      }

      dotMesh.instanceMatrix.setUsage(THREE.StaticDrawUsage);
      dotMesh.instanceMatrix.needsUpdate = true;
      dotMesh.matrixAutoUpdate = false;
      dotMesh.renderOrder = 2;
      globeGroup.add(dotMesh);
    }

    function initGlobe(THREE, root) {
      var poster = root.querySelector(".gmt-globe-poster");
      var stage = root.querySelector(".gmt-globe-stage");
      var canvasMount = root.querySelector(".gmt-globe-canvas");
      var tagsMount = root.querySelector(".gmt-globe-tags");
      if (!poster || !stage || !canvasMount || !tagsMount) return;

      var width = canvasMount.clientWidth;
      var height = canvasMount.clientHeight;
      if (!width || !height) return;
      var halfWidth = width * 0.5;
      var halfHeight = height * 0.5;

      var scene = new THREE.Scene();
      var camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
      camera.position.set(0, 0, 7.5);

      var renderer;
      try {
        renderer = new THREE.WebGLRenderer({
          antialias: true,
          alpha: true,
          powerPreference: "high-performance",
        });
      } catch (e) {
        return;
      }
      renderer.setClearColor(0xffffff, 0);
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      canvasMount.appendChild(renderer.domElement);

      var globePivot = new THREE.Group();
      globePivot.rotation.z = THREE.MathUtils.degToRad(-11);
      globePivot.rotation.x = THREE.MathUtils.degToRad(12);
      scene.add(globePivot);

      var globeGroup = new THREE.Group();
      globeGroup.rotation.y = THREE.MathUtils.degToRad(-60);
      globePivot.add(globeGroup);

      var GLOBE_RADIUS = 2.2;

      var innerCore = new THREE.Mesh(
        new THREE.SphereGeometry(GLOBE_RADIUS - 0.015, 64, 64),
        new THREE.MeshBasicMaterial({
          color: 0xffffff,
          depthWrite: true,
          depthTest: true,
        })
      );
      innerCore.renderOrder = 0;
      innerCore.matrixAutoUpdate = false;
      globeGroup.add(innerCore);

      var gridRadius = GLOBE_RADIUS + 0.03;
      var wireframeSegments = 64;
      var wireframePositions = new Float32Array(7296);
      var wfPtr = 0;

      for (var i = 1; i < 12; i++) {
        var phi = (Math.PI * i) / 12;
        var y = gridRadius * Math.cos(phi);
        var r = gridRadius * Math.sin(phi);
        for (var j = 0; j < wireframeSegments; j++) {
          var t1 = (j / wireframeSegments) * Math.PI * 2;
          var t2 = ((j + 1) / wireframeSegments) * Math.PI * 2;
          wireframePositions[wfPtr++] = r * Math.cos(t1);
          wireframePositions[wfPtr++] = y;
          wireframePositions[wfPtr++] = r * Math.sin(t1);
          wireframePositions[wfPtr++] = r * Math.cos(t2);
          wireframePositions[wfPtr++] = y;
          wireframePositions[wfPtr++] = r * Math.sin(t2);
        }
      }

      for (var i2 = 0; i2 < 8; i2++) {
        var theta0 = (Math.PI * i2) / 8;
        var cosTheta = Math.cos(theta0);
        var sinTheta = Math.sin(theta0);
        for (var j2 = 0; j2 < wireframeSegments; j2++) {
          var t1b = (j2 / wireframeSegments) * Math.PI * 2;
          var t2b = ((j2 + 1) / wireframeSegments) * Math.PI * 2;
          var x1 = gridRadius * Math.cos(t1b);
          var y1 = gridRadius * Math.sin(t1b);
          var x2 = gridRadius * Math.cos(t2b);
          var y2 = gridRadius * Math.sin(t2b);
          wireframePositions[wfPtr++] = x1 * cosTheta;
          wireframePositions[wfPtr++] = y1;
          wireframePositions[wfPtr++] = -x1 * sinTheta;
          wireframePositions[wfPtr++] = x2 * cosTheta;
          wireframePositions[wfPtr++] = y2;
          wireframePositions[wfPtr++] = -x2 * sinTheta;
        }
      }

      var wireframeGeo = new THREE.BufferGeometry();
      wireframeGeo.setAttribute(
        "position",
        new THREE.BufferAttribute(wireframePositions, 3)
      );
      var gridMaterial = new THREE.LineBasicMaterial({
        color: 0x646867,
        transparent: true,
        opacity: 0.32,
      });
      var wireframeMesh = new THREE.LineSegments(wireframeGeo, gridMaterial);
      wireframeMesh.renderOrder = 3;
      wireframeMesh.matrixAutoUpdate = false;
      globeGroup.add(wireframeMesh);

      initContinentDots(THREE, globeGroup, GLOBE_RADIUS);

      var tagElements = [];
      var tagsFragment = document.createDocumentFragment();

      COUNTRY_TAGS.forEach(function (country) {
        var wrapper = document.createElement("div");
        wrapper.className = "gmt-globe-tag-wrapper";

        var content = document.createElement("div");
        content.className = "gmt-globe-tag-content";

        if (country.code) {
          var flag = document.createElement("img");
          /* jsDelivr, not flagcdn.com: the site CSP img-src allows
             cdn.jsdelivr.net but not flagcdn.com. */
          flag.src =
            "https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/flags/1x1/" +
            country.code +
            ".svg";
          flag.alt = country.name;
          flag.width = 28;
          flag.height = 28;
          flag.loading = "lazy";
          flag.decoding = "async";
          /* If the flag host is blocked (CSP img-src) or down, drop the broken
             image icon and leave the marker as a plain dot. */
          flag.onerror = function () {
            flag.remove();
          };
          content.appendChild(flag);
        }
        wrapper.appendChild(content);

        var phiT = (90 - country.lat) * (Math.PI / 180);
        var thetaT = (country.lon + 180) * (Math.PI / 180);
        var rT = GLOBE_RADIUS + 0.005;
        var position = new THREE.Vector3(
          -rT * Math.sin(phiT) * Math.cos(thetaT),
          rT * Math.cos(phiT),
          rT * Math.sin(phiT) * Math.sin(thetaT)
        );

        tagsFragment.appendChild(wrapper);
        tagElements.push({
          position: position,
          element: wrapper,
          isVisible: false,
        });
      });

      tagsMount.appendChild(tagsFragment);

      var axisMat = new THREE.LineBasicMaterial({
        color: 0x646867,
        transparent: true,
        opacity: 0.45,
      });
      var arcMat = new THREE.MeshBasicMaterial({
        color: 0x646867,
        transparent: true,
        opacity: 0.65,
      });
      var arcThickness = 0.00675;
      var axisGeo = new THREE.BufferGeometry().setFromPoints([
        new THREE.Vector3(0, -GLOBE_RADIUS * 1.8, 0),
        new THREE.Vector3(0, GLOBE_RADIUS * 1.5, 0),
      ]);
      var axisLine = new THREE.Line(axisGeo, axisMat);
      axisLine.matrixAutoUpdate = false;
      globePivot.add(axisLine);

      var arcRadius = 0.65;
      var arcEndAngle = Math.PI * 1.35;
      var innerRingRadius = 0.28;
      var arcSegments = 48;
      var outerArcPoints = [];
      var innerArcPoints = [];
      for (var ai = 0; ai <= arcSegments; ai++) {
        var at = (ai / arcSegments) * arcEndAngle;
        outerArcPoints.push(
          new THREE.Vector3(arcRadius * Math.cos(at), 0, -arcRadius * Math.sin(at))
        );
        innerArcPoints.push(
          new THREE.Vector3(
            innerRingRadius * Math.cos(at),
            0,
            -innerRingRadius * Math.sin(at)
          )
        );
      }
      var outerArcGeo = new THREE.TubeGeometry(
        new THREE.CatmullRomCurve3(outerArcPoints),
        arcSegments,
        arcThickness,
        8,
        false
      );
      var innerArcGeo = new THREE.TubeGeometry(
        new THREE.CatmullRomCurve3(innerArcPoints),
        arcSegments,
        arcThickness,
        8,
        false
      );

      var rotatingArcs = [];
      var synchronizedArcs = [];

      function createRotationIndicators(direction) {
        var group = new THREE.Group();

        var arc = new THREE.Mesh(outerArcGeo, arcMat);
        arc.rotation.y = -Math.PI / 4;
        arc.position.y = direction === -1 ? -0.06 : 0;
        rotatingArcs.push(arc);
        group.add(arc);

        var innerRing = new THREE.Mesh(innerArcGeo, arcMat);
        innerRing.position.y = -direction * 0.25;
        synchronizedArcs.push(innerRing);
        group.add(innerRing);

        group.position.y =
          direction * GLOBE_RADIUS * 1.5 + (direction === 1 ? -0.6 : 0.23);
        group.rotation.x = direction === -1 ? THREE.MathUtils.degToRad(-45) : 0;
        return group;
      }

      globePivot.add(createRotationIndicators(1));
      globePivot.add(createRotationIndicators(-1));

      scene.add(new THREE.AmbientLight(0xffffff, 0.9));

      var tagWorldPos = new THREE.Vector3();
      var rotationClock = new THREE.Clock();
      var LOOP_DURATION = 16;
      var globeRotationSpeed = (Math.PI * 2) / LOOP_DURATION;
      var arcSpeed = globeRotationSpeed * 2;
      var syncSpeed = globeRotationSpeed * 4;
      var VISIBILITY_Z_THRESHOLD = 0.852;

      function updateTagPositions() {
        var mWorld = globeGroup.matrixWorld;

        for (var t = 0; t < tagElements.length; t++) {
          var tag = tagElements[t];
          tagWorldPos.copy(tag.position).applyMatrix4(mWorld);

          var isVisible = tagWorldPos.z >= VISIBILITY_Z_THRESHOLD;
          if (tag.isVisible !== isVisible) {
            tag.isVisible = isVisible;
            tag.element.classList.toggle("gmt-globe-visible", isVisible);
          }

          if (isVisible) {
            tagWorldPos.project(camera);
            var x = tagWorldPos.x * halfWidth + halfWidth;
            var y = tagWorldPos.y * -halfHeight + halfHeight;
            var px = ((x * 10 + 0.5) | 0) * 0.1;
            var py = ((y * 10 + 0.5) | 0) * 0.1;

            if (tag.px !== px || tag.py !== py) {
              tag.px = px;
              tag.py = py;
              tag.element.style.transform =
                "translate3d(" + px + "px, " + py + "px, 0) translate(-50%, -50%)";
            }
          }
        }
      }

      camera.updateMatrixWorld(true);
      globeGroup.updateMatrixWorld(true);
      renderer.render(scene, camera);
      updateTagPositions();

      stage.classList.add("gmt-globe-visible");
      poster.classList.add("gmt-globe-hidden");
      requestAnimationFrame(function () {
        tagsMount.classList.add("gmt-globe-animated");
      });

      function animate() {
        requestAnimationFrame(animate);
        var deltaTime = Math.min(rotationClock.getDelta(), 0.05);

        globeGroup.rotation.y += globeRotationSpeed * deltaTime;

        var arcDelta = arcSpeed * deltaTime;
        for (var ra = 0; ra < rotatingArcs.length; ra++) {
          rotatingArcs[ra].rotation.y += arcDelta;
        }

        var syncDelta = syncSpeed * deltaTime;
        for (var sa = 0; sa < synchronizedArcs.length; sa++) {
          synchronizedArcs[sa].rotation.y += syncDelta;
        }

        globeGroup.updateMatrixWorld();
        renderer.render(scene, camera);
        updateTagPositions();
      }
      animate();

      if ("ResizeObserver" in window) {
        var resizeObserver = new ResizeObserver(function (entries) {
          var entry = entries[0];
          if (!entry) return;
          var newWidth = entry.contentRect.width;
          var newHeight = entry.contentRect.height;
          if (!newWidth || !newHeight) return;

          width = newWidth;
          height = newHeight;
          halfWidth = width * 0.5;
          halfHeight = height * 0.5;

          camera.aspect = width / height;
          camera.updateProjectionMatrix();

          renderer.setSize(width, height);
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        });
        resizeObserver.observe(canvasMount);
      }
    }

    function initPresenceGlobe() {
      var root = document.querySelector(".gmt-presence-globe");
      if (!root || root.dataset.globeReady) return;
      root.dataset.globeReady = "true";

      if (!("IntersectionObserver" in window) || !window.WebGLRenderingContext) {
        return;
      }

      var mountObserver = new IntersectionObserver(
        function (entries) {
          if (!entries[0].isIntersecting) return;
          mountObserver.disconnect();
          loadThree()
            .then(function (THREE) {
              initGlobe(THREE, root);
            })
            .catch(function () {
              /* Three.js failed to load — poster stays as-is. */
            });
        },
        { rootMargin: "200px 0px", threshold: 0 }
      );
      mountObserver.observe(root);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPresenceGlobe);
    } else {
      initPresenceGlobe();
    }
  })();
</script>
