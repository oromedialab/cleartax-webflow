---
/**
 * Why mandates are spreading — Figma node 19809:57762. The icon squares are
 * unfilled placeholders in the Figma; swap for Webflow-hosted artwork.
 */
const cards = [
    {
        title: "Closing the VAT gap",
        body: "Governments lose trillions annually to VAT/GST fraud. Real-time e-invoicing is the primary tool to recover this revenue and cut evasion.",
    },
    {
        title: "Automated compliance",
        body: "Structured formats like XML, UBL, and Peppol let machines validate and submit invoices automatically, reducing errors and audit risk.",
    },
    {
        title: "Faster payments",
        body: "E-invoicing accelerates order-to-cash cycles. Automated delivery and matching leads to faster approvals and shorter payment terms.",
    },
    {
        title: "Global interoperability",
        body: "Peppol bridges national systems for cross-border e-invoicing. The EU's ViDA initiative will make intra-EU digital reporting mandatory by 2030.",
    },
];
---

<section class="bg-generic-00 py-12 lg:py-20">
    <div class="container mx-auto flex flex-col gap-12">
        <div class="flex flex-col items-center gap-3 text-center">
            <h2 class="m-0 font-heading font-medium tracking-[-0.5px] text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] md:text-[length:var(--fs-h1)] md:leading-[length:var(--lh-h1)]">Understanding the global shift</h2>
            <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">Governments are accelerating e-invoicing mandates. Here's what it means for your business.</p>
        </div>
        <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-2">
            {cards.map((c) => (
                <li class="flex flex-col items-start gap-6 rounded-xl border border-solid border-neutral-300 p-6">
                    <span class="size-18 rounded-xl bg-visual-placeholder" aria-hidden="true"></span>
                    <div class="flex flex-col gap-4">
                        <h3 class="m-0 font-heading font-medium tracking-[-0.5px] text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">{c.title}</h3>
                        <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">{c.body}</p>
                    </div>
                </li>
            ))}
        </ul>
    </div>
</section>
