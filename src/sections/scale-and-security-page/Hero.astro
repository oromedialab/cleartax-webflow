---
/**
 * The dot field is the one from `sections/blog-listing/Newsletter.astro`, in the
 * hero's own lime. The long explanation of the geometry lives in that file; the
 * short version is that the field is a plain grid of dots until a pointer
 * enters, and each dot then draws out into a stroke aimed at the cursor, longest
 * right beside it and back to a dot by `lengthRadius`.
 *
 * These are rendered onto the section as `data-*` and read back by the script.
 * The old grid declared its numbers twice — as props here and again as a literal
 * `config` in the script — so editing a prop changed nothing. One source now.
 *
 * The props that drove the old spring physics (`speedTrigger`, `shockRadius`,
 * `maxSpeed`, `resistance`, `returnDuration`, `proximity`, `activeColor`) are
 * gone with it. No page passed any of them.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

interface Props {
    lineWidth?: number;
    gap?: number;
    maxLength?: number;
    lengthRadius?: number;
    tilt?: number;
    baseColor?: string;
    cursorRadius?: number;
    pull?: number;
    fadeRadius?: number;
    titlePrefix?: string;
    titleHighlight?: string;
    titleSuffix?: string;
    description?: string;
}

const {
    /* lineWidth is the old dotSize: the width of a stroke, and so the diameter of
     the dot that stroke becomes at rest. 2 + 24 holds the hero's 26px pitch,
     with a finer dot than the 4px it used to draw. */
    lineWidth = 3,
    gap = 24,
    /* Longest a stroke gets, in px. Must stay under the 26px pitch or the field
     starts knitting into a mesh — the guarantee is spelt out in
     Newsletter.astro. */
    maxLength = 6,
    lengthRadius = 260,
    /* Leave at 1. A partial turn cannot be continuous, and strokes flip as the
     cursor crosses them — see the note in Newsletter.astro. */
    tilt = 1,
    baseColor = "#C8F006",
    cursorRadius = 320,
    pull = 14,
    fadeRadius = 40,
    titlePrefix = "Infrastructure that",
    titleHighlight = "scales",
    titleSuffix = "Security that doesn't bend.",
    description = "Built for enterprise compliance across 50+ countries, with sovereign cloud architecture, zero-trust access, and AES-256 encryption across every layer. ",
} = Astro.props;

const icons = [
    {
        image: "https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/662d07af32e831cf27c88fcc_ERP-Integrations.webp",
        alt: "ERP Integrations",
    },
    {
        image: "https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/662d07af32e831cf27c88fcc_ERP-Integrations.webp",
        alt: "ERP Integrations",
    },
    {
        image: "https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/662d07af32e831cf27c88fcc_ERP-Integrations.webp",
        alt: "ERP Integrations",
    },
    {
        image: "https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/662d07af32e831cf27c88fcc_ERP-Integrations.webp",
        alt: "ERP Integrations",
    },
];
---

<section
    class="de-hero-section relative min-h-[700px] bg-generic-00 overflow-hidden flex flex-col pt-28 pb-12 md:pt-30 md:pb-16 lg:pt-50 lg:pb-35"
    id="hero"
>
    <!-- Interactive Dot Grid Background -->
    <Dotgrid
        containerId="hero"
        lineWidth={lineWidth}
        gap={gap}
        maxLength={maxLength}
        lengthRadius={lengthRadius}
        tilt={tilt}
        baseColor={baseColor}
        cursorRadius={cursorRadius}
        pull={pull}
        fadeRadius={fadeRadius}
    />

    <!-- Radial wash, so the headline keeps its contrast over the field -->
    <div
        class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"
    >
    </div>

    <div
        class="relative z-10 mx-auto lg:container w-full h-full flex flex-col px-4 md:px-6 pointer-events-auto"
    >
        <div class="flex justify-center w-full h-full">
            <!-- Hero Content -->
            <div
                class="hero-content flex flex-col items-center mx-auto text-center w-full h-full"
            >
                <!-- Headline -->
                <h2
                    class="text-[length:var(--fs-h1)] lg:text-[length:var(--fs-display-sm)] xl:text-[length:var(--fs-display-lg)] leading-[length:var(--lh-h1)] lg:leading-[length:var(--lh-display-sm)] xl:leading-[length:var(--lh-display-lg)] max-w-170 text-generic-100 font-semibold font-heading mb-4 m-0 text-center"
                >
                    {titlePrefix}
                    {
                        titleHighlight && (
                            <span class="text-generic-100 bg-flux-lime px-1 rounded-lg">
                                {titleHighlight}
                            </span>
                        )
                    }
                    {titleSuffix}
                </h2>

                <!-- Description -->
                <p
                    class="text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-lg)] sm:leading-[length:var(--lh-body-lg)] max-w-170 text-neutral-500 font-normal font-body mb-6 md:mb-8 lg:mb-12 text-center"
                >
                    {description}
                </p>
                <!-- Statistics -->
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6 md:mb-8 lg:mb-12"
                >
                    <div
                        class="flex bg-generic-00 border-2 border-[#CCCCCC] items-center gap-2.5 py-3.5 px-3 rounded-lg"
                    >
                        <img
                            src="/public/images/scale-and-security-page/innovice-icon.png"
                            alt=""
                            class="w-6 h-4.5"
                        />
                        <p
                            class="text-[#6B7280] text-base font-medium leading-[1.12]"
                        >
                            1B+ E-Invoices annually
                        </p>
                    </div>
                    <div
                        class="flex bg-generic-00 border-2 border-[#CCCCCC] items-center gap-2.5 py-3.5 px-3 rounded-lg"
                    >
                        <img
                            src="/public/images/scale-and-security-page/10k-peak-icon.png"
                            alt=""
                            class="w-6 h-4.5"
                        />
                        <p
                            class="text-[#6B7280] text-base font-medium leading-[1.12]"
                        >
                            10K/s Peak invoice throughput
                        </p>
                    </div>
                    <div
                        class="flex bg-generic-00 border-2 border-[#CCCCCC] items-center gap-2.5 py-3.5 px-3 rounded-lg"
                    >
                        <img
                            src="/public/images/scale-and-security-page/countries.png"
                            alt=""
                            class="w-6 h-4.5"
                        />
                        <p
                            class="text-[#6B7280] text-base font-medium leading-[1.12]"
                        >
                            50+ Countries covered
                        </p>
                    </div>
                    <div
                        class="flex bg-generic-00 border-2 border-[#CCCCCC] items-center gap-2.5 py-3.5 px-3 rounded-lg"
                    >
                        <img
                            src="/public/images/scale-and-security-page/rupees.png"
                            alt=""
                            class="w-6 h-4.5"
                        />
                        <p
                            class="text-[#6B7280] text-base font-medium leading-[1.12]"
                        >
                            $500B+ Invoices processed
                        </p>
                    </div>
                </div>
                <!-- Call to Action buttons -->
                <div class="flex items-center justify-center gap-4">
                    <a
                        href="javascript:void(0)"
                        onclick="document.getElementById('contactForm').scrollIntoView({behavior:'smooth'})"
                        class="inline-flex items-center justify-center gap-2 px-5 py-3.5 font-body rounded-lg font-medium text-white text-[length:var(--fs-body)] leading-[length:var(--lh-body)] cursor-pointer bg-nova-blue border border-nova-blue hover:bg-generic-00 hover:text-nova-blue transition-all duration-150 ease-in-out"
                        style="outline: none;"
                    >
                        Book a Demo
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    // Smooth scroll logic
    window.scrollToContactForm = (e) => {
        e.preventDefault();
        const contactForm = document.getElementById("contact-form");
        if (contactForm) {
            contactForm.scrollIntoView({ behavior: "smooth" });
            history.replaceState(
                null,
                "",
                window.location.pathname + window.location.search,
            );
        }
    };
</script>
