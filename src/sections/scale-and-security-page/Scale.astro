---

const asideMenu = [
    { label: 'At Scale' },
    { label: 'Entity Management' },
    { label: 'Compliance APIs' },
    { label: 'Data Encryption' },
    { label: 'Zero Trust' }
];

const cardsData = [
    {
        title: 'Processing at scale no queues, no delays ',
        description: 'Auto-scaling clusters spin up in under 30 seconds. Year-end bulk runs complete in minutes. 300M+ invoices annually in KSA alone.',
        points: [
            {label:'200-300ms processing' , cardIcon:'bg-visual-placeholder'},
            {label:'Auto-scaling clusters' , cardIcon:'bg-visual-placeholder'},
            {label:'10,000 invoices/second' , cardIcon:'bg-visual-placeholder'},
            {label:'Multi-region residency' , cardIcon:'bg-visual-placeholder'}
        ]
    },
    {
        title: 'One platform for every subsidiary',
        description: 'Manage entities, jurisdictions & compliance rules from one workspace across your corporate sutrcture.',
        points: [
            {label:'Unlimited entity hierarchy' , cardIcon:'bg-visual-placeholder'},
            {label:'Consolidated dashboards' , cardIcon:'bg-visual-placeholder'},
            {label:'Jurisdiction auto-routing' , cardIcon:'bg-visual-placeholder'},
            {label:'Role-based access' , cardIcon:'bg-visual-placeholder'}
        ]
    },
    {
        title: 'Embed compliance into any workflow',
        description: 'Add e-invoicing, filing, and compliance workflows directly into ERP, billing, and finance systems.',
        points: [
            {label:'Multi-language SDKs' , cardIcon:'bg-visual-placeholder'},
            {label:'Duplicate filing prevention' , cardIcon:'bg-visual-placeholder'},
            {label:'Real-time webhooks' , cardIcon:'bg-visual-placeholder'},
            {label:'Country-level configuration' , cardIcon:'bg-visual-placeholder'}
        ]
    },
    {
        title: 'Every byte encrypted, at rest and in transit',
        description: 'Protect financial data with encryption controls, managed keys, and secure data movement across sysmtems.',
        points: [
            {label:'AES-256 encryption' , cardIcon:'bg-visual-placeholder'},
            {label:'Customer-managed keys' , cardIcon:'bg-visual-placeholder'},
            {label:'TLS 1.3 in transit' , cardIcon:'bg-visual-placeholder'},
            {label:'HSM-backed storage' , cardIcon:'bg-visual-placeholder'}
        ]
    },
    {
        title: 'Identity-first, least-privilege by default',
        description: 'Every request is authenticated, authorized, and logged with fine-grained access controls.',
        points: [
            {label:'SAML / OIDC SSO' , cardIcon:'bg-visual-placeholder'},
            {label:'Attribute-based access' , cardIcon:'bg-visual-placeholder'},
            {label:'MFA enforcement' , cardIcon:'bg-visual-placeholder'},
            {label:'Immutable audit logs' , cardIcon:'bg-visual-placeholder'}
        ]
    }
];

---

<section class="sc-invoice-stack-section py-12 md:py-16 bg-generic-00">
    <div class="min-[1400px]:container mx-auto w-full px-4 md:px-6">
        <!-- Section Header (Scrolls away naturally) -->
        <div id="sc-invoice-header-text" class="text-center w-full mx-auto mb-8 md:mb-12 bg-generic-00">
            <h2 class="font-heading font-medium text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] text-text-default max-w-250 mx-auto m-0 mb-3">
                Infrastructure <span class="text-generic-100 bg-flux-lime px-1 rounded-lg">That Grows</span> With You</h2>
            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-neutral-500 max-w-140 font-normal mx-auto">
                From the first return to millions of invoices across every jurisdiction — our platform handles it without blinking.</p>
        </div>

        <!-- Main Stack Layout Grid -->
        <div class="relative max-w-[1280px] mx-auto w-full flex flex-col md:flex-row gap-6 lg:gap-10 items-start">
            <!-- Aside Menu (Sticky Left Sidebar) -->
            <div
                id="sc-aside-menu"
                class="hidden md:flex flex-col gap-3 w-40 lg:w-48 shrink-0 sticky z-30 pt-2 pointer-events-auto"
                style="top: calc(var(--nav-clear, 112px) + 8px);"
            >
                {asideMenu.map((item, btnIdx) => (
                    <button
                        type="button"
                        class={`sc-aside-menu-item text-left border-l-2 pl-3.5 py-0.5 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-body transition-colors duration-200 cursor-pointer bg-transparent border-t-0 border-r-0 border-b-0 outline-none ${
                            btnIdx === 0
                                ? 'active-aside border-[#655DFF] text-text-default font-medium'
                                : 'border-transparent text-text-default/28 font-normal'
                        }`}
                        data-card-index={btnIdx}
                    >
                        {item.label}
                    </button>
                ))}
            </div>

            <!-- Cards Stack (Right Column) -->
            <div id="sc-invoice-stack-container" class="invoice-stack flex-1 w-full flex flex-col gap-[30vh] md:gap-[50vh]">
                {cardsData.map((card, index) => (
                    <div
                        class="invoice-stack-sticky sticky"
                        style={`top: calc(var(--nav-clear, 112px) + ${index * 16}px); z-index: ${index};`}
                    >
                        <div
                            class="invoice-stack-card w-full border-2 border-neutral-300 rounded-xl min-h-[372px] md:min-h-0 md:h-[clamp(340px,calc(100vh-var(--nav-clear,112px)-64px),520px)] bg-generic-00 will-change-transform flex flex-col md:flex-row"
                            style="transform-origin: top center;"
                        >
                            <div class="flex-1 p-5 sm:p-6 flex flex-col justify-between items-start">
                                <div class="w-full">
                                    <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-2 md:mb-3 text-text-default max-w-98 font-medium">
                                        {card.title}
                                    </h3>
                                    <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] font-normal max-w-98">
                                        {card.description}
                                    </p>
                                </div>
                                <div class="mt-4 md:mt-auto grid grid-cols-2 gap-3 xl:gap-x-8 xl:gap-y-6 w-full">
                                    {
                                        card.points.map((point) => (
                                            <div class="flex items-center gap-2.5">
                                                <div class={`w-5 h-5 md:w-6 md:h-6 rounded-sm shrink-0 ${point.cardIcon}`}></div>
                                                <span class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-normal text-neutral-500">{point.label}</span>
                                            </div>
                                        ))
                                    }
                                </div>
                            </div>
                            <div class="w-full md:w-[40%] lg:w-[50%] p-4 md:p-5 lg:p-6 flex">
                                <div class="w-full h-full min-h-[180px] md:min-h-0 rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                            </div>
                        </div>
                    </div>
                ))}

                <!-- Gap after the stack finishes -->
                <div style="height: 80px;"></div>
            </div>
        </div>
    </div>
</section>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    .invoice-stack {
      gap: 2rem !important;
    }
    .invoice-stack-sticky {
      position: static !important;
    }
    .invoice-stack-card {
      transform: none !important;
      height: auto !important;
    }
  }

  @media (max-height: 800px) and (min-width: 768px) {
    .sc-invoice-stack-section {
      padding-top: 1.5rem !important;
      padding-bottom: 1.5rem !important;
    }
    .invoice-stack-card {
      height: clamp(300px, calc(100vh - var(--nav-clear, 112px) - 140px), 430px) !important;
    }
    .invoice-stack-card h3 {
      font-size: clamp(1.25rem, 2.2vh, 1.75rem) !important;
      line-height: 1.25 !important;
      margin-bottom: 0.35rem !important;
    }
    .invoice-stack-card p {
      font-size: clamp(0.875rem, 1.7vh, 1rem) !important;
      line-height: 1.35 !important;
    }
    .invoice-stack-card .grid {
      gap: 0.5rem !important;
      padding-top: 0.25rem !important;
    }
  }

  @media (max-height: 680px) and (min-width: 768px) {
    .invoice-stack-card {
      height: clamp(260px, calc(100vh - var(--nav-clear, 112px) - 100px), 350px) !important;
    }
    .invoice-stack-card > div {
      padding: 0.875rem !important;
    }
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    const stack = document.getElementById('sc-invoice-stack-container');
    if (!stack) return;

    const asideMenuEl = document.getElementById('sc-aside-menu');
    const outers = Array.from(stack.querySelectorAll('.invoice-stack-sticky'));
    const inners = Array.from(stack.querySelectorAll('.invoice-stack-card'));

    if (!outers.length || outers.length !== inners.length) return;

    const reduceMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    const STACK_OFFSET = 16;
    const NAV_CLEAR =
        parseFloat(
            getComputedStyle(document.documentElement).getPropertyValue('--nav-clear'),
        ) || 112;

    const targetScaleFor = (i) => 0.88 + i * 0.03;

    const zoomFactor = () => {
        let z = 1;
        for (let n = stack; n && n.nodeType === 1; n = n.parentElement) {
            const v = parseFloat(getComputedStyle(n).zoom);
            if (v && v !== 1) z *= v;
        }
        return z;
    };

    let zoom = zoomFactor();
    let outersStickyTop = [];
    let lastActiveIdx = -1;
    const sidebarBtns = Array.from(document.querySelectorAll('.sc-aside-menu-item'));

    const setTops = () => {
        zoom = zoomFactor();

        // Measure static height of card without mutating transform (eliminates layout thrashing)
        const cardHeight = inners[0] ? (inners[0].offsetHeight / zoom) : 380;
        let firstTop = NAV_CLEAR;

        if (window.innerWidth >= 768) {
            const totalStackHeight = cardHeight + (outers.length - 1) * STACK_OFFSET;
            const viewportCss = window.innerHeight / zoom;
            firstTop = Math.max(NAV_CLEAR, (viewportCss - totalStackHeight) / 2);
        }

        for (let i = 0; i < outers.length; i++) {
            outers[i].style.top = (firstTop + i * STACK_OFFSET) + 'px';
        }

        outersStickyTop = outers.map((el) => (parseFloat(el.style.top) || NAV_CLEAR) * zoom);

        if (asideMenuEl) {
            const asideTopOffset = 8;
            const lastCardOffset = (outers.length - 1) * STACK_OFFSET;
            const asideTargetHeight = cardHeight + (lastCardOffset - asideTopOffset);
            asideMenuEl.style.top = (firstTop + asideTopOffset) + 'px';
            asideMenuEl.style.minHeight = asideTargetHeight + 'px';
        }
    };

    let ticking = false;

    const update = () => {
        const tops = outers.map((el) => el.getBoundingClientRect().top);
        const revealDistance = Math.max(260, (window.innerHeight / zoom) * 0.45);

        let activeIdx = 0;
        inners.forEach((inner, i) => {
            if (i === inners.length - 1) {
                inner.style.transform = 'scale(1) translateZ(0)';
                return;
            }

            const nextStickyTopPx = outersStickyTop[i + 1] || ((NAV_CLEAR + (i + 1) * STACK_OFFSET) * zoom);
            const distanceToStick = tops[i + 1] - nextStickyTopPx;

            const progress = Math.min(1, Math.max(0, 1 - distanceToStick / revealDistance));
            const scale = 1 - progress * (1 - targetScaleFor(i));
            inner.style.transform = `scale(${scale.toFixed(4)}) translateZ(0)`;
        });

        for (let i = 0; i < tops.length; i++) {
            const stickyTop = outersStickyTop[i] || (NAV_CLEAR * zoom);
            if (tops[i] <= stickyTop + 60) {
                activeIdx = i;
            }
        }

        if (activeIdx !== lastActiveIdx) {
            lastActiveIdx = activeIdx;
            sidebarBtns.forEach((btn, idx) => {
                if (idx === activeIdx) {
                    btn.classList.add('border-[#655DFF]', 'text-text-default', 'font-medium');
                    btn.classList.remove('border-transparent', 'text-text-default/28', 'font-normal');
                } else {
                    btn.classList.remove('border-[#655DFF]', 'text-text-default', 'font-medium');
                    btn.classList.add('border-transparent', 'text-text-default/28', 'font-normal');
                }
            });
        }

        ticking = false;
    };

    const getUnstuckTop = (el) => {
        let top = 0;
        let curr = el;
        while (curr) {
            top += curr.offsetTop;
            curr = curr.offsetParent;
        }
        return top;
    };

    const getCardTargetY = (index) => {
        const stickyTopPx = (parseFloat(outers[index].style.top) || NAV_CLEAR) * zoom;
        return getUnstuckTop(outers[index]) - stickyTopPx;
    };

    sidebarBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const index = parseInt(btn.getAttribute('data-card-index') || '0', 10);
            if (outers[index]) {
                const targetY = getCardTargetY(index);
                window.scrollTo({ top: targetY, behavior: 'smooth' });
            }
        });
    });

    const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
    };

    const handleLayoutShift = () => {
        setTops();
        update();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', handleLayoutShift);
    window.addEventListener('load', handleLayoutShift, { once: true });

    setTops();
    update();
});
</script>