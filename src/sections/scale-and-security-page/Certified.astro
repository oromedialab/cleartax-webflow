---
interface SecurityCard {
  title: string;
  desc: string;
  img: string;
}

const securityCards: SecurityCard[] = [
  {
    title: "SOC 2 Type II",
    desc: "Annual audit compliance for data security",
    img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa273ca73bb14a872601cdd_certified-1.png',
  },
  {
    title: "ISO 27001 / 22301",
    desc: "Information security & business continuity",
    img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa273cf73bb14a872601f01_Certified-2.png',
  },
  {
    title: "GDPR",
    desc: "Vulnerability assessment & penetration testing",
    img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa273d3edc1641713304fc5_certified-3.png',
  },
  {
    title: "SSL Transit",
    desc: "Encrypted data in transit with TLS 1.3",
    img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa273d99bbbfbc56719264b_certified-4.png',
  },
  {
    title: "AES 256-bit",
    desc: "Military-grade encryption at rest",
    img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa273dfeaf0b376c1df01db_certified-5.png',
  },
  {
    title: "VAPT",
    desc: "Vulnerability assessment and penetration testing",
    img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa273e43e29ca49beb12f69_certified-6.png',
  },
  {
    title: "Auth Tokens",
    desc: "Secure token-based authentication",
    img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa273eac82f83748302987f_certified-7.png'
  },
  {
    title: "Data Residency",
    desc: "Multi cloud hosting with local data residency",
    img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa273f0dbd332ed119c5bbd_certified-8.png',
  },
  {
    title: "Privacy",
    desc: "Regulatory-compliant data privacy",
    img: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa273f5f7b2994b8b92d7f1_certified-9.png',
  }
];
---

<section
  id="security"
  class="bg-generic-00 py-16 sm:py-20"
>
  <div class="mx-auto w-full px-4 lg:px-6 min-[1400px]:container">
    <h2
      class="m-0 text-center text-[length:var(--fs-h2)] lg:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] lg:leading-[length:var(--lh-h1)] font-medium text-vault-navy max-w-170 mx-auto mb-4"
    >
      Certified, Audited, And <span class="bg-flux-lime px-1 rounded-lg text-generic-100"> Trusted</span>
    </h2>
    <p
      class="text-center max-w-143 mx-auto text-[length:var(--fs-body)] leading-[length:var(--lh-body)] lg:text-[length:var(--fs-body-lg)] lg:leading-[length:var(--lh-body-lg)] font-normal text-neutral-500 font-body"
    >
      Independent third-party audits and international certifications. We hold ourselves to the highest standards of security and data protection globally. 
    </p>

    <div
      class="mt-8 sm:mt-12 grid gap-4 sm:gap-6 md:gap-8 sm:max-lg:grid-cols-2 lg:grid-cols-3"
    >
      {
        securityCards.map((card) => (
          <div
            class="flex flex-col h-full justify-between bg-generic-00 border-2 border-neutral-300 rounded-xl p-5 min-h-[200px] lg:p-8"
          >
            <div>
              {card.img && <img src={card.img} alt={card.title} />}
            </div>
            <div class="mt-auto">
              <h3 class="m-0 font-medium text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] text-text-default">
                {card.title}
              </h3>
              <p class="mt-3 mb-0 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-normal text-neutral-500 font-body">
                {card.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
