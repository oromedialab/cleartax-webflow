---
const DataPoints = [
    {
        iconBg: 'bg-[#EAF8E6]',
        title: 'Disaster Recovery',
        desc: 'Instant failover across local providers keeps operations running without single-vendor dependency.'
    },
    {
        iconBg: 'bg-[#EAF8E6]',
        title: 'Data Sovereignty',
        desc: 'Data is processed and stored within your designated region to meet local compliance requirements.'
    },
    {
        iconBg: 'bg-[#EAF8E6]',
        title: 'High-Scale Performance',
        desc: 'Proven infrastructure supports high-volume e-invoicing across regulated markets.'
    }
];

const BLUE_DOT_ROWS = [8, 8, 16, 16, 24, 24, 24];
---

<section class="bg-generic-00 py-16 md:py-20">
    <div class="mx-auto w-full min-[1400px]:container px-4 md:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
            
            <!-- Left Column: Title, Description & Dot Matrix -->
            <div class="lg:col-span-6 xl:col-span-6 flex flex-col h-full justify-between">
                <div>
                    <h2 class="text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-text-default max-w-120 mb-4 md:mb-6">
                        Sovereign infrastructure. Zero single points of failure.
                    </h2>
                    <p class="text-neutral-500 font-normal text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] max-w-120">
                        Deploy across AWS, OCI, or GCP based on each country’s regulatory, performance, and data residency needs.
                    </p>
                </div>

                <!-- Blue Dot Matrix -->
                <div class="hidden lg:flex flex-col gap-3.5 select-none mt-auto">
                    {BLUE_DOT_ROWS.map((count) => (
                        <div class="flex items-center gap-3.5">
                            {Array.from({ length: count }).map(() => (
                                <span class="w-1 h-1 rounded-full bg-nova-blue shrink-0 inline-block aspect-square" />
                            ))}
                        </div>
                    ))}
                </div>
            </div>

            <!-- Right Column: Feature List -->
            <div class="lg:col-span-6 xl:col-span-6 flex flex-col divide-y divide-neutral-200">
                {DataPoints.map((item) => (
                    <div class="flex items-center gap-6 py-8 first:pt-0 last:pb-0">
                        <div class={`w-20 h-20 sm:w-30 sm:h-30 rounded-lg shrink-0 ${item.iconBg}`} />
                        <div class="flex flex-col justify-center">
                            <h3 class="text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] font-medium text-vault-navy mb-2 font-heading">
                                {item.title}
                            </h3>
                            <p class="text-vault-navy/70 font-normal text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-body max-w-140">
                                {item.desc}
                            </p>
                        </div>
                    </div>
                ))}
            </div>

        </div>
    </div>
</section>