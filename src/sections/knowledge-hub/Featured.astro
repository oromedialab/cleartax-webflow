---
/**
 * "Featured resources" — Figma node 15070:48199, mirrors the structure of
 * `sections/events/Upcoming.astro` byte for byte (bordered panel, lead card
 * left, scrolling rail right, same fade/scrollbar/scroll-hint treatment).
 * Content comes from `featuredResources` in `src/data/knowledge-hub.ts`; the
 * lead is the first entry and the rail is everything after it.
 *
 * THE RAIL SCROLLS, IT DOES NOT PAGE — see the note in `events/Upcoming.astro`
 * for why: a plain overflow region with a styled scrollbar and two overlay
 * gradients, no script beyond the one-time scroll hint.
 *
 * Resources have no detail page, so every card links straight to `href` (the
 * resource's own URL) and opens in a new tab — unlike the events rail, which
 * routes through `eventPath` to an in-repo page.
 *
 * `image: ''` renders the Figma "Visual Placeholder" tint. Drop in a Webflow
 * asset URL to replace it — never a `data:` URI.
 */
import { featuredResources } from '../../data/knowledge-hub';

const heading = 'Featured resources';
const subheading = 'Stay ahead with expert-led sessions designed for enterprise leaders';
const ctaLabel = 'Sign up to stay updated';
const ctaHref = 'https://www.cleartax.com/contact-us';

const lead = featuredResources[0];
const rail = featuredResources.slice(1);

/* Lead card: Popular chip (if tagged) is Flux Lime with navy text; the
   category chip beside it is the outlined neutral style. Matches Figma node
   15070:48220 exactly — the two chips use different text colours. */
const popularChipLead =
  'rounded-lg bg-flux-lime px-3 py-1.5 font-body font-medium text-vault-navy text-[length:var(--fs-label)] leading-[var(--lh-label)]';
const categoryChipLead =
  'inline-flex items-center gap-2 rounded-lg border border-ledger-300 bg-neutral-100 px-3 py-1.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[var(--lh-label)]';

/* Rail chips are a size down — 12px type in a 4px-radius chip, per Figma node
   14851:47977. Popular there is Flux Lime with neutral-700 text (not navy —
   the lead and rail chips disagree on this in Figma, and this follows each
   literally rather than silently reconciling them). */
const railPopularChip =
  'inline-flex items-center rounded bg-flux-lime px-1.5 py-0.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label-sm)] leading-[var(--lh-label-sm)]';
const railNeutralChip =
  'inline-flex items-center rounded border border-ledger-300 bg-neutral-100 px-1.5 py-0.5 font-body font-medium text-neutral-700 text-[length:var(--fs-label-sm)] leading-[var(--lh-label-sm)]';

const metaClass =
  'flex items-center gap-2 font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)] m-0';
---

<section class="bg-generic-00 py-12 md:py-20">
  <!-- Icon sprite: defined once, referenced by the lead card and every rail
       row. Prefixed `ct-kh-` — section CSS/markup ids are one flat namespace
       per Webflow page, and `events` already claims `ct-ev-*` on other pages. -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <symbol id="ct-kh-calendar" viewBox="0 0 20 20">
      <path
        d="M16.25 2.5H14.375V1.875C14.375 1.70924 14.3092 1.55027 14.1919 1.43306C14.0747 1.31585 13.9158 1.25 13.75 1.25C13.5842 1.25 13.4253 1.31585 13.3081 1.43306C13.1908 1.55027 13.125 1.70924 13.125 1.875V2.5H6.875V1.875C6.875 1.70924 6.80915 1.55027 6.69194 1.43306C6.57473 1.31585 6.41576 1.25 6.25 1.25C6.08424 1.25 5.92527 1.31585 5.80806 1.43306C5.69085 1.55027 5.625 1.70924 5.625 1.875V2.5H3.75C3.41848 2.5 3.10054 2.6317 2.86612 2.86612C2.6317 3.10054 2.5 3.41848 2.5 3.75V16.25C2.5 16.5815 2.6317 16.8995 2.86612 17.1339C3.10054 17.3683 3.41848 17.5 3.75 17.5H16.25C16.5815 17.5 16.8995 17.3683 17.1339 17.1339C17.3683 16.8995 17.5 16.5815 17.5 16.25V3.75C17.5 3.41848 17.3683 3.10054 17.1339 2.86612C16.8995 2.6317 16.5815 2.5 16.25 2.5ZM5.625 3.75V4.375C5.625 4.54076 5.69085 4.69973 5.80806 4.81694C5.92527 4.93415 6.08424 5 6.25 5C6.41576 5 6.57473 4.93415 6.69194 4.81694C6.80915 4.69973 6.875 4.54076 6.875 4.375V3.75H13.125V4.375C13.125 4.54076 13.1908 4.69973 13.3081 4.81694C13.4253 4.93415 13.5842 5 13.75 5C13.9158 5 14.0747 4.93415 14.1919 4.81694C14.3092 4.69973 14.375 4.54076 14.375 4.375V3.75H16.25V6.25H3.75V3.75H5.625ZM16.25 16.25H3.75V7.5H16.25V16.25Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-kh-clock" viewBox="0 0 20 20">
      <path
        d="M10 1.875C8.39303 1.875 6.82214 2.35152 5.486 3.24431C4.14985 4.1371 3.10844 5.40605 2.49348 6.8907C1.87852 8.37535 1.71762 10.009 2.03112 11.5851C2.34463 13.1612 3.11846 14.6089 4.25476 15.7452C5.39106 16.8815 6.8388 17.6554 8.41489 17.9689C9.99099 18.2824 11.6247 18.1215 13.1093 17.5065C14.594 16.8916 15.8629 15.8502 16.7557 14.514C17.6485 13.1779 18.125 11.607 18.125 10C18.1227 7.84581 17.266 5.78051 15.7427 4.25727C14.2195 2.73403 12.1542 1.87727 10 1.875ZM10 16.875C8.64026 16.875 7.31105 16.4718 6.18046 15.7164C5.04987 14.9609 4.16868 13.8872 3.64833 12.6309C3.12798 11.3747 2.99183 9.99237 3.2571 8.65875C3.52238 7.32513 4.17716 6.10013 5.13864 5.13864C6.10013 4.17715 7.32514 3.52237 8.65876 3.2571C9.99238 2.99183 11.3747 3.12798 12.631 3.64833C13.8872 4.16868 14.9609 5.04987 15.7164 6.18045C16.4718 7.31104 16.875 8.64025 16.875 10C16.8729 11.8227 16.1479 13.5702 14.8591 14.8591C13.5702 16.1479 11.8227 16.8729 10 16.875ZM15 10C15 10.1658 14.9342 10.3247 14.8169 10.4419C14.6997 10.5592 14.5408 10.625 14.375 10.625H10C9.83424 10.625 9.67527 10.5592 9.55806 10.4419C9.44085 10.3247 9.375 10.1658 9.375 10V5.625C9.375 5.45924 9.44085 5.30027 9.55806 5.18306C9.67527 5.06585 9.83424 5 10 5C10.1658 5 10.3247 5.06585 10.4419 5.18306C10.5592 5.30027 10.625 5.45924 10.625 5.625V9.375H14.375C14.5408 9.375 14.6997 9.44085 14.8169 9.55806C14.9342 9.67527 15 9.83424 15 10Z"
        fill="currentColor"></path>
    </symbol>
    <symbol id="ct-kh-arrow" viewBox="0 0 24 24">
      <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M8.25 3.75L19.5 3.75C19.6989 3.75 19.8897 3.82902 20.0303 3.96967C20.171 4.11032 20.25 4.30109 20.25 4.5V15.75C20.25 16.1642 19.9142 16.5 19.5 16.5C19.0858 16.5 18.75 16.1642 18.75 15.75V6.31066L5.03033 20.0303C4.73744 20.3232 4.26256 20.3232 3.96967 20.0303C3.67678 19.7374 3.67678 19.2626 3.96967 18.9697L17.6893 5.25L8.25 5.25C7.83579 5.25 7.5 4.91421 7.5 4.5C7.5 4.08579 7.83579 3.75 8.25 3.75Z"
        fill="currentColor"></path>
    </symbol>
  </svg>

  <div class="container">
    <div class="rounded-xl border-2 border-ledger-200 bg-generic-00 p-6">
      <!-- Section head -->
      <div
        class="flex flex-col gap-6 border-b border-ledger-200 pb-6 lg:flex-row lg:items-center lg:justify-between lg:gap-8"
      >
        <div class="flex flex-col gap-4">
          <h2
            class="font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[var(--lh-h1)] tracking-[var(--tracking-heading)] m-0"
          >
            {heading}
          </h2>
          <p
            class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[var(--lh-body-lg)] m-0"
          >
            {subheading}
          </p>
        </div>
        <a
          href={ctaHref} target="_blank"
          class="shrink-0 self-start rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 text-center font-body font-medium text-nova-50 text-[length:var(--fs-label-lg)] leading-[var(--lh-label-lg)] no-underline transition-all ease-in-out duration-150 hover:bg-generic-00 hover:text-nova-blue lg:self-auto"
        >
          {ctaLabel}
        </a>
      </div>

      <!-- `items-start`: the rail is a fixed-height scroller and the lead card
           is as tall as its own title, so neither should stretch to the other. -->
      <div class="mt-8 grid grid-cols-1 items-start gap-8 lg:grid-cols-[689fr_507fr]">
        <!-- Lead resource -->
        <a href={lead.href} target="_blank" rel="noopener" class="group flex flex-col gap-6 no-underline">
          <div
            class="relative aspect-video w-full overflow-hidden rounded-xl border border-ledger-300 bg-visual-placeholder"
          >
            {
              lead.image && (
                <img
                  src={lead.image}
                  alt={lead.title}
                  width="1280"
                  height="720"
                  loading="eager"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              )
            }

            <span class="absolute left-5 top-5 flex flex-wrap items-center gap-2">
              {lead.tags?.includes('Popular') && <span class={popularChipLead}>Popular</span>}
              <span class={categoryChipLead}>{lead.category}</span>
            </span>

            <span
              class="absolute right-5 top-5 flex h-10 w-10 items-center justify-center rounded-lg bg-ledger-white text-vault-navy transition-colors duration-200 group-hover:bg-nova-blue group-hover:text-ledger-white"
            >
              <svg width="20" height="20" aria-hidden="true" focusable="false"
                ><use href="#ct-kh-arrow"></use></svg
              >
            </span>
          </div>

          <div class="flex flex-col gap-4">
            <h3
              class="font-heading font-medium text-vault-navy text-[length:var(--fs-h3)] leading-[var(--lh-h3)] tracking-[var(--tracking-heading)] m-0 transition-colors duration-200 group-hover:text-nova-blue"
            >
              {lead.title}
            </h3>

            <div class="flex flex-wrap items-center gap-3">
              <p class={metaClass}>
                <svg width="20" height="20" class="shrink-0" aria-hidden="true" focusable="false"
                  ><use href="#ct-kh-calendar"></use></svg
                >
                <time datetime={lead.datetime}>{lead.date}</time>
              </p>
              <span class="h-4 w-px shrink-0 rounded-full bg-ledger-300" aria-hidden="true"></span>
              <p class={metaClass}>
                <svg width="20" height="20" class="shrink-0" aria-hidden="true" focusable="false"
                  ><use href="#ct-kh-clock"></use></svg
                >
                {lead.readTime}
              </p>
            </div>
          </div>
        </a>

        <!-- Rail. The wrapper is the positioning context for the two fades; the
             scroller inside owns the overflow so they never move with it. -->
        <div class="relative">
          <div
            class="kh-rail flex max-h-[535px] flex-col gap-6 overflow-y-auto py-8 pr-4"
            data-kh-rail
          >
            {
              rail.map((resource) => (
                <a href={resource.href} target="_blank" rel="noopener" class="group flex items-center gap-6 no-underline">
                  <span class="relative block h-[116px] w-[140px] shrink-0 overflow-hidden rounded-lg border border-ledger-300 bg-visual-placeholder sm:w-[206px]">
                    {resource.image && (
                      <img
                        src={resource.image}
                        alt={resource.title}
                        width="1280"
                        height="720"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover"
                      />
                    )}

                    {/* Hover affordance — only appears over the image on hover,
                        matching the events rail treatment. */}
                    <span class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
                      <span class="flex h-9 w-9 items-center justify-center text-vault-navy">
                        <svg width="20" height="20" aria-hidden="true" focusable="false">
                          <use href="#ct-kh-arrow" />
                        </svg>
                      </span>
                    </span>
                  </span>

                  <span class="flex min-w-0 flex-1 flex-col gap-3">
                    <span class="flex flex-col gap-2">
                      {/* Clamped: the rail column is narrow and a third line on
                          one row would push the whole list out of step. */}
                      <span class="line-clamp-2 font-body font-medium text-vault-navy text-[length:var(--fs-label-lg)] leading-[var(--lh-label-lg)] transition-colors duration-200 group-hover:text-nova-blue">
                        {resource.title}
                      </span>
                      {resource.author && (
                        <span class="truncate font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)]">
                          {resource.author}
                        </span>
                      )}
                    </span>

                    <span class="flex flex-wrap items-center gap-2 font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)]">
                      <span class="flex items-center gap-2">
                        <svg width="20" height="20" class="shrink-0" aria-hidden="true" focusable="false">
                          <use href="#ct-kh-calendar" />
                        </svg>
                        <time datetime={resource.datetime}>{resource.date}</time>
                      </span>
                      <span class="h-4 w-px shrink-0 rounded-full bg-ledger-300" aria-hidden="true" />
                      <span class="flex items-center gap-2">
                        <svg width="20" height="20" class="shrink-0" aria-hidden="true" focusable="false">
                          <use href="#ct-kh-clock" />
                        </svg>
                        {resource.readTime}
                      </span>
                    </span>

                    <span class="flex flex-wrap items-center gap-1">
                      {resource.tags?.includes('Popular') && <span class={railPopularChip}>Popular</span>}
                      <span class={railNeutralChip}>{resource.category}</span>
                      {resource.tags?.includes('Recently added') && (
                        <span class={railNeutralChip}>Recently added</span>
                      )}
                    </span>
                  </span>
                </a>
              ))
            }
          </div>

          <!-- The fades. `right-4` clears the scrollbar gutter so the thumb
               stays crisp at both ends — it is the only thing telling a reader
               the list continues. -->
          <div
            class="pointer-events-none absolute inset-x-0 top-0 right-4 h-14 bg-gradient-to-b from-generic-00 to-transparent"
            aria-hidden="true"
          >
          </div>
          <div
            class="pointer-events-none absolute inset-x-0 bottom-0 right-4 h-14 bg-gradient-to-t from-generic-00 to-transparent"
            aria-hidden="true"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* The rail's scrollbar, styled to the brand rather than left as OS chrome —
     mirrors `.ev-rail` in `sections/events/Upcoming.astro`. Prefixed `kh-`
     because section CSS is one flat namespace per Webflow page. */
  .kh-rail {
    scrollbar-width: thin;
    scrollbar-color: var(--color-ledger-300, #d7d0d1) transparent;
    scroll-behavior: auto;
  }

  .kh-rail::-webkit-scrollbar {
    width: 8px;
  }

  .kh-rail::-webkit-scrollbar-track {
    background: transparent;
  }

  .kh-rail::-webkit-scrollbar-thumb {
    background: var(--color-ledger-300, #d7d0d1);
    border-radius: 999px;
  }
</style>

<script is:inline>
  /* Scroll hint — plays ONCE, the first time the rail is on screen. Identical
     behaviour to `events/Upcoming.astro`'s hint, retargeted at `[data-kh-rail]`
     so the two pages' scripts never collide if both embeds land on one page. */
  (function () {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
      var rails = document.querySelectorAll('[data-kh-rail]');
      for (var i = 0; i < rails.length; i++) setup(rails[i]);
    }

    function setup(rail) {
      var PEEK = 72;
      var DOWN = 1400;
      var DELAY = 320;

      var reduce =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;

      if (rail.scrollHeight - rail.clientHeight < PEEK + 8) return;
      if (rail.scrollTop > 0) return;

      if (!('IntersectionObserver' in window)) {
        play();
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (!entries[i].isIntersecting) continue;
            observer.disconnect();
            play();
          }
        },
        { threshold: 0.33 }
      );
      observer.observe(rail);

      function play() {
        animate(rail, PEEK, DOWN, DELAY);
      }
    }

    function animate(rail, PEEK, DOWN, DELAY) {
      var start = null;
      var frame = 0;
      var cancelled = false;

      var events = ['wheel', 'touchstart', 'pointerdown', 'keydown'];

      function stop() {
        if (cancelled) return;
        cancelled = true;
        if (frame) cancelAnimationFrame(frame);
        for (var i = 0; i < events.length; i++) {
          rail.removeEventListener(events[i], stop);
        }
      }

      for (var i = 0; i < events.length; i++) {
        rail.addEventListener(events[i], stop, { passive: true });
      }

      function ease(t) {
        return 0.5 * (1 - Math.cos(Math.PI * t));
      }

      function step(now) {
        if (cancelled) return;
        if (start === null) start = now;

        var elapsed = now - start - DELAY;
        if (elapsed < 0) {
          frame = requestAnimationFrame(step);
          return;
        }

        if (elapsed >= DOWN) {
          rail.scrollTop = PEEK;
          stop();
          return;
        }

        rail.scrollTop = PEEK * ease(elapsed / DOWN);
        frame = requestAnimationFrame(step);
      }

      frame = requestAnimationFrame(step);
    }
  })();
</script>
