---
/**
 * "Discover more research & publications" head + the Search / Category /
 * Country / Sort by bar — Figma node 15070:48247. Structural and behavioural
 * twin of `sections/events/Filters.astro`: same pin-under-navbar mechanics,
 * same custom-listbox script, same `data-select-*` hooks. Only the field set
 * differs — Category replaces Type.
 *
 * THE HEAD AND THE BAR PIN TOGETHER, as one block — see the long comment in
 * `events/Filters.astro` for the full rationale (`position: sticky` is not
 * available because Webflow wraps each pasted Embed in its own div).
 *
 * Filtering/sorting logic lives in `Resources.astro`, which owns the card
 * grid, and reaches these controls through the `data-kh-*` hooks below using
 * document-level delegation — so it does not matter which Embed Webflow
 * renders first.
 *
 * The Category and Country option lists must stay in sync with the
 * `category` / `country` values in `src/data/knowledge-hub.ts`. They are
 * duplicated rather than imported because this section is pasted into
 * Webflow as an independent Embed and a stale option is harmless (it just
 * matches nothing) while a stale *value* would make a resource unreachable.
 */
const heading = 'Discover more research & publications';
const subheading =
  'Access in-depth research, practical guides, and playbooks for confident finance decisions.';

/* Exactly the four values `ResourceItem.category` allows. This is a closed
   set, unlike Country — a fifth option here would be unreachable by
   construction. */
const categories: string[] = ['Blog', 'Whitepaper', 'Report', 'Case study'];

const countries: string[] = [
  'Global',
  'India',
  'UAE',
  'Saudi Arabia',
  'Malaysia',
  'France',
  'Germany',
  'Singapore',
];

const fieldClass =
  'h-10 w-full rounded-lg border border-neutral-200 bg-generic-00 px-3 py-2 font-body font-normal text-[length:var(--fs-label)] leading-[var(--lh-label)] text-neutral-900 shadow-[0px_1px_2px_0px_rgba(16,24,40,0.04)] outline-none transition-colors duration-150 placeholder:text-neutral-400 focus:border-nova-blue';

const labelClass =
  'font-body font-medium text-[length:var(--fs-label)] leading-[var(--lh-label)] text-neutral-900';

const triggerClass = `${fieldClass} group flex cursor-pointer items-center justify-between gap-2 text-left aria-expanded:border-nova-blue data-[placeholder]:text-neutral-400`;

const panelClass =
  'absolute left-0 right-0 top-[calc(100%+6px)] z-20 hidden max-h-64 overflow-y-auto rounded-lg border border-neutral-200 bg-generic-00 p-1 shadow-[0px_12px_24px_-6px_rgba(16,24,40,0.12)]';

const optionClass =
  'group flex cursor-pointer items-center justify-between gap-2 rounded-md px-3 py-2 font-body font-normal text-[length:var(--fs-label)] leading-[var(--lh-label)] text-neutral-900 outline-none transition-colors duration-100 hover:bg-ledger-100 focus:bg-ledger-100 aria-selected:bg-nova-50 aria-selected:font-medium aria-selected:text-nova-blue';

type SelectOption = { value: string; label: string };

const selects: Array<{
  id: string;
  name: string;
  label: string;
  hook: Record<string, string>;
  options: SelectOption[];
  value: string;
  width: string;
}> = [
  {
    id: 'kh-filter-category',
    name: 'category',
    label: 'Category',
    hook: { 'data-kh-category': '' },
    options: [{ value: '', label: 'Select' }, ...categories.map((c) => ({ value: c, label: c }))],
    value: '',
    width: 'md:flex-1 md:min-w-0',
  },
  {
    id: 'kh-filter-country',
    name: 'country',
    label: 'Country',
    hook: { 'data-kh-country': '' },
    options: [{ value: '', label: 'Select' }, ...countries.map((c) => ({ value: c, label: c }))],
    value: '',
    width: 'md:flex-1 md:min-w-0',
  },
  {
    id: 'kh-filter-sort',
    name: 'sort',
    label: 'Sort by',
    hook: { 'data-kh-sort': '' },
    options: [
      { value: 'new', label: 'New to old' },
      { value: 'old', label: 'Old to new' },
    ],
    value: 'new',
    width: 'md:flex-1 md:min-w-0',
  },
];
---

<!--
  THE SECTION IS A PURE SPACER; EVERY PIXEL OF THE BAND'S SPACING IS ON THE
  BLOCK INSIDE IT — same contract as `events/Filters.astro`: the block's box
  must be IDENTICAL pinned and unpinned, so no `data-[pinned]:` padding,
  margin or border-width on it, ever.
-->
<section data-kh-filter-root class="bg-generic-00">
  <div
    data-kh-filter-bar
    class="bg-generic-00 border-b border-ledger-200 pt-12 pb-8 md:pt-20 md:pb-12 transition-shadow duration-200 data-[pinned]:shadow-[0px_2px_6px_0px_rgba(16,24,40,0.06)]"
  >
    <div class="container mb-6 md:mb-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between lg:gap-8">
        <h2
          class="font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[var(--lh-h1)] tracking-[var(--tracking-heading)] m-0 lg:max-w-[672px]"
        >
          {heading}
        </h2>
        <p
          class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[var(--lh-body-lg)] m-0 lg:max-w-[427px]"
        >
          {subheading}
        </p>
      </div>
    </div>

    <div class="container">
      <form
        data-kh-filter
        role="search"
        aria-label="Filter resources"
        class="flex flex-col items-stretch justify-center gap-6 md:flex-row md:flex-wrap md:items-end md:gap-8"
      >
        <!-- Search -->
        <div class="flex w-full flex-col gap-2 md:w-[405px] md:shrink-0">
          <label class={labelClass} for="kh-filter-search">Search</label>
          <input
            id="kh-filter-search"
            name="search"
            type="search"
            autocomplete="off"
            placeholder="Enter"
            data-kh-search
            class={fieldClass}
          />
        </div>

        {
          selects.map((field) => (
            <div class={`flex w-full flex-col gap-2 ${field.width}`}>
              <span class={labelClass} id={`${field.id}-label`}>
                {field.label}
              </span>

              <div class="relative" data-kh-select>
                <select
                  {...field.hook}
                  id={field.id}
                  name={field.name}
                  class="sr-only"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {field.options.map((option) => (
                    <option value={option.value} selected={option.value === field.value}>
                      {option.label}
                    </option>
                  ))}
                </select>

                <button
                  type="button"
                  data-select-trigger
                  data-placeholder={field.value === '' ? '' : undefined}
                  id={`${field.id}-button`}
                  role="combobox"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-controls={`${field.id}-list`}
                  aria-labelledby={`${field.id}-label ${field.id}-button`}
                  class={triggerClass}
                >
                  <span data-select-value class="truncate">
                    {field.options.filter((o) => o.value === field.value)[0].label}
                  </span>
                  <svg
                    class="shrink-0 text-neutral-500 transition-transform duration-150 group-aria-expanded:rotate-180"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>

                <div
                  data-select-panel
                  id={`${field.id}-list`}
                  role="listbox"
                  tabindex="-1"
                  aria-labelledby={`${field.id}-label`}
                  class={panelClass}
                >
                  {field.options.map((option) => (
                    <div
                      data-select-option
                      data-value={option.value}
                      role="option"
                      aria-selected={option.value === field.value ? 'true' : 'false'}
                      tabindex="-1"
                      class={optionClass}
                    >
                      <span class="truncate">{option.label}</span>
                      <svg
                        class="shrink-0 opacity-0 group-aria-selected:opacity-100"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </form>
    </div>
  </div>
</section>

<style is:global>
  /* THE STRIP ABOVE THE NAVBAR — same rationale as `events/Filters.astro`:
     `NavbarRb` is a floating card with a 16px gutter above it, and this cap
     keeps the pinned block's white extending to the top of the screen instead
     of letting cards scroll through that gutter. */
  [data-kh-filter-bar][data-pinned]::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    height: 50vh;
    background: var(--color-generic-00, #fff);
  }
</style>

<script is:inline>
  /* Custom listbox behaviour for Category, Country and Sort by — identical to
     `events/Filters.astro`, retargeted at `[data-kh-select]`. */
  (function () {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
      var roots = document.querySelectorAll('[data-kh-select]');
      for (var i = 0; i < roots.length; i++) setup(roots[i]);
    }

    function setup(root) {
      var select = root.querySelector('select');
      var trigger = root.querySelector('[data-select-trigger]');
      var panel = root.querySelector('[data-select-panel]');
      var valueEl = root.querySelector('[data-select-value]');
      if (!select || !trigger || !panel || !valueEl) return;

      var options = panel.querySelectorAll('[data-select-option]');
      if (!options.length) return;

      function isOpen() {
        return trigger.getAttribute('aria-expanded') === 'true';
      }

      function open() {
        panel.style.display = 'block';
        trigger.setAttribute('aria-expanded', 'true');
        var current = panel.querySelector('[aria-selected="true"]') || options[0];
        if (current) {
          current.focus();
          if (current.scrollIntoView) current.scrollIntoView({ block: 'nearest' });
        }
      }

      function close(returnFocus) {
        panel.style.display = 'none';
        trigger.setAttribute('aria-expanded', 'false');
        if (returnFocus) trigger.focus();
      }

      function choose(option) {
        var value = option.getAttribute('data-value');

        for (var i = 0; i < options.length; i++) {
          options[i].setAttribute('aria-selected', options[i] === option ? 'true' : 'false');
        }

        valueEl.textContent = option.textContent.trim();
        if (value) trigger.removeAttribute('data-placeholder');
        else trigger.setAttribute('data-placeholder', '');

        select.value = value;
        select.dispatchEvent(new Event('change', { bubbles: true }));

        close(true);
      }

      function step(from, delta) {
        var index = -1;
        for (var i = 0; i < options.length; i++) {
          if (options[i] === from) index = i;
        }
        var next = index + delta;
        if (next < 0) next = options.length - 1;
        if (next > options.length - 1) next = 0;
        options[next].focus();
        if (options[next].scrollIntoView) options[next].scrollIntoView({ block: 'nearest' });
      }

      trigger.addEventListener('click', function () {
        if (isOpen()) close(false);
        else open();
      });

      trigger.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open();
        } else if (e.key === 'Escape') {
          close(false);
        }
      });

      panel.addEventListener('click', function (e) {
        if (!e.target.closest) return;
        var option = e.target.closest('[data-select-option]');
        if (option) choose(option);
      });

      panel.addEventListener('keydown', function (e) {
        if (!e.target.closest) return;
        var option = e.target.closest('[data-select-option]');
        if (!option) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          step(option, 1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          step(option, -1);
        } else if (e.key === 'Home') {
          e.preventDefault();
          options[0].focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          options[options.length - 1].focus();
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          choose(option);
        } else if (e.key === 'Escape') {
          e.preventDefault();
          close(true);
        } else if (e.key === 'Tab') {
          close(false);
        }
      });

      document.addEventListener('click', function (e) {
        if (!isOpen()) return;
        if (root.contains(e.target)) return;
        close(false);
      });
    }
  })();
</script>

<script is:inline>
  /* Pin the head + filter block directly under the navbar for the length of
     the resource grid, then release it. Identical mechanics to
     `events/Filters.astro` — see that file for the full rationale, including
     why `position: sticky` is not available (Webflow wraps each pasted Embed
     in its own div) and the visual-px/layout-px split forced by `shared.css`'s
     `zoom` on `body` between 768px and 1439.98px. */
  (function () {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
      var root = document.querySelector('[data-kh-filter-root]');
      if (!root) return;
      var block = root.querySelector('[data-kh-filter-bar]');
      var grid = document.querySelector('[data-kh-grid-root]');
      if (!block || !grid) return;

      var navRoot = document.querySelector('[data-giwip-nav-root]');
      var navCard = navRoot ? navRoot.querySelector('[data-nav-card]') : null;

      var wideEnough = window.matchMedia('(min-width: 768px)');

      var EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';
      var EXIT = 420;

      var reduceMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var pinned = false;
      var releasedBelow = false;
      var zoom = 1;
      var sectionHeight = 0;
      var blockTop = 0;
      var blockHeightPx = 0;
      var blockHeightCss = 0;
      var navBottomPx = 0;
      var pinTopCss = 0;
      var releaseTimer = null;
      var ticking = false;

      function measure() {
        if (pinned) return;

        blockHeightCss = block.offsetHeight;
        var rect = block.getBoundingClientRect();
        blockHeightPx = rect.height;
        zoom = blockHeightCss ? blockHeightPx / blockHeightCss : 1;

        sectionHeight = root.offsetHeight;
        blockTop = rect.top + window.pageYOffset;

        navBottomPx = navCard ? Math.max(0, navCard.getBoundingClientRect().bottom) : 0;
        pinTopCss = navBottomPx / zoom;
      }

      function offscreen() {
        return 'translateY(-' + (blockHeightCss + pinTopCss) + 'px)';
      }

      function pin(animateIn) {
        if (pinned) return;
        if (releaseTimer) {
          clearTimeout(releaseTimer);
          releaseTimer = null;
        }
        pinned = true;
        releasedBelow = false;

        root.style.height = sectionHeight + 'px';
        root.setAttribute('data-pinned', '');
        block.setAttribute('data-pinned', '');
        block.style.position = 'fixed';
        block.style.top = pinTopCss + 'px';
        block.style.left = '0';
        block.style.right = '0';
        block.style.zIndex = '900';
        block.style.willChange = 'transform';

        if (!animateIn || reduceMotion) {
          block.style.transition = '';
          block.style.transform = '';
          return;
        }

        block.style.transition = 'none';
        block.style.transform = offscreen();
        void block.offsetHeight;
        block.style.transition = 'transform ' + EXIT + 'ms ' + EASE;
        block.style.transform = 'translateY(0)';
      }

      function reset() {
        root.removeAttribute('data-pinned');
        block.removeAttribute('data-pinned');
        block.style.position = '';
        block.style.top = '';
        block.style.left = '';
        block.style.right = '';
        block.style.zIndex = '';
        block.style.transition = '';
        block.style.transform = '';
        block.style.willChange = '';
        root.style.height = '';
        measure();
      }

      function unpin(animateOut) {
        if (!pinned) return;
        pinned = false;
        releasedBelow = !!animateOut;

        if (!animateOut || reduceMotion) {
          reset();
          return;
        }

        block.style.transition = 'transform ' + EXIT + 'ms ' + EASE;
        block.style.transform = offscreen();
        releaseTimer = setTimeout(function () {
          releaseTimer = null;
          if (pinned) return;
          reset();
        }, EXIT);
      }

      function update() {
        ticking = false;

        if (!wideEnough.matches) {
          if (pinned) unpin(false);
          return;
        }

        var scrollY = window.pageYOffset;
        var past = scrollY - (blockTop - navBottomPx);
        var gridBottom = grid.getBoundingClientRect().bottom + scrollY;
        var stillOverGrid = gridBottom - scrollY > navBottomPx + blockHeightPx;

        if (past >= 0 && stillOverGrid) pin(releasedBelow);
        else if (pinned) unpin(past >= 0);
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', function () {
        measure();
        onScroll();
      });

      measure();
      update();
    }
  })();
</script>
