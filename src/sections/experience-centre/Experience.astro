/**
 * Experience Centre — Figma node 15070:52961 ("Experience Centre - {{insert
 * link}}"). One paste unit, deliberately.
 *
 * WHAT THE FIGMA FRAME IS
 * ---------------------------------------------------------------------------
 * A template: one tool page out of the six its sidebar lists. The sidebar items
 * do NOT navigate — clicking one swaps the whole right-hand column (tool, "How
 * to use", article, FAQ) for that tool's own content, in place.
 *
 * The swap is plain show/hide plus one CSS animation, and carries no library.
 * It was a Swiper pair for a while — `press/Hero.astro` and
 * `v1-clear-compliance-cloud/ComparisonComp.astro` use that pattern — but
 * sliding six panels sideways reads as a carousel, and this is a tab. See the
 * notes at the rail and panel markup for what replaced it and why.
 *
 * WHY ONE SECTION AND NOT SIX
 * ---------------------------------------------------------------------------
 * The mock is a two-column grid: the rail on the left (405px), everything else
 * on the right (843px, 32px gutter). Webflow Embeds stack vertically, so
 * splitting the right column into its own embeds would break the grid the
 * moment it was pasted — and the tab swap needs every panel in one DOM tree
 * anyway. The whole block ships as one embed.
 *
 * WHERE THE CSS IS
 * ---------------------------------------------------------------------------
 * `src/styles/experience-centre.css`, not a `<style is:global>` here. Six tools
 * of markup written as Tailwind utility strings blew past Webflow's ~50 KB
 * per-Embed cap; the `.exc-*` component classes move those bytes into the page
 * head bundle instead. The reasoning is written out at the top of that file.
 *
 * THE GREY BOX IN THE MOCK
 * ---------------------------------------------------------------------------
 * Figma draws every tool as an empty "Visual Placeholder", so the design does
 * not specify any calculator UI. The rest of each frame does: the "How to use"
 * card names the controls and the article gives the formulas. Each tool below is
 * built from its own published ClearTax page — the five links the rail used to
 * point at — so the in-page tool matches the one it replaces field for field.
 *
 * TWO TOOLS THAT COULD NOT BE PORTED WHOLE — see the notes at `roiAssumptions`
 * and at the HSN tool's `sections` list.
 */

import Dotgrid from "../_shared/Dotgrid.astro";

/* ------------------------------------------------------------------ types */

interface Block {
  kind: "h" | "p" | "ul" | "steps";
  text?: string;
  /* An `<a>` rendered before `text`. Avoids `set:html`, which this repo bans
     for React portability. */
  linkText?: string;
  linkHref?: string;
  items?: string[];
  groups?: { lead: string; lines: string[] }[];
}

interface Faq {
  q: string;
  a: string;
}

interface RateOption {
  value: number;
  label: string;
}

interface TaxType {
  label: string;
  rates: RateOption[];
}

interface Calc {
  kind: "rate" | "roi" | "hsn";
  currency?: string;
  amountLabel?: string;
  amount?: number;
  amountMax?: number;
  amountStep?: number;
  rateLabel?: string;
  rate?: number;
  /* Slider for VAT (the Figma "How to use" copy says slider); a select for the
     tools whose source page ships a fixed rate list. */
  rateSlider?: boolean;
  rates?: RateOption[];
  taxTypes?: TaxType[];
  inclusiveLabel?: string;
  inclusive?: boolean;
  netLabel?: string;
  taxLabel?: string;
  totalLabel?: string;
  /* GST: CGST/SGST/IGST rows plus the intra-state toggle that drives them. */
  split?: boolean;
  /* VAT: the country pill from the mock. */
  country?: boolean;
  note?: string;
}

interface Tool {
  id: string;
  label: string;
  calc: Calc;
  howTitle: string;
  howToUse: string[];
  article: Block[];
  faqs: Faq[];
}

