                                <input id="exc-roi-pans" class="exc-num" type="number" min="0" step="1" value="3" data-exc-roi="pans" />
                              </div>
                            </div>
                            <div class="exc-roi-field">
                              <label class="exc-label" for="exc-roi-revenue">Annual Sales Revenue (Cr)</label>
                              <div class="exc-field">
                                <input id="exc-roi-revenue" class="exc-num" type="number" min="0" step="1" value="500" data-exc-roi="revenue" />
                              </div>
                            </div>
                            <div class="exc-roi-field">
                              <label class="exc-label" for="exc-roi-sales">No of B2B Sales Invoices per year</label>
                              <div class="exc-field">
                                <input id="exc-roi-sales" class="exc-num" type="number" min="0" step="1000" value="240000" data-exc-roi="sales" />
                              </div>
                            </div>
                            <div class="exc-roi-field">
                              <label class="exc-label" for="exc-roi-purchase">No of Purchase Invoices per year</label>
                              <div class="exc-field">
                                <input id="exc-roi-purchase" class="exc-num" type="number" min="0" step="1000" value="180000" data-exc-roi="purchase" />
                              </div>
                            </div>
                            <div class="exc-roi-field">
                              <label class="exc-label" for="exc-roi-industry">Industry</label>
                              <select id="exc-roi-industry" class="exc-select" data-exc-roi="industry">
