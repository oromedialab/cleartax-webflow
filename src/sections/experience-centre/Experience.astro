                      </div>
                    )}

                    {/* --- Compliance ROI --- */}
                    {tool.calc.kind === "roi" && (
                      <div class="exc-calc exc-calc-roi">
                        <div class="exc-controls">
                          {/* The six mandatory fields from Clear's tool, in its
                              order, then its four optional ones. */}
                          <div class="exc-roi-fields">
                            <div class="exc-roi-field">
                              <label class="exc-label" for="exc-roi-gstins">No of GSTINs</label>
                              <div class="exc-field">
                                <input id="exc-roi-gstins" class="exc-num" type="number" min="0" step="1" value="12" data-exc-roi="gstins" />
                              </div>
                            </div>
                            <div class="exc-roi-field">
                              <label class="exc-label" for="exc-roi-pans">No of PANs</label>
