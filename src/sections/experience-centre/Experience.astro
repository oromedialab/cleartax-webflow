                              </select>
                            </div>
                            <div class="exc-roi-field">
                              <label class="exc-label" for="exc-roi-vendors">No. of Active Vendors per year</label>
                              <div class="exc-field">
                                <input id="exc-roi-vendors" class="exc-num" type="number" min="0" step="10" value="2500" data-exc-roi="vendors" />
                              </div>
                            </div>
                            <div class="exc-roi-field">
                              <label class="exc-label" for="exc-roi-blocking">Payment Blocking</label>
                              <select id="exc-roi-blocking" class="exc-select" data-exc-roi="blocking">
                                <option value="no">No</option>
                                <option value="yes">Yes</option>
                              </select>
                            </div>
                            <div class="exc-roi-field">
                              <label class="exc-label" for="exc-roi-lost">Any lost ITC Per Annum (%)</label>
                              <div class="exc-field">
                                <input id="exc-roi-lost" class="exc-num" type="number" min="0" step="0.1" value="0.5" data-exc-roi="lost" />
                                <span class="exc-affix">%</span>
                              </div>
                            </div>
                            <div class="exc-roi-field">
                              <label class="exc-label" for="exc-roi-delayed">Delayed ITC Per Annum (%)</label>
                              <div class="exc-field">
                                <input id="exc-roi-delayed" class="exc-num" type="number" min="0" step="0.1" value="1" data-exc-roi="delayed" />
                                <span class="exc-affix">%</span>
                              </div>
                            </div>
                            {/* Not on Clear's tool — it knows its own pricing, so
                                it can show a multiplier and payback without
                                asking. This build cannot, so the price is an
                                input rather than an invented constant. */}
                            <div class="exc-roi-field">
                              <label class="exc-label" for="exc-roi-cost">Annual platform cost (₹ lakh)</label>
                              <div class="exc-field">
                                <input id="exc-roi-cost" class="exc-num" type="number" min="0" step="1" value="60" data-exc-roi="cost" />
                              </div>
                            </div>
                          </div>
                          <p class="exc-note">{tool.calc.note}</p>
                        </div>

                        <div class="exc-result" aria-live="polite">
                          <div class="exc-out">
                            <span class="exc-out-label">Productivity savings</span>
                            <span class="exc-out-value" data-exc-roi-out="productivity" />
                          </div>
                          <div class="exc-out">
                            <span class="exc-out-label">Money Savings</span>
                            <span class="exc-out-value" data-exc-roi-out="money" />
                          </div>
                          <div class="exc-out">
                            <span class="exc-out-label">Assurance Savings</span>
                            <span class="exc-out-value" data-exc-roi-out="assurance" />
                          </div>
                          <div class="exc-rule" />
                          <div class="exc-out exc-out-total">
                            <span class="exc-out-label">Total Savings</span>
                            <span class="exc-out-value" data-exc-roi-out="total" />
                          </div>
                          <div class="exc-out">
                            <span class="exc-out-label">ROI</span>
                            <span class="exc-out-value" data-exc-roi-out="roi" />
                          </div>
                          <div class="exc-out">
                            <span class="exc-out-label">Payback Period</span>
                            <span class="exc-out-value" data-exc-roi-out="payback" />
                          </div>
                        </div>
                      </div>
                    )}

                    {/* --- HSN Code Finder --- */}
                    {tool.calc.kind === "hsn" && (
                      <div class="flex flex-col gap-6">
                        <div class="exc-hsn-form">
                          <div class="exc-field">
                            <input
                              id="exc-hsn-q"
                              class="exc-num"
                              type="search"
                              placeholder="Search a product, material or chapter number"
                              aria-label="Search HS sections"
                              data-exc-hsn-input
                            />
                          </div>
                          <a
                            class="exc-btn"
                            href="https://cleartax.in/s/gst-hsn-lookup"
                            target="_blank"
                            rel="noopener"
                          >
                            Open the full HSN database
                          </a>
                        </div>
                        <div class="exc-hsn-results">
                          <ul class="exc-hsn-list">
                            {hsSections.map((s) => (
                              <li
                                class="exc-hsn-row"
                                data-exc-hsn-row
                                data-text={`${s.chapters} ${s.title}`.toLowerCase()}
                              >
                                <span class="exc-hsn-chapters">{s.chapters}</span>
                                <span class="exc-out-label">{s.title}</span>
                              </li>
                            ))}
                          </ul>
                          <p class="exc-note exc-hsn-empty" data-exc-hsn-empty hidden>
                            No section matches that term. Try a broader word, or open the full database.
                          </p>
                        </div>
                        <p class="exc-note">{tool.calc.note}</p>
                      </div>
                    )}
                  </div>

                  {/* ----------------------------- how to use ------------- */}
                  <div class="exc-card flex flex-col gap-6 p-6">
                    <h2 class="exc-h2">{tool.howTitle}</h2>
                    <ul class="exc-steps">
                      {tool.howToUse.map((step) => (
                        <li class="exc-step">
                          <span class="exc-check" aria-hidden="true" />
                          <span>{step}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* --------------------------- article + faq -----------
                      One "doc" per tool, except the VAT tool, which gets one
                      per country: the pill swaps the written content along with
                      the currency and the rate. Only the active doc is in
                      flow. */}
                  {(tool.calc.country
                    ? countries.map((c, ci) => ({ key: c.short, active: ci === 0, article: c.article, faqs: c.faqs }))
                    : [{ key: tool.id, active: true, article: tool.article, faqs: tool.faqs }]
                  ).map((doc) => (
                    <div
                      class={`exc-stack-lg exc-doc ${doc.active ? "exc-is-active" : ""}`}
                      data-exc-doc={doc.key}
                    >
                      <div class="exc-prose">
                        {doc.article.map((block) =>
                          block.kind === "h" ? (
                            <h2 class="exc-h2 mt-16 first:mt-0">{block.text}</h2>
                          ) : block.kind === "p" ? (
                            <p>
                              {block.linkText && (
                                <a href={block.linkHref} target="_blank" rel="noopener">
                                  {block.linkText}
                                </a>
                              )}
                              {block.text}
                            </p>
                          ) : block.kind === "ul" ? (
                            <ul class="exc-list-tight">
                              {(block.items ?? []).map((li) => (
                                <li>{li}</li>
                              ))}
                            </ul>
                          ) : (
                            <ul class="exc-list">
                              {(block.groups ?? []).map((g) => (
                                <li>
                                  <strong>{g.lead}</strong>
                                  {g.lines.map((line) => (
                                    <p>{line}</p>
                                  ))}
                                </li>
                              ))}
                            </ul>
                          ),
                        )}
                      </div>

                      <div class="flex flex-col gap-6" data-exc-faq>
                        <h2 class="exc-h3">Frequently Asked Questions</h2>
                        <div class="exc-faq">
                          {doc.faqs.map((item, i) => (
                            <div class="exc-faq-item">
                              <button
                                type="button"
                                class="exc-faq-trigger"
                                aria-expanded="false"
                                aria-controls={`exc-faq-${doc.key}-${i}`}
                                id={`exc-faqt-${doc.key}-${i}`}
                              >
                                <span class="exc-faq-q">{item.q}</span>
                                <span class="exc-faq-icon" aria-hidden="true" />
                              </button>
                              <div
                                class="exc-faq-panel"
                                id={`exc-faq-${doc.key}-${i}`}
                                role="region"
                                aria-labelledby={`exc-faqt-${doc.key}-${i}`}
                              >
                                <p>{item.a}</p>
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    /* ClearTax does not publish the coefficients behind its Compliance ROI
       calculator, and inventing numbers that read as authoritative would be
       worse than useless on a tool finance teams quote from. So that panel
       takes the real input fields and the real three-category breakdown, and
       computes them from the named constants below. Anything that depends on a
       figure only the customer knows — lost ITC, platform cost — is an input,
       not a guess, which is why there is no invented "typical savings" number.

       REPLACE THESE with ClearTax's published model before the page goes live.
       The panel carries an "Indicative estimate" note for as long as they
       stand. */
    var ROI = {
      minutesPerInvoice: 0.75, // manual handling time removed per invoice
      personDaysPerGstin: 8, // return prep/recon days removed per GSTIN per year
      costPerPersonDay: 6000, // fully-loaded ₹ cost of a compliance person-day
      itcRecoveryRate: 0.7, // share of lost ITC recovered
      costOfCapital: 0.09, // annual cost of money delayed ITC ties up
      noticesPerPan: 3, // tax notices per PAN per year
      costPerNotice: 60000, // ₹ cost to answer one notice
      noticesAvoided: 0.5, // share of those notices avoided
    };

    function num(el, fallback) {
      var v = parseFloat(el && el.value);
      return isNaN(v) ? fallback || 0 : v;
    }

    function paintTrack(range) {
      var min = parseFloat(range.min) || 0;
      var max = parseFloat(range.max) || 100;
      var value = parseFloat(range.value) || 0;
      range.style.setProperty("--exc-fill", (max === min ? 0 : ((value - min) / (max - min)) * 100) + "%");
    }

    function clamp(v, min, max) {
      if (isNaN(v)) return min;
      return v < min ? min : v > max ? max : v;
    }

    /* ------------------------------------------------ rate calculators --- */
    function initRateCalc(root) {
      var currency = root.getAttribute("data-currency") || "";
      var split = !!root.querySelector("[data-exc-out-cgst]");
      var amountInput = root.querySelector("[data-exc-amount]");
      var amountRange = root.querySelector("[data-exc-amount-range]");
      var rateInput = root.querySelector("[data-exc-rate]");
      var rateRange = root.querySelector("[data-exc-rate-range]");
      var currencyLabel = root.querySelector("[data-exc-currency-label]");
      var out = {
        net: root.querySelector("[data-exc-out-net]"),
        tax: root.querySelector("[data-exc-out-tax]"),
        total: root.querySelector("[data-exc-out-total]"),
        cgst: root.querySelector("[data-exc-out-cgst]"),
        sgst: root.querySelector("[data-exc-out-sgst]"),
        igst: root.querySelector("[data-exc-out-igst]"),
      };
      var inclusive = root.querySelector('[data-exc-inclusive="yes"]').getAttribute("aria-checked") === "true";
      var intra = true;

      function money(value) {
        return (
          currency +
          " " +
          value.toLocaleString(currency === "₹" ? "en-IN" : "en-US", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          })
        );
      }

      function compute() {
        var amount = num(amountInput, 0);
        if (amount < 0) amount = 0;
        var rate = num(rateInput, 0);
        if (rate < 0) rate = 0;

        var net, tax, total;
        if (inclusive) {
          total = amount;
          tax = amount * (rate / (100 + rate));
          net = total - tax;
        } else {
          net = amount;
          tax = amount * (rate / 100);
          total = net + tax;
        }

        out.net.textContent = money(net);
        out.tax.textContent = money(tax);
        out.total.textContent = money(total);
        if (split) {
          out.cgst.textContent = money(intra ? tax / 2 : 0);
          out.sgst.textContent = money(intra ? tax / 2 : 0);
          out.igst.textContent = money(intra ? 0 : tax);
        }
      }

      function syncRanges() {
        /* The number field is deliberately unbounded above the slider's max —
           someone pricing a ₹40 lakh contract should not be capped by a control
           that exists for convenience. The slider just pins at its own max. */
        if (amountRange) {
          amountRange.value = String(clamp(num(amountInput, 0), 0, parseFloat(amountRange.max)));
          paintTrack(amountRange);
        }
        if (rateRange) {
          rateRange.value = String(clamp(num(rateInput, 0), 0, parseFloat(rateRange.max)));
          paintTrack(rateRange);
        }
      }

      function refresh() {
        syncRanges();
        compute();
      }

      if (amountRange) {
        amountRange.addEventListener("input", function () {
          amountInput.value = amountRange.value;
          paintTrack(amountRange);
          compute();
        });
      }
      if (rateRange) {
        rateRange.addEventListener("input", function () {
          rateInput.value = rateRange.value;
          paintTrack(rateRange);
          compute();
        });
      }
      amountInput.addEventListener("input", refresh);
      rateInput.addEventListener("input", refresh);
      if (rateInput.tagName === "SELECT") rateInput.addEventListener("change", refresh);

      function bindSegment(selector, apply) {
        var btns = root.querySelectorAll(selector);
        btns.forEach(function (btn) {
          btn.addEventListener("click", function () {
            btns.forEach(function (other) {
              var on = other === btn;
              other.classList.toggle("exc-segment-btn-on", on);
              other.setAttribute("aria-checked", on ? "true" : "false");
            });
            apply(btn);
            refresh();
          });
        });
      }

      bindSegment("[data-exc-inclusive]", function (btn) {
        inclusive = btn.getAttribute("data-exc-inclusive") === "yes";
      });
      bindSegment("[data-exc-intra]", function (btn) {
        intra = btn.getAttribute("data-exc-intra") === "yes";
      });
      /* SST: the tax type decides which rates are on offer, so the select is
         rebuilt rather than filtered. */
      bindSegment("[data-exc-taxtype]", function (btn) {
        var rates = (btn.getAttribute("data-rates") || "").split(",");
        rateInput.innerHTML = "";
        rates.forEach(function (r) {
          var opt = document.createElement("option");
          opt.value = r;
          opt.textContent = r + "%";
          rateInput.appendChild(opt);
        });
        rateInput.value = rates[0];
      });

      /* Country pill — VAT only. Swaps the currency and resets the rate to that
         market's standard rate. It does not re-write the article below, which
         is KSA-specific, which is why Saudi Arabia is the default. */
      var countryRoot = root.querySelector("[data-exc-country]");
      if (countryRoot) {
        var trigger = countryRoot.querySelector("[data-exc-country-trigger]");
        var menu = countryRoot.querySelector("[data-exc-country-menu]");
        var flag = countryRoot.querySelector("[data-exc-country-flag]");
        var label = countryRoot.querySelector("[data-exc-country-label]");

        function closeMenu() {
          menu.classList.remove("exc-is-open");
          trigger.setAttribute("aria-expanded", "false");
        }

        trigger.addEventListener("click", function (e) {
          e.stopPropagation();
          var open = menu.classList.toggle("exc-is-open");
          trigger.setAttribute("aria-expanded", open ? "true" : "false");
        });

        countryRoot.querySelectorAll("[data-exc-country-option]").forEach(function (option) {
          option.addEventListener("click", function () {
            var short = option.getAttribute("data-short");
            currency = option.getAttribute("data-currency");
            currencyLabel.textContent = currency;
            label.textContent = short;
            flag.setAttribute("src", option.getAttribute("data-flag"));
            rateInput.value = option.getAttribute("data-rate");
            countryRoot.querySelectorAll("[data-exc-country-option]").forEach(function (o) {
              o.setAttribute("aria-selected", o === option ? "true" : "false");
            });

            /* The article and FAQ below the tool are per country too. They sit
               outside the calculator's own root, so reach up to the panel. */
            var slide = root.closest(".exc-panel-slide");
            if (slide) {
              slide.querySelectorAll("[data-exc-doc]").forEach(function (doc) {
                doc.classList.toggle("exc-is-active", doc.getAttribute("data-exc-doc") === short);
              });
            }

            closeMenu();
            refresh();
          });
        });

        document.addEventListener("click", function (e) {
          if (!countryRoot.contains(e.target)) closeMenu();
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") closeMenu();
        });
      }

      refresh();
    }

    /* ---------------------------------------------------- ROI calculator -- */
    function initRoiCalc(root) {
      var fields = {};
      root.querySelectorAll("[data-exc-roi]").forEach(function (el) {
        fields[el.getAttribute("data-exc-roi")] = el;
      });
      var outs = {};
      root.querySelectorAll("[data-exc-roi-out]").forEach(function (el) {
        outs[el.getAttribute("data-exc-roi-out")] = el;
      });

      function rupees(value) {
        return "₹ " + Math.round(value).toLocaleString("en-IN");
      }

      function compute() {
        var gstins = num(fields.gstins);
        var pans = num(fields.pans);
        var revenue = num(fields.revenue) * 10000000; // ₹ crore → ₹
        var invoices = num(fields.sales) + num(fields.purchase);
        var cost = num(fields.cost) * 100000; // ₹ lakh → ₹

        // Productivity: person-days taken out of manual handling, priced.
        var personDays = (invoices * ROI.minutesPerInvoice) / 480 + gstins * ROI.personDaysPerGstin;
        var productivity = personDays * ROI.costPerPersonDay;

        /* Money: Clear's page takes lost and delayed ITC as percentages without
           saying of what. Read here as a share of annual sales revenue, which
           is the only turnover figure the form collects. Lost ITC is recovered
           outright; delayed ITC only returns the cost of the money for the time
           it was stuck, hence the two different rates. */
        var money =
          revenue * (num(fields.lost) / 100) * ROI.itcRecoveryRate +
          revenue * (num(fields.delayed) / 100) * ROI.costOfCapital;

        // Assurance: notices not raised, and the cost of answering them.
        var assurance = pans * ROI.noticesPerPan * ROI.costPerNotice * ROI.noticesAvoided;

        var total = productivity + money + assurance;

        outs.productivity.textContent = rupees(productivity);
        outs.money.textContent = rupees(money);
        outs.assurance.textContent = rupees(assurance);
        outs.total.textContent = rupees(total);

        if (cost > 0 && total > 0) {
          var multiple = total / cost;
          outs.roi.textContent = multiple.toFixed(1) + "×";
          outs.payback.textContent = Math.max(1, Math.round(365 / multiple)) + " days";
        } else {
          outs.roi.textContent = "—";
          outs.payback.textContent = "—";
        }
      }

      root.querySelectorAll("[data-exc-roi]").forEach(function (el) {
        el.addEventListener("input", compute);
        if (el.tagName === "SELECT") el.addEventListener("change", compute);
      });
      compute();
    }

    /* ------------------------------------------------------ HSN finder ---- */
    function initHsn(root) {
      var input = root.querySelector("[data-exc-hsn-input]");
      var rows = root.querySelectorAll("[data-exc-hsn-row]");
      var empty = root.querySelector("[data-exc-hsn-empty]");

      /* The button's label stays fixed. It used to read "Search <term> in the
         full database", which the href does not do — ClearTax's lookup takes no
         query parameter, so the link would have dropped the term on arrival. */
      input.addEventListener("input", function () {
        var q = input.value.trim().toLowerCase();
        var hits = 0;
        rows.forEach(function (row) {
          var match = !q || row.getAttribute("data-text").indexOf(q) !== -1;
          row.hidden = !match;
          if (match) hits++;
        });
        empty.hidden = hits > 0;
      });
    }

    /* ------------------------------------------------------------- FAQ ---- */
    function initFaq() {
      document.querySelectorAll("#exc-root [data-exc-faq]").forEach(function (group) {
        var items = group.querySelectorAll(".exc-faq-item");

        function closeItem(item) {
          var panel = item.querySelector(".exc-faq-panel");
          panel.style.height = panel.scrollHeight + "px";
          requestAnimationFrame(function () {
            panel.style.height = "0px";
          });
          item.classList.remove("exc-is-open");
          item.querySelector(".exc-faq-trigger").setAttribute("aria-expanded", "false");
        }

        function openItem(item) {
          var panel = item.querySelector(".exc-faq-panel");
          panel.style.height = panel.scrollHeight + "px";
          item.classList.add("exc-is-open");
          item.querySelector(".exc-faq-trigger").setAttribute("aria-expanded", "true");
          panel.addEventListener("transitionend", function handler(e) {
            if (e.propertyName !== "height") return;
            panel.removeEventListener("transitionend", handler);
            if (item.classList.contains("exc-is-open")) panel.style.height = "auto";
          });
        }

        items.forEach(function (item) {
          item.querySelector(".exc-faq-trigger").addEventListener("click", function () {
            if (item.classList.contains("exc-is-open")) {
              closeItem(item);
            } else {
              items.forEach(function (other) {
                if (other !== item && other.classList.contains("exc-is-open")) closeItem(other);
              });
              openItem(item);
            }
          });
        });

        window.addEventListener("resize", function () {
          items.forEach(function (item) {
            if (item.classList.contains("exc-is-open")) item.querySelector(".exc-faq-panel").style.height = "auto";
          });
        });
      });
    }

    /* ------------------------------------------------------------- tabs --- */
    function initTabs(root) {
      var tabs = root.querySelectorAll(".exc-tab");
      var slides = root.querySelectorAll(".exc-panel-slide");
      var panels = root.querySelector(".exc-panels");

      tabs.forEach(function (tab, i) {
        tab.addEventListener("click", function () {
          if (tab.getAttribute("aria-selected") === "true") return;

          tabs.forEach(function (t, ti) {
            t.setAttribute("aria-selected", ti === i ? "true" : "false");
          });
          /* The whole transition. Going `display: none` → `block` restarts the
             panel's CSS animation on its own, so there is no enter/leave state
             machine to keep in sync and nothing to clean up if a second tab is
             clicked mid-animation. */
          slides.forEach(function (s, si) {
            s.classList.toggle("exc-is-active", si === i);
          });

          // On mobile the rail is a scrolling strip, so the newly active tab may
          // sit off to one side. `inline: "nearest"` only scrolls when it does.
          tab.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });

          /* Panels differ in length by thousands of pixels. Switching from a
             long one to a short one while scrolled deep would otherwise leave
             you somewhere in the footer, so pull back to the top of the panel —
             but only when the switch happened from past that point. */
          var navClear = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--nav-clear")) || 112;
          var top = panels.getBoundingClientRect().top;
          if (top < navClear) {
            window.scrollTo({ top: window.pageYOffset + top - navClear, behavior: "smooth" });
          }
        });
      });
    }

    /* ------------------------------------------------------------- init --- */
    function init() {
      var root = document.getElementById("exc-root");
      if (!root || root.dataset.excReady) return;
      root.dataset.excReady = "true";

      root.querySelectorAll("[data-exc-calc]").forEach(function (calc) {
        var kind = calc.getAttribute("data-exc-calc");
        if (kind === "rate") initRateCalc(calc);
        else if (kind === "roi") initRoiCalc(calc);
        else if (kind === "hsn") initHsn(calc);
      });

      initFaq();
      initTabs(root);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
