                        <div class="exc-result" aria-live="polite">
                          <div class="exc-out">
                            <span class="exc-out-label">{tool.calc.netLabel}</span>
                            <span class="exc-out-value" data-exc-out-net />
                          </div>
                          <div class="exc-out">
                            <span class="exc-out-label">{tool.calc.taxLabel}</span>
                            <span class="exc-out-value" data-exc-out-tax />
                          </div>
                          {tool.calc.split && (
                            <>
                              <div class="exc-out">
                                <span class="exc-out-label">CGST</span>
                                <span class="exc-out-value" data-exc-out-cgst />
                              </div>
                              <div class="exc-out">
                                <span class="exc-out-label">SGST</span>
                                <span class="exc-out-value" data-exc-out-sgst />
                              </div>
                              <div class="exc-out">
                                <span class="exc-out-label">IGST</span>
                                <span class="exc-out-value" data-exc-out-igst />
                              </div>
                            </>
