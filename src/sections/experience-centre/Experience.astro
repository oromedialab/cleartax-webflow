<!-- No `overflow-hidden` on this section, deliberately. It would make the
     section a scrollport, and the sticky rail below resolves its offsets
     against the nearest scrollport — one that never scrolls. That both pushed
     the rail 168px down its own grid row and stopped it ever sticking. The dot
     band is inset within the section, so nothing needs clipping anyway. -->
<section
  id="exc-root"
  class="exc-section relative bg-generic-00 max-lg:pt-28 max-lg:pb-16 lg:pt-[184px] lg:pb-30"
>
  <!-- The lime dot field from the Figma BG layer, washed out at the centre so
       the cards keep contrast.

       Figma draws it as an 842px band at the top that fades out. Here it is a
       sticky viewport-height layer instead, so it stays under the content for
       the whole section rather than scrolling away after the first screen —
       which is also why the band's bottom fade is gone: on a fixed layer it
       would read as a permanent line across the viewport.

       The field is `_shared/Dotgrid.astro` — the same interactive canvas
       trust-centre and scale-and-security use, where each dot draws out into a
       stroke aimed at the cursor. It was a CSS drift for a while; at a pitch
       you can actually loop seamlessly the movement is imperceptible, so it
       read as a static field.

       Pointer coordinates resolve against the CANVAS's own rect, not the
       section's, which is what lets it sit inside a sticky layer and still
       track correctly. Listeners go on the section, so anywhere over the
       content drives it.

       `lineWidth` + `gap` is the pitch: 4 + 22 = the 26px the Figma BG layer
       measures. `maxLength` must stay under that or the strokes knit into a
       mesh. -->
  <div class="exc-bg" aria-hidden="true">
    <div class="exc-bg-inner">
      <Dotgrid
        containerId="exc-root"
        canvasId="exc-dotgrid"
        lineWidth={3}
        gap={22}
        maxLength={6}
        lengthRadius={260}
        tilt={1}
        baseColor="#C8F006"
        cursorRadius={320}
        pull={14}
        fadeRadius={40}
      />
      <div class="exc-bg-wash"></div>
    </div>
  </div>

  <div class="container relative z-10 mx-auto">
    <!-- `grid-cols-1` is load-bearing below lg, not decoration. Without it the
         single column is an implicit `auto` track, whose minimum is the items'
         min-content width — the nowrap tool labels — so the track refused to
         shrink and pushed the whole page ~700px wide on a phone. -->
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[405px_minmax(0,1fr)]">
      <!-- ============================== RAIL =============================== -->
      <aside class="exc-rail lg:sticky lg:top-[var(--nav-clear,112px)]">
        <div class="exc-rail-head">
          <h1 class="exc-rail-title">Experience centre</h1>
        </div>

        <!-- A plain list. This was briefly the thumbs half of a Swiper pair,
             which is worth recording as a warning: a vertical Swiper whose
             slides are `height: auto` is circular by construction —
             `slidesPerView: 6` derives each slide's size from the container's
             height, which is derived from the slides. It resolved at Chrome's
             33,554,432px layout ceiling and took the document's width with it.

             All six items are visible at once on desktop anyway, so there was
             never a carousel here to drive. -->
        <div class="exc-rail-list" role="tablist" aria-label="Experience Centre tools">
          {
            tools.map((tool, i) => (
              <button
                type="button"
                role="tab"
                id={`exc-tab-${tool.id}`}
                class="exc-tab"
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls={`exc-panel-${tool.id}`}
              >
                <span class="exc-tab-ind" aria-hidden="true" />
                <span>{tool.label}</span>
              </button>
            ))
          }
        </div>
      </aside>

      <!-- ============================= PANELS =============================
           Plain show/hide, no carousel. This was a Swiper, and sliding six
           panels sideways read as a carousel rather than a tab switch — which
           is what it is. Only the active panel is in flow; the incoming one
           cross-fades up into place via a CSS animation that replays on every
           `display: none` → `block` transition, so the script only has to move
           one class and never coordinates timings.

           Nothing animates the container's height. Panels differ by thousands
           of pixels and easing between those numbers is slow and draws the eye
           to the wrong thing; the rail is sticky, so the eye is already at the
           top where the swap happens. -->
      <div class="exc-panels min-w-0">
          {
            tools.map((tool, i) => (
              <div class={`exc-panel-slide ${i === 0 ? "exc-is-active" : ""}`}>
                <div
                  class="exc-stack"
                  id={`exc-panel-${tool.id}`}
                  role="tabpanel"
                  aria-labelledby={`exc-tab-${tool.id}`}
                >
                  {/* ------------------------------- the tool ------------- */}
                  <div class="exc-panel" data-exc-calc={tool.calc.kind} data-currency={tool.calc.currency}>
                    {tool.calc.country && (
                      <div class="flex justify-end">
                        <div class="exc-country" data-exc-country>
                          <button
                            type="button"
                            class="exc-country-trigger"
                            aria-haspopup="listbox"
                            aria-expanded="false"
                            data-exc-country-trigger
                          >
                            <img
                              class="exc-flag"
                              src={defaultCountry.flag}
                              alt=""
                              width="24"
                              height="18"
                              loading="lazy"
                              decoding="async"
                              data-exc-country-flag
                            />
                            <span data-exc-country-label>{defaultCountry.short}</span>
                            <svg class="exc-country-caret" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                              <path
                                d="M1 1.5 6 6.5 11 1.5"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </button>
                          <ul class="exc-country-menu" role="listbox" aria-label="Select country" data-exc-country-menu>
                            {countries.map((country) => (
                              <li>
                                <button
                                  type="button"
                                  role="option"
                                  aria-selected={country.short === defaultCountry.short ? "true" : "false"}
                                  class="exc-country-option"
                                  data-exc-country-option
                                  data-short={country.short}
                                  data-currency={country.currency}
                                  data-rate={String(country.rate)}
                                  data-flag={country.flag}
                                >
                                  <img class="exc-flag" src={country.flag} alt="" width="24" height="18" loading="lazy" decoding="async" />
                                  <span>{country.name}</span>
                                  <span class="exc-country-rate">{country.rate}%</span>
                                </button>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    )}

                    {/* --- rate calculators: VAT, SST, GST, Reverse GST --- */}
                    {tool.calc.kind === "rate" && (
                      <div class="exc-calc">
                        <div class="exc-controls">
                          {tool.calc.taxTypes && (
                            <div class="exc-row-inline">
                              <span class="exc-label" id={`exc-${tool.id}-type`}>
                                Type of tax
                              </span>
                              <div class="exc-segment" role="radiogroup" aria-labelledby={`exc-${tool.id}-type`}>
                                {tool.calc.taxTypes.map((type, ti) => (
                                  <button
                                    type="button"
                                    role="radio"
                                    aria-checked={ti === 0 ? "true" : "false"}
                                    class={`exc-segment-btn ${ti === 0 ? "exc-segment-btn-on" : ""}`}
                                    data-exc-taxtype
                                    data-rates={type.rates.map((r) => r.value).join(",")}
                                  >
                                    {type.label}
                                  </button>
                                ))}
                              </div>
                            </div>
                          )}

                          <div class="exc-row">
                            <div class="exc-row-inline">
                              <label class="exc-label" for={`exc-${tool.id}-amount`}>
                                {tool.calc.amountLabel}
                              </label>
                              <div class="exc-field">
                                <span class="exc-affix" data-exc-currency-label>
                                  {tool.calc.currency}
                                </span>
                                <input
                                  id={`exc-${tool.id}-amount`}
                                  class="exc-num"
                                  type="number"
                                  min="0"
                                  step="1"
                                  inputmode="decimal"
                                  value={String(tool.calc.amount)}
                                  data-exc-amount
                                />
                              </div>
                            </div>
                            <input
                              class="exc-slider"
                              type="range"
                              min="0"
                              max={String(tool.calc.amountMax)}
                              step={String(tool.calc.amountStep)}
                              value={String(tool.calc.amount)}
                              aria-label={tool.calc.amountLabel}
                              data-exc-amount-range
                            />
                          </div>

                          {tool.calc.rateSlider ? (
                            <div class="exc-row">
                              <div class="exc-row-inline">
                                <label class="exc-label" for={`exc-${tool.id}-rate`}>
                                  {tool.calc.rateLabel}
                                </label>
                                <div class="exc-field">
                                  <input
                                    id={`exc-${tool.id}-rate`}
                                    class="exc-num exc-num-sm"
                                    type="number"
                                    min="0"
                                    max="30"
                                    step="0.5"
                                    inputmode="decimal"
                                    value={String(tool.calc.rate)}
                                    data-exc-rate
                                  />
                                  <span class="exc-affix">%</span>
                                </div>
                              </div>
                              <input
                                class="exc-slider"
                                type="range"
                                min="0"
                                max="30"
                                step="0.5"
                                value={String(tool.calc.rate)}
                                aria-label={tool.calc.rateLabel}
                                data-exc-rate-range
                              />
                            </div>
                          ) : (
                            <div class="exc-row-inline">
                              <label class="exc-label" for={`exc-${tool.id}-rate`}>
                                {tool.calc.rateLabel}
                              </label>
                              <select id={`exc-${tool.id}-rate`} class="exc-select" data-exc-rate>
                                {(tool.calc.rates ?? tool.calc.taxTypes?.[0].rates ?? []).map((r) => (
                                  <option value={String(r.value)} selected={r.value === tool.calc.rate}>
                                    {r.label}
                                  </option>
                                ))}
                              </select>
                            </div>
                          )}

                          <div class="exc-row-inline">
                            <span class="exc-label" id={`exc-${tool.id}-incl`}>
                              {tool.calc.inclusiveLabel}
                            </span>
                            <div class="exc-segment" role="radiogroup" aria-labelledby={`exc-${tool.id}-incl`}>
                              <button
                                type="button"
                                role="radio"
                                aria-checked={tool.calc.inclusive ? "true" : "false"}
                                class={`exc-segment-btn ${tool.calc.inclusive ? "exc-segment-btn-on" : ""}`}
                                data-exc-inclusive="yes"
                              >
                                Yes
                              </button>
                              <button
                                type="button"
                                role="radio"
                                aria-checked={tool.calc.inclusive ? "false" : "true"}
                                class={`exc-segment-btn ${tool.calc.inclusive ? "" : "exc-segment-btn-on"}`}
                                data-exc-inclusive="no"
                              >
                                No
                              </button>
                            </div>
                          </div>

                          {tool.calc.split && (
                            <div class="exc-row-inline">
                              <span class="exc-label" id={`exc-${tool.id}-intra`}>
                                Selling within the same state?
                              </span>
                              <div class="exc-segment" role="radiogroup" aria-labelledby={`exc-${tool.id}-intra`}>
                                <button
                                  type="button"
                                  role="radio"
                                  aria-checked="true"
                                  class="exc-segment-btn exc-segment-btn-on"
                                  data-exc-intra="yes"
                                >
                                  Yes
                                </button>
                                <button type="button" role="radio" aria-checked="false" class="exc-segment-btn" data-exc-intra="no">
