---
/**
 * "We speak the language of your existing systems." Software and
 * Professional Services variant of travel-and-hospitality/ExistingSystems.astro
 * — same three-category card layout, re-skinned for finance/billing,
 * subscription, and PSA/CRM/middleware systems. None of these vendors have a
 * hosted Webflow logo asset yet, so every badge falls back to the neutral
 * monogram swatch — same fallback pattern travel-and-hospitality's version
 * uses for vendors without art.
 */
interface Logo {
  name: string;
  src?: string;
}

interface Category {
  title: string;
  desc: string;
  logos: Logo[];
}

const categories: Category[] = [
  {
    title: "Finance & billing",
    desc: "Where the invoice is raised.",
    logos: [
      {
        name: "NetSuite",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59523b28c72573cd0c92_oracle-net.png",
      },
      {
        name: "Xero",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5a00c9c4a1b0555a58f4_xero.png",
      },
      {
        name: "MS Dynamics 365",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594489cb38a8fe58819d_ms.png",
      },
      {
        name: "Sage Intacct",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59b04026d93696911299_sage.png",
      },
      {
        name: "Oracle Fusion",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594b2872eeb6348efacd_oracle-fusion.png",
      },
      {
        name: "SAP",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59be2ddedbf4b5615765_sap.png",
      },
    ],
  },
  {
    title: "Subscription engines",
    desc: "Where recurring revenue is priced and charged.",
    logos: [
      {
        name: "Stripe Billing",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59c7cf6273a97292bd23_strip.png",
      },
      {
        name: "Zuora",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5a0a046c194e16dbb61c_zuora.png",
      },
      {
        name: "Chargebee",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58a8ed5cad3df92ebff7_charge.png",
      },
      {
        name: "Recurly",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5996bf105356f0acdd7d_recurly.png",
      },
      {
        name: "Paddle",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5960d8936e10e51411c6_paddle.png",
      },
      {
        name: "In-house metering",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb590013db44f6eacad264_inhouse.png",
      },
    ],
  },
  {
    title: "PSA, CRM & middleware",
    desc: "Where the engagement and the client record live.",
    logos: [
      {
        name: "Salesforce",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59b8c6c71064ad1ea30d_salesforce.png",
      },
      {
        name: "HubSpot",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58ec64e1f4bc7198be69_hubspot.png",
      },
      {
        name: "Kantata",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb591c13db44f6eacaeca4_kantata.png",
      },
      {
        name: "Certinia",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58a01cc6deef8bbfac90_certinia.png",
      },
      {
        name: "Unified API",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5898427628a740fb9391_api.png",
      },
      {
        name: "Workday",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59fbc6c71064ad1ee2d7_workdoy.png",
      },
    ],
  },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full px-4 md:px-6 mx-auto">
    <div class="flex flex-col gap-12">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-left text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        We speak the language of your existing systems.
      </h2>

      <div
        class="grid grid-cols-1 lg:grid-cols-3 rounded-xl border border-neutral-200 divide-y divide-neutral-200 lg:divide-y-0 lg:divide-x"
      >
        {
          categories.map((cat) => (
            <div class="flex flex-col gap-12 p-6">
              <div class="flex flex-col gap-2">
                <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                  {cat.title}
                </p>
                <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                  {cat.desc}
                </p>
              </div>
              <div class="flex flex-wrap gap-2">
                {cat.logos.map((logo) => (
                  <span class="inline-flex items-center gap-x-3 gap-y-2 rounded-lg border border-neutral-200 px-3 py-1.5">
                    {logo.src ? (
                      <img
                        src={logo.src}
                        alt=""
                        class="max-h-6 w-full object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span
                        class="h-6 w-6 shrink-0 rounded-md bg-neutral-200"
                        aria-hidden="true"
                      />
                    )}
                    <span class="font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] whitespace-nowrap">
                      {logo.name}
                    </span>
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
