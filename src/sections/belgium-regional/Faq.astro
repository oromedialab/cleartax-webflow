---
/**
 * FAQ for the Belgium regional page — Figma node 18357:63325 ("FAQ"). The
 * paste unit.
 *
 * Structure, styling and behaviour live in `_shared/FaqRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file,
 * because the embed route renders sections with no props.
 *
 * The Figma has no subtitle under the heading, so an empty one is passed —
 * `FaqRb` omits the paragraph when it is empty. Seven questions, first open,
 * the last two behind "Load more" after five — the primitive's standard
 * behaviour, and the "Load more" button the Figma draws.
 */
import FaqRb from '../_shared/FaqRb.astro';
import type { FaqItem } from '../_shared/FaqRb.astro';

const items: FaqItem[] = [
  {
    q: "Who must comply with e-invoicing in Belgium?",
    a: [
      {
        kind: "p",
        html: "All VAT-registered businesses established in Belgium, including Belgian fixed establishments of foreign companies, for domestic B2B transactions. There is no turnover threshold. B2C sales, cross-border B2B, and businesses that only make VAT-exempt supplies under Article 44 are out of scope.",
      },
    ],
  },
  {
    q: "What format must Belgian e-invoices use?",
    a: [
      {
        kind: "p",
        html: "Peppol BIS Billing 3.0 in UBL, compliant with EN 16931. Other EN 16931 formats are allowed only if both parties agree, and you must still be able to send and receive over Peppol. A PDF or paper invoice alone does not meet the structured-invoice requirement. A PDF can accompany the structured invoice.",
      },
    ],
  },
  {
    q: "What are the penalties for non-compliance in Belgium?",
    a: [
      {
        kind: "p",
        html: "Fines are €1,500 for the first infringement, €3,000 for the second and €5,000 for each one after that, enforced since 1 April 2026. Buyers can also lose their input VAT deduction if they accept a non-compliant invoice.",
      },
    ],
  },
  {
    q: "Do I need to register with the government to send e-invoices?",
    a: [
      {
        kind: "p",
        html: "No. Belgium uses a decentralised four-corner Peppol model with no central clearance portal. You connect through a certified Peppol Access Point and register in the Peppol directory with your KBO/BCE enterprise number.",
      },
    ],
  },
  {
    q: "What changes in Belgium in 2028?",
    a: [
      {
        kind: "p",
        html: "From 1 January 2028, Belgium proposes to have a near-real-time e-reporting through a five-corner model. Suppliers and buyers will both report invoice data to FPS Finance over Peppol, replacing the annual client listing. Details will follow by Royal Decree.",
      },
    ],
  },
  {
    q: "How long must e-invoices be archived?",
    a: [
      {
        kind: "p",
        html: "Ten years, starting from 1 January of the year after the invoice date. Keep the original structured file, and make sure FPS Finance can access it online from Belgium.",
      },
    ],
  },
  {
    q: "How do I choose the right e-invoicing software for Belgium?",
    a: [
      {
        kind: "p",
        html: "Look for a certified Peppol Access Point that integrates with your ERP, validates invoices before sending, receives incoming invoices, archives for 10 years and has a clear plan for 2028 e-reporting. If you operate in several countries, one platform for all mandates cuts long-term cost.",
      },
    ],
  },
];
---

<FaqRb
  items={items}
  subtitle=""
/>
