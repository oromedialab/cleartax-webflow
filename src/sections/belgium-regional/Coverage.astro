---
/**
 * "How ClearTax keeps you compliant with Belgium's e-invoicing mandate" — Figma
 * node 18357:63207 ("Fold 10"). Seven rows, title + sub-line on the left, the
 * longer explanation on the right, divided by hairlines.
 *
 * Every row is drawn at 50% opacity in the Figma: it is the resting state of a
 * scroll-spotlight. A small script lifts the row nearest the middle of the
 * viewport to full opacity as the section scrolls past; without script (or with
 * reduced motion) all rows stay fully legible.
 *
 * The icon squares are unfilled "Visual placeholder" frames in the Figma, so
 * they render as `bg-visual-placeholder` (#E8FFE1). Swap for Webflow-hosted
 * artwork when it lands — never a `data:` URI.
 *
 * Classes and ids are `be-cov-` prefixed: embeds share one namespace per page.
 */
interface Row {
  title: string;
  lead: string;
  body: string;
  icon: string;
}

const rows: Row[] = [
  {
    title: "Full Belgium mandate coverage",
    lead: "Send and receive Peppol BIS Billing 3.0 invoices and credit notes",
    body: "through ClearTax's Open Peppol Access Point. Self-billing, B2G via Mercurius and 10-year archiving are covered in the same flow.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af19ece9965380aa08fa8b7_glance-2.png",
  },
  {
    title: "Catch errors before your buyer does",
    lead: "AI-powered checks validate every mandatory field",
    body: "VAT rate and rounding rule before an invoice leaves your ERP. Fewer rejections, faster payments, and no VAT deduction risk for your customers.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af19f385412f4708f11fe25_icon-2.png",
  },
  {
    title: "Ready for 2028, without a second project",
    lead: "When the five-corner model goes live, ClearTax handles reporting to FPS Finance on the platform side.",
    body: "Your ERP stays as it is, and rule changes arrive as cloud updates at no extra cost.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af19f3d01eba404bdf91205_icon-3.png",
  },
  {
    title: "Integrates with any ERP or POS",
    lead: "2,500+ integrations across 50+ ERP and POS systems, including SAP, Oracle, Microsoft Dynamics and NetSuite.",
    body: "AI-driven connectors and structured UAT cut onboarding from weeks to days.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af19f413f4b6f589b17bf8d_icon-4.png",
  },
  {
    title: "One dashboard for incoming and outgoing invoices",
    lead: "Track every sent and received invoice, its status and any exception in one view.",
    body: "Finance sees what's stuck and why, before month-end close.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af19f453f4b6f589b17ca51_icon-5.png",
  },
  {
    title: "Belgium now. ViDA next",
    lead: "One platform and one API for 50+ countries.",
    body: "Your Belgian entities reuse the same integration as France, Germany and the rest of your footprint, ready for EU cross-border reporting from July 2030.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af19f49b577fee589d9e53e_icon-6.png",
  },
  {
    title: "Audit-ready books and local support",
    lead: "Automated reconciliation across invoice, books and VAT data keeps your records clean.",
    body: "A dedicated success manager, 750+ integration engineers and in-house tax experts back you from go-live onward, with a team in Brussels.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af19f4db8c0ec1f3def0749_icon-7.png",
  },
];
---

<section id="be-cov" class="bg-generic-00 py-16 lg:py-20">
  <div
    class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-8 md:gap-12"
  >
    <div class="flex max-w-[626px] flex-col items-center gap-4 text-center">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        How ClearTax keeps you compliant with Belgium's e-invoicing mandate
      </h2>
      <p
        class="m-0 max-w-[586px] font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]"
      >
        One Peppol-certified platform to create, validate, send, receive and
        archive every B2B invoice, with 2028 e-reporting built into the roadmap.
      </p>
    </div>

    <div class="flex w-full flex-col">
      {
        rows.map((r, i) => (
          <div
            class:list={[
              "be-cov-row flex flex-col justify-between gap-2 py-8 md:flex-row md:items-center md:gap-8",
              i < rows.length - 1 && "border-b border-neutral-200",
            ]}
          >
            <div class="grid shrink-0 grid-cols-[53px_minmax(0,1fr)] items-center lg:items-start gap-x-4 max-w-[590px] flex-1 md:grid-cols-[53px_minmax(0,1fr)]">
              <img src={r.icon} alt="" class="h-13.25 w-13.25 shrink-0 " />
              <div class="contents md:flex md:min-w-0 md:flex-col md:gap-[2px]">
                <h3 class="col-start-2 m-0 font-heading text-lg leading-[1.33] font-medium text-vault-navy">
                  {r.title}
                </h3>
                {r.lead && (
                  <span class="col-span-2 max-sm:mt-4 block font-body text-sm leading-[length:var(--lh-body-lg)] text-neutral-500">
                    {r.lead}
                  </span>
                )}
              </div>
            </div>
            <p class="m-0 font-body text-sm leading-[length:var(--lh-body)] text-neutral-500 md:flex-1 max-w-[456px]">
              {r.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .be-cov-js .be-cov-row {
    opacity: 0.5;
    transition:
      opacity 0.35s ease-in-out,
      transform 0.35s ease-in-out;
  }
  .be-cov-js .be-cov-row.is-active {
    opacity: 1;
    transform: scale(1.02);
  }
</style>

<script is:inline>
  (function () {
    var section = document.getElementById("be-cov");
    if (!section) return;
    if (
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;
    var rows = section.querySelectorAll(".be-cov-row");
    if (!rows.length) return;

    section.classList.add("be-cov-js");

    // The row whose centre is closest to the middle of the viewport is "on".
    function update() {
      var mid = window.innerHeight / 2;
      var best = null;
      var bestDist = Infinity;
      rows.forEach(function (row) {
        var rect = row.getBoundingClientRect();
        var dist = Math.abs(rect.top + rect.height / 2 - mid);
        if (dist < bestDist) {
          bestDist = dist;
          best = row;
        }
      });
      rows.forEach(function (row) {
        row.classList.toggle("is-active", row === best);
      });
    }

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        update();
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  })();
</script>
