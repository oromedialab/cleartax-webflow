<!-- ============================================================
     2. EVENT LAYOUT  (.ct-event)
     One grid holding groups 2A–2D. Keep them as DIRECT children of this div:
     the stylesheet positions them by that nesting.
     ============================================================ -->
<div class="container ct-event">
  <!-- 2A. HEADER — breadcrumb, Type badge, Name, speaker chips, date / time / location
       Fields: Name, Type, Speaker 1–3 Name + Role, Date, Display Time, Location -->
  <header>
    <nav aria-label="Breadcrumb">
      <ol>
        <li><a href="/resources/events">Webinars</a></li>
        <li aria-current="page">[[ Name ]]</li>
      </ol>
    </nav>

    <p>
      <mark>Upcoming</mark>
      <span>
        <svg aria-hidden="true" focusable="false"><use href="#ct-evd-globe"></use></svg>
        [[ Type ]]
      </span>
    </p>

    <h1>[[ Name ]]</h1>

    <p>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2.4375C10.1087 2.4375 8.25992 2.99833 6.68736 4.04908C5.11482 5.09981 3.88917 6.59327 3.16541 8.34059C2.44164 10.0879 2.25227 12.0106 2.62125 13.8655C2.99022 15.7205 3.90096 17.4244 5.2383 18.7618C6.57564 20.099 8.27951 21.0098 10.1345 21.3787C11.9894 21.7477 13.9121 21.5584 15.6594 20.8346C17.4067 20.1108 18.9002 18.8852 19.951 17.3126C21.0017 15.74 21.5626 13.8913 21.5626 12C21.5596 9.46478 20.5511 7.03426 18.7584 5.24158C16.9657 3.44891 14.5352 2.44048 12 2.4375ZM6.6975 18.5626C7.24762 17.6478 8.02503 16.8908 8.95418 16.3655C9.88331 15.84 10.9326 15.5639 12 15.5639C13.0674 15.5639 14.1167 15.84 15.0458 16.3655C15.975 16.8908 16.7524 17.6478 17.3026 18.5626C15.8028 19.7785 13.9308 20.4422 12 20.4422C10.0693 20.4422 8.19717 19.7785 6.6975 18.5626ZM8.8125 11.25C8.8125 10.6196 8.99945 10.0033 9.3497 9.47912C9.69994 8.95494 10.1978 8.54639 10.7802 8.30514C11.3626 8.06388 12.0036 8.00076 12.6218 8.12375C13.2402 8.24674 13.8082 8.55031 14.254 8.9961C14.6996 9.44188 15.0032 10.0098 15.1262 10.6281C15.2492 11.2465 15.1861 11.8874 14.9449 12.4698C14.7036 13.0523 14.2951 13.55 13.7708 13.9003C13.2467 14.2506 12.6305 14.4374 12 14.4374C11.1546 14.4374 10.3439 14.1017 9.7461 13.504C9.14834 12.9061 8.8125 12.0954 8.8125 11.25ZM18.1416 17.7787C17.2578 16.4045 15.9367 15.3682 14.3916 14.8369C15.162 14.3237 15.7469 13.5762 16.0597 12.705C16.3726 11.8337 16.3967 10.8849 16.1287 9.99882C15.8606 9.11276 15.3145 8.33648 14.5711 7.78476C13.8278 7.23304 12.9266 6.93515 12.001 6.93515C11.0752 6.93515 10.1741 7.23304 9.43072 7.78476C8.68737 8.33648 8.1413 9.11276 7.87322 9.99882C7.60515 10.8849 7.62932 11.8337 7.94214 12.705C8.25497 13.5762 8.83985 14.3237 9.61032 14.8369C8.06519 15.3682 6.74414 16.4045 5.86032 17.7787C4.73048 16.5798 3.97635 15.0762 3.69099 13.4537C3.40563 11.8311 3.60152 10.1605 4.25448 8.64799C4.90745 7.13546 5.98894 5.84718 7.36551 4.94209C8.74206 4.037 10.3535 3.5547 12.001 3.5547C13.6484 3.5547 15.2598 4.037 16.6364 4.94209C18.013 5.84718 19.0944 7.13546 19.7474 8.64799C20.4004 10.1605 20.5963 11.8311 20.311 13.4537C20.0256 15.0762 19.2714 16.5798 18.1416 17.7787Z" fill="#05022A"></path>
      </svg>
      <span>[[ Speaker 1 Name ]], [[ Speaker 1 Role ]]</span>
      <span>[[ Speaker 2 Name ]], [[ Speaker 2 Role ]]</span>
      <span>[[ Speaker 3 Name ]], [[ Speaker 3 Role ]]</span>
    </p>

    <p>
      <time>
        <svg aria-hidden="true" focusable="false"><use href="#ct-evd-calendar"></use></svg>
        [[ Date ]]
      </time>
      <span></span>
      <span>
        <svg aria-hidden="true" focusable="false"><use href="#ct-evd-clock"></use></svg>
        [[ Display Time ]]
      </span>
      <span></span>
      <span>
        <svg aria-hidden="true" focusable="false"><use href="#ct-evd-pin"></use></svg>
        [[ Location ]]
      </span>
    </p>

    <hr />
  </header>

  <!-- 2B. REGISTRATION CARD — thumbnail, play button (past), Register now, share links
       Fields: Thumbnail, Name, Recording Link, Registration Link -->
  <aside>
    <figure>
      <img src="[[ Thumbnail ]]" alt="[[ Name ]]" width="1280" height="720" />
      <a href="[[ Recording Link ]]" target="_blank" rel="noopener" aria-label="Play the recording">
        <img
          src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab246685e37e413aa90378a_play-button.png"
          alt=""
          width="72"
          height="72"
          loading="lazy"
        />
      </a>
    </figure>

    <p><a href="[[ Registration Link ]]" target="_blank" rel="noopener">Register now</a></p>

    <hr />

    <p>Share</p>
    <ul>
      <li>
        <a data-share="whatsapp" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
          <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab249b08dadf09d6cf24ccf_whatsapp-icon.png" alt="icon" />
        </a>
      </li>
      <li>
        <a data-share="facebook" target="_blank" rel="noopener" aria-label="Share on Facebook">
          <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab249b09a873b15d2a4dfef_facebook-icon.png" alt="icon" />
        </a>
      </li>
      <li>
        <a data-share="x" target="_blank" rel="noopener" aria-label="Share on X">
          <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab249b02ed6fb96143a0f85_x-icon.png" alt="icon" />
        </a>
      </li>
      <li>
        <a data-share="linkedin" target="_blank" rel="noopener" aria-label="Share on LinkedIn">
          <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab249b196c5fb62e0af7c11_linkedin-icon.png" alt="icon" />
        </a>
      </li>
    </ul>
  </aside>

  <!-- 2C. BODY — filled from the Description Rich Text element (.ct-event-description)
       Fields: none here. Bind Description on the Rich Text element, not in this embed. -->
  <article>
    <h2>About the Webinar</h2>
  </article>

  <!-- 2D. SPEAKERS — up to three cards; a card with no Name is removed
       Fields: Speaker 1–3 Bio, Photo, LinkedIn, Name, Role -->
  <section class="ct-event-speakers">
    <hr />
    <header>
      <h2>About the Speakers</h2>
      <span>
        <button type="button" class="ct-speaker-prev" aria-label="Previous speaker">
          <svg aria-hidden="true" focusable="false"><use href="#ct-evd-chevron-left"></use></svg>
        </button>
        <button type="button" class="ct-speaker-next" aria-label="Next speaker">
          <svg aria-hidden="true" focusable="false"><use href="#ct-evd-chevron-right"></use></svg>
        </button>
      </span>
    </header>
    <div class="swiper ct-speaker-swiper">
      <div class="swiper-wrapper">
        {
          [1, 2, 3].map((n) => (
            <article class="swiper-slide">
              <p>{`[[ Speaker ${n} Bio ]]`}</p>
              <div>
                <address>
                  <span><img src={`[[ Speaker ${n} Photo ]]`} alt={`[[ Speaker ${n} Name ]]`} width="48" height="48" /></span>
                  <span>
                    <strong>{`[[ Speaker ${n} Name ]]`}</strong>
                    <span>{`[[ Speaker ${n} Role ]]`}</span>
                  </span>
                </address>
                <a href={`[[ Speaker ${n} LinkedIn ]]`} target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M1.16721 0H14.8334C15.4778 0.00033738 16 0.522818 16 1.16721V14.8334C15.9997 15.4778 15.4772 16 14.8328 16H1.16721C0.52258 16 0 15.4774 0 14.8328V1.16721C0 0.52258 0.52258 0 1.16721 0ZM2.33321 13.6668H4.66641V5.99985H2.33321V13.6668ZM5.00008 3.49981C5.00008 2.67123 4.32838 1.99954 3.49981 1.99954C2.67123 1.99954 1.99954 2.67123 1.99954 3.49981C1.99954 4.32838 2.67123 5.00008 3.49981 5.00008C4.32838 5.00008 5.00008 4.32838 5.00008 3.49981ZM6.33351 5.99985V13.6668H8.66672V9.9531C8.66672 8.70827 9.12505 7.91689 10.2269 7.91689C11.0213 7.91689 11.333 8.65083 11.333 9.9531V13.6668H13.6668V9.43182C13.6668 7.14628 13.1199 5.89963 10.8148 5.89963C9.61271 5.89963 8.81216 6.46246 8.49989 7.08884V5.99985H6.33351Z" fill="#05022A"></path>
                  </svg>
                  View Profile
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</div>

<!-- ============================================================
     3. UPCOMING EVENTS ROW
     Empty on purpose. The script fills it from the hidden Collection List
     (.ct-event-related-source) holding the related-card embed. Fields: none.
     ============================================================ -->
<section class="container ct-event-related">
  <h2>Upcoming Events &amp; Webinars</h2>
  <p>Learn from the people building compliance every day.</p>
  <ul></ul>
</section>

<!-- ============================================================
     4. STYLES
     Hides the three helper elements Webflow needs (Description, Is Upcoming flag,
     Collection List). The page design CSS lives in the page <head>, not here.
     ============================================================ -->
<style is:global>
  .ct-event-description,
  .ct-event-upcoming,
  .ct-event-related-source,
  .ct-event-data,
  .ct-event-card-data {
    display: none;
  }
</style>

<!-- ============================================================
     5. SCRIPT
     Runs once on load. Order: header badges and chips, thumbnail and play button,
     register button, share links, description, speakers, upcoming row.
     ============================================================ -->
<script is:inline>
  (function () {
    // One bound element per field, in THIS order, inside .ct-event-data.
    var EVENT_KEYS = [
      'Name', 'Type', 'Date', 'Display Time', 'Location',
      'Registration Link', 'Recording Link', 'Thumbnail',
      'Speaker 1 Name', 'Speaker 1 Role', 'Speaker 1 Bio', 'Speaker 1 Photo', 'Speaker 1 LinkedIn',
      'Speaker 2 Name', 'Speaker 2 Role', 'Speaker 2 Bio', 'Speaker 2 Photo', 'Speaker 2 LinkedIn',
      'Speaker 3 Name', 'Speaker 3 Role', 'Speaker 3 Bio', 'Speaker 3 Photo', 'Speaker 3 LinkedIn',
    ];
    // Same idea inside each Collection Item of the upcoming-events list.
    var CARD_KEYS = ['Slug', 'Name', 'Type', 'Date', 'Display Time', 'Speaker 1 Name', 'Speaker 1 Role', 'Thumbnail'];

    // Text -> its text, Image -> src, Link -> href. A field left empty in the
    // CMS leaves its element in place with nothing in it, so order holds.
    // Three ways to supply a value, tried in this order:
    //  1. a custom attribute on the holder, named after the field with a data-
    //     prefix: data-name, data-display-time, data-speaker-1-name ...
    //     (text, link and date fields only: Webflow cannot bind an image
    //     field into an attribute)
    //  2. a bound child element carrying the class ct-f-<field>, e.g. an Image
    //     with class ct-f-thumbnail or ct-f-speaker-1-photo
    //  3. one bound child per field in key order (the original layout)
    function readData(holder, keys) {
      if (!holder) return null;
      var data = {};
      keys.forEach(function (key, i) {
        var slug = key.toLowerCase().replace(/ /g, '-');
        var value = holder.getAttribute('data-' + slug);
        if (value === null || value === '') {
          var el = holder.querySelector('.ct-f-' + slug) || (value === null ? holder.children[i] : null);
          if (el) {
            var tag = el.tagName;
            value = tag === 'IMG' ? el.getAttribute('src') : tag === 'A' ? el.getAttribute('href') : el.textContent;
          }
        }
        data[key] = (value || '').trim();
      });
      return data;
    }

    // Swaps each double-bracket marker in text and attributes for its value.
    // A missing value becomes '' so empty fields behave as empty.
    function applyData(root, data) {
      if (!data || !root) return;
      var marker = /\[\[ ([^\]]+?) \]\]/g;
      var swap = function (_, key) { return data[key] || ''; };
      var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      var texts = [];
      while (walker.nextNode()) texts.push(walker.currentNode);
      texts.forEach(function (node) {
        if (node.nodeValue.indexOf('[') > -1) node.nodeValue = node.nodeValue.replace(marker, swap);
      });
      [root].concat(Array.prototype.slice.call(root.querySelectorAll('*'))).forEach(function (el) {
        Array.prototype.forEach.call(el.attributes, function (attr) {
          if (attr.value.indexOf('[') > -1) el.setAttribute(attr.name, attr.value.replace(marker, swap));
        });
      });
    }

    function fill() {
      var root = document.querySelector('.ct-event');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = 'true';

      // No Add Field in the embed? Bind native elements inside .ct-event-data
      // instead, and copy their values into the markers here.
      applyData(root, readData(document.querySelector('.ct-event-data'), EVENT_KEYS));

      var header = root.querySelector(':scope > header');
      var aside = root.querySelector(':scope > aside');
      var article = root.querySelector(':scope > article');
      var title = (header.querySelector('h1').textContent || '').trim();

      // Is Upcoming: the flag Div is still in the DOM when its condition
      // fails, just carrying `w-condition-invisible`.
      var flag = document.querySelector('.ct-event-upcoming');
      // Preferred: data-is-upcoming on .ct-event-data, set with a Webflow
      // conditional (Is Upcoming on -> "yes", otherwise "no").
      var holder = document.querySelector('.ct-event-data');
      var flagAttr = holder ? (holder.getAttribute('data-is-upcoming') || '').trim() : '';
      var upcoming = flagAttr
        ? /^(true|yes|1|on)$/i.test(flagAttr)
        : !!flag && !flag.classList.contains('w-condition-invisible');

      // Status badge + type icon. The icon <use> is the badge row's only one.
      var badges = header.querySelector(':scope > p');
      badges.querySelector('mark').textContent = upcoming ? 'Upcoming' : 'Past';
      // Only webinars are online; every other event type is in person.
      var typeSpan = badges.querySelector('span');
      var online = /webinar|online/i.test(typeSpan.textContent || '');
      if (!online) {
        typeSpan.querySelector('use').setAttribute('href', '#ct-evd-user');
        header.querySelector('nav a').textContent = 'Events';
      }
      if (!(typeSpan.textContent || '').trim()) typeSpan.remove();

      // Speaker chips: drop unused slots, tidy a missing role. If none are
      // left the row is hidden rather than removed, so the date row stays the
      // third <p> that the stylesheet's nth-of-type rules expect.
      var speakerRow = header.querySelectorAll(':scope > p')[1];
      speakerRow.querySelectorAll(':scope > span').forEach(function (chip) {
        var text = (chip.textContent || '').replace(/^[\s,]+|[\s,]+$/g, '');
        if (text) chip.textContent = text;
        else chip.remove();
      });
      if (!speakerRow.querySelector(':scope > span')) speakerRow.hidden = true;

      // Thumbnail: an empty image field leaves src="" — remove it so the
      // figure shows the placeholder tint. The play control is past-only.
      var figure = aside.querySelector('figure');
      var thumb = figure.querySelector(':scope > img');
      if (thumb && !thumb.getAttribute('src')) thumb.remove();
      // Past sessions link the play control to the Demio recording; with no
      // recording yet there is nothing to play, so it goes too.
      var play = figure.querySelector(':scope > a');
      if (play && (upcoming || !play.getAttribute('href'))) play.remove();

      // CTA: one label always; a past session gets a disabled <button>.
      if (!upcoming) {
        var cta = aside.querySelector(':scope > p');
        var button = document.createElement('button');
        button.type = 'button';
        button.disabled = true;
        button.textContent = 'Register now';
        cta.replaceChildren(button);
      }

      // Share links point at the live URL of this item.
      var url = encodeURIComponent(location.origin + location.pathname);
      var text = encodeURIComponent(title);
      var shareHrefs = {
        whatsapp: 'https://wa.me/?text=' + text + '%20' + url,
        facebook: 'https://www.facebook.com/sharer/sharer.php?u=' + url,
        x: 'https://x.com/intent/tweet?url=' + url + '&text=' + text,
        linkedin: 'https://www.linkedin.com/sharing/share-offsite/?url=' + url,
      };
      aside.querySelectorAll('[data-share]').forEach(function (link) {
        link.href = shareHrefs[link.dataset.share];
      });

      // Description: move the Rich Text's children into <article>.
      article.querySelector('h2').textContent = !upcoming ? 'About the session' : online ? 'About the Webinar' : 'About the Event';
      var description = document.querySelector('.ct-event-description');
      if (description) {
        while (description.firstChild) article.appendChild(description.firstChild);
      }

      fillSpeakers(root.querySelector(':scope > .ct-event-speakers'));
      fillRelated(document.querySelector('.ct-event-related'));
    }

    function initialsOf(name) {
      return name
        .split(' ')
        .map(function (part) { return part.charAt(0); })
        .join('')
        .slice(0, 2)
        .toUpperCase();
    }

    // Speaker cards: three fixed slots, emptied ones removed. A carousel only
    // for 2+ speakers — Swiper (~150 KB) is fetched only then.
    function fillSpeakers(section) {
      if (!section) return;
      var slides = Array.prototype.slice.call(section.querySelectorAll('article'));
      slides.forEach(function (slide) {
        var name = (slide.querySelector('strong').textContent || '').trim();
        if (!name) return slide.remove();

        var bio = slide.querySelector(':scope > p');
        if (!(bio.textContent || '').trim()) bio.remove();

        var avatar = slide.querySelector('address > span:first-child');
        var photo = avatar.querySelector('img');
        if (!photo.getAttribute('src')) avatar.textContent = initialsOf(name);

        var role = slide.querySelector('address strong + span');
        if (!(role.textContent || '').trim()) role.remove();

        var profile = slide.querySelector(':scope > div > a');
        if (!profile.getAttribute('href')) profile.remove();
      });

      var count = section.querySelectorAll('article').length;
      if (!count) return section.remove();

      if (count === 1) {
        section.querySelector('header h2').textContent = 'About the Speaker';
        section.querySelector('header > span').remove();
        section.querySelectorAll('.swiper, .swiper-wrapper, .swiper-slide').forEach(function (el) {
          el.removeAttribute('class');
        });
        return;
      }

      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
      document.head.appendChild(css);
      var js = document.createElement('script');
      js.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
      js.onload = function () {
        new Swiper('.ct-speaker-swiper', {
          slidesPerView: 1,
          spaceBetween: 24,
          autoHeight: true,
          grabCursor: true,
          navigation: { prevEl: '.ct-speaker-prev', nextEl: '.ct-speaker-next' },
          keyboard: { enabled: true },
        });
      };
      document.head.appendChild(js);
    }

    // Upcoming rail: cards come from a hidden Collection List
    // (.ct-event-related-source, one RelatedCard embed per item). They are
    // moved into this section's <ul>, skipping the event being viewed.
    function fillRelated(section) {
      if (!section) return;
      var list = section.querySelector('ul');
      var base = location.pathname.replace(/\/[^/]*\/?$/, '');
      var current = location.pathname.replace(/\/$/, '').split('/').pop();
      var cards = document.querySelectorAll('.ct-event-related-source li');

      Array.prototype.forEach.call(cards, function (card) {
        var item = card.closest('.w-dyn-item') || card.parentNode;
        applyData(card, readData(item.querySelector('.ct-event-card-data'), CARD_KEYS));

        var slug = card.dataset.slug;
        if (!slug || slug === current || list.children.length >= 6) return;

        card.querySelector('a').href = base + '/' + slug;

        var img = card.querySelector('figure > img');
        if (img && !img.getAttribute('src')) img.remove();

        var type = card.querySelector('figure > span');
        if (!/webinar|online/i.test(type.textContent || '')) {
          type.querySelector('use').setAttribute('href', '#ct-evd-user');
        }
        if (!(type.textContent || '').trim()) type.style.visibility = 'hidden';

        var speaker = card.querySelector('figure > span:last-of-type');
        var who = (speaker.textContent || '').replace(/^[\s,]+|[\s,]+$/g, '');
        if (who) speaker.textContent = who;
        else speaker.style.visibility = 'hidden';

        list.appendChild(card);
      });

      if (!list.children.length) section.remove();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fill);
    } else {
      fill();
    }
  })();
</script>
