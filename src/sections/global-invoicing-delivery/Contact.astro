---

<section
  class="relative overflow-hidden bg-[#1B1140] bg-cover bg-center bg-no-repeat max-md:py-12 md:max-lg:py-16 lg:py-16"
  style="background-image: url('https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/6a06c1ff977549be3339fd66_closing-cta-bg.png');"
>
  <div class="relative z-10 mx-auto lg:container w-full px-4 md:px-6">
    <div class="flex flex-col lg:flex-row justify-between items-stretch gap-6">
      <div class="flex-1 flex flex-col mt-3 lg:mt-6 items-start">
        <h1
                class="inline-flex items-center gap-1.5 m-0 bg-[linear-gradient(90deg,_rgba(144,_68,_169,_0.2)_0%,_rgba(184,_126,_200,_0.2)_100%)] text-[#FFFFFF] leading-[1] text-xs font-normal px-4 py-2 rounded-full mb-5 text-center"
