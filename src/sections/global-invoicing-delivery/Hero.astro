---
/**
 * Global invoicing delivery Hero section — modern Astro component
 * Matches reference layout and screenshot with hero-bg.png as background,
 */
const checklistItems = [
    {
        label: "Fully Peppol-Ready",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a731c9d83d9bbd127f6fb63_check-1.png",
    },
    {
        label: "OTA Approved",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a731ca4464f0b495648a964_check-2.png",
    },
    {
        label: "DGFIP Certified",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a731cb657fba0c09a9e56ac_check-3.png",
    },
    {
        label: "FTA-approved (ASP)",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a731cbb334688ab9bc5426b_check-4.png",
    },
    {
        label: "MDEC accredited",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a731cc85793a3017df757cb_check-5.png",
    }
];
---



<section class="hero-section relative min-h-[700px] overflow-hidden flex items-center pt-28 pb-12 md:pt-30 md:pb-16 lg:pt-35 lg:pb-25" id="hero">
  <!-- Sunset Skyline Background with dark to soft fade overlays -->
  <div class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat" style="background-image: url('https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a731820698401458f78185d_hero-bg.png');"></div>
<div class="absolute inset-0 z-0 bg-gradient-to-b from-white/85 via-white/50 to-transparent hidden max-[630px]:block pointer-events-none"></div>

  <div class="relative z-10 mx-auto lg:container w-full px-4 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.9fr] 2xl:grid-cols-2 gap-12 lg:gap-8 items-start">
      
      <!-- Hero Left Column -->
      <div class="hero-left-content flex flex-col items-start">
        <!-- Badge Capsule -->
        <h1 class="inline-flex items-center gap-1.5 m-0 bg-[linear-gradient(90deg,_rgba(144,_68,_169,_0.2)_0%,_rgba(184,_126,_200,_0.2)_100%)] text-[#9144AB] leading-[1] text-xs font-normal px-4 py-2 rounded-full mb-4">
          ✦ Global e-invoicing delivery
        </h1>
        <!-- Headline -->
        <h2 class="text-[36px] lg:text-[44px] xl:text-[56px] max-w-138 text-black font-medium font-['Nohemi'] leading-[1.14] mb-4">
         The mandate changes by country.
         <span class="text-[#C4269F]">The delivery burden doesn't.</span>
        </h2>
        
        <!-- Description -->
        <p class="text-base sm:text-lg max-w-138 text-[#291952] leading-normal mb-7">
            Global e-invoicing succeeds on three things most vendors skip: understanding how mandates diverge, surviving what actually breaks multi-country delivery & owning it after go-live — everywhere, not just market one.
        </p>
         
        
        <!-- Trust Badges Strip -->
        <ul class="list-none p-0 mb-8 sm:mt-0 grid grid-cols-3 gap-4">
          {
                    checklistItems.map((item, index) => (
                        <li
                            class="inline-flex items-center leading-snug gap-3 px-3 py-3 bg-white/10 border border-[#F5F5F533] rounded-[54px] transition-all cursor-pointer premium-reveal"
                            style={`transition-delay: ${200 + index * 100}ms`}
                        >
                            <div class=" flex items-center justify-center">
                                <img src={item.icon} alt={item.label} class="w-[24px] h-[24px] object-contain" />
                            </div>
                            <span class="text-base font-normal text-[#000000]">
                                {item.label}
                            </span>
                        </li>
                    ))
                }
            </ul>
            
            <!-- Call to Action button -->
            <a 
            href="javascript:void(0)"
            onclick="scrollToGridRisk(event)"
            class="inline-flex items-center justify-center px-12 py-2 md:py-4 font-gilroy rounded-full font-normal text-white transition-all duration-300 hover:-translate-y-1 text-base cursor-pointer bg-[linear-gradient(90deg,_#110072_0%,_#7A5698_100%)] border border-white/20"
            style="outline: none;"
            >
            Explore platform
          </a>
        </div>
    
        <div class="flex-1 flex items-center justify-center premium-reveal [transition-delay:500ms] w-full">
            <img
                src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7318f063aa42d5d6563c22_hero-graphic.png"
                alt="Hero graphic"
                class="w-full max-w-[450px] xl:max-w-[500px] object-contain opacity-90 drop-shadow-2xl hover:-translate-y-2 transition-transform duration-500"
            />
        </div>
    </div>
  </div>
</section>
