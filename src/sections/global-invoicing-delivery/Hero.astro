---
/**
 * Global invoicing delivery Hero section — modern Astro component
 * Matches reference layout and screenshot with hero-bg.png as background,
 */
const checklistItems = [
    {
        label: "Fully Peppol-Ready",
        icon: "Peppol",
    },
    {
        label: "OTA Approved",
        icon: "OTA",
    },
    {
        label: "DGFIP Certified",
        icon: "Certified",
    },
    {
        label: "FTA-approved (ASP)",
        icon: "FTA",
    },
    {
        label: "MDEC accredited",
        icon: "MDEC",
    },
];
---

<section
    class="hero-section relative min-h-[700px] overflow-hidden flex items-center pt-28 pb-12 md:pt-30 md:pb-16 lg:pt-35 lg:pb-25"
    id="hero"
>
    <!-- Sunset Skyline Background with dark to soft fade overlays -->
    <div
        class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a731820698401458f78185d_hero-bg.png');"
    >
    </div>
    <div
        class="absolute inset-0 z-0 bg-gradient-to-b from-white/85 via-white/50 to-transparent hidden max-[630px]:block pointer-events-none"
    >
    </div>

    <div class="relative z-10 mx-auto lg:container w-full px-4 lg:px-8">
        <div
            class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.9fr] 2xl:grid-cols-2 gap-12 lg:gap-8 items-start"
        >
            <!-- Hero Left Column -->
            <div class="hero-left-content flex flex-col items-start">
                <!-- Badge Capsule -->
                <h1
                    class="inline-flex items-center gap-1.5 m-0 bg-[linear-gradient(90deg,_rgba(144,_68,_169,_0.2)_0%,_rgba(184,_126,_200,_0.2)_100%)] text-[#9144AB] leading-[1] text-xs font-normal px-4 py-2 rounded-full mb-4"
                >
                    ✦ Global e-invoicing delivery
                </h1>
                <!-- Headline -->
                <h2
                    class="text-[36px] lg:text-[44px] xl:text-[56px] max-w-138 text-black font-medium font-['Nohemi'] leading-[1.14] mb-4"
                >
                    The mandate changes by country.
                    <span class="text-[#C4269F]"
                        >The delivery burden doesn't.</span
                    >
                </h2>

                <!-- Description -->
                <p
                    class="text-base sm:text-lg max-w-138 text-[#291952] leading-normal mb-7"
                >
                    Global e-invoicing succeeds on three things most vendors
                    skip: understanding how mandates diverge, surviving what
                    actually breaks multi-country delivery & owning it after
                    go-live — everywhere, not just market one.
                </p>

                <!-- Trust Badges Strip -->
                <ul class="list-none p-0 mb-8 sm:mt-0 flex flex-wrap gap-x-4 gap-y-3.5 max-w-[620px]">
                    {
                        checklistItems.map((item, index) => (
                            <li
                                class="inline-flex items-center leading-snug gap-3 pl-3 pr-5 py-2.5 bg-white/45 backdrop-blur-[4px] border border-white rounded-full transition-all duration-300 cursor-pointer hover:bg-white/60 hover:scale-[1.02] shadow-[0_4px_12px_rgba(0,0,0,0.03)] premium-reveal"
                                style={`transition-delay: ${200 + index * 100}ms`}
                            >
                                <div class="shrink-0 text-[#27127A] flex">
                                    {item.icon === "Peppol" && (
