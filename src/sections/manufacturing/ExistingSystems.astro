---
/**
 * "We speak the language of your existing systems." Manufacturing variant of
 * retail-consumer/ExistingSystems.astro — same three-category card layout,
 * re-skinned for manufacturing/plant systems. None of these vendors have a
 * hosted Webflow logo asset yet, so every badge falls back to the neutral
 * monogram swatch (same fallback pattern the retail-consumer version uses
 * for POS vendors without art).
 */
interface Logo {
  name: string;
  src?: string;
}

interface Category {
  title: string;
  desc: string;
  logos: Logo[];
}

const categories: Category[] = [
  {
    title: "Enterprise ERPs",
    desc: "Where your transactions originate.",
    logos: [
      { name: "SAP S/4HANA", src: "/images/service-logos/sap.png" },
      { name: "QAD", src: "/images/service-logos/qad.png" },
      {
        name: "Microsoft D365",
        src: "/images/service-logos/ms.png",
      },
      { name: "Infor", src: "/images/service-logos/infor.png" },
      {
        name: "Oracle Fusion & EBS",
        src: "/images/service-logos/oracle-fusion.png",
      },
    ],
  },
  {
    title: "Plant & Warehouse systems",
    desc: "Where the material actually moves.",
    logos: [
      { name: "MES", src: "/images/service-logos/mes.png" },
      { name: "WMS", src: "/images/service-logos/wms.png" },
      { name: "TMS", src: "/images/service-logos/tms.png" },
      {
        name: "Plant maintenance",
        src: "/images/service-logos/plant.png",
      },
      {
        name: "Barcode & scanner feeds",
        src: "/images/service-logos/barcode.png",
      },
    ],
  },
  {
    title: "Trade, channel & middleware",
    desc: "Where the goods cross the border, and the price is settled.",
    logos: [
      {
        name: "Customs brokers",
        src: "/images/service-logos/custom.png",
      },
      {
        name: "Freight forwarders",
        src: "/images/service-logos/frieght.png",
      },
      { name: "3PL", src: "/images/service-logos/3pl.png" },
      {
        name: "Distributor portals",
        src: "/images/service-logos/dist.png",
      },
      {
        name: "Rebate management",
        src: "/images/service-logos/rebate.png",
      },
      { name: "EDI", src: "/images/service-logos/edl.png" },
      { name: "TIBCO", src: "/images/service-logos/tibco.png" },
    ],
  },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div class="flex flex-col gap-12">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-left text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        We speak the language of your existing systems.
      </h2>

      <div
        class="grid grid-cols-1 lg:grid-cols-3 rounded-xl border border-neutral-200 divide-y divide-neutral-200 lg:divide-y-0 lg:divide-x"
      >
        {
          categories.map((cat) => (
            <div class="flex flex-col gap-12 p-6">
              <div class="flex flex-col gap-2">
                <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                  {cat.title}
                </p>
                <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                  {cat.desc}
                </p>
              </div>
              <div class="flex flex-wrap gap-2">
                {cat.logos.map((logo) => (
                  <span class="inline-flex items-center gap-x-3 gap-y-2 rounded-lg border border-neutral-200 px-3 py-1.5">
                    {logo.src ? (
                      <img
                        src={logo.src}
                        alt=""
                        class="max-h-6 w-full object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span
                        class="h-6 w-6 shrink-0 rounded-md bg-neutral-200"
                        aria-hidden="true"
                      />
                    )}
                    <span class="font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] whitespace-nowrap">
                      {logo.name}
                    </span>
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
