---
/**
 * "We speak the language of your existing systems." Manufacturing variant of
 * retail-consumer/ExistingSystems.astro — same three-category card layout,
 * re-skinned for manufacturing/plant systems. None of these vendors have a
 * hosted Webflow logo asset yet, so every badge falls back to the neutral
 * monogram swatch (same fallback pattern the retail-consumer version uses
 * for POS vendors without art).
 */
interface Logo {
  name: string;
  src?: string;
}

interface Category {
  title: string;
  desc: string;
  logos: Logo[];
}

const categories: Category[] = [
  {
    title: "Enterprise ERPs",
    desc: "Where your transactions originate.",
    logos: [
      {
        name: "SAP S/4HANA",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59be2ddedbf4b5615765_sap.png",
      },
      {
        name: "QAD",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5985cf6273a972929eaa_qad.png",
      },
      {
        name: "Microsoft D365",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594489cb38a8fe58819d_ms.png",
      },
      {
        name: "Infor",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58f164e1f4bc7198c112_infor.png",
      },
      {
        name: "Oracle Fusion & EBS",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594b2872eeb6348efacd_oracle-fusion.png",
      },
    ],
  },
  {
    title: "Plant & Warehouse systems",
    desc: "Where the material actually moves.",
    logos: [
      {
        name: "MES",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59249eab064d1fffe168_mes.png",
      },
      {
        name: "WMS",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59f1d5f95121f3d0e696_wms.png",
      },
      {
        name: "TMS",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59d95ebea7fda2ea4254_tms.png",
      },
      {
        name: "Barcode & scanner feeds",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adf84f71f5a1ee55b63896f_brcode.png",
      },
      {
        name: "Plant maintenance",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59711172d09e5531486c_plant.png",
      },
    ],
  },
  {
    title: "Trade, channel & middleware",
    desc: "Where the goods cross the border, and the price is settled.",
    logos: [
      {
        name: "Customs brokers",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58b595eac82bb285c7fc_custom.png",
      },
      {
        name: "Freight forwarders",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58d5bf105356f0ac5249_frieght.png",
      },
      {
        name: "3PL",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb588fcf5353c2002fb4a3_3pl.png",
      },
      {
        name: "Distributor portals",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58ba57164b893950682d_dist.png",
      },
      {
        name: "Rebate management",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb598e5ebea7fda2e9fd83_rebate.png",
      },
      {
        name: "EDI",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58c4cd3ede7f6ea9ce13_edl.png",
      },
      {
        name: "TIBCO",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59d4427628a740fc9cbc_tibco.png",
      },
    ],
  },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div class="flex flex-col gap-12">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-left text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        We speak the language of your existing systems.
      </h2>

      <div
        class="grid grid-cols-1 lg:grid-cols-3 rounded-xl border border-neutral-200 divide-y divide-neutral-200 lg:divide-y-0 lg:divide-x"
      >
        {
          categories.map((cat) => (
            <div class="flex flex-col gap-12 p-6">
              <div class="flex flex-col gap-2">
                <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                  {cat.title}
                </p>
                <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                  {cat.desc}
                </p>
              </div>
              <div class="flex flex-wrap gap-2">
                {cat.logos.map((logo) => (
                  <span class="inline-flex items-center gap-x-3 gap-y-2 rounded-lg border border-neutral-200 px-3 py-1.5">
                    {logo.src ? (
                      <img
                        src={logo.src}
                        alt=""
                        class="max-h-6 w-full object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span
                        class="h-6 w-6 shrink-0 rounded-md bg-neutral-200"
                        aria-hidden="true"
                      />
                    )}
                    <span class="font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] whitespace-nowrap">
                      {logo.name}
                    </span>
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
