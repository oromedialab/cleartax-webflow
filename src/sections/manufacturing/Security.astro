---
/**
 * "Highest levels of security and audit readiness." Manufacturing variant.
 *
 * retail-consumer/Security.astro implements the full tabbed
 * Security/Compliance/Integrations/Support accordion (Figma instance
 * 15389:33465). The manufacturing source doc only gives four flat
 * title+description pairs (certifications, infra, incident response,
 * encryption) — identical copy to the real-estate brief's Security section —
 * no tab content to fill the other three panels, so this stays a simple
 * four-card grid instead of fabricating tabs the brief doesn't specify.
 */
interface SecurityItem {
  title: string;
  desc: string;
}

const items: SecurityItem[] = [
  {
    title: "Certifications & compliance",
    desc: "ISO 27001:2022 · SOC 2 Type II · ISO 22301 · GDPR. We do not self-declare security.",
  },
  {
    title: "Infrastructure & edge protection",
    desc: "WAF and anti-DDoS filter traffic before the VPC. SentinelOne CSPM + DSPM for anomaly detection. Private subnets, no public IPs.",
  },
  {
    title: "Incident response & audit logs",
    desc: "Every activity logged and traceable via SIEM and EDR. P0 response guaranteed under 24 hours.",
  },
  {
    title: "Encryption & access identity",
    desc: "AES-256 at rest, TLS 1.2+ in transit. SAML/OIDC SSO, RBAC, no standing access.",
  },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="container">
    <div class="flex flex-col gap-12">
      <h2 class="m-0 font-heading font-medium text-vault-navy text-center text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]">
        Highest levels of security and audit readiness.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          items.map((item) => (
            <div class="flex flex-col gap-3 rounded-xl border border-neutral-300 bg-generic-00 p-6 lg:p-8">
              <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px]">
                {item.title}
              </p>
              <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                {item.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
