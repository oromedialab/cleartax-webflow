---
/**
 * "Global experience, mandate after mandate." Manufacturing variant of
 * retail-consumer/GlobalExperience.astro's click-to-expand accordion.
 *
 * Source doc gives each case study as a 3-part tag line ("ELECTRONICS
 * MANUFACTURING · MALAYSIA · SAP ECC") plus a trailing metric and
 * description — split here into title (first two segments) + stat (ERP tag +
 * metric) to match the accordion's three-field shape, same as
 * retail-consumer's "Aviation · Multi-Entity" / "9 ERPs · 25+ TINs" split.
 * Only two case studies are given, so the accordion renders two items
 * instead of retail-consumer's three.
 */
interface CaseStudy {
  title: string;
  stat: string;
  text: string;
}

const items: CaseStudy[] = [
  {
    title: "ELECTRONICS MANUFACTURING · MALAYSIA · SAP ECC",
    stat: "500,000 invoices/ year",
    text: "ClearTax's own SI team built the SAP ECC integration and handles the full volume, around 2,000 documents every working day, submitted to LHDN under appointed intermediary status.",
  },
  {
    title: "LIGHTING & ELECTRICALS · SAUDI ARABIA · MULTI-ERP",
    stat: "3 ERPs, one layer",
    text: "SAP ECC, Oracle EBS and a custom system unified behind a single compliance layer. The estate stayed as it was; no consolidation project was needed to become compliant.",
  },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col gap-12">
        <h2
          class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
        >
          Global experience,<br />mandate after mandate.
        </h2>

        <div class="flex flex-col relative" data-mandate-root>
          {
            items.map((item, i) => (
              <div
                class:list={[
                  "mandate-item flex flex-col cursor-pointer group",
                  i === 0 && "active",
                ]}
                data-mandate-item
                data-index={i}
              >
                <h3 class="mandate-title font-heading text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] font-medium m-0 text-neutral-500 group-[.active]:text-vault-navy opacity-60 group-[.active]:opacity-100 pt-2 pb-1 transition-all duration-300">
                  {item.title}
                </h3>

                <div
                  class="mandate-desc overflow-hidden max-w-105 transition-all duration-500 ease-in-out"
                  style={i === 0 ? "max-height: 160px; opacity: 1;" : "max-height: 0px; opacity: 0;"}
                >
                  <div class="flex flex-col gap-2 pt-2 pb-3.5">
                    <p class="mandate-stat m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] tracking-[-0.5px]">
                      {item.stat}
                    </p>
                    <p class="mandate-text m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] max-lg:max-w-full">
                      {item.text}
                    </p>
                  </div>
                </div>

                <!-- Progress line loader -->
                <div class="relative w-full h-[2px] bg-neutral-200 mt-3 mb-5 rounded-full overflow-hidden">
                  <!-- Active blue line (fills up) -->
                  <div
                    class="mandate-progress absolute left-0 top-0 h-full bg-nova-blue rounded-full transition-none"
                    style="width: 0%;"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="relative aspect-square lg:aspect-[624/500] w-full"
        data-mandate-thumbs
      >
        {
          items.map((item, i) => (
            <div
              class:list={[
                "absolute inset-0 rounded-lg overflow-hidden transition-opacity duration-300 flex items-center justify-center",
                i === 0 ? "opacity-100" : "opacity-0",
              ]}
              data-mandate-panel
              aria-hidden={i !== 0}
            >
              <img
                src="/images/retail-consumer/ret.png"
                alt={item.title}
                class="w-full h-full object-contain"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script is:inline>
(() => {
  const init = () => {
    document.querySelectorAll("[data-mandate-root]").forEach((root) => {
      const items = Array.from(root.querySelectorAll("[data-mandate-item]"));
      const section = root.closest("section");
      const panels = section
        ? Array.from(section.querySelectorAll("[data-mandate-panel]"))
        : [];
      if (!items.length) return;

      let currentIndex = 0;
      let timer = null;
      const duration = 5000;

      const activateTab = (index, instant = false) => {
        currentIndex = index;

        items.forEach((item, i) => {
          const desc = item.querySelector(".mandate-desc");
          const progress = item.querySelector(".mandate-progress");

          if (i === index) {
            item.classList.add("active");
            if (desc) {
              desc.style.maxHeight = desc.scrollHeight + "px";
              desc.style.opacity = "1";
            }

            if (progress) {
              progress.style.transition = "none";
              progress.style.width = "0%";
              void progress.offsetWidth;

              if (!instant) {
                progress.style.transition = `width ${duration}ms linear`;
                progress.style.width = "100%";
              }
            }
          } else {
            item.classList.remove("active");
            if (desc) {
              desc.style.maxHeight = "0px";
              desc.style.opacity = "0";
            }

            if (progress) {
              progress.style.transition = "width 0.2s ease";
              progress.style.width = "0%";
            }
          }
        });

        panels.forEach((panel, i) => {
          const active = i === index;
          panel.classList.toggle("opacity-100", active);
          panel.classList.toggle("opacity-0", !active);
          panel.setAttribute("aria-hidden", active ? "false" : "true");
        });
      };

      const nextTab = () => {
        const next = (currentIndex + 1) % items.length;
        activateTab(next);
      };

      const startTimer = () => {
        clearInterval(timer);
        activateTab(currentIndex);
        timer = setInterval(nextTab, duration);
      };

      items.forEach((item, i) => {
        item.addEventListener("click", () => {
          clearInterval(timer);
          activateTab(i);
          timer = setInterval(nextTab, duration);
        });
      });

      window.addEventListener("resize", () => {
        const activeDesc = items[currentIndex]?.querySelector(".mandate-desc");
        if (activeDesc) {
          activeDesc.style.maxHeight = activeDesc.scrollHeight + "px";
        }
      });

      startTimer();
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
