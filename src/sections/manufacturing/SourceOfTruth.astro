---
/**
 * "From every plant and every movement to one source of truth." Figma node
 * 15562:45982 ("Sell side & Dispatch" / "Procurement, Transfers & Group").
 *
 * Built from screenshots (no Figma tool access in this environment). Source
 * -> billing-card pairing was confirmed against zoomed screenshots and by
 * asking the user directly where a wire's target was genuinely ambiguous —
 * see sellSideWires/procurementWires' own comments. The one thing that's
 * still a judgement call rather than a confirmed read: when 2+ differently
 * coloured sources converge on one billing card, that card's single
 * billing -> ERP GL exit wire is rendered purple (this design's dominant
 * colour) since one wire can only carry one colour.
 *
 * The actual diagram (cards + connectors) lives in ./FlowCanvas.astro — see
 * that file's doc comment for the pixel-coordinate provenance. This file
 * owns the two tab datasets (card content AND wire routing) and the
 * interaction — see real-estate/SourceOfTruth.astro's doc comment for the
 * scale-to-fit / draw-in-animation mechanics shared by both sections.
 *
 * Unlike the real-estate version, each tab here has 5 source rows (4 plain +
 * 1 `directToGL`) instead of 4, and the middleware column label / ERP GL
 * checklist differ per tab — both threaded through as FlowCanvas props
 * (`middlewareLabel`, `erpChecklist`) rather than fixed markup.
 */
import FlowCanvas, { CANVAS_W, CANVAS_H, type FlowCard, type FlowWire } from "./FlowCanvas.astro";

// Row gap is 40px (not the original 24px) ONLY directly above the
// `directToGL` row (row 4, the last one) — that's the room FlowCanvas.astro's
// floating "Direct → GL" badge needs to clear both the card above it (8px)
// and its own top edge (4px). All other gaps stay the original 24px.
const sellSideSources: FlowCard[] = [
  { x: 0, y: 52, w: 286, h: 144, tag: "purple", title: "Domestic sales", desc: "Plant despatch • direct billing\nTax where the goods ship from" },
  { x: 0, y: 220, w: 286, h: 144, tag: "purple", title: "Exports & cross-border", desc: "Intra-community supplies\nProof of exit held per shipment" },
  { x: 0, y: 388, w: 286, h: 144, tag: "purple", title: "Distributor & channel", desc: "Dealer sales • OEM contracts\nVolume rebates settled later" },
  { x: 0, y: 556, w: 286, h: 144, tag: "purple", title: "Scrap & by-product", desc: "Process waste • offcuts\nSamples and warranty despatch" },
  { x: 0, y: 740, w: 286, h: 144, tag: "orange", title: "Procurement / AP", desc: "Vendor invoices\nReverse charge", directToGL: true },
];

const sellSideBilling: FlowCard[] = [
  { x: 332, y: 220, w: 286, h: 144, tag: "grey", title: "Dispatch e-invoice", desc: "Structured e-invoice per country.\nTax from ship-from and ship-to." },
  { x: 332, y: 368, w: 286, h: 164, tag: "grey", title: "Movement document", desc: "Delivery note, goods in transit,\nexport evidence held against the invoice." },
];

// Confirmed with the user: Domestic sales, Exports & cross-border AND
// Distributor & channel (rows 0-2, all purple) converge on Dispatch
// e-invoice — as one merged line, not 3 separate entry points. Each of the
// 3 wires below is an explicit point path that travels to the SAME trunk
// point (310, 292 — Dispatch e-invoice's own vertical center, which is also
// Exports & cross-border's own row y, so its wire is already a straight
// run) and then shares the identical final segment (310,292)->(332,292)
// into the card — 3 overlapping dashed paths render as one line post-merge,
// same trick real estate's FlowCanvas draws bypass wires with (`points`
// instead of `from`/`to`/`turnX`). Scrap & by-product (row 3) is Movement
// document's only input, so it keeps a plain one-corner wire. Procurement/AP
// bypasses billing entirely, straight to ERP GL, same mechanic as real
// estate's Buyer/Tenant (already the bottom-most row, so a plain
// one-corner turn is safe — no card sits below it to hide behind).
const sellSideWires: FlowWire[] = [
  { flow: "purple", stage: "src-entry", points: [{ x: 286, y: 124 }, { x: 310, y: 124 }, { x: 310, y: 292 }, { x: 332, y: 292 }] },
  { flow: "purple", stage: "src-entry", points: [{ x: 286, y: 292 }, { x: 310, y: 292 }, { x: 332, y: 292 }] },
  { flow: "purple", stage: "src-entry", points: [{ x: 286, y: 460 }, { x: 310, y: 460 }, { x: 310, y: 292 }, { x: 332, y: 292 }] },
  { flow: "purple", stage: "src-entry", from: { x: 286, y: 628 }, to: { x: 332, y: 450 }, turnX: 316 },
  { flow: "orange", stage: "orange-full", from: { x: 286, y: 812 }, to: { x: 668, y: 500 }, turnX: 643 },
  { flow: "purple", stage: "bill-exit", from: { x: 618, y: 292 }, to: { x: 668, y: 260 }, turnX: 632 },
  { flow: "purple", stage: "bill-exit", from: { x: 618, y: 450 }, to: { x: 668, y: 320 }, turnX: 654 },
];

const sellSideChecklist = ["Output tax by ship-from and ship-to", "Zero-rating evidence", "Reverse charge on cross-border B2B", "E-invoice per country model", "Tax reconciliation"];

// Same 5-row layout as sellSideSources.
const procurementSources: FlowCard[] = [
  { x: 0, y: 52, w: 286, h: 144, tag: "green", title: "Imports & customs", desc: "Entry declarations • duty and\nimport VAT • deferment" },
  { x: 0, y: 220, w: 286, h: 144, tag: "purple", title: "Stock transfers", desc: "Plant to plant • cross-border\nOwn-goods movements" },
  { x: 0, y: 388, w: 286, h: 144, tag: "orange", title: "Toll & subcontract", desc: "Free-issue material out\nProcessing fee back in" },
  { x: 0, y: 556, w: 286, h: 144, tag: "purple", title: "Consignment & call-off", desc: "Stock at customer site\n12-month call-off clock" },
  { x: 0, y: 740, w: 286, h: 144, tag: "orange", title: "Intercompany & AP", desc: "Group cross-charges\nForeign vendor spend", directToGL: true },
];

const procurementBilling: FlowCard[] = [
  { x: 332, y: 220, w: 286, h: 164, tag: "grey", title: "Transfer document", desc: "Own-goods movement, call-off\nregister, 12-month clock tracked\nper consignment." },
  { x: 332, y: 388, w: 286, h: 144, tag: "grey", title: "Processing document", desc: "Toll fee raised as a service. Free-\nissue material held out of the sale." },
];

// Confirmed with the user, a clean 2+2 split: Imports & customs (green) and
// Stock transfers (purple) converge on Transfer document; Toll & subcontract
// (orange — corrected from an earlier purple guess, its wire is clearly
// orange in the zoomed screenshot) and Consignment & call-off (purple)
// converge on Processing document. Each pair uses distinct turnX lanes per
// colour, per the file's own convention, since same-lane + different colour
// reads as one merged multi-colour wire. Both billing cards' bill-exit wires
// render purple (this design's dominant colour) since each receives 2
// differently-coloured inputs and one wire can only carry one colour.
// Intercompany & AP bypasses billing entirely, same mechanic as
// sellSideWires' Procurement/AP.
const procurementWires: FlowWire[] = [
  { flow: "green", stage: "src-entry", from: { x: 286, y: 124 }, to: { x: 332, y: 260 }, turnX: 300 },
  { flow: "purple", stage: "src-entry", from: { x: 286, y: 292 }, to: { x: 332, y: 344 }, turnX: 308 },
  { flow: "orange", stage: "src-entry", from: { x: 286, y: 460 }, to: { x: 332, y: 415 }, turnX: 316 },
  { flow: "purple", stage: "src-entry", from: { x: 286, y: 628 }, to: { x: 332, y: 480 }, turnX: 324 },
  { flow: "orange", stage: "orange-full", from: { x: 286, y: 812 }, to: { x: 668, y: 500 }, turnX: 643 },
  { flow: "purple", stage: "bill-exit", from: { x: 618, y: 302 }, to: { x: 668, y: 260 }, turnX: 632 },
  { flow: "purple", stage: "bill-exit", from: { x: 618, y: 460 }, to: { x: 668, y: 320 }, turnX: 654 },
];

const procurementChecklist = ["Import VAT and deferment", "Input VAT recovery", "Intercompany tax and credit", "Deemed supply on own-goods transfers", "Tax reconciliation"];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="container">
    <div class="rounded-xl border border-neutral-200 p-6 lg:p-8">
      <div class="flex items-center justify-between gap-4 mb-12">
        <h2 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] text-balance">
          From every plant and every movement to one source of truth.
        </h2>
        <div class="inline-flex items-center gap-1 rounded-xl bg-neutral-100 p-1 max-w-[445px] w-full" data-sot-tabs>
          <button
            type="button"
            class="sot-tab inline-flex items-center justify-center rounded-lg px-6 py-2 font-body font-medium text-[length:var(--fs-label)] leading-[length:var(--lh-label)] cursor-pointer border-0 bg-generic-00 text-nova-blue shadow-[0px_1px_2px_0px_rgba(16,24,40,0.04)]"
            data-sot-tab="sell-side"
            aria-selected="true"
          >
            Sell side & Dispatch
          </button>
          <button
            type="button"
            class="sot-tab inline-flex items-center justify-center rounded-lg px-6 py-2 font-body font-medium text-[length:var(--fs-label)] leading-[length:var(--lh-label)] cursor-pointer border-0 bg-transparent text-neutral-700"
            data-sot-tab="procurement"
            aria-selected="false"
          >
            Procurement, Transfers & Group
          </button>
        </div>
      </div>

      <div class="sot-stage relative w-full" data-sot-stage>
        <div class="sot-track absolute top-0 left-0" style={`width:${CANVAS_W}px;height:${CANVAS_H}px;`} data-sot-track>
          <FlowCanvas
            id="sell-side"
            active={true}
            middlewareLabel="Billing // Tax-doc"
            erpChecklist={sellSideChecklist}
            sourceCards={sellSideSources}
            billingCards={sellSideBilling}
            wires={sellSideWires}
          />
          <FlowCanvas
            id="procurement"
            active={false}
            middlewareLabel="Movement // Tax-doc"
            erpChecklist={procurementChecklist}
            sourceCards={procurementSources}
            billingCards={procurementBilling}
            wires={procurementWires}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .sot-tab[aria-selected="true"] {
    background-color: var(--color-generic-00);
    color: var(--color-nova-blue);
    box-shadow: 0px 1px 2px 0px rgba(16, 24, 40, 0.04);
  }
  .sot-tab[aria-selected="false"] {
    background-color: transparent;
    color: var(--color-neutral-700);
  }
</style>

<script is:inline>
  (function () {
    /**
     * Connector draw-in: no <mask>, no stroke-dashoffset-through-a-mask —
     * see FlowCanvas.astro's doc comment on `straightLines`/`bentWires` for
     * why (a real Chrome bug: `zoom` — this site's `--page-zoom`, shared.css
     * — breaks SVG masks outright). Instead GSAP animates the actual
     * geometry: a straight <line>'s `x2`/`y2` attributes grow from its
     * `x1`/`y1` (its own `6 5` dasharray is never touched, so the dots you
     * see are the same dots throughout — just more of them as the line
     * extends); a bent <path>'s `d` is rebuilt every frame from a
     * length-truncated copy of its point list (`data-points`), re-rounded
     * with the same `roundedPolylineJS` FlowCanvas.astro's build-time
     * `roundedPolyline` mirrors.
     *
     * Staged in the order data actually moves through the diagram (see
     * FlowCanvas.astro's `Stage` type for the exact grouping) — sources
     * emit, merge onto the purple bus, feed billing; billing emits, merges
     * onto the green bus (and taps the middleware feed), feeds ERP GL; ERP
     * GL emits to cleartax. The bypass source's `orange-full` wire skips
     * billing entirely in one continuous path, so it gets a longer duration
     * instead of its own stage, timed to land at ERP GL together with the
     * other colors rather than arriving early.
     *
     * Plays once, on first scroll into view. GSAP loads from the same CDN
     * this codebase already uses elsewhere (global-homepage/WhyGenericAi.astro),
     * self-injected here rather than assumed already present on the page,
     * so this section works even if pasted somewhere that doesn't load it.
     */
    const STAGE_DURATION = 0.45;
    const EASE = "sine.out";
    const STAGE_ORDER = ["src-entry", "src-trunk", "src-exit", "bill-entry", "bill-trunk", "bill-exit", "final"];

    const prefersReducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function loadGsap(onReady) {
      if (window.gsap) return onReady();
      const existing = document.querySelector("script[data-gsap-cdn]");
      if (existing) {
        existing.addEventListener("load", onReady, { once: true });
        return;
      }
      const s = document.createElement("script");
      s.src = "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js";
      s.dataset.gsapCdn = "true";
      s.onload = onReady;
      document.head.appendChild(s);
    }

    // Mirrors FlowCanvas.astro's build-time `roundedPolyline` exactly.
    function roundedPolylineJS(points, r) {
      if (points.length < 2) return "";
      let d = `M ${points[0].x} ${points[0].y}`;
      for (let i = 1; i < points.length - 1; i++) {
        const prev = points[i - 1];
        const curr = points[i];
        const next = points[i + 1];
        const inLen = Math.hypot(curr.x - prev.x, curr.y - prev.y);
        const outLen = Math.hypot(next.x - curr.x, next.y - curr.y);
        const radius = Math.min(r, inLen / 2, outLen / 2);
        const inX = curr.x + ((prev.x - curr.x) / inLen) * radius;
        const inY = curr.y + ((prev.y - curr.y) / inLen) * radius;
        const outX = curr.x + ((next.x - curr.x) / outLen) * radius;
        const outY = curr.y + ((next.y - curr.y) / outLen) * radius;
        d += ` L ${inX} ${inY} Q ${curr.x} ${curr.y} ${outX} ${outY}`;
      }
      const last = points[points.length - 1];
      d += ` L ${last.x} ${last.y}`;
      return d;
    }

    function parsePoints(str) {
      return str.split(" ").map((pair) => {
        const [x, y] = pair.split(",").map(Number);
        return { x, y };
      });
    }

    function polylineLength(points) {
      let len = 0;
      for (let i = 0; i < points.length - 1; i++) len += Math.hypot(points[i + 1].x - points[i].x, points[i + 1].y - points[i].y);
      return len;
    }

    // Points from the wire's start up to `targetLen` along it — the
    // truncated shape `roundedPolylineJS` re-rounds every frame.
    function pointsUpToLength(points, targetLen) {
      let acc = 0;
      const result = [points[0]];
      for (let i = 0; i < points.length - 1; i++) {
        const a = points[i];
        const b = points[i + 1];
        const segLen = Math.hypot(b.x - a.x, b.y - a.y);
        if (acc + segLen >= targetLen) {
          const t = segLen === 0 ? 0 : (targetLen - acc) / segLen;
          result.push({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t });
          return result;
        }
        result.push(b);
        acc += segLen;
      }
      return result;
    }

    function prepareLine(gsap, el) {
      const x1 = Number(el.getAttribute("x1"));
      const y1 = Number(el.getAttribute("y1"));
      const x2 = Number(el.getAttribute("x2"));
      const y2 = Number(el.getAttribute("y2"));
      gsap.set(el, { attr: { x2: x1, y2: y1 } });
      return { type: "line", el, final: { x2, y2 } };
    }

    function preparePath(el) {
      const points = parsePoints(el.getAttribute("data-points"));
      const radius = Number(el.getAttribute("data-radius"));
      const total = polylineLength(points);
      el.setAttribute("d", `M ${points[0].x} ${points[0].y}`);
      return { type: "path", el, points, radius, total };
    }

    function tweenItem(tl, item, duration, position) {
      if (item.type === "line") {
        tl.to(item.el, { attr: { x2: item.final.x2, y2: item.final.y2 }, duration, ease: EASE }, position);
      } else {
        const proxy = { p: 0 };
        tl.to(
          proxy,
          {
            p: 1,
            duration,
            ease: EASE,
            onUpdate: () => item.el.setAttribute("d", roundedPolylineJS(pointsUpToLength(item.points, proxy.p * item.total), item.radius)),
          },
          position,
        );
      }
    }

    function animatePanel(panel) {
      if (!panel || panel.dataset.sotAnimated === "true") return;
      panel.dataset.sotAnimated = "true";
      const lines = Array.from(panel.querySelectorAll("[data-sot-line]"));
      if (!lines.length) return;

      if (prefersReducedMotion) return; // leave the static dashed lines as-is

      const gsap = window.gsap;
      const byStage = {};
      lines.forEach((line) => {
        const item = line.getAttribute("data-shape") === "line" ? prepareLine(gsap, line) : preparePath(line);
        const stage = line.getAttribute("data-stage");
        if (!byStage[stage]) byStage[stage] = [];
        byStage[stage].push(item);
      });

      const tl = gsap.timeline();
      STAGE_ORDER.forEach((stage, i) => {
        const group = byStage[stage];
        if (!group) return;
        group.forEach((item) => tweenItem(tl, item, STAGE_DURATION, i * STAGE_DURATION));
      });

      // The bypass source's wire skips billing in one continuous wire —
      // stretch its draw to land at ERP GL (stage index of "final") in step
      // with the other colors instead of finishing after just one stage.
      const orangeGroup = byStage["orange-full"];
      if (orangeGroup) {
        const finalIndex = STAGE_ORDER.indexOf("final");
        orangeGroup.forEach((item) => tweenItem(tl, item, STAGE_DURATION * finalIndex, 0));
      }

      // The middleware feed taps off the billing bus, so it plays alongside
      // that merge rather than getting its own place in STAGE_ORDER.
      const midFeedGroup = byStage["mid-feed"];
      if (midFeedGroup) {
        const billTrunkIndex = STAGE_ORDER.indexOf("bill-trunk");
        midFeedGroup.forEach((item) => tweenItem(tl, item, STAGE_DURATION, billTrunkIndex * STAGE_DURATION));
      }
    }

    document.querySelectorAll("[data-sot-stage]").forEach((stage) => {
      const track = stage.querySelector("[data-sot-track]");
      if (!track) return;
      const designWidth = track.offsetWidth;
      const designHeight = track.offsetHeight;

      const resize = () => {
        const scale = stage.clientWidth / designWidth;
        track.style.transform = `scale(${scale})`;
        track.style.transformOrigin = "top left";
        stage.style.height = `${designHeight * scale}px`;
      };

      window.addEventListener("resize", resize);
      resize();

      const tabsRoot = stage.parentElement.querySelector("[data-sot-tabs]");
      const tabs = tabsRoot ? tabsRoot.querySelectorAll("[data-sot-tab]") : [];
      const panels = track.querySelectorAll("[data-sot-panel]");

      let hasEnteredView = false;
      const activePanel = () => Array.from(panels).find((p) => !p.classList.contains("hidden"));

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            hasEnteredView = true;
            loadGsap(() => animatePanel(activePanel()));
            observer.disconnect();
          });
        },
        { threshold: 0.2 },
      );
      observer.observe(stage);

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const key = tab.getAttribute("data-sot-tab");
          tabs.forEach((t) => t.setAttribute("aria-selected", t === tab ? "true" : "false"));
          panels.forEach((p) => p.classList.toggle("hidden", p.getAttribute("data-sot-panel") !== key));
          // If the diagram was already visible before this switch, the
          // panel being switched TO has never had its own draw-in — play it
          // now instead of leaving it permanently hidden mid-animation.
          if (hasEnteredView) loadGsap(() => animatePanel(activePanel()));
        });
      });
    });
  })();
</script>
