---
/**
 * "From every plant and every movement to one source of truth." Manufacturing
 * variant.
 *
 * retail-consumer/SourceOfTruth.astro pairs this headline with a pixel-exact
 * animated flow diagram (see its FlowCanvas.astro) built from a Figma frame
 * with named source/billing cards per channel. The manufacturing source doc
 * only gives the headline plus two category labels — no per-card detail to
 * populate an equivalent diagram — so this stays a plain two-column layout
 * instead of fabricating flow-diagram content that isn't in the brief.
 */
interface Category {
  title: string;
}

const categories: Category[] = [
  { title: "Sell Side & Dispatch" },
  { title: "Procurement, Transfers & Group" },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="container">
    <div class="rounded-xl border border-neutral-200 p-6 lg:p-8">
      <div class="flex flex-col gap-12">
        <h2 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]">
          From every plant and every movement to one source of truth.
        </h2>

        <div class="grid sm:grid-cols-2 gap-6">
          {
            categories.map((cat) => (
              <div class="flex flex-col gap-4">
                <div class="aspect-[568/400] w-full bg-visual-placeholder rounded-lg" />
                <p class="m-0 font-heading font-medium text-vault-navy text-center text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] tracking-[-0.5px]">
                  {cat.title}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
