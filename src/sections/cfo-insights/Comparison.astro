</div>

<style is:global>
  @media (max-height: 750px) {
    .cfoicmp-sticky-container .cfoicmp-sticky-section {
      padding-top: 1.25rem !important;
      padding-bottom: 1.25rem !important;
    }
    .cfoicmp-card {
      max-width: calc(100vw - 32px) !important;
      width: calc(100vw - 32px) !important;
    }
    @media (min-width: 768px) {
      .cfoicmp-card {
        max-width: 420px !important;
        width: 38vw !important;
      }
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const containers = document.querySelectorAll(".cfoicmp-sticky-container");
    if (!containers.length) return;

    containers.forEach((container) => {
      const track = container.querySelector(".cfoicmp-track");
      const section = container.querySelector(".cfoicmp-sticky-section");
      if (!container || !track || !section) return;

      const getHeaderHeight = () => {
        const header = document.querySelector("header, .navbar, .w-nav");
        return header ? header.offsetHeight : 80;
      };

      let maxTranslate = 0;
      let totalScrollable = 0;
      let stickyTop = 0;

      const updateMeasurements = () => {
        const sectionHeight = section.offsetHeight;
        const windowHeight = window.innerHeight;
        const headerHeight = getHeaderHeight();

        const trackOffset =
          track.parentElement.getBoundingClientRect().top -
          section.getBoundingClientRect().top;
        const trackHeight = track.offsetHeight;
        const availableSpace = windowHeight - headerHeight;

        const idealTrackTop =
          headerHeight + Math.max(40, (availableSpace - trackHeight) / 2);
        let calculatedTop = idealTrackTop - trackOffset;

        stickyTop = Math.min(headerHeight, calculatedTop);
        section.style.top = `${stickyTop}px`;

        const containerWidth = track.parentElement.getBoundingClientRect().width;
        maxTranslate = Math.max(0, track.scrollWidth - containerWidth);
        container.style.height = `${maxTranslate + windowHeight}px`;
        totalScrollable = container.getBoundingClientRect().height - sectionHeight;
      };

      updateMeasurements();

      if (window.ResizeObserver) {
        const ro = new ResizeObserver(updateMeasurements);
        ro.observe(section);
        ro.observe(track);
      }
      window.addEventListener("resize", updateMeasurements);

      let ticking = false;

      const handleScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            const containerRect = container.getBoundingClientRect();
            const scrolledDistance = Math.max(0, stickyTop - containerRect.top);

            let progress = totalScrollable > 0 ? scrolledDistance / totalScrollable : 0;
            progress = Math.max(0, Math.min(1, progress));

            track.style.transform = `translate3d(-${progress * maxTranslate}px, 0, 0)`;

            ticking = false;
          });
          ticking = true;
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              window.addEventListener("scroll", handleScroll, { passive: true });
              handleScroll();
            } else {
              window.removeEventListener("scroll", handleScroll);
            }
          });
        },
        { rootMargin: "100% 0px 100% 0px" },
      );

      observer.observe(container);
    });
  });
</script>
