---
/**
 * "Real-life example" — same bordered two-column card shape as
 * accounts-payable/RealLifeExample.astro, content swapped for the plant
 * maintenance example from the CFO Insights doc.
 */
const findings = [
  "The GL could tell the team how much they were spending. It couldn’t tell them whether that spend was necessary, where it was concentrated, or what they could safely change.",
  "Clarity AI connected maintenance spend with plant output, downtime and capacity, and separated what the business was actually buying at each plant.",
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full px-4 md:px-6 mx-auto">
    <div
      class="flex flex-col lg:flex-row gap-6 lg:gap-8 border border-neutral-200 rounded-xl p-6"
    >
      <div class="flex flex-col gap-4 xl:gap-6 flex-1">
        <div class="flex flex-col gap-4">
          <h2
            class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
          >
            Real life example
          </h2>
          <p
            class="m-0 max-w-121 font-body text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
          >
            Clarity AI identified $1.58M of optimization potential in plant
            maintenance spend, worth $420K of EBITDA
          </p>
        </div>

        <div class="h-px w-full bg-ledger-100"></div>

        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-4 max-w-121">
            <p
              class="m-0 font-body text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)] max-w-88"
            >
              Maintenance spend looked like a fixed cost of running the plants.
            </p>
            <div class="flex flex-col gap-2">
              <ul class="list-none m-0 p-0 flex flex-col gap-2">
                {
                  findings.map((f) => (
                    <li class="flex items-center gap-2">
                      <span
                        class="shrink-0 w-2 h-2 rounded-full bg-nova-blue"
                        aria-hidden="true"
                      />
                      <span class="font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                        {f}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <p
            class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] max-w-87.5"
          >
            The analysis identified $1,58M of optimization potential without
            trading off production capacity.
          </p>
        </div>
      </div>

      <div class="relative flex-1 min-h-50 lg:min-h-auto overflow-hidden">
        <img
          src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae074b307c33e0286c2c25e_cfo-icon.png"
          alt="icon"
          loading="lazy"
          height="406"
          width="598"
          class="h-full w-full object-contain"
        />
      </div>
    </div>
  </div>
</section>
