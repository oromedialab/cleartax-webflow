---
/**
 * Hero — Figma node 16734:50376 ("Container - Hero").
 *
 * The mock's decorative background is an 8-column wall of ~50 faint icon
 * tiles behind a radial gradient wash — pure filler with no content value.
 * Swapped for the shared interactive dot-grid field (`_shared/Dotgrid.astro`)
 * used by every other brand v2 hero instead, same geometry as
 * trust-centre/Hero.astro. It shares this hero's one Flux Lime highlight
 * (the "one chain." text) rather than counting as a second use — the brand
 * allows one Flux Lime moment per screen, not per element.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

const lineWidth = 3;
const gap = 24;
const maxLength = 6;
const lengthRadius = 260;
const tilt = 1;
const baseColor = "#C8F006";
const cursorRadius = 320;
const pull = 14;
const fadeRadius = 40;
---

<section id="bg-hero" class="relative overflow-hidden bg-generic-00 pt-32 pb-16 lg:pt-44 lg:pb-20">
  <Dotgrid
    containerId="bg-hero"
    lineWidth={lineWidth}
    gap={gap}
    maxLength={maxLength}
    lengthRadius={lengthRadius}
    tilt={tilt}
    baseColor={baseColor}
    cursorRadius={cursorRadius}
    pull={pull}
    fadeRadius={fadeRadius}
  />

  <!-- Radial wash, so the headline keeps its contrast over the field -->
  <div
    class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.6)_30%,_rgba(255,255,255,0)_65%)]"
  >
  </div>

  <div class="pointer-events-auto relative z-10 mx-auto flex w-full flex-col items-center px-4 text-center md:px-6">
    <h1
      class="m-0 mb-6 max-w-245 font-heading text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] font-semibold text-vault-navy lg:text-[length:var(--fs-display-sm)] lg:leading-[length:var(--lh-display-sm)]"
    >
      Governance runs through three people.
      <br />
      Now it runs on{" "}
      <span class="bg-flux-lime inline-block rounded-lg px-[13px] py-1 text-generic-100">
        one chain.
      </span>
    </h1>

    <p class="m-0 mb-8 max-w-125 font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500">
      The company secretary who prepares it. The director who decides on it.
      The compliance head who has to prove it happened.
    </p>

    <a
      href="https://www.cleartax.com/contact-us"
      data-demo-open
      class="inline-flex items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 font-body text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-50 no-underline shadow-[0px_2px_3px_rgba(16,24,40,0.06)] transition-all duration-200 ease-in-out hover:bg-generic-00 hover:text-nova-blue"
    >
      Book a demo
    </a>
  </div>
</section>
