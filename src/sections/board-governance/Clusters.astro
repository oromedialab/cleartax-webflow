---
/**
 * "Where to start" — Figma node 16734:52021
 * ("Container - Fifteen-plus clusters, one obligation universe.").
 * Three self-selection cards, each a set of symptom bullets for one product.
 */
interface StartCard {
  title: string;
  bullets: string[];
}

const cards: StartCard[] = [
  {
    title: "BLISS if…",
    bullets: [
      "Your secretarial team is rebuilding agendas and registers by hand each quarter",
      "Records are scattered across drives and a predecessor's laptop",
      "A secretarial audit is coming and there is no consolidated record",
    ],
  },
  {
    title: "BLISSDOCS if…",
    bullets: [
      "Directors are reading board packs as email attachments",
      "Papers are still being printed and couriered before meetings",
      "There is no way to withdraw board material when a director steps down",
    ],
  },
  {
    title: "Compass if…",
    bullets: [
      "Nobody can answer \"what is our exposure, in rupees?\"",
      "Ten-plus entities and no single view of what is overdue",
      "Proof documents are only examined once a year, at audit",
    ],
  },
];
---

<section class="bg-generic-00 px-4 py-16 md:px-6 lg:py-20">
  <div class="mx-auto max-w-[var(--container-max)] rounded-xl border-2 border-nova-blue p-6 lg:p-12">
    <h2 class="m-0 mb-10 text-center font-heading text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] font-medium text-vault-navy lg:mb-12 lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)]">
      Where to start
    </h2>

    <div class="flex flex-col gap-10 lg:flex-row lg:gap-8">
      {
        cards.map((card, i) => (
          <>
            {i > 0 && (
              <div class="hidden h-auto w-px shrink-0 bg-ledger-white lg:block" aria-hidden="true" />
            )}
            <div class="flex flex-1 flex-col gap-6">
              <p class="m-0 font-heading text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] font-medium text-vault-navy">
                {card.title}
              </p>
              <div class="flex flex-col gap-6">
                {
                  card.bullets.map((bullet, bi) => (
                    <>
                      {bi > 0 && <div class="h-px w-full bg-ledger-white" aria-hidden="true" />}
                      <p class="m-0 font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500">
                        {bullet}
                      </p>
                    </>
                  ))
                }
              </div>
            </div>
          </>
        ))
      }
    </div>
  </div>
</section>
