---
/**
 * Y-Model, demystified — Figma node 16734:51982
 * ("Container - The Y-Model, demystified").
 *
 * A stat strip (4 figures, divider-separated) under an overline + heading,
 * then a two-column pair of supporting claims.
 */
interface Stat {
  value: string;
  label: string;
}

const stats: Stat[] = [
  {
    value: "40–100",
    label: "compliances a year for an unlisted company under the Companies Act, 2013",
  },
  {
    value: "200–800",
    label: "compliances a year once you are listed and SEBI's LODR applies",
  },
  {
    value: "15+",
    label: "separate law clusters an enterprise answers to beyond corporate law alone",
  },
  {
    value: "Personal liability",
    label: "on directors and key managerial personnel; the reason a name on every approval matters",
  },
];

interface Claim {
  heading: string;
  body: string;
}

const claims: Claim[] = [
  {
    heading: "Secretarial audit is not optional above the threshold",
    body: "Under section 204 of the Companies Act, 2013, every listed company has its statutory compliance audited by a practising company secretary, who reports to shareholders.",
  },
  {
    heading: "The evidence is usually the weak link",
    body: "Most enterprises can produce a tracker showing an obligation marked complete. Far fewer can produce, on demand. That gap is where qualified remarks and demand notices come from.",
  },
];
---

<section class="bg-generic-00 px-4 py-16 md:px-6 lg:py-20">
  <div class="mx-auto flex max-w-[var(--container-max)] flex-col items-center gap-10 lg:gap-12">
    <div class="flex flex-col items-center gap-4 text-center">
      <p class="m-0 font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-semibold tracking-[1px] text-nova-blue uppercase">
        The problem
      </p>
      <h2 class="m-0 max-w-120 font-heading text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] font-medium text-vault-navy lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] text-balance">
        The board approves. The regulator asks for proof.
      </h2>
      <p class="m-0 max-w-272 font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500 lg:text-[length:var(--fs-body-lg)] lg:leading-[length:var(--lh-body-lg)] text-balance">
        Incorporation gives a company the right to raise capital with limited
        liability and transferable shares. The price is a compliance load
        that grows with every listing, every subsidiary and every new
        statute, and enforcement that now asks for the document, not the
        assurance.
      </p>
    </div>

    <div class="flex w-full flex-col gap-6 rounded-xl border border-neutral-300 p-6 lg:flex-row lg:items-start lg:gap-8">
      {
        stats.map((stat, i) => (
          <>
            {i > 0 && (
              <div
                class="hidden w-px shrink-0 self-stretch bg-ledger-white lg:block"
                aria-hidden="true"
              />
            )}
            <div class="flex flex-1 flex-col gap-4">
              <p class="m-0 font-heading text-[length:var(--fs-h3)] leading-[length:var(--lh-h3)] font-medium text-vault-navy">
                {stat.value}
              </p>
              <p class="m-0 font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500">
                {stat.label}
              </p>
            </div>
          </>
        ))
      }
    </div>

    <div class="grid w-full grid-cols-1 gap-8 lg:grid-cols-2">
      {
        claims.map((claim) => (
          <div class="flex flex-col gap-4">
            <p class="m-0 font-body text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] text-vault-navy">
              {claim.heading}
            </p>
            <p class="m-0 font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500">
              {claim.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
