                  >
                    {step.heading}
                  </span>
                  <span class="sa-steps-body-wrap">
                    <span class="sa-steps-body font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500">
                      {step.body}
                    </span>
                  </span>
                </span>
              </button>
            </div>
            {i < prevSteps.length - 1 && (
              <div
                class="sa-steps-connector mx-auto h-10 w-0.5 bg-neutral-300"
