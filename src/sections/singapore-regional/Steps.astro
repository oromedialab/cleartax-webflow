<style is:global>
  .sa-steps-list {
    overflow-anchor: none;
  }
  .sa-steps-item {
    opacity: 0.5;
    transition: border-color 350ms ease-in-out, opacity 350ms ease-in-out;
  }
  .sa-steps-open.sa-steps-item {
    opacity: 1;
  }
