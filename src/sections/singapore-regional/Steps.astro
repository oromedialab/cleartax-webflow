              class={`sa-steps-item flex gap-4 rounded-xl bg-generic-00 border-2 ${i === 0 ? "border-nova-blue sa-steps-open" : "border-neutral-300"} p-4`}
              data-sa-steps-item
            >
              <button
                type="button"
                class="sa-steps-trigger flex w-full cursor-pointer items-start gap-4 border-0 bg-transparent p-0 text-left"
                aria-expanded={i === 0 ? "true" : "false"}
              >
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-neutral-300 bg-generic-00 font-body text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] font-medium text-vault-navy">
