---
/**
 * "Build your InvoiceNow readiness plan in five steps" — Singapore regional page.
 *
 * Implements sticky horizontal scroll container matching regional specs:
 * - Section pins to viewport as reader scrolls down the page
 * - Translates horizontal track smoothly across the 5 implementation step cards
 * - Blue connecting progress line connects all cards together and fills dynamically with scroll progress
 */

interface Step {
  number: number;
  title: string;
  bullets: string[];
}

const steps: Step[] = [
  {
    number: 1,
    title: "Confirm your entities and implementation phase",
    bullets: [
      "Check GST registration status, the relevant application date, the 2025 supplies measure and any IRAS exclusions.",
      "Map the requirement to each GST registration in Singapore. Entities registered on their own can fall into different phases, while members of a GST group follow the group’s phase.",
    ],
  },
  {
    number: 2,
    title: "Choose the connection approach",
    bullets: [
      "Check whether your finance solution is InvoiceNow-ready.",
      "Businesses using in-house enterprise systems can work with an IMDA-accredited Access Point Provider to establish connectivity. Register with your UEN and obtain a Peppol ID.",
    ],
  },
  {
    number: 3,
    title: "Prepare sales and purchase data",
    bullets: [
      "Review master data, invoice references, credit notes and GST treatment.",
      "Map your internal tax codes to the prescribed IRAS GST category codes. Identify how required off-network invoice data will enter the submission workflow.",
    ],
  },
  {
    number: 4,
    title: "Enable reporting and test end-to-end",
    bullets: [
      "Enable the GST InvoiceNow submission feature and test successful transmission to IRAS—not only delivery to the customer.",
      "Include required sales, purchase and credit-note scenarios in your testing.",
    ],
  },
  {
    number: 5,
    title: "Reconcile and maintain your GST controls",
    bullets: [
      "Assign owners for exceptions, reporting deadlines and reconciliation.",
      "Continue filing GST returns and keeping the required business records; InvoiceNow does not replace those obligations. [S1, S2]",
    ],
  },
];

