---
/**
 * FAQ for the Singapore regional page.
 *
 * Structure, styling and behaviour live in `_shared/FaqRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file,
 * because the embed route renders sections with no props.
 *
 * The Figma has no subtitle under the heading, so an empty one is passed —
 * `FaqRb` omits the paragraph when it is empty. Eleven questions, first open,
 * remaining behind "Load more" after five.
 */
import FaqRb from "../_shared/FaqRb.astro";
import type { FaqItem } from "../_shared/FaqRb.astro";

const items: FaqItem[] = [
    {
        q: "What is InvoiceNow?",
        a: [
            {
                kind: "p",
                html: "InvoiceNow is Singapore’s nationwide e-invoicing network based on Peppol. It enables businesses to transmit standardised invoice data between connected finance and accounting systems. IMDA is the Singapore Peppol Authority.",
            },
        ],
    },
    {
        q: "Is e-invoicing mandatory for every Singapore business now?",
        a: [
            {
                kind: "p",
                html: "No. The GST InvoiceNow Requirement is being implemented in phases for covered GST-registered businesses. The November 2025 and April 2026 phases concern specified new voluntary GST registrants. New compulsory registrants and existing GST-registered businesses enter the published rollout from April 2028 to April 2031, subject to exclusions.",
            },
        ],
    },
    {
        q: "Who is covered from 1 April 2026?",
        a: [
            {
                kind: "p",
                html: "Businesses applying for new voluntary GST registration on or after 1 April 2026, regardless of incorporation date or business structure. This is not a requirement covering all new compulsory GST registrants from that date.",
            },
        ],
    },
    {
        q: "When do existing GST-registered businesses have to adopt?",
        a: [
            {
                kind: "p",
                html: "The published phases begin on 1 April 2028 for total annual supplies of SGD 200,000 or less, then extend to SGD 1,000,000 or less from 1 April 2029, SGD 4,000,000 or less from 1 April 2030, and above SGD 4,000,000 from 1 April 2031. An earlier phase continues to apply once the business is covered. Use the IRAS 2025 accounting-period measure and check exclusions.",
            },
        ],
    },
    {
        q: "Does sending a Peppol invoice automatically mean it has been reported to IRAS?",
        a: [
            {
                kind: "p",
                html: "Not unless the GST InvoiceNow submission feature is enabled and the relevant reporting connection is in place. An existing network participant can continue sending Peppol invoices without those invoices being transmitted to IRAS where the submission feature is not activated.",
            },
        ],
    },
    {
        q: "What if a customer or supplier is not on InvoiceNow?",
        a: [
            {
                kind: "p",
                html: "Relevant off-network transactions can be recorded in an InvoiceNow-Ready Solution and submitted to IRAS through the solution-extracted route. A counterparty’s absence from the network does not, by itself, remove your reporting obligation for an in-scope transaction.",
            },
        ],
    },
    {
        q: "Is a PDF enough for InvoiceNow reporting?",
        a: [
            {
                kind: "p",
                html: "A PDF sent by email is not a Peppol invoice. For relevant paper or PDF transactions, record the invoice data in your solution and use the solution-extracted submission route. Sending a PDF to an Access Point for conversion is not the reporting method described by IRAS.",
            },
        ],
    },
    {
        q: "Does InvoiceNow replace GST returns or record keeping?",
        a: [
            {
                kind: "p",
                html: "No. Businesses must continue filing GST returns and retaining proper business and accounting records, including source documents, for at least five years. Invoice-data transmission is an additional obligation for businesses in scope.",
            },
        ],
    },
    {
        q: "When must invoice data be submitted to IRAS?",
        a: [
            {
                kind: "p",
                html: "The deadline is the earlier of the date you file the relevant GST return and its filing due date. Plan a regular submission process rather than treating customer invoice delivery as proof that reporting is complete.",
            },
        ],
    },
    {
        q: "Can we keep our existing ERP?",
        a: [
            {
                kind: "p",
                html: "IRAS’s guidance provides for in-house enterprise solutions connected through an IMDA-accredited Access Point. Whether your specific system can be used depends on its capabilities and the integration work required. Confirm the supported approach, mappings and testing plan for your deployment.",
            },
        ],
    },
    {
        q: "How can ClearTax help us plan?",
        a: [
            {
                kind: "p",
                html: "Bring your source systems, invoice volumes and business priorities to a demo. Discuss the Singapore workflows you need, and confirm current product capabilities, provider arrangements, implementation dependencies and support scope before choosing your deployment approach.",
            },
        ],
    },
];
---

<FaqRb items={items} subtitle="" />

