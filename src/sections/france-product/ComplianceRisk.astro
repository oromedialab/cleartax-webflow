---
/**
 * "The cost of missing the September deadline" — Figma node 16433:47348.
 *
 * Heading + lede, then a notice-bordered box with two penalty figures split
 * by a divider, and a closing "Audit exposure" line in the negative colour.
 */
interface Penalty {
  amount: string;
  label: string;
  body: string;
}

const penalties: Penalty[] = [
  {
    amount: "€50",
    label: "Per non-compliant invoice",
    body: "Autonomous mapping of your ERP data model. Pre-built connectors for SAP R3/HANA/ECC, Oracle, MS Dynamics 365, and 50 others. Go from kick-off to live invoices in 8–10 weeks.",
  },
  {
    amount: "€500",
    label: "Per e-reporting transmission",
    body: "Penalty for each failed or incorrect submission of B2C and cross-border transaction data to DGFiP. Also capped at €15,000 per year.",
  },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="container mx-auto flex flex-col gap-12">
    <div class="flex flex-col gap-12">
      <div class="flex flex-col items-center gap-3 text-center">
        <p class="m-0 font-body font-semibold text-nova-blue text-[length:var(--fs-label)] leading-[length:var(--lh-label)] uppercase tracking-[1px]">
          Compliance Risk
        </p>
        <h2 class="m-0 max-w-[700px] font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] text-balance">
          The cost of missing the September deadline
        </h2>
        <p class="m-0 max-w-[634px] font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
          {"France's penalty regime escalates fast. Italy halved its VAT gap within two years of mandating e-invoicing — because enforcement followed immediately."}
        </p>
      </div>

      <div class="flex w-full flex-col items-center gap-8 rounded-xl border-2 border-[var(--border-notice,#ff8000)] p-6 lg:flex-row lg:items-stretch">
        {
          penalties.map((p, i) => (
            <>
              {i > 0 && <div class="hidden w-0.5 shrink-0 rounded-full bg-neutral-300 lg:block" aria-hidden="true" />}
              <div class="flex flex-1 flex-col gap-3">
                <p class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h4)] leading-[length:var(--lh-h4)] tracking-[-0.5px]">
                  {p.amount}
                </p>
                <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                  {p.label}
                </p>
                <p class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                  {p.body}
                </p>
              </div>
            </>
          ))
        }
      </div>
    </div>

    <div class="flex flex-col items-center gap-3 text-center">
      <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
        Audit exposure
      </p>
      <p class="m-0 max-w-[706px] font-body font-normal text-[color:var(--content-negative,#e50000)] text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] text-balance">
        Operational and reputational risk. Non-compliance triggers DGFiP audit risk, payment delays from buyers unable to receive e-invoices, and reputational damage with French trading partners.
      </p>
    </div>
  </div>
</section>
