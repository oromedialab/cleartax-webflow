---
/**
 * "Built for the full complexity of French compliance" — Figma node
 * 16433:47332. Six cards in a 2-column grid, each a heading + plus icon that
 * opens one shared overlay with prev/next chevrons — same pattern as
 * `france-regional/Supports.astro`.
 *
 * PLACEHOLDER BODY COPY: the Figma shows only an icon + heading + plus per
 * card (an "expand for detail" button), with no body text captured in the
 * design. The bodies below are drafted marketing copy consistent with the
 * platform capabilities named elsewhere on this page and should be reviewed
 * by content before staging.
 *
 * The icon squares and the overlay visual are unfilled "Icon placeholder" /
 * "Image" frames in the Figma, so they render as `bg-visual-placeholder` —
 * #E8FFE1, the fill the design uses. Swap each for a Webflow-hosted URL when
 * the artwork lands — never a `data:` URI.
 */
interface PlatformCard {
  heading: string;
  body: string;
}

const cards: PlatformCard[] = [
  {
    heading: "AI-driven integration",
    body: "Autonomous mapping of your ERP data model. Pre-built connectors for SAP R3/HANA/ECC, Oracle, MS Dynamics 365, and 50 others. Go from kick-off to live invoices in 8–1",
  },
  {
    heading: "One integration, 40+ countries",
    body: "Integrate once. When Belgium (2026), Germany (2027), or Spain (2027) mandates arrive, unlock them instantly — no new ERP work. Your IT team touches it once, ever.",
  },
  {
    heading: "Real-time MIS dashboard",
    body: "Every invoice status, error rate, and lifecycle event in a single view. One-click drill-down into failures with guided corrective workflows. Nothing misses your finance team.",
  },
  {
    heading: "AI-powered reconciliation",
    body: "Automatically matches e-invoice data against your ERP general ledger. Surfaces discrepancies before DGFiP's own audits — eliminating the VAT-gap notices that hit 90% of businesses post-mandate.",
  },
  {
    heading: "24×7 dedicated support",
    body: "A named French-speaking customer success manager. In-house tax compliance experts on call. In-product ticketing with a 3-tiered escalation matrix — no outsourced helpdesk, ever.",
  },
  {
    heading: "Future-proof by design",
    body: "Regulatory amendments — new fields, format updates, DGFiP changes — are absorbed by our cloud layer. No ERP changes, no re-integration cycles, no IT surprises when the rules shift.",
  },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="container mx-auto flex flex-col gap-12">
    <div class="flex flex-col items-center gap-3 text-center">
      <p class="m-0 font-body font-semibold text-nova-blue text-[length:var(--fs-label)] leading-[length:var(--lh-label)] uppercase tracking-[1px]">
        Platform
      </p>
      <h2 class="m-0 max-w-[560px] font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]">
        Built for the full complexity of French compliance
      </h2>
      <p class="m-0 max-w-[530px] font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
        ClearTax is not an invoice transmitter. It is a compliance operating system — from ERP integration through VAT reconciliation.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
      {
        cards.map((card, i) => (
          <button
            type="button"
            class="group m-0 flex w-full cursor-pointer items-center gap-6 rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue"
            aria-haspopup="dialog"
            data-fp-platform-open
            data-fp-platform-index={i}
          >
            <span class="block h-14 w-14 shrink-0 rounded-lg bg-visual-placeholder" aria-hidden="true" />
            <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
              {card.heading}
            </span>
            <span
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg p-2 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
              aria-hidden="true"
            >
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 10V30" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M30 20L10 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<!-- Detail overlay. Lives outside the section's container so the scrim covers
     the viewport rather than the 1280px column. -->
<div
  id="fp-platform-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="fp-platform-overlay-title"
  aria-hidden="true"
  class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
>
  <div
    class="relative max-h-[90vh] w-full max-w-[1280px] overflow-y-auto rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6"
    data-fp-platform-panel
  >
    <button
      type="button"
      aria-label="Close"
      class="absolute right-6 top-6 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-11 lg:top-11"
      data-fp-platform-close
    >
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" class="rotate-45" aria-hidden="true" focusable="false">
        <path d="M20 10V30" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M30 20L10 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="flex flex-col items-start gap-6 lg:flex-row lg:gap-12">
      <div class="flex w-full flex-col justify-between gap-6 lg:w-[416px] lg:shrink-0 lg:self-stretch">
        <div class="flex flex-col gap-6">
          <span class="block h-16 w-16 shrink-0 rounded-lg bg-visual-placeholder" aria-hidden="true" />
          <div id="fp-platform-overlay-title">
            {
              cards.map((card, i) => (
                <h3
                  class="m-0 pr-12 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px] lg:pr-0"
                  hidden={i !== 0}
                  data-fp-platform-heading
                >
                  {card.heading}
                </h3>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col gap-6">
          <div>
            {
              cards.map((card, i) => (
                <p
                  class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                  hidden={i !== 0}
                  data-fp-platform-body
                >
                  {card.body}
                </p>
              ))
            }
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              aria-label="Previous"
              aria-controls="fp-platform-overlay-title"
              class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue"
              data-fp-platform-prev
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M12 15L7 10L12 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <button
              type="button"
              aria-label="Next"
              aria-controls="fp-platform-overlay-title"
              class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue"
              data-fp-platform-next
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M7 5L12 10L7 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="aspect-[1280/720] w-full rounded-lg bg-visual-placeholder lg:w-auto lg:flex-1" aria-hidden="true" />
    </div>
  </div>
</div>

<script is:inline>
  /* Card -> detail overlay, with the chevrons walking the six without closing.
     Same mechanics as `france-regional/Supports.astro`. */
  (function () {
    var overlay = document.getElementById("fp-platform-overlay");
    if (!overlay) return;

    var panel = overlay.querySelector("[data-fp-platform-panel]");
    var closeBtn = overlay.querySelector("[data-fp-platform-close]");
    var prevBtn = overlay.querySelector("[data-fp-platform-prev]");
    var nextBtn = overlay.querySelector("[data-fp-platform-next]");
    var headings = overlay.querySelectorAll("[data-fp-platform-heading]");
    var bodies = overlay.querySelectorAll("[data-fp-platform-body]");
    if (!panel || !headings.length || headings.length !== bodies.length) return;

    var count = headings.length;
    var current = 0;
    var lastFocused = null;

    function show(index) {
      current = ((index % count) + count) % count;
      for (var i = 0; i < count; i++) {
        headings[i].hidden = i !== current;
        bodies[i].hidden = i !== current;
      }
      panel.scrollTop = 0;
    }

    function open(index, opener) {
      lastFocused = opener || document.activeElement;
      show(index);
      overlay.style.display = "flex";
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
    }

    function close() {
      overlay.style.display = "none";
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function isOpen() {
      return overlay.style.display === "flex";
    }

    document.addEventListener("click", function (e) {
      if (!e.target.closest) return;
      var opener = e.target.closest("[data-fp-platform-open]");
      if (!opener) return;
      open(parseInt(opener.getAttribute("data-fp-platform-index"), 10) || 0, opener);
    });

    if (closeBtn) closeBtn.addEventListener("click", close);
    if (prevBtn)
      prevBtn.addEventListener("click", function () {
        show(current - 1);
      });
    if (nextBtn)
      nextBtn.addEventListener("click", function () {
        show(current + 1);
      });

    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) close();
    });

    document.addEventListener("keydown", function (e) {
      if (!isOpen()) return;

      if (e.key === "Escape") {
        close();
        return;
      }

      if (e.key === "ArrowLeft") {
        show(current - 1);
        return;
      }
      if (e.key === "ArrowRight") {
        show(current + 1);
        return;
      }

      if (e.key !== "Tab") return;
      var focusable = panel.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>
