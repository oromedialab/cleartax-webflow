---
/**
 * "Spain e-Invoicing resource centre" — Figma node 15121:30542 ("Container -
 * Resources").
 *
 * Up to 3 per row in a grid (Figma mocks six as a 3-column grid). Each card
 * is a category chip, an optional "New" chip, a title and a one-line summary,
 * and the whole card is the link.
 */
interface Resource {
  category: string;
  isNew: boolean;
  title: string;
  desc: string;
  href: string;
}

const resources: Resource[] = [
  {
    category: "Case study",
    isNew: true,
    title:
      "How a Leading Sportswear Brand Unified Two ERPs for Belgium e-Invoicing",
    desc: "With ClearTax, both channels went live on time, with automated invoice processing, PEPPOL compliance across both systems, and zero disruption to store or online sales.",
    href: "https://files.clear.in/JIrK3NCuo7n",
  },
  {
    category: "Blog",
    isNew: true,
    title:
      "Spain E-invoicing Mandate: Requirements, Timeline, Format and Penalties",
    desc: "Spain's B2B e-invoicing mandate introduces domestic electronic invoice exchange in phases starting October 2027.",
    href: "https://www.cleartax.com/es/en/e-invoicing-spain",
  },
  {
    category: "Blog",
    isNew: true,
    title:
      "SII in Spain: What It Is, Who Must Comply, and How It Works",
    desc: "SII is an electronic VAT ledger reporting platform by Spain’s tax authority, AEAT. Businesses must submit their VAT invoice records electronically to SII.",
    href: "https://www.cleartax.com/es/en/suministro-de-informacion-inmediata-sii-in-spain",
  },
  {
    category: "Whitepaper",
    isNew: true,
    title: "Two Mandates, One Job: How Spain Is Building Europe's Tightest Tax and Payment Grid",
    desc: "Spain's overlapping invoice rules look fragmented in isolation. From the state's point of view, each layer closes a gap the last one couldn't see.",
    href: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf56812ba8d41d02ca2933_Two%20mandates%2C%20ONE%20JOB_WEBSITE.pdf",
  },
  {
    category: "Whitepaper",
    isNew: true,
    title: "Let's Separate Fact From Fiction: 12 Myths & 12 Realities of Spain e-Invoicing",
    desc: "Finance leaders must challenge these myths about Crea y Crece B2B e-invoicing before they become compliance gaps.",
    href: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf56811938d91e8689be1f_myth%20vs%20fact%20asset_website.pdf",
  },
  {
    category: "Whitepaper",
    isNew: true,
    title: "The Full ViDA Picture: A Strategic Opportunity for EU Finance Leaders",
    desc: "What CFOs and tax heads across the EU need to look beyond the format change, and where the real exposure lies.",
    href: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf5682d9bc407e79d0512f_VIDA%20picture_ln.pdf",
  },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6">
    <h2
      class="m-0 mb-8 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] lg:mb-12"
    >
      Spain e-Invoicing resource centre
    </h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        resources.map((r) => (
          <a
            href={r.href}
            class="flex flex-col gap-4 rounded-xl border border-neutral-300 bg-generic-00 p-6 no-underline transition-all duration-200 ease-in-out hover:border-nova-blue"
          >
            <div class="flex items-start justify-between gap-3">
              <span class="inline-flex items-center justify-center rounded-lg bg-neutral-100 px-3 py-1.5 font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-neutral-700">
                {r.category}
              </span>
              {r.isNew && (
                <span class="inline-flex items-center justify-center rounded-lg bg-nova-blue px-3 py-1.5 font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-generic-00">
                  New
                </span>
              )}
            </div>

            <div class="flex flex-col gap-2.5">
              <h3 class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                {r.title}
              </h3>
              <p class="m-0 line-clamp-3 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                {r.desc}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
