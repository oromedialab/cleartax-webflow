---
/**
 * "VAT Assurance: SII Reporting Done Right" — Figma node 15121:30519
 * ("Fold 4 B"). Unique to this page — no France/Oman/UAE equivalent.
 *
 * Heading + sub-heading, then a static 2x2 grid of icon + statement rows (no
 * click-to-expand, unlike `Supports.astro` — the Figma cards here carry no plus
 * icon).
 *
 * The icon squares are unfilled "Icon placeholder" frames in the Figma, so they
 * render as `bg-visual-placeholder` blocks — #E8FFE1, the fill the design uses.
 * Swap each for a Webflow-hosted URL when the artwork lands — never a `data:`
 * URI.
 *
 * Ids are `sp-assurance-` prefixed: embeds share one namespace per page.
 */
interface Row {
  statement: string;
  icon: string;
}

const rows: Row[] = [
  {
    statement: "Checks invoice data mismatches across counterparties",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac776ffe44a0b1c366708b9_icon-9.png",
  },
  {
    statement: "Finds purchase ledger gaps against SII records",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac777036dc6526aa10747e2_icon-10.png",
  },
  {
    statement: "Compiles missing acceptance, rejection, or payment status",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac77707c8fc165710ce5e54_icon-11.png",
  },
  {
    statement: "Provides audit exposure from unresolved VAT discrepancies",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac7770dc8fc165710ce6173_icon-12.png",
  },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div
    class="min-[1400px]:container w-full px-4 md:px-6 mx-auto flex flex-col items-center gap-12"
  >
    <div class="flex flex-col items-center gap-3 text-center max-w-[750px]">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        VAT Assurance: SII Reporting Done Right
      </h2>
      <p
        class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
      >
        ClearTax Finds Compliance Gaps Before AEAT Does
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
      {
        rows.map((row) => (
          <div class="sp-assurance-card flex items-center gap-4 rounded-xl border-2 border-neutral-300 bg-generic-00 p-8">
            <img
              src={row.icon}
              class="block h-8 w-8 shrink-0 rounded-[5px]"
              width={32}
              height={32}
            />
            <p class="m-0 font-heading font-medium text-vault-navy text-[16px] leading-6 md:text-[length:var(--fs-h6)] md:leading-[length:var(--lh-h6)]">
              {row.statement}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
