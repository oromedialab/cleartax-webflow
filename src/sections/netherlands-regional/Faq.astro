---
/**
 * FAQ for the KSA regional page — Figma node 18377:74883 ("FAQ"). The
 * paste unit.
 *
 * Structure, styling and behaviour live in `_shared/FaqRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file,
 * because the embed route renders sections with no props.
 *
 * The Figma has no subtitle under the heading, so an empty one is passed —
 * `FaqRb` omits the paragraph when it is empty. Seven questions, first open,
 * the last two behind "Load more" after five — the primitive's standard
 * behaviour, and the "Load more" button the Figma draws.
 */
import FaqRb from "../_shared/FaqRb.astro";
import type { FaqItem } from "../_shared/FaqRb.astro";

const items: FaqItem[] = [
    {
        q: "Is e-invoicing mandatory in Ireland?",
        a: [
            {
                kind: "p",
                html: "Not yet for B2B, but it's coming. From 1 November 2028, large corporates must issue e-invoices and report to Revenue for domestic B2B sales, and every VAT-registered business must be able to receive them. Today, only public bodies are required to accept e-invoices.",
            },
        ],
    },
    {
        q: "Who is in scope for Phase One?",
        a: [
            {
                kind: "p",
                html: "VAT-registered businesses whose tax affairs are managed by Revenue's Large Corporates Division and that are established, or have a fixed establishment, in Ireland. There is no turnover threshold. Revenue is writing to these businesses to confirm their inclusion.",
            },
        ],
    },
    {
        q: "What happens in 2029 and 2030?",
        a: [
            {
                kind: "p",
                html: "From November 2029, the planned domestic B2B e-invoicing and reporting obligation extends to VAT-registered businesses engaged in cross-border EU B2B trade subject to zero-rate VAT arrangements. From 1 July 2030, EU ViDA rules require e-invoicing and digital reporting for cross-border B2B supplies.",
            },
        ],
    },
    {
        q: "What format must Irish e-invoices use?",
        a: [
            {
                kind: "p",
                html: "A structured format that complies with EN 16931, in practice Peppol BIS Billing 3.0 in UBL XML, exchanged through a Peppol Access Point. A PDF or scanned invoice won't count.",
            },
        ],
    },
    {
        q: "Do I need to report invoices to Revenue?",
        a: [
            {
                kind: "p",
                html: "Yes, if you're in scope. Businesses issuing e-invoices must report a subset of invoice data to Revenue in near real time. Revenue will publish the data fields and technical specifications before each phase.",
            },
        ],
    },
    {
        q: "What are the penalties for non-compliance?",
        a: [
            {
                kind: "p",
                html: "E-invoicing specific penalties will be set in the enabling legislation. Today, fixed penalties of up to €4,000 apply to VAT invoicing and record-keeping failures, plus interest and tax-geared penalties on incorrect returns.",
            },
        ],
    },
    {
        q: "How long must e-invoices be kept?",
        a: [
            {
                kind: "p",
                html: "Generally six years under Irish VAT law. Keep the original structured file, not just a PDF copy.",
            },
        ],
    },
    {
        q: "How do I choose the right e-invoicing software for Ireland?",
        a: [
            {
                kind: "p",
                html: "Look for a Peppol Access Point that integrates with your ERP, validates invoices before sending, receives incoming invoices, archives them and has a clear plan for Revenue's real-time reporting. If you operate in several countries, one platform for all mandates cuts long-term cost.",
            },
        ],
    },
];
---

<FaqRb items={items} subtitle="" />
