---
/**
 * FAQ for the Netherlands regional page.
 *
 * Structure, styling and behaviour live in `_shared/FaqRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file,
 * because the embed route renders sections with no props.
 *
 * The Figma has no subtitle under the heading, so an empty one is passed —
 * `FaqRb` omits the paragraph when it is empty.
 */
import FaqRb from "../_shared/FaqRb.astro";
import type { FaqItem } from "../_shared/FaqRb.astro";

const items: FaqItem[] = [
    {
        q: "Is e-invoicing mandatory in the Netherlands?",
        a: [
            {
                kind: "p",
                html: "It is required when supplying goods or services to the Dutch central government. No general domestic B2B structured e-invoicing mandate is currently in force. The cabinet plans domestic B2B e-invoicing from July 2030 and domestic reporting from July 2031, subject to legislation and applicable exclusions.",
            },
        ],
    },
    {
        q: "Do all Dutch public-sector suppliers have to send e-invoices?",
        a: [
            {
                kind: "p",
                html: "The public sector's obligation to receive e-invoices is not the same as a blanket obligation for suppliers. Since April 2019, all contracting authorities must be able to receive and process EN 16931 invoices. Check the sending requirements in your buyer's procurement terms.",
            },
        ],
    },
    {
        q: "Is a PDF a structured e-invoice?",
        a: [
            {
                kind: "p",
                html: "No. An emailed PDF alone is not a structured e-invoice that the receiving system can process automatically. Ordinary B2B VAT invoicing rules still permit paper or digital invoicing today, so this distinction should not be read as a blanket ban on PDF invoices.",
            },
        ],
    },
    {
        q: "What are NLCIUS and Peppol BIS 3?",
        a: [
            {
                kind: "p",
                html: "NLCIUS is the Dutch supplementary specification to EN 16931. Peppol BIS 3 is another standard listed in Dutch central-government documentation. Your invoice format and delivery route need to match what the receiving organisation accepts.",
            },
        ],
    },
    {
        q: "Is Peppol the only way to invoice Dutch central government?",
        a: [
            {
                kind: "p",
                html: "No. Peppol is the preferred route, but direct Digipoort submission and the supplier portal are alternatives. Confirm the appropriate route for your customer and invoice flow.",
            },
        ],
    },
    {
        q: "Who governs Peppol in the Netherlands?",
        a: [
            {
                kind: "p",
                html: "The Netherlands Peppol Authority safeguards the quality and reliability of the Dutch Peppol framework. Logius performs the authority's tasks. Verify provider authorisation and the Netherlands scope separately.",
            },
        ],
    },
    {
        q: "How do I go live with ERP integration without disruption?",
        a: [
            {
                kind: "p",
                html: "ClearTax converts ERP invoice data into the required structured formats. It uses pre-built connectors for SAP, Oracle, Microsoft Dynamics, NetSuite, Sage, and 60+ other systems. No disruption to your existing AP and AR workflows.",
            },
        ],
    },
    {
        q: "Does ClearTax integrate with SAP, Microsoft Dynamics and other ERPs?",
        a: [
            {
                kind: "p",
                html: "Yes. ClearTax integrates with SAP, Microsoft Dynamics, Oracle, NetSuite and other ERP systems through standard connectors and the ClearTax API. This allows businesses to automate e-invoicing without replacing their existing ERP.",
            },
        ],
    },
    {
        q: "Can ClearTax handle e-invoicing for multi-entity or cross-border B2B operations?",
        a: [
            {
                kind: "p",
                html: "ClearTax's global e-invoicing platform supports businesses operating across multiple entities and countries. It applies Spain's compliance requirements while helping standardise e-invoicing across different jurisdictions.",
            },
        ],
    },
    {
        q: "What are the advantages of using ClearTax for e-invoicing in the Netherlands?",
        a: [
            {
                kind: "p",
                html: "ClearTax is an e-invoicing solution provider that goes beyond compliance. It offers a single API for multiple jurisdictions, country-specific configurations with pre-built workflows, a unified dashboard for complete visibility, and an in-house team of tax experts to help you navigate changing regulations with confidence. Instead of managing multiple tools, businesses can handle Spain's e-invoicing requirements through a single solution.",
            },
        ],
    },
    {
        q: "Which e-invoice formats does ClearTax support for the Netherlands?",
        a: [
            {
                kind: "p",
                html: "ClearTax supports all mandatory B2B syntaxes under RD 238/2026: UBL, Facturae (B2G via FACe, and accepted during the B2B transition), CII, and EDIFACT. The platform handles format conversion and validation, so businesses don't have to manually manage multiple invoice standards.",
            },
        ],
    },
    {
        q: "How should I evaluate a Netherlands e-invoicing solution?",
        a: [
            {
                kind: "p",
                html: "Check your buyers' accepted standards and channels, the provider's authorisation, ERP connection options, validation, sending and receiving scope, exception handling and access to invoice records. Ask for evidence of Netherlands-specific functionality before relying on a country-coverage claim.",
            },
        ],
    },
];
---

<FaqRb items={items} subtitle="" />
