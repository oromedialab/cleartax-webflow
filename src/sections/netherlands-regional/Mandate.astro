---
/**
 * "Saudi Arabia e-invoicing at a glance" — Figma node 18377:72678. Heading and lede,
 * then a 2x2 grid of cards that each carry a plus control.
 *
 * A card is a button: clicking it opens ONE overlay dialog showing that card's
 * heading and body, with prev/next chevrons to walk the other three without
 * closing. Pattern and mechanics copied from `spain-regional/Supports.astro`;
 * the overlay renders its layout once and swaps only the heading / body /
 * visual that differ per card.
 *
 * The Figma shows the cards collapsed only, so the body copy is drafted from the
 * FAQ and steps on this page. Review with content before staging.
 *
 * The card icons and the overlay visual are unfilled placeholder frames in the
 * Figma, so they render as `bg-visual-placeholder` (#E8FFE1). Swap for
 * Webflow-hosted artwork when it lands — never a `data:` URI.
 *
 * Ids and data attributes are `nl-glance-` prefixed: embeds share one
 * namespace per page.
 */
interface Card {
    heading: string;
    body: string;
    img: string;
}

const cards: Card[] = [
    {
        heading: "Structured invoices, not just PDFs",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aec914d818a73f351a82eae_icon-1.png",
        body: "A structured e-invoice contains data that the receiving system can process automatically. Digital invoicing requires recipient acceptance and safeguards for authenticity of origin, integrity of content and readability. An emailed PDF alone is not a structured e-invoice. That does not mean PDFs are invalid for every ordinary B2B VAT invoice today: the general invoicing rules still allow paper or digital invoices.",
    },
    {
        heading: "Dutch standards. European interoperability.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aec915655c134dbd70edcc4_icon-2.png",
        body: "NLCIUS adds Dutch specifications to the European EN 16931 standard. Dutch central-government documentation lists Peppol BIS 3, NLCIUS and UBL-OHNL among supported standards. They are not interchangeable across every route: UBL-OHNL applies to a direct Digipoort connection. Confirm the format accepted by your buyer and delivery channel. The right format depends on the receiving organisation and the delivery route you use.",
    },
    {
        heading: "Peppol is preferred, with mutually agreed routes",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac7769ec663aaac1dd24ceb_icon-1.png",
        body: "Dutch central government prefers to receive invoices through Peppol. Direct Digipoort submission and the supplier portal are alternative routes. Confirm your customer’s requirements before deciding how to connect.",
    },
    {
        heading: "Network governance and provider checks",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aec9160bfe8cda504112c2f_icon-4.png",
        body: "The Netherlands Peppol Authority safeguards the quality and reliability of the Dutch Peppol framework, with Logius performing these tasks. When evaluating a provider, request evidence of its Peppol credentials and confirm support for your required Dutch invoice formats and workflows. ",
    },
];
---

<section class="bg-generic-00 pt-16 pb-12 lg:pt-20">
    <div
        class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12"
    >
        <div class="flex flex-col items-center gap-6 text-center">
            <h2
                class="m-0 font-heading max-w-200s font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
            >
                Netherlands e-invoicing at a glance
            </h2>
            <p
                class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] max-w-200"
            >
                Suppliers must submit electronic invoices under new procurement
                agreements with the Dutch central government from 1 January
                2017. Since 18 April 2019, all contracting authorities must also
                be able to receive and process invoices in the European EN 16931
                format.
            </p>
        </div>

        <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-8">
            {
                cards.map((card, i) => (
                    <button
                        type="button"
                        class="group m-0 flex h-full w-full cursor-pointer items-center justify-between gap-3 sm:gap-4 md:gap-5 rounded-xl border border-neutral-300 bg-generic-00 p-4 sm:p-5 md:p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue"
                        aria-haspopup="dialog"
                        data-nl-glance-open
                        data-nl-glance-index={i}
                    >
                        <img
                            src={card.img}
                            alt=""
                            width="56"
                            height="56"
                            class="block h-12 w-12 sm:h-14 sm:w-14 shrink-0 rounded-lg object-contain"
                            loading="lazy"
                            decoding="async"
                        />
                        <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)] md:text-[length:var(--fs-body-lg)] md:leading-[length:var(--lh-body-lg)] lg:text-[length:var(--fs-h6)] lg:leading-[length:var(--lh-h6)]">
                            {card.heading}
                        </span>
                        <span
                            class="ml-auto flex h-10 w-10 sm:h-12 sm:w-12 lg:h-14 lg:w-14 shrink-0 items-center justify-center rounded-lg p-1.5 sm:p-2 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
                            aria-hidden="true"
                        >
                            <svg
                                class="h-6 w-6 sm:h-8 sm:w-8 lg:h-10 lg:w-10"
                                viewBox="0 0 40 40"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20 10V30"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                                <path
                                    d="M30 20L10 20"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </span>
                    </button>
                ))
            }
        </div>
    </div>
</section>

<!-- Detail overlay. Lives outside the section's container so the scrim covers
     the viewport rather than the 1280px column. -->
<div
    id="nl-glance-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="nl-glance-overlay-title"
    aria-hidden="true"
    class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
>
    <div
        class="relative max-h-[90vh] w-full max-w-[1280px] overflow-y-auto rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6"
        data-nl-glance-panel
    >
        <button
            type="button"
            aria-label="Close"
            class="absolute right-6 top-6 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-11 lg:top-11"
            data-nl-glance-close
        >
            <svg
                width="40"
                height="40"
                viewBox="0 0 40 40"
                fill="none"
                class="rotate-45"
                aria-hidden="true"
                focusable="false"
            >
                <path
                    d="M20 10V30"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                <path
                    d="M30 20L10 20"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </button>

        <div class="flex flex-col items-start gap-6 lg:flex-row lg:gap-12">
            <div
                class="flex w-full flex-col justify-between gap-6 lg:w-[416px] lg:shrink-0 lg:self-stretch"
            >
                <div class="flex flex-col gap-6">
                    <div class="h-16 w-16 shrink-0">
                        {
                            cards.map((card, i) => (
                                <img
                                    src={card.img}
                                    alt=""
                                    width="64"
                                    height="64"
                                    class="h-16 w-16 rounded-lg object-contain"
                                    style={
                                        i === 0
                                            ? "display: block;"
                                            : "display: none;"
                                    }
                                    hidden={i !== 0}
                                    data-nl-glance-icon
                                    loading="lazy"
                                    decoding="async"
                                />
                            ))
                        }
                    </div>
                    <div id="nl-glance-overlay-title">
                        {
                            cards.map((card, i) => (
                                <h3
                                    class="m-0 pr-12 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px] lg:pr-0"
                                    hidden={i !== 0}
                                    data-nl-glance-heading
                                >
                                    {card.heading}
                                </h3>
                            ))
                        }
                    </div>
                </div>

                <div class="flex flex-col gap-6">
                    <div>
                        {
                            cards.map((card, i) => (
                                <p
                                    class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                                    hidden={i !== 0}
                                    data-nl-glance-body
                                >
                                    {card.body}
                                </p>
                            ))
                        }
                    </div>

                    <div class="flex items-center gap-2">
                        <button
                            type="button"
                            aria-label="Previous"
                            aria-controls="nl-glance-overlay-title"
                            class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue"
                            data-nl-glance-prev
                        >
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 20 20"
                                fill="none"
                                aria-hidden="true"
                                focusable="false"
                            >
                                <path
                                    d="M12 15L7 10L12 5"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"></path>
                            </svg>
                        </button>
                        <button
                            type="button"
                            aria-label="Next"
                            aria-controls="nl-glance-overlay-title"
                            class="inline-flex cursor-pointer items-center justify-center rounded border border-neutral-300 bg-generic-00 p-2 text-vault-navy transition-colors duration-150 hover:border-nova-blue"
                            data-nl-glance-next
                        >
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 20 20"
                                fill="none"
                                aria-hidden="true"
                                focusable="false"
                            >
                                <path
                                    d="M7 5L12 10L7 15"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <div
                class="aspect-[1280/720] w-full rounded-lg overflow-hidden bg-visual-placeholder lg:w-auto lg:flex-1"
            >
                {
                    cards.map((card, i) => (
                        <div
                            class="h-full w-full bg-visual-placeholder"
                            style={
                                i === 0 ? "display: block;" : "display: none;"
                            }
                            hidden={i !== 0}
                            data-nl-glance-image
                            aria-hidden="true"
                        />
                    ))
                }
            </div>
        </div>
    </div>
</div>

<style is:global>
    [data-nl-glance-icon][hidden],
    [data-nl-glance-image][hidden] {
        display: none !important;
    }
</style>

<script is:inline>
    /* Card -> detail overlay, with the chevrons walking the eight without closing. */
    (function () {
        var overlay = document.getElementById("nl-glance-overlay");
        if (!overlay) return;

        var panel = overlay.querySelector("[data-nl-glance-panel]");
        var closeBtn = overlay.querySelector("[data-nl-glance-close]");
        var prevBtn = overlay.querySelector("[data-nl-glance-prev]");
        var nextBtn = overlay.querySelector("[data-nl-glance-next]");
        var headings = overlay.querySelectorAll("[data-nl-glance-heading]");
        var bodies = overlay.querySelectorAll("[data-nl-glance-body]");
        var icons = overlay.querySelectorAll("[data-nl-glance-icon]");
        var images = overlay.querySelectorAll("[data-nl-glance-image]");
        if (!panel || !headings.length || headings.length !== bodies.length)
            return;

        var count = headings.length;
        var current = 0;
        var lastFocused = null;

        function show(index) {
            current = ((index % count) + count) % count;
            for (var i = 0; i < count; i++) {
                headings[i].hidden = i !== current;
                bodies[i].hidden = i !== current;
                if (icons[i]) {
                    icons[i].hidden = i !== current;
                    icons[i].style.display = i === current ? "block" : "none";
                }
                if (images[i]) {
                    images[i].hidden = i !== current;
                    images[i].style.display = i === current ? "block" : "none";
                }
            }
            panel.scrollTop = 0;
        }

        function open(index, opener) {
            lastFocused = opener || document.activeElement;
            show(index);
            overlay.style.display = "flex";
            overlay.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
            if (closeBtn) closeBtn.focus();
        }

        function close() {
            overlay.style.display = "none";
            overlay.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
            if (lastFocused && lastFocused.focus) lastFocused.focus();
        }

        function isOpen() {
            return overlay.style.display === "flex";
        }

        document.addEventListener("click", function (e) {
            if (!e.target.closest) return;
            var opener = e.target.closest("[data-nl-glance-open]");
            if (!opener) return;
            open(
                parseInt(opener.getAttribute("data-nl-glance-index"), 10) || 0,
                opener,
            );
        });

        if (closeBtn) closeBtn.addEventListener("click", close);
        if (prevBtn)
            prevBtn.addEventListener("click", function () {
                show(current - 1);
            });
        if (nextBtn)
            nextBtn.addEventListener("click", function () {
                show(current + 1);
            });

        overlay.addEventListener("click", function (e) {
            if (e.target === overlay) close();
        });

        document.addEventListener("keydown", function (e) {
            if (!isOpen()) return;

            if (e.key === "Escape") {
                close();
                return;
            }

            if (e.key === "ArrowLeft") {
                show(current - 1);
                return;
            }
            if (e.key === "ArrowRight") {
                show(current + 1);
                return;
            }

            if (e.key !== "Tab") return;
            var focusable = panel.querySelectorAll(
                'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
            );
            if (!focusable.length) return;
            var first = focusable[0];
            var last = focusable[focusable.length - 1];

            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });
    })();
</script>
