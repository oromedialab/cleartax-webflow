    >
    </div>

    <div class="container mx-auto relative z-10">
        <div
            class="flex flex-col items-center gap-6 text-center max-lg:pt-32 max-lg:pb-16 lg:pt-[257px] lg:pb-[177px]"
        >
            <div class="flex flex-col items-center gap-8 w-full">
                <div class="flex flex-col items-center gap-4">
                    <h1
                        class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h1)] md:text-[length:var(--fs-display-sm)] lg:text-[length:var(--fs-display-lg)] leading-[length:var(--lh-h1)] md:leading-[length:var(--lh-display-sm)] lg:leading-[length:var(--lh-display-lg)] tracking-[-1px] max-w-195"
                    >
                        Netherlands <span
                            class="inline-block text-generic-100 bg-flux-lime py-1 px-[13px] rounded-xl"
