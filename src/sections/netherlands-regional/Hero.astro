           absent, onclick lets the browser follow the href as normal. -->
            <a
                href="javascript:void(0)"
                onclick="document.getElementById('contactForm').scrollIntoView({behavior:'smooth'})"
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-50 no-underline transition-all duration-200 hover:bg-generic-00 hover:text-nova-blue"
