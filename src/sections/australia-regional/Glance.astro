---
/**
 * "Get Peppol-ready in Australia in 5 steps"
 *
 * Implements sticky horizontal scroll container matching ERPintegration specs:
 * - Section pins to viewport as reader scrolls down the page
 * - Translates horizontal track smoothly across the 5 implementation step cards
 * - Purple connecting progress line connects all cards together and fills dynamically with scroll progress
 */

interface Step {
    number: number;
    title: string;
    bullets: string[];
}

const steps: Step[] = [
    {
        number: 1,
        title: "Internal assessment",
        bullets: [
            "List the government agencies and large customers you invoice, and check which are already on the Peppol directory.",
            "Map invoice volumes, entities, ABNs and every ERP or billing system that issues or receives invoices.",
            "Review IT and finance bandwidth for integration work.",
        ],
    },
    {
        number: 2,
        title: "Platform and vendor shortlisting (RFP)",
        bullets: [
            "Decide on platform type: an Australia-only Peppol connector, or a global vendor that covers Australia and your mandatory countries in one place.",
            "Confirm the provider is an ATO-accredited Peppol Access Point supporting PINT A-NZ.",
            "Run demos, proof-of-concept tests and reference checks.",
        ],
    },
    {
        number: 3,
        title: "Data readiness review",
        bullets: [
            "Validate PINT A-NZ and GST tax invoice fields against your ERP data.",
            "Clean customer and supplier master data, especially ABNs.",
            "Register each ABN as a Peppol participant ID.",
        ],
    },
    {
        number: 4,
        title: "Integration and testing",
        bullets: [
            "Connect your ERP or accounting system to the platform.",
            "Test send and receive flows, validation, approvals and archiving end to end.",
        ],
    },
    {
        number: 5,
        title: "Customer and supplier enablement",
        bullets: [
            "Start with government buyers and your largest customers to get paid faster.",
            "Invite suppliers to send e-invoices so your AP team can stop keying in PDFs.",
        ],
    },
];
---

<div class="au-glance-sticky-container bg-generic-00 relative">
    <section
        class="sticky top-0 flex flex-col justify-center bg-generic-00 py-12 md:py-16 xl:py-20 overflow-hidden min-h-[calc(100vh-80px)]"
        id="au-glance"
    >
        <div class="max-w-[var(--container-max)] mx-auto w-full px-4 md:px-6">
            <!-- Header -->
            <div class="au-glance-header-wrapper text-center mx-auto mb-8 md:mb-12 max-w-3xl">
                <h2
                    class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px] mb-3 sm:mb-4"
                >
                    Get Peppol-ready in Australia in 5 steps
                </h2>
                <p
                    class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)]"
                >
                    Whether a government buyer has asked you to switch or you want to cut AP costs,
                    these steps get you sending and receiving e-invoices without disrupting your ERP.
                </p>
            </div>

            <!-- Cards Track with Connecting Progress Line -->
            <div class="w-full h-auto relative">
                <div
                    class="au-glance-scroll-track flex items-stretch gap-6 md:gap-8 w-max transition-transform duration-[200ms] ease-out will-change-transform relative py-2"
                >
                    <!-- Connecting Progress Line between the cards -->
                    <div
                        class="hidden md:block absolute top-[160px] left-16 right-16 h-[2.5px] bg-neutral-200 z-0 pointer-events-none rounded-full overflow-hidden"
                        aria-hidden="true"
                    >
                        <div
                            class="au-glance-progress-fill h-full bg-nova-blue rounded-full transition-all duration-150 ease-out"
                            style="width: 10%;"
                        ></div>
                    </div>

                    <!-- 5 Implementation Step Cards -->
                    {
                        steps.map((step) => (
                            <div
                                class="au-glance-card-item relative z-10 w-[320px] sm:w-[360px] md:w-[380px] lg:w-[478px] shrink-0 rounded-2xl border border-neutral-300 bg-generic-00 flex flex-col justify-start min-h-[317px] select-none overflow-hidden transition-all duration-200"
                            >
                                <!-- Card Header (spans full width above divider) -->
                                <div class="p-6 pb-6 border-b border-neutral-200 bg-generic-00 w-full">
                                    <!-- Step Badge -->
                                    <div class="w-8 h-8 rounded-lg border border-neutral-300 flex items-center justify-center font-heading font-medium text-neutral-500 text-[length:var(--fs-body-xs)] leading-[length:var(--lh-body-xs)] shrink-0 bg-[#FBFBFC]">
                                        {step.number}
                                    </div>

                                    <!-- Step Title (16px margin from top number, 20px font size) -->
                                    <h3 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] mt-4 min-h-[24px]">
                                        {step.title}
                                    </h3>
                                </div>

                                <!-- Card Body: Bullet Points (14px font size) -->
                                <div class="p-6 pt-6 flex-1 flex flex-col w-full">
                                    <ul class="m-0 p-0 list-none space-y-4 flex-1">
                                        {step.bullets.map((bullet) => (
                                            <li class="flex items-start gap-2.5 font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                                                <span class="w-1 h-1 rounded-full bg-neutral-400 shrink-0 mt-2" aria-hidden="true"></span>
                                                <span>{bullet}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>
</div>

<style is:global>
    @media (max-height: 750px) {
        .au-glance-sticky-container section {
            padding-top: var(--spacing-big, 1.25rem) !important;
            padding-bottom: var(--spacing-big, 1.25rem) !important;
        }
        .au-glance-header-wrapper {
            margin-bottom: var(--spacing-md, 1rem) !important;
        }
        .au-glance-card-item {
            min-height: 315px !important;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const containers = document.querySelectorAll(".au-glance-sticky-container");
        if (!containers.length) return;

        containers.forEach((container) => {
            const track = container.querySelector(".au-glance-scroll-track");
            const section = container.querySelector("section");
            const progressFill = container.querySelector(".au-glance-progress-fill");
            if (!container || !track || !section) return;

            const getHeaderHeight = () => {
                const header = document.querySelector("header, .navbar, .w-nav");
                return header ? header.offsetHeight : 80;
            };

            let maxTranslate = 0;
            let totalScrollable = 0;
            let stickyTop = 0;

            const updateMeasurements = () => {
                const sectionHeight = section.offsetHeight;
                const windowHeight = window.innerHeight;
                const headerHeight = getHeaderHeight();

                const trackOffset =
                    track.parentElement.getBoundingClientRect().top -
                    section.getBoundingClientRect().top;
                const trackHeight = track.offsetHeight;
                const availableSpace = windowHeight - headerHeight;

                const idealTrackTop =
                    headerHeight + Math.max(40, (availableSpace - trackHeight) / 2);
                let calculatedTop = idealTrackTop - trackOffset;

                stickyTop = Math.min(headerHeight, calculatedTop);
                section.style.top = `${stickyTop}px`;

                const containerWidth =
                    track.parentElement.getBoundingClientRect().width;
                maxTranslate = Math.max(0, track.scrollWidth - containerWidth);
                container.style.height = `${maxTranslate + windowHeight}px`;
                totalScrollable =
                    container.getBoundingClientRect().height - sectionHeight;
            };

            updateMeasurements();

            if (window.ResizeObserver) {
                const ro = new ResizeObserver(updateMeasurements);
                ro.observe(section);
                ro.observe(track);
            }
            window.addEventListener("resize", updateMeasurements);

            let ticking = false;

            const handleScroll = () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const containerRect = container.getBoundingClientRect();
                        const scrolledDistance = Math.max(
                            0,
                            stickyTop - containerRect.top
                        );

                        let progress =
                            totalScrollable > 0
                                ? scrolledDistance / totalScrollable
                                : 0;
                        progress = Math.max(0, Math.min(1, progress));

                        track.style.transform = `translate3d(-${progress * maxTranslate}px, 0, 0)`;

                        if (progressFill) {
                            // Progress bar fills proportionally from 10% to 100% as you scroll through all 5 cards
                            const fillPercent = 10 + progress * 90;
                            progressFill.style.width = `${fillPercent}%`;
                        }

                        ticking = false;
                    });
                    ticking = true;
                }
            };

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            window.addEventListener("scroll", handleScroll, {
                                passive: true,
                            });
                            handleScroll();
                        } else {
                            window.removeEventListener("scroll", handleScroll);
                        }
                    });
                },
                {
                    rootMargin: "100% 0px 100% 0px",
                }
            );

            observer.observe(container);
        });
    });
</script>
