---
/**
 * "Build your Norway e-invoicing solution for 2027 and 2030." — Figma node
 * 17103:85017 ("Fold 9").
 *
 * A 2-column grid of 5 feature cards, the last spanning both columns. Each
 * card is an accordion that expands inline to reveal an image placeholder
 * and body text. First 4 cards sit in a 2×2 grid at equal size; the 5th
 * card spans both columns at full width.
 *
 * All cards are collapsed by default. Clicking a card toggles it open/closed.
 * The plus icon rotates to a minus when open.
 *
 * Ids are `no-features-` prefixed: embeds share one namespace per page.
 */
interface Feature {
    title: string;
    body: string;
    image: string;
    span2?: boolean;
}

const features: Feature[] = [
    {
        title: "Send and receive on Peppol",
        body: "Exchange PINT A-NZ invoices and credit notes with any business or government agency on the Peppol network through our Access Point accredited to operate in Australia. Your ABN is registered once, and archiving runs in the same flow.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aeb054643bdbad5546a7c72_img-1-1.png",
    },
    {
        title: "Get paid faster by government",
        body: "Send e-invoices to Peppol-enabled government agencies; under the current policy, eligible e-invoices to non-corporate Commonwealth entities have a 5-calendar-day payment term once the policy conditions are met. Track each invoice from sent to paid, so AR knows what's coming in.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aeb054be039cc0010ee04a6_img-1-2.png",
    },
    {
        title: "Catch errors before your buyer does",
        body: "AI-powered checks validate every PINT A-NZ field, ABN and GST value before an invoice leaves your ERP. Fewer rejections, fewer disputes and faster payments.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aeb054e5bc091391441ea98_img-1-3.png",
    },
    {
        title: "AP that runs itself",
        body: "Receive supplier e-invoices, match them to purchase orders and post them to your ERP without keying anything in. Approval workflows and a single dashboard show what's stuck and why, before month-end close.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aeb05525bc091391441ec27_img-1-4.png",
    },
    {
        title: "Integrates with any ERP or POS",
        body: "2,500+ integrations across 50+ ERP and POS systems, including SAP, Oracle, Microsoft Dynamics and NetSuite. AI-driven connectors and structured UAT cut onboarding from weeks to days.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aeb055619845c93e37fe0c7_img-1-5.png",
    },
    {
        title: "Australia today. Every mandate you face next.",
        body: "One platform and one API for 50+ countries. Your Australian entities reuse the same integration as your entities in the EU, the Middle East and Asia, where e-invoicing is already mandatory.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aeb05595e78e57bc02991e4_img-1-6.png",
    },
    {
        title: "Clean books and expert support",
        body: "Automated reconciliation across invoice, books and GST data keeps your records clean. A dedicated success manager, 750+ integration engineers and in-house tax experts back you from planning to go-live and beyond.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aeb055d05e0096f9cfa83a3_img-1-7.png",
        span2: true,
    },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
    <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6">
        <div
            class="mx-auto mb-8 flex flex-col items-center gap-4 text-center lg:mb-12"
        >
            <h2
                class="m-0 max-w-141 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
            >
                How ClearTax gets you on Peppol in Australia
            </h2>
            <p
                class="m-0 max-w-147 font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500"
            >
                One Peppol platform to create, validate, send, receive and
                archive every invoice, connected to your ERP and the rest of
                your global footprint.
            </p>
        </div>

        {
            /* Two independent columns so expanding one card doesn't push the adjacent column */
        }
        <div class="flex flex-col gap-6 md:flex-row">
            {/* Left column: cards 0, 2, 4 */}
            <div class="flex flex-1 flex-col gap-6">
                {
                    features
                        .filter((f) => !f.span2)
                        .filter((_, idx) => idx % 2 === 0)
                        .map((f) => {
                            const i = features.indexOf(f);
                            const isDefaultOpen = i === 0;
                            return (
                                <div
                                    class="flex flex-col"
                                    data-no-features-card={i}
                                >
                                    <button
                                        type="button"
                                        class={`group flex w-full cursor-pointer items-center justify-between gap-6 rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out ${isDefaultOpen ? "rounded-b-none" : ""}`}
                                        data-no-features-toggle={i}
                                        aria-expanded={
                                            isDefaultOpen ? "true" : "false"
                                        }
                                    >
                                        <span class="font-heading text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium text-vault-navy">
                                            {f.title}
                                        </span>
                                        <svg
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            class="shrink-0 text-vault-navy transition-colors duration-150 ease-in-out"
                                            aria-hidden="true"
                                            focusable="false"
                                            data-no-features-icon={i}
                                            style={
                                                isDefaultOpen
                                                    ? "transform: rotate(180deg);"
                                                    : ""
                                            }
                                        >
                                            <path
                                                d="M5 12H19"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            />
                                            <path
                                                d="M12 5V19"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                data-no-features-vertical={i}
                                                style={
                                                    isDefaultOpen
                                                        ? "opacity: 0;"
                                                        : "opacity: 1;"
                                                }
                                            />
                                        </svg>
                                    </button>
                                    <div
                                        class="grid overflow-hidden rounded-b-xl border border-t-0 border-neutral-300 bg-generic-00 transition-[grid-template-rows,opacity,border-color] duration-300 ease-in-out"
                                        style={
                                            isDefaultOpen
                                                ? "grid-template-rows: 1fr; opacity: 1;"
                                                : "grid-template-rows: 0fr; opacity: 0; border-color: transparent;"
                                        }
                                        data-no-features-content={i}
                                        data-open={
                                            isDefaultOpen ? "true" : "false"
                                        }
                                    >
                                        <div class="overflow-hidden">
                                            <div class="p-6 pt-0">
                                                <div class="mt-4 w-full">
                                                    <img
                                                        src={f.image}
                                                        alt={f.title}
                                                        class="aspect-[574/323] w-full rounded-lg bg-visual-placeholder object-cover"
                                                        loading="lazy"
                                                    />
                                                </div>
                                                <p class="m-0 mt-4 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                                                    {f.body}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            );
                        })
                }
            </div>
            {/* Right column: cards 1, 3, 5 */}
            <div class="flex flex-1 flex-col gap-6">
                {
                    features
                        .filter((f) => !f.span2)
                        .filter((_, idx) => idx % 2 === 1)
                        .map((f) => {
                            const i = features.indexOf(f);
                            const isDefaultOpen = i === 1;
                            return (
                                <div
                                    class="flex flex-col"
                                    data-no-features-card={i}
                                >
                                    <button
                                        type="button"
                                        class={`group flex w-full cursor-pointer items-center justify-between gap-6 rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out ${isDefaultOpen ? "rounded-b-none" : ""}`}
                                        data-no-features-toggle={i}
                                        aria-expanded={
                                            isDefaultOpen ? "true" : "false"
                                        }
                                    >
                                        <span class="font-heading text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium text-vault-navy">
                                            {f.title}
                                        </span>
                                        <svg
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            class="shrink-0 text-vault-navy transition-colors duration-150 ease-in-out"
                                            aria-hidden="true"
                                            focusable="false"
                                            data-no-features-icon={i}
                                            style={
                                                isDefaultOpen
                                                    ? "transform: rotate(180deg);"
                                                    : ""
                                            }
                                        >
                                            <path
                                                d="M5 12H19"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            />
                                            <path
                                                d="M12 5V19"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                data-no-features-vertical={i}
                                                style={
                                                    isDefaultOpen
                                                        ? "opacity: 0;"
                                                        : "opacity: 1;"
                                                }
                                            />
                                        </svg>
                                    </button>
                                    <div
                                        class="grid overflow-hidden rounded-b-xl border border-t-0 border-neutral-300 bg-generic-00 transition-[grid-template-rows,opacity,border-color] duration-300 ease-in-out"
                                        style={
                                            isDefaultOpen
                                                ? "grid-template-rows: 1fr; opacity: 1;"
                                                : "grid-template-rows: 0fr; opacity: 0; border-color: transparent;"
                                        }
                                        data-no-features-content={i}
                                        data-open={
                                            isDefaultOpen ? "true" : "false"
                                        }
                                    >
                                        <div class="overflow-hidden">
                                            <div class="p-6 pt-0">
                                                <div class="mt-4 w-full">
                                                    <img
                                                        src={f.image}
                                                        alt={f.title}
                                                        class="aspect-[574/323] w-full rounded-lg bg-visual-placeholder object-cover"
                                                        loading="lazy"
                                                    />
                                                </div>
                                                <p class="m-0 mt-4 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                                                    {f.body}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            );
                        })
                }
            </div>
        </div>
        {/* Last card — full width */}
        {
            features
                .filter((f) => f.span2)
                .map((f) => {
                    const i = features.indexOf(f);
                    return (
                        <div
                            class="mt-6 flex flex-col"
                            data-no-features-card={i}
                        >
                            <button
                                type="button"
                                class="group flex w-full cursor-pointer items-center justify-between gap-6 rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out"
                                data-no-features-toggle={i}
                                aria-expanded="false"
                            >
                                <span class="font-heading text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium text-vault-navy">
                                    {f.title}
                                </span>
                                <svg
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    class="shrink-0 text-vault-navy transition-colors duration-150 ease-in-out"
                                    aria-hidden="true"
                                    focusable="false"
                                    data-no-features-icon={i}
                                >
                                    <path
                                        d="M5 12H19"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                    <path
                                        d="M12 5V19"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        data-no-features-vertical={i}
                                    />
                                </svg>
                            </button>
                            <div
                                class="grid overflow-hidden rounded-b-xl border border-t-0 border-neutral-300 bg-generic-00 transition-[grid-template-rows,opacity,border-color] duration-300 ease-in-out"
                                style="grid-template-rows: 0fr; opacity: 0; border-color: transparent;"
                                data-no-features-content={i}
                                data-open="false"
                            >
                                <div class="overflow-hidden">
                                    <div class="p-6 pt-0">
                                        <div class="mt-4 w-full">
                                            <img
                                                src={f.image}
                                                alt={f.title}
                                                class="aspect-[574/323] w-full rounded-lg bg-visual-placeholder object-cover"
                                                loading="lazy"
                                            />
                                        </div>
                                        <p class="m-0 mt-4 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                                            {f.body}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    );
                })
        }
    </div>
</section>

<script is:inline>
    /* Smooth accordion toggle for feature cards. */
    (function () {
        var cards = document.querySelectorAll("[data-no-features-card]");
        if (!cards.length) return;

        var LEFT_COLUMN = ["0", "2", "4"];
        var RIGHT_COLUMN = ["1", "3", "5"];

        function closeCard(index) {
            var content = document.querySelector(
                '[data-no-features-content="' + index + '"]',
            );
            var btn = document.querySelector(
                '[data-no-features-toggle="' + index + '"]',
            );
            var vertical = document.querySelector(
                '[data-no-features-vertical="' + index + '"]',
            );
            var icon = document.querySelector(
                '[data-no-features-icon="' + index + '"]',
            );
            if (!content || content.getAttribute("data-open") !== "true")
                return;
            content.style.gridTemplateRows = "0fr";
            content.style.opacity = "0";
            content.style.borderColor = "transparent";
            content.setAttribute("data-open", "false");
            if (btn) {
                btn.classList.remove("rounded-b-none");
                btn.setAttribute("aria-expanded", "false");
            }
            if (vertical) vertical.style.opacity = "1";
            if (icon) icon.style.transform = "";
        }

        function closeSiblingInColumn(index) {
            var strIdx = String(index);
            var col = null;
            if (LEFT_COLUMN.indexOf(strIdx) !== -1) {
                col = LEFT_COLUMN;
            } else if (RIGHT_COLUMN.indexOf(strIdx) !== -1) {
                col = RIGHT_COLUMN;
            }

            if (col) {
                col.forEach(function (siblingIdx) {
                    if (siblingIdx !== strIdx) {
                        closeCard(siblingIdx);
                    }
                });
            }
        }

        function toggle(index) {
            var content = document.querySelector(
                '[data-no-features-content="' + index + '"]',
            );
            var btn = document.querySelector(
                '[data-no-features-toggle="' + index + '"]',
            );
            var vertical = document.querySelector(
                '[data-no-features-vertical="' + index + '"]',
            );
            var icon = document.querySelector(
                '[data-no-features-icon="' + index + '"]',
            );
            if (!content || !btn) return;

            var isOpen = content.getAttribute("data-open") === "true";

            if (isOpen) {
                closeCard(index);
            } else {
                closeSiblingInColumn(index);
                // Open — animate height to auto
                content.style.gridTemplateRows = "1fr";
                content.style.opacity = "1";
                content.style.borderColor = "";
                content.setAttribute("data-open", "true");
                btn.classList.add("rounded-b-none");
                btn.setAttribute("aria-expanded", "true");
                if (vertical) vertical.style.opacity = "0";
                if (icon) icon.style.transform = "rotate(180deg)";
            }
        }

        // Add transition to vertical bars for smooth plus-to-minus
        var verticals = document.querySelectorAll(
            "[data-no-features-vertical]",
        );
        for (var v = 0; v < verticals.length; v++) {
            verticals[v].style.transition = "opacity 0.3s ease-in-out";
        }

        // Add transition to icons for smooth rotation
        var icons = document.querySelectorAll("[data-no-features-icon]");
        for (var k = 0; k < icons.length; k++) {
            icons[k].style.transition = "transform 0.3s ease-in-out";
        }

        document.addEventListener("click", function (e) {
            if (!e.target.closest) return;
            var toggleBtn = e.target.closest("[data-no-features-toggle]");
            if (!toggleBtn) return;
            var index = toggleBtn.getAttribute("data-no-features-toggle");
            toggle(index);
        });
    })();
</script>
