---
/**
 * "How ClearTax gets you on Peppol in Australia"
 *
 * Feature cards in a 2-column grid, the last spanning both columns.
 * Clicking a card opens a detail overlay dialog showing that card's title,
 * image and body text.
 *
 * Ids and data attributes are `au-platform-` prefixed.
 */
interface Feature {
    title: string;
    body: string;
    image: string;
    span2?: boolean;
}

const features: Feature[] = [
    {
        title: "Send and receive on Peppol",
        body: "Exchange PINT A-NZ invoices and credit notes with any business or government agency on the Peppol network through our Access Point accredited to operate in Australia. Your ABN is registered once, and archiving runs in the same flow.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b0822a7963ccc2d2baf89c1_aus-1.png",
    },
    {
        title: "Get paid faster by government",
        body: "Send e-invoices to Peppol-enabled government agencies; under the current policy, eligible e-invoices to non-corporate Commonwealth entities have a 5-calendar-day payment term once the policy conditions are met. Track each invoice from sent to paid, so AR knows what's coming in.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b0822bbaa9323b2c1882785_aus-2.png",
    },
    {
        title: "Catch errors before your buyer does",
        body: "AI-powered checks validate every PINT A-NZ field, ABN and GST value before an invoice leaves your ERP. Fewer rejections, fewer disputes and faster payments.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b0822d90998cb42700c5b6a_aus-3.png",
    },
    {
        title: "AP that runs itself",
        body: "Receive supplier e-invoices, match them to purchase orders and post them to your ERP without keying anything in. Approval workflows and a single dashboard show what's stuck and why, before month-end close.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b0822eeaa7f97937ada6a07_aus-4.png",
    },
    {
        title: "Integrates with any ERP or POS",
        body: "2,500+ integrations across 50+ ERP and POS systems, including SAP, Oracle, Microsoft Dynamics and NetSuite. AI-driven connectors and structured UAT cut onboarding from weeks to days.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aeb055619845c93e37fe0c7_img-1-5.png",
    },
    {
        title: "Australia today. Every mandate you face next.",
        body: "One platform and one API for 50+ countries. Your Australian entities reuse the same integration as your entities in the EU, the Middle East and Asia, where e-invoicing is already mandatory.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b0822f29dcce88b966374f0_aus-6.png",
    },
    {
        title: "Clean books and expert support",
        body: "Automated reconciliation across invoice, books and GST data keeps your records clean. A dedicated success manager, 750+ integration engineers and in-house tax experts back you from planning to go-live and beyond.",
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aeb055d05e0096f9cfa83a3_img-1-7.png",
        span2: true,
    },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
    <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6">
        <div class="mx-auto mb-8 flex flex-col items-center gap-4 text-center lg:mb-12">
            <h2 class="m-0 max-w-[620px] font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]">
                How ClearTax gets you on Peppol in Australia
            </h2>
            <p class="m-0 max-w-[1020px] font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500">
                One Peppol platform to create, validate, send, receive and
                archive every invoice, connected to your ERP and the rest of
                your global footprint.
            </p>
        </div>

        <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-6">
            {features.map((feature, i) => (
                <button
                    type="button"
                    class:list={[
                        "group m-0 flex h-full w-full cursor-pointer items-center justify-between gap-6 rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue",
                        feature.span2 && "md:col-span-2",
                    ]}
                    aria-haspopup="dialog"
                    data-au-platform-open
                    data-au-platform-index={i}
                >
                    <span class="min-w-0 flex-1 font-heading text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium text-vault-navy">
                        {feature.title}
                    </span>
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        class="shrink-0 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
                        aria-hidden="true"
                        focusable="false"
                    >
                        <path
                            d="M5 12H19"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                        <path
                            d="M12 5V19"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </button>
            ))}
        </div>
    </div>
</section>

<!-- Detail overlay. Lives outside the section's container so the scrim covers
     the viewport rather than the 1280px column. -->
<div
    id="au-platform-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="au-platform-overlay-title"
    aria-hidden="true"
    class="fixed inset-0 z-[2000] hidden items-center justify-center p-4 backdrop-blur-sm"
    style="background-color: rgba(0, 0, 0, 0.7);"
>
    <div
        class="relative max-h-[90vh] w-full max-w-[630px] overflow-y-auto rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6"
        data-au-platform-panel
    >
        <button
            type="button"
            aria-label="Close"
            class="absolute right-6 top-6 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-5 lg:top-5"
            data-au-platform-close
        >
            <svg
                width="40"
                height="40"
                viewBox="0 0 40 40"
                fill="none"
                class="rotate-45"
                aria-hidden="true"
                focusable="false"
            >
                <path
                    d="M20 10V30"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                ></path>
                <path
                    d="M30 20L10 20"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                ></path>
            </svg>
        </button>

        <div class="flex flex-col items-start gap-6">
            <div class="flex w-full flex-col justify-between gap-6">
                <div class="flex flex-col gap-6">
                    <div id="au-platform-overlay-title">
                        {features.map((feature, i) => (
                            <h3
                                class="m-0 pr-12 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px] lg:pr-0 text-balance"
                                style={i === 0 ? "display: block;" : "display: none;"}
                                hidden={i !== 0}
                                data-au-platform-heading
                            >
                                {feature.title}
                            </h3>
                        ))}
                    </div>
                </div>

                <div class="aspect-[574/323] w-full max-w-[574px] overflow-hidden mx-auto">
                    {features.map((feature, i) => (
                        <img
                            src={feature.image}
                            alt={feature.title}
                            width="574"
                            height="323"
                            class="h-full w-full object-contain"
                            style={i === 0 ? "display: block;" : "display: none;"}
                            hidden={i !== 0}
                            data-au-platform-image
                            loading="lazy"
                        />
                    ))}
                </div>

                <div class="flex flex-col gap-6">
                    <div>
                        {features.map((feature, i) => (
                            <div
                                class="m-0 flex flex-col gap-3 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                                style={i === 0 ? "display: flex;" : "display: none;"}
                                hidden={i !== 0}
                                data-au-platform-body
                            >
                                <p class="m-0">{feature.body}</p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style is:global>
    #au-platform-overlay {
        background-color: rgba(0, 0, 0, 0.7);
    }
    [data-au-platform-heading][hidden],
    [data-au-platform-body][hidden],
    [data-au-platform-image][hidden] {
        display: none !important;
    }
</style>

<script is:inline>
    /* Card -> detail overlay */
    (function () {
        var overlay = document.getElementById("au-platform-overlay");
        if (!overlay) return;

        var panel = overlay.querySelector("[data-au-platform-panel]");
        var closeBtn = overlay.querySelector("[data-au-platform-close]");
        var headings = overlay.querySelectorAll("[data-au-platform-heading]");
        var bodies = overlay.querySelectorAll("[data-au-platform-body]");
        var images = overlay.querySelectorAll("[data-au-platform-image]");
        if (!panel || !headings.length || headings.length !== bodies.length) return;

        var count = headings.length;
        var current = 0;
        var lastFocused = null;

        function show(index) {
            current = ((index % count) + count) % count;
            for (var i = 0; i < count; i++) {
                headings[i].hidden = i !== current;
                headings[i].style.display = i === current ? "block" : "none";
                bodies[i].hidden = i !== current;
                bodies[i].style.display = i === current ? "flex" : "none";
                if (images[i]) {
                    images[i].hidden = i !== current;
                    images[i].style.display = i === current ? "block" : "none";
                }
            }
            panel.scrollTop = 0;
        }

        function open(index, opener) {
            lastFocused = opener || document.activeElement;
            show(index);
            overlay.style.display = "flex";
            overlay.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
            if (closeBtn) closeBtn.focus();
        }

        function close() {
            overlay.style.display = "none";
            overlay.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
            if (lastFocused && lastFocused.focus) lastFocused.focus();
        }

        function isOpen() {
            return overlay.style.display === "flex";
        }

        document.addEventListener("click", function (e) {
            if (!e.target.closest) return;
            var opener = e.target.closest("[data-au-platform-open]");
            if (!opener) return;
            open(
                parseInt(opener.getAttribute("data-au-platform-index"), 10) || 0,
                opener,
            );
        });

        if (closeBtn) closeBtn.addEventListener("click", close);

        overlay.addEventListener("click", function (e) {
            if (e.target === overlay) close();
        });

        document.addEventListener("keydown", function (e) {
            if (!isOpen()) return;

            if (e.key === "Escape") {
                close();
                return;
            }

            if (e.key === "ArrowLeft") {
                show(current - 1);
                return;
            }
            if (e.key === "ArrowRight") {
                show(current + 1);
                return;
            }

            if (e.key !== "Tab") return;
            var focusable = panel.querySelectorAll(
                'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
            );
            if (!focusable.length) return;
            var first = focusable[0];
            var last = focusable[focusable.length - 1];

            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });
    })();
</script>
