---
/**
 * France regional hero — Figma node 13600:27940.
 *
 * Background is the interactive stroke field from
 * `sections/global-homepage/Hero.astro` (originally
 * `sections/blog-listing/Newsletter.astro`, which carries the full explanation of
 * the geometry): a plain grid of lime dots until a pointer enters, at which point
 * each dot draws out into a stroke aimed at the cursor, longest beside it and back
 * to a dot by `lengthRadius`. Same four gradient layers over it — page gradient,
 * radial wash behind the copy, a mobile-only top fade, and a bottom fade.
 *
 * Ids and the canvas id are `fr-` prefixed rather than the `hero` /
 * `hero-dots-canvas` older files use, because embeds share one namespace per page
 * and a bare `hero` is exactly the kind of name that collides later.
 *
 * The three badges carry a 37px `bg-visual-placeholder` square where the Figma
 * has an unfilled "Icon placeholder" frame. Swap each for a Webflow-hosted asset
 * once the icons exist — never a `data:` URI, which would blow the paste cap.
 */
interface Props {
    /** Stroke width, and so the diameter of the dot it becomes at rest. */
    lineWidth?: number;
    gap?: number;
    /** Must stay under the grid pitch or the field knits into a mesh. */
    maxLength?: number;
    lengthRadius?: number;
    /** Leave at 1 — a partial turn makes strokes flip as the cursor crosses them. */
    tilt?: number;
    baseColor?: string;
    cursorRadius?: number;
    pull?: number;
    fadeRadius?: number;
}

const {
    lineWidth = 3,
    gap = 24,
    maxLength = 6,
    lengthRadius = 260,
    tilt = 1,
    baseColor = "#C8F006",
    cursorRadius = 320,
    pull = 14,
    fadeRadius = 40,
} = Astro.props;

const stats: { label: string; value: string; width: string }[] = [
    {
        value: "Peppol Access Point",
        label: "supporting the PINT A-NZ specification",
        width: "sm:max-w-[350px]",
    },
    {
        value: "AI-powered seamless integration",
        label: "with any ERP/POS systems",
        width: "sm:max-w-[350px]",
    },
    {
        value: "One global e-invoicing",
        label: "API for 50+ country mandates",
        width: "sm:max-w-[350px]",
    },
];
---

<section
    id="au-hero"
    class="au-hero relative overflow-hidden bg-generic-00"
    data-line-width={String(lineWidth)}
    data-gap={String(gap)}
    data-max-length={String(maxLength)}
    data-length-radius={String(lengthRadius)}
    data-tilt={String(tilt)}
    data-base-color={baseColor}
    data-cursor-radius={String(cursorRadius)}
    data-pull={String(pull)}
    data-fade-radius={String(fadeRadius)}
>
    <!-- Interactive stroke field -->
    <div class="absolute inset-0 z-0 w-full h-full pointer-events-none">
        <canvas id="au-hero-dots" class="absolute inset-0 w-full h-full"
        ></canvas>
    </div>

    <!-- Radial wash, so the headline keeps its contrast over the field -->
    <div
        class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"
    >
    </div>

    <div class="container mx-auto relative z-10">
        <div
            class="flex flex-col items-center gap-6 text-center max-lg:pt-32 max-lg:pb-16 lg:pt-[257px] lg:pb-[177px]"
        >
            <div class="flex flex-col items-center w-full">
                <h1
                    class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h1)] md:text-[length:var(--fs-display-sm)] lg:text-[length:var(--fs-display-lg)] leading-[length:var(--lh-h1)] md:leading-[length:var(--lh-display-sm)] lg:leading-[length:var(--lh-display-lg)] tracking-[-1px] max-w-185"
                >
                    Peppol <span class="inline-block text-generic-100 bg-flux-lime py-1 px-[13px] rounded-xl">E-invoicing</span> for Australia. Get paid in days, not weeks.
                </h1>
                <p
                    class="m-0 font-body mt-2 text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] max-w-179"
                >
                    Send and receive every invoice in PINT A-NZ over Peppol,
                    straight from your ERP.
                </p>

                <!-- 3 up on desktop in a unified bordered card with vertical dividers -->
                <ul
                    class="mt-4 p-0 sm:mt-8 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 divide-neutral-200 rounded-xl border border-neutral-300 bg-generic-00 list-none m-0 w-full max-w-[1056px]"
                >
                    {
                        stats.map((st, index) => (
                            <li class="relative flex items-center gap-3 p-4 text-left first:before:hidden md:before:block before:hidden before:absolute before:left-0 before:top-1/2 before:-translate-y-1/2 before:h-10 sm:before:h-11 before:w-px before:bg-neutral-200">
                                <div class="size-11 sm:size-12 shrink-0 rounded-xl flex items-center justify-center">
