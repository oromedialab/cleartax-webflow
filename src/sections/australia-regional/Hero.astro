<path d="M23.9967 20.4761C23.7965 20.3682 23.1913 20.0894 22.625 20.3088C22.0086 20.5476 21.7623 21.394 22.3263 21.8234C22.6351 22.0585 23.0557 22.1901 23.4181 22.3182C24.5756 22.7273 24.1656 24.3458 23.0052 24.3899M23.0052 24.3899C22.992 24.3904 22.9787 24.3907 22.9653 24.3908C22.5006 24.3939 22.2833 24.3644 21.8751 24.0974M23.0052 24.3899V24.3849M23.0052 24.3899V25.3023M23.0052 19.3021V20.1686" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#05022A"/>
