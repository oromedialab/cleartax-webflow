                                    )}
                                    {index === 2 && (
                                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect x="0.5" y="0.5" width="55" height="55" rx="7.5" stroke="#CCCCCC"/>
<path d="M28.3713 34.7496H21.2626V31.7496M21.2626 31.7496V28.7495H31.7627V31.2482M21.2626 31.7496L30.7539 31.7494" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" stroke="#05022A"/>
