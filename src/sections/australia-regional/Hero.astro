                                    )}
                                </div>
                                <div class={`flex flex-col ${st.width}`}>
                                        <span class="font-medium text-vault-navy text-[length:var(--fs-label)] leading-[length:var(--lh-body)]">
                                            {st.value}
                                        </span>
                                        <span class="font-normal text-neutral-500 text-[length:var(--fs-label-xs)] leading-[length:var(--lh-body-sm)]">
                                            {st.label}
                                        </span>
                                    </div>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Opens the HubSpot modal from `DemoModal.astro`. The href is kept real
           so the CTA still goes somewhere if that section is absent. -->
            <a
                href="https://www.cleartax.com/contact-us"
                data-demo-open
                class="max-md:w-full inline-flex items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-10 py-3.5 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-50 no-underline transition-all duration-200 hover:bg-generic-00 hover:text-nova-blue"
