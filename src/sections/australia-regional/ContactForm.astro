---
/**
 * Closing contact band for the Belgium regional page — Figma node 18357:63267
 * ("Container - Testimonial", the second one). The paste unit.
 *
 * Structure, styling and behaviour live in `_shared/ContactFormRb.astro`; this
 * file owns the content. Props must be supplied here, inside a section file,
 * because the embed route renders sections with no props.
 *
 * The Figma draws a hand-built Name / Phone / Email / Company form with a
 * "Book a demo" button and placeholder lede ("Insert an engaging description
 * text for the form"). The page's real lead capture is the HubSpot form inside
 * `ContactFormRb`, so that is what renders; the three feature points on the
 * left are the Figma's, and match the other regional pages.
 */
import ContactFormRb from '../_shared/ContactFormRb.astro';
import type { FormPoint } from '../_shared/ContactFormRb.astro';

const points: FormPoint[] = [
  {
    icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c38298f6479be8501b0b6_form-icon-1.png',
    iconAlt: "Laptop with onboarding checklist icon",
    title: "Enterprise Onboarding",
    desc: "Dedicated implementation support to help your teams go live faster.",
  },
  {
    icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c2a4d9db9087ca3daff4f_form-icon-2.png',
    iconAlt: "Connected user access network icon",
    title: "Security-Led Setup",
    desc: "Built around zero-trust access, encryption, and role-based controls.",
  },
  {
    icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c2a4d9983b773cf441564_form-icon-3.png',
    iconAlt: "Gear and wrench integration icon",
    title: "Global Integration",
    desc: "Custom-fit to your ERP, subsidiaries, and compliance workflows.",
  },
];
---

<div class="au-contact-wrap">
  <ContactFormRb
    points={points}
    title="Turn Australia e-invoicing into a practical readiness plan."
    subtitle="Bring your systems, invoice volumes and business priorities. Discuss what you can prepare now, what needs official confirmation and what the next steps could look like with ClearTax."
  />
</div>

<style is:global>
  .au-contact-wrap #contactForm p.max-w-2xl {
    max-width: 798px;
  }
</style>
