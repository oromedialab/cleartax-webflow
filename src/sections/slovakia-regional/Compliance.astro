---
/**
 * ERP Integration section for Integration page.
 * Implements isolated sticky horizontal scroll container matching Figma specs (628x512 cards),
 * clean vertical rhythm, single-line titles, and responsive handling.
 */

const cards = [
  {
    title: "Connect once. Stay compliant.",
    img: "/images/slovakia-regional/image-1.png",
    desc: "ClearTax connects to your existing ERP without any rebuild and keeps you compliant with Slovakia's e-invoicing ecosystem.",
  },
  {
    title: "Create & exchange compliant e-invoices",
    img: "/images/slovakia-regional/image-2.png",
    desc: "Generate invoices in the required structured format on your ERP and billing systems. And send or receive them through Peppol, which is the required certified delivery infrastructure.",
  },
  {
    title: "Validate before sending",
    img: "/images/slovakia-regional/image-3.png",
    desc: "Validation of the invoices is required against applicable Slovak and Peppol validation rules before transmission.",
  },
  {
    title: "Automate tax reporting",
    img: "/images/slovakia-regional/image-4.png",
    desc: "Transmit the required invoice data to the Slovak Financial Administration through the compliant reporting workflow.",
  },
  {
    title: "Track invoice status",
    img: "/images/slovakia-regional/image-5.png",
    desc: "Monitor invoice creation, validation, transmission, delivery and reporting from one place.",
  },
  {
    title: "Keep your ERP unchanged",
    img: "/images/slovakia-regional/image-6.png",
    desc: "Centralise country-specific compliance outside your ERP while keeping your core finance systems intact.",
  },
];
---

<div class="erp-sticky-container">
  <section
    class="sticky top-0 flex flex-col justify-center bg-generic-00 py-12 md:py-16 xl:py-20 overflow-hidden min-h-[calc(100vh-80px)]"
  >
    <div class="max-w-[var(--container-max)] mx-auto w-full px-4 md:px-6">
      <!-- Header -->
      <div class="erp-header-wrapper text-center mx-auto mb-8 md:mb-12">
        <h2
          class="erp-section-title font-heading font-medium text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] text-text-default max-w-141 mx-auto mb-3 sm:mb-4 m-0"
        >
         Slovakia E-Invoicing Compliance
          Without the ERP Overhaul
        </h2>
        <p
          class="erp-section-desc font-body font-normal text-neutral-500 text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] max-w-188 mx-auto mb-12 m-0"
        >
          Slovakia's Financial Administration specifies Peppol BIS as the standardised format based on EN 16931 and requires businesses to select a certified delivery service provider.
        </p>
      </div>

      <!-- Cards Track -->
      <div class="w-full h-auto">
        <div
          class="erp-scroll-track flex items-stretch gap-6 w-max transition-transform duration-[250ms] ease-out will-change-transform"
        >
          {
            cards.map((item) => (
              <div class="erp-card-item box-border bg-generic-00 rounded-2xl p-6 sm:p-7 lg:p-8 w-[calc(100vw-32px)] sm:w-[500px] md:w-[560px] lg:w-[628px] h-[420px] md:h-[480px] lg:h-[540px] max-h-[420px] md:max-h-[480px] lg:max-h-[540px] shrink-0 flex flex-col justify-between border-2 border-neutral-300 rounded-xl select-none">
                <h3 class="erp-card-title font-heading text-[22px] sm:text-[24px] lg:text-[26px] leading-[1.3] font-medium text-text-default pointer-events-none  m-0">
                  {item.title}
                </h3>
                <div class="w-full h-[200px] sm:h-[290px] lg:h-[316px] shrink-0 overflow-hidden flex items-center justify-center my-auto pointer-events-none">
                  <img
                    class="w-full h-full object-contain"
                    src={item.img}
                    alt={item.title}
                  />
                </div>
                <p class="erp-card-desc font-body text-neutral-500 font-normal text-sm lg:text-[15px] leading-relaxed max-w-[540px] pointer-events-none  m-0">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</div>

<style is:global>
  @media (max-height: 750px) {
    .erp-sticky-container section {
      padding-top: var(--spacing-big, 1.25rem) !important;
      padding-bottom: var(--spacing-big, 1.25rem) !important;
    }
    .erp-header-wrapper {
      margin-bottom: var(--spacing-md, 1rem) !important;
    }
    .erp-card-item {
      padding: var(--spacing-x-big, 1.25rem) !important;
    }
    .erp-card-title {
      font-size: var(--fs-h5, 22px) !important;
      line-height: var(--lh-h5, 28px) !important;
    }
    .erp-card-desc {
      font-size: var(--fs-body, 16px) !important;
      line-height: var(--lh-body-sm, 20px) !important;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const containers = document.querySelectorAll(".erp-sticky-container");
    if (!containers.length) return;

    containers.forEach((container) => {
      const track = container.querySelector(".erp-scroll-track");
      const section = container.querySelector("section");
      if (!container || !track || !section) return;

      const getHeaderHeight = () => {
        const header = document.querySelector("header, .navbar, .w-nav");
        return header ? header.offsetHeight : 80;
      };

      let maxTranslate = 0;
      let totalScrollable = 0;
      let stickyTop = 0;

      const updateMeasurements = () => {
        const sectionHeight = section.offsetHeight;
        const windowHeight = window.innerHeight;
        const headerHeight = getHeaderHeight();

        const trackOffset =
          track.parentElement.getBoundingClientRect().top -
          section.getBoundingClientRect().top;
        const trackHeight = track.offsetHeight;
        const availableSpace = windowHeight - headerHeight;

        const idealTrackTop =
          headerHeight + Math.max(40, (availableSpace - trackHeight) / 2);
        let calculatedTop = idealTrackTop - trackOffset;

        // Position section flush under header when sticky, avoiding gap on large screens
        stickyTop = Math.min(headerHeight, calculatedTop);
        section.style.top = `${stickyTop}px`;

        const containerWidth =
          track.parentElement.getBoundingClientRect().width;
        maxTranslate = Math.max(0, track.scrollWidth - containerWidth);
        container.style.height = `${maxTranslate + windowHeight}px`;
        totalScrollable =
          container.getBoundingClientRect().height - sectionHeight;
      };

      updateMeasurements();

      if (window.ResizeObserver) {
        const ro = new ResizeObserver(updateMeasurements);
        ro.observe(section);
        ro.observe(track);
      }
      window.addEventListener("resize", updateMeasurements);

      let ticking = false;

      const handleScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            const containerRect = container.getBoundingClientRect();
            const scrolledDistance = Math.max(0, stickyTop - containerRect.top);

            let progress =
              totalScrollable > 0 ? scrolledDistance / totalScrollable : 0;
            progress = Math.max(0, Math.min(1, progress));

            track.style.transform = `translate3d(-${progress * maxTranslate}px, 0, 0)`;

            ticking = false;
          });
          ticking = true;
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              window.addEventListener("scroll", handleScroll, {
                passive: true,
              });
              handleScroll();
            } else {
              window.removeEventListener("scroll", handleScroll);
            }
          });
        },
        {
          rootMargin: "100% 0px 100% 0px",
        },
      );

      observer.observe(container);
    });
  });
</script>
