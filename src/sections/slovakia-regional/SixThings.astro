---
/**
 * "Six Things to Get Right Before January 2027" — Figma node 18270:58056
 * ("Fold 6 alt").
 *
 * Two-column grid of six outlined cards: a numbered 30px badge, a 24px title
 * and a muted line.
 */
interface Item {
  title: string;
  body: string;
}

const items: Item[] = [
  {
    title: "Confirm your scope",
    body: "Domestic B2B and B2G transactions are under the scope with no threshold in revenue, so every VAT-registered entity is in scope from day one.",
  },
  {
    title: "Align invoice formats to EN 16931 / UBL 2.1.",
    body: "PDFs, EDIFACT, and unstructured XML won't qualify after the mandate goes live.",
  },
  {
    title: "Onboard an accredited Digital Postman",
    body: "You'll need one e-invoicing solution provider to send and to receive e-invoices. ClearTax acts as both.",
  },
  {
    title: "Test during the pilot phase.",
    body: "The pilot window exists precisely so you're not troubleshooting live in January 2027.",
  },
  {
    title: "Build real-time TDD reporting",
    body: "The reporting window is measured in days, not weeks, so this has to be automatic.",
  },
  {
    title: "Set your retention policy.",
    body: "10-year retention applies generally, 20 years for real estate-related invoices.",
  },
];
---

<section class="bg-generic-00 py-12 lg:py-20">
  <div class="container mx-auto">
    <div class="flex flex-col items-center gap-12">
      <h2
        class="m-0 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        Six Things to Get Right Before January 2027
      </h2>

      <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-2">
        {
          items.map((item, i) => (
            <div class="flex flex-col items-start gap-4 lg:gap-6 rounded-xl border-2 border-neutral-300 bg-generic-00 p-6 lg:p-7">
              <span class="flex h-[30px] w-[30px] items-center justify-center rounded-lg border border-[#c3c7cd] bg-[#fbfbfc] font-body font-medium text-[#5b6068] text-[length:var(--fs-label-sm)] leading-[14px]">
                {i + 1}
              </span>
              <div class="flex w-full flex-col gap-4">
                <h3 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">
                  {item.title}
                </h3>
                <p class="m-0 font-body text-neutral-500/80 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                  {item.body}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
