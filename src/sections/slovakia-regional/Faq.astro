---
/**
 * FAQ for the Slovakia regional page — Figma node 18270:58164 ("FAQ"). The
 * paste unit.
 *
 * Structure, styling and behaviour live in `_shared/FaqRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file,
 * because the embed route renders sections with no props.
 *
 * The Figma has no subtitle under the heading, so an empty one is passed —
 * `FaqRb` omits the paragraph when it is empty. Eight questions, first open,
 * the rest behind "Load more" after five — the primitive's standard behaviour.
 */
import FaqRb from '../_shared/FaqRb.astro';
import type { FaqItem } from '../_shared/FaqRb.astro';

const items: FaqItem[] = [
  {
    q: "What’s an E-Invoice?",
    a: [
      {
        kind: "p",
        html: "An e-invoice is a machine-processable, EN 16931-compliant electronic document, not merely a PDF. Exchange will generally use certified providers and the Peppol network - not IS EFA.",
      },
      {
        kind: "p",
        html: "Where a covered invoice is exchanged through the certified delivery service, the applicable tax-data reporting rules in § 85o(9)–(11) also apply.",
      },
    ],
  },
  {
    q: "When does Slovakia's e-invoicing mandate take effect?",
    a: "Mandatory structured e-invoicing and real-time reporting for domestic B2B and B2G transactions begins 1 January 2027, under Act No. 385/2025. 2026 is a voluntary pilot year.",
  },
  {
    q: "Who needs to comply?",
    a: "Every VAT-registered business in Slovakia — no revenue threshold. All must be able to issue and receive compliant e-invoices.",
  },
  {
    q: "What format is required?",
    a: "Peppol BIS Billing 3.0 in UBL 2.1 XML, compliant with the EN 16931 European standard. There's no Slovak-specific CIUS. PDFs and emailed invoices won't be valid from 2027.",
  },
  {
    q: "Is there a threshold below which businesses are exempt?",
    a: "No. Unlike the earlier B2G-only rules (which applied a €5,000 procurement threshold), the B2B mandate has no threshold.",
  },
  {
    q: "What happens if I don't comply?",
    a: "Penalties run up to €10,000 per breach, and up to €100,000 for repeat offences. Honest mistakes corrected promptly aren't penalised.",
  },
  {
    q: "Do I need a Digital Postman, and can ClearTax be mine?",
    a: "Yes — transmission must go through a certified Digital Postman on both the sending and receiving side. ClearTax can act as your Digital Postman for both AR and AP.",
  },
  {
    q: "What about invoices to other EU countries?",
    a: "Cross-border and ViDA-aligned digital reporting requirements extend from 1 July 2030, when the Tax Data Document also replaces the VAT Control Statement and EC Sales List domestically.",
  },
];
---

<FaqRb items={items} subtitle="" />
