        <div id="macc-panel-integrations" class="macc-wrapper">
          <div class="macc-inner px-4 pb-6">
            <p
              class="text-[length:var(--fs-body)] font-normal text-neutral-500 leading-[length:var(--lh-body)] m-0 mb-4"
            >
              Deep integrations means minimal to no changes in your daily
              workflow
            </p>
            <div
              class="w-full rounded-[14px] border border-black/10 bg-generic-00 flex flex-col p-4 sm:p-5"
            >
              <div class="mb-3">
                <h3
                  class="m-0 text-[length:var(--fs-h6)] font-medium leading-[length:var(--lh-h6)] text-vault-navy"
                >
                  Multiple Systems
                </h3>
                <p
                  class="m-0 mt-1 text-[length:var(--fs-body)] text-neutral-500 font-normal leading-[length:var(--lh-body)]"
                >
                  ERPs, POS, Handheld systems
                </p>
              </div>
              <div class="grid grid-cols-2 gap-2.5 my-4">
                {
                  integrationLogos.slice(0, 6).map((logo) => (
                    <div class="bg-generic-00 rounded-[8px] shadow-xs border border-black/5 min-h-13 flex items-center justify-center p-2.5">
                      <img
                        src={logo.src}
                        alt={logo.alt}
                        class="max-h-7 max-w-[80%] w-auto object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ))
                }
              </div>
              <div
                class="grid grid-cols-2 gap-4 pt-4 border-t border-black/5 mt-auto"
              >
                <div>
                  <div
                    class="text-[length:var(--fs-h5)] font-medium leading-[length:var(--lh-h5)] text-vault-navy"
                  >
                    2,000+
                  </div>
                  <p
                    class="m-0 mt-0.5 text-[length:var(--fs-body-sm)] text-neutral-500 font-normal leading-[length:var(--lh-body-sm)]"
                  >
                    Successful Integrations
                  </p>
                </div>
                <div>
                  <div
                    class="text-[length:var(--fs-h5)] font-medium leading-[length:var(--lh-h5)] text-vault-navy"
                  >
                    100+
                  </div>
                  <p
                    class="m-0 mt-0.5 text-[length:var(--fs-body-sm)] text-neutral-500 font-normal leading-[length:var(--lh-body-sm)]"
                  >
                    Integration engineers
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Service and Support -->
      <div class="macc-item border-b border-black/10" data-macc="support">
        <button
          type="button"
          class="macc-trigger w-full flex items-center justify-between py-4 px-4 text-left cursor-pointer bg-transparent border-0 select-none hover:bg-black/[0.02]"
