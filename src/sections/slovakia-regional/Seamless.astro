<!-- Mobile (<lg) -->
<section class="lg:hidden bg-generic-00 py-12">
  <div class="w-full max-w-[var(--container-max)] mx-auto px-6">
    <div class="text-center">
      <h2
        class="text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] mb-0 mt-0 font-medium text-black mb-12 tracking-[-0.02em] max-w-[1170px] w-full mx-auto"
      >
        Enterprise-grade security for your invoice data
      </h2>
    </div>

    <div class="flex flex-col border-t border-black/10" data-macc-root>
      <!-- 1. Security -->
      <div
        class="macc-item border-b border-black/10 active"
        data-macc="security"
      >
        <button
          type="button"
          class="macc-trigger w-full flex items-center justify-between py-4 px-4 text-left cursor-pointer bg-transparent border-0 select-none hover:bg-black/[0.02]"
          aria-expanded="true"
          aria-controls="macc-panel-security"
        >
          <span
            class="macc-title text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium text-neutral-500 transition-colors duration-200"
          >
            Security
          </span>
          <svg
            viewBox="0 0 22 22"
            fill="none"
            height="20"
            width="20"
            class="macc-chevron text-neutral-400 shrink-0"
          >
            <path
              d="M7 9l4 4 4-4"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <div id="macc-panel-security" class="macc-wrapper">
          <div class="macc-inner px-4 pb-6">
            <p
              class="text-[length:var(--fs-body)] font-normal text-neutral-500 leading-[length:var(--lh-body)] m-0 mb-4"
            >
              Powering Global e-Invoicing Alongside Regulators
            </p>
            <div class="flex flex-col gap-3 w-full">
              {
                securityCards.map((card) => (
                  <div class="bg-generic-00 rounded-[12px] p-4 flex items-start gap-3.5 border border-black/10">
                    <div class="flex items-center justify-center shrink-0 w-8 h-8 mt-0.5">
                      <img
                        src={card.icon}
                        alt=""
                        class="w-7 h-7 object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="flex flex-col flex-1 min-w-0">
                      <div class="text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-semibold mb-1 text-vault-navy">
                        {card.title}
                      </div>
                      <p class="text-[length:var(--fs-body-sm)] text-neutral-500 leading-[length:var(--lh-body-sm)] font-normal m-0">
                        {card.desc}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Compliance -->
      <div class="macc-item border-b border-black/10" data-macc="compliance">
        <button
          type="button"
          class="macc-trigger w-full flex items-center justify-between py-4 px-4 text-left cursor-pointer bg-transparent border-0 select-none hover:bg-black/[0.02]"
          aria-expanded="false"
          aria-controls="macc-panel-compliance"
        >
          <span
            class="macc-title text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium text-neutral-500 transition-colors duration-200"
          >
            Compliance
          </span>
          <svg
            viewBox="0 0 22 22"
            fill="none"
            height="20"
            width="20"
            class="macc-chevron text-neutral-400 shrink-0"
          >
            <path
              d="M7 9l4 4 4-4"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <div id="macc-panel-compliance" class="macc-wrapper">
          <div class="macc-inner px-4 pb-6">
            <p
              class="text-[length:var(--fs-body)] font-normal text-neutral-500 leading-[length:var(--lh-body)] m-0 mb-4"
            >
              Powering global e-invoicing alongside regulators.
            </p>
            <div class="grid grid-cols-2 gap-3 w-full">
              {
                mobileComplianceCards.map((c) => (
                  <div class="bg-generic-00 rounded-[12px] p-3.5 flex flex-col justify-between border border-black/10">
                    <div class="flex items-center min-h-[34px] mb-5">
                      <img
                        src={c.flag}
                        alt={c.name}
                        class="w-9 h-auto object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="flex flex-col">
                      <div class="text-[length:var(--fs-body)] font-semibold mb-1 leading-[length:var(--lh-body)] text-vault-navy">
                        {c.name}
                      </div>
                      <p class="text-[length:var(--fs-body-sm)] text-neutral-500 leading-[length:var(--lh-body-sm)] font-normal m-0">
                        {c.desc}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Integrations -->
      <div class="macc-item border-b border-black/10" data-macc="integrations">
        <button
          type="button"
          class="macc-trigger w-full flex items-center justify-between py-4 px-4 text-left cursor-pointer bg-transparent border-0 select-none hover:bg-black/[0.02]"
