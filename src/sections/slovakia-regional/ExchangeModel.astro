---
/**
 * "Slovakia E-Invoicing Exchange Model" — Figma node 18270:57934
 * ("Fold 12 – Slovakia exchange model (diagram)").
 *
 * The 5-corner Peppol diagram, drawn as live markup rather than an exported
 * image so the copy stays editable and no asset is pasted. Everything sits on
 * a fixed 1232 × 416 board (the card's 1280px minus 24px padding either side),
 * absolutely positioned at the Figma's coordinates; connectors are one inline
 * SVG underneath, flow labels and cards sit on top with a white ground so they
 * cut the dashed lines the way the design does.
 *
 *   C1 Seller ⇄ C2 ClearTax ⇄ (Peppol) ⇄ C3 ClearTax ⇄ C4 Buyer
 *   C2 and C3 each report the Tax Data Document to C5 Finance Authority.
 *
 * The board does not reflow. Below `lg` it scrolls sideways inside the card,
 * which keeps every connector aligned; the Figma has no mobile frame for it.
 *
 * Colours are literals on purpose: the Figma's emerald (#10b981) is a
 * "(not in use)" token and has no brand-v2 equivalent. Ids are `sk-` prefixed.
 */
interface Corner {
  corner: string;
  name: string;
  sub?: string;
  /** Left / top on the board, and width. */
  x: number;
  y: number;
  w: number;
  accent: "blue" | "green";
}

const corners: Corner[] = [
  { corner: "Corner 1", name: "Seller", x: 0, y: 0, w: 233, accent: "blue" },
  { corner: "Corner 4", name: "Buyer", x: 0, y: 288, w: 233, accent: "blue" },
  {
    corner: "Corner 2",
    name: "ClearTax",
    sub: "Seller’s service provider",
    x: 516,
    y: 0,
    w: 300,
    accent: "green",
  },
  {
    corner: "Corner 3",
    name: "ClearTax",
    sub: "Buyer’s service provider",
    x: 516,
    y: 288,
    w: 300,
    accent: "green",
  },
];
---

<section class="bg-generic-00 py-12 lg:py-20">
  <div class="container mx-auto">
    <!-- Desktop Version (lg and up) - UNTOUCHED -->
    <div
      class="hidden lg:flex rounded-xl border border-neutral-300 px-6 pt-6 pb-8 flex-col gap-12"
    >
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        Slovakia E-Invoicing Exchange Model
      </h2>

      <div class="overflow-x-auto">
        <div
          id="sk-exchange-board"
          class="relative mx-auto h-[416px] w-[1232px] font-body"
          role="img"
          aria-label="Slovakia 5-corner exchange model: the seller (corner 1) sends invoice data to ClearTax as the seller's service provider (corner 2). It travels over the Peppol network to ClearTax as the buyer's service provider (corner 3) and on to the buyer (corner 4). Corners 2 and 3 each send the tax data document to the Finance Authority (corner 5) and receive a response message."
        >
          <!-- Connectors -->
          <svg
            class="absolute inset-0 h-full w-full"
            viewBox="0 0 1232 416"
            fill="none"
            aria-hidden="true"
          >
            <g stroke-width="1.5" stroke-dasharray="4 4" stroke-linecap="round">
              <!-- Seller ⇄ C2 -->
              <path d="M234 58 H516" stroke="#5446ff"></path>
              <path d="M234 81 H516" stroke="#9ca3af"></path>
              <!-- Buyer ⇄ C3 -->
              <path d="M234 344 H516" stroke="#9ca3af"></path>
              <path d="M234 367 H516" stroke="#5446ff"></path>
              <!-- C2 ⇄ C5 -->
              <path d="M816 54 H1142 Q1154 54 1154 66 V118" stroke="#10b981"></path>
              <path d="M816 74 H1120 Q1132 74 1132 86 V118" stroke="#9ca3af"></path>
              <!-- C3 ⇄ C5 -->
              <path d="M816 341 H1119 Q1131 341 1131 329 V298" stroke="#10b981"></path>
              <path d="M816 361 H1142 Q1154 361 1154 349 V298" stroke="#9ca3af"></path>
              <!-- Acknowledgement: C3 up to C2, C2 down to C3 -->
              <path d="M558 288 V129" stroke="#10b981"></path>
              <path d="M773 129 V287" stroke="#10b981"></path>
            </g>
            <g
              stroke="#10b981"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M553 135 L558 129 L563 135"></path>
              <path d="M768 281 L773 287 L778 281"></path>
            </g>
          </svg>

          <!-- Corner cards -->
          {
            corners.map((c) => (
              <div
                class="absolute flex h-32 items-center gap-[13px] overflow-hidden rounded-lg border border-neutral-300 bg-generic-00 p-6"
                style={`left:${c.x}px;top:${c.y}px;width:${c.w}px;`}
              >
                <span
                  class:list={[
                    "h-full w-1 shrink-0 rounded-lg",
                    c.accent === "blue" ? "bg-nova-blue" : "bg-[#10b981]",
                  ]}
                  aria-hidden="true"
                />
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <p class="m-0 font-body font-medium uppercase text-neutral-500 text-[length:var(--fs-label-sm)] leading-4 tracking-[0.6px]">
                    {c.corner}
                  </p>
                  <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-7">
                    {c.name}
                  </p>
                  {c.sub && (
                    <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-5">
                      {c.sub}
                    </p>
                  )}
                </div>
              </div>
            ))
          }

          <!-- Corner 5 -->
          <div
            class="absolute flex h-[180px] w-[174px] flex-col justify-between overflow-hidden rounded-lg border border-[#9ca3af] bg-generic-00 p-6"
            style="left:1054px;top:118px;"
          >
            <div class="flex flex-col gap-6">
              <p class="m-0 font-body font-semibold uppercase text-nova-blue text-[length:var(--fs-body)] leading-6 tracking-[0.6px]">
                Corner 5
              </p>
              <span class="block h-0.5 w-full rounded-full bg-[#ecebe9]" aria-hidden="true"></span>
            </div>
            <p class="m-0 w-[126px] font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-7">
              Finance Authority
            </p>
          </div>

          <!-- Flow labels -->
          <div
            class="absolute flex flex-col items-center gap-1 rounded-md bg-generic-00 px-2 py-1.5 font-body font-medium uppercase text-[length:var(--fs-label-sm)] leading-5 whitespace-nowrap"
            style="left:309px;top:40px;"
          >
            <span class="text-nova-blue">Invoice data →</span>
            <span class="text-neutral-500">← Response</span>
          </div>
          <div
            class="absolute flex flex-col items-center gap-1 rounded-md bg-generic-00 px-2 py-1.5 font-body font-medium uppercase text-[length:var(--fs-label-sm)] leading-5 whitespace-nowrap"
            style="left:275px;top:328px;"
          >
            <span class="text-neutral-500">← Delivery confirmation</span>
            <span class="text-nova-blue">Invoice data →</span>
          </div>
          <div
            class="absolute flex flex-col items-center gap-1 rounded-md bg-generic-00 px-2 py-1.5 font-body font-medium uppercase text-[length:var(--fs-label-sm)] leading-4 tracking-[0.3px] whitespace-nowrap"
            style="left:892px;top:40px;"
          >
            <span class="text-[#10b981]">Tax data document →</span>
            <span class="text-neutral-500">← Response message</span>
          </div>
          <div
            class="absolute flex flex-col items-center gap-1 rounded-md bg-generic-00 px-2 py-1.5 font-body font-medium uppercase text-[length:var(--fs-label-sm)] leading-4 tracking-[0.3px] whitespace-nowrap"
            style="left:892px;top:328px;"
          >
            <span class="text-[#10b981]">Tax data document →</span>
            <span class="text-neutral-500">← Response message</span>
          </div>

          <!-- Acknowledgement pill -->
          <div
            class="absolute flex w-[169px] items-center justify-center rounded-xl border-2 border-dashed border-[#10b981] bg-generic-00 px-3 py-2"
            style="left:581px;top:185px;"
          >
            <span class="font-body font-medium text-[#059669] text-[length:var(--fs-body)] leading-6 whitespace-nowrap">
              Acknowledgement
            </span>
          </div>

          <!-- Peppol network -->
          <div
            class="absolute flex w-[145px] flex-col items-center gap-2 bg-generic-00 px-3 py-2"
            style="left:825px;top:146px;"
          >
            <img
              class="max-w-15 w-full object-contain"
              src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae9ac0741c278990fdd5b3d_peppol.png"
              alt=""
              aria-hidden="true"
            />
            <span class="font-body font-medium text-black text-[length:var(--fs-body)] leading-6 whitespace-nowrap">
              Peppol network
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Version (< lg) -->
    <div class="lg:hidden flex flex-col gap-6">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[28px] sm:text-[34px] leading-[1.15] tracking-[-0.5px]"
      >
        Slovakia E-Invoicing<br />Exchange Model
      </h2>

      <div
        class="w-full max-w-[460px] mx-auto rounded-2xl border border-neutral-300 bg-generic-00 p-4 sm:p-5 flex flex-col font-body"
        role="region"
        aria-label="Slovakia 5-corner exchange model mobile diagram"
      >
        <!-- Row 1: Corner 1 (Seller) and Corner 4 (Buyer) -->
        <div class="grid grid-cols-2 gap-3 sm:gap-4 items-stretch">
          <!-- Corner 1 (Seller) -->
          <div class="rounded-xl border border-neutral-300 bg-generic-00 p-3 sm:p-4 flex items-center gap-2.5 sm:gap-3">
            <span class="w-1 h-12 rounded-xs bg-nova-blue shrink-0" aria-hidden="true"></span>
            <div class="flex flex-col min-w-0">
              <p class="m-0 font-body font-medium uppercase text-neutral-500 text-xs leading-[1.33] tracking-[0.6px]">
                Corner 1
              </p>
              <p class="m-0 font-body font-semibold text-vault-navy text-base sm:text-lg leading-normal mt-1 truncate">
                Seller
              </p>
            </div>
          </div>

          <!-- Corner 4 (Buyer) -->
          <div class="rounded-xl border border-neutral-300 bg-generic-00 p-3 sm:p-4 flex items-center gap-2.5 sm:gap-3">
            <span class="w-1 h-12 rounded-xs bg-nova-blue shrink-0" aria-hidden="true"></span>
            <div class="flex flex-col min-w-0">
              <p class="m-0 font-body font-medium uppercase text-neutral-500 text-xs leading-[1.33] tracking-[0.6px]">
                Corner 4
              </p>
              <p class="m-0 font-body font-semibold text-vault-navy text-base sm:text-lg leading-normal mt-1 truncate">
                Buyer
              </p>
            </div>
          </div>
        </div>

        <!-- Connector Row 1: Seller ⇄ C2 and Buyer ⇄ C3 -->
        <div class="grid grid-cols-2 gap-3 sm:gap-4 my-4">
          <!-- Left: Invoice data ↓ / ↑ Response -->
          <div class="flex flex-col items-center">
            <svg class="w-6 h-5" viewBox="0 0 24 20" fill="none" aria-hidden="true">
              <line x1="7" y1="0" x2="7" y2="20" stroke="#5446ff" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
              <line x1="17" y1="0" x2="17" y2="20" stroke="#9ca3af" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
            </svg>
            <div class="flex flex-col items-center text-center py-3 font-body font-semibold uppercase text-xs leading-[1.33] tracking-[0.3px] whitespace-nowrap select-none">
              <span class="text-nova-blue flex items-center gap-1">Invoice data <svg width="9" height="12" viewBox="0 0 9 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.7562 11.8403L8.57442 8.02208C8.67378 7.9192 8.72876 7.78142 8.72752 7.6384C8.72628 7.49538 8.66891 7.35858 8.56778 7.25744C8.46664 7.15631 8.32984 7.09894 8.18682 7.0977C8.0438 7.09646 7.90602 7.15144 7.80314 7.2508L4.91602 10.1379L4.91602 0.54546C4.91602 0.400795 4.85855 0.262055 4.75626 0.159761C4.65397 0.0574679 4.51523 0 4.37056 0C4.2259 0 4.08716 0.0574679 3.98486 0.159761C3.88257 0.262055 3.8251 0.400795 3.8251 0.54546L3.8251 10.1379L0.937984 7.2508C0.887667 7.1987 0.827478 7.15715 0.76093 7.12856C0.694382 7.09997 0.622807 7.08493 0.550381 7.0843C0.477955 7.08367 0.40613 7.09747 0.339094 7.12489C0.272059 7.15232 0.211158 7.19282 0.159943 7.24404C0.108728 7.29525 0.0682259 7.35615 0.0407991 7.42319C0.0133734 7.49022 -0.0004282 7.56205 0.000201225 7.63447C0.00083065 7.7069 0.0158787 7.77848 0.044466 7.84502C0.0730524 7.91157 0.114606 7.97176 0.166703 8.02208L3.98492 11.8403C4.08721 11.9426 4.22593 12 4.37056 12C4.5152 12 4.65391 11.9426 4.7562 11.8403Z" fill="#5446FF"/>
                </svg>
              </span>
              <span class="text-neutral-500 flex items-center gap-1"><span class="text-[11px] sm:text-xs leading-none">↑</span> Response</span>
            </div>
            <svg class="w-6 h-5" viewBox="0 0 24 20" fill="none" aria-hidden="true">
              <line x1="7" y1="0" x2="7" y2="20" stroke="#5446ff" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
              <line x1="17" y1="0" x2="17" y2="20" stroke="#9ca3af" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
            </svg>
          </div>

          <!-- Right: ↑ Delivery confirmation / Invoice data ↓ -->
          <div class="flex flex-col items-center">
            <svg class="w-6 h-5" viewBox="0 0 24 20" fill="none" aria-hidden="true">
              <line x1="7" y1="0" x2="7" y2="20" stroke="#9ca3af" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
              <line x1="17" y1="0" x2="17" y2="20" stroke="#5446ff" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
            </svg>
            <div class="flex flex-col items-center text-center py-3 font-body font-semibold uppercase text-xs leading-[1.33] tracking-[0.3px] whitespace-nowrap select-none">
              <span class="text-neutral-500 flex items-center gap-1"><span class="text-[11px] sm:text-xs leading-none">↑</span> Delivery confirmation</span>
              <span class="text-nova-blue flex items-center gap-1">Invoice data <svg width="9" height="12" viewBox="0 0 9 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4.7562 11.8403L8.57442 8.02208C8.67378 7.9192 8.72876 7.78142 8.72752 7.6384C8.72628 7.49538 8.66891 7.35858 8.56778 7.25744C8.46664 7.15631 8.32984 7.09894 8.18682 7.0977C8.0438 7.09646 7.90602 7.15144 7.80314 7.2508L4.91602 10.1379L4.91602 0.54546C4.91602 0.400795 4.85855 0.262055 4.75626 0.159761C4.65397 0.0574679 4.51523 0 4.37056 0C4.2259 0 4.08716 0.0574679 3.98486 0.159761C3.88257 0.262055 3.8251 0.400795 3.8251 0.54546L3.8251 10.1379L0.937984 7.2508C0.887667 7.1987 0.827478 7.15715 0.76093 7.12856C0.694382 7.09997 0.622807 7.08493 0.550381 7.0843C0.477955 7.08367 0.40613 7.09747 0.339094 7.12489C0.272059 7.15232 0.211158 7.19282 0.159943 7.24404C0.108728 7.29525 0.0682259 7.35615 0.0407991 7.42319C0.0133734 7.49022 -0.0004282 7.56205 0.000201225 7.63447C0.00083065 7.7069 0.0158787 7.77848 0.044466 7.84502C0.0730524 7.91157 0.114606 7.97176 0.166703 8.02208L3.98492 11.8403C4.08721 11.9426 4.22593 12 4.37056 12C4.5152 12 4.65391 11.9426 4.7562 11.8403Z" fill="#5446FF"/>
              </svg>
              </span>
            </div>
            <svg class="w-6 h-5" viewBox="0 0 24 20" fill="none" aria-hidden="true">
              <line x1="7" y1="0" x2="7" y2="20" stroke="#9ca3af" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
              <line x1="17" y1="0" x2="17" y2="20" stroke="#5446ff" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
            </svg>
          </div>
        </div>

        <!-- Row 2: Corner 2 (ClearTax), Middle exchange arrows, and Corner 3 (ClearTax) -->
        <div class="flex items-center justify-between gap-1 sm:gap-2">
          <!-- Corner 2 (ClearTax - Seller's service provider) -->
          <div class="flex-1 min-w-0 rounded-xl border border-neutral-300 bg-generic-00 p-4 flex items-center gap-2 sm:gap-3">
            <span class="w-1 h-23  rounded-xs bg-[#10B981] shrink-0" aria-hidden="true"></span>
            <div class="flex flex-col min-w-0">
              <p class="m-0 font-body font-medium uppercase text-neutral-500 text-xs leading-[1.33] tracking-[0.6px]">
                Corner 2
              </p>
              <p class="m-0 font-body font-semibold text-vault-navy text-base sm:text-lg leading-normal mt-1 truncate">
                ClearTax
              </p>
              <p class="m-0 font-body text-neutral-500 text-sm leading-[1.42] mt-1">
                Seller’s service provider
              </p>
            </div>
          </div>

          <!-- Middle Connector: Exchange arrows and vertical stem -->
          <div class="relative w-8 sm:w-11 h-14 shrink-0 flex items-center justify-center">
            <svg class="w-full h-full overflow-visible" viewBox="0 0 36 56" fill="none" aria-hidden="true">
              <!-- Top arrow: pointing left from C3 to C2 -->
              <line x1="36" y1="18" x2="6" y2="18" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3" />
              <path d="M9 13 L3 18 L9 23" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />

              <!-- Bottom arrow: pointing right from C2 to C3 -->
              <line x1="0" y1="36" x2="30" y2="36" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3" />
              <path d="M27 31 L33 36 L27 41" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />

              <!-- Vertical stem branching down toward Acknowledgement -->
              <line x1="18" y1="36" x2="18" y2="108" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
            </svg>
          </div>

          <!-- Corner 3 (ClearTax - Buyer's service provider) -->
          <div class="flex-1 min-w-0 rounded-xl border border-neutral-300 bg-generic-00 p-4 flex items-center gap-2 sm:gap-3">
            <span class="w-1 h-23 rounded-xs bg-[#10B981] shrink-0" aria-hidden="true"></span>
            <div class="flex flex-col min-w-0">
              <p class="m-0 font-body font-medium uppercase text-neutral-500 text-xs leading-[1.33] tracking-[0.6px]">
                Corner 3
              </p>
              <p class="m-0 font-body font-semibold text-vault-navy text-base sm:text-lg leading-normal mt-1 truncate">
                ClearTax
              </p>
              <p class="m-0 font-body text-neutral-500 text-sm leading-[1.42] mt-1">
                Buyer’s service provider
              </p>
            </div>
          </div>
        </div>

        <!-- Acknowledgement pill -->
        <div class="flex justify-center mt-2.5 relative z-10">
          <div class="inline-flex items-center justify-center rounded-xl border-2 border-dashed border-[#10b981] bg-generic-00 px-3 py-1.5">
            <span class="font-body font-medium text-[#10B981] text-sm tracking-[1.42] whitespace-nowrap">
              Acknowledgement
            </span>
          </div>
        </div>

        <!-- Peppol network -->
        <div class="flex items-center justify-center gap-2.5 my-3">
          <img
            class="w-6 h-6 object-contain"
            src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae9ac0741c278990fdd5b3d_peppol.png"
            alt=""
            aria-hidden="true"
          />
          <span class="font-body font-medium text-black leading-[1.6] text-sm whitespace-nowrap">
            Peppol network
          </span>
        </div>

        <!-- Connector Row 2: C2 ⇄ C5 and C3 ⇄ C5 -->
        <div class="grid grid-cols-2 gap-3 sm:gap-4 my-2 sm:my-3">
          <!-- Left: ↓ Tax data document / Response message ↑ -->
          <div class="flex flex-col items-center">
            <svg class="w-6 h-5" viewBox="0 0 24 20" fill="none" aria-hidden="true">
              <line x1="7" y1="0" x2="7" y2="20" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
              <line x1="17" y1="0" x2="17" y2="20" stroke="#9ca3af" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
            </svg>
            <div class="flex flex-col items-center text-center py-3 font-body font-medium uppercase text-xs leading-[1.33] tracking-[0.3px] whitespace-nowrap select-none">
              <span class="text-[#10b981] flex items-center gap-1"><span class="text-[11px] sm:text-xs leading-none">↓</span> Tax data document</span>
              <span class="text-neutral-500 flex items-center gap-1">Response message <span class="text-[11px] sm:text-xs leading-none">↑</span></span>
            </div>
            <svg class="w-6 h-5" viewBox="0 0 24 20" fill="none" aria-hidden="true">
              <line x1="7" y1="0" x2="7" y2="20" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
              <line x1="17" y1="0" x2="17" y2="20" stroke="#9ca3af" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
            </svg>
          </div>

          <!-- Right: ↓ Tax data document / Response message ↑ -->
          <div class="flex flex-col items-center">
            <svg class="w-6 h-5" viewBox="0 0 24 20" fill="none" aria-hidden="true">
              <line x1="7" y1="0" x2="7" y2="20" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
              <line x1="17" y1="0" x2="17" y2="20" stroke="#9ca3af" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" />
            </svg>
            <div class="flex flex-col items-center text-center py-3 font-body font-medium uppercase text-xs leading-[1.33] tracking-[0.3px] whitespace-nowrap select-none">
              <span class="text-[#10b981] flex items-center gap-1"><span class="text-[11px] sm:text-xs leading-none">↓</span> Tax data document</span>
              <span class="text-neutral-500 flex items-center gap-1">Response message <span class="text-[11px] sm:text-xs leading-none">↑</span></span>
