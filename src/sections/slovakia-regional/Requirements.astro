---
/**
 * "Slovakia e-Invoicing: Key Requirements You Must Comply With" — Figma node
 * 18270:57879 ("Fold 3").
 *
 * Seven rows: 40px icon placeholder + title on the left, a muted paragraph on
 * the right (597px column), a 2px divider under every row including the last.
 * Same row shape as `bahrain-regional/Phases.astro`.
 *
 * The 40px squares are the Figma's unfilled icon placeholders — swap for
 * Webflow-hosted assets once the icons exist, never a `data:` URI.
 */
interface Row {
  title: string;
  body: string;
}

const rows: Row[] = [
  {
    title: "Transmission model",
    body: "Slovakia has a 5-corner Peppol CTC model. Invoices flow C1→C2→C3→C4. Tax data is reported to the authority within 5 days. ClearTax e-invoicing solution acts as the certified compliance layer on both the seller's and the buyer's side.",
  },
  {
    title: "Applicability",
    body: "All Slovak VAT payers must issue, and every taxable person must receive e-invoices for domestic B2B and B2G transactions only. No revenue threshold is applicable.",
  },
  {
    title: "Acceptable invoice formats",
    body: "Peppol BIS Billing 3.0 (UBL 2.1 XML), EN 16931 compliant. No national CIUS. PDFs and emails don't count.",
  },
  {
    title: "Real-Time TDD Reporting",
    body: "The Tax Data Document is built and reported to the Financial Administration automatically, inside the 5-day window — no manual reconciliation step.",
  },
  {
    title: "ERP-Native Integration",
    body: "Connects to SAP, Oracle, Microsoft Dynamics, and others without re-platforming. Typical go-live in 2–4 weeks.",
  },
  {
    title: "Archival",
    body: "10-year retention (20 years for real estate) built in — audit-ready without a separate archiving project.",
  },
  {
    title: "Penalties",
    body: "Up to €10,000 per breach. Up to €100,000 for repeat offences. Honest mistakes corrected promptly are not penalised.",
  },
];
---

<section class="bg-generic-00 py-12 lg:py-20">
  <div class="container mx-auto">
    <div class="flex flex-col gap-12">
      <h2
        class="m-0 mx-auto max-w-[684px] text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        Slovakia e-Invoicing: Key Requirements You Must Comply With
      </h2>

      <div class="flex flex-col">
        {
          rows.map((row, i) => (
            <div
              class:list={[
                "grid grid-cols-1 gap-4 border-b-2 border-[var(--border-divider,#f2f1f0)] pb-9 lg:grid-cols-[1fr_597px] lg:items-center lg:gap-8",
                i > 0 && "pt-9",
              ]}
            >
              <div class="flex items-center gap-6">
                <span
                  class="block h-10 w-10 shrink-0 rounded-md bg-visual-placeholder"
                  aria-hidden="true"
                />
                <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">
                  {row.title}
                </p>
              </div>
              <p class="m-0 font-body text-neutral-500/80 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                {row.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
