---

<section class="bg-white py-12 lg:py-25">
    <div class="lg:container mx-auto px-4 lg:px-6">
        <div class="w-full mb-12 mx-auto max-w-148 flex flex-col items-center">
              <h1
                class="inline-flex items-center gap-1.5 m-0 bg-[linear-gradient(90deg,_rgba(144,_68,_169,_0.2)_0%,_rgba(184,_126,_200,_0.2)_100%)] text-[#9144AB] leading-[1] text-xs font-normal px-4 py-2 rounded-full mb-4 text-center"
              >
                One platform
              </h1>
              <h2
                class="m-0 text-[26px] sm:text-[32px] lg:text-[44px] max-w-148 text-center font-semibold leading-[1.18] text-black"
              >
                One Platform.<span
                  class="text-[#655DFF]"
                  > Every Market.</span
                >
              </h2>
              <p class="max-w-148 text-base lg:text-lg mt-4 text-center text-black/80">
                Every mandate you're on the hook for — mapped, monitored and maintained in one place.
              </p>
              <a
                    href="javascript:void(0)"
                    onclick="scrollToContactForm(event)"
                    class="inline-flex items-center justify-center gap-2 px-12 py-2 mt-7 md:py-4 font-gilroy rounded-full font-semibold text-white text-base cursor-pointer bg-[linear-gradient(90deg,_#110072_0%,_#7A5698_100%)] border border-white/20"
                    style="outline: none;"
                >
                    Book A Demo 
                    <svg width="11" height="12" viewBox="0 0 11 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.576294 10.8L10.2056 0.800049M10.2056 9.35943V0.800049H1.64622H1.64171" stroke="white" stroke-width="1.6"/>
                    </svg>
                </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
            {features.map((feature) => (
          
                <div class={`${feature.bg} p-8 rounded-xl flex flex-col h-full min-h-[242px]`}>
                    <Fragment set:html={feature.icon} />
                    <div class="mt-auto">
                        <h3 class="text-xl lg:text-[22px] font-medium leading-[1.36]">{feature.title}</h3>
                        <p class="mt-3 text-black/80 font-normal text-base">{feature.desc}</p>
                    </div>
                </div>
            ))}
        </div>

        <div class="w-full bg-[#3388781F] rounded-lg">
            <div class="flex items-center gap-5 mt-7 premium-reveal [transition-delay:200ms]">
        
      </div>
      <div class="relative w-full">
        <!-- Scale Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-4 md:gap-0 border border-[#338878] rounded-lg px-7 py-5 text-center premium-reveal [transition-delay:250ms]">
          
          <!-- Scale 1 -->
          <div class="flex flex-col items-center px-2 sm:px-4 md:px-8 py-4 md:py-0">
            <h3 class="text-[22px] font-medium text-[#266458] leading-[1.36] mb-3 m-0">
              1Bn+
            </h3>
            <span class="text-sm sm:text-base text-[#266458] font-normal leading-normal">
              Invoices processed
            </span>
          </div>

          <!-- Scale 2 -->
          <div class="flex flex-col items-center px-2 sm:px-4 md:px-8 md:border-l border-[#266458] py-4 md:py-0">
            <h3 class="text-[22px] font-medium text-[#266458] leading-[1.36] mb-3 m-0">
              50+
            </h3>
            <span class="text-sm sm:text-base text-[#266458] font-normal leading-normal">
                Countries covered
            </span>
          </div>

          <!-- Scale 3 -->
          <div class="flex flex-col items-center px-2 sm:px-4 md:px-8 md:border-l border-[#266458] py-4 md:py-0">
            <h3 class="text-[22px] font-medium text-[#266458] leading-[1.36] mb-3 m-0">
              1B+
            </h3>
            <span class="text-sm sm:text-base text-[#266458] font-normal leading-normal">
              E-Invoices processed
            </span>
          </div>

          <!-- Scale 4 -->
          <div class="flex flex-col items-center px-2 sm:px-4 md:px-8 md:border-l border-[#266458] pt-4 md:pt-0">
            <h3 class="text-[22px] font-medium text-[#266458] leading-[1.36] mb-3 m-0">
              5000+
            </h3>
            <span class="text-sm sm:text-base text-[#266458] font-normal leading-normal">
              Enterprise clients 
            </span>
          </div>

        </div>

        <!-- Mobile Segmented Plus Dividers -->
        <!-- Top Vertical Divider Line -->
        <div class="absolute md:hidden left-1/2 -translate-x-1/2 bottom-[calc(50%+16px)] h-16 w-[1px] bg-black/28"></div>
        <!-- Bottom Vertical Divider Line -->
        <div class="absolute md:hidden left-1/2 -translate-x-1/2 top-[calc(50%+16px)] h-16 w-[1px] bg-black/28"></div>
        <!-- Left Horizontal Divider Line -->
        <div class="absolute md:hidden top-1/2 -translate-y-1/2 left-1/4 -translate-x-1/2 w-16 h-[1px] bg-black/28"></div>
        <!-- Right Horizontal Divider Line -->
        <div class="absolute md:hidden top-1/2 -translate-y-1/2 left-3/4 -translate-x-1/2 w-16 h-[1px] bg-black/28"></div>
      </div>
         </div>

    </div>
</section>

<style is:global>
    .dashed-line-horizontal {
        height: 2px;
        --clr-border: #A198EE;
        background-image: repeating-linear-gradient(90deg, var(--clr-border), var(--clr-border) 10px, transparent 10px, transparent 20px);
    }
    .dashed-line-vertical {
        width: 2px;
        --clr-border: #A198EE;
        background-image: repeating-linear-gradient(0deg, var(--clr-border), var(--clr-border) 10px, transparent 10px, transparent 20px);
    }
    .glow-pulse {
        animation: pulse-glow 2s infinite ease-in-out;
    }
    @keyframes pulse-glow {
        0% {
            box-shadow: 0 0 0 0 rgba(107, 92, 231, 0.6);
        }
        70% {
            box-shadow: 0 0 0 12px rgba(107, 92, 231, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(107, 92, 231, 0);
        }
    }
</style>
<script is:inline>
  window.scrollToContactForm = (e) => {
    e.preventDefault();
    const contactForm = document.getElementById('contact-form');
    if (contactForm) {
      contactForm.scrollIntoView({ behavior: 'smooth' });
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }
  };
</script>