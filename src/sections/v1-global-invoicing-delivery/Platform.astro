    { id: 3,
      title: 'Automatic, everywhere',
      desc: 'Nothing waits on your team when any mandate\'s requirement changes.',
      bg: 'bg-[#FCEBE3]',
      icon: '<svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="56" height="56" rx="9.88235" fill="#DC8F56" fill-opacity="0.12"/><path d="M28.0141 23.6666C25.3447 23.6666 23.1807 25.8306 23.1807 28.5C23.1807 31.1694 25.3447 33.3333 28.0141 33.3333C30.6834 33.3333 32.8474 31.1694 32.8474 28.5C32.8474 25.8306 30.6834 23.6666 28.0141 23.6666ZM41.5803 25.0509L40.2717 26.1282C38.7789 27.3571 38.7789 29.6429 40.2717 30.8717L41.5803 31.949C42.0441 32.3308 42.1638 32.9919 41.8635 33.5121L39.2795 37.9878C38.9791 38.508 38.3467 38.7348 37.7842 38.5241L36.1969 37.9295C34.3863 37.2512 32.4067 38.394 32.0888 40.3012L31.8102 41.9732C31.7115 42.5657 31.1988 43 30.5982 43H25.43C24.8294 43 24.3167 42.5657 24.218 41.9732L23.9393 40.3012C23.6215 38.394 21.6419 37.2512 19.8313 37.9295L18.244 38.5241C17.6815 38.7348 17.0491 38.508 16.7487 37.9878L14.1647 33.5121C13.8644 32.9919 13.9841 32.3308 14.4479 31.949L15.7566 30.8717C17.2493 29.6429 17.2493 27.3571 15.7566 26.1282L14.4479 25.0509C13.9841 24.6691 13.8644 24.008 14.1647 23.4878L16.7487 19.0121C17.0491 18.4919 17.6815 18.2651 18.244 18.4758L19.8313 19.0705C21.6419 19.7488 23.6215 18.6059 23.9393 16.6987L24.218 15.0267C24.3167 14.4343 24.8294 14 25.43 14H30.5982C31.1988 14 31.7115 14.4343 31.8102 15.0267L32.0888 16.6987C32.4067 18.6059 34.3863 19.7488 36.1969 19.0705L37.7842 18.4758C38.3467 18.2651 38.9791 18.4919 39.2795 19.0121L41.8635 23.4878C42.1638 24.008 42.0441 24.6691 41.5803 25.0509Z" stroke="#DC8F56" stroke-width="2.35724" stroke-miterlimit="10"/></svg>'
