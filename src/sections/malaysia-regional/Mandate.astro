---
/**
 * "Norway E-Invoicing Mandate at a glance" — Figma node 17103:83413
 * ("Container - Regulatory Timeline").
 *
 * Unlike the sticky-card stack used for the "at a glance" section on other
 * brand v2 regional pages (`spain-regional/Glance.astro`,
 * `france-regional/Mandate.astro`), the Norway Figma shows a flat single-
 * column list: an icon placeholder, a row label and a description, divided
 * by hairlines. Each row is the shared "Timeline" component (Figma node
 * 16433:24519) used standalone, not inside a scroll-pinned stack.
 *
 * Scroll-opacity focus effect ported from `france-product/RegulatoryTimeline.astro`:
 * the row nearest the vertical centre of the viewport sits at full opacity;
 * every other row rests at 50% opacity.
 * Mechanics (thin-band IntersectionObserver picking the closest row to the
 * centre line) are copied verbatim from that file — see its docblock for the
 * long-form rationale, originally from `global-homepage/Proven.astro`.
 *
 * The row icons use the matching Norway regional icon assets.
 */
interface Row {
    icon: string;
    label: string;
    sublabel?: string;
    desc: string;
}

const rows: Row[] = [
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af312f2bf2fbc7193268b29_icon-1.png",
        label: "Full MyInvois coverage",
        sublabel:
            "Issue and validate invoices, credit notes, debit notes, refund notes and self-billed e-invoices",
        desc: "through MyInvois, with digital signatures, UIDs and QR codes handled for you. B2C consolidation runs in the same flow.",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af312faffc1181c3d987e2d_icon-2.png",
        label: "Catch errors before LHDN does",
        sublabel:
            "AI-powered checks validate all 55 fields, TINs, classification codes and SST values",
        desc: "before an invoice is submitted. Real-time alerts and bulk correction clear rejections in minutes, not days.",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af313017c6e4839c9613390_icon-3.png",
        label: "Reconcile your books with LHDN",
        sublabel: "Match your ERP against MyInvois every month",
        desc: "with 13-field document matching and 150+ validations. Root-cause analysis shows why a mismatch happened, so you fix it before an audit does.",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af313074c7b4f12b76c8417_icon-4.png",
        label: "Ready for the end of relaxation",
        sublabel:
            "Move from consolidated to individual e-invoices for B2B and transactions above RM10,000",
        desc: "above RM10,000 without changing how your ERP works. ClearTax splits, validates and submits them automatically.",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af3130d1dd94f95aa9d75fa_icon-5.png",
        label: "Integrates with any ERP or POS",
        sublabel: "300+ integrations in Malaysia and 5,000+ worldwide",
        desc: "including SAP, Oracle, Microsoft, AutoCount, SQL and custom systems. Most businesses go live in weeks.",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af3131317fefd33bbbbfea5_icon-6.png",
        label: "A branded portal for your B2C customers",
        sublabel: "Let walk-in customers request a validated e-invoice",
        desc: "from your own self-service portal, instead of queueing at the counter or emailing your finance team.",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af3132591975217e22dcb83_icon-7.png",
        label: "LHDN updates, handled",
        sublabel: "When LHDN changes its guidelines or SDK",
        desc: "the update ships to you as a cloud release at no extra cost. You get notified of every change before it affects an invoice.",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af3132bb922cd3b8b111701_icon-8.png",
        label: "Malaysia now. 50+ countries next.",
        sublabel:
            "One platform and one API for Malaysia, Singapore, the Middle East and Europe.",
        desc: "Your Kuala Lumpur team gets 24/7 support in English and Bahasa Melayu, a dedicated success manager and in-house tax experts.",
    },
];
---

<section class="bg-generic-00 py-16 lg:py-20" data-no-glance>
    <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6">
        <h2
            class="m-0 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] max-w-[640px] mx-auto mb-4"
        >
            How ClearTax keeps you compliant with LHDN's e-invoicing mandate
        </h2>
        <p
            class="m-0 font-body text-center text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500 md:max-w-[640px] mx-auto"
        >
            One platform to issue, validate, reconcile and report every
            e-invoice in Malaysia, proven on 300 million MyInvois submissions.
        </p>
        <div class="flex flex-col">
            {
                rows.map((row, i) => (
                    <div
                        class:list={[
                            "no-glance-row flex flex-col justify-between gap-2 py-8 md:flex-row md:items-center md:gap-8",
                            i < rows.length - 1 &&
                                "border-b border-neutral-200",
                        ]}
                    >
                        <div class="grid shrink-0 grid-cols-[53px_minmax(0,1fr)] items-center lg:items-start gap-x-4 max-w-[590px] flex-1 md:grid-cols-[53px_minmax(0,1fr)]">
                            <img
                                src={row.icon}
                                width="52"
                                height="52"
                                alt=""
                                aria-hidden="true"
                                class="no-glance-icon h-[52px] w-[52px] shrink-0 object-contain"
                            />
                            <div class="contents md:flex md:min-w-0 md:flex-col md:gap-[2px]">
                                <span class="col-start-2 font-heading text-lg leading-[1.33] font-medium text-vault-navy">
                                    {row.label}
                                </span>
                                {row.sublabel && (
                                    <span class="col-span-2 max-sm:mt-4 block font-body text-sm leading-[length:var(--lh-body-lg)] text-neutral-500">
                                        {row.sublabel}
                                    </span>
                                )}
                            </div>
                        </div>
                        <p class="m-0 font-body text-sm leading-[length:var(--lh-body)] text-neutral-500 md:flex-1 max-w-[456px]">
                            {row.desc}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style is:global>
    /* Rows start dimmed; the row nearest the viewport's vertical centre is
     promoted to full opacity by the script below. */
    .no-glance-row {
        opacity: 0.5;
        transition:
            opacity 0.35s ease-in-out,
            transform 0.35s ease-in-out;
    }

    .no-glance-row.is-centered {
        opacity: 1;
    }

    .no-glance-row.is-scaled {
        transform: scale(1.01);
    }

    .no-glance-icon {
        transition: transform 0.35s ease-in-out;
    }

    .no-glance-row.is-scaled .no-glance-icon {
        transform: scale(1.05);
    }
</style>

<script is:inline>
    (function () {
        const root = document.querySelector("[data-no-glance]");
        if (!root) return;
        const rows = Array.from(root.querySelectorAll(".no-glance-row"));
        if (!rows.length) return;

        if (
            !("IntersectionObserver" in window) ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
            // No observer, or motion is unwelcome: every row full opacity rather
            // than the whole list sitting dimmed with nothing to light it.
            rows.forEach((el) => el.classList.add("is-centered"));
            return;
        }

        // A thin 1% band pinned across the middle of the viewport — "centred"
        // means the row the centre line is actually inside. The observer only
        // fires on a crossing, so a wide band could let the nearest row change
        // with nothing to trigger a recompute; kept thin, every change of row IS
        // a crossing. `inBand` holds the running set because two rows can
        // straddle the line for a frame; pick() resolves that by distance.
        let centred = null;
        const inBand = new Set();

        const pick = () => {
            // Nothing in the band means the middle has landed in a gap between
            // rows — hold the last choice instead of clearing, so the focus never
            // blinks off between rows.
            if (!inBand.size) return;

            const middle = window.innerHeight / 2;
            let best = null;
            let bestDistance = Infinity;

            inBand.forEach((el) => {
                const r = el.getBoundingClientRect();
                const distance = Math.abs((r.top + r.bottom) / 2 - middle);
                if (distance < bestDistance) {
                    bestDistance = distance;
                    best = el;
                }
            });

            if (!best || best === centred) return;
            if (centred) {
                centred.classList.remove("is-centered", "is-scaled");
            }
            centred = best;
            centred.classList.add("is-centered", "is-scaled");
        };

        const centreObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) inBand.add(entry.target);
                    else inBand.delete(entry.target);
                });
                pick();
            },
            { rootMargin: "-49.5% 0px -49.5% 0px", threshold: 0 },
        );

        rows.forEach((el) => centreObserver.observe(el));
    })();
</script>
