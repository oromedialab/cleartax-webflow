---
/**
 * "Australia e-invoicing at a glance"
 *
 * 2x2 grid of 4 cards:
 * - The first card is open by default; the others open only when clicked.
 * - Each card sizes independently to its own content (items-start).
 * - Clicking a card toggles only that card open/closed without stretching adjacent cards.
 * - Plus icon smoothly rotates to an "x" (45deg) when open.
 * - Single outer border (neutral-300) wraps the entire card.
 * - No extra inner border on button or content.
 * - No blue border on hover or select.
 *
 * Ids / data attributes are `au-glance-` prefixed.
 */
interface SupportCard {
    heading: string;
    body: string | string[];
}

const cards: SupportCard[] = [
    {
        heading: "Internal assessment",
        body: [
            "Confirm each entity's phase and whether the RM3 million exemption applies, including the group, shareholder and related-company tests.",
            "Map every ERP, billing system, POS and e-commerce channel that issues invoices, plus B2B, B2C and self-billed volumes.",
            "Review IT and finance bandwidth for integration work",
        ],
    },
    {
        heading: "Platform and vendor shortlisting (RFP)",
        body: ["Decide on platform type: a MyInvois-only connector, or one vendor for e-invoicing, reconciliation and AP automation.",
        "Use the RFP checklist and evaluation matrix to shortlist vendors.",
        "Run demos, sandbox tests and reference checks with Malaysian customers.",

    ],
    },
    {
        heading: "Compliance readiness review",
        body: [
            "Validate the 55 mandatory fields, TINs, classification codes and SST data against your ERP.",
            "List flows still using consolidation, and plan individual e-invoices for B2B and any transaction above RM10,000.",
            "Set up self-billing for imports, commissions and other in-scope payments.",
        ],    
    },
    {
        heading: "Integration and testing",
        body: [
            "Connect your ERP and POS to the platform and to MyInvois, with digital certificates in place.",
            "Test validation, rejections, cancellations within 72 hours, credit notes and B2C consolidation end to end.",
        ],    
    },
    {
        heading: "Go-live and monthly reconciliation",
        body: [
            "Go live entity by entity and track every rejection on one dashboard.",
            "Reconcile your books against MyInvois every month, before income tax and SST filings.",
        ],    
    },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
    <div class="max-w-[var(--container-max)] w-full px-4 md:px-6 mx-auto">
        <div class="flex flex-col w-full mb-6 lg:mb-12 mx-auto">
            <h2
                class="m-0 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
            >
                Get fully LHDN compliant in 5 steps
            </h2>
            <p
                class="m-0 max-w-2xl font-body mt-4 text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] text-center mx-auto"
            >
                Already live on MyInvois, or still relying on consolidation? Use these steps to close the gaps before an audit or the end of the relaxation period finds them.
            </p>
        </div>

        {
            /* 2x2 grid: items-start ensures only the selected/open card expands; closed cards stay compact without empty space */
        }
        <div class="grid grid-cols-1  gap-6 items-start">
            {
                cards.map((card, i) => {
                    const isDefaultOpen = i === 0;
                    return (
                        <div
                            class="group/card flex flex-col rounded-xl border border-neutral-300 bg-generic-00 overflow-hidden"
                            data-au-glance-card={i}
                        >
                            <button
                                type="button"
                                class={`group flex w-full cursor-pointer items-center justify-between gap-4 md:gap-6 p-6 text-left transition-all duration-150 ease-in-out bg-generic-00 border-0 outline-none focus:outline-none focus:ring-0 ${isDefaultOpen ? "pb-3" : ""}`}
                                data-au-glance-toggle={i}
                                aria-expanded={isDefaultOpen ? "true" : "false"}
                            >
                                <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                                    {card.heading}
                                </span>
                                <svg
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    class="shrink-0 text-vault-navy transition-transform duration-200 ease-in-out"
                                    aria-hidden="true"
                                    focusable="false"
                                    data-au-glance-icon={i}
                                    style={
                                        isDefaultOpen
                                            ? "transform: rotate(45deg);"
                                            : "transform: rotate(0deg);"
                                    }
                                >
                                    <path
                                        d="M12 5V19"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                    <path
                                        d="M5 12H19"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </button>
                            <div
                                class="grid overflow-hidden transition-[grid-template-rows,opacity] duration-300 ease-out border-0"
                                style={
                                    isDefaultOpen
                                        ? "grid-template-rows: 1fr; opacity: 1;"
                                        : "grid-template-rows: 0fr; opacity: 0;"
                                }
                                data-au-glance-content={i}
                                data-open={isDefaultOpen ? "true" : "false"}
                            >
                                <div class="overflow-hidden border-0">
                                    <div class="px-6 pb-6 pt-1">
                                        {
                                            Array.isArray(card.body) ? (
                                                <ul class="m-0 list-disc space-y-2 pl-5 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                                                    {card.body.map((item) => <li>{item}</li>)}
                                                </ul>
                                            ) : (
                                                <p class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                                                    {card.body}
                                                </p>
                                            )
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </div>
</section>

<script is:inline>
    (function () {
        function syncRowHeights() {
            if (window.innerWidth < 768) {
                for (var i = 0; i < 4; i++) {
                    var c = document.querySelector(
                        '[data-au-glance-card="' + i + '"]',
                    );
                    if (c) c.style.height = "";
                }
                return;
            }

            var rows = [
                [0, 1],
                [2, 3],
            ];

            rows.forEach(function (pair) {
                var cardA = document.querySelector(
                    '[data-au-glance-card="' + pair[0] + '"]',
                );
                var cardB = document.querySelector(
                    '[data-au-glance-card="' + pair[1] + '"]',
                );
                var contentA = document.querySelector(
                    '[data-au-glance-content="' + pair[0] + '"]',
                );
                var contentB = document.querySelector(
                    '[data-au-glance-content="' + pair[1] + '"]',
                );

                if (!cardA || !cardB || !contentA || !contentB) return;

                var openA = contentA.getAttribute("data-open") === "true";
                var openB = contentB.getAttribute("data-open") === "true";

                cardA.style.height = "";
                cardB.style.height = "";

                if (openA && openB) {
                    var h = Math.max(cardA.offsetHeight, cardB.offsetHeight);
                    cardA.style.height = h + "px";
                    cardB.style.height = h + "px";
                }
            });
        }

        function openCard(index) {
            var openContents = document.querySelectorAll(
                '[data-au-glance-content][data-open="true"]',
            );
            openContents.forEach(function (el) {
                var openIndex = el.getAttribute("data-au-glance-content");
                if (openIndex !== String(index)) {
                    closeCard(openIndex);
                }
            });

            var content = document.querySelector(
                '[data-au-glance-content="' + index + '"]',
            );
            var btn = document.querySelector(
                '[data-au-glance-toggle="' + index + '"]',
            );
            var icon = document.querySelector(
                '[data-au-glance-icon="' + index + '"]',
            );
            if (!content || !btn) return;

            var num = Number(index);
            var pairIndex = num % 2 === 0 ? num + 1 : num - 1;
            var thisCard = document.querySelector(
                '[data-au-glance-card="' + num + '"]',
            );
            var siblingCard = document.querySelector(
                '[data-au-glance-card="' + pairIndex + '"]',
            );
            if (thisCard) thisCard.style.height = "";
            if (siblingCard) siblingCard.style.height = "";

            content.style.gridTemplateRows = "1fr";
            content.style.opacity = "1";
            content.setAttribute("data-open", "true");
            btn.setAttribute("aria-expanded", "true");
            btn.classList.add("pb-3");
            if (icon) icon.style.transform = "rotate(45deg)";

            setTimeout(syncRowHeights, 320);
        }

        function closeCard(index) {
            var content = document.querySelector(
                '[data-au-glance-content="' + index + '"]',
            );
            var btn = document.querySelector(
                '[data-au-glance-toggle="' + index + '"]',
            );
            var icon = document.querySelector(
                '[data-au-glance-icon="' + index + '"]',
            );
            if (!content || !btn) return;

            var num = Number(index);
            var pairIndex = num % 2 === 0 ? num + 1 : num - 1;
            var thisCard = document.querySelector(
                '[data-au-glance-card="' + num + '"]',
            );
            var siblingCard = document.querySelector(
                '[data-au-glance-card="' + pairIndex + '"]',
            );
            if (thisCard) thisCard.style.height = "";
            if (siblingCard) siblingCard.style.height = "";

            content.style.gridTemplateRows = "0fr";
            content.style.opacity = "0";
            content.setAttribute("data-open", "false");
            btn.setAttribute("aria-expanded", "false");
            btn.classList.remove("pb-3");
            if (icon) icon.style.transform = "rotate(0deg)";

            setTimeout(syncRowHeights, 320);
        }

        function toggle(index) {
            var content = document.querySelector(
                '[data-au-glance-content="' + index + '"]',
            );
            if (!content) return;

            var isOpen = content.getAttribute("data-open") === "true";

            if (isOpen) {
                closeCard(index);
            } else {
                openCard(index);
            }
        }

        document.addEventListener("click", function (e) {
            if (!e.target.closest) return;
            var toggleBtn = e.target.closest("[data-au-glance-toggle]");
            if (!toggleBtn) return;
            var index = toggleBtn.getAttribute("data-au-glance-toggle");
            toggle(index);
        });

        window.addEventListener("resize", syncRowHeights);
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", syncRowHeights);
        } else {
            syncRowHeights();
        }
        window.addEventListener("load", syncRowHeights);
    })();
</script>
