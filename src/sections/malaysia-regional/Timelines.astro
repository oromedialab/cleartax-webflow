---
/**
 * "Key timelines" and "What paper and PDF invoices cost you" tables.
 *
 * Australia regional page section:
 * 1. Key timelines table:
 *    - 3 columns: Date, Milestone, Who it applies to
 *    - 7 milestone rows detailing ATO Peppol adoption through 2026
 * 2. What paper and PDF invoices cost you table:
 *    - 2 columns: For suppliers (AR), For buyers (AP)
 *    - 4 rows comparing supplier vs buyer friction with paper/PDF invoicing
 */

interface TimelineRow {
    date: string;
    milestone: string;
    appliesTo: string;
}

interface CostRow {
    supplier: string;
    buyer: string;
}

const timelines: TimelineRow[] = [
    {
        date: "1 Aug 2024",
        milestone: "Phase 1 go-live (relaxation to 31 Jan 2025)",
        appliesTo: "Turnover above RM100 million",
    },
    {
        date: "1 Jan 2025",
        milestone:
            "Phase 2 go-live (relaxation to 30 Jun 2025)",
        appliesTo: "Turnover RM25 million to RM100 million",
    },
    {
        date: "1 Jul 2025",
        milestone: "Phase 3 go-live (relaxation to 31 Dec 2025)",
        appliesTo: "Turnover RM5 million to RM25 million",
    },
    {
        date: "1 Jan 2026",
        milestone: "Phase 4 go-live",
        appliesTo: "Turnover up to RM5 million, unless exempt",
    },
    {
        date: "1 Sep 2026",
        milestone:
            "Exemption threshold raised from RM1 million to RM3 million",
        appliesTo: "Businesses below RM3 million that meet the criteria",
    },
    {
        date: "31 Dec 2027",
        milestone:
            "Phase 4 relaxation period ends",
        appliesTo: "Phase 4 businesses still consolidating",
    },
];

const costs: CostRow[] = [
    {
        supplier:
            "Fine of RM200 to RM20,000 per offence under Section 120(1)(d) of the Income Tax Act 1967",
        buyer: "Buyers can't support expense claims without a validated e-invoice.",
    },
    {
        supplier:
            "Up to six months' imprisonment, or both",
        buyer: "Rejected invoices hold up payment and cash flow",
    },
    {
        supplier: "Each non-compliant invoice can count as a separate offence",
        buyer: "ERP-vs-LHDN mismatches trigger audits of income tax and SST",
    },
    {
        supplier: "No penalty relief once your relaxation period ends",
        buyer: "Large customers drop suppliers who can't issue e-invoices",
    },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
    <div class="max-w-[var(--container-max)] w-full px-4 md:px-6 mx-auto">
        <div class="w-full mb-16 lg:mb-20">
            <h2
                class="m-0 font-heading text-left md:text-center mx-auto font-medium text-vault-navy text-[length:var(--fs-h4)] leading-[length:var(--lh-h4)] tracking-[-0.5px] mb-6 md:mb-8"
            >
                Key timelines
            </h2>

            {/* Desktop Table */}
            <div
                class="hidden md:block w-full overflow-x-auto rounded-2xl border border-neutral-300 bg-generic-00"
            >
                <table class="w-full min-w-[720px] border-collapse text-left">
                    <thead>
                        <tr class="border-b border-neutral-200">
                            <th
                                class="py-5 px-6 md:px-8 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] w-[16%]"
                            >
                                Date
                            </th>
                            <th
                                class="py-5 px-6 md:px-8 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] w-[54%]"
                            >
                                Milestone
                            </th>
                            <th
                                class="py-5 px-6 md:px-8 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] w-[30%]"
                            >
                                Who it applies to
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            timelines.map((row) => (
                                <tr class="align-top border-b border-neutral-200">
                                    <td class="py-4 md:py-5 px-6 md:px-8 font-heading font-normal text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                                        {row.date}
                                    </td>
                                    <td class="py-4 md:py-5 px-6 md:px-8 font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] pr-12">
                                        {row.milestone}
                                    </td>
                                    <td class="py-4 md:py-5 px-6 md:px-8 font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                                        {row.appliesTo}
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>

            {/* Mobile View: 2-column combined layout */}
            <div
                class="block md:hidden w-full rounded-2xl border border-neutral-300 bg-generic-00 overflow-hidden"
            >
                <div
                    class="border-b border-neutral-200 py-3.5 px-4 flex items-center bg-generic-00"
                >
                    <div
                        class="w-[95px] sm:w-[110px] shrink-0 font-heading font-medium text-vault-navy text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]"
                    >
                        Date
                    </div>
                    <div
                        class="flex-1 pl-3 sm:pl-4 font-heading font-medium text-vault-navy text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]"
                    >
                        Milestone &middot; Who it applies to
                    </div>
                </div>
                <div class="divide-y divide-neutral-200">
                    {
                        timelines.map((row) => (
                            <div class="py-4 px-4 flex items-start">
                                <div class="w-[95px] sm:w-[110px] shrink-0 font-heading font-medium text-vault-navy text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                                    {row.date}
                                </div>
                                <div class="flex-1 pl-3 sm:pl-4 flex flex-col gap-1.5">
                                    <p class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                                        {row.milestone}
                                    </p>
                                    <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                                        {row.appliesTo}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
            <p class="font-heading text-base m-0 mt-2 text-[#6B7280] font-medium leading-normal">Turnover is based on audited revenue for FY2022 for existing businesses.</p>
        </div>

        <div class="w-full">
            <h2
                class="m-0 font-heading font-medium text-left md:text-center mx-auto text-vault-navy text-[length:var(--fs-h4)] leading-[length:var(--lh-h4)] tracking-[-0.5px] mb-6"
            >
                What non-compliance costs
            </h2>

            {/* Desktop Table */}
            <div
                class="hidden md:block w-full overflow-x-auto rounded-2xl border border-neutral-300 bg-generic-00"
            >
                <table class="w-full min-w-[640px] border-collapse text-left">
                    <thead>
                        <tr class="border-b border-neutral-200">
                            <th
                                class="py-5 px-6 md:px-8 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] w-1/2"
                            >
                                Penalties
                            </th>
                            <th
                                class="py-5 px-6 md:px-8 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] w-1/2"
                            >
                                Business risks
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            costs.map((row) => (
                                <tr class="align-top border-b border-neutral-200">
                                    <td class="py-4 md:py-5 px-6 md:px-8 font-body font-normal text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] pr-8 md:pr-12">
                                        {row.supplier}
                                    </td>
                                    <td class="py-4 md:py-5 px-6 md:px-8 font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] pr-8 md:pr-12">
                                        {row.buyer}
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>

            {/* Mobile View: Tabs + Bulleted Cards */}
            <div class="block md:hidden w-full">
                <div
                    role="tablist"
                    aria-label="Non-compliance costs by category"
                    class="flex bg-neutral-100 p-1.5 rounded-2xl mb-4 gap-1"
                >
                    <button
                        type="button"
                        role="tab"
                        id="my-cost-tab-penalties"
                        aria-selected="true"
                        aria-controls="my-cost-panel-penalties"
                        data-my-cost-tab="penalties"
                        class="flex-1 py-2.5 px-3 rounded-xl text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium transition-all text-center bg-generic-00 border-0 cursor-pointer text-nova-blue"
                    >
                        Penalties
                    </button>
                    <button
                        type="button"
                        role="tab"
                        id="my-cost-tab-business-risks"
                        aria-selected="false"
                        aria-controls="my-cost-panel-business-risks"
                        data-my-cost-tab="business-risks"
                        class="flex-1 py-2.5 px-3 rounded-xl text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-medium transition-all border-0 bg-transparent text-center cursor-pointer text-neutral-700"
                    >
                        Business risks
                    </button>
                </div>

                <div
                    role="tabpanel"
                    id="my-cost-panel-penalties"
                    aria-labelledby="my-cost-tab-penalties"
                    data-my-cost-panel="penalties"
                    class="flex flex-col gap-3"
                >
                    {
                        costs.map((row) => (
                            <div class="rounded-2xl border border-neutral-300 bg-generic-00 p-4 sm:p-5 flex items-start gap-3">
                                <span
                                    class="text-nova-blue font-bold text-base leading-none shrink-0 select-none mt-0.5"
                                    aria-hidden="true"
                                >
                                    &bull;
                                </span>
                                <p class="m-0 font-body text-vault-navy text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                                    {row.supplier}
                                </p>
                            </div>
                        ))
                    }
                </div>

                <div
                    role="tabpanel"
                    id="my-cost-panel-business-risks"
                    aria-labelledby="my-cost-tab-business-risks"
                    data-my-cost-panel="business-risks"
                    class="hidden flex-col gap-3"
                >
                    {
                        costs.map((row) => (
                            <div class="rounded-2xl border border-neutral-300 bg-generic-00 p-4 sm:p-5 flex items-start gap-3">
                                <span
                                    class="text-nova-blue font-bold text-base leading-none shrink-0 select-none mt-0.5"
                                    aria-hidden="true"
                                >
                                    &bull;
                                </span>
                                <p class="m-0 font-body text-vault-navy text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                                    {row.buyer}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    (function () {
        const tabs = document.querySelectorAll("[data-my-cost-tab]");
        const panels = document.querySelectorAll("[data-my-cost-panel]");

        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const target = tab.getAttribute("data-my-cost-tab");

                tabs.forEach((t) => {
                    const isSelected =
                        t.getAttribute("data-my-cost-tab") === target;
                    t.setAttribute(
                        "aria-selected",
                        isSelected ? "true" : "false",
                    );
                    if (isSelected) {
                        t.classList.remove(
                            "text-neutral-700",
                            "bg-transparent",
                        );
                        t.classList.add("bg-generic-00", "text-nova-blue");
                    } else {
                        t.classList.remove("bg-generic-00", "text-nova-blue");
                        t.classList.add("text-neutral-700", "bg-transparent");
                    }
                });

                panels.forEach((panel) => {
                    const isMatch =
                        panel.getAttribute("data-my-cost-panel") === target;
                    if (isMatch) {
                        panel.classList.remove("hidden");
                        panel.classList.add("flex");
                    } else {
                        panel.classList.remove("flex");
                        panel.classList.add("hidden");
                    }
                });
            });
        });
    })();
</script>
