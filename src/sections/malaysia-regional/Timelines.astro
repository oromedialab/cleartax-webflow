---
/**
 * "Key timelines" and "What paper and PDF invoices cost you" tables.
 *
 * Australia regional page section:
 * 1. Key timelines table:
 *    - 3 columns: Date, Milestone, Who it applies to
 *    - 7 milestone rows detailing ATO Peppol adoption through 2026
 * 2. What paper and PDF invoices cost you table:
 *    - 2 columns: For suppliers (AR), For buyers (AP)
 *    - 4 rows comparing supplier vs buyer friction with paper/PDF invoicing
 */

interface TimelineRow {
    date: string;
    milestone: string;
    appliesTo: string;
}

interface CostRow {
    supplier: string;
    buyer: string;
}

const timelines: TimelineRow[] = [
    {
        date: "1 Aug 2024",
        milestone: "Phase 1 go-live (relaxation to 31 Jan 2025)",
        appliesTo: "Turnover above RM100 million",
    },
    {
        date: "1 Jan 2025",
        milestone:
            "Phase 2 go-live (relaxation to 30 Jun 2025)",
        appliesTo: "Turnover RM25 million to RM100 million",
    },
    {
        date: "1 Jul 2025",
        milestone: "Phase 3 go-live (relaxation to 31 Dec 2025)",
        appliesTo: "Turnover RM5 million to RM25 million",
    },
    {
        date: "1 Jan 2026",
        milestone: "Phase 4 go-live",
        appliesTo: "Turnover up to RM5 million, unless exempt",
    },
    {
        date: "1 Sep 2026",
        milestone:
            "Exemption threshold raised from RM1 million to RM3 million",
        appliesTo: "Businesses below RM3 million that meet the criteria",
    },
    {
        date: "31 Dec 2027",
        milestone:
            "Phase 4 relaxation period ends",
        appliesTo: "Phase 4 businesses still consolidating",
    },
];

const costs: CostRow[] = [
    {
        supplier:
            "Fine of RM200 to RM20,000 per offence under Section 120(1)(d) of the Income Tax Act 1967",
        buyer: "Buyers can't support expense claims without a validated e-invoice.",
    },
    {
        supplier:
            "Up to six months' imprisonment, or both",
        buyer: "Rejected invoices hold up payment and cash flow",
    },
    {
        supplier: "Each non-compliant invoice can count as a separate offence",
        buyer: "ERP-vs-LHDN mismatches trigger audits of income tax and SST",
    },
    {
        supplier: "No penalty relief once your relaxation period ends",
        buyer: "Large customers drop suppliers who can't issue e-invoices",
    },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
    <div class="max-w-[var(--container-max)] w-full px-4 md:px-6 mx-auto">
        <div class="w-full mb-16 lg:mb-20">
            <h2
                class="m-0 font-heading text-center mx-auto font-medium text-vault-navy text-[length:var(--fs-h4)] leading-[length:var(--lh-h4)] tracking-[-0.5px] mb-8"
            >
                Key timelines
            </h2>

            <div
                class="w-full overflow-x-auto rounded-2xl border border-neutral-300 bg-generic-00"
            >
                <table class="w-full min-w-[720px] border-collapse text-left">
                    <thead>
                        <tr class="border-b border-neutral-200">
                            <th
                                class="py-5 px-6 md:px-8 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] w-[16%]"
                            >
                                Date
                            </th>
                            <th
                                class="py-5 px-6 md:px-8 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] w-[54%]"
                            >
                                Milestone
                            </th>
                            <th
                                class="py-5 px-6 md:px-8 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] w-[30%]"
                            >
                                Who it applies to
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            timelines.map((row) => (
                                <tr class="align-top border-b border-neutral-200">
                                    <td class="py-4 md:py-5 px-6 md:px-8 font-heading font-normal text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                                        {row.date}
                                    </td>
                                    <td class="py-4 md:py-5 px-6 md:px-8 font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] pr-12">
                                        {row.milestone}
                                    </td>
                                    <td class="py-4 md:py-5 px-6 md:px-8 font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                                        {row.appliesTo}
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
            <p class="font-heading text-base m-0 mt-2 text-[#6B7280] font-medium leading-normal">Turnover is based on audited revenue for FY2022 for existing businesses.</p>
        </div>

        <div class="w-full">
            <h2
                class="m-0 font-heading font-medium text-center mx-auto text-vault-navy text-[length:var(--fs-h4)] leading-[length:var(--lh-h4)] tracking-[-0.5px] mb-6"
            >
                What non-compliance costs
            </h2>

            <div
                class="w-full overflow-x-auto rounded-2xl border border-neutral-300 bg-generic-00"
            >
                <table class="w-full min-w-[640px] border-collapse text-left">
                    <thead>
                        <tr class="border-b border-neutral-200">
                            <th
                                class="py-5 px-6 md:px-8 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] w-1/2"
                            >
                                Penalties
                            </th>
                            <th
                                class="py-5 px-6 md:px-8 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] w-1/2"
                            >
                                Business risks
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            costs.map((row) => (
                                <tr class="align-top border-b border-neutral-200">
                                    <td class="py-4 md:py-5 px-6 md:px-8 font-body font-normal text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] pr-8 md:pr-12">
                                        {row.supplier}
                                    </td>
                                    <td class="py-4 md:py-5 px-6 md:px-8 font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] pr-8 md:pr-12">
                                        {row.buyer}
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
