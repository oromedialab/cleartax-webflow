---
/**
 * France regional hero — Figma node 13600:27940.
 *
 * Background is the interactive stroke field from
 * `sections/global-homepage/Hero.astro` (originally
 * `sections/blog-listing/Newsletter.astro`, which carries the full explanation of
 * the geometry): a plain grid of lime dots until a pointer enters, at which point
 * each dot draws out into a stroke aimed at the cursor, longest beside it and back
 * to a dot by `lengthRadius`. Same four gradient layers over it — page gradient,
 * radial wash behind the copy, a mobile-only top fade, and a bottom fade.
 *
 * Ids and the canvas id are `fr-` prefixed rather than the `hero` /
 * `hero-dots-canvas` older files use, because embeds share one namespace per page
 * and a bare `hero` is exactly the kind of name that collides later.
 *
 * The three badges carry a 37px `bg-visual-placeholder` square where the Figma
 * has an unfilled "Icon placeholder" frame. Swap each for a Webflow-hosted asset
 * once the icons exist — never a `data:` URI, which would blow the paste cap.
 */
interface Props {
    /** Stroke width, and so the diameter of the dot it becomes at rest. */
    lineWidth?: number;
    gap?: number;
    /** Must stay under the grid pitch or the field knits into a mesh. */
    maxLength?: number;
    lengthRadius?: number;
    /** Leave at 1 — a partial turn makes strokes flip as the cursor crosses them. */
    tilt?: number;
    baseColor?: string;
    cursorRadius?: number;
    pull?: number;
    fadeRadius?: number;
}

const {
    lineWidth = 3,
    gap = 24,
    maxLength = 6,
    lengthRadius = 260,
    tilt = 1,
    baseColor = "#C8F006",
    cursorRadius = 320,
    pull = 14,
    fadeRadius = 40,
} = Astro.props;

const badges = [
    {
        title: "300M+ LHDN e-invoices",
        description: "processed, about 15% of Malaysia's volume",
    },
    {
        title: "Integrates with any ERP or POS",
        description: "including SAP, Oracle, Microsoft, AutoCount and SQL",
    },
    {
        title: "Local team in Kuala Lumpur",
        description: "Local team in Kuala Lumpur",
    },
];
---

