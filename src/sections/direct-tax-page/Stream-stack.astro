                    tl.set(stageBigFolder, { opacity: 0, scale: 1 }, finalHoldEnd + 0.25);
                }
                if (bigFolderWrapper) {
                    tl.set(bigFolderWrapper, { x: 0, y: 0, scale: 1, rotation: 0 }, finalHoldEnd + 0.25);
                }

                if (stageGrid) {
                    tl.set(stageGrid, { opacity: 0, scale: 1 }, finalHoldEnd + 0.25);
                    if (gridTiles.length) tl.set(gridTiles, { x: 0, y: 0, opacity: 0, scale: 0.25 }, finalHoldEnd + 0.25);
                }

                if (stageCards) {
                    tl.set(stageCards, { opacity: 0 }, finalHoldEnd + 0.25);
                    var allCardsReset = [card1, card2, card3, card4].filter(Boolean);
                    if (allCardsReset.length) {
                        tl.set(allCardsReset, {
                            opacity: 0,
                            scale: 0.94,
                            minHeight: 120,
                            flexGrow: 1,
                        }, finalHoldEnd + 0.25);
                    }
                    var allContentsReset = [cardContent1, cardContent2, cardContent3, cardContent4].filter(Boolean);
                    if (allContentsReset.length) {
                        tl.set(allContentsReset, { opacity: 0, y: -16 }, finalHoldEnd + 0.25);
                    }
                }

                if (folderPacked) {
                    tl.set(folderPacked, { opacity: 0 }, finalHoldEnd + 0.25);
                    tl.set(emptyFolderElements, { opacity: 1 }, finalHoldEnd + 0.25);
