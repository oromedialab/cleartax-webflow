---
const asideMenu = [
    { label: "GL - Stream" },
    { label: "TDS Filing" },
    { label: "Expense Rationalisation" },
    { label: "26AS Reconciliation" },
];

const cardsData = [
    {
        tag: "TDS Workbench · GL-Stream",
        title: "100% of your GL data in Cleartax. Trial balance verified.",
        description:
            "GL-Stream ingests raw general ledger data from SAP, Oracle, or Dynamics 365 and verifies every debit and credit against the trial balance — creating a trusted foundation for downstream filings.",
        points: [
            {
                label: "Trial balance match: 100%",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61ebd1dd0b327e9899bf7_icon-1.png",
            },
            {
                label: "SAP · Oracle · Dynamics 365",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61ed10f6e1822b8d1c14b_icon-2.png",
            },
            {
                label: "Data prep: 2 days → 2 mins",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61ed775ae303a1c063012_icon-3.png",
            },
        ],
    },
    {
        tag: "TDS Filing",
        title: "End-to-end TDS filing with 200+ validations. ",
        description:
            "Auto-import TDS payable deductions, net off advances, provisions, and reversals, and run 200+ checks across PAN status, LDC limits, and 206AB compliance. Generate FVU files for 3M+ rows in 30 minutes.",
        points: [
            {
                label: "200+ pre-filing validations",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61eddb67b530c663e9aef_icon-4.png",
            },
            {
                label: "FVU: 3M rows in 30 mins",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61ee39d9e882bf57a3fec_icon-5.png",
            },
            {
                label: "Auto net-off of advances & reversals",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61ee7be4ce54d09d8d2df_icon-6.png",
            },
        ],
    },
    {
        tag: "Expense Rationalisation · Clause 34",
        title: "AI validates every TDS section. Audit-ready from day one.",
        description:
            "AI analyses vendor and expense data to validate the correct TDS section, surfacing section variances, missed deductions, and rate discrepancies before filing.",
        points: [
            {
                label: "AI section variance detection",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61eedb4dc093e37aef310_icon-7.png",
            },
            {
                label: "Clause 34 exception report",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61ef2d1c09d7199b62f8c_icon-8.png",
            },
            {
                label: "GRN ←→ IRN auto-linkage",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61f529d9e882bf57a9832_icon-9.png",
            },
        ],
    },
    {
        tag: "26AS Reconciliation",
        title: "Match 40,000+ 26AS records in under 2 hours.",
        description:
            "Automate Many:Many, Best-Fit, Cross-FY, and PAN ←→ TAN matching. Intelligent sub-bucketing guides unmatched records, helping teams reconcile monthly and recover working capital faster.",
        points: [
            {
                label: "Many:Many & Best-Fit matching",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61f57cf7aa0d356a8f918_icon-10.png",
            },
            {
                label: "Match rate: 50% → 80%+",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61f69f2396ebf1ff3c421_icon-11.png",
            },
            {
                label: "Auto PAN ←→ TAN mapping",
                cardIcon:
                    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac61f603e8b494eb0c3d0c2_icon-12.png",
            },
        ],
    },
];
---

<section class="sc-invoice-stack-section py-12 md:py-16 bg-generic-00">
    <div class="max-w-[var(--container-max)] mx-auto w-full px-4 md:px-6">
        <!-- Section Header (Scrolls away naturally) -->
        <div
            id="sc-invoice-header-text"
            class="text-center w-full mx-auto mb-8 md:mb-12 bg-generic-00"
        >
            <h2
                class="font-heading font-medium text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] text-text-default max-w-250 mx-auto m-0 mb-3"
            >
                Infrastructure <span
                    class="text-generic-100 bg-flux-lime px-1 rounded-lg"
                    >That Grows</span
                > With You
            </h2>
            <p
                class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-neutral-500 max-w-140 font-normal mx-auto"
            >
                From the first return to millions of invoices across every
                jurisdiction — our platform handles it without blinking.
            </p>
        </div>

        <!-- Main Stack Layout Grid -->
        <div
            class="relative max-w-[1280px] mx-auto w-full flex flex-col md:flex-row gap-6 lg:gap-10 items-start"
        >
            <!-- Aside Menu (Sticky Left Sidebar) -->
            <div
                id="sc-aside-menu"
                class="hidden md:flex flex-col gap-3 w-40 lg:w-48 shrink-0 sticky z-30 pt-2 pointer-events-auto will-change-transform"
                style="top: calc(var(--nav-clear, 112px) + 8px);"
            >
                {
                    asideMenu.map((item, btnIdx) => (
                        <button
                            type="button"
                            class={`sc-aside-menu-item text-left border-l-2 pl-3.5 py-0.5 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-body transition-colors duration-200 cursor-pointer bg-transparent border-t-0 border-r-0 border-b-0 outline-none ${
                                btnIdx === 0
                                    ? "active-aside border-[#655DFF] text-text-default font-medium"
                                    : "border-transparent text-text-default/28 font-normal"
                            }`}
                            data-card-index={btnIdx}
                        >
                            {item.label}
                        </button>
                    ))
                }
            </div>

            <!-- Cards Stack (Right Column) -->
            <div
                id="sc-invoice-stack-container"
                class="invoice-stack flex-1 w-full flex flex-col gap-[30vh] md:gap-[50vh]"
            >
                {
                    cardsData.map((card, index) => (
                        <div
                            class="invoice-stack-sticky sticky"
                            style={`top: calc(var(--nav-clear, 112px) + ${index * 16}px); z-index: ${index};`}
                        >
                            <div
                                class="invoice-stack-card w-full border-2 border-neutral-300 rounded-xl overflow-hidden min-h-[372px] md:min-h-0 md:h-[400px] bg-generic-00 will-change-transform flex flex-col md:flex-row md:justify-between"
                                style="transform-origin: top center;"
                            >
                                <div class="flex-1 p-5 sm:p-6 flex flex-col justify-between items-start">
                                    <div class="w-full">
                                        {card.tag && (
                                            <h6 class="font-body font-medium text-nova-blue text-[length:var(--fs-body)] leading-[length:var(--lh-body)] mb-4">
                                                {card.tag}
                                            </h6>
                                        )}
                                        <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-2 md:mb-3 text-text-default font-medium">
                                            {card.title}
                                        </h3>
                                        <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] font-normal max-w-xl">
                                            {card.description}
                                        </p>
                                    </div>
                                    <div class="mt-4 md:mt-auto grid grid-cols-1 lg:grid-cols-2 gap-x-3 sm:gap-x-4 lg:gap-x-6 xl:gap-x-8 gap-y-3 xl:gap-y-6 w-full pt-2">
                                        {card.points.map((point) => (
                                            <div class="flex items-center gap-1 xl:gap-2 md:gap-1 min-w-0">
                                                <div class="w-5 h-5 md:w-6 md:h-6 rounded-sm shrink-0">
                                                    <img
                                                        class="w-full h-full object-contain"
                                                        src={point.cardIcon}
                                                        alt=""
                                                        loading="lazy"
                                                        decoding="async"
                                                    />
                                                </div>
                                                <span class="font-body text-[12px] leading-[16px] md:text-[14px] md:leading-[20px] xl:text-[length:var(--fs-body)] xl:leading-[length:var(--lh-body)] font-normal text-neutral-500 whitespace-nowrap">
                                                    {point.label}
                                                </span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                                <div class="sc-card-visual-wrap w-full md:w-[48%] lg:w-[46%] px-3 sm:px-4 md:px-5 pt-3 md:pt-6 pb-3 md:pb-6 flex flex-col justify-center">
                                    {index === 0 ? (
                                        <!-- GL - Stream Animation Canvas -->
                                        <div
                                            class="gl-stream-visual-canvas relative w-full h-full min-h-[280px] md:min-h-0 rounded-xl md:rounded-2xl border border-neutral-200 bg-generic-00 flex items-end justify-center px-3 sm:px-4 pt-3 sm:pt-4 pb-2 sm:pb-3 select-none bg-cover bg-center bg-no-repeat shadow-xs"
                                            style="background-image:url('https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab399f1e2c6a1e38c91700f_dots-bg.png'); overflow:visible;"
                                            data-gl-visual
                                        >
                                            <!-- Ambient Glow from WhyGenericAi -->
                                            <div
                                                class="pointer-events-none absolute inset-0 z-0"
                                                style="background: radial-gradient(ellipse 65% 50% at 50% 50%, rgba(212, 248, 66, 0.24) 0%, rgba(212, 248, 66, 0) 70%);"
                                            />

                                            <!-- ============================================== -->
                                            <!-- STAGE 1 & 2: FOLDER & FALLING APP ICONS        -->
                                            <!-- (Toggle opacity-100 / opacity-0 for testing)   -->
                                            <!-- ============================================== -->
                                            <div class="gl-stage-folder relative z-10 w-full max-w-[280px] sm:max-w-[320px] h-full min-h-[240px] sm:min-h-[270px] max-h-[310px] flex flex-col items-center justify-end pb-0">
                                                <!-- Floating App Badges Layer -->
                                                <div class="gl-app-icons-container absolute inset-x-0 top-0 h-[65%] pointer-events-none z-10" style="overflow:visible;">
                                                    <!-- Icon 1: Purple Sunburst (Top-left) -->
                                                    <div class="gl-app-badge absolute left-[10%] top-[2%] opacity-0">
                                                        <img src="/images/direct-tax-page/animate-1-2.png" alt="App" class="gl-icon-img block" />
                                                    </div>

                                                    <!-- Icon 2: Infor (Top-center) -->
                                                    <div class="gl-app-badge absolute left-[43%] top-[8%] opacity-0">
                                                        <img src="/images/direct-tax-page/animate-1-3.png" alt="Infor" class="gl-icon-img block" />
                                                    </div>

                                                    <!-- Icon 3: Blue Wedge (Top-right) -->
                                                    <div class="gl-app-badge absolute right-[8%] top-0 opacity-0">
                                                        <img src="/images/direct-tax-page/animate-1-4.png" alt="App" class="gl-icon-img block" />
                                                    </div>

                                                    <!-- Icon 4: Dynamics 365 (Mid-left) -->
                                                    <div class="gl-app-badge absolute left-[30%] top-[48%] opacity-0">
                                                        <img src="/images/direct-tax-page/animate-1-6.png" alt="Dynamics" class="gl-icon-img block" />
                                                    </div>

                                                    <!-- Icon 5: Workday (Mid-right) -->
                                                    <div class="gl-app-badge absolute right-[23%] top-[37%] opacity-0">
                                                        <img src="/images/direct-tax-page/animate-1-5.png" alt="Workday" class="gl-icon-img block" />
                                                    </div>

                                                    <!-- Icon 6: Microsoft (Folder mouth, center) -->
                                                    <div class="gl-app-badge absolute left-[44%] top-[83%] z-10 opacity-0">
                                                        <img src="/images/direct-tax-page/animate-1-7.png" alt="Microsoft" class="gl-icon-img block" />
                                                    </div>

                                                    <!-- Icon 7: Oracle (Folder mouth, left) -->
                                                    <div class="gl-app-badge absolute left-[34%] top-[87%] z-10 opacity-0">
                                                        <img src="/images/direct-tax-page/animate-1-8.png" alt="Oracle" class="gl-icon-img block" />
                                                    </div>

                                                    <!-- Icon 8: App (Inside folder, right) -->
                                                    <div class="gl-app-badge absolute right-[29%] top-[100%] z-10 opacity-0">
                                                        <img src="/images/direct-tax-page/animate-1-10.png" alt="App" class="gl-icon-img block blur-[2px] opacity-90" />
                                                    </div>
                                                </div>

                                                <!-- Folder Graphics Container -->
                                                <div class="gl-folder-wrapper relative w-[120px] sm:w-[132px] aspect-[4/3] flex items-center justify-center pointer-events-none">
                                                    <!-- Open Folder -->
                                                    <img
                                                        src="/images/direct-tax-page/animate-1-1.png"
                                                        alt="Open Folder"
                                                        class="gl-folder-empty absolute inset-0 w-full h-full object-contain transition-opacity duration-300"
                                                    />

                                                    <!-- Packed Folder with Apps Inside -->
                                                    <img
                                                        src="/images/direct-tax-page/animate-1-9.png"
                                                        alt="Packed Folder"
                                                        class="gl-folder-packed absolute inset-0 w-full h-full object-contain opacity-0 origin-center transition-opacity duration-500"
                                                        style="transform: scale(1.15) translateY(2px);"
                                                    />
                                                </div>
                                            </div>

                                            <!-- ============================================== -->
                                            <!-- STAGE 2.5: BIG FOLDER (animation-1-12.png)     -->
                                            <!-- ============================================== -->
                                            <div class="gl-stage-big-folder absolute inset-0 z-10 flex items-center justify-center pointer-events-none opacity-0">
                                                <div class="gl-big-folder-wrapper relative w-[264px] h-[204px] flex items-center justify-center">
                                                    <img
                                                        src="/images/direct-tax-page/animation-1-12.png"
                                                        alt="Expanded Folder"
                                                        class="gl-big-folder-img w-full h-full object-contain"
                                                    />
                                                </div>
                                            </div>

                                            <!-- ============================================== -->
                                            <!-- STAGE 3: 3x3 PURPLE GRID                       -->
                                            <!-- ============================================== -->
                                            <div class="gl-stage-grid absolute inset-0 z-10 flex items-center justify-center p-6 opacity-0 pointer-events-none transition-all duration-500">
                                                <div class="grid grid-cols-3 gap-2 sm:gap-2.5 w-[160px] sm:w-[180px] aspect-square">
                                                    <div class="gl-tile rounded-xl bg-gradient-to-b from-[#C7D2FE] to-[#818CF8] border border-white/60 shadow-xs aspect-square" />
                                                    <div class="gl-tile rounded-xl bg-gradient-to-b from-[#C7D2FE] to-[#818CF8] border border-white/60 shadow-xs aspect-square" />
                                                    <div class="gl-tile rounded-xl bg-gradient-to-b from-[#C7D2FE] to-[#818CF8] border border-white/60 shadow-xs aspect-square" />
                                                    <div class="gl-tile rounded-xl bg-gradient-to-b from-[#C7D2FE] to-[#818CF8] border border-white/60 shadow-xs aspect-square" />
                                                    <div class="gl-tile rounded-xl bg-gradient-to-b from-[#C7D2FE] to-[#818CF8] border border-white/60 shadow-xs aspect-square" />
                                                    <div class="gl-tile rounded-xl bg-gradient-to-b from-[#C7D2FE] to-[#818CF8] border border-white/60 shadow-xs aspect-square" />
                                                    <div class="gl-tile rounded-xl bg-gradient-to-b from-[#C7D2FE] to-[#818CF8] border border-white/60 shadow-xs aspect-square" />
                                                    <div class="gl-tile rounded-xl bg-gradient-to-b from-[#C7D2FE] to-[#818CF8] border border-white/60 shadow-xs aspect-square" />
                                                    <div class="gl-tile rounded-xl bg-gradient-to-b from-[#C7D2FE] to-[#818CF8] border border-white/60 shadow-xs aspect-square" />
                                                </div>
                                            </div>
                                        </div>
                                    ) : (
                                        <div class="w-full h-full min-h-[180px] md:min-h-0 rounded-xl md:rounded-2xl bg-visual-placeholder mt-2" />
                                    )}
                                </div>
                            </div>
                        </div>
                    ))
                }

                <!-- Gap after the stack finishes -->
                <div style="height: 80px;"></div>
            </div>
        </div>
    </div>
</section>

<style is:global>
    @media (min-width: 768px) {
        .invoice-stack-card {
            height: 400px !important;
        }
        .invoice-stack-card .sc-card-visual-wrap {
            padding-top: 2.25rem !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .invoice-stack {
            gap: 2rem !important;
        }
        .invoice-stack-sticky {
            position: static !important;
        }
        .invoice-stack-card {
            transform: none !important;
            height: auto !important;
        }
    }

    @media (max-height: 800px) and (min-width: 768px) {
        .sc-invoice-stack-section {
            padding-top: 1.5rem !important;
            padding-bottom: 1.5rem !important;
        }
        .invoice-stack-card {
            height: 400px !important;
        }
        .invoice-stack-card h3 {
            font-size: clamp(1.25rem, 2.2vh, 1.75rem) !important;
            line-height: 1.25 !important;
            margin-bottom: 0.35rem !important;
        }
        .invoice-stack-card p {
            font-size: clamp(0.875rem, 1.7vh, 1rem) !important;
            line-height: 1.35 !important;
        }
        .invoice-stack-card .grid {
            gap: 0.5rem !important;
            padding-top: 0.25rem !important;
        }
    }

    @media (max-height: 680px) and (min-width: 768px) {
        .invoice-stack-card {
            height: clamp(
                260px,
                calc(100vh - var(--nav-clear, 112px) - 100px),
                350px
            ) !important;
        }
        .invoice-stack-card > div {
            padding: 0.875rem !important;
        }
        .invoice-stack-card .sc-card-visual-wrap {
            padding-top: 1.75rem !important;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const stack = document.getElementById("sc-invoice-stack-container");
        if (!stack) return;

        const asideMenuEl = document.getElementById("sc-aside-menu");
        const outers = Array.from(
            stack.querySelectorAll(".invoice-stack-sticky"),
        );
        const inners = Array.from(
            stack.querySelectorAll(".invoice-stack-card"),
        );

        if (!outers.length || outers.length !== inners.length) return;

        const reduceMotion =
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduceMotion) return;

        const STACK_OFFSET = 16;
        const NAV_CLEAR =
            parseFloat(
                getComputedStyle(document.documentElement).getPropertyValue(
                    "--nav-clear",
                ),
            ) || 112;

        const targetScaleFor = (i) => 0.88 + i * 0.03;

        const zoomFactor = () => {
            let z = 1;
            for (let n = stack; n && n.nodeType === 1; n = n.parentElement) {
                const v = parseFloat(getComputedStyle(n).zoom);
                if (v && v !== 1) z *= v;
            }
            return z;
        };

        let zoom = zoomFactor();
        let outersStickyTop = [];
        let lastActiveIdx = -1;
        let lastNavClear = 0;
        let lastNavBottomMeasured = -1;
        const sidebarBtns = Array.from(
            document.querySelectorAll(".sc-aside-menu-item"),
        );

        const setTops = () => {
            zoom = zoomFactor();

            const navEl =
                document.querySelector("[data-nav-card]") ||
                document.querySelector("[data-giwip-nav-root]") ||
                document.querySelector("nav") ||
                document.querySelector(".nav-wrap");

            const bannerEl =
                document.querySelector("[class*='banner']") ||
                document.querySelector("[id*='banner']") ||
                document.querySelector("[class*='announcement']") ||
                document.querySelector("[id*='announcement']") ||
                document.querySelector("[data-banner]");

            let navBottom = 0;
            if (navEl) {
                navBottom = Math.max(
                    navBottom,
                    navEl.getBoundingClientRect().bottom / zoom,
                );
            }
            if (bannerEl) {
                navBottom = Math.max(
                    navBottom,
                    bannerEl.getBoundingClientRect().bottom / zoom,
                );
            }

            let effectiveNavClear = NAV_CLEAR;
            if (navBottom > 0) {
                effectiveNavClear = Math.max(
                    NAV_CLEAR,
                    Math.round(navBottom + 28),
                );
            }

            if (Math.abs(effectiveNavClear - lastNavClear) >= 1) {
                lastNavClear = effectiveNavClear;
                document.documentElement.style.setProperty(
                    "--nav-clear",
                    `${effectiveNavClear}px`,
                );
            }

            const cardHeight = inners[0] ? inners[0].offsetHeight / zoom : 380;
            let firstTop = effectiveNavClear;

            if (window.innerWidth >= 768) {
                const totalStackHeight =
                    cardHeight + (outers.length - 1) * STACK_OFFSET;
                const viewportCss = window.innerHeight / zoom;
                firstTop = Math.max(
                    effectiveNavClear,
                    (viewportCss - totalStackHeight) / 2,
                );
            }

            for (let i = 0; i < outers.length; i++) {
                outers[i].style.top = firstTop + i * STACK_OFFSET + "px";
            }

            outersStickyTop = outers.map(
                (el) => (parseFloat(el.style.top) || effectiveNavClear) * zoom,
            );

            if (asideMenuEl) {
                const asideTopOffset = 8;
                asideMenuEl.style.top = firstTop + asideTopOffset + "px";
                asideMenuEl.style.minHeight = "";
            }
        };

        let ticking = false;

        const update = () => {
            const tops = outers.map((el) => el.getBoundingClientRect().top);
            const revealDistance = Math.max(
                260,
                (window.innerHeight / zoom) * 0.45,
            );

            let activeIdx = 0;
            inners.forEach((inner, i) => {
                if (i === inners.length - 1) {
                    inner.style.transform = "scale(1) translateZ(0)";
                    return;
                }

                const nextStickyTopPx =
                    outersStickyTop[i + 1] ||
                    (NAV_CLEAR + (i + 1) * STACK_OFFSET) * zoom;
                const distanceToStick = tops[i + 1] - nextStickyTopPx;

                const progress = Math.min(
                    1,
                    Math.max(0, 1 - distanceToStick / revealDistance),
                );
                const scale = 1 - progress * (1 - targetScaleFor(i));
                inner.style.transform = `scale(${scale.toFixed(4)}) translateZ(0)`;
            });

            for (let i = 0; i < tops.length; i++) {
                const stickyTop = outersStickyTop[i] || NAV_CLEAR * zoom;
                if (tops[i] <= stickyTop + 60) {
                    activeIdx = i;
                }
            }

            if (activeIdx !== lastActiveIdx) {
                lastActiveIdx = activeIdx;
                sidebarBtns.forEach((btn, idx) => {
                    if (idx === activeIdx) {
                        btn.classList.add(
                            "border-[#655DFF]",
                            "text-text-default",
                            "font-medium",
                        );
                        btn.classList.remove(
                            "border-transparent",
                            "text-text-default/28",
                            "font-normal",
                        );
                    } else {
                        btn.classList.remove(
                            "border-[#655DFF]",
                            "text-text-default",
                            "font-medium",
                        );
                        btn.classList.add(
                            "border-transparent",
                            "text-text-default/28",
                            "font-normal",
                        );
                    }
                });
            }

            if (asideMenuEl && outers.length > 0) {
                const lastIdx = outers.length - 1;
                const lastOuterTop = tops[lastIdx];
                const lastStickyTop = outersStickyTop[lastIdx] || 0;
                const exitDiff = lastOuterTop - lastStickyTop;

                if (exitDiff < -1) {
                    const translateY = exitDiff / zoom;
                    asideMenuEl.style.transform = `translate3d(0, ${translateY.toFixed(2)}px, 0)`;
                } else {
                    asideMenuEl.style.transform = "";
                }
            }

            ticking = false;
        };

        const getUnstuckTop = (el) => {
            let top = 0;
            let curr = el;
            while (curr) {
                top += curr.offsetTop;
                curr = curr.offsetParent;
            }
            return top;
        };

        const getCardTargetY = (index) => {
            const stickyTopPx =
                (parseFloat(outers[index].style.top) || NAV_CLEAR) * zoom;
            return getUnstuckTop(outers[index]) - stickyTopPx;
        };

        sidebarBtns.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.preventDefault();
                const index = parseInt(
                    btn.getAttribute("data-card-index") || "0",
                    10,
                );
                if (outers[index]) {
                    const targetY = getCardTargetY(index);
                    window.scrollTo({ top: targetY, behavior: "smooth" });
                }
            });
        });

        const onScroll = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
        };

        const handleLayoutShift = () => {
            setTops();
            update();
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", handleLayoutShift);
        window.addEventListener("load", handleLayoutShift, { once: true });

        const navElToObserve =
            document.querySelector("[data-nav-card]") ||
            document.querySelector("[data-giwip-nav-root]") ||
            document.querySelector("nav") ||
            document.querySelector(".nav-wrap");
        if (navElToObserve && typeof ResizeObserver !== "undefined") {
            new ResizeObserver(() => {
                const bottom = navElToObserve.getBoundingClientRect().bottom;
                if (Math.abs(bottom - lastNavBottomMeasured) >= 1) {
                    lastNavBottomMeasured = bottom;
                    handleLayoutShift();
                }
            }).observe(navElToObserve);
        }

        const bannerElToObserve =
            document.querySelector("[class*='banner']") ||
            document.querySelector("[id*='banner']") ||
            document.querySelector("[class*='announcement']") ||
            document.querySelector("[id*='announcement']") ||
            document.querySelector("[data-banner]");
        if (bannerElToObserve && typeof ResizeObserver !== "undefined") {
            new ResizeObserver(() => {
                handleLayoutShift();
            }).observe(bannerElToObserve);
        }

        if (typeof MutationObserver !== "undefined") {
            const bodyObserver = new MutationObserver(() => {
                handleLayoutShift();
            });
            bodyObserver.observe(document.body, {
                childList: true,
                subtree: false,
            });
        }

        setTimeout(handleLayoutShift, 100);
        setTimeout(handleLayoutShift, 300);
        setTimeout(handleLayoutShift, 1000);

        setTops();
        update();
    });
</script>

<script is:inline>
    (function () {
        // Animation enabled
        var ANIMATION_ENABLED = true;
        var currentTl = null;

        function runFolderAnimation() {
            if (!ANIMATION_ENABLED) return;
            var canvas = document.querySelector("[data-gl-visual]");
            if (!canvas) return;

            var badges = Array.from(canvas.querySelectorAll(".gl-app-badge"));
            var stageFolder = canvas.querySelector(".gl-stage-folder");
            var folderEmpty = canvas.querySelector(".gl-folder-empty");
            var folderBack = canvas.querySelector(".gl-folder-back");
            var folderFront = canvas.querySelector(".gl-folder-front");
            var folderPacked = canvas.querySelector(".gl-folder-packed");
            var folderWrapper = canvas.querySelector(".gl-folder-wrapper");

            var stageBigFolder = canvas.querySelector(".gl-stage-big-folder");
            var bigFolderWrapper = canvas.querySelector(".gl-big-folder-wrapper") || (stageBigFolder ? stageBigFolder.querySelector("div") : null);
            var bigFolderImg = canvas.querySelector(".gl-big-folder-img");

            var stageGrid = canvas.querySelector(".gl-stage-grid");
            var gridTiles = Array.from(canvas.querySelectorAll(".gl-stage-grid .gl-tile"));

            if (!badges.length || !folderWrapper) return;

            var emptyFolderElements = folderEmpty ? [folderEmpty] : [folderBack, folderFront].filter(Boolean);
            var iconImgs = badges.map(function (b) { return b.querySelector("img"); });

            function getThrowTarget(badge, index) {
                var stageEl = badge.closest(".gl-stage-folder") || canvas;
                var stageRect = stageEl.getBoundingClientRect();
                var folderRect = folderWrapper.getBoundingClientRect();
                var badgeRect = badge.getBoundingClientRect();

                var badgeCX = badgeRect.left + badgeRect.width / 2 - stageRect.left;
                var badgeCY = badgeRect.top + badgeRect.height / 2 - stageRect.top;

                var folderLeft = folderRect.left - stageRect.left;
                var folderTop = folderRect.top - stageRect.top;
                var fW = folderRect.width;
                var fH = folderRect.height;

                // Slightly spread along the folder mouth rim
                var mouthSpread = [0.38, 0.50, 0.62, 0.42, 0.58, 0.48, 0.36, 0.64];
                var ratio = mouthSpread[index] || 0.5;

                var targetCX = folderLeft + fW * ratio;
                var targetCY = folderTop + fH * 0.30; // Rim/mouth of folder

                return {
                    dx: targetCX - badgeCX,
                    dy: targetCY - badgeCY,
                };
            }

            function buildTimeline() {
                if (currentTl) {
                    currentTl.kill();
                }

                // Reset all states initially: Open folder visible alone, icons hidden below with scale
                var PACKED_SCALE = 1.15;
                var PACKED_Y = 2;
                gsap.set(badges, { x: 0, y: 30, opacity: 0, scale: 0.35, rotation: function(i) { return i % 2 === 0 ? -12 : 12; }, clearProps: "filter" });
                gsap.set(iconImgs, { scale: 1, clearProps: "filter" });
                if (stageFolder) gsap.set(stageFolder, { opacity: 1, scale: 1 });
                gsap.set(emptyFolderElements, { opacity: 1, scale: 1, clearProps: "transform" });
                if (folderPacked) gsap.set(folderPacked, { opacity: 0, scale: PACKED_SCALE, y: PACKED_Y });

                if (stageBigFolder) {
                    gsap.set(stageBigFolder, { opacity: 0, scale: 1 });
                    if (bigFolderWrapper) gsap.set(bigFolderWrapper, { x: 0, y: 0, scale: 1, rotation: 0, clearProps: "transform" });
                }

                if (stageGrid) {
                    gsap.set(stageGrid, { opacity: 0, scale: 1 });
                    if (gridTiles.length) gsap.set(gridTiles, { opacity: 0, scale: 0.3 });
                }

                var tl = gsap.timeline({ delay: 0.2 });
                currentTl = tl;

                // ----------------------------------------------------
                // STAGE 0: Open folder sits alone, then icons spring
                // up organically into orbit with tactile physics
                // ----------------------------------------------------
                var appearStart = 0.35;
                badges.forEach(function (badge, i) {
                    tl.to(badge, {
                        opacity: i === 7 ? 0.9 : 1,
                        y: 0,
                        scale: 1,
                        rotation: i % 2 === 0 ? -2 : 2,
                        duration: 0.52,
                        ease: "back.out(1.8)",
                    }, appearStart + i * 0.08);
                });

                // Idle floating breath while hovering above the folder
                var floatStart = appearStart + badges.length * 0.08 + 0.15;
                badges.forEach(function (badge, i) {
                    tl.to(badge, {
                        y: i % 2 === 0 ? -6 : 6,
                        duration: 0.55,
                        ease: "sine.inOut",
                        yoyo: true,
                        repeat: 1,
                    }, floatStart + i * 0.04);
                });

                var dropStart = floatStart + 0.9;

                // ----------------------------------------------------
                // STAGE 1: Mouth badges (Oracle, Microsoft, App)
                // tumble and shrink into the depth of the mouth
                // ----------------------------------------------------
                var mouthIndices = [6, 5, 7];
                mouthIndices.forEach(function (idx, i) {
                    if (!badges[idx]) return;
                    var drop = getThrowTarget(badges[idx], idx);
                    var tStart = dropStart + i * 0.1;
                    var dur = 0.32;

                    tl.to(badges[idx], {
                        x: drop.dx,
                        y: drop.dy + 14,
                        scale: 0.2,
                        rotation: idx % 2 === 0 ? -18 : 18,
                        duration: dur,
                        ease: "power2.in",
                    }, tStart);

                    tl.to(badges[idx], {
                        opacity: 0,
                        duration: 0.08,
                        ease: "power1.in",
                    }, tStart + dur - 0.06);

                    // Folder squashes on catch
                    tl.to(emptyFolderElements, {
                        scaleX: 1.03,
                        scaleY: 0.97,
                        duration: 0.08,
                        yoyo: true,
                        repeat: 1,
                        ease: "power1.inOut",
                    }, tStart + dur - 0.04);
                });

                // ----------------------------------------------------
                // STAGE 2: Mid-tier badges (Dynamics 365 & Workday)
                // accelerate down, rotate, and plunge deep into folder
                // ----------------------------------------------------
                var midIndices = [3, 4];
                midIndices.forEach(function (idx, i) {
                    if (!badges[idx]) return;
                    var drop = getThrowTarget(badges[idx], idx);
                    var tStart = dropStart + 0.35 + i * 0.14;
                    var dur = 0.46;

                    tl.to(badges[idx], {
                        x: drop.dx,
                        y: drop.dy + 16,
                        scale: 0.18,
                        rotation: idx % 2 === 0 ? 22 : -22,
                        duration: dur,
                        ease: "power2.in",
                    }, tStart);

                    tl.to(badges[idx], {
                        opacity: 0,
                        duration: 0.08,
                        ease: "power1.in",
                    }, tStart + dur - 0.06);
                });

                // Folder catches mid-tier apps with a satisfying bounce
                tl.to(emptyFolderElements, {
                    scaleX: 1.05,
                    scaleY: 0.95,
                    duration: 0.1,
                    yoyo: true,
                    repeat: 1,
                    ease: "power1.inOut",
                }, dropStart + 0.88);

                // ----------------------------------------------------
                // STAGE 3: Top-tier badges (Infor, Sunburst, Blue Wedge)
                // swoop down from the top arc into the mouth
                // ----------------------------------------------------
                var topIndices = [1, 0, 2];
                topIndices.forEach(function (idx, i) {
                    if (!badges[idx]) return;
                    var drop = getThrowTarget(badges[idx], idx);
                    var tStart = dropStart + 0.72 + i * 0.12;
                    var dur = 0.52;

                    tl.to(badges[idx], {
                        x: drop.dx,
                        y: drop.dy + 18,
                        scale: 0.15,
                        rotation: idx % 2 === 0 ? -25 : 25,
                        duration: dur,
                        ease: "power2.in",
                    }, tStart);

                    tl.to(badges[idx], {
                        opacity: 0,
                        duration: 0.08,
                        ease: "power1.in",
                    }, tStart + dur - 0.06);
                });

                // ----------------------------------------------------
                // STAGE 4: All apps caught! Folder absorbs impact with
                // an organic squeeze & pop into packed folder
                // ----------------------------------------------------
                var packedTime = dropStart + 1.45;

                // Folder dips with weight impact
                tl.to(folderWrapper, {
                    scaleX: 1.07,
                    scaleY: 0.93,
                    y: 4,
                    duration: 0.12,
                    ease: "power2.in",
                }, packedTime);

                // Transformation occurs inside the impact
                if (folderPacked) {
                    tl.to(folderPacked, {
                        opacity: 1,
                        duration: 0.18,
                        ease: "power1.inOut",
                    }, packedTime + 0.06);

                    tl.to(emptyFolderElements, {
                        opacity: 0,
                        duration: 0.18,
                        ease: "power1.inOut",
                    }, packedTime + 0.06);
                }

                // Elastic rebound
                tl.to(folderWrapper, {
                    scaleX: 1,
                    scaleY: 1,
                    y: 0,
                    duration: 0.45,
                    ease: "elastic.out(1.2, 0.45)",
                }, packedTime + 0.12);

                tl.set(badges, { opacity: 0 }, packedTime + 0.1);

                // ----------------------------------------------------
                // STAGE 4.5: TRANSITION TO BIG FOLDER (animation-1-12.png)
                // Glides upward with smooth momentum into center (264w x 204h)
                // ----------------------------------------------------
                var bigFolderTime = packedTime + 0.85;

                if (stageBigFolder && stageFolder && bigFolderWrapper && folderWrapper) {
                    var folderRect = folderWrapper.getBoundingClientRect();
                    var bigRect = bigFolderWrapper.getBoundingClientRect();

                    var startDy = (folderRect.top + folderRect.height / 2) - (bigRect.top + bigRect.height / 2);
                    var startDx = (folderRect.left + folderRect.width / 2) - (bigRect.left + bigRect.width / 2);
                    var startScale = folderRect.width / (bigRect.width || 264);

                    // Anticipation squeeze on small folder
                    tl.to(stageFolder, {
                        scale: 0.96,
                        duration: 0.1,
                        ease: "power1.in",
                    }, bigFolderTime - 0.1);

                    // Handover seamlessly
                    tl.to(stageFolder, {
                        opacity: 0,
                        duration: 0.08,
                        ease: "power1.out",
                    }, bigFolderTime);

                    tl.set(stageBigFolder, {
                        opacity: 1,
                        scale: 1,
                    }, bigFolderTime);

                    tl.set(bigFolderWrapper, {
                        x: startDx,
                        y: startDy,
                        scale: startScale,
                        rotation: -2,
                    }, bigFolderTime);

                    // Buoyant, momentum-driven glide to center
                    tl.to(bigFolderWrapper, {
                        x: 0,
                        y: 0,
                        scale: 1,
                        rotation: 0,
                        duration: 0.85,
                        ease: "power3.out",
                    }, bigFolderTime + 0.02);
                }

                // ----------------------------------------------------
                // STAGE 5: BIG FOLDER TRANSITIONS TO 3x3 PURPLE GRID
                // Big folder shrinks inward as 9 tiles ripple from center
                // ----------------------------------------------------
                var gridTime = bigFolderTime + 1.5;

                if (stageBigFolder) {
                    tl.to(stageBigFolder, {
                        opacity: 0,
                        scale: 0.88,
                        duration: 0.32,
                        ease: "power2.in",
                    }, gridTime);
                }

                if (stageGrid) {
                    tl.set(stageGrid, { opacity: 1, scale: 1 }, gridTime + 0.08);

                    if (gridTiles.length) {
                        tl.fromTo(gridTiles, {
                            scale: 0.25,
                            opacity: 0,
                        }, {
                            scale: 1,
                            opacity: 1,
                            duration: 0.42,
                            stagger: {
                                grid: [3, 3],
                                from: "center",
                                amount: 0.2,
                            },
                            ease: "back.out(1.8)",
                        }, gridTime + 0.08);
                    }
                }

                // ----------------------------------------------------
                // STAGE 6: Hold 3x3 purple grid state
                // ----------------------------------------------------
                var holdEnd = gridTime + 2.8;

                // ----------------------------------------------------
                // STAGE 7: Smooth reset back to initial open folder state
                // ----------------------------------------------------
                if (stageGrid) {
                    if (gridTiles.length) {
                        tl.to(gridTiles, {
                            scale: 0.7,
                            opacity: 0,
                            duration: 0.28,
                            stagger: {
                                grid: [3, 3],
                                from: "edges",
                                amount: 0.12,
                            },
                            ease: "power2.in",
                        }, holdEnd);
                    }
                    tl.to(stageGrid, {
                        opacity: 0,
                        duration: 0.35,
                        ease: "power2.inOut",
                    }, holdEnd + 0.12);
                }

                if (stageFolder) {
                    tl.to(stageFolder, {
                        opacity: 1,
                        scale: 1,
                        duration: 0.4,
                        ease: "power2.inOut",
                    }, holdEnd + 0.22);
                }

                if (stageBigFolder) {
                    tl.set(stageBigFolder, { opacity: 0, scale: 1 }, holdEnd + 0.22);
                }
                if (bigFolderWrapper) {
                    tl.set(bigFolderWrapper, { x: 0, y: 0, scale: 1, rotation: 0 }, holdEnd + 0.22);
                }

                if (folderPacked) {
                    tl.set(folderPacked, { opacity: 0 }, holdEnd + 0.22);
                    tl.set(emptyFolderElements, { opacity: 1 }, holdEnd + 0.22);
                }

                var totalDuration = holdEnd + 0.75;

                // Loop cleanly — next loop starts with open folder alone, then icons spring into view
                tl.call(function () {
                    setTimeout(buildTimeline, 500);
                }, null, totalDuration);

                return tl;
            }

            // Start on first intersection with viewport
            if (typeof IntersectionObserver !== "undefined") {
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            observer.disconnect();
                            buildTimeline();
                        }
                    });
                }, { threshold: 0.25 });
                observer.observe(canvas);
            } else {
                buildTimeline();
            }
        }

        function boot() {
            if (typeof gsap === "undefined") {
                var s = document.createElement("script");
                s.src = "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js";
                s.onload = runFolderAnimation;
                document.head.appendChild(s);
            } else {
                runFolderAnimation();
            }
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", boot);
        } else {
            boot();
        }
    })();
</script>
