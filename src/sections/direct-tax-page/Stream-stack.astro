                                minHeight: 160,
                                flexGrow: 1.45,
                                duration: pourDur,
                                ease: "power2.out",
                            }, pourStart);
                        }

                        // Card 2: Debit Amount content pours in + min-h adjusts to 120px
                        var pour2 = pourStart + pourStep;
                        if (cardContent2) {
                            tl.fromTo(cardContent2, {
                                opacity: 0,
                                y: -16,
                            }, {
                                opacity: 1,
                                y: 0,
                                duration: pourDur,
                                ease: "power2.out",
                            }, pour2);
