                        scale: 0.92,
                        duration: 0.3,
                        ease: "power2.in",
                    }, cutCardHoldEnd);
                }

                if (stageCards) {
                    tl.set(stageCards, { opacity: 1 }, cutCardHoldEnd + 0.05);

                    var scrollSideBySideTime = cutCardHoldEnd + 0.15;

                    // 1. "first scroll side by side" (Panel 1 & 2):
                    // Card 1 arrives on left, Card 2 scrolls in from right beside it
                    if (card1) {
                        tl.fromTo(card1, {
                            opacity: 0,
                            x: -35,
                            scale: 0.96,
                        }, {
                            opacity: 1,
                            x: 0,
                            scale: 1,
                            duration: 0.42,
                            ease: "power2.out",
                        }, scrollSideBySideTime);
                    }

                    if (card2) {
                        tl.fromTo(card2, {
                            opacity: 0.25,
                            x: 65,
                            scale: 0.96,
                        }, {
                            opacity: 1,
                            x: 0,
                            scale: 1,
                            duration: 0.52,
                            ease: "power2.out",
                        }, scrollSideBySideTime + 0.18);
                    }

                    // 2. "then from top one comes" / bottom-right float in (Panel 3):
                    // Card 4 (calculator icon) rises up into bottom-right position
                    var card4Time = scrollSideBySideTime + 0.78;
                    if (card4) {
                        tl.fromTo(card4, {
                            opacity: 0,
                            y: 45,
                            scale: 0.94,
                        }, {
                            opacity: 1,
                            y: 0,
                            scale: 1,
                            duration: 0.45,
                            ease: "power2.out",
                        }, card4Time);
                    }

                    // 3. "then from sides" (Panel 4):
                    // Card 3 (checkmark icon) floats in from left side into bottom-left position
                    var card3Time = card4Time + 0.48;
                    if (card3) {
                        tl.fromTo(card3, {
                            opacity: 0,
                            x: -45,
                            scale: 0.94,
                        }, {
                            opacity: 1,
                            x: 0,
                            scale: 1,
                            duration: 0.45,
                            ease: "power2.out",
                        }, card3Time);
                    }

                    // ----------------------------------------------------
                    // STAGE 4: Resolution to Final 4 Display
                    // "and then at last this 4 display dont give opacity to last card"
                    // ----------------------------------------------------
                    var resolveStartTime = card3Time + 0.45 + 0.7;

                    // Step A: Card 1 resolves to ₹1.79L / 16 16 Filed
                    if (card1Initial && card1Resolved) {
                        tl.to(card1Initial, {
                            opacity: 0,
                            y: 10,
                            duration: 0.25,
                            ease: "power2.in",
                        }, resolveStartTime);
                        tl.fromTo(card1Resolved, {
                            opacity: 0,
                            y: -10,
                        }, {
                            opacity: 1,
                            y: 0,
                            duration: 0.35,
                            ease: "power2.out",
                        }, resolveStartTime + 0.12);
                        if (card1) {
                            tl.to(card1, {
                                scale: 1.02,
                                duration: 0.15,
                                yoyo: true,
                                repeat: 1,
                                ease: "power2.out",
                            }, resolveStartTime + 0.12);
                        }
                    }

                    // Step B: Card 2 resolves to ₹0 / 0 To Fix
                    var resolveCard2Time = resolveStartTime + 0.55;
                    if (card2Initial && card2Resolved) {
                        tl.to(card2Initial, {
                            opacity: 0,
                            y: 10,
                            duration: 0.25,
                            ease: "power2.in",
                        }, resolveCard2Time);
                        tl.fromTo(card2Resolved, {
                            opacity: 0,
                            y: -10,
                        }, {
                            opacity: 1,
                            y: 0,
                            duration: 0.35,
                            ease: "power2.out",
                        }, resolveCard2Time + 0.12);
                        if (card2) {
                            tl.to(card2, {
                                scale: 1.02,
                                duration: 0.15,
                                yoyo: true,
                                repeat: 1,
                                ease: "power2.out",
                            }, resolveCard2Time + 0.12);
                        }
                    }

                    // Step C: Card 3 subtle celebratory pop
                    if (card3) {
                        tl.to(card3, {
                            scale: 1.02,
                            duration: 0.15,
                            yoyo: true,
                            repeat: 1,
                            ease: "power2.out",
                        }, resolveCard2Time + 0.35);
                    }

                    // NOTE: User requested "dont give opacity to last card"
                    // card4 remains opacity 1 (styled as muted in HTML) with NO gsap opacity change!

                    // ----------------------------------------------------
                    // STAGE 5: Hold final 4 cards state and loop reset
                    // ----------------------------------------------------
                    var finalHoldEnd = resolveCard2Time + 0.35 + 3.0;

                    tl.to(stageCards, {
                        opacity: 0,
                        scale: 0.96,
                        duration: 0.45,
                        ease: "power2.inOut",
                    }, finalHoldEnd);

                    if (stageRadar) {
                        tl.to(stageRadar, {
                            opacity: 1,
                            scale: 1,
                            duration: 0.45,
                            ease: "power2.inOut",
                        }, finalHoldEnd + 0.2);
                    }

                    if (stageCutCard) {
                        tl.set(stageCutCard, { opacity: 0 }, finalHoldEnd + 0.2);
                    }
                    if (cutCardWrapper) {
                        tl.set(cutCardWrapper, { scale: 0.75, opacity: 0 }, finalHoldEnd + 0.2);
                    }

                    tl.set(stageCards, { opacity: 0 }, finalHoldEnd + 0.2);
                    var allCardsReset = [card1, card2, card3, card4].filter(Boolean);
                    if (allCardsReset.length) {
                        tl.set(allCardsReset, { opacity: 0, scale: 1, x: 0, y: 0, clearProps: "filter" }, finalHoldEnd + 0.2);
                    }
                    if (card1Initial) tl.set(card1Initial, { opacity: 1, y: 0 }, finalHoldEnd + 0.2);
                    if (card1Resolved) tl.set(card1Resolved, { opacity: 0, y: -10 }, finalHoldEnd + 0.2);
                    if (card2Initial) tl.set(card2Initial, { opacity: 1, y: 0 }, finalHoldEnd + 0.2);
                    if (card2Resolved) tl.set(card2Resolved, { opacity: 0, y: -10 }, finalHoldEnd + 0.2);
                    if (card4) tl.set(card4, { opacity: 1, clearProps: "filter" }, finalHoldEnd + 0.2);
                    if (radarDoc) tl.set(radarDoc, { opacity: 1, scale: 1 }, finalHoldEnd + 0.2);
                    if (radarSvg) tl.set(radarSvg, { opacity: 1, scale: 1 }, finalHoldEnd + 0.2);

                    var totalDuration = finalHoldEnd + 0.7;

                    tl.call(function () {
                        setTimeout(buildTdsTimeline, 400);
                    }, null, totalDuration);
                }

                return tl;
            }

            // IntersectionObserver for TDS visual
            if (typeof IntersectionObserver !== "undefined") {
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            observer.disconnect();
                            buildTdsTimeline();
                        }
                    });
                }, { threshold: 0.25 });
                observer.observe(canvas);
            } else {
                buildTdsTimeline();
            }
        }

        function boot() {
            function runAll() {
                runFolderAnimation();
                runTdsAnimation();
            }
            if (typeof gsap === "undefined") {
                var s = document.createElement("script");
                s.src = "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js";
                s.onload = runAll;
                document.head.appendChild(s);
            } else {
                runAll();
            }
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", boot);
        } else {
            boot();
        }
    })();
</script>
