---
/**
 * Direct Tax Walkthrough Section
 * Features a video walkthrough column with responsive stats
 * (Desktop: 1-col vertical list, Tablet: 4-col row with dividers, Mobile: 2x2 grid with segmented plus dividers)
 */

const stats = [
    {
        value: "7/10",
        label: "Enterprises struggle with direct tax compliance",
    },
    {
        value: "₹2 Cr",
        label: "Avg unutilised challans per enterprise per FY",
    },
    {
        value: "10 days",
        label: "Average quarterly TDS filing time (manual)",
    },
    {
        value: "90%",
        label: "Companies receive a qualified audit note",
    },
];
---

<section class="bg-generic-00 py-16 md:py-20">
    <div class="mx-auto w-full min-[1400px]:container px-4 md:px-6">
        <div class="flex flex-col justify-center items-center gap-4">
            <h2
                class="font-heading font-medium text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] text-text-default"
            >
                Watch how it works
            </h2>
            <p
                class="font-body font-normal text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-neutral-500 max-w-100.75 text-center"
            >
                From ERP data extraction to filing-ready returns, see the full
                workflow in under 4 minutes.
            </p>
        </div>

        <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-10 lg:gap-12 pt-6 md:pt-8 lg:pt-12"
        >
            <!-- Video / Walkthrough Container -->
            <div
                class="col-span-1 lg:col-span-9 bg-visual-placeholder rounded-xl aspect-[912/560] lg:aspect-auto w-full lg:h-[560px] flex flex-col justify-end p-6 lg:p-8"
            >
                <div class="flex flex-col">
                    <h3
                        class="font-heading font-medium text-[length:var(--fs-h6)] md:text-[length:var(--fs-h5)] leading-[length:var(--lh-h6)] md:leading-[length:var(--lh-h5)] text-text-default mb-2"
                    >
                        Direct Tax Product Walkthrough
                    </h3>
                    <p
                        class="font-body font-normal text-[length:var(--fs-body-sm)] lg:text-[length:var(--fs-body)] leading-[length:var(--lh-body-sm)] lg:leading-[length:var(--lh-body)] text-neutral-500"
                    >
                        Add your video link here
                    </p>
                </div>
            </div>

            <!-- Stats -->
            <div class="col-span-1 lg:col-span-3 w-full">
                <div class="relative w-full">
                    <div
                        class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-1 gap-y-8 gap-x-4 md:gap-0 lg:gap-y-4 text-center lg:text-left"
                    >
                        {
                            stats.map((stat, index) => (
                                <div
                                    class:list={[
                                        "flex flex-col items-center lg:items-start px-2 sm:px-4 md:px-3 lg:px-6 py-2 md:py-0",
                                        index > 0 &&
                                            "md:border-l md:border-neutral-300 lg:border-l-0",
                                        index < stats.length - 1 &&
                                            "lg:border-b lg:border-neutral-300 lg:pb-5",
                                    ]}
                                >
                                    <h3 class="font-heading font-medium text-[length:var(--fs-h4)] sm:text-[length:var(--fs-h3)] lg:text-[length:var(--fs-h2)] leading-[length:var(--lh-h4)] sm:leading-[length:var(--lh-h3)] lg:leading-[length:var(--lh-h2)] text-text-default mb-2">
                                        {stat.value}
                                    </h3>
                                    <p class="font-body font-normal text-[length:var(--fs-body-sm)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-sm)] lg:leading-[length:var(--lh-body-lg)] text-neutral-500">
                                        {stat.label}
                                    </p>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Mobile Segmented Plus Dividers -->
                    <div
                        class="absolute md:hidden left-1/2 -translate-x-1/2 bottom-[calc(50%+16px)] h-14 sm:h-16 w-[1px] bg-neutral-300"
                    >
                    </div>
                    <div
                        class="absolute md:hidden left-1/2 -translate-x-1/2 top-[calc(50%+16px)] h-14 sm:h-16 w-[1px] bg-neutral-300"
                    >
                    </div>
                    <div
                        class="absolute md:hidden top-1/2 -translate-y-1/2 left-1/4 -translate-x-1/2 w-14 sm:w-16 h-[1px] bg-neutral-300"
                    >
                    </div>
                    <div
                        class="absolute md:hidden top-1/2 -translate-y-1/2 left-3/4 -translate-x-1/2 w-14 sm:w-16 h-[1px] bg-neutral-300"
                    >
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
