---
/**
 * Filing section for Direct Tax page.
 * Implements isolated sticky horizontal scroll container with 6 cards sized 480x560,
 * custom #E8FFE1 mint styling, top title, bottom desc, and responsive handling.
 */

const cards = [
    {
        title: "GL-Stream Data Ingestion",
        desc: "Single connector from your ERP extracts raw GL data and verifies it against trial balance. Supports SAP, Oracle, Dynamics 365 and more. Multi-TAN, multi-entity ready.",
    },
    {
        title: "TDS Filing & FVU Generation",
        desc: "Auto net-off of advances, provisions, and reversals. 200+ pre-filing validations. FVU generation for 5M+ deductions. End-to-end filing to TinFC right from the platform.",
    },
    {
        title: "TDS Certificate Distribution",
        desc: "Bulk generation, digital signing, and email distribution of Form 16A to all deductees in one click. Reduces vendor escalations by 70–80% per quarter.",
    },
    {
        title: "26AS, AIS & TIS Reconciliation",
        desc: "Automated 3-way reconciliation between book turnover, 26AS tax credits, and AIS data. Flags mismatching PANs, missing credits, and timing discrepancies instantly.",
    },
    {
        title: "Challan & Notice Management",
        desc: "Real-time OLTAS challan verification, automated consumption against deductee records, and smart correction statements to eliminate demand notices before filing.",
    },
    {
        title: "Audit-Ready Trail & Analytics",
        desc: "Centralized multi-entity repository with immutable timestamped audit logs, lower deduction certificate tracking, and executive compliance dashboards.",
    },
];
---

<div class="filing-sticky-container">
    <section
        class="sticky top-0 flex flex-col justify-center bg-generic-00 py-12 md:py-16 xl:py-20 overflow-hidden min-h-[calc(100vh-80px)]"
    >
        <div class="min-[1400px]:container mx-auto w-full px-4 md:px-6">
            <!-- Header -->
            <div
                class="filing-header-wrapper text-center mx-auto mb-8 md:mb-12"
            >
                <h2
                    class="filing-section-title font-heading font-medium text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] text-text-default max-w-216 mx-auto mb-4"
                >
                    Full coverage, end to end.
                </h2>
                <p
                    class="filing-section-desc font-body font-normal text-neutral-500 text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] max-w-138.75 mx-auto"
                >
                    Every step from ERP data extraction to government filing and
                    audit readiness — one platform.
                </p>
            </div>

            <!-- Cards Track -->
            <div class="w-full h-auto">
                <div
                    class="filing-scroll-track flex items-stretch gap-6 w-max transition-transform duration-[250ms] ease-out will-change-transform"
                >
                    {
                        cards.map((item) => (
                            <div class="filing-card-item bg-[#E8FFE1] rounded-xl p-6 sm:p-8 lg:p-10 w-[calc(100vw-32px)] sm:w-[420px] md:w-[460px] lg:w-[480px] h-[460px] sm:h-[500px] md:h-[560px] shrink-0 flex flex-col justify-between select-none">
                                <h3 class="filing-card-title font-heading text-[24px] sm:text-[28px] lg:text-[32px] leading-[1.25] font-medium text-text-default max-w-[400px] pointer-events-none">
                                    {item.title}
                                </h3>
                                <p class="filing-card-desc font-body text-neutral-600 font-normal text-[14px] sm:text-[15px] lg:text-[16px] leading-[1.6] max-w-[420px] pointer-events-none">
                                    {item.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>
</div>

<style is:global>
    @media (max-height: 750px) {
        .filing-sticky-container section {
            padding-top: 1.25rem !important;
            padding-bottom: 1.25rem !important;
        }
        .filing-header-wrapper {
            margin-bottom: 1rem !important;
        }
        .filing-card-item {
            padding: 1.5rem !important;
            height: 420px !important;
            min-height: 420px !important;
            max-width: calc(100vw - 32px) !important;
        }
        @media (min-width: 768px) {
            .filing-card-item {
                width: 400px !important;
                height: 440px !important;
                min-height: 440px !important;
            }
        }
        .filing-card-title {
            font-size: 1.35rem !important;
            margin-bottom: 0.75rem !important;
        }
        .filing-card-desc {
            font-size: 0.875rem !important;
            line-height: 1.4 !important;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const containers = document.querySelectorAll(
            ".filing-sticky-container",
        );
        if (!containers.length) return;

        containers.forEach((container) => {
            const track = container.querySelector(".filing-scroll-track");
            const section = container.querySelector("section");
            if (!container || !track || !section) return;

            const getHeaderHeight = () => {
                const header = document.querySelector(
                    "header, .navbar, .w-nav",
                );
                return header ? header.offsetHeight : 80;
            };

            let maxTranslate = 0;
            let totalScrollable = 0;
            let stickyTop = 0;

            const updateMeasurements = () => {
                const sectionHeight = section.offsetHeight;
                const windowHeight = window.innerHeight;
                const headerHeight = getHeaderHeight();

                const trackOffset =
                    track.parentElement.getBoundingClientRect().top -
                    section.getBoundingClientRect().top;
                const trackHeight = track.offsetHeight;
                const availableSpace = windowHeight - headerHeight;

                const idealTrackTop =
                    headerHeight +
                    Math.max(40, (availableSpace - trackHeight) / 2);
                let calculatedTop = idealTrackTop - trackOffset;

                // Position section flush under header when sticky, avoiding gap on large screens
                stickyTop = Math.min(headerHeight, calculatedTop);
                section.style.top = `${stickyTop}px`;

                const containerWidth =
                    track.parentElement.getBoundingClientRect().width;
                maxTranslate = Math.max(0, track.scrollWidth - containerWidth);
                container.style.height = `${maxTranslate + windowHeight}px`;
                totalScrollable =
                    container.getBoundingClientRect().height - sectionHeight;
            };

            updateMeasurements();

            if (window.ResizeObserver) {
                const ro = new ResizeObserver(updateMeasurements);
                ro.observe(section);
                ro.observe(track);
            }
            window.addEventListener("resize", updateMeasurements);

            let ticking = false;

            const handleScroll = () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const containerRect = container.getBoundingClientRect();
                        const scrolledDistance = Math.max(
                            0,
                            stickyTop - containerRect.top,
                        );

                        let progress =
                            totalScrollable > 0
                                ? scrolledDistance / totalScrollable
                                : 0;
                        progress = Math.max(0, Math.min(1, progress));

                        track.style.transform = `translate3d(-${progress * maxTranslate}px, 0, 0)`;

                        ticking = false;
                    });
                    ticking = true;
                }
            };

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            window.addEventListener("scroll", handleScroll, {
                                passive: true,
                            });
                            handleScroll();
                        } else {
                            window.removeEventListener("scroll", handleScroll);
                        }
                    });
                },
                {
                    rootMargin: "100% 0px 100% 0px",
                },
            );

            observer.observe(container);
        });
    });
</script>
