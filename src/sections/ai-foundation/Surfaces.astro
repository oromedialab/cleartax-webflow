---
/**
 * "The surface you build agents on." Figma node 16985:64558 ("24"). Left:
 * heading/description over the plug-and-cube illustration. Right: a
 * numbered 3-step list of where Clarity AI's data can be put to work, plus
 * a highlighted closing line.
 *
 * ── ASSET TO UPLOAD ──────────────────────────────────────────────────────
 * The illustration is `public/images/ai-foundation/surfaces-illustration.png`
 * — a screenshot export of Figma node 16985:64564 (an isometric cube built
 * from a dozen separate face/extrude SVGs with no single exportable asset).
 * Renders in `npm run dev` / `dist/preview`; resolves to nothing once pasted
 * into Webflow — upload it to Webflow assets and swap the `src` below for
 * the CDN URL first.
 * ───────────────────────────────────────────────────────────────────────────
 */
const surfaces = [
  {
    title: "CFO Studio",
    body: "Ask any question. Get answers and build dashboards in minutes.",
  },
  {
    title: "Agent Studio",
    body: "Build agents that automate tasks like vendor follow ups, variance detection, monthly close, reconciliations, and more",
  },
  {
    title: "Surfaces you already own",
    body: "Or build on whatever you have already invested in, Claude, Codex, or CoPilot via MCP or API",
  },
];
---

<section class="bg-generic-00 max-lg:py-16 lg:py-20">
  <div class="container flex flex-col gap-12 lg:flex-row lg:items-stretch lg:gap-12">
    <div class="flex w-full flex-col justify-between gap-8 lg:w-1/2">
      <div class="flex flex-col gap-4">
        <h2 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]">
          The surface you build agents on
        </h2>
        <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
          You can choose to build on Clarity's Studios or build on Claude, or Codex, or CoPilot.
        </p>
      </div>
      <div class="max-w-[616px] w-full aspect-[616/466]">
        <img
          src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1cf8f9a95869773b030e_surfaces-illustration.png"
          alt="Isometric illustration of a Clarity AI data cube connecting out to external agent surfaces"
          width="616"
          height="466"
          class="h-full object-contain w-full"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="flex w-full flex-col gap-6 lg:w-1/2">
      {surfaces.map((surface, i) => (
        <div class="flex gap-4 rounded-xl border border-neutral-300 bg-generic-00 p-6">
          <div class="flex flex-col gap-1">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#FBFBFC] border border-neutral-300 font-body text-neutral-500 text-[length:var(--fs-body-sm)]">
              {i + 1}
            </span>
            <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
              {surface.title}
            </p>
            <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
              {surface.body}
            </p>
          </div>
        </div>
      ))}

      <p class="m-0 font-body font-medium text-nova-blue text-[length:var(--fs-body)] leading-[length:var(--lh-body)] py-6 px-4 bg-[#E4E3FF] rounded-lg">
        Whatever the surface, Clarity AI delivers accuracy at volume. No hallucinations.
      </p>
    </div>
  </div>
</section>
