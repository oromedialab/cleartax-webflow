---
/**
 * "Your data sits in a dozen systems." Figma node 16985:63173 ("Fold 22").
 * Left: what Clarity AI reads from every source. Right: the four source
 * categories it pulls from. Centre: the Clarity AI wordmark over a dotted
 * field — the Figma field is six hand-placed "staircase" dot columns per
 * side; approximated here with a lightweight radial-gradient dot pattern
 * rather than reassembling dozens of 4px dot SVGs for a purely decorative
 * ornament.
 *
 * Icons: the Figma exports are nested-mask SVGs with no single downloadable
 * asset per glyph; rebuilt as minimal inline strokes instead (no `set:html`
 * — see Portability rules — so each icon's markup is written out per item).
 *
 * `imgD9F36...svg` in the Figma export is the real ClearTax CDN logo
 * (same file `_shared/AIAgent.astro` already references), so it's used
 * directly rather than re-downloaded from a temporary Figma asset URL.
 */
---

<section class="ai-fd-datalayer bg-generic-00 max-lg:py-16 lg:py-20">
  <div class="container flex flex-col items-center gap-12">
    <div class="flex flex-col items-center gap-4 text-center">
      <h2 class="m-0 max-w-200 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]">
        Your data sits in a dozen systems.
      </h2>
      <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
        ClearTax pulls all your data into one finance-owned layer
      </p>
    </div>

    <div class="flex w-full flex-col items-stretch gap-8 lg:flex-row lg:items-center lg:gap-6">
      <div class="rounded-xl border border-neutral-300 bg-generic-00 p-6 lg:w-85 lg:shrink-0">
        <p class="m-0 mb-6 font-body font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
          WHAT WE READ
        </p>
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0 text-nova-blue" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
                <path d="M3 9h18M9 9v11" stroke="currentColor" stroke-width="1.5"></path>
              </svg>
              <p class="m-0 font-body font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                Structure
              </p>
            </div>
            <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
              Tables, columns and types, across every source.
            </p>
          </div>

          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0 text-nova-blue" aria-hidden="true">
                <path d="M9 15l6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                <path d="M11 6.5l1-1a3.5 3.5 0 0 1 5 5l-1 1M13 17.5l-1 1a3.5 3.5 0 0 1-5-5l1-1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
              <p class="m-0 font-body font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                Lineage
              </p>
            </div>
            <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
              What feeds what, upstream and downstream.
            </p>
          </div>

          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0 text-nova-blue" aria-hidden="true">
                <path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                <path d="M18 3v4h-4M6 21v-4h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <p class="m-0 font-body font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                Freshness
              </p>
            </div>
            <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
              Row counts and last change, so you know it is current.
            </p>
          </div>
        </div>
      </div>

      <div class="ai-fd-dot-field flex flex-1 items-center justify-center gap-6 self-stretch py-8 lg:py-0">
        <span class="ai-fd-dots h-full w-16 shrink-0 max-lg:hidden" aria-hidden="true"></span>
        <div class="flex shrink-0 flex-col items-center gap-1">
          <p class="m-0 font-body text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
            Clarity AI
          </p>
          <img
            src="https://assets1.cleartax-cdn.com/finfo/wg-utils/retool/d9f36ac3-77a9-40c6-94fc-20c2e3855457.svg"
            alt="ClearTax"
            width="151"
            height="32"
            class="h-8 w-auto"
            loading="lazy"
            decoding="async"
          />
        </div>
        <span class="ai-fd-dots h-full w-16 shrink-0 max-lg:hidden" aria-hidden="true"></span>
      </div>

      <div class="grid grid-cols-1 gap-4 lg:w-85 lg:shrink-0">
        <div class="rounded-xl border border-neutral-300 bg-generic-00 px-4 py-6">
          <div class="flex items-center gap-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0 text-nova-blue" aria-hidden="true">
              <rect x="4" y="4" width="16" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
              <rect x="4" y="14" width="16" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
              <path d="M8 7h.01M8 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
            <p class="m-0 font-body font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
              ERP, POS, OMS, WMS
            </p>
          </div>
          <p class="m-0 mt-2 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
            SAP, Oracle, D365, Billing, POS, OMS, WMS
          </p>
        </div>

        <div class="rounded-xl border border-neutral-300 bg-generic-00 px-4 py-6">
          <div class="flex items-center gap-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0 text-nova-blue" aria-hidden="true">
              <ellipse cx="12" cy="6" rx="7" ry="3" stroke="currentColor" stroke-width="1.5"></ellipse>
              <path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6" stroke="currentColor" stroke-width="1.5"></path>
              <path d="M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3" stroke="currentColor" stroke-width="1.5"></path>
            </svg>
            <p class="m-0 font-body font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
              CUSTOMER DATA LAKES
            </p>
          </div>
          <p class="m-0 mt-2 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
            Snowflake, Databricks
          </p>
        </div>

        <div class="rounded-xl border border-neutral-300 bg-generic-00 px-4 py-6">
          <div class="flex items-center gap-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0 text-nova-blue" aria-hidden="true">
              <path d="M3 9l9-5 9 5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
              <path d="M5 9v10M9 9v10M15 9v10M19 9v10" stroke="currentColor" stroke-width="1.5"></path>
              <path d="M3 20h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            <p class="m-0 font-body font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
              GOVERNMENT, BANKING & PAYMENTS
            </p>
          </div>
          <p class="m-0 mt-2 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
            Tax portals, Bank feeds, Payment gateways
          </p>
        </div>

        <div class="rounded-xl border border-neutral-300 bg-generic-00 px-4 py-6">
          <div class="flex items-center gap-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0 text-nova-blue" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
              <path d="M3.5 6.5L12 13l8.5-6.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
            </svg>
            <p class="m-0 font-body font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
              DOCUMENTS & MAIL
            </p>
          </div>
          <p class="m-0 mt-2 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
            Excel, PDFs, Statements, Mailboxes
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Decorative dot field flanking the Clarity AI wordmark — a lightweight
     radial-gradient stand-in for the Figma mock's hand-placed staircase of
     4px dot SVGs, prefixed per the section-CSS rule. */
  .ai-fd-dots {
    background-image: radial-gradient(
      circle,
      var(--palette-lime-500) 1.5px,
      transparent 1.6px
    );
    background-size: 16px 16px;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 20%,
      #000 80%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 20%,
      #000 80%,
      transparent 100%
    );
  }
</style>
