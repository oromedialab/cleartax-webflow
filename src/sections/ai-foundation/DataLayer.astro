---
/**
 * "Your data sits in a dozen systems." Figma node 16985:63173 ("Fold 22").
 * Left: what Clarity AI reads from every source. Right: the four source
 * categories it pulls from. Centre: the Clarity AI wordmark over a dotted
 * field — six vertical dotted-line columns per side (16985:63216 /
 * :63291), heights 290/264/238/212/186/160px tapering toward the wordmark,
 * each one 26px shorter than the last (one dot-period). Built from real
 * dot counts rather than a radial-gradient approximation so the "staircase"
 * silhouette matches exactly.
 *
 * `imgD9F36...svg` in the Figma export is the real ClearTax CDN logo
 * (same file `_shared/AIAgent.astro` already references), so it's used
 * directly rather than re-downloaded from a temporary Figma asset URL.
 *
 * ── ASSETS TO UPLOAD ─────────────────────────────────────────────────────
 * Icons are screenshot exports of their Figma icon nodes (16985:63183,
 * :63192, :63201, :63359, :63378, :63392, :63409), saved locally to
 * public/images/ai-foundation/icons/dl-*.png. Render in `npm run dev` /
 * `dist/preview`; resolve to nothing once pasted into Webflow — upload each
 * to Webflow assets and swap the `icon` paths below for the CDN URLs first.
 * ─────────────────────────────────────────────────────────────────────────
 */
const whatWeRead = [
  {
    title: "Structure",
    body: "Tables, columns and types, across every source.",
    icon: "/images/ai-foundation/icons/dl-structure.png",
  },
  {
    title: "Lineage",
    body: "What feeds what, upstream and downstream.",
    icon: "/images/ai-foundation/icons/dl-lineage.png",
  },
  {
    title: "Freshness",
    body: "Row counts and last change, so you know it is current.",
    icon: "/images/ai-foundation/icons/dl-freshness.png",
  },
];

const sources = [
  {
    title: "ERP, POS, OMS, WMS",
    body: "SAP, Oracle, D365, Billing, POS, OMS, WMS",
    icon: "/images/ai-foundation/icons/dl-erp.png",
  },
  {
    title: "CUSTOMER DATA LAKES",
    body: "Snowflake, Databricks",
    icon: "/images/ai-foundation/icons/dl-data-lakes.png",
  },
  {
    title: "GOVERNMENT, BANKING & PAYMENTS",
    body: "Tax portals, Bank feeds, Payment gateways",
    icon: "/images/ai-foundation/icons/dl-government.png",
  },
  {
    title: "DOCUMENTS & MAIL",
    body: "Excel, PDFs, Statements, Mailboxes",
    icon: "/images/ai-foundation/icons/dl-documents.png",
  },
];

/** Outer-to-inner column heights, left side. Right side mirrors this list
 * (inner-to-outer) so both tapers meet shortest at the wordmark. */
const dotColumnHeights = [290, 264, 238, 212, 186, 160];
const dotPeriod = 26;

function dotsForHeight(height: number) {
  return Array.from({ length: Math.round(height / dotPeriod) + 1 });
}
---

<section class="bg-generic-00 max-lg:py-16 lg:py-20">
  <div class="container flex flex-col items-center gap-12">
    <div class="flex flex-col items-center gap-4 text-center">
      <h2 class="m-0 max-w-200 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]">
        Your data sits in a dozen systems.
      </h2>
      <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
        ClearTax pulls all your data into one finance-owned layer
      </p>
    </div>

    <div class="flex w-full flex-col items-stretch gap-8 lg:flex-row lg:items-center lg:gap-6">
      <div class="rounded-xl border border-neutral-300 bg-generic-00 p-6 lg:w-85 lg:shrink-0">
        <p class="m-0 mb-6 font-body font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
          WHAT WE READ
        </p>
        <div class="flex flex-col gap-6">
          {whatWeRead.map((item) => (
            <div class="flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <img src={item.icon} alt="" width="24" height="24" class="shrink-0" loading="lazy" decoding="async" />
                <p class="m-0 font-body font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                  {item.title}
                </p>
              </div>
              <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                {item.body}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="flex flex-1 items-center justify-center gap-6 self-stretch py-8 lg:py-0">
        <div class="flex shrink-0 items-center gap-6 max-lg:hidden" aria-hidden="true">
          {dotColumnHeights.map((h) => (
            <span class="flex shrink-0 flex-col items-center justify-between" style={`height:${h}px`}>
              {dotsForHeight(h).map(() => (
                <span class="h-1 w-1 shrink-0 rounded-full bg-flux-lime"></span>
              ))}
            </span>
          ))}
        </div>
        <div class="flex shrink-0 flex-col items-center gap-1">
          <p class="m-0 font-body text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
            Clarity AI
          </p>
          <img
            src="https://assets1.cleartax-cdn.com/finfo/wg-utils/retool/d9f36ac3-77a9-40c6-94fc-20c2e3855457.svg"
            alt="ClearTax"
            width="151"
            height="32"
            class="h-8 w-auto"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="flex shrink-0 items-center gap-6 max-lg:hidden" aria-hidden="true">
          {[...dotColumnHeights].reverse().map((h) => (
            <span class="flex shrink-0 flex-col items-center justify-between" style={`height:${h}px`}>
              {dotsForHeight(h).map(() => (
                <span class="h-1 w-1 shrink-0 rounded-full bg-flux-lime"></span>
              ))}
            </span>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 lg:w-85 lg:shrink-0">
        {sources.map((source) => (
          <div class="rounded-xl border border-neutral-300 bg-generic-00 px-4 py-6">
            <div class="flex items-center gap-2">
              <img src={source.icon} alt="" width="24" height="24" class="shrink-0" loading="lazy" decoding="async" />
              <p class="m-0 font-body font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                {source.title}
              </p>
            </div>
            <p class="m-0 mt-2 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
              {source.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
