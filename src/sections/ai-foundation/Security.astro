---
/**
 * "Bulletproof security." Figma node 16985:65221 ("9"). Three columns of
 * checklist cards. The mock's subheading paragraph under this heading is
 * leftover copy duplicated from the "surface you build agents on" section
 * (identical sentence, wrong topic) — the screenshot render shows no
 * subheading here, so it's dropped rather than reproduced verbatim.
 *
 * ── ASSETS TO UPLOAD ─────────────────────────────────────────────────────
 * Icons are screenshot exports of their Figma icon nodes (16985:65244,
 * :65252, :65263, :65276, :65300, :65308, :65318, :65330, :65358, :65365,
 * :65374), saved to public/images/ai-foundation/icons/sec-*.png. Render in
 * `npm run dev` / `dist/preview`; resolve to nothing once pasted into
 * Webflow — upload each to Webflow assets and swap the `icon` paths below
 * for the CDN URLs first.
 * ─────────────────────────────────────────────────────────────────────────
 */
const columns = [
  {
    title: "CERTIFICATIONS & AUDITS",
    items: [
      {
        title: "SOC 2 Type II",
        body: "Annual audit compliance for data security",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017f8dc7b66d5a588bc_security-1.png",
      },
      {
        title: "ISO 27001 / 22301",
        body: "Information security and business continuity",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017a6ed8b9b53e24994_security-2.png",
      },
      {
        title: "VAPT",
        body: "Independent vulnerability assessment and penetration testing",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf10177e44768c4276915c_security-3.png",
      },
      {
        title: "GDPR",
        body: "Aligned with GDPR, UAE PDPL and KSA PDPL",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017fed23ae56780ff7a_security-4.png",
      },
    ],
  },
  {
    title: "ENCRYPTION & ACCESS",
    items: [
      {
        title: "AES 256-bit",
        body: "Military-grade encryption at rest",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf10173e74617468a30d6f_security-5.png",
      },
      {
        title: "SSL transit",
        body: "Encrypted data in transit with TLS 1.3",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017081cff26f50a19f2_security-6.png",
      },
      {
        title: "Auth tokens",
        body: "Secure token-based authentication",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf101b33c66a200fcfb424_security-7.png",
      },
      {
        title: "Role-based access control",
        body: "Permissions by role, down to the record",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017a0f65116187238cc_security-8.png",
      },
    ],
  },
  {
    title: "RESIDENCY & PRIVACY",
    items: [
      {
        title: "Data residency",
        body: "Each region runs on dedicated, sovereign infrastructure",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf10176d7068a643517ca9_security-9.png",
      },
      {
        title: "Privacy",
        body: "Regulatory-compliant data privacy in every country you file in",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017fd1598da87a56dcc_security-10.png",
      },
      {
        title: "No model training",
        body: "Your data stays in your environment and never trains a model",
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017380f206efda6a64a_security-11.png",
      },
    ],
  },
];
---

<section class="bg-generic-00 max-lg:py-16 lg:py-20">
  <div
    class="max-w-[var(--container-max)] mx-auto w-full px-4 md:px-6 flex flex-col items-center gap-12"
  >
    <h2
      class="m-0 max-w-170 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]"
    >
      Bulletproof security
    </h2>

    <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-3">
      {
        columns.map((col) => (
          <div class="flex flex-col rounded-xl border border-neutral-300 bg-generic-00">
            <div class="border-b border-neutral-300 p-6">
              <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                {col.title}
              </p>
            </div>
            <div class="flex flex-col gap-6 p-6">
              {col.items.map((item, i) => (
                <>
                  {i > 0 && (
                    <div
                      class="h-px w-full bg-neutral-300"
                      aria-hidden="true"
                    />
                  )}
                  <div class="flex items-start gap-4">
                    <img
                      src={item.icon}
                      alt=""
                      width="32"
                      height="32"
                      class="shrink-0"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="flex flex-col gap-2">
                      <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                        {item.title}
                      </p>
                      <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                        {item.body}
                      </p>
                    </div>
                  </div>
                </>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
