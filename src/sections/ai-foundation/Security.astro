---
/**
 * "Bulletproof security." Figma node 16985:65221 ("9"). Three columns of
 * checklist cards. The mock's subheading paragraph under this heading is
 * leftover copy duplicated from the "surface you build agents on" section
 * (identical sentence, wrong topic) — the screenshot render shows no
 * subheading here, so it's dropped rather than reproduced verbatim.
 *
 * Icons: minimal inline strokes — the Figma exports are nested-mask SVGs
 * with no single downloadable asset per glyph (same treatment as the other
 * sections on this page).
 */
const columns = [
  {
    title: "CERTIFICATIONS & AUDITS",
    items: [
      { title: "SOC 2 Type II", body: "Annual audit compliance for data security", icon: "shield" },
      { title: "ISO 27001 / 22301", body: "Information security and business continuity", icon: "document" },
      { title: "VAPT", body: "Independent vulnerability assessment and penetration testing", icon: "search" },
      { title: "GDPR", body: "Aligned with GDPR, UAE PDPL and KSA PDPL", icon: "lock" },
    ],
  },
  {
    title: "ENCRYPTION & ACCESS",
    items: [
      { title: "AES 256-bit", body: "Military-grade encryption at rest", icon: "lock" },
      { title: "SSL transit", body: "Encrypted data in transit with TLS 1.3", icon: "shield" },
      { title: "Auth tokens", body: "Secure token-based authentication", icon: "key" },
      { title: "Role-based access control", body: "Permissions by role, down to the record", icon: "users" },
    ],
  },
  {
    title: "RESIDENCY & PRIVACY",
    items: [
      { title: "Data residency", body: "Each region runs on dedicated, sovereign infrastructure", icon: "server" },
      { title: "Privacy", body: "Regulatory-compliant data privacy in every country you file in", icon: "eye" },
      { title: "No model training", body: "Your data stays in your environment and never trains a model", icon: "ban" },
    ],
  },
];
---

<section class="bg-generic-00 max-lg:py-16 lg:py-20">
  <div class="container flex flex-col items-center gap-12">
    <h2 class="m-0 max-w-170 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]">
      Bulletproof security
    </h2>

    <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-3">
      {columns.map((col) => (
        <div class="flex flex-col rounded-xl border border-neutral-300 bg-generic-00">
          <div class="border-b border-neutral-300 p-6">
            <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
              {col.title}
            </p>
          </div>
          <div class="flex flex-col gap-6 p-6">
            {col.items.map((item, i) => (
              <>
                {i > 0 && <div class="h-px w-full bg-neutral-300" aria-hidden="true"></div>}
                <div class="flex items-start gap-4">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="shrink-0 text-nova-blue" aria-hidden="true">
                    {item.icon === "shield" && (
                      <path d="M12 3l7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                    )}
                    {item.icon === "document" && (
                      <>
                        <path d="M7 3h7l4 4v14H7V3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                        <path d="M14 3v4h4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                        <path d="M9.5 14l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </>
                    )}
                    {item.icon === "search" && (
                      <>
                        <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.5"></circle>
                        <path d="M20 20l-4.8-4.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                      </>
                    )}
                    {item.icon === "lock" && (
                      <>
                        <rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="1.5"></rect>
                        <path d="M8 11V7a4 4 0 1 1 8 0v4" stroke="currentColor" stroke-width="1.5"></path>
                      </>
                    )}
                    {item.icon === "key" && (
                      <>
                        <circle cx="8" cy="15" r="4" stroke="currentColor" stroke-width="1.5"></circle>
                        <path d="M11 12l9-9M16 7l2 2M19 4l2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                      </>
                    )}
                    {item.icon === "users" && (
                      <>
                        <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.5"></circle>
                        <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                        <circle cx="17" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"></circle>
                        <path d="M15.5 14.2c2.6.5 4.5 2.6 4.5 5.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                      </>
                    )}
                    {item.icon === "server" && (
                      <>
                        <rect x="4" y="4" width="16" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
                        <rect x="4" y="14" width="16" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
                        <path d="M8 7h.01M8 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                      </>
                    )}
                    {item.icon === "eye" && (
                      <>
                        <path d="M2 12c1-3.5 5-7 10-7s9 3.5 10 7c-1 3.5-5 7-10 7s-9-3.5-10-7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                        <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"></circle>
                      </>
                    )}
                    {item.icon === "ban" && (
                      <>
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"></circle>
                        <path d="M5.8 5.8l12.4 12.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                      </>
                    )}
                  </svg>
                  <div class="flex flex-col gap-2">
                    <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                      {item.title}
                    </p>
                    <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                      {item.body}
                    </p>
                  </div>
                </div>
              </>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
