---
/**
 * "Bulletproof security." Figma node 16985:65221 ("9"). Three columns of
 * checklist cards. The mock's subheading paragraph under this heading is
 * leftover copy duplicated from the "surface you build agents on" section
 * (identical sentence, wrong topic) — the screenshot render shows no
 * subheading here, so it's dropped rather than reproduced verbatim.
 *
 * ── ASSETS TO UPLOAD ─────────────────────────────────────────────────────
 * Icons are screenshot exports of their Figma icon nodes (16985:65244,
 * :65252, :65263, :65276, :65300, :65308, :65318, :65330, :65358, :65365,
 * :65374), saved to public/images/ai-foundation/icons/sec-*.png. Render in
 * `npm run dev` / `dist/preview`; resolve to nothing once pasted into
 * Webflow — upload each to Webflow assets and swap the `icon` paths below
 * for the CDN URLs first.
 * ─────────────────────────────────────────────────────────────────────────
 */
const columns = [
  {
    title: "CERTIFICATIONS & AUDITS",
    items: [
      { title: "SOC 2 Type II", body: "Annual audit compliance for data security", icon: "/images/ai-foundation/icons/sec-soc2.png" },
      { title: "ISO 27001 / 22301", body: "Information security and business continuity", icon: "/images/ai-foundation/icons/sec-iso.png" },
      { title: "VAPT", body: "Independent vulnerability assessment and penetration testing", icon: "/images/ai-foundation/icons/sec-vapt.png" },
      { title: "GDPR", body: "Aligned with GDPR, UAE PDPL and KSA PDPL", icon: "/images/ai-foundation/icons/sec-gdpr.png" },
    ],
  },
  {
    title: "ENCRYPTION & ACCESS",
    items: [
      { title: "AES 256-bit", body: "Military-grade encryption at rest", icon: "/images/ai-foundation/icons/sec-aes.png" },
      { title: "SSL transit", body: "Encrypted data in transit with TLS 1.3", icon: "/images/ai-foundation/icons/sec-ssl.png" },
      { title: "Auth tokens", body: "Secure token-based authentication", icon: "/images/ai-foundation/icons/sec-auth-tokens.png" },
      { title: "Role-based access control", body: "Permissions by role, down to the record", icon: "/images/ai-foundation/icons/sec-rbac.png" },
    ],
  },
  {
    title: "RESIDENCY & PRIVACY",
    items: [
      { title: "Data residency", body: "Each region runs on dedicated, sovereign infrastructure", icon: "/images/ai-foundation/icons/sec-data-residency.png" },
      { title: "Privacy", body: "Regulatory-compliant data privacy in every country you file in", icon: "/images/ai-foundation/icons/sec-privacy.png" },
      { title: "No model training", body: "Your data stays in your environment and never trains a model", icon: "/images/ai-foundation/icons/sec-no-training.png" },
    ],
  },
];
---

<section class="bg-generic-00 max-lg:py-16 lg:py-20">
  <div class="container flex flex-col items-center gap-12">
    <h2 class="m-0 max-w-170 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]">
      Bulletproof security
    </h2>

    <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-3">
      {columns.map((col) => (
        <div class="flex flex-col rounded-xl border border-neutral-300 bg-generic-00">
          <div class="border-b border-neutral-300 p-6">
            <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
              {col.title}
            </p>
          </div>
          <div class="flex flex-col gap-6 p-6">
            {col.items.map((item, i) => (
              <>
                {i > 0 && <div class="h-px w-full bg-neutral-300" aria-hidden="true"></div>}
                <div class="flex items-start gap-4">
                  <img src={item.icon} alt="" width="32" height="32" class="shrink-0" loading="lazy" decoding="async" />
                  <div class="flex flex-col gap-2">
                    <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                      {item.title}
                    </p>
                    <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                      {item.body}
                    </p>
                  </div>
                </div>
              </>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
