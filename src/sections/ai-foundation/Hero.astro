---
/**
 * Hero — AI Foundation. Figma node 16985:61465.
 *
 * Same Dotgrid + radial-wash treatment as cfo-insights/Hero.astro, with a
 * stats row (6000+ enterprises, 2,000+ integrations, 50+ countries, 10,000
 * e-invoices/sec) under the CTAs — unique to this page's hero, so it lives
 * here rather than in a shared primitive.
 *
 * "Book a demo" opens the HubSpot modal in `DemoModal.astro` (data-demo-open).
 * "See how it works" scrolls to the Comparison section further down the page.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

const stats = [
  { value: "6000+", label: "enterprises" },
  { value: "2,000+", label: "integrations delivered" },
  { value: "50+", label: "countries" },
  { value: "10,000", label: "e-invoices per second" },
];
---

<section
  id="hero"
  class="relative bg-generic-00 overflow-hidden flex items-center justify-center min-h-svh max-lg:pt-32 max-lg:pb-16 lg:pt-[140px] lg:pb-[80px]"
>
  <Dotgrid containerId="hero" baseColor="#C8F006" />

  <!-- Radial wash, so the headline keeps its contrast over the field -->
  <div
    class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"
  >
  </div>

  <div class="relative z-10 mx-auto lg:container w-full px-4 lg:px-8 pointer-events-auto">
    <div class="flex flex-col items-center gap-12 w-full">
      <div class="flex flex-col items-center gap-6 mx-auto text-center max-w-[923px]">
        <div class="flex flex-col items-center gap-4 max-w-139 lg:max-w-none">
          <h1
            class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h1)] lg:text-[length:var(--fs-display-sm)] xl:text-[length:var(--fs-display-lg)] leading-[length:var(--lh-h1)] lg:leading-[length:var(--lh-display-sm)] xl:leading-[length:var(--lh-display-lg)] tracking-[-1px] text-center text-balance"
          >
            Clarity AI, The <span class="bg-flux-lime px-1 rounded-lg">foundation</span> for finance AI
          </h1>
          <p
            class="m-0 font-body text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)] text-neutral-500 font-normal text-center max-w-156"
          >
            Connected to whatever data source you need, embedded with your business context, and the surface to build your own AI workflows.
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="https://www.cleartax.com/contact-us"
            data-demo-open
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 font-body rounded-lg font-medium text-nova-50 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] cursor-pointer bg-nova-blue border border-nova-blue shadow-[0px_2px_3px_rgba(16,24,40,0.06)] hover:bg-generic-00 hover:text-nova-blue transition-all duration-150 ease-in-out no-underline"
          >
            Book a demo
          </a>
          <a
            href="#comparison"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 font-body rounded-lg font-medium text-nova-blue text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] cursor-pointer bg-generic-00 border border-nova-blue shadow-[0px_2px_6px_rgba(16,24,40,0.06)] hover:bg-ledger-50 transition-all duration-150 ease-in-out no-underline"
          >
            See how it works
          </a>
        </div>
      </div>

      <div class="flex flex-wrap items-stretch justify-center gap-x-2 gap-y-6">
        {stats.map((stat, i) => (
          <>
            {i > 0 && (
              <span class="hidden sm:block w-0.5 rounded-full bg-ledger-100 my-2" aria-hidden="true" />
            )}
            <div class="flex flex-col items-center justify-center gap-2 px-6 py-4 text-center w-[200px]">
              <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)]">
                {stat.value}
              </p>
              <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                {stat.label}
              </p>
            </div>
          </>
        ))}
      </div>
    </div>
  </div>
</section>
