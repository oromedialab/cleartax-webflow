---
/**
 * "Generic AI sees what you prompt. Clarity AI knows your business." Figma
 * node 16985:65154 ("Fold 18"). Three parallel cards — capability labels,
 * what a generic assistant does with them (crosses), what Clarity AI does
 * (checks, lime-bordered) — rather than cfo-insights/Comparison.astro's
 * row-wise table, since this mock stacks three independent columns.
 *
 * Row heights can't be left to each column's own flow: "Knows your
 * financial context…" wraps to two lines while its neighbours don't, so
 * three independent `flex-col`s drift out of alignment row by row. Fixed
 * with CSS subgrid — the outer grid owns one shared set of 7 row tracks
 * (title + 6 rows), and each column is `grid-rows-subgrid` so its cells
 * size to the tallest cell in that row across all three columns, not just
 * its own content.
 *
 * `id="comparison"` is the Hero's "See how it works" anchor target.
 *
 * The cross/check marks are already-uploaded Webflow assets (cross.png /
 * tick.png). Only 5 of the 6 capability rows get a cross/check (Figma nodes
 * 16985:65176–:65188 — five icons, not six); the 6th row is the summary
 * line ("Re-reads everything…" / "Data and context already resident")
 * rendered in place of an icon, not appended below a full set of six.
 */
const rows = [
  "Knows your transaction-level data",
  "Knows your financial context: rate history, credit note timing, entity structure",
  "Reconciles books against source systems and government records",
  "Every figure traceable to a source record",
  "Consolidated across entities, currencies and jurisdictions",
  "Cost per query at scale",
];

const bottomRow = {
  title: rows[5],
  generalAi: "Re-reads everything, every time",
  clarityAi: "Data and context already resident",
};

const crossIcon =
  "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf117985dedd28f5678d9c_cross.png";
const tickIcon =
  "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf11793e74617468a37fed_tick.png";
---

<section id="comparison" class="bg-generic-00 max-lg:py-16 lg:py-20">
  <div
    class="max-w-[var(--container-max)] mx-auto w-full px-4 md:px-6 flex flex-col items-center gap-12"
  >
    <h2
      class="m-0 max-w-170 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]"
    >
      Generic AI sees what you prompt. Clarity AI knows your business.
    </h2>

    <!-- Desktop Comparison Table (Hidden on Mobile) -->
    <div
      class="hidden lg:grid w-full grid-cols-3 grid-rows-[repeat(7,auto)] gap-6"
    >
      <div
        class="grid grid-rows-subgrid gap-0 divide-y divide-neutral-300 rounded-xl border border-neutral-300 p-8 row-span-7"
      >
        <p
          class="m-0 pb-7 font-heading text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]"
        >
          Capability
        </p>
        {
          rows.map((row) => (
            <p class="m-0 flex items-center py-3.5 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
              {row}
            </p>
          ))
        }
      </div>

      <div
        class="grid grid-rows-subgrid gap-0 divide-y divide-neutral-300 rounded-xl border border-neutral-300 p-8 text-center row-span-7"
      >
        <p
          class="m-0 pb-7 font-heading text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]"
        >
          General AI assistants
        </p>
        {
          rows.map((_, i) =>
            i < rows.length - 1 ? (
              <span class="flex items-center justify-center py-7">
                <img
                  src={crossIcon}
                  alt=""
                  width="20"
                  height="20"
                  class="shrink-0"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : (
              <p class="m-0 flex items-center justify-center py-3.5 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                {bottomRow.generalAi}
              </p>
            ),
          )
        }
      </div>

      <div
        class="grid grid-rows-subgrid gap-0 divide-y divide-neutral-300 rounded-xl border border-flux-lime bg-generic-00 p-8 text-center row-span-7"
      >
        <p
          class="m-0 pb-7 font-heading font-semibold text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]"
        >
          With Clarity AI
        </p>
        {
          rows.map((_, i) =>
            i < rows.length - 1 ? (
              <span class="flex items-center justify-center py-7">
                <img
                  src={tickIcon}
                  alt=""
                  width="20"
                  height="20"
                  class="shrink-0"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : (
              <p class="m-0 flex items-center justify-center py-3.5 font-body font-medium text-nova-blue text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                {bottomRow.clarityAi}
              </p>
            ),
          )
        }
      </div>
    </div>

    <!-- Mobile View (Hidden on Desktop): Tabbed 2-Column Comparison + Static Bottom Card -->
    <div
      class="lg:hidden w-full flex flex-col"
      id="ai-cmp-mobile-container"
      data-active-index="1"
    >
      <!-- Mobile Pill Tabs -->
      <div class="mb-6 flex justify-center w-full max-w-full">
        <div
          class="ai-cmp-tabs-nav inline-flex p-1 rounded-full border border-solid border-neutral-300 bg-slate-50 gap-1 overflow-x-auto max-w-full shadow-sm"
        >
          <button
            type="button"
            class="ai-cmp-tab-btn border-none bg-transparent py-2 px-4 rounded-full font-body text-[length:var(--fs-label-sm)] font-semibold text-slate-500 cursor-pointer transition-all duration-300 data-[active=true]:bg-nova-blue data-[active=true]:text-generic-00 data-[active=true]:shadow-sm uppercase"
            data-index="0"
          >
            General AI
          </button>
          <button
            type="button"
            class="ai-cmp-tab-btn border-none bg-transparent py-2 px-4 rounded-full font-body text-[length:var(--fs-label-sm)] font-semibold text-slate-500 cursor-pointer transition-all duration-300 data-[active=true]:bg-nova-blue data-[active=true]:text-generic-00 data-[active=true]:shadow-sm uppercase"
            data-index="1"
            data-active="true"
          >
            Clarity AI
          </button>
        </div>
      </div>

      <!-- 2-Column Mobile Table: Left Capability + Right Slider Viewport -->
      <div class="ai-cmp-table">
        <div class="grid grid-cols-2 items-stretch">
          <!-- Column 1: Capability (Fixed on Left) -->
          <div class="flex flex-col ai-cmp-col-border bg-generic-00">
            <!-- Col 1 Header -->
            <div class="p-3.5 flex items-center ai-cmp-header min-h-[72px]">
              <h3
                class="font-heading text-[length:var(--fs-body)] sm:text-[length:var(--fs-body-lg)] font-medium tracking-wider text-text-default uppercase m-0"
              >
                CAPABILITY
              </h3>
            </div>
            <!-- Col 1 Rows -->
            <ul class="list-none m-0 p-0 flex flex-col">
              {
                rows.map((row) => (
                  <li class="ai-cmp-col1-item p-3.5 font-body text-[length:var(--fs-body-sm)] min-h-[76px] flex items-center ai-cmp-mob-row text-neutral-500 leading-snug">
                    {row}
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Column 2: Sliding Viewport on Right -->
          <div
            class="ai-cmp-slider-viewport flex flex-col min-w-0 overflow-hidden w-full relative"
          >
            <div
              id="ai-cmp-slider-track"
              class="ai-cmp-slider-track flex w-full transition-transform duration-300 ease-out"
              style="transform: translateX(-100%);"
            >
              <!-- Slide 0: General AI -->
              <div
                class="ai-cmp-slide w-full shrink-0 flex flex-col bg-generic-00"
                data-slide-index="0"
              >
                <!-- Header -->
                <div
                  class="p-3 flex items-center justify-center text-center ai-cmp-header min-h-[72px]"
                >
                  <h3
                    class="font-heading text-[length:var(--fs-body)] sm:text-[length:var(--fs-body-lg)] font-medium tracking-wider text-text-default uppercase m-0"
                  >
                    GENERAL AI
                  </h3>
                </div>
                <!-- Rows: 5 'x' icons + 6th summary text -->
                <ul class="list-none m-0 p-0 flex flex-col">
                  {
                    rows.map((_, i) => (
                      <li class="ai-cmp-row-item min-h-[76px] p-3 ai-cmp-mob-row flex items-center justify-center text-center">
                        {i < rows.length - 1 ? (
                          <img
                            src={crossIcon}
                            alt=""
                            width="20"
                            height="20"
                            class="shrink-0"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span class="font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-snug">
                            {bottomRow.generalAi}
                          </span>
                        )}
                      </li>
                    ))
                  }
                </ul>
              </div>

              <!-- Slide 1: Clarity AI -->
              <div
                class="ai-cmp-slide w-full shrink-0 flex flex-col bg-generic-00"
                data-slide-index="1"
              >
                <!-- Header: Flux Lime background matching desktop hero card and Capability.astro -->
                <div
                  class="p-3 bg-flux-lime flex items-center justify-center text-center ai-cmp-header min-h-[72px]"
                >
                  <h3
                    class="font-heading text-[length:var(--fs-body)] sm:text-[length:var(--fs-body-lg)] font-medium tracking-wider text-vault-navy uppercase m-0"
                  >
                    CLARITY AI
                  </h3>
                </div>
                <!-- Rows: 5 'right' / check icons + 6th summary text -->
                <ul class="list-none m-0 p-0 flex flex-col">
                  {
                    rows.map((_, i) => (
                      <li class="ai-cmp-row-item min-h-[76px] p-3 ai-cmp-mob-row flex items-center justify-center text-center">
                        {i < rows.length - 1 ? (
                          <img
                            src={tickIcon}
                            alt=""
                            width="20"
                            height="20"
                            class="shrink-0"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span class="font-body font-medium text-nova-blue text-[length:var(--fs-body-sm)] leading-snug">
                            {bottomRow.clarityAi}
                          </span>
                        )}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Mobile Table Container */
  .ai-cmp-table {
    border: 1px solid var(--color-border, #cccccc);
    border-radius: 16px;
    background-color: var(--color-generic-00, #ffffff);
    overflow: hidden;
    isolation: isolate;
    contain: paint;
  }

  /* Solid header divider */
  .ai-cmp-header {
    border-bottom: 1px solid var(--color-border, #cccccc);
  }

  /* Solid vertical column divider */
  .ai-cmp-col-border {
    border-right: 1px solid var(--color-border, #cccccc);
  }

  /* Horizontal dashed dividers between data rows */
  .ai-cmp-mob-row:not(:last-child) {
    border-bottom: 1px solid var(--palette-neutral-300, #9ca3af);
  }
</style>

<script is:inline>
  (function () {
    function initAiComparisonCarousel() {
      const container = document.getElementById("ai-cmp-mobile-container");
      if (!container) return;

      const track = document.getElementById("ai-cmp-slider-track");
      const tabBtns = container.querySelectorAll(".ai-cmp-tab-btn");
      const col1Items = container.querySelectorAll(".ai-cmp-col1-item");
      const slides = container.querySelectorAll(".ai-cmp-slide");

      if (!track || !tabBtns.length) return;

      let currentIndex = parseInt(
        container.getAttribute("data-active-index") || "1",
        10,
      );
      const totalSlides = 2;

      function updateSlide(index, animate = true) {
        currentIndex = Math.max(0, Math.min(index, totalSlides - 1));
        container.setAttribute("data-active-index", currentIndex.toString());

        if (animate) {
          track.style.transition =
            "transform 350ms cubic-bezier(0.25, 1, 0.5, 1)";
        } else {
          track.style.transition = "none";
        }

        track.style.transform = `translateX(-${currentIndex * 100}%)`;

        tabBtns.forEach((btn, i) => {
          if (i === currentIndex) {
            btn.setAttribute("data-active", "true");
          } else {
            btn.removeAttribute("data-active");
          }
        });
      }

      // Synchronize row heights between Column 1 and all slides
      function syncHeights() {
        if (window.innerWidth >= 1024) return;

        col1Items.forEach((el) => (el.style.minHeight = ""));
        slides.forEach((slide) => {
          slide
            .querySelectorAll(".ai-cmp-row-item")
            .forEach((el) => (el.style.minHeight = ""));
        });

        const numRows = col1Items.length;
        for (let r = 0; r < numRows; r++) {
          let maxH = col1Items[r].offsetHeight;
          slides.forEach((slide) => {
            const rowItem = slide.querySelectorAll(".ai-cmp-row-item")[r];
            if (rowItem) maxH = Math.max(maxH, rowItem.offsetHeight);
          });
          const finalH = Math.max(maxH, 72) + "px";
          col1Items[r].style.minHeight = finalH;
          slides.forEach((slide) => {
            const rowItem = slide.querySelectorAll(".ai-cmp-row-item")[r];
            if (rowItem) rowItem.style.minHeight = finalH;
          });
        }
      }

      // Tab Button Clicks
      tabBtns.forEach((btn) => {
        if (btn.getAttribute("data-listener-attached")) return;
        btn.setAttribute("data-listener-attached", "true");

        btn.addEventListener("click", () => {
          const idx = parseInt(btn.getAttribute("data-index") || "0", 10);
          updateSlide(idx, true);
        });
      });

      // Touch Swipe & Drag Handling
      const viewport = container.querySelector(".ai-cmp-slider-viewport");
      if (viewport && !viewport.getAttribute("data-swipe-attached")) {
        viewport.setAttribute("data-swipe-attached", "true");

        let startX = 0;
        let startY = 0;
        let currentX = 0;
        let isDragging = false;
        let isHorizontal = null;

        viewport.addEventListener(
          "touchstart",
          (e) => {
            if (e.touches.length !== 1) return;
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
            currentX = startX;
            isDragging = true;
            isHorizontal = null;
            track.style.transition = "none";
          },
          { passive: true },
        );

        viewport.addEventListener(
          "touchmove",
          (e) => {
            if (!isDragging || e.touches.length !== 1) return;
            currentX = e.touches[0].clientX;
            const diffX = currentX - startX;
            const diffY = e.touches[0].clientY - startY;

            if (isHorizontal === null) {
              if (Math.abs(diffX) > 5 || Math.abs(diffY) > 5) {
                isHorizontal = Math.abs(diffX) > Math.abs(diffY);
              }
            }

            if (isHorizontal) {
              const viewportWidth = viewport.offsetWidth || 1;
              const percentOffset = (diffX / viewportWidth) * 100;
              const basePercent = -currentIndex * 100;
              track.style.transform = `translateX(${basePercent + percentOffset}%)`;
            }
          },
          { passive: true },
        );

        viewport.addEventListener(
          "touchend",
          () => {
            if (!isDragging) return;
            isDragging = false;

            if (isHorizontal) {
              const diffX = currentX - startX;
              if (diffX < -40 && currentIndex < totalSlides - 1) {
                updateSlide(currentIndex + 1, true);
              } else if (diffX > 40 && currentIndex > 0) {
                updateSlide(currentIndex - 1, true);
              } else {
                updateSlide(currentIndex, true);
              }
            } else {
              updateSlide(currentIndex, true);
            }
          },
          { passive: true },
        );
      }

      syncHeights();
      updateSlide(currentIndex, false);
      window.addEventListener("resize", syncHeights);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAiComparisonCarousel);
    } else {
      initAiComparisonCarousel();
    }

    document.addEventListener("astro:page-load", initAiComparisonCarousel);
  })();
</script>
