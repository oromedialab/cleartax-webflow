---
/**
 * "Generic AI sees what you prompt. Clarity AI knows your business." Figma
 * node 16985:65154 ("Fold 18"). Three parallel cards — capability labels,
 * what a generic assistant does with them (crosses), what Clarity AI does
 * (checks, lime-bordered) — rather than cfo-insights/Comparison.astro's
 * row-wise table, since this mock stacks three independent columns.
 *
 * `id="comparison"` is the Hero's "See how it works" anchor target.
 */
const rows = [
  "Knows your transaction-level data",
  "Knows your financial context: rate history, credit note timing, entity structure",
  "Reconciles books against source systems and government records",
  "Every figure traceable to a source record",
  "Consolidated across entities, currencies and jurisdictions",
  "Cost per query at scale",
];
---

<section id="comparison" class="bg-generic-00 max-lg:py-16 lg:py-20">
  <div class="container flex flex-col items-center gap-12">
    <h2 class="m-0 max-w-170 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]">
      Generic AI sees what you prompt. Clarity AI knows your business.
    </h2>

    <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="flex flex-col gap-7 rounded-xl border border-neutral-300 p-8">
        <p class="m-0 font-heading text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">
          Capability
        </p>
        <div class="flex flex-col">
          {rows.map((row, i) => (
            <>
              {i > 0 && <div class="h-px w-full bg-neutral-300" aria-hidden="true"></div>}
              <p class="m-0 py-3.5 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                {row}
              </p>
            </>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-7 rounded-xl border border-neutral-300 p-8 text-center">
        <p class="m-0 font-heading text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">
          General AI assistants
        </p>
        <div class="flex flex-col items-center">
          {rows.map((_, i) => (
            <>
              {i > 0 && <div class="h-px w-full bg-neutral-300" aria-hidden="true"></div>}
              <span class="flex h-11 items-center justify-center">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="text-neutral-400" aria-hidden="true">
                  <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                </svg>
              </span>
            </>
          ))}
          <p class="m-0 pt-3.5 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
            Re-reads everything, every time
          </p>
        </div>
      </div>

      <div class="flex flex-col gap-7 rounded-xl border border-flux-lime bg-generic-00 p-8 text-center">
        <p class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">
          With Clarity AI
        </p>
        <div class="flex flex-col items-center">
          {rows.map((_, i) => (
            <>
              {i > 0 && <div class="h-px w-full bg-neutral-300" aria-hidden="true"></div>}
              <span class="flex h-11 items-center justify-center">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="text-nova-blue" aria-hidden="true">
                  <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </>
          ))}
          <p class="m-0 pt-3.5 font-body font-medium text-nova-blue text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
            Data and context already resident
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
