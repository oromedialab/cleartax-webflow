---
/**
 * "AI in finance is hard because building a reliable foundation is hard."
 * Figma node 16985:63065 ("22"). An 80/20 work-breakdown card: three steps
 * that eat most of an AI project (finding data, cleaning it, applying
 * business context), then the one step — the answer — that's actually easy.
 *
 * ── ASSETS TO UPLOAD ─────────────────────────────────────────────────────
 * Icons are cropped from screenshot exports of their Figma icon+text ROW
 * nodes (16985:63078, :63093, :63101, :63121), saved locally to
 * public/images/ai-foundation/icons/wb-*.png. Screenshotting the icon's own
 * node in isolation (16985:63079 etc.) renders distorted — those icons use
 * a mask + rotate(-180) + scaleX(-100) construction with container-query
 * sizing (`100cqh`/`100cqw`) that doesn't resolve outside its original
 * layout flow — so the crop comes from the correctly-rendered parent row
 * instead. Render in `npm run dev` / `dist/preview`; resolve to nothing
 * once pasted into Webflow — upload each to Webflow assets and swap the
 * `icon` paths below for the CDN URLs first.
 * ─────────────────────────────────────────────────────────────────────────
 *
 * The decorative dot clusters flanking the "20% of the work" card
 * (16985:63135 / :63154) are a 4×4 grid of 4px squares on a 24px pitch —
 * pixel-sampled from the Figma export (`wb-dot-cluster.png`) and rebuilt as
 * a Tailwind grid (`grid-cols-4 gap-5`, each cell `w-1 h-1`) rather than an
 * image, since it reproduces exactly and costs nothing against the Embed
 * budget.
 */
const majorSteps = [
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acdfe2ee29930062b824d64_finance-1.png",
    title: "A question gets asked.",
    body: "About an audit query, or a margin variance, or supply chain cost.",
  },
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acdfe2e561905c76ee5585b_finance-2.png",
    title: "Answering it needs clean data.",
    body: "Which is spread across multiple spreadsheets, and disconnected systems.",
  },
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acdfe2e5d562af1d31ce728_finance-3.png",
    title: "Make AI interpret the data, based on your business context",
    body: "More days/ weeks spent transforming the data, and applying your business logic, for one AI project. Repeat for the next AI project.",
  },
];
---

<section class="bg-generic-00 max-lg:py-16 lg:py-20">
  <div class="container flex flex-col items-center gap-12">
    <h2
      class="m-0 max-w-172 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]"
    >
      AI in finance is hard because building a reliable foundation is hard.
    </h2>

    <div class="flex w-full flex-col gap-6">
      <div class="rounded-xl border-2 border-neutral-300 bg-generic-00 p-7">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between lg:gap-14">
          <div class="flex flex-col gap-2 lg:w-60 lg:shrink-0">
            <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)]">
              80% of the work
            </p>
            <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
              Finding the data · Applying the context · Building the trail
            </p>
          </div>

          <div class="relative flex flex-col gap-6 pl-8 lg:max-w-145">
            <span
              class="absolute left-0 top-2 bottom-2 block w-1.5 rounded-full bg-nova-blue"
              aria-hidden="true"
            ></span>
            {majorSteps.map((step) => (
              <div class="flex gap-6 items-start">
                <div class="max-w-8 w-full aspect-square relative shrink-0 ">
                  <img
                    src={step.icon}
                    alt=""
                    width="32"
                    height="32"
                    class="object-contain w-full h-full"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="flex flex-1 flex-col gap-2">
                  <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">
                    {step.title}
                  </p>
                  <p class="m-0 font-body text-neutral-500/80 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                    {step.body}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="flex items-center justify-center gap-6">
        <div class="hidden shrink-0 grid-cols-4 gap-5 xl:grid" aria-hidden="true">
          {Array.from({ length: 16 }).map(() => (
            <span class="h-1 w-1 bg-flux-lime"></span>
          ))}
        </div>

        <div class="flex w-full flex-col gap-6 rounded-xl border-2 border-neutral-300 bg-generic-00 p-7 lg:max-w-242 lg:flex-row lg:items-center">
          <div class="flex flex-col gap-2 lg:w-60 lg:shrink-0">
            <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)]">
              20% of the work
            </p>
            <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
              Producing the answer
            </p>
          </div>

          <div class="relative flex gap-6 pl-8 items-start">
            <span
              class="absolute left-0 top-0 bottom-0 block w-1.5 rounded-full bg-flux-lime"
              aria-hidden="true"
            ></span>
            <div class="max-w-8 w-full aspect-square relative shrink-0 items-start">
              <img
                src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acdfe2ea4cfb4d540c4d571_finance-4.png"
                alt=""
                width="32"
                height="32"
                class="w-full h-full object-center"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="flex flex-col gap-2">
              <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">
                Only then, the answer.
              </p>
              <p class="m-0 font-body text-neutral-500/80 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                The easy part. The weeks are already gone.
              </p>
            </div>
          </div>
        </div>

        <div class="hidden shrink-0 grid-cols-4 gap-5 xl:grid" aria-hidden="true">
          {Array.from({ length: 16 }).map(() => (
            <span class="h-1 w-1 bg-flux-lime"></span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
