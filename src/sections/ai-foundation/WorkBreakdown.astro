---
/**
 * "AI in finance is hard because building a reliable foundation is hard."
 * Figma node 16985:63065 ("22"). An 80/20 work-breakdown card: three steps
 * that eat most of an AI project (finding data, cleaning it, applying
 * business context), then the one step — the answer — that's actually easy.
 *
 * The Figma icons are nested nested-mask exports with no single downloadable
 * asset; rebuilt here as minimal inline strokes (same treatment
 * `trust-centre/Certifications.astro` uses for its globe glyph) rather than
 * reassembling multi-layer masks for decorative icons.
 */
const majorSteps = [
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acdfe2ee29930062b824d64_finance-1.png",
    title: "A question gets asked.",
    body: "About an audit query, or a margin variance, or supply chain cost.",
  },
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acdfe2e561905c76ee5585b_finance-2.png",
    title: "Answering it needs clean data.",
    body: "Which is spread across multiple spreadsheets, and disconnected systems.",
  },
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acdfe2e5d562af1d31ce728_finance-3.png",
    title: "Make AI interpret the data, based on your business context",
    body: "More days/ weeks spent transforming the data, and applying your business logic, for one AI project. Repeat for the next AI project.",
  },
];
---

<section class="bg-generic-00 max-lg:py-16 lg:py-20">
  <div class="container flex flex-col items-center gap-12">
    <h2
      class="m-0 max-w-172 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]"
    >
      AI in finance is hard because building a reliable foundation is hard.
    </h2>

    <div class="flex w-full flex-col gap-6">
      <div class="rounded-xl border-2 border-neutral-300 bg-generic-00 p-7">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between lg:gap-14">
          <div class="flex flex-col gap-2 lg:w-60 lg:shrink-0">
            <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)]">
              80% of the work
            </p>
            <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
              Finding the data · Applying the context · Building the trail
            </p>
          </div>

          <div class="relative flex flex-col gap-6 lg:max-w-145">
            <span
              class="absolute left-4 top-2 bottom-2 hidden w-0.5 rounded-full bg-nova-blue lg:block"
              aria-hidden="true"
            ></span>
            {majorSteps.map((step) => (
              <div class="flex gap-6">
                <div class="max-w-8 w-full aspect-square">
                  <img src={step.icon} alt={step.title} class="w-full h-full" />
                </div>
                <div class="flex flex-1 flex-col gap-2">
                  <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">
                    {step.title}
                  </p>
                  <p class="m-0 font-body text-neutral-500/80 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                    {step.body}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="flex justify-center">
        <div class="flex w-full flex-col gap-6 rounded-xl border-2 border-neutral-300 bg-generic-00 p-7 lg:max-w-242 lg:flex-row lg:items-center lg:gap-14">
          <div class="flex flex-col gap-2 lg:w-60 lg:shrink-0">
            <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)]">
              20% of the work
            </p>
            <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
              Producing the answer
            </p>
          </div>

          <div class="relative flex gap-6">
            <span
              class="absolute left-4 top-2 bottom-2 hidden w-0.5 rounded-full bg-flux-lime lg:block"
              aria-hidden="true"
            ></span>
            <div class="max-w-8 w-full aspect-square">
              <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acdfe2ea4cfb4d540c4d571_finance-4.png" alt="Message">
            </div>
            <div class="flex flex-col gap-2">
              <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)]">
                Only then, the answer.
              </p>
              <p class="m-0 font-body text-neutral-500/80 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                The easy part. The weeks are already gone.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
