---
/**
 * "Your context is across even more systems than your data." Figma node
 * 16985:63426 ("12"). Left: four cards of the context layered on top of raw
 * data. Right: the isometric "Clarity AI" stack illustration.
 *
 * ── ASSETS TO UPLOAD ─────────────────────────────────────────────────────
 * The illustration is `public/images/ai-foundation/context-layers-illustration.png`
 * — a screenshot export of Figma node 16985:63481, since it's built from
 * hundreds of individual face/dot SVGs with no single exportable asset.
 * Card icons are screenshot exports of their own icon nodes (16985:63436,
 * :63448, :63460, :63474), saved to public/images/ai-foundation/icons/cl-*.png.
 * All render in `npm run dev` / `dist/preview`; resolve to nothing once
 * pasted into Webflow — upload each to Webflow assets and swap the `src`
 * paths below for the CDN URLs first.
 * ─────────────────────────────────────────────────────────────────────────
 */
const contextCards = [
  {
    title: "Linked records",
    body: "Every system joined at transaction level. PO → GRN → invoice → payment → GL, reconciled against banks, government and counterparties.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf0dde713c08fdd3edcc07_system-1.png",
  },
  {
    title: "Statutory logic",
    body: "Rates, classification and filing rules across 50+ countries, versioned by date.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf0ddef8dc7b66d5a4d789_system-2.png",
  },
  {
    title: "Your logic",
    body: "GL structure, credit note timing, vendor and item definitions, and the recons and checks your team runs.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf0dde0334db6cd33658d7_system-3.png",
  },
  {
    title: "Institutional memory",
    body: "Every investigation and the decision it led to, logged. Plus the rules your finance team carries in its head.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf0dde3e74617468a27b29_system-4.png",
  },
];
---

<section class="bg-generic-00 max-lg:py-16 lg:py-20">
  <div class="container flex flex-col gap-12">
    <div class="flex flex-col items-center gap-4 text-center">
      <h2 class="m-0 max-w-170 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px]">
        Your context is across even more systems than your data
      </h2>
      <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
        Data says what happened. Context says what it means
      </p>
    </div>

    <div class="flex flex-col items-start gap-8 lg:flex-row lg:gap-8">
      <div class="flex w-full flex-col gap-6 lg:w-1/2">
        {contextCards.map((card) => (
          <div class="rounded-xl border border-neutral-300 bg-generic-00 px-5.5 py-6">
            <div class="flex items-center gap-4">
              <img src={card.icon} alt="" width="32" height="32" class="shrink-0" loading="lazy" decoding="async" />
              <p class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                {card.title}
              </p>
            </div>
            <p class="m-0 mt-4 lg:mt-6 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
              {card.body}
            </p>
          </div>
        ))}
      </div>

      <div class="flex max-w-[608px] w-full aspect-[608/664] items-center justify-center lg:w-1/2">
        <img
          src="/images/ai-foundation/context-layers-illustration.png"
          alt="Isometric illustration of the Clarity AI context layer stacking above the raw data layer"
          width="608"
          height="664"
          class="h-full w-full object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
