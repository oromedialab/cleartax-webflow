---
/**
 * Compliance section for UAE Product page.
 * Highlights e-invoicing as a company-wide compliance risk rather than just an IT project,
 * detailing FTA penalty risks and automated audit triggers.
 */
const bullets = [
    "AED 100 per invoice not issued or transmitted (capped at AED 5,000/month per category)",
    "AED 1,000 per day for failure to notify the authority of system errors",
    "FTA cross-references your VAT returns against e-invoice data; any gaps trigger audits",
];
---

<section id="compliance-risk" class="bg-generic-00 py-16 lg:py-20">
    <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
        <!-- Section Header -->
        <div class="text-center mb-12">
            <h2 class="text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-vault-navy font-heading max-w-180 mx-auto m-0">
                E-invoicing isn't just an IT project. It's a company-wide
                compliance risk.
            </h2>
        </div>

        <!-- 2-Column Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            <!-- Left Column: Copy & Bullets -->
            <div class="flex flex-col lg:col-span-6">
                <p class="text-neutral-500 font-normal text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] font-body mb-4 sm:mb-6 m-0">
                    When the mandate goes live, every B2B and B2G transaction
                    your business issues must pass through a Peppol-certified
                    Access Point and be reported to the FTA in real time. Get it
                    wrong even once, and the penalties stack up fast.
                </p>

                <ul class="flex flex-col gap-4 list-none p-0 m-0">
                    {bullets.map((bullet) => (
                        <li class="flex items-start gap-3">
                            <span
                                class="size-2 rounded-full bg-nova-blue shrink-0 mt-2"
                                aria-hidden="true"
                            ></span>
                            <span class="text-neutral-500 font-normal text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-body">
                                {bullet}
                            </span>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Right Column: Visual Placeholder Container -->
            <div class="w-full lg:col-span-6">
                <div class="w-full aspect-[620/288] rounded-lg bg-visual-placeholder overflow-hidden"></div>
            </div>
        </div>
    </div>
</section>
