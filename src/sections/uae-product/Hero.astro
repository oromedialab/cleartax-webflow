---
/**
 * Hero section for Indirect Tax page.
 * Uses interactive Dotgrid in Flux Lime with high-contrast radial wash,
 * brand typography, and tailored copy.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

interface Props {
    lineWidth?: number;
    gap?: number;
    maxLength?: number;
    lengthRadius?: number;
    tilt?: number;
    baseColor?: string;
    cursorRadius?: number;
    pull?: number;
    fadeRadius?: number;
    titlePrefix?: string;
    titleHighlight?: string;
    titleSuffix?: string;
    description?: string;
}

const {
    lineWidth = 3,
    gap = 24,
    maxLength = 6,
    lengthRadius = 260,
    tilt = 1,
    baseColor = "#C8F006",
    cursorRadius = 320,
    pull = 14,
    fadeRadius = 40,
    titlePrefix = "Choosing an ASP isn't a",
    titleHighlight = "Go-live",
    titleSuffix = "plan for UAE e-invoicing",
    description = "UAE enterprises must appoint an ASP by 30 October 2026 and implement e-invoicing from 1 January 2027. The 2 months time is crucial to connect the ERP/ billing systems, test invoice data, and prepare for go-live.",
} = Astro.props;

const badges = [
    {
        value: "FTA-approved",
        label: "Accredited Service Provider (ASP)",
    },
    {
        value: "Open Peppol Access Point",
        label: "Supporting UAE's 5-corner model",
    },
    {
        value: "Integrate with",
        label: "any ERP/POS within days",
    },
    {
        value: "Cloud-Based",
        label: "e-Invoice Management Portal",
    },
];
---

<section
    class="de-hero-section relative bg-generic-00 overflow-hidden flex flex-col max-lg:pt-32 max-lg:pb-16 lg:pt-[257px] lg:pb-[161px]"
    id="hero"
>
    <!-- Interactive Dot Grid Background -->
    <Dotgrid
        containerId="hero"
        lineWidth={lineWidth}
        gap={gap}
        maxLength={maxLength}
        lengthRadius={lengthRadius}
        tilt={tilt}
        baseColor={baseColor}
        cursorRadius={cursorRadius}
        pull={pull}
        fadeRadius={fadeRadius}
    />

    <!-- Radial wash, so the headline keeps its contrast over the field -->
    <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"></div>

    <div class="relative z-10 mx-auto lg:container w-full h-full flex flex-col px-4 md:px-6 pointer-events-auto">
        <div class="flex justify-center w-full h-full">
            <!-- Hero Content -->
            <div class="hero-content flex flex-col items-center mx-auto text-center w-full h-full">
                <!-- Headline -->
                <h1 class="text-[length:var(--fs-h1)] sm:text-[length:var(--fs-display-sm)] lg:text-[length:var(--fs-display-lg)] leading-[length:var(--lh-h1)] sm:leading-[length:var(--lh-display-sm)] lg:leading-[length:var(--lh-display-lg)] text-generic-100 font-semibold font-heading max-w-190 mx-auto mb-4 m-0 text-center">
                    {titlePrefix}
                    {titleHighlight && (
                        <span class="text-generic-100 bg-flux-lime partner-hero-mark rounded-lg">
                            {titleHighlight}
                        </span>
                    )}
                    {titleSuffix}
                </h1>

                <!-- Description -->
                <p class="text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-base)] sm:leading-[length:var(--lh-body-lg)] max-w-205 text-neutral-500 font-medium font-body text-center">
                    {description}
                </p>
                <ul
                    aria-label="UAE e-invoicing highlights"
                    class="m-0 mt-4 lg:mt-8 flex w-full max-w-[1188px] list-none flex-wrap lg:flex-nowrap overflow-hidden rounded-xl border border-neutral-300 bg-generic-00 p-0"
                >
                    {badges.map((badge, index) => (
                        <li class="flex w-full md:w-1/2 lg:w-1/4 lg:flex-1 items-center gap-3 p-3 text-left">
