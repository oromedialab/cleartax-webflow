---
/**
 * FAQ for the UAE Product page.
 * Uses _shared/FaqRb.astro for accordion structure, schema markup, and styling.
 * Questions and answers for the UAE e-invoicing mandate (PINT AE / FTA / MoF).
 */
import FaqRb from "../_shared/FaqRb.astro";
import type { FaqItem } from "../_shared/FaqRb.astro";

const items: FaqItem[] = [
    {
        q: "What is e-invoicing in the UAE?",
        a: "E-invoicing is the exchange of invoices and credit notes in a structured digital format for automated processing, using the UAE's Peppol-based 5-corner model.",
    },
    {
        q: "When is e-invoicing being implemented, and what are the phases for UAE?",
        a: [
            {
                kind: "p",
                html: "The rollout starts with a pilot and voluntary adoption on 1 July 2026. Mandatory implementation follows in phases:",
            },
            {
                kind: "ul",
                items: [
                    "AED 50 million or more revenue: ASP by 31 July 2026; go live by 1 January 2027",
                    "Below AED 50 million revenue: ASP by 31 March 2027; go live by 1 July 2027",
                    "Government entities: ASP by 31 March 2027; go live by 1 October 2027",
                ],
            },
        ],
    },
    {
        q: "What is the role of accredited service providers (ASPs) in e-invoicing?",
        a: "ASPs onboard businesses, validate and convert invoice data, exchange invoices securely, report tax data to the FTA, and support compliance.",
    },
    {
        q: "What are the key features of ClearTax electronic invoicing software for UAE?",
        a: "ClearTax offers a Peppol-ready e-invoicing solution for the UAE with support for seamless ERP/POS integration, a unified global e-invoicing API, end-to-end invoice exchange, automated error management, dashboards and reports, and dedicated support. The landing page brief also highlights bulk-friendly workflows such as real-time alerts, guided corrections, and resubmission support.",
    },
    {
        q: "How does ClearTax's e-invoicing software meet compliance requirements?",
        a: "ClearTax is a Peppol-ready, FTA- and MoF-compliant Accredited Service Provider solution for the UAE, designed to support compliant invoice exchange and reporting. It aligns with the UAE's structured e-invoicing model by enabling integration with source systems, transmitting invoice data through the ASP layer, and supporting the mandated data exchange flow.",
    },
    {
        q: "Can businesses that are not registered for VAT be considered part of B2B e-invoicing transactions?",
        a: "Yes. E-invoicing applies to businesses in scope regardless of VAT registration status, unless specifically excluded.",
    },
    {
        q: "Can ClearTax integrate with custom ERP systems?",
        a: "Yes. ClearTax integrates smoothly with custom ERP and POS systems, making it easier to capture, map, and transmit all required invoice data accurately. It also supports multi-entity, multi-channel, and multi-location businesses through a consolidated integration approach, helping large or complex organisations manage e-invoicing in a more connected and scalable way.",
    },
    {
        q: "Can ClearTax handle bulk invoice processing?",
        a: "Yes. It supports high-volume invoicing with automated error handling, bulk resubmission, and reporting dashboards.",
    },
    {
        q: "Which e-invoice formats are accepted as compliant under UAE e-invoicing regulations?",
        a: "Compliant e-invoices must be exchanged in XML format under the Peppol PINT-AE specifications and UAE data dictionary.",
    },
    {
        q: "Do businesses need to register with any government system to send e-invoices in the UAE?",
        a: "Yes. Businesses must onboard through EmaraTax and obtain a TIN if they do not already have one.",
    },
];
---

<FaqRb items={items} subtitle="" />
