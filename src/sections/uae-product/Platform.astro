---
interface Props {
    title?: string;
    description?: string;
    descriptionClass?: string;
    items?: {
        title: string;
        desc?: string;
    }[];
}

const defaultItems = [
    {
        title: "Connect your ERP in days, not months.",
        desc: "ClearTax ships certified connectors for SAP ECC, S/4HANA, and more, along with custom connectors for JDE, Tally, and Zoho. Our AI-powered integration agent handles the mapping automatically. Once integrated, regulatory changes never require a new build. We update on our side.",
    },
    {
        title: "400+ validation rules so your invoices don't fail at the FTA.",
        desc: "ClearTax runs deep pre-submission validation across every PINT AE field, catches errors before they reach Corner 5, and auto-heals retriable failures. Your finance team gets clear error codes and bulk-correction tools, not just a rejection notice.",
    },
    {
        title: "Know what the FTA sees before you file your VAT return.",
        desc: "ClearTax tracks every document from submission through buyer delivery to FTA reporting across all five corners. Our advanced Recon AI runs daily in the background, comparing your ERP's GL data against e-invoice data and emails your team only when there's a gap to act on.",
    },
    {
        title: "10,000 invoices per second. 99.9% uptime. No excuses.",
        desc: "ClearTax processes invoices in 200–300ms, auto-scales infrastructure horizontally under peak load, and operates on a multi-cloud architecture hosted within the UAE (OCI Abu Dhabi primary, AWS Dubai DR). If government APIs go down, your invoices queue and retry; they don't fail.",
    },
    {
        title: "Your financial data never leaves the UAE.",
        desc: "ClearTax is SOC 2 Type II certified, ISO 27001:2022 and ISO 22301:2019 compliant, and secured with AES-256 encryption at rest and SSL in transit. All data is processed and stored exclusively within the UAE, aligned with UAE PDPL data privacy principles. Role-based access controls and authentication tokens protect every API call.",
    },
];

const {
    title = "One platform. Every corner of the 5-corner model covered.",
    descriptionClass = "ClearTax acts as both your seller's and buyer's Peppol Access Point, handling data validation, UUID enrichment, transmission to the FTA (Corner 5), buyer delivery confirmation, archival, VAT reconciliation prep, and real-time error resolution.",
    items = defaultItems,
} = Astro.props;
---

<div class="sticky-scroll-container bg-generic-00">
    <section class="sticky top-0 flex flex-col justify-center bg-generic-00 py-12 md:py-16 xl:py-20 overflow-hidden min-h-[calc(100vh-80px)]">
        <div class="mx-auto max-w-[var(--container-max)] w-full px-4 lg:px-6">
            <div class="header-wrapper text-center mx-auto mb-8 md:mb-12">
                <h2 class="section-title text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-text-default max-w-150 mx-auto mb-4 m-0">
                    {title}
                </h2>
                <p class="text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] font-normal text-neutral-500 max-w-262 mx-auto m-0">
                    {descriptionClass}
                </p>
            </div>

            <div class="w-full h-auto">
                <div class="compliance-scroll-track flex items-stretch gap-6 w-max transition-transform duration-[250ms] ease-out will-change-transform">
                    {items.map((item) => {
                        return (
                            <div class="card-item bg-generic-00 rounded-xl w-[calc(100vw-58px)] md:w-[calc(50vw-28px)] lg:w-[43vw] border border-neutral-300 flex flex-col select-none overflow-hidden">
                                <div class="card-header border-b border-neutral-300 px-5 py-4 sm:px-6 sm:py-5">
                                    <h3 class="card-title font-heading text-[length:var(--fs-h6)] sm:text-[20px] md:text-[18px] lg:text-[20px] leading-[length:var(--lh-h6)] sm:leading-[28px] md:leading-[26px] lg:leading-[28px] font-medium text-text-default pointer-events-none m-0">
                                        {item.title}
                                    </h3>
                                </div>

                                <div class="card-body p-5 sm:p-6 flex flex-col flex-1">
                                    <div class="aspect-[510/286] w-full rounded-lg sm:rounded-xl bg-visual-placeholder" />

                                    <p class="card-desc font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-lg)] sm:leading-[length:var(--lh-body-lg)] mt-5 sm:mt-6 pointer-events-none m-0">
                                        {item.desc}
                                    </p>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>
    </section>
</div>

<style is:global>
    @media (min-width: 768px) and (max-width: 1023px) {
        .sticky-scroll-container .card-item {
            max-width: none !important;
            width: calc(50vw - 28px) !important;
        }
    }

    @media (max-height: 750px) {
        .sticky-scroll-container section {
            padding-top: 1.25rem !important;
            padding-bottom: 1.25rem !important;
        }
        .sticky-scroll-container .header-wrapper {
            margin-bottom: 1rem !important;
        }
        .sticky-scroll-container .card-item {
            padding: 0 !important;
            max-width: calc(100vw - 58px) !important;
            width: calc(100vw - 32px) !important;
        }
        @media (min-width: 768px) and (max-width: 1023px) {
            .sticky-scroll-container .card-item {
                max-width: none !important;
                width: calc(50vw - 28px) !important;
            }
        }
        @media (min-width: 1024px) {
            .sticky-scroll-container .card-item {
                max-width: 547px !important;
                width: 34vw !important;
            }
        }
        .sticky-scroll-container .card-header {
            padding: 0.875rem 1.25rem !important;
        }
        .sticky-scroll-container .card-body {
            padding: 1.25rem !important;
        }
        .sticky-scroll-container .card-title {
            margin-bottom: 0 !important;
        }
        .sticky-scroll-container .card-img,
        .sticky-scroll-container .card-body .bg-visual-placeholder {
            min-height: 210px !important;
            height: 25vh !important;
            max-height: 280px !important;
        }
        .sticky-scroll-container .card-desc {
            margin-top: 0.75rem !important;
            font-size: 0.875rem !important;
            line-height: 1.35 !important;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const containers = document.querySelectorAll(
            ".sticky-scroll-container",
        );
        if (!containers.length) return;

        containers.forEach((container) => {
            const track = container.querySelector(".compliance-scroll-track");
            const section = container.querySelector("section");
            if (!container || !track || !section) return;

            const getHeaderHeight = () => {
                const header = document.querySelector(
                    "header, .navbar, .w-nav",
                );
                return header ? header.offsetHeight : 80;
            };

            let maxTranslate = 0;
            let totalScrollable = 0;
            let stickyTop = 0;

            const updateMeasurements = () => {
                const sectionHeight = section.offsetHeight;
                const windowHeight = window.innerHeight;
                const headerHeight = getHeaderHeight();

                const trackOffset =
                    track.parentElement.getBoundingClientRect().top -
                    section.getBoundingClientRect().top;
                const trackHeight = track.offsetHeight;
                const availableSpace = windowHeight - headerHeight;

                const idealTrackTop =
                    headerHeight +
                    Math.max(40, (availableSpace - trackHeight) / 2);
                let calculatedTop = idealTrackTop - trackOffset;

                // Position section flush under header when sticky, avoiding gap on large screens
                stickyTop = Math.min(headerHeight, calculatedTop);
                section.style.top = `${stickyTop}px`;

                const containerWidth =
                    track.parentElement.getBoundingClientRect().width;
                maxTranslate = Math.max(0, track.scrollWidth - containerWidth);
                container.style.height = `${maxTranslate + windowHeight}px`;
                totalScrollable =
                    container.getBoundingClientRect().height - sectionHeight;
            };

            updateMeasurements();

            if (window.ResizeObserver) {
                const ro = new ResizeObserver(updateMeasurements);
                ro.observe(section);
                ro.observe(track);
            }
            window.addEventListener("resize", updateMeasurements);

            let ticking = false;

            const handleScroll = () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const containerRect = container.getBoundingClientRect();
                        const scrolledDistance = Math.max(
                            0,
                            stickyTop - containerRect.top,
                        );

                        let progress =
                            totalScrollable > 0
                                ? scrolledDistance / totalScrollable
                                : 0;
                        progress = Math.max(0, Math.min(1, progress));

                        track.style.transform = `translate3d(-${progress * maxTranslate}px, 0, 0)`;

                        ticking = false;
                    });
                    ticking = true;
                }
            };

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            window.addEventListener("scroll", handleScroll, {
                                passive: true,
                            });
                            handleScroll();
                        } else {
                            window.removeEventListener("scroll", handleScroll);
                        }
                    });
                },
                {
                    rootMargin: "100% 0px 100% 0px",
                },
            );

            observer.observe(container);
        });
    });
</script>
