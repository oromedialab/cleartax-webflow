---
/**
 * Deadline section for UAE Product page.
 * Highlights the ASP appointment deadline vs mandatory go-live,
 * and details the FTA penalty regime in an alert table.
 */
interface PenaltyItem {
    description: string;
    amount: string;
    note: string;
}

const penalties: PenaltyItem[] = [
    {
        description: "Failure to appoint a provider or implement the system",
        amount: "AED 5,000",
        note: "for each month or part thereof",
    },
    {
        description: "Failure to issue and transmit an electronic invoice",
        amount: "AED 100",
        note: "per invoice, capped at AED 5,000 per calendar month",
    },
];
---

<section id="deadline" class="bg-generic-00 py-16 lg:py-20">
    <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
        <!-- Section Header -->
        <div class="text-center mb-12">
            <h2 class="text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium mx-auto text-vault-navy max-w-171 font-heading mb-4">
                Appointing an ASP is the first deadline. January 2027 is the
                real test.
            </h2>
            <p class="text-neutral-500 font-normal text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] font-body max-w-235 mx-auto">
                Companies with revenue above AED 50M must appoint an ASP by 30
                October 2026 and implement e-invoicing from 1 January 2027.
                Before January, your systems, invoice data, and teams need to be
                ready.
            </p>
        </div>

        <!-- Penalty Card Table -->
        <div class="max-w-[1010px] mx-auto rounded-xl border border-[#FF8000CC] bg-generic-00 overflow-hidden shadow-xs">
            <!-- Header bar -->
            <div class="bg-[#FF880014] px-6 py-3.5 border-b border-[#FF8000CC]">
                <span class="text-vault-navy font-normal text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-body">
                    After mandatory implementation
                </span>
            </div>

            <!-- Rows -->
            <div class="divide-y divide-[#FF8000CC]">
                {penalties.map((item) => (
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-6 items-center p-4">
                        <div class="sm:col-span-7">
                            <p class="text-vault-navy font-normal text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-body m-0">
                                {item.description}
                            </p>
                        </div>
                        <div class="sm:col-span-5 flex flex-col">
                            <span class="text-[#E50000] font-medium text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-body m-0">
                                {item.amount}
                            </span>
                            <span class="text-neutral-500 font-normal text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-body mt-0.5">
                                {item.note}
                            </span>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
