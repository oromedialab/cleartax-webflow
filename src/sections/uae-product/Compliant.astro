---
/**
 * UAE Product: "How ClearTax gets you compliant in the UAE"
 * 6 rows with title and icon on the left, and lead heading + full explanation on the right.
 */
interface Row {
    title: string;
    img?: string;
    heading: string;
    body: string;
}

const rows: Row[] = [
    {
        title: "End-to-end UAE mandate coverage",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccd7758a3c30559f9cda_ir-icon-14.png",
        heading: "PINT, Peppol & FTA Compliance",
        body: "B2B and B2G e-invoicing in PINT AE format, exchanged over the Peppol network and reported to the FTA in near real time. Includes e-credit notes, self-billing and archiving to UAE retention rules.",
    },
    {
        title: "24×7 support from a UAE-based team",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b095a0db380b1b1595f4c91_ae-icon-2.png",
        heading: "UAE Tax Expertise",
        body: "A named success manager, round-the-clock technical support and in-house tax specialists in the region who track FTA and Ministry of Finance updates and turn them into product changes.",
    },
    {
        title: "One global platform, one API",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccd37cb6fc00f8748311_ir-icon-13.png",
        heading: "Automatic Regulatory Updates",
        body: "The same integration covers 50+ country mandates, so UAE entities in a multi-country group reuse what's already built. Rule changes ship as cloud updates — no ERP rework.",
    },
    {
        title: "Proven integrations and accelerators",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccbe97f9feffa7f17b6a_ir-icon-8.png",
        heading: "Ready-Made ERP Connectors",
        body: "Pre-built connectors for SAP, Oracle, Microsoft Dynamics and 500+ other ERP and POS systems. Start with Excel ingestion and go live in as little as 24 hours while the deeper integration is built.",
    },
    {
        title: "Bank-grade security and uptime",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b095a1b171ae64b3a375c19_ae-icon-5.png",
        heading: "Certified Security & Data Residency",
        body: "ISO 27001 and SOC 2 certified, VAPT tested, 256-bit encryption and role-based access. UAE data stays within country borders, on a platform with a 99.8% generation success rate.",
    },
    {
        title: "VAT-ready, audit-ready, future-proof",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6abb821559914c7b687369a7_ai-icon2.png",
        heading: "Invoice Monitoring & Automation",
        body: "MIS dashboards, error alerts with correction guidance and bulk resubmission, plus reconciliation across forex and time of supply. AP automation digitises inbound invoices for three-way matching.",
    },
];
---

<section id="uae-compliant" class="bg-generic-00 py-16 lg:py-20">
    <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12">
        <div class="flex flex-col items-center gap-4 text-center">
            <h2 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] tracking-[-0.5px]">
                How ClearTax gets you compliant in the UAE
            </h2>
            <p class="m-0 max-w-[600px] font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]">
                One platform for issuing, receiving, validating, reporting and
                archiving e-invoices — without rebuilding your ERP.
            </p>
        </div>

        <div class="flex w-full flex-col divide-y divide-neutral-200">
            {rows.map((r) => (
                <div class="uae-compliant-row grid grid-cols-1 gap-4 py-8 lg:grid-cols-12 lg:gap-12 items-start">
                    {/* Left Column: Icon + Title */}
                    <div class="lg:col-span-6 flex items-center gap-4">
                        {r.img && (
                            <img
                                src={r.img}
                                alt=""
                                loading="lazy"
                                height="56"
                                width="56"
                                class="size-12 sm:size-14 shrink-0 object-contain"
                            />
                        )}
                        <h3 class="m-0 font-heading font-medium text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] text-vault-navy">
                            {r.title}
                        </h3>
                    </div>

                    {/* Right Column: Heading + Body */}
                    <div class="lg:col-span-6 flex flex-col gap-2">
                        <h4 class="m-0 font-heading font-medium text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-vault-navy">
                            {r.heading}
                        </h4>
                        <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                            {r.body}
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
