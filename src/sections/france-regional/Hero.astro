---
/**
 * France regional hero — Figma node 13600:27940.
 *
 * Background is the interactive stroke field from
 * `sections/global-homepage/Hero.astro` (originally
 * `sections/blog-listing/Newsletter.astro`, which carries the full explanation of
 * the geometry): a plain grid of lime dots until a pointer enters, at which point
 * each dot draws out into a stroke aimed at the cursor, longest beside it and back
 * to a dot by `lengthRadius`. Same four gradient layers over it — page gradient,
 * radial wash behind the copy, a mobile-only top fade, and a bottom fade.
 *
 * Ids and the canvas id are `fr-` prefixed rather than the `hero` /
 * `hero-dots-canvas` older files use, because embeds share one namespace per page
 * and a bare `hero` is exactly the kind of name that collides later.
 *
 * The three badges carry a 37px `bg-visual-placeholder` square where the Figma
 * has an unfilled "Icon placeholder" frame. Swap each for a Webflow-hosted asset
 * once the icons exist — never a `data:` URI, which would blow the paste cap.
 */
interface Props {
  /** Stroke width, and so the diameter of the dot it becomes at rest. */
  lineWidth?: number;
  gap?: number;
  /** Must stay under the grid pitch or the field knits into a mesh. */
  maxLength?: number;
  lengthRadius?: number;
  /** Leave at 1 — a partial turn makes strokes flip as the cursor crosses them. */
  tilt?: number;
  baseColor?: string;
  cursorRadius?: number;
  pull?: number;
  fadeRadius?: number;
}

const {
  lineWidth = 3,
  gap = 24,
  maxLength = 6,
  lengthRadius = 260,
  tilt = 1,
  baseColor = "#C8F006",
  cursorRadius = 320,
  pull = 14,
  fadeRadius = 40,
} = Astro.props;

const badges = [
  "AI-powered seamless integration with any ERP/POS systems",
  "DGFiP Certified Plateforme Agréée (PA) in France",
  "Single unified Global E-invoicing API, to support 40+ country mandates",
];
---

<section
  id="fr-hero"
  class="fr-hero relative overflow-hidden bg-generic-00"
  data-line-width={String(lineWidth)}
  data-gap={String(gap)}
  data-max-length={String(maxLength)}
  data-length-radius={String(lengthRadius)}
  data-tilt={String(tilt)}
  data-base-color={baseColor}
  data-cursor-radius={String(cursorRadius)}
  data-pull={String(pull)}
  data-fade-radius={String(fadeRadius)}
>
  <!-- Interactive stroke field -->
  <div class="absolute inset-0 z-0 w-full h-full pointer-events-none">
    <canvas id="fr-hero-dots" class="absolute inset-0 w-full h-full"></canvas>
  </div>

  <!-- Radial wash, so the headline keeps its contrast over the field -->
  <div
    class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"
  >
  </div>

  <div class="container mx-auto relative z-10">
    <div
      class="flex flex-col items-center gap-6 text-center max-lg:pt-32 max-lg:pb-16 lg:pt-[257px] lg:pb-[177px]"
    >
      <div class="flex flex-col items-center gap-8 w-full">
        <h1
          class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h1)] md:text-[length:var(--fs-display-sm)] lg:text-[length:var(--fs-display-lg)] leading-[length:var(--lh-h1)] md:leading-[length:var(--lh-display-sm)] lg:leading-[length:var(--lh-display-lg)] tracking-[-1px] max-w-[1280px]"
        >
          Get Ready for 2026 <br class="max-md:hidden" /><span
            class="fr-hero-mark">France E-invoicing</span
          > with ClearTax
        </h1>

        <!-- 3 up on desktop, stacking below. Each badge is a fixed 320px in the
             Figma; `basis` keeps that as the preferred width while still letting
             them shrink rather than overflow the container. -->
        <ul
          class="flex flex-wrap items-stretch justify-center gap-2 list-none m-0 p-0 w-full"
        >
          {
            badges.map((label) => (
              <li class="flex basis-[320px] grow-0 shrink items-center gap-3 rounded-xl border border-neutral-300 bg-generic-00 p-4 text-left">
                <span
                  class="block h-[37px] max-w-[37px] w-full shrink-0 rounded-lg bg-visual-placeholder"
                  aria-hidden="true"
                />
                <span class="font-body text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] text-vault-navy">
                  {label}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Opens the HubSpot modal from `DemoModal.astro`. The href is kept real
           so the CTA still goes somewhere if that section is absent. -->
      <a
        href="https://www.cleartax.com/contact-us"
        data-demo-open
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-50 no-underline transition-all duration-200 hover:bg-nova-50 hover:text-nova-blue"
      >
        Book a demo
      </a>
    </div>
  </div>
</section>

<style is:global>
  /* The single Flux Lime instance on this screen. clone keeps the block intact
     if the headline wraps inside "France E-invoicing" on narrow viewports. */
  .fr-hero-mark {
    background-color: var(--color-flux-lime);
    padding: 0 0.08em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    border-radius: 12px;
  }
</style>

<script is:inline>
  /* Interactive stroke field — the one from `sections/global-invoicing/Hero.astro`,
     which took it from `sections/blog-listing/Newsletter.astro`. That file carries
     the full explanation of the geometry; the numbers here come off the section's
     data-* attributes so there is a single source for each. */
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('fr-hero');
    if (!section) return;
    const canvas = document.getElementById('fr-hero-dots');
    if (!canvas || !canvas.getContext) return;
    const ctx = canvas.getContext('2d');

    function num(name, fallback) {
      const value = parseFloat(section.getAttribute(name));
      return isNaN(value) ? fallback : value;
    }

    const config = {
      lineWidth: num('data-line-width', 2),
      gap: num('data-gap', 24),
      maxLength: num('data-max-length', 6),
      lengthRadius: num('data-length-radius', 260),
      tilt: num('data-tilt', 1),
      baseColor: section.getAttribute('data-base-color') || '#C8F006',
      cursorRadius: num('data-cursor-radius', 320),
      pull: num('data-pull', 14),
      fadeRadius: num('data-fade-radius', 40),
      fadeSpeed: 12,
      followSpeed: 7,
      engageSpeed: 4,
      focusSpeed: 5,
    };

    const HALF_PI = Math.PI / 2; // straight down — the resting angle

    let width = 0;
    let height = 0;
    let dots = [];
    const mouse = { x: -9999, y: -9999, prevX: -9999, prevY: -9999 };
    let hover = false;
    let speed = 0; // smoothed cursor travel, px per frame
    let engagement = 0; // 0–1, how awake the field is
    let presence = 0; // 0–1, whether a pointer is over the section at all
    let focusX = 0;
    let focusY = 0;

    function initGrid() {
      const parent = canvas.parentElement;
      width = parent.offsetWidth;
      height = parent.offsetHeight;
      if (!width || !height) return;

      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      // setTransform, not scale: scale() multiplies the existing matrix, so
      // every resize would compound the DPR and shrink the grid.
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      dots = [];
      const spacing = config.lineWidth + config.gap;
      const cols = Math.floor(width / spacing);
      const rows = Math.floor(height / spacing);
      const startX = (width - cols * spacing) / 2 + config.lineWidth / 2;
      const startY = (height - rows * spacing) / 2 + config.lineWidth / 2;

      for (let y = 0; y <= rows; y++) {
        for (let x = 0; x <= cols; x++) {
          const cx = startX + x * spacing;
          const cy = startY + y * spacing;
          // ox/oy is the stroke's home and the point it is drawn centred on;
          // x/y is where that centre is now; hx/hy is half its segment vector.
          dots.push({ x: cx, y: cy, ox: cx, oy: cy, alpha: 1, hx: 0, hy: 0 });
        }
      }

      if (!hover) {
        focusX = width / 2;
        focusY = height / 2;
      }
      aim();
    }

    // Length and angle, both straight off the focus. The focus and `presence`
    // are already eased, so neither needs easing here.
    function aim() {
      const longest = config.maxLength / 2;
      const turn = presence * config.tilt;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        const dx = focusX - dot.ox;
        const dy = focusY - dot.oy;
        const dist = Math.sqrt(dx * dx + dy * dy);

        // 1 at the pointer, 0 by `lengthRadius`. Scaled by `presence`, so with
        // no cursor on the section every stroke is a plain dot.
        let t = dist / config.lengthRadius;
        if (t > 1) t = 1;
        const grow = 1 - t;
        let reach = longest * grow * grow * (3 - 2 * grow) * presence;
        // A canvas subpath of exactly zero length is not reliably painted, even
        // with a round cap. A quarter pixel is a dot and is always drawn.
        if (reach < 0.25) reach = 0.25;

        let ux = 0;
        let uy = 1;

        if (turn > 0.001 && dist > 0.01) {
          // Folded into a quarter turn either side: a segment drawn about its
          // centre looks the same pointed either way, so this takes the short
          // way round. Only seamless because `turn` reaches 1 — scaling the
          // angle by any fraction makes strokes flip as the cursor crosses them.
          let off = Math.atan2(dy, dx) - HALF_PI;
          while (off > HALF_PI) off -= Math.PI;
          while (off < -HALF_PI) off += Math.PI;

          const angle = HALF_PI + off * turn;
          ux = Math.cos(angle);
          uy = Math.sin(angle);
        }

        dot.hx = ux * reach;
        dot.hy = uy * reach;
      }
    }

    function paint() {
      ctx.clearRect(0, 0, width, height);
      ctx.strokeStyle = config.baseColor;
      ctx.lineWidth = config.lineWidth;
      ctx.lineCap = 'round'; // so a stroke shrunk to nothing reads as a dot

      // Two passes. Only the strokes the cursor is touching have an alpha of
      // their own; the rest of the field goes down as one path in one stroke
      // call. Setting globalAlpha per stroke across the whole grid stutters.
      ctx.globalAlpha = 1;
      ctx.beginPath();
      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        if (dot.alpha < 0.995) continue;
        ctx.moveTo(dot.x - dot.hx, dot.y - dot.hy);
        ctx.lineTo(dot.x + dot.hx, dot.y + dot.hy);
      }
      ctx.stroke();

      for (let j = 0; j < dots.length; j++) {
        const fading = dots[j];
        if (fading.alpha >= 0.995 || fading.alpha < 0.01) continue;
        ctx.globalAlpha = fading.alpha;
        ctx.beginPath();
        ctx.moveTo(fading.x - fading.hx, fading.y - fading.hy);
        ctx.lineTo(fading.x + fading.hx, fading.y + fading.hy);
        ctx.stroke();
      }

      ctx.globalAlpha = 1;
    }

    const reduceMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      // Static dot grid. No animation loop, no cursor reaction.
      initGrid();
      paint();
      window.addEventListener('resize', () => {
        initGrid();
        paint();
      });
      return;
    }

    let lastTime = performance.now();

    function draw(time) {
      let dt = (time - lastTime) / 1000;
      if (dt > 0.05) dt = 0.05; // cap so a backgrounded tab can't jolt the grid
      lastTime = time;

      const fadeEase = Math.min(1, config.fadeSpeed * dt);
      const followEase = Math.min(1, config.followSpeed * dt);
      const engageEase = Math.min(1, config.engageSpeed * dt);
      const focusEase = Math.min(1, config.focusSpeed * dt);

      const travelX = mouse.x - mouse.prevX;
      const travelY = mouse.y - mouse.prevY;
      mouse.prevX = mouse.x;
      mouse.prevY = mouse.y;
      speed += (Math.sqrt(travelX * travelX + travelY * travelY) - speed) * 0.5;
      if (speed < 0.01) speed = 0;

      engagement += ((hover ? Math.min(speed / 6, 1) : 0) - engagement) * engageEase;
      if (engagement < 0.001) engagement = 0;

      // A parked cursor still holds the field open, just more gently.
      const grip = hover ? 0.4 + 0.6 * engagement : 0;

      const wantX = hover ? mouse.x : width / 2;
      const wantY = hover ? mouse.y : height / 2;
      const swungX = wantX - focusX;
      const swungY = wantY - focusY;
      let swung = swungX > 0.05 || swungX < -0.05 || swungY > 0.05 || swungY < -0.05;
      if (swung) {
        focusX += swungX * focusEase;
        focusY += swungY * focusEase;
      } else if (focusX !== wantX || focusY !== wantY) {
        focusX = wantX;
        focusY = wantY;
        swung = true;
      }

      const wantPresence = hover ? 1 : 0;
      const presenceDiff = wantPresence - presence;
      if (presenceDiff > 0.002 || presenceDiff < -0.002) {
        presence += presenceDiff * focusEase;
        swung = true;
      } else if (presence !== wantPresence) {
        presence = wantPresence;
        swung = true;
      }

      // Length and angle hang off those two, so they only need recomputing on
      // the frames one of them actually moved.
      if (swung) aim();

      const crSq = config.cursorRadius * config.cursorRadius;
      let moving = swung;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];

        // Measured from the stroke's home, not its current position, or one
        // that has moved toward the focus reads as closer and runs away into it.
        const dx = focusX - dot.ox;
        const dy = focusY - dot.oy;
        const distSq = dx * dx + dy * dy;

        let targetAlpha = 1;
        let targetX = dot.ox;
        let targetY = dot.oy;

        if (distSq < crSq) {
          const dist = Math.sqrt(distSq);

          if (grip > 0.001) {
            const t = 1 - dist / config.cursorRadius;
            let push = t * t * config.pull * grip;
            // A stroke must never reach the cursor: past it, it crosses to the
            // far side and the field knots up around the pointer.
            if (push > dist * 0.75) push = dist * 0.75;
            const step = dist > 0.01 ? push / dist : 0;
            targetX += dx * step;
            targetY += dy * step;
          }

          if (dist < config.fadeRadius) {
            const ft = dist / config.fadeRadius;
            const hole = ft * ft * (3 - 2 * ft);
            // Also the pointer's doing, so the resting grid keeps every dot.
            targetAlpha = 1 - (1 - hole) * presence;
          }
        }

        const offX = targetX - dot.x;
        const offY = targetY - dot.y;
        if (offX > 0.05 || offX < -0.05 || offY > 0.05 || offY < -0.05) {
          dot.x += offX * followEase;
          dot.y += offY * followEase;
          moving = true;
        } else if (dot.x !== targetX || dot.y !== targetY) {
          dot.x = targetX;
          dot.y = targetY;
          moving = true;
        }

        const diff = targetAlpha - dot.alpha;
        if (diff > 0.002 || diff < -0.002) {
          dot.alpha += diff * fadeEase;
          moving = true;
        } else if (dot.alpha !== targetAlpha) {
          dot.alpha = targetAlpha;
          moving = true;
        }
      }

      // A settled field is repainted zero times a second, not sixty.
      if (moving) paint();
      requestAnimationFrame(draw);
    }

    window.addEventListener('resize', initGrid);
    initGrid();
    requestAnimationFrame(draw);

    section.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      // TWO SPACES, and `zoom` makes them different sizes.
      // rect and clientX are RENDERED px. The grid lives in the canvas's own
      // logical space, laid out by initGrid from parent.offsetWidth. shared.css
      // zooms the body element between tablet and 1440px, so a pointer position
      // carried straight across lands short by that factor — no error at the left
      // edge, growing all the way across, which reads as the field ignoring the
      // cursor on the right-hand side.
      //
      // The scale is derived from the two boxes rather than from the zoom value:
      // that needs no knowledge of `zoom` and covers a CSS transform or any other
      // sizing mismatch for free. Guarded because a hidden canvas measures 0.
      const sx = rect.width ? width / rect.width : 1;
      const sy = rect.height ? height / rect.height : 1;
      const nx = (e.clientX - rect.left) * sx;
      const ny = (e.clientY - rect.top) * sy;
      if (!hover) {
        // Re-entering: seed prev with the entry point, or the jump from the last
        // position would register as a colossal cursor speed.
        mouse.prevX = nx;
        mouse.prevY = ny;
      }
      hover = true;
      mouse.x = nx;
      mouse.y = ny;
    });

    section.addEventListener('mouseleave', () => {
      // Dropping `hover` is what matters: the focus starts its swing back to the
      // centre, the strokes reel in and the pull lets go. Nothing reads the
      // parked coordinates while `hover` is false, and re-entry reseeds them.
      hover = false;
      speed = 0;
    });
  });
</script>
