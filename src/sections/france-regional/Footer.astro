---
/**
 * Footer for the France regional page — the paste unit.
 *
 * Structure, styling and behaviour live in `_shared/FooterRb.astro`;
 * this file owns the content. Props must be supplied here, inside a section
 * file, because the embed route renders sections with no props.
 *
 * Links are taken from the footer of https://www.cleartax.com/fr/en.
 */
import FooterRb from "../_shared/FooterRb.astro";
import type { BadgeItem, LinkColumn, LinkItem } from "../_shared/FooterRb.astro";

const companyLinks: LinkItem[] = [
  { label: "About us", href: "https://www.cleartax.com/about-us" },
  { label: "Contact us", href: "https://www.cleartax.com/contact-us" },
  { label: "Partners", href: "https://www.cleartax.com/global/partner-program" },
  { label: "Media & Press", href: "https://www.cleartax.com/press" },
  { label: "Trust & Safety", href: "https://www.cleartax.com/trust-centre" },
];

const socialLinks: LinkItem[] = [
  { label: "LinkedIn", href: "https://www.linkedin.com/company/cleartax" },
  { label: "X", href: "https://x.com/cleartax_" },
  { label: "Facebook", href: "https://www.facebook.com/people/ClearTax-for-Business/61594718619825/" },
  { label: "Github", href: "https://github.com/ClearTax" },
];

const columns: LinkColumn[] = [
  {
    title: "Products & Solutions",
    items: [
      { label: "E-invoicing Software(France)", href: "https://www.cleartax.com/fr" },
      { label: "E-invoicing Software(Belgium)", href: "https://www.cleartax.com/be/en" },
      { label: "E-invoicing Software(Germany)", href: "https://www.cleartax.com/de/en" },
      { label: "E-invoicing Software(Saudi Arabia)", href: "https://www.cleartax.com/sa" },
      { label: "E-invoicing Software(UAE)", href: "https://www.cleartax.com/ae" },
      { label: "E-invoicing Software(Malaysia)", href: "https://www.cleartax.com/my/en" },
    ],
  },
  {
    title: "Resources",
    items: [
      { label: "Webinars", href: "https://7giy8.app.link/e/o0RuZugLMZb" },
      { label: "Blog", href: "https://www.cleartax.com/fr/facturation-electronique-france" },
      { label: "VAT Calculator", href: "https://www.cleartax.com/fr/vat-calculator" },
    ],
  },
  {
    title: "Resources(French)",
    items: [
      { label: "Facturation électronique en France", href: "https://www.cleartax.com/fr/facturation-electronique-france" },
      { label: "Chorus Pro pour la facturation électronique en France", href: "https://www.cleartax.com/fr/chorus-pro-france-e-facturation" },
      { label: "PDP, OD et PPF dans la facturation électronique en France", href: "https://www.cleartax.com/fr/pdp-od-ppf-france-facturation-electronique" },
      { label: "e-Reporting sous France e-Invoicing", href: "https://www.cleartax.com/fr/e-facturation-et-e-reporting" },
    ],
  },
];

const complianceBadges: BadgeItem[] = [
  {
    alt: "ISO Certified",
    src: "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69fb0ff41b9a63ce3e1f50d9_iso.png",
  },
  {
    alt: "SOC Certified",
    src: "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69fad934822abf67d7c25954_soc.png",
  },
  {
    alt: "SSL Secured",
    src: "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/6a154210439a661bb4313f68_ssll.png",
  },
  {
    alt: "GDPR Compliant",
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a153c9e423a6b967412239c_gdpr.png",
  },
];
---

<FooterRb
  address="42 Rue Cambronne, 75015 Paris, France"
  companyLinks={companyLinks}
  columns={columns}
  complianceBadges={complianceBadges}
  socialLinks={socialLinks}
/>
