---
/**
 * "France e-invoicing resource centre" — Figma node 13600:29596.
 *
 * Six cards in a 3-column grid. Each is a category chip, an optional "New" chip,
 * a title and a one-line summary, and the whole card is the link.
 *
 * Content: three whitepapers (HubSpot-hosted PDFs), one case study and two
 * blogs. Links are real; titles and summaries are drafted from the URLs, so
 * confirm the wording with the content team.
 */
interface Resource {
  category: string;
  isNew: boolean;
  title: string;
  desc: string;
  href: string;
}

const HUB = "https://go.cleartax.com/hubfs/France/Content%20Asset/English";

const resources: Resource[] = [
  {
    category: "Whitepaper",
    isNew: true,
    title: "Signed with a PA months ago. Still not live. Sound familiar?",
    desc: "Why Platform Agréée onboarding stalls and how to get live",
    href: `${HUB}/Signed%20with%20a%20PA%20months%20ago.%20Still%20not%20live.%20Doesit%20sounds%20similar/PA%20FRANCE%20ASSET%20Email.pdf`,
  },
  {
    category: "Whitepaper",
    isNew: true,
    title: "Compliant on paper is not the same as proven in production",
    desc: "What to test before the French e-invoicing mandate goes live",
    href: `${HUB}/Compliant%20on%20paper%20is%20not%20the%20same%20as%20proven%20in%20production%20email.pdf`,
  },
  {
    category: "Whitepaper",
    isNew: false,
    title: "Vendor discovery guide for French e-invoicing",
    desc: "A practical framework to shortlist and evaluate providers",
    href: `${HUB}/Vendor%20Discovery/vendor%20discovery%20(UTM%203%20-%20Email).pdf`,
  },
  {
    category: "Case study",
    isNew: true,
    title: "How a global business got ready for French e-invoicing",
    desc: "See how ClearTax delivered compliance at scale",
    href: "https://files.clear.in/08iPqLw4PVz",
  },
  {
    category: "Blog",
    isNew: false,
    title: "E-invoicing in France: key rules, requirements & timelines",
    desc: "Everything you need to know about the French mandate",
    href: "https://www.cleartax.com/fr/en/e-invoicing-france",
  },
  {
    category: "Blog",
    isNew: false,
    title: "E-invoicing and e-reporting in France: FAQs",
    desc: "Answers to the most common mandate questions",
    href: "https://www.cleartax.com/fr/en/e-invoicing-and-e-reporting-faqs-france",
  },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full px-4 md:px-6 mx-auto">
    <h2
      class="m-0 mb-8 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] lg:mb-12"
    >
      France e-invoicing resource centre
    </h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        resources.map((r) => (
          <a
            href={r.href}
            class="flex flex-col gap-4 rounded-xl border border-neutral-300 bg-generic-00 p-6 no-underline transition-all duration-200 ease-in-out hover:border-nova-blue"
          >
            <div class="flex items-start justify-between gap-3">
              <span class="inline-flex items-center justify-center rounded-lg bg-neutral-100 px-3 py-1.5 font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-neutral-700">
                {r.category}
              </span>
              {r.isNew && (
                <span class="inline-flex items-center justify-center rounded-lg bg-nova-blue px-3 py-1.5 font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-generic-00">
                  New
                </span>
              )}
            </div>

            <div class="flex flex-col gap-2.5">
              <h3 class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                {r.title}
              </h3>
              <p class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                {r.desc}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
