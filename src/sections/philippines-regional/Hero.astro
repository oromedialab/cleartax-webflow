                href="javascript:void(0)"
                onclick="document.getElementById('contactForm').scrollIntoView({behavior:'smooth'})"
                class="inline-flex max-md:w-full items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-10 py-3.5 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-50 no-underline transition-all duration-200 hover:bg-nova-50 hover:text-nova-blue"
