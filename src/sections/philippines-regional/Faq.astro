---
/**
 * FAQ for the France regional page — Figma node 13600:29627. The paste unit.
 *
 * Structure, styling and behaviour live in `_shared/FaqRb.astro`;
 * this file owns the content. Props must be supplied here, inside a section
 * file, because the embed route renders sections with no props.
 *
 * Questions are the global e-invoicing set from
 * `global-invoicing/Faq.astro` — that is what the Figma shows, down to the four
 * visible rows and the "Load more" control. Swap in France-specific questions
 * here if the content team supplies them; nothing else on the page changes.
 */
import FaqRb from "../_shared/FaqRb.astro";
import type { FaqItem } from "../_shared/FaqRb.astro";

const items: FaqItem[] = [
    {
        q: "Is my company in scope for the Philippine e-invoicing mandate?",
        a: [
            {
                kind: "p",
                html: " If you're classified as a Large Taxpayer, run an e-commerce business, or use ERP or accounting software, you're in scope under RR 11-2025. This applies regardless of revenue size, and if any branch is in scope, all your locations must comply.",
            },
        ],
    },
    {
        q: "What's the deadline?",
        a: [
            {
                kind: "p",
                html: "Wave 1 is December 31, 2026. Large Taxpayers, e-commerce businesses, and ERP users must issue compliant e-invoices by this date. Wave 2 (exporters, incentive-based businesses) and ESRS live reporting follow under a separate regulation.",
            },
        ],
    },
    {
        q: "What format does BIR require? ",
        a: [
            {
                kind: "p",
                html: "Structured JSON with a JWS digital signature (RS256). PDFs are explicitly excluded under RR 11-2025. Plain email invoices are also invalid.",
            },
        ],
    },
    {
        q: "What happens if we miss the deadline?",
        a: [
            {
                kind: "p",
                html: " Non-compliant invoices are invalidated. You lose the right to claim input tax deductions on those transactions. BIR publishes lists of non-compliant companies publicly. And your Acknowledgement Certificate can be revoked on audit.",
            },
        ],
    },
    {
        q: "Can ClearTax work with our existing ERP?",
        a: [
            {
                kind: "p",
                html: "Yes. ClearTax integrates with SAP (R3, HANA, B1, ECC), Oracle (EBS, Fusion, NetSuite, JD Edwards), Microsoft Dynamics (NAV, AX, 365), Shopify, and 95+ custom ERPs. Our AI-powered connector maps your data automatically. Setup takes days, not months.",
            },
        ],
    },
    {
        q: "Will we need a new integration project every time BIR changes something?",
        a: [
            {
                kind: "p",
                html: "No. Regulatory updates — new fields, amended schemas, format changes — are deployed on the ClearTax platform. Your ERP connector stays unchanged after go-live",
            },
        ],
    },
];
---

<div class="philippines-faq-wrapper">
    <FaqRb items={items} />
</div>

<style is:global>
    .philippines-faq-wrapper #faq .max-w-155 p {
        display: none !important;
    }
</style>
