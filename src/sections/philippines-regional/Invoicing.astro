---
interface FeatureItem {
    iconBg?: string;
    title: string;
    desc: string;
}

const HEADING = "The BIR e-invoicing mandate is here.";
const LEDE =
  "Revenue Regulation 11-2025 is not a form update. It's a fundamental change to how Philippine businesses issue, sign, and report invoices, and the deadline is December 31, 2026.";
const CTA_LABEL = "Talk to a compliance expert";
const CTA_HREF = "https://www.cleartax.com/contact-us";

const features: FeatureItem[] = [
    {
        iconBg: 'bg-visual-placeholder',
        title: 'Transmission model',
        desc: 'Post-audit. Invoices delivered directly to buyers — no BIR clearance required.'
    },
    {
        iconBg: 'bg-visual-placeholder',
        title: 'Applicability',
        desc: 'Large Taxpayers, e-commerce businesses, and any enterprise using ERP or accounting software. In scope regardless of sales volume.'
    },
    {
        iconBg: 'bg-visual-placeholder',
        title: 'Acceptable formats',
        desc: "JSONs only. PDFs and scanned invoices do not qualify. Digital signature required on every invoice."
    },
    {
        iconBg: 'bg-visual-placeholder',
        title: 'Transactions covered',
        desc: 'Sales invoices, official receipts, service billings, credit and debit notes. If any branch is in scope, all locations must comply.'
    },
    {
        iconBg: 'bg-visual-placeholder',
        title: 'Penalties & incentives',
        desc: '50–100% tax deduction on implementation costs for early adopters. Non-compliance: invoices invalidated, input tax deductions lost.'
    }
];
---

<section id="asp" class="bg-generic-00 py-16 md:py-20">
    <div class="mx-auto w-full min-[1400px]:container px-4 md:px-6">
        
        <!-- Section Header -->
        <div
      class="fr-mandate-header-flow flex flex-col gap-6 bg-generic-00 lg:flex-row lg:items-end lg:justify-between lg:gap-12 mb-8 lg:mb-12"
    >
      <div class="flex flex-col gap-3 lg:max-w-[887px]">
        <h2
          class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
        >
          {HEADING}
        </h2>
        <p
          class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]"
        >
          {LEDE}
        </p>
      </div>

      <!-- Opens the HubSpot modal from `DemoModal.astro`. The href is kept real
           so the CTA still goes somewhere if that section is absent. -->
      <a
        href={CTA_HREF}
        data-demo-open
        class="inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-lg border border-nova-500 px-5 py-3.5 font-body text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] font-medium text-nova-blue no-underline transition-all ease-in-out duration-200 hover:bg-generic-00 hover:text-nova-blue lg:self-auto"
      >
        {CTA_LABEL}
        <svg width="14" height="9" viewBox="0 0 14 9" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M9.00628 0.256282C9.34799 -0.0854272 9.90201 -0.0854272 10.2437 0.256282L13.7437 3.75628C14.0854 4.09799 14.0854 4.65201 13.7437 4.99372L10.2437 8.49372C9.90201 8.83543 9.34799 8.83543 9.00628 8.49372C8.66457 8.15201 8.66457 7.59799 9.00628 7.25628L11.0126 5.25H0.875001C0.391751 5.25 -2.11235e-08 4.85825 0 4.375C2.11235e-08 3.89175 0.391751 3.5 0.875001 3.5H11.0126L9.00628 1.49372C8.66457 1.15201 8.66457 0.59799 9.00628 0.256282Z" fill="#5446FF"/>
        </svg>

      </a>
    </div>

        <!-- Features List -->
        <div class="flex flex-col divide-y divide-neutral-200">
            <h3 class="font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] border-none">What you must comply with:</h3>
            {features.map((item) => (
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-center py-7 md:pb-9 md:pt-8 first:pt-0 last:pb-0">
                    
                    <!-- Left Column: Icon & Title -->
                    <div class="md:col-span-6 flex items-center gap-5 sm:gap-6">
                        <div class={`w-10 h-10 rounded-lg shrink-0 ${item.iconBg || 'bg-visual-placeholder'}`} />
                        <h3 class="text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] font-medium text-vault-navy font-heading">
                            {item.title}
                        </h3>
                    </div>

                    <!-- Right Column: Description -->
                    <div class="md:col-span-6">
                        <p class="text-vault-navy/70 font-normal text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-body max-w-xl">
                            {item.desc}
                        </p>
                    </div>

                </div>
            ))}
        </div>

    </div>
</section>
