---

<section id="gst-workflow-tabs-section" class="bg-generic-00 py-16 md:py-20 overflow-hidden">
    <div class="mx-auto w-full min-[1400px]:container px-4 md:px-6">
        <!-- Section Header -->
        <div class="text-center mx-auto mb-8 md:mb-10">
            <h2 class="font-heading font-medium text-[32px] sm:text-[36px] md:text-[40px] leading-[1.2] text-text-default max-w-200 mx-auto m-0">
                Infrastructure that powers every GST workflow
            </h2>
            <p class="font-body font-normal text-neutral-500 text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] max-w-150.75 mx-auto mt-4 m-0">
                From validation and filing to IMS, reconciliation, and notice defense — Clear handles every step with speed, accuracy, and audit-ready control.
            </p>
        </div>

        <!-- Tabs Navigation -->
        <div class="flex justify-center mb-6 md:mb-8">
            <div
                class="inline-flex items-center justify-start sm:justify-center p-1.5 bg-neutral-100 rounded-xl gap-1 max-w-full overflow-x-auto [scrollbar-width:_none] [-ms-overflow-style:_none] [&::-webkit-scrollbar]:hidden"
                role="tablist"
                aria-label="GST Workflows"
            >
                {
                    tabsData.map((tab, index) => (
                        <button
                            type="button"
                            role="tab"
                            id={`tab-btn-${tab.id}`}
                            aria-selected={index === 0 ? "true" : "false"}
                            aria-controls={`panel-${tab.id}`}
                            data-tab-index={index}
                            class:list={[
                                "gst-tab-btn shrink-0 whitespace-nowrap py-2 px-6 text-sm font-medium rounded-lg font-body transition-all duration-200 cursor-pointer outline-none select-none border-0",
                                index === 0
                                    ? "active bg-generic-00 text-[#1200FF] shadow-[0px_1px_2px_0px_#1018280A]"
                                    : "text-[#374151] bg-transparent",
                            ]}
                        >
                            {tab.tabLabel}
                        </button>
                    ))
                }
            </div>
        </div>

        <!-- Tab Panels Swiper Container -->
        <div class="max-w-[1280px] mx-auto">
            <div class="swiper gst-tabs-swiper w-full overflow-hidden">
                <div class="swiper-wrapper items-start">
                    {
                        tabsData.map((tab) => (
                            <div
                                id={`panel-${tab.id}`}
                                role="tabpanel"
                                aria-labelledby={`tab-btn-${tab.id}`}
                                class="swiper-slide w-full shrink-0 box-border"
                            >
                                <div class="bg-generic-00 border border-[#DCDEE2] rounded-xl p-6">
                                    <!-- Card Header -->
                                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-6 md:pb-8">
                                        <div class="max-w-2xl">
                                            <h3 class="font-heading font-medium text-[24px] sm:text-[28px] md:text-[32px] leading-tight text-text-default m-0">
                                                {tab.title}
                                                {tab.subtitle && (
                                                    <>
                                                        <br />
                                                        <span>{tab.subtitle}</span>
                                                    </>
                                                )}
                                            </h3>
                                            <p class="font-body font-normal text-neutral-500 text-sm sm:text-base leading-relaxed mt-4 max-w-3xl m-0">
                                                {tab.desc}
                                            </p>
                                        </div>
                                        <div class="shrink-0 self-start">
                                            <span class="inline-flex items-center bg-nova-50 text-nova-blue px-4 py-3 rounded-lg text-xs sm:text-sm font-medium font-body border border-nova-100/60">
                                                {tab.badge}
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Card Body Grid -->
                                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5.5 items-stretch">
                                        <!-- Left Column: Visual Area -->
                                        <div class="lg:col-span-8 w-full flex items-center justify-center relative">
                                            <img
                                                src={tab.image}
                                                alt={tab.title}
                                                width="768"
                                                height="432"
                                                class="w-full max-w-[768px] aspect-[768/432] object-contain block"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        </div>

                                        <!-- Right Column: Checklist & Feature Tags -->
                                        <div class="lg:col-span-4 border border-neutral-200 rounded-xl flex flex-col justify-between bg-generic-00">
                                            <!-- Checklist items -->
                                            <div class="flex flex-col divide-y p-6 sm:p-7 divide-neutral-100">
                                                {tab.checklist.map((item) => (
                                                     <div class="py-4 lg:py-6 first:pt-0 last:pb-0 text-base font-body text-neutral-600 font-normal">
                                                         {item}
                                                     </div>
                                                ))}
                                            </div>

                                            <!-- 4 Icons + Text Grid -->
                                            <div class="grid grid-cols-2 gap-2 md:gap-4 p-3 lg:p-6 max-sm:mt-4 border-t border-neutral-100">
                                                {tab.features.map((feat) => (
                                                    <div class="flex items-center gap-1 md:gap-2 min-w-0">
                                                        <img
                                                            src={feat.icon}
                                                            alt=""
                                                            width="24"
                                                            height="24"
                                                            class="w-6 h-6 object-contain shrink-0"
                                                            loading="lazy"
                                                            decoding="async"
                                                        />
                                                        <span class="text-xs md:text-sm  font-body text-neutral-600 font-normal lg:whitespace-nowrap">
                                                            {feat.text}
                                                        </span>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                        
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>
<script
    is:inline
    src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
></script>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const section = document.getElementById("gst-workflow-tabs-section");
        if (!section) return;

        const tabBtns = section.querySelectorAll(".gst-tab-btn");
        const swiperEl = section.querySelector(".gst-tabs-swiper");
        if (!swiperEl || !tabBtns.length) return;

        function updateActiveTab(index) {
            tabBtns.forEach((btn, i) => {
                const isActive = i === index;
                btn.setAttribute("aria-selected", isActive ? "true" : "false");
                if (isActive) {
                    btn.classList.add("active", "bg-generic-00", "text-[#1200FF]", "shadow-[0px_1px_2px_0px_#1018280A]");
                    btn.classList.remove("text-[#374151]", "bg-transparent");
                    btn.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
                } else {
                    btn.classList.remove("active", "bg-generic-00", "text-[#1200FF]", "shadow-[0px_1px_2px_0px_#1018280A]");
                    btn.classList.add("text-[#374151]", "bg-transparent");
                }
            });
        }

        function initSwiper() {
            if (typeof Swiper === "undefined") {
                setTimeout(initSwiper, 50);
                return;
            }

            const swiper = new Swiper(swiperEl, {
                slidesPerView: 1,
                spaceBetween: 32,
                speed: 500,
                grabCursor: true,
                autoHeight: false,
                on: {
                    slideChange: function () {
                        updateActiveTab(this.activeIndex);
                    },
                },
            });

            tabBtns.forEach((btn, index) => {
                btn.addEventListener("click", () => {
                    swiper.slideTo(index);
                });
            });
        }

        initSwiper();
    });
</script>
