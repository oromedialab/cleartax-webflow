---
/**
 * Stream-stack section for Indirect Tax page.
 * Features an interactive sticky stack with desktop aside navigation menu and card transitions.
 */

const asideMenu = [
    { label: 'At Scale' },
    { label: 'Multi-GSTIN' },
    { label: 'ITC Maximizer' },
    { label: 'E-Invoicing & EWB' },
    { label: 'Notice & Audit' }
];

const cardsData = [
    {
        tag: 'GST Workbench · GL-Stream',
        urlPath: 'app.clear.in  /  gst  /  gl-stream  /  reconciliation',
        title: 'Processing at scale no queues, no delays',
        description: 'Auto-scaling clusters handle millions of invoices during peak filing dates. Ingest, validate, and reconcile massive datasets in minutes.',
        points: [
            { label: '200-300ms processing', cardIcon: 'bg-visual-placeholder' },
            { label: 'Auto-scaling clusters', cardIcon: 'bg-visual-placeholder' },
            { label: '10,000 invoices/second', cardIcon: 'bg-visual-placeholder' },
            { label: 'Multi-region redundancy', cardIcon: 'bg-visual-placeholder' }
        ]
    },
    {
        tag: 'GST Workbench · Multi-GSTIN',
        urlPath: 'app.clear.in  /  gst  /  entities  /  pan-india',
        title: 'One platform for all your GSTINs',
        description: 'Manage pan-India entities, state-level compliance rules, and branch filers from a single consolidated dashboard.',
        points: [
            { label: 'Unlimited GSTIN hierarchy', cardIcon: 'bg-visual-placeholder' },
            { label: 'Consolidated dashboards', cardIcon: 'bg-visual-placeholder' },
            { label: 'State-wise rule routing', cardIcon: 'bg-visual-placeholder' },
            { label: 'Role-based branch access', cardIcon: 'bg-visual-placeholder' }
        ]
    },
    {
        tag: 'GST Workbench · ITC Maximizer',
        urlPath: 'app.clear.in  /  gst  /  itc  /  2b-reconciliation',
        title: 'Zero ITC leakage with AI 2B matching',
        description: 'Continuous 2B vs Purchase Register reconciliation flags missing invoices, mismatching tax amounts, and non-compliant suppliers.',
        points: [
            { label: '100% ITC claim accuracy', cardIcon: 'bg-visual-placeholder' },
            { label: 'Smart fuzzy matching AI', cardIcon: 'bg-visual-placeholder' },
            { label: 'Automated vendor nudges', cardIcon: 'bg-visual-placeholder' },
            { label: 'Vendor payout locking', cardIcon: 'bg-visual-placeholder' }
        ]
    },
    {
        tag: 'GST Workbench · E-Invoicing & EWB',
        urlPath: 'app.clear.in  /  gst  /  e-invoice  /  irn-generation',
        title: 'Lightning-fast IRN & E-Way Bill generation',
        description: 'Direct API connection to IRP and NIC portals generates IRN and E-Way bills in under 200ms with 99.99% uptime.',
        points: [
            { label: 'Sub-200ms IRN generation', cardIcon: 'bg-visual-placeholder' },
            { label: 'Automated QR code embedding', cardIcon: 'bg-visual-placeholder' },
            { label: 'Real-time multi-IRP failover', cardIcon: 'bg-visual-placeholder' },
            { label: 'Combined E-invoice + EWB', cardIcon: 'bg-visual-placeholder' }
        ]
    },
    {
        tag: 'GST Workbench · Notice & Audit',
        urlPath: 'app.clear.in  /  gst  /  notices  /  audit-trail',
        title: 'Audit-ready compliance & notice tracking',
        description: 'Track ASMT-10 notices, manage DRC-01 workflows, and maintain an immutable historical audit trail for every return filed.',
        points: [
            { label: 'Automated notice scraping', cardIcon: 'bg-visual-placeholder' },
            { label: 'DRC-01 response templates', cardIcon: 'bg-visual-placeholder' },
            { label: 'Complete field-level audit log', cardIcon: 'bg-visual-placeholder' },
            { label: 'Tax authority reconciliations', cardIcon: 'bg-visual-placeholder' }
        ]
    }
];
---

<section class="sc-invoice-stack-section py-12 md:py-16 bg-generic-00">
    <div class="min-[1400px]:container mx-auto w-full px-4 md:px-6">
        <!-- Mobile Header (Scrolls away) -->
        <div class="md:hidden text-center w-full mx-auto mb-8 bg-generic-00">
            <h2 class="font-heading font-medium text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] text-text-default max-w-250 mx-auto m-0 mb-3">
                Infrastructure <span class="text-generic-100 bg-flux-lime px-1 rounded-lg">That Grows</span> With You</h2>
            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-neutral-500 max-w-140 mx-auto">
                From monthly GSTR-1 to millions of e-invoices across every state — our platform handles it without blinking.</p>
        </div>

        <div id="it-invoice-stack-container" class="invoice-stack mx-auto w-full flex flex-col gap-[30vh] md:gap-[50vh]">
            {cardsData.map((card, index) => (
                <div
                    class="invoice-stack-sticky sticky"
                    style={`top: calc(var(--nav-clear, 112px) + ${index * 16}px); z-index: ${index};`}
                >
                    {index === 0 && (
                        <!-- Desktop Header (Sticky) -->
                        <div id="it-invoice-header-text" class="hidden md:block text-center w-full mx-auto mb-6 bg-generic-00">
                            <h2 class="font-heading font-medium text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] text-text-default max-w-250 mx-auto mb-3">
                                Infrastructure <span class="text-generic-100 bg-flux-lime px-1 rounded-lg">That Grows</span> With You</h2>
                            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-neutral-500 max-w-140 font-normal mx-auto">
                                From monthly GSTR-1 to millions of e-invoices across every state — our platform handles it without blinking.</p>
                        </div>
                    )}

                    <div class="flex flex-col md:flex-row gap-6 lg:gap-10 items-start max-w-[1280px] mx-auto w-full">
                        {index === 0 ? (
                            <!-- Aside Menu (Desktop) -->
                            <div class="hidden md:flex flex-col gap-3 w-40 lg:w-48 shrink-0 pt-2">
                                {asideMenu.map((item, btnIdx) => (
                                    <button
                                        type="button"
                                        class={`it-aside-menu-item text-left border-l-2 pl-3.5 py-0.5 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-body transition-colors duration-200 cursor-pointer bg-transparent border-t-0 border-r-0 border-b-0 outline-none ${
                                            btnIdx === 0
                                                ? 'active-aside border-[#655DFF] text-text-default font-medium'
                                                : 'border-transparent text-text-default/28 font-normal'
                                        }`}
                                        data-card-index={btnIdx}
                                    >
                                        {item.label}
                                    </button>
                                ))}
                            </div>
                        ) : (
                            <!-- Spacer alignment for card 1..N -->
                            <div class="hidden md:block w-40 lg:w-48 shrink-0"></div>
                        )}

                        <div
                            class="invoice-stack-card flex-1 flex flex-col md:flex-row w-full border-2 border-neutral-300 rounded-xl min-h-[372px] md:min-h-0 md:h-[clamp(380px,calc(100vh-var(--nav-clear,112px)-160px),480px)] bg-generic-00 will-change-transform"
                            style="transform-origin: top center;"
                        >
                            <div class="flex-1 p-5 sm:p-6 flex flex-col justify-between items-start">
                                <div class="w-full">
                                    {card.tag && (
                                        <h6 class="font-body font-medium text-nova-blue text-[length:var(--fs-body)] leading-[length:var(--lh-body)] mb-4">
                                            {card.tag}
                                        </h6>
                                    )}
                                    <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-2 md:mb-3 text-text-default font-medium">
                                        {card.title}
                                    </h3>
                                    <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500/80 font-normal max-w-xl">
                                        {card.description}
                                    </p>
                                </div>
                                <div class="mt-4 md:mt-auto grid grid-cols-2 gap-3 xl:gap-x-8 xl:gap-y-6 w-full pt-2">
                                    {
                                        card.points.map((point) => (
                                            <div class="flex items-center gap-2.5">
                                                <div class={`w-5 h-5 md:w-6 md:h-6 rounded-sm shrink-0 ${point.cardIcon}`}></div>
                                                <span class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-normal text-neutral-500">{point.label}</span>
                                            </div>
                                        ))
                                    }
                                </div>
                            </div>
                            <div class="w-full md:w-[40%] lg:w-[45%] p-4 md:p-5 lg:p-6 flex flex-col gap-y-4">
                                {card.urlPath && (
                                    <h6 class="font-body text-vault-navy/60 font-normal text-[length:var(--fs-body)] leading-[length:var(--lh-body)] self-end">
                                        {card.urlPath}
                                    </h6>
                                )}
                                <div class="w-full h-full min-h-[180px] md:min-h-0 rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                            </div>
                        </div>
                    </div>
                </div>
            ))}

            <!-- Gap after the stack finishes -->
            <div style="height: 80px;"></div>
        </div>

    </div>
</section>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    .invoice-stack {
      gap: 2rem !important;
    }
    .invoice-stack-sticky {
      position: static !important;
    }
    .invoice-stack-card {
      transform: none !important;
      height: auto !important;
    }
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    const stack = document.getElementById('it-invoice-stack-container');
    if (!stack) return;

    const textEl = document.getElementById('it-invoice-header-text');
    const outers = Array.from(stack.querySelectorAll('.invoice-stack-sticky'));
    const inners = Array.from(stack.querySelectorAll('.invoice-stack-card'));

    if (!outers.length || outers.length !== inners.length) return;

    const reduceMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    const STACK_OFFSET = 16;
    const REVEAL_DISTANCE = 260;

    const NAV_CLEAR =
        parseFloat(
            getComputedStyle(document.documentElement).getPropertyValue('--nav-clear'),
        ) || 112;

    const targetScaleFor = (i) => 0.88 + i * 0.03;

    const zoomFactor = () => {
        let z = 1;
        for (let n = stack; n && n.nodeType === 1; n = n.parentElement) {
            const v = parseFloat(getComputedStyle(n).zoom);
            if (v && v !== 1) z *= v;
        }
        return z;
    };

    let zoom = zoomFactor();

    const setTops = () => {
        zoom = zoomFactor();

        const originalTransform = inners[0].style.transform;
        inners[0].style.transform = 'none';

        const outerTop = outers[0].getBoundingClientRect().top;
        const innerTop = inners[0].getBoundingClientRect().top;
        const cardOffset = (innerTop - outerTop) / zoom;

        inners[0].style.transform = originalTransform;

        let firstTop = NAV_CLEAR;

        if (window.innerWidth >= 1280) {
            const cardHeight = inners[0].getBoundingClientRect().height / zoom;
            const totalStackHeight =
                cardOffset + cardHeight + (outers.length - 1) * STACK_OFFSET;
            const viewportCss = window.innerHeight / zoom;
            firstTop = Math.max(NAV_CLEAR, (viewportCss - totalStackHeight) / 2);
        }

        outers[0].style.top = firstTop + 'px';

        const baseTop = firstTop + cardOffset;
        for (let i = 1; i < outers.length; i++) {
            outers[i].style.top = baseTop + i * STACK_OFFSET + 'px';
        }
    };

    let ticking = false;

    const update = () => {
        const tops = outers.map((el) => el.getBoundingClientRect().top);

        let activeIdx = 0;
        inners.forEach((inner, i) => {
            if (i === inners.length - 1) {
                inner.style.transform = 'scale(1)';
                return;
            }

            const nextStickyTopPx =
                (parseFloat(getComputedStyle(outers[i + 1]).top) || 0) * zoom;
            const distanceToStick = tops[i + 1] - nextStickyTopPx;

            const progress = Math.min(1, Math.max(0, 1 - distanceToStick / REVEAL_DISTANCE));
            const scale = 1 - progress * (1 - targetScaleFor(i));
            inner.style.transform = `scale(${scale.toFixed(4)})`;
        });

        tops.forEach((top, i) => {
            const stickyTop = (parseFloat(getComputedStyle(outers[i]).top) || 0) * zoom;
            if (top <= stickyTop + 60) {
                activeIdx = i;
            }
        });

        const sidebarBtns = document.querySelectorAll('.it-aside-menu-item');
        sidebarBtns.forEach((btn, idx) => {
            if (idx === activeIdx) {
                btn.classList.add('border-[#655DFF]', 'text-text-default', 'font-medium');
                btn.classList.remove('border-transparent', 'text-text-default/28', 'font-normal');
            } else {
                btn.classList.remove('border-[#655DFF]', 'text-text-default', 'font-medium');
                btn.classList.add('border-transparent', 'text-text-default/28', 'font-normal');
            }
        });

        ticking = false;
    };

    const sidebarBtns = document.querySelectorAll('.it-aside-menu-item');
    sidebarBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
            const index = parseInt(btn.getAttribute('data-card-index') || '0', 10);
            if (outers[index]) {
                const topTarget = outers[index].getBoundingClientRect().top + window.scrollY - NAV_CLEAR - (index * STACK_OFFSET);
                window.scrollTo({ top: topTarget, behavior: 'smooth' });
            }
        });
    });

    const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
    };

    const handleLayoutShift = () => {
        setTops();
        update();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', handleLayoutShift);
    window.addEventListener('load', handleLayoutShift, { once: true });

    if (textEl && typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(handleLayoutShift).observe(textEl);
    }

    setTops();
    update();
});
</script>
