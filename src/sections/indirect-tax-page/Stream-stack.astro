---
/**
 * Stream-stack (GST Workflow Infrastructure Tabs) Section for Indirect Tax Page.
 * Implements accessible, lightweight, high-performance horizontal sliding tabs
 * with isolated slide tracks and smooth easing matching ClearTax brand standards.
 */

interface TabItem {
    id: string;
    tabLabel: string;
    badge: string;
    title: string;
    subtitle: string;
    desc: string;
    checklist: string[];
    tags: string[];
}

const tabsData: TabItem[] = [
    {
        id: "ai-validation",
        tabLabel: "AI Validation",
        badge: "0 Ineligible ITC",
        title: "AI validates every transaction.",
        subtitle: "Audit-ready from day one.",
        desc: "AI tags every transaction — RCM, SEZ, blocked credits — and flags ineligible ITC, missing HSN/GSTIN/POS, and duplicate vendors before filing.",
        checklist: [
            "AI data tagging & quality checks",
            "Ineligible ITC detection",
            "Missing HSN/GSTIN/POS flags",
            "Exception reports",
        ],
        tags: [
            "RCM tagged",
            "HSN validated",
            "POS checked",
            "POS checked",
        ],
    },
    {
        id: "gst-filing",
        tabLabel: "GST Filing",
        badge: "Returns Ready",
        title: "End-to-end multi-GST filing.",
        subtitle: "Validated before every return.",
        desc: "Clear auto-transforms GL into GST-ready SR/PR registers, then runs system-driven validations for ineligible ITC, missing HSN, and place-of-supply before you file.",
        checklist: [
            "PAN-level G1 to G9 filing",
            "Built-in pre-filing validations",
            "GSTR-1, 3B, 9, 9C",
            "Return-ready output",
        ],
        tags: [
            "GSTR-1 filed",
            "GSTR-3B filed",
            "GSTR-9 & 9C",
            "PAN-level filing",
        ],
    },
    {
        id: "ims",
        tabLabel: "IMS",
        badge: "Accurate 2B",
        title: "Take control of your 2B with IMS.",
        subtitle: "",
        desc: "\Manage the GST Invoice Management System end-to-end — bulk accept, reject, and pending actions, plus IMS-vs-PR reconciliation for an accurate 2B.",
        checklist: [
            "IMS Console (bulk actions)",
            "IMS Pro (IMS vs PR recon)",
            "Accurate 2B generation",
            "Bulk accept / reject / pending",
        ],
        tags: [
            "Invoices accepted",
            "Rejected flagged",
            "Pending resolved",
            "2B generated",
        ],
    },
    {
        id: "ai-2b-recon",
        tabLabel: "AI-powered 2B Recon",
        badge: "Match rate 99%",
        title: "Industry-best reconciliation, with the highest ",
        subtitle: "matching %",
        desc: "AI reconciles 2B against your purchase register with configurable rules and sub-bucketing — moving teams from monthly to daily reconciliation.",
        checklist: [
            "Industry-leading match %",
            "Automated Table 4",
            "Configurable matching rules",
            "Rule 42 & 180-day reversals",
        ],
        tags: [
            "2B vs PR matched",
            "Table 4 automated",
            "Mismatches flagged",
            "Under 10 min",
        ],
    },
    {
        id: "notice-management",
        tabLabel: "Notice Management",
        badge: "5x fewer notices",
        title: "Never miss a notice",
        subtitle: "",
        desc: "Track and respond to GST notices with AI agents that surface the root cause and pull the exact data you need to reply — backed by 25+ post-filing reports and full audit trails.",
        checklist: [
            "GST Notice Tracker",
            "AI root-cause analysis",
            "25+ post-filing reports",
            "Full audit trails",
        ],
        tags: [
            "Notices tracked",
            "Root cause found",
            "Reply data ready",
            "Audit-ready",
        ],
    },
];
---

<section id="gst-workflow-tabs-section" class="bg-generic-00 py-16 md:py-20 overflow-hidden">
    <div class="mx-auto w-full min-[1400px]:container px-4 md:px-6">
        <!-- Section Header -->
        <div class="text-center mx-auto mb-8 md:mb-10">
            <h2 class="font-heading font-medium text-[32px] sm:text-[36px] md:text-[40px] leading-[1.2] text-text-default max-w-200 mx-auto">
                Infrastructure that powers every GST workflow
            </h2>
            <p class="font-body font-normal text-neutral-500 text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] max-w-150.75 mx-auto mt-4">
                From validation and filing to IMS, reconciliation, and notice defense — Clear handles every step with speed, accuracy, and audit-ready control.
            </p>
        </div>

        <!-- Tabs Navigation -->
        <div class="flex justify-center mb-6 md:mb-8">
            <div
                class="inline-flex flex-wrap items-center justify-center p-1.5 bg-neutral-100 rounded-xl gap-1 max-w-full"
                role="tablist"
                aria-label="GST Workflows"
            >
                {
                    tabsData.map((tab, index) => (
                        <button
                            type="button"
                            role="tab"
                            id={`tab-btn-${tab.id}`}
                            aria-selected={index === 0 ? "true" : "false"}
                            aria-controls={`panel-${tab.id}`}
                            data-tab-index={index}
                            class:list={[
                                "gst-tab-btn py-2 px-6 text-sm font-medium rounded-lg font-body transition-all duration-200 cursor-pointer outline-none select-none border-0",
                                index === 0
                                    ? "active bg-generic-00 text-[#1200FF]"
                                    : "text-[#374151]",
                            ]}
                        >
                            {tab.tabLabel}
                        </button>
                    ))
                }
            </div>
        </div>

        <!-- Tab Panels Swiper Container -->
        <div class="max-w-[1280px] mx-auto p-1 -m-1">
            <div class="swiper gst-tabs-swiper w-full overflow-hidden">
                <div class="swiper-wrapper items-start">
                    {
                        tabsData.map((tab) => (
                            <div
                                id={`panel-${tab.id}`}
                                role="tabpanel"
                                aria-labelledby={`tab-btn-${tab.id}`}
                                class="swiper-slide w-full shrink-0 box-border"
                            >
                                <div class="bg-generic-00 border border-[#DCDEE2] rounded-xl p-6">
                                    <!-- Card Header -->
                                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-6 md:pb-8">
                                        <div class="max-w-2xl">
                                            <h3 class="font-heading font-medium text-[24px] sm:text-[28px] md:text-[32px] leading-tight text-text-default">
                                                {tab.title}
                                                <br />
                                                <span>{tab.subtitle}</span>
                                            </h3>
                                            <p class="font-body font-normal text-neutral-500 text-sm sm:text-base leading-relaxed mt-4 max-w-3xl">
                                                {tab.desc}
                                            </p>
                                        </div>
                                        <div class="shrink-0 self-start">
                                            <span class="inline-flex items-center bg-nova-50 text-nova-blue px-4 py-3 rounded-lg text-xs sm:text-sm font-medium font-body border border-nova-100/60">
                                                {tab.badge}
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Card Body Grid -->
                                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5.5 items-stretch">
                                        <!-- Left Column: Visual Area -->
                                        <div class="lg:col-span-8 bg-visual-placeholder rounded-2xl min-h-[300px] sm:min-h-[380px] lg:min-h-[432px] w-full flex items-center justify-center p-6 relative overflow-hidden">
                                            <div class="w-full h-full min-h-[220px] rounded-xl bg-visual-placeholder/80 flex items-center justify-center">
                                                <!-- Visual placeholder box matching brand v2 standards -->
                                            </div>
                                        </div>

                                        <!-- Right Column: Checklist & Feature Tags -->
                                        <div class="lg:col-span-4 border border-neutral-200 rounded-xl p-6 sm:p-7 flex flex-col justify-between bg-generic-00">
                                            <!-- Checklist items -->
                                            <div class="flex flex-col divide-y divide-neutral-100">
                                                {tab.checklist.map((item) => (
                                                     <div class="py-3.5 first:pt-0 last:pb-0 text-sm sm:text-[15px] font-body text-neutral-700 font-normal">
                                                         {item}
                                                     </div>
                                                ))}
                                            </div>

                                            <!-- Bottom 2x2 Feature Tags -->
                                            <div class="grid grid-cols-2 gap-x-4 gap-y-3 pt-6 mt-6 border-t border-neutral-100">
                                                {tab.tags.map((tag) => (
                                                    <div class="flex items-center gap-2.5">
                                                        <div class="w-6 h-6 rounded-xs bg-visual-placeholder shrink-0"></div>
                                                        <span class="font-body text-xs sm:text-sm text-neutral-600 font-normal">
                                                            {tag}
                                                        </span>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>
<script
    is:inline
    src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
></script>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const section = document.getElementById("gst-workflow-tabs-section");
        if (!section) return;

        const tabBtns = section.querySelectorAll(".gst-tab-btn");
        const swiperEl = section.querySelector(".gst-tabs-swiper");
        if (!swiperEl || !tabBtns.length) return;

        function updateActiveTab(index) {
            tabBtns.forEach((btn, i) => {
                const isActive = i === index;
                btn.setAttribute("aria-selected", isActive ? "true" : "false");
                if (isActive) {
                    btn.classList.add("active", "bg-generic-00", "text-[#1200FF]");
                    btn.classList.remove("text-[#374151]");
                } else {
                    btn.classList.remove("active", "bg-generic-00", "text-[#1200FF]");
                    btn.classList.add("text-[#374151]");
                }
            });
        }

        function initSwiper() {
            if (typeof Swiper === "undefined") {
                setTimeout(initSwiper, 50);
                return;
            }

            const swiper = new Swiper(swiperEl, {
                slidesPerView: 1,
                spaceBetween: 32,
                speed: 500,
                grabCursor: true,
                autoHeight: false,
                on: {
                    slideChange: function () {
                        updateActiveTab(this.activeIndex);
                    },
                },
            });

            tabBtns.forEach((btn, index) => {
                btn.addEventListener("click", () => {
                    swiper.slideTo(index);
                });
            });
        }

        initSwiper();
    });
</script>
