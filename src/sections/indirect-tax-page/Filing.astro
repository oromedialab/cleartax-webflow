---
/**
 * Filing section for Indirect Tax page.
 * Implements isolated sticky horizontal scroll container with 6 cards,
 * top title, bottom description, and responsive handling.
 */

const cards = [
    {
        title: "GL-Stream data ingestion",
        desc: "Import raw GL data from SAP, Oracle, Dynamics 365 and other ERPs. Verified against trial balance before filing begins.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac72809203ae939c6b8e7f9_image-6.png",
    },
    {
        title: "GST return filing",
        desc: "Auto-transform GL into GST-ready registers, run pre-filing validations, and file GSTR-1 to GSTR-9 at PAN level.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac72817ef17ffc941dfef40_image-7.png",
    },
    {
        title: "E-invoicing & e-way bills",
        desc: "Generate, validate, and reconcile e-invoices and e-way bills via IRP, at enterprise scale.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac7281ee803144a8d54157f_image-8.png",
    },
    {
        title: "2B reconciliation & Max ITC",
        desc: "Match 2B vs purchase register with configurable rules, IMS actions, and automated Rule 42 / 180-day reversals.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac72823ba8435714351a064_image-9.png",
    },
    {
        title: "Notice prevention",
        desc: "Flag ineligible ITC, 2B–3B mismatches, and expired e-way bills before filing to avoid system-triggered notices.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac72828203ae939c6b8ec92_image-10.png",
    },
    {
        title: "Vendor compliance",
        desc: "AI-driven vendor scorecards and risk scores, with systemised vendor communication.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac7282e9e773ab39e097956_image-11.png",
    },
];

const filingStats = [
    {
        value: "100%",
        label: "System-triggered notices eliminated",
    },
    {
        value: "Zero",
        label: "Working-capital leakage",
    },
    {
        value: "4x",
        label: "Increase in productivity",
    },
];
---

<div class="filing-sticky-container">
    <section
        class="sticky top-0 flex flex-col justify-center bg-generic-00 py-12 md:py-16 xl:py-20 overflow-hidden min-h-[calc(100vh-80px)]"
    >
        <div class="min-[1400px]:container mx-auto w-full px-4 md:px-6">
            <!-- Header -->
            <div
                class="filing-header-wrapper text-center mx-auto mb-8 md:mb-12"
            >
                <h2
                    class="filing-section-title font-heading font-medium text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] text-text-default max-w-216 mx-auto mb-4 m-0"
                >
                    Everything you need for GST compliance
                </h2>
                <p
                    class="filing-section-desc font-body font-normal text-neutral-500 text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] max-w-138.75 mx-auto"
                >
                    From ERP data extraction to filing, reconciliation,
                    e-invoicing, and audit readiness — all in one place.
                </p>
            </div>

            <!-- Cards Track -->
            <div class="w-full h-auto">
                <div
                    class="filing-scroll-track flex items-stretch gap-6 w-max transition-transform duration-[250ms] ease-out will-change-transform"
                >
                    {
                        cards.map((item) => (
                            <div class="filing-card-item bg-generic-00 rounded-xl p-6 sm:p-8 lg:p-10 w-[calc(100vw-32px)] sm:w-[420px] md:w-[460px] lg:w-[480px] h-[450px] sm:h-[500px] md:h-[535px] shrink-0 flex flex-col border-2 border-neutral-300 select-none">
                                <h3 class="filing-card-title font-heading text-[length:var(--fs-h5)] sm:text-[length:var(--fs-h4)] lg:text-[length:var(--fs-h3)] leading-[length:var(--lh-h5)] sm:leading-[length:var(--lh-h4)] lg:leading-[length:var(--lh-h3)] font-medium text-text-default max-w-[400px] pointer-events-none mb-4 m-0">
                                    {item.title}
                                </h3>
                                <div class="aspect-[412/320] rounded-xl mb-4">
                                    <img
                                        class="w-full h-full object-cover"
                                        src={item.img}
                                        alt={item.title}
                                    />
                                </div>
                                <p class="filing-card-desc font-body text-neutral-600 font-normal text-[length:var(--fs-body-sm)] lg:text-[length:var(--fs-body)] leading-[length:var(--lh-body-sm)] lg:leading-[length:var(--lh-body)] max-w-[420px] pointer-events-none">
                                    {item.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="grid grid-cols-3 mt-8 md:mt-12">
                {
                    filingStats.map((stat, index) => (
                        <div
                            class:list={[
                                "flex flex-col items-center px-2 sm:px-4 md:px-6 py-2 md:py-0 md:flex-1",
                                index > 0 &&
                                    "md:border-l md:border-neutral-300",
                            ]}
                        >
                            <h3 class="font-heading font-medium text-[length:var(--fs-h4)] sm:text-[length:var(--fs-h3)] md:text-[length:var(--fs-h2)] leading-[length:var(--lh-h4)] sm:leading-[length:var(--lh-h3)] md:leading-[length:var(--lh-h2)] text-nova-blue mb-2 m-0">
                                {stat.value}
                            </h3>
                            <p class="font-body font-normal text-[length:var(--fs-body-sm)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-sm)] lg:leading-[length:var(--lh-body-lg)] text-neutral-500 text-center m-0">
                                {stat.label}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</div>

<style is:global>
    @media (max-height: 750px) {
        .filing-sticky-container section {
            padding-top: var(--spacing-big, 1.25rem) !important;
            padding-bottom: var(--spacing-big, 1.25rem) !important;
        }
        .filing-header-wrapper {
            margin-bottom: var(--spacing-md, 1rem) !important;
        }
        .filing-card-item {
            padding: var(--spacing-x-big, 1.5rem) !important;
            height: 420px !important;
            min-height: 420px !important;
            max-width: calc(100vw - 32px) !important;
        }
        @media (min-width: 768px) {
            .filing-card-item {
                width: 400px !important;
                height: 460px !important;
                min-height: 440px !important;
            }
        }
        .filing-card-title {
            font-size: var(--fs-h5, 24px) !important;
            line-height: var(--lh-h5, 32px) !important;
        }
        .filing-card-desc {
            font-size: var(--fs-body-sm, 14px) !important;
            line-height: var(--lh-body-sm, 20px) !important;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const containers = document.querySelectorAll(
            ".filing-sticky-container",
        );
        if (!containers.length) return;

        containers.forEach((container) => {
            const track = container.querySelector(".filing-scroll-track");
            const section = container.querySelector("section");
            if (!container || !track || !section) return;

            const getHeaderHeight = () => {
                const header = document.querySelector(
                    "header, .navbar, .w-nav",
                );
                return header ? header.offsetHeight : 80;
            };

            let maxTranslate = 0;
            let totalScrollable = 0;
            let stickyTop = 0;

            const updateMeasurements = () => {
                const sectionHeight = section.offsetHeight;
                const windowHeight = window.innerHeight;
                const headerHeight = getHeaderHeight();

                const trackOffset =
                    track.parentElement.getBoundingClientRect().top -
                    section.getBoundingClientRect().top;
                const trackHeight = track.offsetHeight;
                const availableSpace = windowHeight - headerHeight;

                const idealTrackTop =
                    headerHeight +
                    Math.max(40, (availableSpace - trackHeight) / 2);
                let calculatedTop = idealTrackTop - trackOffset;

                // Position section flush under header when sticky, avoiding gap on large screens
                stickyTop = Math.min(headerHeight, calculatedTop);
                section.style.top = `${stickyTop}px`;

                const containerWidth =
                    track.parentElement.getBoundingClientRect().width;
                maxTranslate = Math.max(0, track.scrollWidth - containerWidth);
                container.style.height = `${maxTranslate + windowHeight}px`;
                totalScrollable =
                    container.getBoundingClientRect().height - sectionHeight;
            };

            updateMeasurements();

            if (window.ResizeObserver) {
                const ro = new ResizeObserver(updateMeasurements);
                ro.observe(section);
                ro.observe(track);
            }
            window.addEventListener("resize", updateMeasurements);

            let ticking = false;

            const handleScroll = () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const containerRect = container.getBoundingClientRect();
                        const scrolledDistance = Math.max(
                            0,
                            stickyTop - containerRect.top,
                        );

                        let progress =
                            totalScrollable > 0
                                ? scrolledDistance / totalScrollable
                                : 0;
                        progress = Math.max(0, Math.min(1, progress));

                        track.style.transform = `translate3d(-${progress * maxTranslate}px, 0, 0)`;

                        ticking = false;
                    });
                    ticking = true;
                }
            };

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            window.addEventListener("scroll", handleScroll, {
                                passive: true,
                            });
                            handleScroll();
                        } else {
                            window.removeEventListener("scroll", handleScroll);
                        }
                    });
                },
                {
                    rootMargin: "100% 0px 100% 0px",
                },
            );

            observer.observe(container);
        });
    });
</script>
