<section
    class="hero-section relative min-h-[700px] bg-[linear-gradient(180deg,#FFFFFF_0%,#F2F1F0_25%,#F2F1F0_75%,#FFFFFF_100%)] overflow-hidden flex items-center pt-28 pb-12 md:pt-30 md:pb-16 lg:pt-35 lg:pb-25"
    id="hero"
>
    <!-- Interactive Dot Grid Background -->
    <canvas id="hero-dots-canvas" class="absolute inset-0 z-0 w-full h-full pointer-events-none"></canvas>
    
    <!-- Radial Gradient Mask to hide dots in the center (behind text) -->
    <div 
        class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_rgba(255,255,255,1)_30%,_rgba(255,255,255,0.7)_40%,_rgba(255,255,255,0)_65%)] pointer-events-none"
    >
    </div>

    <div
        class="absolute inset-0 z-0 bg-gradient-to-b from-white/85 via-white/50 to-transparent hidden max-[630px]:block pointer-events-none"
    >
    </div>

    <div class="relative z-10 mx-auto lg:container w-full px-4 lg:px-8">
        <div class="flex justify-center items-center w-full">
            <!-- Hero Content -->
            <div class="hero-content flex flex-col items-center mx-auto text-center">
                <!-- Headline -->
                <h2
                    class="text-[36px] lg:text-[44px] xl:text-[80px] max-w-250 text-black font-semibold font-inter-tight leading-[1.1] mb-4 m-0 text-center"
                >
                    AI-powered  <span class="text-black bg-[#C8F006] px-1 rounded-lg">compliance</span>, built for assurance
                </h2>

                <!-- Description -->
                <p
                    class="text-base sm:text-lg max-w-133 text-[#6B7280] font-medium font-google-sans leading-normal mb-7 text-center"
                >
                    One intelligent platform for tax, e-invoicing, finance automation and governance across every market you operate in.
                </p>

                <!-- Call to Action button -->
                <button
                    onclick="scrollToContactForm(event)"
                    class="inline-flex items-center justify-center gap-2 px-12 py-2 md:py-4 font-google-sans rounded-lg font-medium text-white text-base cursor-pointer bg-[#5446FF] border border-[#5446FF]"
                    style="outline: none;"
                >
                    See how it works
                </button>
            </div>
        </div>
    </div>
</section>
<script is:inline>
  // Smooth scroll logic
  window.scrollToContactForm = (e) => {
    e.preventDefault();
    const contactForm = document.getElementById('contact-form');
    if (contactForm) {
      contactForm.scrollIntoView({ behavior: 'smooth' });
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('hero-dots-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    let width, height;
    
    // Exact configuration from your code snippet + physics props
    const config = {
      dotSize: 4,
      gap: 22,
      baseColor: "#A5D200",
      activeColor: "#799124",
      proximity: 120,
      
      // Physics additions
      speedTrigger: 100,
      shockRadius: 250,
      shockStrength: 6,
      maxSpeed: 5000,
      resistance: 450,
      returnDuration: 1.5
    };

    let dots = [];
    let shockwaves = [];
    
    let mouse = { x: -9999, y: -9999 };
    let lastMouse = { x: -9999, y: -9999 };
    let lastShockwaveTime = 0;

    function initGrid() {
      width = canvas.parentElement.offsetWidth;
      height = canvas.parentElement.offsetHeight;
      
      const dpr = window.devicePixelRatio || 1;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
      
      dots = [];
      const spacing = config.dotSize + config.gap;
      
      for (let y = spacing; y < height + spacing; y += spacing) {
        for (let x = spacing; x < width + spacing; x += spacing) {
          dots.push({
            originX: x,
            originY: y,
            x: x,
            y: y,
            vx: 0,
            vy: 0,
            colorIntensity: 0
          });
        }
      }
    }

    // Convert hex colors to RGB for smooth transitions
    function hexToRgb(hex) {
      const bigint = parseInt(hex.replace('#', ''), 16);
      return [(bigint >> 16) & 255, (bigint >> 8) & 255, bigint & 255];
    }
    const baseRgb = hexToRgb(config.baseColor);
    const activeRgb = hexToRgb(config.activeColor);

    let lastTime = performance.now();

    function draw(time) {
      let dt = (time - lastTime) / 1000;
      if (dt > 0.05) dt = 0.05; // Cap delta time
      lastTime = time;

      ctx.clearRect(0, 0, width, height);

      // Expand and filter shockwaves
      shockwaves.forEach(sw => {
        sw.radius += 800 * dt; 
      });
      shockwaves = shockwaves.filter(sw => sw.radius < config.shockRadius);

      // Physics variables derived from your parameters
      const spring = 30 / config.returnDuration; 
      const damping = config.resistance / 100;

      dots.forEach((dot) => {
        const dx = mouse.x - dot.originX;
        const dy = mouse.y - dot.originY;
        const distance = Math.sqrt(dx * dx + dy * dy);

        // 1. Proximity Color Change (Just like your provided snippet)
        let targetIntensity = distance < config.proximity ? 1 : 0;
        
        // 2. Proximity Magnetic Flow (Tuned based on your edits)
        // If you don't want any movement on hover, you can delete this block!
        if (distance < config.proximity) {
          const force = Math.pow((config.proximity - distance) / config.proximity, 2);
          const angle = Math.atan2(dy, dx);
          dot.vx -= Math.cos(angle) * force * 350 * dt; // Outward push
          dot.vy -= Math.sin(angle) * force * 350 * dt;
          dot.vx -= Math.cos(angle + Math.PI/2) * force * 100 * dt; // Swirl
          dot.vy -= Math.sin(angle + Math.PI/2) * force * 100 * dt;
        }

        // 3. Shockwave Push
        shockwaves.forEach(sw => {
          const swDx = dot.x - sw.x;
          const swDy = dot.y - sw.y;
          const swDist = Math.sqrt(swDx*swDx + swDy*swDy);
          const distToFront = Math.abs(swDist - sw.radius);
          
          if (distToFront < 30) { 
            const force = config.shockStrength * (1 - sw.radius/config.shockRadius) * (30 - distToFront)/30;
            const angle = Math.atan2(swDy, swDx);
            dot.vx += Math.cos(angle) * force * 2000 * dt;
            dot.vy += Math.sin(angle) * force * 2000 * dt;
          }
        });

        // 4. Spring physics returning to origin
        dot.vx -= spring * (dot.x - dot.originX) * dt;
        dot.vy -= spring * (dot.y - dot.originY) * dt;
        
        dot.vx -= damping * dot.vx * dt;
        dot.vy -= damping * dot.vy * dt;

        // Cap speed
        const speed = Math.sqrt(dot.vx*dot.vx + dot.vy*dot.vy);
        if (speed > config.maxSpeed) {
          dot.vx = (dot.vx / speed) * config.maxSpeed;
          dot.vy = (dot.vy / speed) * config.maxSpeed;
        }

        // Apply velocity
        dot.x += dot.vx * dt;
        dot.y += dot.vy * dt;

        // Smoothly transition colors
        dot.colorIntensity += (targetIntensity - dot.colorIntensity) * 10 * dt;
        const r = Math.round(baseRgb[0] + (activeRgb[0] - baseRgb[0]) * dot.colorIntensity);
        const g = Math.round(baseRgb[1] + (activeRgb[1] - baseRgb[1]) * dot.colorIntensity);
        const b = Math.round(baseRgb[2] + (activeRgb[2] - baseRgb[2]) * dot.colorIntensity);

        ctx.beginPath();
        ctx.fillStyle = `rgb(${r}, ${g}, ${b})`;
        ctx.arc(dot.x, dot.y, config.dotSize / 2, 0, Math.PI * 2);
        ctx.fill();
      });

      requestAnimationFrame(draw);
    }

    window.addEventListener('resize', initGrid);
    initGrid();

    // Mouse Tracking & Shockwave Trigger
    const heroSection = document.getElementById('hero');
    heroSection.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      const currentX = e.clientX - rect.left;
      const currentY = e.clientY - rect.top;

      if (lastMouse.x !== -9999) {
        const dx = currentX - lastMouse.x;
        const dy = currentY - lastMouse.y;
        const dist = Math.sqrt(dx*dx + dy*dy);
        
        const now = performance.now();
        if (dist > config.speedTrigger && now - lastShockwaveTime > 150) { 
          shockwaves.push({ x: currentX, y: currentY, radius: 0 });
          lastShockwaveTime = now;
        }
      }

      lastMouse.x = currentX;
      lastMouse.y = currentY;
      mouse.x = currentX;
      mouse.y = currentY;
    });

    heroSection.addEventListener("mouseleave", () => {
      mouse.x = -9999;
      mouse.y = -9999;
      lastMouse.x = -9999;
      lastMouse.y = -9999;
    });

    draw(performance.now());
  });
</script>
