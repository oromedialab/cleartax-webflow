<section
    class="hero-section relative min-h-[700px] overflow-hidden flex items-center pt-28 pb-12 md:pt-30 md:pb-16 lg:pt-35 lg:pb-25"
    id="hero"
>
    <!-- Sunset Skyline Background with dark to soft fade overlays -->
    <div
        class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a731820698401458f78185d_hero-bg.png');"
    >
    </div>
    <div
        class="absolute inset-0 z-0 bg-gradient-to-b from-white/85 via-white/50 to-transparent hidden max-[630px]:block pointer-events-none"
    >
    </div>

    <div class="relative z-10 mx-auto lg:container w-full px-4 lg:px-8">
        <div class="flex justify-center items-center w-full">
            <!-- Hero Content -->
            <div class="hero-content flex flex-col items-center mx-auto text-center">
                <!-- Headline -->
                <h2
                    class="text-[36px] lg:text-[44px] xl:text-[80px] max-w-250 text-black font-medium font-inter-tight leading-[1] mb-4 m-0 text-center"
                >
                    AI-powered  <span class="text-black bg-[#C8F006] px-1 rounded-lg">compliance</span>, built for assurance
                </h2>

                <!-- Description -->
                <p
                    class="text-base sm:text-lg max-w-133 text-[#6B7280] font-medium leading-normal mb-7 text-center"
                >
                    One intelligent platform for tax, e-invoicing, finance automation and governance across every market you operate in.
                </p>

                <!-- Call to Action button -->
                <button
                    onclick="scrollToContactForm(event)"
                    class="inline-flex items-center justify-center gap-2 px-12 py-2 md:py-4 font-google-sans rounded-lg font-medium text-white text-base cursor-pointer bg-[#5446FF] border border-[#5446FF]"
                    style="outline: none;"
                >
                    See how it works
                </button>
            </div>
        </div>
    </div>
</section>
<script is:inline>
  window.scrollToContactForm = (e) => {
    e.preventDefault();
    const contactForm = document.getElementById('contact-form');
    if (contactForm) {
      contactForm.scrollIntoView({ behavior: 'smooth' });
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }
  };
</script>
