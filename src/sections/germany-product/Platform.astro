---
interface Props {
  label?: string;
}

const stats = [
  {
    label: "Receive invoices",
  },
  {
    label: "Identify the invoice format",
  },
  {
    label: "Validate structured data",
  },
  {
    label: "Extract structured data",
  },
  {
    label: "Route into ERP / AP workflows",
  },
  {
    label: "Monitor exceptions",
  },
  {
    label: "Archive the invoice",
  },
];

// Duplicate sets to create an infinite circular dialer wheel
const loopSets = [0, 1, 2, 3];
---

<section class="bg-generic-00 py-16 md:py-20" data-de-platform-section>
  <div class="mx-auto max-w-[var(--container-max)] px-4 md:px-6 w-full">
    <div
      class="border border-neutral-200 w-full rounded-2xl bg-generic-00 p-6 sm:p-8 lg:p-12 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center"
    >
      <!-- Left Column: Title, Description & Placeholder Visual -->
      <div class="lg:col-span-5 flex flex-col justify-between h-full">
        <div>
          <h3
            class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] lg:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] lg:leading-[length:var(--lh-h1)] mb-4 text-balance"
          >
            How ClearTax Platform Helps Receive E-Invoices
          </h3>
          <p
            class="m-0 mb-6 text-neutral-500 font-body font-normal text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] max-w-[480px]"
          >
            Enterprise teams get automated validation of the incoming invoices, structured data capture, visibility into what failed and why, ERP-ready workflows, and audit-ready records.
          </p>
        </div>
        <div class="bg-visual-placeholder aspect-[490/275] w-full rounded-xl mt-2 lg:mt-6"></div>
      </div>

      <!-- Right Column: Repeating Dialer Wheel -->
      <div class="lg:col-span-7 flex flex-col justify-center relative w-full h-[380px] sm:h-[525px] overflow-hidden">
        <div
          class="de-platform-dialer relative w-full h-full overflow-y-scroll select-none cursor-grab"
          data-de-platform-dialer
          aria-label="E-Invoice workflow steps dialer"
        >
          <div class="de-platform-track flex flex-col" data-de-platform-track>
            {
              loopSets.map((setIdx) =>
                stats.map((stat, i) => (
                  <div
                    class="de-platform-item flex items-center px-4 sm:px-6 lg:px-8 border-b border-neutral-200/80 transition-all duration-150 h-[60px] sm:h-[80px] shrink-0"
                    data-de-platform-item
                    data-step-index={i}
                    data-set-index={setIdx}
                  >
                    <span class="de-platform-label font-body text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] truncate">
                      {stat.label}
                    </span>
                  </div>
                ))
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .de-platform-dialer {
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.4) 10%,
      black 25%,
      black 75%,
      rgba(0, 0, 0, 0.4) 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.4) 10%,
      black 25%,
      black 75%,
      rgba(0, 0, 0, 0.4) 90%,
      transparent 100%
    );
  }

  .de-platform-dialer::-webkit-scrollbar {
    display: none;
  }

  .de-platform-item {
    will-change: opacity, color;
  }
</style>

<script is:inline>
  (function () {
    const dialer = document.querySelector("[data-de-platform-dialer]");
    if (!dialer) return;

    const items = Array.from(dialer.querySelectorAll("[data-de-platform-item]"));
    if (!items.length) return;

    const itemCountPerSet = 7;
    let itemHeight = items[0].offsetHeight || 60;
    let setHeight = itemHeight * itemCountPerSet;

    // Recalculate dimensions on resize
    function measure() {
      itemHeight = items[0].offsetHeight || 60;
      setHeight = itemHeight * itemCountPerSet;
    }

    // Start in the second set (setIndex 1) for infinite bidirectional scrolling
    measure();
    dialer.scrollTop = setHeight;

    let isInteracting = false;
    let isPointerDown = false;
    let startY = 0;
    let startScrollTop = 0;
    let interactionTimeout = null;

    function handleInteractionStart() {
      isInteracting = true;
      if (interactionTimeout) clearTimeout(interactionTimeout);
    }

    function handleInteractionEnd() {
      if (interactionTimeout) clearTimeout(interactionTimeout);
      interactionTimeout = setTimeout(() => {
        if (!isPointerDown) {
          isInteracting = false;
        }
      }, 1500);
    }

    // Infinite loop wrap check & focal styling update
    function updateDialer() {
      if (!setHeight) return;

      // Wrap around seamlessly
      if (dialer.scrollTop < setHeight * 0.5) {
        dialer.scrollTop += setHeight;
      } else if (dialer.scrollTop >= setHeight * 2.5) {
        dialer.scrollTop -= setHeight;
      }

      const dialerRect = dialer.getBoundingClientRect();
      const dialerCenter = dialerRect.top + dialerRect.height / 2;
      const halfHeight = dialerRect.height / 2;

      items.forEach((item) => {
        const itemRect = item.getBoundingClientRect();
        // Check if item is inside or close to viewport
        if (itemRect.bottom < dialerRect.top - 50 || itemRect.top > dialerRect.bottom + 50) {
          return;
        }

        const itemCenter = itemRect.top + itemRect.height / 2;
        const dist = Math.abs(itemCenter - dialerCenter);
        const normDist = Math.min(dist / halfHeight, 1);

        const label = item.querySelector(".de-platform-label");
        if (!label) return;

        // Dial wheel focus curve: 
        // Center: 1.0 opacity, dark navy, font-semibold
        // Off-center: progressively dimmer and lighter
        if (normDist <= 0.28) {
          item.style.opacity = "1";
          label.style.fontWeight = "500";
          label.style.color = "#05022A";
        } else if (normDist <= 0.6) {
          item.style.opacity = (1 - (normDist - 0.28) * 1.1).toFixed(2);
          label.style.fontWeight = "500";
          label.style.color = "#1F2937";
        } else {
          item.style.opacity = Math.max(0.2, (0.6 - (normDist - 0.6) * 1.0)).toFixed(2);
          label.style.fontWeight = "400";
          label.style.color = "#4B5563";
        }
      });
    }

    dialer.addEventListener("scroll", updateDialer, { passive: true });

    // Pointer Drag interactions
    dialer.addEventListener("pointerdown", (e) => {
      isPointerDown = true;
      handleInteractionStart();
      startY = e.clientY;
      startScrollTop = dialer.scrollTop;
      dialer.style.cursor = "grabbing";
      dialer.setPointerCapture(e.pointerId);
    });

    dialer.addEventListener("pointermove", (e) => {
      if (!isPointerDown) return;
      const dy = e.clientY - startY;
      dialer.scrollTop = startScrollTop - dy;
    });

    function endPointerDrag(e) {
      if (!isPointerDown) return;
      isPointerDown = false;
      dialer.style.cursor = "grab";
      try {
        dialer.releasePointerCapture(e.pointerId);
      } catch (_) {}
      handleInteractionEnd();
    }

    dialer.addEventListener("pointerup", endPointerDrag);
    dialer.addEventListener("pointercancel", endPointerDrag);

    // Pause auto-drift when hovered
    dialer.addEventListener("mouseenter", handleInteractionStart);
    dialer.addEventListener("mouseleave", handleInteractionEnd);
    dialer.addEventListener("wheel", () => {
      handleInteractionStart();
      handleInteractionEnd();
    }, { passive: true });

    // Slow idle drift like a dialer wheel
    let rafId = null;
    function autoDrift() {
      if (!isInteracting) {
        dialer.scrollTop += 0.45;
      }
      rafId = requestAnimationFrame(autoDrift);
    }
    rafId = requestAnimationFrame(autoDrift);

    window.addEventListener("resize", () => {
      measure();
      updateDialer();
    });

    // Initial calculation
    updateDialer();
  })();
</script>