---
/**
 * Germany Product: "How ClearTax supports Germany's e-invoicing Mandate"
 * 6 rows with title and icon on the left, and lead heading + full explanation on the right.
 * Scroll-spotlight lifts the active row to full opacity as it passes through the viewport.
 */
interface Row {
  title: string;
  img?: string;
  heading: string;
  body: string;
}

const rows: Row[] = [
  {
    title: "4× Faster Transition",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1753c5f4e751ca08a8893_ksa-icon-5.png",
    heading: "Go-live with AI Integration",
    body: "Our autonomous integration agent analyses your ERP, maps your data, and configures the connection automatically. Setup goes from months to weeks, and your IT team barely has to touch it.\n\nConnectors for SAP, Oracle, Microsoft Dynamics, and 100+ others are available out of the box.",
  },
  {
    title: "Interoperability",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1753f10bad5e8d3678812_ksa-icon-6.png",
    heading: "One API. Every Mandate & ViDA",
    body: "Integrate ClearTax once for Germany and scale to future e-invoicing mandates across the EU and other regions. When ViDA DRR goes live in 2030, or a new country mandate comes into scope, you don't need a new IT project. Your existing API and ERP integration stay the same. Just activate the required country configuration in ClearTax.",
  },
  {
    title: "Auto-healing keeps invoices flowing",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccc5de9b225f084c5057_ir-icon-10.png",
    heading: "99.88% uptime",
    body: "Our platform validates every invoice before transmission and flags issues before they become failures. Duplicate detection, abnormal value alerts, vendor anomaly detection — problems surface before they cost you money. 10,000 invoices per second at 99.88% uptime.",
  },
  {
    title: "Audit-ready. Every day",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccced00effec3a6c3bff_ir-icon-12.png",
    heading: "Recon AI Agent",
    body: "The Recon AI Agent runs a reconciliation every day and compares your ERP sales data against e-invoice data, flagging discrepancies before they become notices. Finance teams query invoices and exceptions in plain language. No deep system navigation required.",
  },
  {
    title: "One dashboard for Multi-Channel",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af1752faf24c8e93a253fae_ksa-icon-4.png",
    heading: "Unified dashboard",
    body: "XRechnung, ZUGFeRD 2.x, and Peppol BIS 3.0 - all invoices, incoming or outgoing - flow into one unified dashboard with status, validation result, and error detail for every document. Whenever you expand to cross-border transactions, or any of our 40+ supported countries, you don't need a new integration or a vendor. The same interface with the same unified API will work.",
  },
  {
    title: "E-reporting",
    img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aedccd7758a3c30559f9cda_ir-icon-14.png",
    heading: "Insert sub-heading",
    body: "Germany's Finance Ministry has given its first timeline for the Meldesystem, which is about e-reporting to the tax authorities. The mandate for e-reporting will go live from July 2030. ClearTax's e-invoicing solution is already equipped with automation for e-reporting. Our platform automates all transformations, scheduling, and submissions. You will see a status dashboard with complete reporting.",
  },
];
---

<section id="de-mandate" class="bg-generic-00 py-16 lg:py-20">
  <div
    class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12"
  >
    <div class="flex max-w-[760px] flex-col items-center gap-4 text-center">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        How ClearTax supports Germany's e-invoicing Mandate
      </h2>
      <p
        class="m-0 max-w-[620px] font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]"
      >
        Germany E-Invoicing software that works across your ERP landscape. ClearTax was built from day one for tax, and it shows.
      </p>
    </div>

    <div class="flex w-full flex-col divide-y divide-neutral-200">
      {
        rows.map((r) => (
          <div class="de-mandate-row grid grid-cols-1 gap-4 py-8 lg:grid-cols-12 lg:gap-12 items-start">
            {/* Left Column: Icon + Title */}
            <div class="lg:col-span-5 flex items-center gap-4">
              {r.img && (
                <img
                  src={r.img}
                  alt=""
                  loading="lazy"
                  height="56"
                  width="56"
                  class="size-12 sm:size-14 shrink-0 object-contain"
                />
              )}
              <h3 class="m-0 font-heading font-medium text-[19px] sm:text-[20px] leading-[26.6px] text-vault-navy max-w-[370px]">
                {r.title}
              </h3>
            </div>

            {/* Right Column: Heading + Body */}
            <div class="lg:col-span-7 flex flex-col gap-2">
              <h4 class="m-0 font-heading font-medium text-[16px] sm:text-[17px] leading-[24px] text-vault-navy">
                {r.heading}
              </h4>
              <p class="m-0 font-body text-neutral-500 text-[13.5px] sm:text-[14px] leading-[22px] whitespace-pre-line">
                {r.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
