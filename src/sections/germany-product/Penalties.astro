---
/**
 * Germany Product: "Why E-Invoicing Compliance Can't Wait" (Penalties / Risk Assessment)
 * 3-Column structured card highlighting Reputation & Penalty Risk, Technology Risk, and Global Delivery Risk.
 * Styled following the typography, spacing, and design system of the germany-product page.
 */
interface RiskItem {
  riskNumber: string;
  title: string;
  description: string;
}

const risks: RiskItem[] = [
  {
    riskNumber: "Risk 1",
    title: "Reputation & Penalty Risk",
    description:
      "Tax authorities cross-reference e-Invoice data against VAT returns automatically. Mismatches surface too fast.",
  },
  {
    riskNumber: "Risk 2",
    title: "Technology Risk",
    description:
      "E-Invoicing regulations change constantly after go-live. Without a purpose-built platform, every regulatory update consumes IT bandwidth and creates fragile, patchwork architecture.",
  },
  {
    riskNumber: "Risk 3",
    title: "Global Delivery Risk",
    description:
      "Each new country mandate multiplies complexity. Building one-off integrations per market creates high development costs, manual workarounds, and systems that can't scale.",
  },
];
---

<section id="de-penalties" class="bg-generic-00 py-16 lg:py-20" data-de-penalties>
  <div
    class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-10 md:gap-12"
  >
    <!-- Header: Title & Subtitle -->
    <div class="flex flex-col items-center gap-4 text-center">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        Why E-Invoicing Compliance Can’t Wait
      </h2>
      <p
        class="m-0 max-w-198 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]"
      >
        Penalties are financial and legal liabilities. Germany’s e-invoicing mandate is already in motion.
        Any delay can create compliance gaps, tax exposure, and costly last-minute system changes.
      </p>
    </div>

    <!-- 3-Column Risk Card with Orange Border -->
    <div
      class="w-full rounded-2xl border border-[#F97316] bg-generic-00 p-6 sm:p-8 lg:p-10"
    >
      <div class="flex flex-col md:flex-row items-stretch">
        {
          risks.map((risk, index) => (
            <>
              {index > 0 && (
                <>
                  {/* Desktop vertical divider */}
                  <div
                    class="hidden md:block w-px bg-neutral-200 mx-6 lg:mx-8 shrink-0 self-stretch"
                    aria-hidden="true"
                  />
                  {/* Mobile horizontal divider */}
                  <div
                    class="block md:hidden h-px bg-neutral-200 w-full my-6 shrink-0"
                    aria-hidden="true"
                  />
                </>
              )}
              <div class="flex-1 flex flex-col items-start text-left">
                <span class="font-heading font-medium text-vault-navy text-[length:var(--fs-h4)] leading-[length:var(--lh-h4)]">
                  {risk.riskNumber}
                </span>
                <h3 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] mt-2 mb-3">
                  {risk.title}
                </h3>
                <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                  {risk.description}
                </p>
              </div>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>
