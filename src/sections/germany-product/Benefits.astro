---
/**
 * Germany Product: "Germany E-invoicing Won't Stay the Same." (Benefits / Evolution Roadmap)
 * 3-Column structured comparison card for 2027 E-Invoicing, 2030 E-Reporting, and 2030 EU ViDA.
 * Styled following typography, background, borders and spacing from bahrain-regional/InvoiceData.astro.
 */

interface ColumnData {
  id: string;
  yearTitle: string;
  subtitle: string;
  icon: string;
  rows: string[];
}

const columns: ColumnData[] = [
  {
    id: "invoicing",
    yearTitle: "2027 - E-Invoicing",
    subtitle: "Structured B2B invoice exchange begins.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6afb3e31fdabc0ab1f94a5f0_de-icon-7.png",
    rows: [
      "B2B invoice exchange in phases",
      "Post-audit model with no clearance model",
      "ClearTax is Live in Germany from day one",
    ],
  },
  {
    id: "reporting",
    yearTitle: "2030 - E-Reporting",
    subtitle: "Invoice data is submitted to the tax authority per transaction.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6afb3e36851a5f3b5f873d78_de-icon-8.png",
    rows: [
      "Reporting begins in July 2030",
      "New data fields required",
      "VAT pre-fill: government holds its own view of your position",
      "With ClearTax, no new IT project required",
    ],
  },
  {
    id: "vida",
    yearTitle: "2030 - EU ViDA",
    subtitle: "Cross-border B2B reporting becomes EU-wide.",
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6afb3e3c15c9472f4b115456_de-icon-9.png",
    rows: [
      "Digital Reporting Requirements for intra-EU B2B",
      "EU-wide cross-border B2B invoices",
      "Replaces EC sales listings for intra-EU",
      "ClearTax's architecture is designed for ViDA",
    ],
  },
];
---

<section
  class="bg-generic-00 py-16 lg:py-20"
  id="de-benefits"
  data-de-benefits
>
  <div class="max-w-[var(--container-max)] mx-auto px-4 md:px-6">
    <div class="flex flex-col items-center gap-12">
      <!-- Header: Title & Subtitle -->
      <div class="flex flex-col items-center gap-4 text-center">
        <h2
          class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] tracking-[-0.5px]"
        >
          Germany E-invoicing Won't Stay the Same.
        </h2>
        <p
          class="m-0 max-w-[666px] font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
        >
          B2B E-invoicing is phase one of a multi-year digital transformation of VAT. ClearTax is already built for what comes next in EU-ViDA.
        </p>
      </div>

      <!-- Main Comparison Card (3 Columns) -->
      <div
        class="w-full rounded-xl border border-neutral-300 bg-generic-00 overflow-hidden"
      >
        <div
          class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-neutral-300"
        >
          {
            columns.map((col) => (
              <div
                class="flex flex-col h-full"
                data-col-id={col.id}
              >
                {/* Column Header: Icon, Year Title, Subtitle */}
                <div class="p-4 sm:p-5 lg:p-6 flex flex-col justify-start border-b border-neutral-300 md:min-h-[205px] lg:min-h-[230px]">
                  <div class="size-12 sm:size-14 lg:size-18 flex items-center justify-center shrink-0 mb-4 lg:mb-6">
                    <img
                      src={col.icon}
                      alt=""
                      class="size-12 sm:size-14 lg:size-18 object-contain"
                      loading="lazy"
                    />
                  </div>

                  <h3 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-body)] lg:text-[length:var(--fs-h5)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-h5)]">
                    {col.yearTitle}
                  </h3>
                  <p class="m-0 font-body text-vault-navy max-w-none lg:max-w-[217px] text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] mt-2">
                    {col.subtitle}
                  </p>
                </div>

                {/* Bullet Rows */}
                <div class="px-4 sm:px-5 lg:px-6 py-2 flex flex-col justify-around flex-1">
                  {col.rows.map((rowText, rowIdx) => {
                    const isLastRow = rowIdx === col.rows.length - 1;
                    const borderClass = isLastRow ? "" : "border-b border-neutral-200/80";

                    return (
                      <div
                        class={`flex items-start gap-2 py-3 lg:py-3.5 ${borderClass}`}
                      >
                        <span
                          class="w-1.5 h-1.5 rounded-full bg-[#4F46E5] shrink-0 mt-1.5"
                          aria-hidden="true"
                        />
                        <span class="font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] font-normal">
                          {rowText}
                        </span>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Bottom Caption / Takeaway Note -->
      <div class="flex items-center text-center">
        <p class="m-0 font-body font-normal max-w-118 text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
          Build Germany e-invoicing with Europe’s next phase in mind. Prepare for today. Build for tomorrow.
        </p>
      </div>
    </div>
  </div>
</section>
