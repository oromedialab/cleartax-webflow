---
/**
 * Germany Product: "What actually changes for AP and AR"
 * Two comparison cards for Accounts Receivable and Accounts Payable highlighting operational transformations.
 * Styled following the typography, spacing, and design system of the germany-product page.
 */
interface SectionRow {
  heading: string;
  body: string;
}

interface ColumnCard {
  title: string;
  rows: SectionRow[];
}

const cards: ColumnCard[] = [
  {
    title: "Accounts Receivable",
    rows: [
      {
        heading: "DSO shortens significantly",
        body: "Customers process valid structured invoices in days, not weeks. Working capital improves directly.",
      },
      {
        heading: "Fewer rejection cycles",
        body: "Country-specific validation catches field errors before invoices reach the customer — removing payment delays at source.",
      },
      {
        heading: "ERP-connected, no manual exports",
        body: "AR workflows connect directly to your ERP and order management. No manual export-import cycles.",
      },
      {
        heading: "Business continuity guaranteed",
        body: "Invoicing keeps running even when government portals go down. Revenue recognition stays on schedule.",
      },
    ],
  },
  {
    title: "Accounts Payable",
    rows: [
      {
        heading: "3–5 days processing vs 18–25 on paper",
        body: "Structured e-invoicing compresses the invoice cycle end to end. No manual data entry, no keying errors.",
      },
      {
        heading: "Early payment discount capture",
        body: "Real-time visibility into payables lets you optimise payment timing and capture discounts you'd otherwise miss.",
      },
      {
        heading: "Audit readiness built in",
        body: "Validation rules, approval trails, and invoice data captured automatically. No manual prep for audits ever.",
      },
      {
        heading: "Stronger supplier relationships",
        body: "Faster approvals and on-time payments improve supplier trust and your negotiating position.",
      },
    ],
  },
];
---

<section id="de-apar" class="bg-generic-00 py-16 lg:py-20" data-de-apar>
  <div
    class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-10 md:gap-12"
  >
    <!-- Header: Title & Subtitle -->
    <div class="flex max-w-[760px] flex-col items-center gap-4 text-center">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        What actually changes for AP and AR
      </h2>
      <p
        class="m-0 max-w-[620px] font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]"
      >
        E-invoicing isn't just a technology project — it transforms how your
        accounts receivable and payable teams operate, for the better.
      </p>
    </div>

    <!-- 2 Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 w-full items-stretch">
      {
        cards.map((card) => (
          <article class="flex flex-col rounded-xl border border-neutral-300 bg-generic-00 overflow-hidden">
            <!-- Card Header: Edge-to-edge bottom border -->
            <div class="px-6 py-6 border-b border-neutral-300">
              <h3 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                {card.title}
              </h3>
            </div>

            <!-- Card Rows: Inset borders with container padding -->
            <div class="px-6 px-6 flex flex-col justify-between flex-1">
              {card.rows.map((row, idx) => {
                const isLast = idx === card.rows.length - 1;
                return (
                  <div
                    class={`flex flex-col gap-2 items-start text-left py-6 ${
                      isLast ? "" : "border-b border-neutral-200"
                    }`}
                  >
                    <h4 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                      {row.heading}
                    </h4>
                    <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                      {row.body}
                    </p>
                  </div>
                );
              })}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
