---
interface Step {
  no: string;
  heading: string;
}

const steps: Step[] = [
  {
    no: "01",
    heading: "Create the commercial invoice in your ERP.",
  },
  {
    no: "02",
    heading: "Connect and send invoice data to ClearTax through the ERP integration.",
  },
  {
    no: "03",
    heading: "Map ERP data into the structured invoice format.",
  },
  {
    no: "04",
    heading: "Validate and check syntax and EN 16931 requirements.",
  },
  {
    no: "05",
    heading: "Generate the required XRechnung or qualifying ZUGFeRD invoice.",
  },
  {
    no: "06",
    heading: "Send the invoices through the configured exchange channel.",
  },
  {
    no: "07",
    heading: "Monitor invoice processing, delivery, rejections and exceptions.",
  },
  {
    no: "08",
    heading: "Archive the original structured invoice as required.",
  },
];
