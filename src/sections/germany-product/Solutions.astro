<style is:global>
  .de-solution-card {
    border-color: #5446FF;
    transition: opacity 350ms cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 350ms cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 350ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .de-solution-js .de-solution-card {
    opacity: 0.45;
    border-color: #e5e5e5;
  }
  .de-solution-js .de-solution-card.is-active {
    opacity: 1;
    border-color: #5446FF;
    box-shadow: 0 4px 16px -2px rgba(84, 70, 255, 0.12);
  }
  .de-solution-line {
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 450ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .de-solution-line.is-drawn {
    transform: scaleY(1);
  }
</style>

<script is:inline>
  (function () {
    const root = document.querySelector("[data-de-solutions]");
    if (!root) return;

    const cards = Array.from(
      root.querySelectorAll("[data-de-solution-card]")
    );
    const connectors = Array.from(
      root.querySelectorAll("[data-de-solution-connector]")
    );
    if (!cards.length) return;

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduceMotion) {
      cards.forEach((c) => c.classList.add("is-active"));
      connectors.forEach((conn) => {
        const line = conn.querySelector(".de-solution-line");
        if (line) line.classList.add("is-drawn");
      });
      return;
    }

    root.classList.add("de-solution-js");

    let ticking = false;

    function update() {
      const triggerY = window.innerHeight * 0.72;

      cards.forEach((card) => {
        const rect = card.getBoundingClientRect();
        if (rect.top <= triggerY) {
          card.classList.add("is-active");
        } else if (rect.top > triggerY + 40) {
          card.classList.remove("is-active");
        }
      });

      connectors.forEach((conn) => {
        const line = conn.querySelector(".de-solution-line");
        if (!line) return;

        const rect = conn.getBoundingClientRect();
        if (rect.top <= triggerY) {
          line.classList.add("is-drawn");
        } else if (rect.top > triggerY + 40) {
          line.classList.remove("is-drawn");
        }
      });
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });

    // Initial check on load
    update();
  })();
</script>
