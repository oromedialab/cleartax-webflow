---
/**
 * "We speak the language of your existing stack." Real Estate variant of
 * retail-consumer/ExistingSystems.astro — same three-category card layout,
 * re-skinned for real estate/construction systems. None of these vendors
 * have a hosted Webflow logo asset yet, so every badge falls back to the
 * neutral monogram swatch (same fallback pattern the retail-consumer
 * version uses for POS vendors without art).
 */
interface Logo {
  name: string;
  src?: string;
}

interface Category {
  title: string;
  desc: string;
  logos: Logo[];
}

const categories: Category[] = [
  {
    title: "Real Estate ERPs",
    desc: "Where leases, SPVs and off-plan schedules live.",
    logos: [
      {
        name: "SAP RE-FX",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59be2ddedbf4b5615765_sap.png",
      },
      {
        name: "Yardi Voyager",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5a0591725bbf5e82052b_yardi.png",
      },
      {
        name: "Oracle Fusion",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594b2872eeb6348efacd_oracle-fusion.png",
      },
      {
        name: "MS Dynamics 365",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594489cb38a8fe58819d_ms.png",
      },
      {
        name: "MRI Software",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb593c64e1f4bc7198f580_mn.png",
      },
    ],
  },
  {
    title: "Construction Systems",
    desc: "Where interim bills, Bills of Quantities (BOQs) and certification happen.",
    logos: [
      {
        name: "Procore",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb597d1cc6deef8bc03548_procore.png",
      },
      {
        name: "Primavera P6",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5959ed5cad3df92f2bcf_p6.png",
      },
      {
        name: "JD Edwards",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59098af5fd369ec829b5_jd.png",
      },
      {
        name: "SAP PS",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59be2ddedbf4b5615765_sap.png",
      },
      {
        name: "COINS ERP",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58b19e92b82e10e3cc2d_coin.png",
      },
    ],
  },
  {
    title: "SPV & JV Structures",
    desc: "Where entity boundaries and VAT groups are managed.",
    logos: [
      {
        name: "Entity register",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58c832e169e2332b33b6_entity.png",
      },
      {
        name: "VAT group map",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59e11cc6deef8bc075fa_va.png",
      },
      {
        name: "Grace-period logic",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58dacd3f0f0be94be6aa_grace.png",
      },
      {
        name: "JV boundary rules",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5914157e0c9deee2ceb0_jv.png",
      },
    ],
  },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div class="flex flex-col gap-12">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-left text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        We speak the language of your existing systems.
      </h2>

      <div
        class="grid grid-cols-1 lg:grid-cols-3 rounded-xl border border-neutral-200 divide-y divide-neutral-200 lg:divide-y-0 lg:divide-x"
      >
        {
          categories.map((cat) => (
            <div class="flex flex-col gap-12 p-6">
              <div class="flex flex-col gap-2">
                <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                  {cat.title}
                </p>
                <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                  {cat.desc}
                </p>
              </div>
              <div class="flex flex-wrap gap-2">
                {cat.logos.map((logo) => (
                  <span class="inline-flex items-center gap-x-3 gap-y-2 rounded-lg border border-neutral-200 px-3 py-1.5">
                    {logo.src ? (
                      <img
                        src={logo.src}
                        alt=""
                        class="max-h-6 w-full object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span
                        class="h-6 w-6 shrink-0 rounded-md bg-neutral-200"
                        aria-hidden="true"
                      />
                    )}
                    <span class="font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] whitespace-nowrap">
                      {logo.name}
                    </span>
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
