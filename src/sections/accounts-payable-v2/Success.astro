---
interface Card {
    value: string;
    accent: string;
    desc: string;
}

const cards: Card[] = [
    {
        value: "1,200",
        accent: "Vendors",
        desc: "Scored each one on various parameters. Identified risks & potential savings",
    },
    {
        value: "$600M",
        accent: "transactions",
        desc: "$600M transactions analysed and identified potential margin risks",
    },
    {
        value: "10,000+",
        accent: "Invoices/month",
        desc: "Looks at every invoice for incorrect vendor master and rate card differences. Flags for review, and acts on it, once a human signs-off.",
    },
    {
        value: "400",
        accent: "deliveries/day",
        desc: "Clarity AI scans everyone of them, identifies incorrect documentation, and chases people for corrections",
    },
];
---

<section class="bg-generic-00 py-16 md:py-20">
    <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-12 items-stretch">
            <!-- Left Column: Title, Description & Dot Matrix (col-span 4) -->
            <div class="lg:col-span-4 flex flex-col justify-between h-full">
                <div>
                    <h2 class="text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-vault-navy max-w-[360px] mb-4 md:mb-6 font-heading tracking-tight m-0">
                        The Trident Success
                        <br class="hidden sm:inline" /> Story
                    </h2>
                    <p class="text-neutral-500 font-normal text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] font-body max-w-[380px]">
                        Outcomes delivery by Clarity AI Accounts Payable in
                        Trident Group. A $2B global textile manufacturer.
                    </p>
                </div>

                <!-- Blue Dot Matrix (75 dots: 8, 16, 17, 17, 17 across 5 rows, 26px pitch matching Covered.astro) -->
                <div class="hidden lg:flex flex-col gap-3.5 select-none mt-auto pt-6">
                    <svg
                        width="420"
                        height="108"
                        viewBox="0 0 420 108"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        class="text-nova-blue text-[#5446FF] max-w-full h-auto select-none"
                    >
                        {/* Row 1 (8 dots) */}
                        <circle cx="2" cy="2" r="2" fill="currentColor" />
                        <circle cx="28" cy="2" r="2" fill="currentColor" />
                        <circle cx="54" cy="2" r="2" fill="currentColor" />
                        <circle cx="80" cy="2" r="2" fill="currentColor" />
                        <circle cx="106" cy="2" r="2" fill="currentColor" />
                        <circle cx="132" cy="2" r="2" fill="currentColor" />
                        <circle cx="158" cy="2" r="2" fill="currentColor" />
                        <circle cx="184" cy="2" r="2" fill="currentColor" />
                        {/* Row 2 (16 dots) */}
                        <circle cx="2" cy="28" r="2" fill="currentColor" />
                        <circle cx="28" cy="28" r="2" fill="currentColor" />
                        <circle cx="54" cy="28" r="2" fill="currentColor" />
                        <circle cx="80" cy="28" r="2" fill="currentColor" />
                        <circle cx="106" cy="28" r="2" fill="currentColor" />
                        <circle cx="132" cy="28" r="2" fill="currentColor" />
                        <circle cx="158" cy="28" r="2" fill="currentColor" />
                        <circle cx="184" cy="28" r="2" fill="currentColor" />
                        <circle cx="210" cy="28" r="2" fill="currentColor" />
                        <circle cx="236" cy="28" r="2" fill="currentColor" />
                        <circle cx="262" cy="28" r="2" fill="currentColor" />
                        <circle cx="288" cy="28" r="2" fill="currentColor" />
                        <circle cx="314" cy="28" r="2" fill="currentColor" />
                        <circle cx="340" cy="28" r="2" fill="currentColor" />
                        <circle cx="366" cy="28" r="2" fill="currentColor" />
                        <circle cx="392" cy="28" r="2" fill="currentColor" />
                        {/* Row 3 (17 dots) */}
                        <circle cx="2" cy="54" r="2" fill="currentColor" />
                        <circle cx="28" cy="54" r="2" fill="currentColor" />
                        <circle cx="54" cy="54" r="2" fill="currentColor" />
                        <circle cx="80" cy="54" r="2" fill="currentColor" />
                        <circle cx="106" cy="54" r="2" fill="currentColor" />
                        <circle cx="132" cy="54" r="2" fill="currentColor" />
                        <circle cx="158" cy="54" r="2" fill="currentColor" />
                        <circle cx="184" cy="54" r="2" fill="currentColor" />
                        <circle cx="210" cy="54" r="2" fill="currentColor" />
                        <circle cx="236" cy="54" r="2" fill="currentColor" />
                        <circle cx="262" cy="54" r="2" fill="currentColor" />
                        <circle cx="288" cy="54" r="2" fill="currentColor" />
                        <circle cx="314" cy="54" r="2" fill="currentColor" />
                        <circle cx="340" cy="54" r="2" fill="currentColor" />
                        <circle cx="366" cy="54" r="2" fill="currentColor" />
                        <circle cx="392" cy="54" r="2" fill="currentColor" />
                        <circle cx="418" cy="54" r="2" fill="currentColor" />
                        {/* Row 4 (17 dots) */}
                        <circle cx="2" cy="80" r="2" fill="currentColor" />
                        <circle cx="28" cy="80" r="2" fill="currentColor" />
                        <circle cx="54" cy="80" r="2" fill="currentColor" />
                        <circle cx="80" cy="80" r="2" fill="currentColor" />
                        <circle cx="106" cy="80" r="2" fill="currentColor" />
                        <circle cx="132" cy="80" r="2" fill="currentColor" />
                        <circle cx="158" cy="80" r="2" fill="currentColor" />
                        <circle cx="184" cy="80" r="2" fill="currentColor" />
                        <circle cx="210" cy="80" r="2" fill="currentColor" />
                        <circle cx="236" cy="80" r="2" fill="currentColor" />
                        <circle cx="262" cy="80" r="2" fill="currentColor" />
                        <circle cx="288" cy="80" r="2" fill="currentColor" />
                        <circle cx="314" cy="80" r="2" fill="currentColor" />
                        <circle cx="340" cy="80" r="2" fill="currentColor" />
                        <circle cx="366" cy="80" r="2" fill="currentColor" />
                        <circle cx="392" cy="80" r="2" fill="currentColor" />
                        <circle cx="418" cy="80" r="2" fill="currentColor" />
                        {/* Row 5 (17 dots) */}
                        <circle cx="2" cy="106" r="2" fill="currentColor" />
                        <circle cx="28" cy="106" r="2" fill="currentColor" />
                        <circle cx="54" cy="106" r="2" fill="currentColor" />
                        <circle cx="80" cy="106" r="2" fill="currentColor" />
                        <circle cx="106" cy="106" r="2" fill="currentColor" />
                        <circle cx="132" cy="106" r="2" fill="currentColor" />
                        <circle cx="158" cy="106" r="2" fill="currentColor" />
                        <circle cx="184" cy="106" r="2" fill="currentColor" />
                        <circle cx="210" cy="106" r="2" fill="currentColor" />
                        <circle cx="236" cy="106" r="2" fill="currentColor" />
                        <circle cx="262" cy="106" r="2" fill="currentColor" />
                        <circle cx="288" cy="106" r="2" fill="currentColor" />
                        <circle cx="314" cy="106" r="2" fill="currentColor" />
                        <circle cx="340" cy="106" r="2" fill="currentColor" />
                        <circle cx="366" cy="106" r="2" fill="currentColor" />
                        <circle cx="392" cy="106" r="2" fill="currentColor" />
                        <circle cx="418" cy="106" r="2" fill="currentColor" />
                    </svg>
                </div>
            </div>

            <!-- Right Column: Metric Cards Grid (col-span 8) -->
            <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
                {cards.map((card) => (
                    <div class="bg-generic-00 rounded-2xl border border-neutral-200 p-5 lg:p-6 flex flex-col justify-start">
                        <div class="flex items-baseline gap-2 mb-6">
                            <span class="font-heading font-medium text-[28px] leading-normal">
                                {card.value}
                            </span>
                            <span class="font-heading font-medium text-[#5446FF] text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)]">
                                {card.accent}
                            </span>
                        </div>
                        <p class="text-neutral-500 font-body text-[length:var(--fs-body-sm)] md:text-[length:var(--fs-body)] leading-[length:var(--lh-body-sm)] md:leading-[length:var(--lh-body)] font-normal m-0">
                            {card.desc}
                        </p>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
