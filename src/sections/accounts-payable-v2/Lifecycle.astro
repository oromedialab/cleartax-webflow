---
/**
 * Accounts Payable V2 — "Invoice Lifecycle" section.
 *
 * Displays a single-column list detailing the end-to-end automated
 * invoice processing pipeline: from ingestion and agent inbox routing,
 * through specialized AP and Reviewer agents, to human-in-the-loop exception handling.
 *
 * Scroll-opacity focus effect:
 * The row nearest the vertical centre of the viewport sits at full opacity;
 * every other row rests at 50% opacity.
 */
interface Row {
    icon: string;
    label: string;
    desc: string;
}

const rows: Row[] = [
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b05836943c475e5a4f998b9_life-1.png",
        label: "Invoice Arrival and Capture",
        desc: "Supplier mail and PDFs | eInvoices from tax portals | POs and goods receipts from ERP | Replies from suppliers and approvers",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b05836ea5faddbd63413ecf_life-2.png",
        label: "Agent Inbox",
        desc: "Decides which downstream agent to invoke depending on the task. One task per invoice, mail or reply",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b0583747f9e423ab7cb8934_life-3.png",
        label: "AP Agents",
        desc: "Specific agents for Intake, Digitization, Validation, Matching, Compliance, Follow-up, Approvals, and Posting",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b05837a25a77eea6f06816b_life-4.png",
        label: "Reviewer Agents",
        desc: "Reviews the whole book every morning. Flags what is stuck, late or at risk, names an owner, and puts the AP agent back to work.",
    },
    {
        icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b05838799a360c60d4523a1_life-5.png",
        label: "Human Inbox",
        desc: "Records exceptions. Flags to a human. Human in the loop (HITL): only what needs a decision",
    },
];
---

<section class="bg-generic-00 py-16 lg:py-20" data-no-glance>
    <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6">
        <div class="text-center w-full mx-auto mb-8 md:mb-12">
            <h2 class="m-0 mb-4 font-heading text-center font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] max-w-3xl mx-auto">
                Everything you need to automate your entire invoice lifecycle
            </h2>
            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-neutral-500 font-normal mx-auto">
                From data ingestion, to your business logic, and validation
                rules - all in one place
            </p>
        </div>

        <div class="flex flex-col">
            {rows.map((row, i) => (
                <div
                    class:list={[
                        "no-glance-row flex flex-col justify-between gap-4 py-6 md:flex-row md:items-center md:gap-8",
                        i < rows.length - 1 && "border-b border-neutral-200",
                    ]}
                >
                    <div class="flex shrink-0 items-center gap-6 md:max-w-[434px] flex-1">
                        <img
                            src={row.icon}
                            width="44"
                            height="44"
                            alt=""
                            aria-hidden="true"
                            class="no-glance-icon h-[44px] w-[44px] shrink-0 object-contain"
                        />
                        <span class="font-heading text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] font-medium text-vault-navy">
                            {row.label}
                        </span>
                    </div>
                    <p class="m-0 font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500 md:flex-1 max-w-[640px]">
                        {row.desc}
                    </p>
                </div>
            ))}
        </div>
    </div>
</section>

<style is:global>
    /* Rows start dimmed; the row nearest the viewport's vertical centre is
       promoted to full opacity by the script below. */
    .no-glance-row {
        opacity: 0.5;
        transition:
            opacity 0.35s ease-in-out,
            transform 0.35s ease-in-out;
    }

    .no-glance-row.is-centered {
        opacity: 1;
    }

    .no-glance-row.is-scaled {
        transform: scale(1.02);
    }

    .no-glance-icon {
        transition: transform 0.35s ease-in-out;
    }

    .no-glance-row.is-scaled .no-glance-icon {
        transform: scale(1.1);
    }
</style>

<script is:inline>
    (function () {
        const root = document.querySelector("[data-no-glance]");
        if (!root) return;
        const rows = Array.from(root.querySelectorAll(".no-glance-row"));
        if (!rows.length) return;

        if (
            !("IntersectionObserver" in window) ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
            // No observer, or motion is unwelcome: every row full opacity rather
            // than the whole list sitting dimmed with nothing to light it.
            rows.forEach((el) => el.classList.add("is-centered"));
            return;
        }

        // A thin 1% band pinned across the middle of the viewport — "centred"
        // means the row the centre line is actually inside. The observer only
        // fires on a crossing, so a wide band could let the nearest row change
        // with nothing to trigger a recompute; kept thin, every change of row IS
        // a crossing. `inBand` holds the running set because two rows can
        // straddle the line for a frame; pick() resolves that by distance.
        let centred = null;
        const inBand = new Set();

        const pick = () => {
            // Nothing in the band means the middle has landed in a gap between
            // rows — hold the last choice instead of clearing, so the focus never
            // blinks off between rows.
            if (!inBand.size) return;

            const middle = window.innerHeight / 2;
            let best = null;
            let bestDistance = Infinity;

            inBand.forEach((el) => {
                const r = el.getBoundingClientRect();
                const distance = Math.abs((r.top + r.bottom) / 2 - middle);
                if (distance < bestDistance) {
                    bestDistance = distance;
                    best = el;
                }
            });

            if (!best || best === centred) return;
            if (centred) {
                centred.classList.remove("is-centered", "is-scaled");
            }
            centred = best;
            centred.classList.add("is-centered", "is-scaled");
        };

        const centreObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) inBand.add(entry.target);
                    else inBand.delete(entry.target);
                });
                pick();
            },
            { rootMargin: "-49.5% 0px -49.5% 0px", threshold: 0 },
        );

        rows.forEach((el) => centreObserver.observe(el));
    })();
</script>
