---
const asideMenu = [
    { label: "At Scale" },
    { label: "Data Corrections" },
    { label: "Duplicates" },
    { label: "Reconciles" },
    { label: "Chasing People" },
    { label: "Answering Auditors" },
    { label: "Vendor Scores" },
    { label: "Insights" },
];

const cardsData = [
    {
        title: "Missing Invoice ",
        description:
            "An invoice has been sitting on the tax portal for two weeks, but no one in AP has the PDF. Clarity Al notices, checks who approved this vendor last time, and sends her a short mail asking for it.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac5d629abcf60c8b3d93bdf_stack-1.png",
    },
    {
        title: "Data Corrections",
        description:
            "Tax ID Mismatch between vendor master and invoice. Clarity Al checks the vendor tax ID, their legal name, their elnvoice filings and verifies corresponding bank account. Then it asks for human intervention.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf4d935aafccbb94694c57_stack-2.png",
    },
    {
        title: "Duplicates",
        description:
            "An invoice already booked in a different format or another one that shows a different bank account. Clarity Al puts both on hold before anyone approves them. Only a person can release the hold.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf4d9a449837928a7fd38f_stack-3.png",
    },
    {
        title: "Reconciles",
        description:
            "Your supplier sends a month of bills in one mail. Clarity Al splits them into 30 invoices, matches every line to a sales order and the rate card, and writes one mail back that lists every difference.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ac5d6418e911f572153792e_stack-4.png",
    },
    {
        title: "Chasing People",
        description:
            "Whether it's an invoice waiting for approval or incorrect tax rate by a vendor. Clarity Al chases people, schedules follow-ups, and even escalates when needed",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf4d9de751c5e6966773a9_stack-5.png",
    },
    {
        title: "Answering Auditors",
        description:
            "Clarity Al pulls up a fully recorded trail of reasons and actions for any auditor query. You can review it and share with auditors directly.",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf4d9de751c5e6966773a9_stack-5.png",
    },
    {
        title: "Vendor Scores",
        description:
            "Clarity Al evaluates every transaction with every vendor and scores vendors basis their compliance, quality and delivery history. So you can make better procurement decisions",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf4d9de751c5e6966773a9_stack-5.png",
    },
    {
        title: "Insights",
        description:
            "Ask questions about your invoices and Clarity Al will surface insights that will improve the speed and quality of your decision making",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf4d9de751c5e6966773a9_stack-5.png",
    },
];
---

<section class="sc-invoice-stack-section py-12 md:py-16 bg-generic-00">
    <div class="max-w-[var(--container-max)] mx-auto w-full px-4 md:px-6">
        <!-- Section Header (Scrolls away naturally) -->
        <div
            id="sc-invoice-header-text"
            class="text-center w-full mx-auto mb-8 md:mb-12 bg-generic-00"
        >
            <h2 class="font-heading font-medium text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] text-text-default max-w-150 mx-auto m-0 mb-3">
                You make the decisions. Clarity AI does the manual work
            </h2>
            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-neutral-500 max-w-140 font-normal mx-auto">
                Common AP use-cases, on actual product screens
            </p>
        </div>

        <!-- Main Stack Layout Grid -->
        <div class="relative max-w-[1280px] mx-auto w-full flex flex-col lg:flex-row gap-6 lg:gap-8 xl:gap-10 items-start">
            <!-- Aside Menu (Sticky Left Sidebar: hidden on iPad/mobile < 1024px, shown on laptop/desktop >= 1024px) -->
            <div
                id="sc-aside-menu"
                class="hidden lg:flex flex-col gap-3 w-40 xl:w-48 shrink-0 sticky z-30 pt-2 pointer-events-auto will-change-transform"
                style="top: calc(var(--nav-clear, 112px) + 8px);"
            >
                {asideMenu.map((item, btnIdx) => (
                    <button
                        type="button"
                        class={`sc-aside-menu-item text-left border-l-2 pl-3.5 py-0.5 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-body transition-colors duration-200 cursor-pointer bg-transparent border-t-0 border-r-0 border-b-0 outline-none ${
                            btnIdx === 0
                                ? "active-aside border-[#655DFF] text-text-default font-medium"
                                : "border-transparent text-text-default/28 font-normal"
                        }`}
                        data-card-index={btnIdx}
                    >
                        {item.label}
                    </button>
                ))}
            </div>

            <!-- Cards Stack (Right Column) -->
            <div
                id="sc-invoice-stack-container"
                class="invoice-stack flex-1 w-full flex flex-col gap-[30vh] md:gap-[50vh]"
            >
                {cardsData.map((card, index) => (
                    <div
                        class="invoice-stack-sticky sticky"
                        style={`top: calc(var(--nav-clear, 112px) + ${index * 16}px); z-index: ${index};`}
                    >
                        <div
                            class="invoice-stack-card w-full border-2 border-neutral-300 rounded-xl overflow-hidden min-h-[372px] md:min-h-0 md:h-[400px] bg-generic-00 will-change-transform flex flex-col md:flex-row md:justify-between"
                            style="transform-origin: top center;"
                        >
                            <div class="flex-1 p-5 sm:p-6 flex flex-col justify-between items-start self-stretch">
                                <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] text-text-default max-w-98 font-medium m-0">
                                    {card.title}
                                </h3>
                                <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] font-normal max-w-98 m-0 mt-6 md:mt-0">
                                    {card.description}
                                </p>
                            </div>
                            <div
                                class="sc-card-img-wrap w-full md:w-auto p-5 sm:p-6 flex items-center justify-center md:justify-end shrink-0 self-stretch"
                                style="margin-left: auto; justify-content: flex-end;"
                            >
                                <!-- Placeholder Container (580x320) -->
                                <div class="flex items-center justify-center w-full max-w-[580px] md:w-[580px] h-[320px] rounded-2xl overflow-hidden bg-visual-placeholder shrink-0">
                                    <div class="flex flex-col items-center">
                                        <img
                                            src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6b0583211a1c2a7eb987cacd_play.png"
                                            alt="play"
                                            class="w-12 shrink-0"
                                        />
                                        <p class="mt-8 text-text-default text-center text-2xl font-light">
                                            Product Animation Placeholder
                                        </p>
                                    </div>
                                </div>

                                <!-- Video / Walkthrough Container (580x320) -->
                                <!-- <div class="w-full max-w-[580px] md:w-[580px] h-[320px] rounded-2xl overflow-hidden shadow-md shrink-0">
                                    <iframe
                                        src="https://drive.google.com/file/d/17HJ42gsGgOqytm7Ce_566SXAz-5e7iqf/preview"
                                        title="Clear Compliance product tour"
                                        class="w-full h-full border-0"
                                        width="580"
                                        height="320"
                                        allow="autoplay"
                                        allowfullscreen
                                        loading="lazy"
                                    ></iframe>
                                </div> -->
                            </div>
                        </div>
                    </div>
                ))}

                <!-- Gap after the stack finishes -->
                <div style="height: 80px;"></div>
            </div>
        </div>
    </div>
</section>

<style is:global>
    @media (min-width: 768px) {
        .invoice-stack-card {
            height: 400px !important;
        }
        .sc-card-img-wrap {
            margin-left: auto !important;
            justify-content: flex-end !important;
            align-self: stretch !important;
            height: 100% !important;
            padding-top: 1.75rem !important;
        }
        .sc-card-img {
            margin-left: auto !important;
            object-position: right center !important;
            object-fit: contain !important;
            height: 100% !important;
            max-height: 350px !important;
            max-width: 100% !important;
            width: auto !important;
            display: block !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .invoice-stack {
            gap: 2rem !important;
        }
        .invoice-stack-sticky {
            position: static !important;
        }
        .invoice-stack-card {
            transform: none !important;
            height: auto !important;
        }
    }

    @media (max-height: 800px) and (min-width: 768px) {
        .sc-invoice-stack-section {
            padding-top: 1.5rem !important;
            padding-bottom: 1.5rem !important;
        }
        .invoice-stack-card {
            height: 400px !important;
        }
        .invoice-stack-card h3 {
            font-size: clamp(1.25rem, 2.2vh, 1.75rem) !important;
            line-height: 1.25 !important;
        }
        .invoice-stack-card p {
            font-size: clamp(0.875rem, 1.7vh, 1rem) !important;
            line-height: 1.35 !important;
        }
        .invoice-stack-card .grid {
            gap: 0.5rem !important;
        }
    }

    @media (max-height: 680px) and (min-width: 768px) {
        .invoice-stack-card {
            height: clamp(
                260px,
                calc(100vh - var(--nav-clear, 112px) - 100px),
                300px
            ) !important;
        }
        .sc-card-img-wrap {
            padding-top: 2rem !important;
        }
        .sc-card-img {
            object-position: right bottom !important;
        }
    }

    @media (max-height: 680px) and (min-width: 1024px) {
        .invoice-stack-card {
            height: clamp(
                300px,
                calc(100vh - var(--nav-clear, 112px) - 100px),
                350px
            ) !important;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const stack = document.getElementById("sc-invoice-stack-container");
        if (!stack) return;

        const asideMenuEl = document.getElementById("sc-aside-menu");
        const outers = Array.from(
            stack.querySelectorAll(".invoice-stack-sticky"),
        );
        const inners = Array.from(
            stack.querySelectorAll(".invoice-stack-card"),
        );

        if (!outers.length || outers.length !== inners.length) return;

        const reduceMotion =
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduceMotion) return;

        const STACK_OFFSET = 16;
        const NAV_CLEAR =
            parseFloat(
                getComputedStyle(document.documentElement).getPropertyValue(
                    "--nav-clear",
                ),
            ) || 112;

        // Card 0 shrinks most (0.88), each subsequent one less; the last never shrinks (1.0).
        // Dynamically distributes across inners.length cards so every card shrinks
        // evenly behind the final card rather than stopping at or exceeding 1.0.
        const minScale = 0.88;
        const targetScaleFor = (i) =>
            minScale + (i / Math.max(1, inners.length - 1)) * (1 - minScale);

        const zoomFactor = () => {
            let z = 1;
            for (let n = stack; n && n.nodeType === 1; n = n.parentElement) {
                const v = parseFloat(getComputedStyle(n).zoom);
                if (v && v !== 1) z *= v;
            }
            return z;
        };

        let zoom = zoomFactor();
        let outersStickyTop = [];
        let lastActiveIdx = -1;
        let lastNavClear = 0;
        let lastNavBottomMeasured = -1;
        const sidebarBtns = Array.from(
            document.querySelectorAll(".sc-aside-menu-item"),
        );

        const setTops = () => {
            zoom = zoomFactor();

            // Dynamically measure the bottom of the fixed navbar / top announcement banner
            const navEl =
                document.querySelector("[data-nav-card]") ||
                document.querySelector("[data-giwip-nav-root]") ||
                document.querySelector("nav") ||
                document.querySelector(".nav-wrap");

            const bannerEl =
                document.querySelector("[class*='banner']") ||
                document.querySelector("[id*='banner']") ||
                document.querySelector("[class*='announcement']") ||
                document.querySelector("[id*='announcement']") ||
                document.querySelector("[data-banner]");

            let navBottom = 0;
            if (navEl) {
                navBottom = Math.max(
                    navBottom,
                    navEl.getBoundingClientRect().bottom / zoom,
                );
            }
            if (bannerEl) {
                navBottom = Math.max(
                    navBottom,
                    bannerEl.getBoundingClientRect().bottom / zoom,
                );
            }

            let effectiveNavClear = NAV_CLEAR;
            if (navBottom > 0) {
                // Keep at least 28px breathing clearance below the navbar
                effectiveNavClear = Math.max(
                    NAV_CLEAR,
                    Math.round(navBottom + 28),
                );
            }

            // Update root --nav-clear so that CSS card height clamps and fallback styling adapt
            if (Math.abs(effectiveNavClear - lastNavClear) >= 1) {
                lastNavClear = effectiveNavClear;
                document.documentElement.style.setProperty(
                    "--nav-clear",
                    `${effectiveNavClear}px`,
                );
            }

            // Measure static height of card without mutating transform (eliminates layout thrashing)
            const cardHeight = inners[0] ? inners[0].offsetHeight / zoom : 380;
            let firstTop = effectiveNavClear;

            if (window.innerWidth >= 768) {
                const totalStackHeight =
                    cardHeight + (outers.length - 1) * STACK_OFFSET;
                const viewportCss = window.innerHeight / zoom;
                firstTop = Math.max(
                    effectiveNavClear,
                    (viewportCss - totalStackHeight) / 2,
                );
            }

            for (let i = 0; i < outers.length; i++) {
                outers[i].style.top = firstTop + i * STACK_OFFSET + "px";
            }

            outersStickyTop = outers.map(
                (el) => (parseFloat(el.style.top) || effectiveNavClear) * zoom,
            );

            if (asideMenuEl) {
                const asideTopOffset = 8;
                asideMenuEl.style.top = firstTop + asideTopOffset + "px";
                asideMenuEl.style.minHeight = "";
            }
        };

        let ticking = false;

        const update = () => {
            const tops = outers.map((el) => el.getBoundingClientRect().top);
            const revealDistance = Math.max(
                260,
                (window.innerHeight / zoom) * 0.45,
            );

            let activeIdx = 0;
            inners.forEach((inner, i) => {
                if (i === inners.length - 1) {
                    inner.style.transform = "scale(1) translateZ(0)";
                    return;
                }

                const nextStickyTopPx =
                    outersStickyTop[i + 1] ||
                    (NAV_CLEAR + (i + 1) * STACK_OFFSET) * zoom;
                const distanceToStick = tops[i + 1] - nextStickyTopPx;

                const progress = Math.min(
                    1,
                    Math.max(0, 1 - distanceToStick / revealDistance),
                );
                const scale = 1 - progress * (1 - targetScaleFor(i));
                inner.style.transform = `scale(${scale.toFixed(4)}) translateZ(0)`;
            });

            for (let i = 0; i < tops.length; i++) {
                const stickyTop = outersStickyTop[i] || NAV_CLEAR * zoom;
                if (tops[i] <= stickyTop + 60) {
                    activeIdx = i;
                }
            }

            if (activeIdx !== lastActiveIdx) {
                lastActiveIdx = activeIdx;
                sidebarBtns.forEach((btn, idx) => {
                    if (idx === activeIdx) {
                        btn.classList.add(
                            "border-[#655DFF]",
                            "text-text-default",
                            "font-medium",
                        );
                        btn.classList.remove(
                            "border-transparent",
                            "text-text-default/28",
                            "font-normal",
                        );
                    } else {
                        btn.classList.remove(
                            "border-[#655DFF]",
                            "text-text-default",
                            "font-medium",
                        );
                        btn.classList.add(
                            "border-transparent",
                            "text-text-default/28",
                            "font-normal",
                        );
                    }
                });
            }

            // Synchronize aside menu with the closing card stack on exit
            if (asideMenuEl && outers.length > 0) {
                const lastIdx = outers.length - 1;
                const lastOuterTop = tops[lastIdx];
                const lastStickyTop = outersStickyTop[lastIdx] || 0;
                const exitDiff = lastOuterTop - lastStickyTop;

                if (exitDiff < -1) {
                    const translateY = exitDiff / zoom;
                    asideMenuEl.style.transform = `translate3d(0, ${translateY.toFixed(2)}px, 0)`;
                } else {
                    asideMenuEl.style.transform = "";
                }
            }

            ticking = false;
        };

        const getUnstuckTop = (el) => {
            let top = 0;
            let curr = el;
            while (curr) {
                top += curr.offsetTop;
                curr = curr.offsetParent;
            }
            return top;
        };

        const getCardTargetY = (index) => {
            const stickyTopPx =
                (parseFloat(outers[index].style.top) || NAV_CLEAR) * zoom;
            return getUnstuckTop(outers[index]) - stickyTopPx;
        };

        sidebarBtns.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.preventDefault();
                const index = parseInt(
                    btn.getAttribute("data-card-index") || "0",
                    10,
                );
                if (outers[index]) {
                    const targetY = getCardTargetY(index);
                    window.scrollTo({ top: targetY, behavior: "smooth" });
                }
            });
        });

        const onScroll = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
        };

        const handleLayoutShift = () => {
            setTops();
            update();
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", handleLayoutShift);
        window.addEventListener("load", handleLayoutShift, { once: true });

        const navElToObserve =
            document.querySelector("[data-nav-card]") ||
            document.querySelector("[data-giwip-nav-root]") ||
            document.querySelector("nav") ||
            document.querySelector(".nav-wrap");
        if (navElToObserve && typeof ResizeObserver !== "undefined") {
            new ResizeObserver(() => {
                const bottom = navElToObserve.getBoundingClientRect().bottom;
                if (Math.abs(bottom - lastNavBottomMeasured) >= 1) {
                    lastNavBottomMeasured = bottom;
                    handleLayoutShift();
                }
            }).observe(navElToObserve);
        }

        const bannerElToObserve =
            document.querySelector("[class*='banner']") ||
            document.querySelector("[id*='banner']") ||
            document.querySelector("[class*='announcement']") ||
            document.querySelector("[id*='announcement']") ||
            document.querySelector("[data-banner]");
        if (bannerElToObserve && typeof ResizeObserver !== "undefined") {
            new ResizeObserver(() => {
                handleLayoutShift();
            }).observe(bannerElToObserve);
        }

        if (typeof MutationObserver !== "undefined") {
            const bodyObserver = new MutationObserver(() => {
                handleLayoutShift();
            });
            bodyObserver.observe(document.body, {
                childList: true,
                subtree: false,
            });
        }

        setTimeout(handleLayoutShift, 100);
        setTimeout(handleLayoutShift, 300);
        setTimeout(handleLayoutShift, 1000);

        setTops();
        update();
    });
</script>
