---
/**
 * Accounts Payable V2 — "IT Landscape" section.
 *
 * Demonstrates Clarity AI running on existing enterprise data and IT architecture:
 * 1. Processes: Vendor Onboarding, AP, e-Invoicing, Compliance
 * 2. Where you work: Clarity AI, Copilot, Cowork, Codex, Email, Slack
 * 3. Control plane: Observe, Govern, Approve, Audit trail
 * 4. Finance data context: Business meaning, Methods & conventions, Data maps, Decision traces
 * 5. Your systems: ERP & POS, Data Lakes, Ecosystem Data, Docs & Email
 */
---

<section class="bg-generic-00 py-16 md:py-20 lg:py-24">
    <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
        <!-- Section Header -->
        <div class="text-center w-full mx-auto mb-8 md:mb-12">
            <h2 class="m-0 font-heading text-center font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-tight mx-auto">
                Clarity AI: Runs on your data and your IT Landscape
            </h2>
        </div>

        <!-- Main Outer Architecture Card -->
        <div class="bg-generic-00 rounded-2xl md:rounded-3xl border border-neutral-200/90 p-4 lg:p-6 flex flex-col gap-4">
            <!-- 1. Processes -->
            <div class="flex flex-col">
                <span class="font-heading font-semibold text-vault-navy text-lg mb-3">
                    Processes
                </span>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3 md:gap-4">
                    <div class="bg-generic-00 rounded-xl border border-neutral-200 py-5.5 px-4 text-base font-medium text-[#374151]">
                        Vendor Onboarding and Scoring
                    </div>
                    <div class="bg-generic-00 rounded-xl border border-neutral-200 py-5.5 px-4 text-base font-medium text-[#374151]">
                        Accounts Payable
                    </div>
                    <div class="bg-generic-00 rounded-xl border border-neutral-200 py-5.5 px-4 text-base font-medium text-[#374151]">
                        e-Invoicing and Reporting
                    </div>
                    <div class="bg-generic-00 rounded-xl border border-neutral-200 py-5.5 px-4 text-base font-medium text-[#374151]">
                        Compliance and Audit
                    </div>
                </div>
            </div>

            <!-- 2. Where you work -->
            <div class="rounded-xl border border-[#E5E7EB] p-5 md:p-6 bg-[#F9FAFB] flex flex-col justify-between">
                <span class="font-heading font-semibold text-vault-navy text-lg mb-4">
                    Where you work
                </span>
                <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
                    <span class="bg-generic-00 rounded-lg border border-[#DCDEE2] py-2 px-3 text-base font-medium text-[#374151]">
                        Clarity AI
                    </span>
                    <span class="bg-generic-00 rounded-lg border border-[#DCDEE2] py-2 px-3 text-base font-medium text-[#374151]">
                        Copilot
                    </span>
                    <span class="bg-generic-00 rounded-lg border border-[#DCDEE2] py-2 px-3 text-base font-medium text-[#374151]">
                        Cowork
                    </span>
                    <span class="bg-generic-00 rounded-lg border border-[#DCDEE2] py-2 px-3 text-base font-medium text-[#374151]">
                        Codex
                    </span>
                    <span class="bg-generic-00 rounded-lg border border-[#DCDEE2] py-2 px-3 text-base font-medium text-[#374151]">
                        Email
                    </span>
                    <span class="bg-generic-00 rounded-lg border border-[#DCDEE2] py-2 px-3 text-base font-medium text-[#374151]">
                        Slack
                    </span>
                </div>
                <p class="text-neutral-500 font-body text-sm leading-normal font-medium mt-4 mb-0">
                    Works with your existing subscriptions and tokens
                </p>
            </div>

            <!-- 3. Control plane -->
            <div class="rounded-xl p-5 md:p-6 bg-[#5446FF] text-white flex flex-col justify-between">
                <span class="font-heading font-semibold text-white text-lg mb-4">
                    Control plane
                </span>
                <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
                    <span class="bg-generic-00 rounded-lg py-2.5 px-3.75 text-base font-medium text-[#5446FF]">
                        Observe
                    </span>
                    <span class="bg-generic-00 rounded-lg py-2.5 px-3.75 text-base font-medium text-[#5446FF]">
                        Govern
                    </span>
                    <span class="bg-generic-00 rounded-lg py-2.5 px-3.75 text-base font-medium text-[#5446FF]">
                        Approve
                    </span>
                    <span class="bg-generic-00 rounded-lg py-2.5 px-3.75 text-base font-medium text-[#5446FF]">
                        Audit trail
                    </span>
                </div>
            </div>

            <!-- 4. Finance data context -->
            <div class="rounded-xl p-5 md:p-6 bg-text-default text-white flex flex-col justify-between">
                <span class="font-heading font-semibold text-white text-lg mb-4">
                    Finance data context
                </span>
                <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
                    <span class="bg-generic-00 rounded-lg py-2.5 px-3.75 text-base font-medium text-text-default">
                        Business meaning
                    </span>
                    <span class="bg-generic-00 rounded-lg py-2.5 px-3.75 text-base font-medium text-text-default">
                        Methods & conventions
                    </span>
                    <span class="bg-generic-00 rounded-lg py-2.5 px-3.75 text-base font-medium text-text-default">
                        Data maps
                    </span>
                    <span class="bg-generic-00 rounded-lg py-2.5 px-3.75 text-base font-medium text-text-default">
                        Decision traces
                    </span>
                </div>
                <p class="text-[#E6ECFF] font-body text-sm leading-normal font-medium mt-4 mb-0">
                    Built by FDEs and system experts
                </p>
            </div>

            <!-- 5. Your systems -->
            <div class="rounded-xl border border-[#E5E7EB] p-5 md:p-6 bg-generic-00 flex flex-col justify-between">
                <span class="font-heading font-semibold text-vault-navy text-lg mb-4">
                    Your systems
                </span>

                <div class="flex flex-col lg:flex-row items-start justify-between gap-6 lg:gap-8">
                    <!-- ERP & POS -->
                    <div class="flex flex-col gap-2 w-full lg:w-auto">
                        <span class="text-xs font-semibold tracking-[1px] text-neutral-400 uppercase font-sans">
                            ERP & POS
                        </span>
                        <div class="flex flex-wrap gap-2 max-w-[340px]">
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                SAP
                            </span>
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                Oracle
                            </span>
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                D365
                            </span>
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                POS
                            </span>
                        </div>
                        <div class="flex flex-wrap gap-2 mt-0.5">
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                Master data
                            </span>
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                Z-tables
                            </span>
                        </div>
                    </div>

                    <!-- DATA LAKES -->
                    <div class="flex flex-col gap-2 w-full lg:w-auto">
                        <span class="text-[11px] font-semibold tracking-wider text-neutral-400 uppercase font-mono">
                            DATA LAKES
                        </span>
                        <div class="flex flex-row lg:flex-col gap-2">
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                Snowflake
                            </span>
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                Databricks
                            </span>
                        </div>
                    </div>

                    <!-- ECOSYSTEM DATA -->
                    <div class="flex flex-col gap-2 w-full lg:w-auto">
                        <span class="text-[11px] font-semibold tracking-wider text-neutral-400 uppercase font-mono">
                            ECOSYSTEM DATA
                        </span>
                        <div class="flex flex-col gap-2">
                            <div class="flex flex-wrap gap-2">
                                <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                    Govt systems
                                </span>
                                <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                    Banking & payments
                                </span>
                            </div>
                            <div class="flex">
                                <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                    Identity APIs
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- DOCS & EMAIL -->
                    <div class="flex flex-col gap-2 w-full lg:w-auto">
                        <span class="text-[11px] font-semibold tracking-wider text-neutral-400 uppercase font-mono">
                            DOCS & EMAIL
                        </span>
                        <div class="flex flex-wrap gap-2 max-w-[340px]">
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                Excel
                            </span>
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                Statements
                            </span>
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                Contracts
                            </span>
                            <span class="bg-[#F3F4F6] rounded-lg py-2.5 px-3.75 text-sm font-medium text-[#374151]">
                                Shipping bills
                            </span>
                        </div>
                    </div>
                </div>

                <p class="text-neutral-500 font-body text-sm leading-normal font-medium mt-4 mb-0">
                    Your data lakes and your systems, not a parallel stack
                </p>
            </div>
        </div>
    </div>
</section>
