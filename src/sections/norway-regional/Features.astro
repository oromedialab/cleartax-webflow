---
/**
 * "Build your Norway e-invoicing solution for 2027 and 2030." — Figma node
 * 17103:85017 ("Fold 9").
 *
 * A 2-column grid of 5 feature cards, the last spanning both columns. Each
 * card is an accordion that expands inline to reveal an image placeholder
 * and body text. First 4 cards sit in a 2×2 grid at equal size; the 5th
 * card spans both columns at full width.
 *
 * All cards are collapsed by default. Clicking a card toggles it open/closed.
 * The plus icon rotates to a minus when open.
 *
 * Ids are `no-features-` prefixed: embeds share one namespace per page.
 */
interface Feature {
  title: string;
  body: string;
  image: string;
  span2?: boolean;
}

const features: Feature[] = [
  {
    title: "Seamless ERP & POS Integration",
    body: "Connect any ERP or POS system in only a few days. You keep your existing stack; ClearTax handles the compliance layer on top.",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae9865ef1894de3a776ffcf_feature-1.png",
  },
  {
    title: "Real-Time Error Alerts & Unified Dashboards",
    body: "Catch a malformed invoice before it becomes a rejected one. Every business team - finance, IT, AP, AR - works off the same status view.",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae9866c0a73c6b53bde2d50_feature-2.png",
  },
  {
    title: "Automatic ELMA & Peppol Directory Checks",
    body: "Know before you send whether your buyer can legally receive an EHF invoice, instead of finding out from a bounced delivery.",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae98675d702368c975e5d65_feature-3.png",
  },
  {
    title: "Smart Error Correction & VAT Reconciliation",
    body: "Stay ahead of government notices with built-in error correction and VAT reconciliation, reducing the manual chase before it starts.",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae9867c0a0b6b2d26791706_feature-4.png",
  },
  {
    title: "One-Time Integration, Ongoing Compliance",
    body: "As Norway's rules evolve – 2027 issuance, 2030 reception, SAF-T updates; ClearTax absorbs the change. Your integration doesn't need to.",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae9868493d429752b796da0_feature-5.png",
    span2: true,
  },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6">
    <div
      class="mx-auto mb-8 flex flex-col items-center gap-4 text-center lg:mb-12"
    >
      <h2
        class="m-0 max-w-[620px] font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        Build your Norway e-invoicing solution for 2027 and 2030.
      </h2>
      <p
        class="m-0 max-w-[1020px] font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500"
      >
        ClearTax connects to your ERP, OMS, billing system, or PoS once, via
        native connectors (SAP, Oracle), strategic partnerships (Stripe,
        Shopify), or custom SFTP/API integration, and handles validation,
        transformation, and EHF 3.0 generation from there.
      </p>
    </div>

    {
      /* Two independent columns so expanding one card doesn't push the adjacent column */
    }
    <div class="flex flex-col gap-6 md:flex-row">
      {/* Left column: cards 0, 2 */}
      <div class="flex flex-1 flex-col gap-6">
        {
          features
            .filter((f) => !f.span2)
            .filter((_, idx) => idx % 2 === 0)
            .map((f) => {
              const i = features.indexOf(f);
              return (
                <div class="flex flex-col" data-no-features-card={i}>
                  <button
                    type="button"
                    class="group flex w-full cursor-pointer items-center justify-between gap-6 rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out"
                    data-no-features-toggle={i}
                  >
                    <span class="font-heading text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium text-vault-navy">
                      {f.title}
                    </span>
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="shrink-0 text-vault-navy transition-colors duration-150 ease-in-out"
                      aria-hidden="true"
                      focusable="false"
                      data-no-features-icon={i}
                    >
                      <path
                        d="M5 12H19"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M12 5V19"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        data-no-features-vertical={i}
                      />
                    </svg>
                  </button>
                  <div
                    class="grid overflow-hidden rounded-b-xl border border-t-0 border-neutral-300 bg-generic-00 transition-[grid-template-rows,opacity,border-color] duration-300 ease-in-out"
                    style="grid-template-rows: 0fr; opacity: 0; border-color: transparent;"
                    data-no-features-content={i}
                  >
                    <div class="overflow-hidden">
                      <div class="p-6 pt-0">
                        <div class="mt-4 w-full">
                          <img
                            src={f.image}
                            alt={f.title}
                            class="aspect-[574/323] w-full rounded-lg bg-visual-placeholder object-cover"
                            loading="lazy"
                          />
                        </div>
                        <p class="m-0 mt-4 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                          {f.body}
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })
        }
      </div>
      {/* Right column: cards 1, 3 */}
      <div class="flex flex-1 flex-col gap-6">
        {
          features
            .filter((f) => !f.span2)
            .filter((_, idx) => idx % 2 === 1)
            .map((f) => {
              const i = features.indexOf(f);
              return (
                <div class="flex flex-col" data-no-features-card={i}>
                  <button
                    type="button"
                    class="group flex w-full cursor-pointer items-center justify-between gap-6 rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out"
                    data-no-features-toggle={i}
                  >
                    <span class="font-heading text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium text-vault-navy">
                      {f.title}
                    </span>
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="shrink-0 text-vault-navy transition-colors duration-150 ease-in-out"
                      aria-hidden="true"
                      focusable="false"
                      data-no-features-icon={i}
                    >
                      <path
                        d="M5 12H19"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M12 5V19"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        data-no-features-vertical={i}
                      />
                    </svg>
                  </button>
                  <div
                    class="grid overflow-hidden rounded-b-xl border border-t-0 border-neutral-300 bg-generic-00 transition-[grid-template-rows,opacity,border-color] duration-300 ease-in-out"
                    style="grid-template-rows: 0fr; opacity: 0; border-color: transparent;"
                    data-no-features-content={i}
                  >
                    <div class="overflow-hidden">
                      <div class="p-6 pt-0">
                        <div class="mt-4 w-full">
                          <img
                            src={f.image}
                            alt={f.title}
                            class="aspect-[574/323] w-full rounded-lg bg-visual-placeholder object-cover"
                            loading="lazy"
                          />
                        </div>
                        <p class="m-0 mt-4 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                          {f.body}
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })
        }
      </div>
    </div>
    {/* Last card — full width */}
    {
      features
        .filter((f) => f.span2)
        .map((f) => {
          const i = features.indexOf(f);
          return (
            <div class="mt-6 flex flex-col" data-no-features-card={i}>
              <button
                type="button"
                class="group flex w-full cursor-pointer items-center justify-between gap-6 rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out"
                data-no-features-toggle={i}
              >
                <span class="font-heading text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium text-vault-navy">
                  {f.title}
                </span>
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  class="shrink-0 text-vault-navy transition-colors duration-150 ease-in-out"
                  aria-hidden="true"
                  focusable="false"
                  data-no-features-icon={i}
                >
                  <path
                    d="M5 12H19"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M12 5V19"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    data-no-features-vertical={i}
                  />
                </svg>
              </button>
              <div
                class="grid overflow-hidden rounded-b-xl border border-t-0 border-neutral-300 bg-generic-00 transition-[grid-template-rows,opacity,border-color] duration-300 ease-in-out"
                style="grid-template-rows: 0fr; opacity: 0; border-color: transparent;"
                data-no-features-content={i}
              >
                <div class="overflow-hidden">
                  <div class="p-6 pt-0">
                    <div class="mt-4 w-full">
                      <img
                        src={f.image}
                        alt={f.title}
                        class="aspect-[574/323] w-full rounded-lg bg-visual-placeholder object-cover"
                        loading="lazy"
                      />
                    </div>
                    <p class="m-0 mt-4 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                      {f.body}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          );
        })
    }
  </div>
</section>

<script is:inline>
  /* Smooth accordion toggle for feature cards. */
  (function () {
    var cards = document.querySelectorAll("[data-no-features-card]");
    if (!cards.length) return;

    function closeCard(index) {
      var content = document.querySelector(
        '[data-no-features-content="' + index + '"]',
      );
      var btn = document.querySelector(
        '[data-no-features-toggle="' + index + '"]',
      );
      var vertical = document.querySelector(
        '[data-no-features-vertical="' + index + '"]',
      );
      var icon = document.querySelector(
        '[data-no-features-icon="' + index + '"]',
      );
      if (!content || content.getAttribute("data-open") !== "true") return;
      content.style.gridTemplateRows = "0fr";
      content.style.opacity = "0";
      content.style.borderColor = "transparent";
      content.setAttribute("data-open", "false");
      btn.classList.remove("rounded-b-none", "border-b-0");
      if (vertical) vertical.style.opacity = "1";
      if (icon) icon.style.transform = "";
    }

    function closeAllExcept(exceptIndex) {
      for (var c = 0; c < cards.length; c++) {
        var idx = cards[c].getAttribute("data-no-features-card");
        if (idx !== exceptIndex) closeCard(idx);
      }
    }

    function toggle(index) {
      var content = document.querySelector(
        '[data-no-features-content="' + index + '"]',
      );
      var btn = document.querySelector(
        '[data-no-features-toggle="' + index + '"]',
      );
      var vertical = document.querySelector(
        '[data-no-features-vertical="' + index + '"]',
      );
      var icon = document.querySelector(
        '[data-no-features-icon="' + index + '"]',
      );
      if (!content || !btn) return;

      var isOpen = content.getAttribute("data-open") === "true";

      if (isOpen) {
        closeCard(index);
      } else {
        // Close any other open card first
        closeAllExcept(index);
        // Open — animate height to auto
        content.style.gridTemplateRows = "1fr";
        content.style.opacity = "1";
        content.style.borderColor = "";
        content.setAttribute("data-open", "true");
        btn.classList.add("rounded-b-none", "border-b-0");
        if (vertical) vertical.style.opacity = "0";
        if (icon) icon.style.transform = "rotate(180deg)";
      }
    }

    // Add transition to vertical bars for smooth plus-to-minus
    var verticals = document.querySelectorAll("[data-no-features-vertical]");
    for (var v = 0; v < verticals.length; v++) {
      verticals[v].style.transition = "opacity 0.3s ease-in-out";
    }

    // Add transition to icons for smooth rotation
    var icons = document.querySelectorAll("[data-no-features-icon]");
    for (var k = 0; k < icons.length; k++) {
      icons[k].style.transition = "transform 0.3s ease-in-out";
    }

    document.addEventListener("click", function (e) {
      if (!e.target.closest) return;
      var toggleBtn = e.target.closest("[data-no-features-toggle]");
      if (!toggleBtn) return;
      var index = toggleBtn.getAttribute("data-no-features-toggle");
      toggle(index);
    });
  })();
</script>
