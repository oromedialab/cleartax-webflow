---
/**
 * "Build your Norway e-invoicing solution for 2027 and 2030." — Figma node
 * 17103:85017 ("Fold 9").
 *
 * Five feature cards in a 2-column grid, the last spanning both columns.
 * Clicking a card opens a detail overlay dialog showing that card's title,
 * image and body text.
 *
 * Ids and data attributes are `no-features-` prefixed: embeds share one
 * namespace per page.
 */
interface Feature {
  title: string;
  body: string;
  image: string;
  span2?: boolean;
}

const features: Feature[] = [
  {
    title: "Seamless ERP & POS Integration",
    body: "Connect any ERP or POS system in only a few days. You keep your existing stack; ClearTax handles the compliance layer on top.",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae9865ef1894de3a776ffcf_feature-1.png",
  },
  {
    title: "Real-Time Error Alerts & Unified Dashboards",
    body: "Catch a malformed invoice before it becomes a rejected one. Every business team - finance, IT, AP, AR - works off the same status view.",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae9866c0a73c6b53bde2d50_feature-2.png",
  },
  {
    title: "Automatic ELMA & Peppol Directory Checks",
    body: "Know before you send whether your buyer can legally receive an EHF invoice, instead of finding out from a bounced delivery.",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae98675d702368c975e5d65_feature-3.png",
  },
  {
    title: "Smart Error Correction & VAT Reconciliation",
    body: "Stay ahead of government notices with built-in error correction and VAT reconciliation, reducing the manual chase before it starts.",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae9867c0a0b6b2d26791706_feature-4.png",
  },
  {
    title: "One-Time Integration, Ongoing Compliance",
    body: "As Norway's rules evolve – 2027 issuance, 2030 reception, SAF-T updates; ClearTax absorbs the change. Your integration doesn't need to.",
    image:
      "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ae9868493d429752b796da0_feature-5.png",
    span2: true,
  },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6">
    <div
      class="mx-auto mb-8 flex flex-col items-center gap-4 text-center lg:mb-12"
    >
      <h2
        class="m-0 max-w-[620px] font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        Build your Norway e-invoicing solution for 2027 and 2030.
      </h2>
      <p
        class="m-0 max-w-[1020px] font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500"
      >
        ClearTax connects to your ERP, OMS, billing system, or PoS once, via
        native connectors (SAP, Oracle), strategic partnerships (Stripe,
        Shopify), or custom SFTP/API integration, and handles validation,
        transformation, and EHF 3.0 generation from there.
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-6">
      {
        features.map((feature, i) => (
          <button
            type="button"
            class:list={[
              "group m-0 flex h-full w-full cursor-pointer items-center justify-between gap-6 rounded-xl border border-neutral-300 bg-generic-00 p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue",
              feature.span2 && "md:col-span-2",
            ]}
            aria-haspopup="dialog"
            data-no-features-open
            data-no-features-index={i}
          >
            <span class="min-w-0 flex-1 font-heading text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] font-medium text-vault-navy">
              {feature.title}
            </span>
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              class="shrink-0 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M5 12H19"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M12 5V19"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        ))
      }
    </div>
  </div>
</section>

<!-- Detail overlay. Lives outside the section's container so the scrim covers
     the viewport rather than the 1280px column. -->
<div
  id="no-features-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="no-features-overlay-title"
  aria-hidden="true"
  class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
>
  <div
    class="relative max-h-[90vh] w-full max-w-[630px] overflow-y-auto rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6"
    data-no-features-panel
  >
    <button
      type="button"
      aria-label="Close"
      class="absolute right-6 top-6 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-5 lg:top-5"
      data-no-features-close
    >
      <svg
        width="40"
        height="40"
        viewBox="0 0 40 40"
        fill="none"
        class="rotate-45"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M20 10V30"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M30 20L10 20"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="flex flex-col items-start gap-6">
      <div class="flex w-full flex-col justify-between gap-6">
        <div class="flex flex-col gap-6">
          <div id="no-features-overlay-title">
            {
              features.map((feature, i) => (
                <h3
                  class="m-0 pr-12 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px] lg:pr-0 text-balance"
                  style={i === 0 ? "display: block;" : "display: none;"}
                  hidden={i !== 0}
                  data-no-features-heading
                >
                  {feature.title}
                </h3>
              ))
            }
          </div>
        </div>

        <div
          class="aspect-[574/323] w-full max-w-[574px] overflow-hidden mx-auto"
        >
          {
            features.map((feature, i) => (
              <img
                src={feature.image}
                alt={feature.title}
                width="574"
                height="323"
                class="h-full w-full object-contain"
                style={i === 0 ? "display: block;" : "display: none;"}
                hidden={i !== 0}
                data-no-features-image
                loading="lazy"
              />
            ))
          }
        </div>

        <div class="flex flex-col gap-6">
          <div>
            {
              features.map((feature, i) => (
                <div
                  class="m-0 flex flex-col gap-3 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                  style={i === 0 ? "display: flex;" : "display: none;"}
                  hidden={i !== 0}
                  data-no-features-body
                >
                  <p class="m-0">{feature.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  [data-no-features-heading][hidden],
  [data-no-features-body][hidden],
  [data-no-features-image][hidden] {
    display: none !important;
  }
</style>

<script is:inline>
  /* Card -> detail overlay */
  (function () {
    var overlay = document.getElementById("no-features-overlay");
    if (!overlay) return;

    var panel = overlay.querySelector("[data-no-features-panel]");
    var closeBtn = overlay.querySelector("[data-no-features-close]");
    var prevBtn = overlay.querySelector("[data-no-features-prev]");
    var nextBtn = overlay.querySelector("[data-no-features-next]");
    var headings = overlay.querySelectorAll("[data-no-features-heading]");
    var bodies = overlay.querySelectorAll("[data-no-features-body]");
    var images = overlay.querySelectorAll("[data-no-features-image]");
    if (!panel || !headings.length || headings.length !== bodies.length) return;

    var count = headings.length;
    var current = 0;
    var lastFocused = null;

    function show(index) {
      current = ((index % count) + count) % count;
      for (var i = 0; i < count; i++) {
        headings[i].hidden = i !== current;
        headings[i].style.display = i === current ? "block" : "none";
        bodies[i].hidden = i !== current;
        bodies[i].style.display = i === current ? "flex" : "none";
        if (images[i]) {
          images[i].hidden = i !== current;
          images[i].style.display = i === current ? "block" : "none";
        }
      }
      panel.scrollTop = 0;
    }

    function open(index, opener) {
      lastFocused = opener || document.activeElement;
      show(index);
      overlay.style.display = "flex";
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
    }

    function close() {
      overlay.style.display = "none";
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function isOpen() {
      return overlay.style.display === "flex";
    }

    document.addEventListener("click", function (e) {
      if (!e.target.closest) return;
      var opener = e.target.closest("[data-no-features-open]");
      if (!opener) return;
      open(
        parseInt(opener.getAttribute("data-no-features-index"), 10) || 0,
        opener,
      );
    });

    if (closeBtn) closeBtn.addEventListener("click", close);
    if (prevBtn)
      prevBtn.addEventListener("click", function () {
        show(current - 1);
      });
    if (nextBtn)
      nextBtn.addEventListener("click", function () {
        show(current + 1);
      });

    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) close();
    });

    document.addEventListener("keydown", function (e) {
      if (!isOpen()) return;

      if (e.key === "Escape") {
        close();
        return;
      }

      if (e.key === "ArrowLeft") {
        show(current - 1);
        return;
      }
      if (e.key === "ArrowRight") {
        show(current + 1);
        return;
      }

      if (e.key !== "Tab") return;
      var focusable = panel.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>
