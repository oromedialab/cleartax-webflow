  number: number;
  title: string;
  bullets: string[];
}

const steps: Step[] = [
  {
    number: 1,
    title: "Confirm your bookkeeping obligation",
    bullets: [
      "Determine whether your Norwegian entity falls within the new e-invoicing requirement.",
    ],
  },
  {
    number: 2,
    title: "Check how your customers receive e-invoices",
    bullets: [
      "Check which business buyers are registered in ELMA and can receive e-invoices.",
      "Confirm each customer's reception capability; use ELMA lookup when sending through the EHF/Peppol network.",
      "Do not assume that an absent ELMA listing automatically removes a legal obligation.",
    ],
  },
  {
    number: 3,
    title: "Choose an invoice-exchange route.",
    bullets: [
      "Check the final B2B format rules before describing any one route as mandatory.",
      "If you use EHF through Peppol, confirm how your system connects to an Access Point and test delivery to recipients.",
    ],
  },
  {
    number: 4,
    title: "Prepare structured invoice data.",
    bullets: [
      "Review the information your systems need to produce for an electronic invoice suitable for automated processing.",
    ],
  },
  {
    number: 5,
    title: "Related accounting deadline",
    bullets: [
      "Update your SAF-T capability separately because SAF-T Financial v1.40 is required from January 2027.",
      "Manage it as a parallel accounting-data workstream.",
    ],
  },
  {
    number: 6,
    title: "Connect your ERP",
    bullets: [
      "Establish an e-invoicing software to your ERP. It works as a compliant layer for sending e-invoices through the required digital infrastructure.",
      "ClearTax acts as both Seller's and Buyer's Peppol Access Point for e-invoice exchange.",
    ],
  },
  {
    number: 7,
    title: "Review retention and storage.",
    bullets: [
      "Preserve the original electronic invoices, apply the retention period relevant to your records and business, and check the conditions before storing accounting material outside Norway.",
    ],
  },
  {
    number: 8,
    title: "Prepare for 2030",
    bullets: [
      "Don't build only for outbound invoices.",
      "Your accounts will also need to receive and automatically process e-invoices from 2030.",
    ],
  },
];

