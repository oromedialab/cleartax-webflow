---
/**
 * "What you should do before 2027" — Figma node 17103:83435 ("Fold 8").
 *
 * A vertical numbered stepper of 8 cards connected by a hairline. Diverges
 * from the Figma's single-open accordion: every card from the first through
 * whichever is closest to the viewport's vertical centre is open at once —
 * scrolling down grows that open set (opening the next card); scrolling back
 * up shrinks it from the end, closing one card at a time. Clicking a card
 * sets the open set to end there. The connecting hairline fills cumulatively
 * to match, reading as a progress bar.
 *
 * Background is the same dot-grid field used in the hero, static here (no
 * cursor interaction) since this section sits well below the fold — see
 * `.no-roadmap-bg` below.
 */
interface Step {
  no: string;
  heading: string;
  body: string;
}

const steps: Step[] = [
  {
    no: "01",
    heading: "Confirm your bookkeeping obligation",
    body: "Determine whether your Norwegian entity falls within the new e-invoicing requirement.",
  },
  {
    no: "02",
    heading: "Check how your customers receive e-invoices",
    body: "Check which business buyers are registered in ELMA and can receive e-invoices. Confirm each customer's reception capability; use ELMA lookup when sending through the EHF/Peppol network. Do not assume that an absent ELMA listing automatically removes a legal obligation.",
  },
  {
    no: "03",
    heading: "Choose an invoice-exchange route.",
    body: "Check the final B2B format rules before describing any one route as mandatory. If you use EHF through Peppol, confirm how your system connects to an Access Point and test delivery to recipients.",
  },
  {
    no: "04",
    heading: "Prepare structured invoice data.",
    body: "Review the information your systems need to produce for an electronic invoice suitable for automated processing.",
  },
  {
    no: "05",
    heading: "Related accounting deadline",
    body: "Update your SAF-T capability separately because SAF-T Financial v1.40 is required from January 2027. Manage it as a parallel accounting-data workstream.",
  },
  {
    no: "06",
    heading: "Connect your ERP",
    body: "Establish an e-invoicing software to your ERP. It works as a compliant layer for sending e-invoices through the required digital infrastructure. ClearTax acts as both Seller's and Buyer's Peppol Access Point for e-invoice exchange.",
  },
  {
    no: "07",
    heading: "Review retention and storage.",
    body: "Preserve the original electronic invoices, apply the retention period relevant to your records and business, and check the conditions before storing accounting material outside Norway.",
  },
  {
    no: "08",
    heading: "Prepare for 2030",
    body: "Don't build only for outbound invoices. Your accounts will also need to receive and automatically process e-invoices from 2030.",
  },
];
---

<section class="no-roadmap-bg relative overflow-hidden bg-generic-00 py-16 lg:py-20">
  <div
    class="absolute inset-0 z-0 opacity-60"
    style="background-image: radial-gradient(circle, #C8F006 1.5px, transparent 1.5px); background-size: 27px 27px; mask-image: radial-gradient(ellipse 70% 60% at center, #000 0%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at center, #000 0%, transparent 75%);"
    aria-hidden="true"
  >
  </div>
  <div class="relative z-10 w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6">
    <h2
      class="m-0 mb-8 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] lg:mb-12"
    >
      What you should do before 2027
    </h2>

    <div
      class="no-roadmap-list mx-auto flex max-w-[534px] flex-col items-stretch"
      data-no-roadmap
    >
      {
        steps.map((step, i) => (
          <>
            <div
              class="no-roadmap-item flex gap-4 rounded-xl border-2 border-neutral-300 p-4"
              data-no-roadmap-item
            >
              <button
                type="button"
                class="no-roadmap-trigger flex w-full cursor-pointer items-start gap-4 border-0 bg-transparent p-0 text-left"
                aria-expanded="false"
              >
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-neutral-300 bg-generic-00 font-body text-[length:var(--fs-body-lg)] font-medium text-vault-navy">
                  {step.no}
                </span>
                <span class="flex flex-1 flex-col justify-center pt-[3px]">
                  <span
                    class="font-body text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] font-medium text-vault-navy"
                    data-no-roadmap-anchor
                  >
                    {step.heading}
                  </span>
                  <span class="no-roadmap-body-wrap">
                    <span class="no-roadmap-body font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500">
                      {step.body}
                    </span>
                  </span>
                </span>
              </button>
            </div>
            {i < steps.length - 1 && (
              <div
                class="no-roadmap-connector mx-auto h-10 w-0.5 bg-neutral-300"
                data-no-roadmap-connector
                aria-hidden="true"
              />
            )}
          </>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .no-roadmap-list {
    /* Accordion items change height when they open/close. Without this, the
       browser's scroll-anchoring can silently nudge scrollY to compensate
       for that height change, which our scroll-direction detection then
       misreads as the user scrolling up — closing a step they never asked
       to close. */
    overflow-anchor: none;
  }
  .no-roadmap-item {
    transition: border-color 350ms ease-in-out;
  }
  .no-roadmap-connector {
    transition: background-color 350ms ease-in-out;
  }
  .no-roadmap-body-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .no-roadmap-open .no-roadmap-body-wrap {
    grid-template-rows: 1fr;
  }
  .no-roadmap-body {
    overflow: hidden;
    min-height: 0;
    padding-top: 0.75rem;
    opacity: 0;
    transition: opacity 300ms ease-in-out;
  }
  .no-roadmap-open .no-roadmap-body {
    opacity: 1;
  }
</style>

<script is:inline>
  (function () {
    const root = document.querySelector("[data-no-roadmap]");
    if (!root) return;
    const items = Array.from(root.querySelectorAll("[data-no-roadmap-item]"));
    const connectors = Array.from(
      root.querySelectorAll("[data-no-roadmap-connector]"),
    );
    const anchors = Array.from(
      root.querySelectorAll("[data-no-roadmap-anchor]"),
    );

    // Every step from 0 through this index is open. Scrolling down grows
    // it (opening the next step); scrolling back up shrinks it from the
    // end (closing the trailing step), one at a time, since it's
    // recomputed from scratch on every scroll frame rather than only
    // ever allowed to increase.
    let openUpTo = -1;

    function setOpenUpTo(index) {
      if (index === openUpTo) return;
      openUpTo = index;
      items.forEach((item, i) => {
        const trigger = item.querySelector(".no-roadmap-trigger");
        const isOpen = i <= openUpTo;
        item.classList.toggle("no-roadmap-open", isOpen);
        item.classList.toggle("border-nova-blue", isOpen);
        item.classList.toggle("border-neutral-300", !isOpen);
        if (trigger) trigger.setAttribute("aria-expanded", String(isOpen));
      });
      connectors.forEach((connector, i) => {
        // Connector i sits between item i and item i+1 — fill it once the
        // open set has reached at least that point, so the line reads as
        // a cumulative progress bar.
        const isFilled = i <= openUpTo;
        connector.classList.toggle("bg-nova-blue", isFilled);
        connector.classList.toggle("bg-neutral-300", !isFilled);
      });
    }

    items.forEach((item, i) => {
      const trigger = item.querySelector(".no-roadmap-trigger");
      if (!trigger) return;
      trigger.addEventListener("click", () => setOpenUpTo(i));
    });

    if (anchors.length === 0) return;

    // Recompute from live geometry on every scroll frame, rather than
    // reacting to IntersectionObserver enter/exit edges — a step opening
    // or closing changes the page's layout height, which can make
    // edge-crossing events fire out of order. Picking whichever heading is
    // actually closest to the viewport centre is immune to that, and keeps
    // working correctly in both scroll directions since it's recomputed
    // from scratch every frame rather than tracked incrementally.
    let ticking = false;

    function updateActiveFromScroll() {
      const rootRect = root.getBoundingClientRect();
      const inView = rootRect.top < window.innerHeight && rootRect.bottom > 0;
      if (!inView) return;

      const centerY = window.innerHeight / 2;
      let closestIndex = -1;
      let closestDistance = Infinity;
      anchors.forEach((anchor, i) => {
        const rect = anchor.getBoundingClientRect();
        const distance = Math.abs(rect.top + rect.height / 2 - centerY);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = i;
        }
      });
      if (closestIndex !== -1) setOpenUpTo(closestIndex);
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateActiveFromScroll();
        ticking = false;
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
