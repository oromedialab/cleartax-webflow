---
/**
 * "Security & Privacy" — Figma instance 17103:85029 (".Container - How
 * Cleartax helps", state="Security"). Unlike the tabbed
 * Compliance/Integrations/Security/Support variant of this shared Figma
 * symbol used on `uae-regional/Integration.astro` and the industry-page
 * `Security.astro` files, this page's Figma shows the plain closed-form
 * variant: a single 4-column grid of 8 cards, no tabs.
 *
 * Titles and descriptions are byte-identical to the `securityCards` set in
 * `banking-and-financial-services/Security.astro` (SOC 2, ISO 27001:2022,
 * VAPT, TLS 1.3, AES 256-bit, GDPR) plus an ISO 22301:2019 card and an RBAC
 * card the Figma adds for this page. Icons reuse the matching Webflow-hosted
 * icon already live for each title (RBAC has no match in that set, so it
 * borrows the dedicated RBAC icon from `scale-and-security-page/Certified.astro`)
 * rather than uploading new assets this build can't push to Webflow.
 */
interface Card {
  icon: string;
  title: string;
  desc: string;
}

const cards: Card[] = [
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017f8dc7b66d5a588bc_security-1.png",
    title: "SOC 2 Type II",
    desc: "Annual audit compliance for data security",
  },
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017a6ed8b9b53e24994_security-2.png",
    title: "ISO 27001:2022",
    desc: "Information security management",
  },
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017a6ed8b9b53e24994_security-2.png",
    title: "ISO 22301:2019",
    desc: "Business continuity management",
  },
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf10177e44768c4276915c_security-3.png",
    title: "VAPT",
    desc: "Vulnerability assessment & penetration testing",
  },
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017081cff26f50a19f2_security-6.png",
    title: "TLS 1.3",
    desc: "Encrypted data in transit",
  },
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf10173e74617468a30d6f_security-5.png",
    title: "AES 256-bit",
    desc: "Encryption at rest",
  },
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf101b33c66a200fcfb424_security-7.png",
    title: "RBAC",
    desc: "Role-based access control",
  },
  {
    icon: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6acf1017fed23ae56780ff7a_security-4.png",
    title: "GDPR",
    desc: "EEA data residency, customer data never used to train",
  },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6">
    <div class="mx-auto mb-8 flex max-w-[612px] flex-col items-center gap-4 text-center lg:mb-12">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        Security & Privacy
      </h2>
      <p
        class="m-0 font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-neutral-500"
      >
        Independently audited, encrypted in transit and at rest, and
        access-controlled - the same enterprise controls behind every
        Cleartax market.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        cards.map((card) => (
          <div class="flex items-start gap-3 rounded-xl border border-neutral-300 bg-generic-00 p-6">
            <img
              src={card.icon}
              alt=""
              width="32"
              height="32"
              class="h-8 w-8 shrink-0 object-contain"
              loading="lazy"
              decoding="async"
            />
            <div class="flex flex-col gap-2">
              <div class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] font-semibold text-vault-navy">
                {card.title}
              </div>
              <p class="m-0 font-body text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] text-neutral-500">
                {card.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
