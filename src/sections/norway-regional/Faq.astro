---
/**
 * FAQ for the Norway regional page — Figma node 17103:85045 ("FAQ").
 *
 * Structure, styling and behaviour live in `_shared/FaqRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file,
 * because the embed route renders sections with no props.
 *
 * All items are Norway-specific. `FaqRb` shows a "Load more" button past five.
 */
import FaqRb from '../_shared/FaqRb.astro';
import type { FaqItem } from '../_shared/FaqRb.astro';

const items: FaqItem[] = [
  {
    q: "Is Norway’s B2B e-invoicing mandate confirmed, or still a proposal?",
    a: "Confirmed. The Storting adopted amendments to the Bookkeeping Act on 8 June 2026, following Prop. 44 L (2025–2026). The requirement to issue structured e-invoices for qualifying B2B sales starts from January 2027. Digital bookkeeping starts from January 2030; the Ministry says it will provide transitional rules making e-invoice reception due by that date.",
  },
  {
    q: "Does this apply to foreign companies, or only Norwegian entities?",
    a: "It can apply to either. The relevant test is whether the business has Norwegian bookkeeping obligations, not its place of incorporation. A foreign business carrying on taxable activity in Norway may have those obligations, but its position must be assessed individually.",
  },
  {
    q: "Do I need to send e-invoices to every buyer from 2027?",
    a: "Not to every buyer. The amended Bookkeeping Act § 10 addresses sales to other bookkeeping-obliged businesses. Prop. 44 L, chapter 3.4, describes the 2027 transition with reference to buyers registered in ELMA and able to receive e-invoices.",
  },
  {
    q: "What format counts as compliant?",
    a: "The law requires a structured electronic sales document suitable for automated processing. EHF Fakturering 3.0 and Peppol BIS Billing 3.0 are established approved formats under the public-procurement rules, but the detailed format requirements for the new B2B mandate are to be set in regulation.",
  },
  {
    q: "Is there an exemption for small businesses?",
    a: "An exemption for certain low-turnover businesses was proposed; the enacted amendment allows exceptions to be set by regulation or individual decision. Whether a particular business qualifies needs to be checked against the applicable exception rules.",
  },
  {
    q: "What happens if I don’t comply?",
    a: [
      {
        kind: "p",
        html: "Under B2G, where a contract requires an approved e-invoice and the supplier does not provide one, the public buyer may withhold payment until a compliant invoice is delivered, subject to the notice rule in the public-procurement regulation, § 5. “Invoices are refused” is not the regulation’s wording.",
      },
      {
        kind: "p",
        html: "For B2B, penalties fall under the Bookkeeping Act and Tax Administration Act regimes — the exact tariff is due to be finalised by 15 December 2026.",
      },
    ],
  },
  {
    q: "How long do I need to archive e-invoices?",
    a: "Generally, retain applicable sales documentation for five years after the financial year ends, and retain an electronic invoice in its original format. A 15-year rule applies to the particular businesses covered by the petroleum-extraction and pipeline-transport provision, not every “petroleum-sector entity.”",
  },
];
---

<FaqRb
  items={items}
/>
