---
/**
 * Partner Program Walkthrough Section
 * Features responsive stats row positioned above a full-width video walkthrough container.
 * (Desktop & Tablet: horizontal flex row with justify-between and dividers, Mobile: 2x2 grid with segmented plus dividers)
 */

const stats = [
    {
        value: "5000+",
        label: "Enterprises trust us",
    },
    {
        value: "100+",
        label: "Partners worldwide",
    },
    {
        value: "50+",
        label: "Countries covered",
    },
    {
        value: "100+",
        label: "Integrations",
    },
    {
        value: "99.9%",
        label: "Platform uptime",
    },
];
---

<section class="bg-generic-00 pt-6">
    <div class="mx-auto w-full min-[1400px]:container px-4 md:px-6">
        <div class="flex flex-col">
            <!-- Stats (flipped upward, flex justify-between) -->
            <div class="relative w-full">
                <div
                    class="grid grid-cols-2 md:flex md:flex-row md:justify-between items-start gap-y-8 gap-x-4 md:gap-0 text-center md:text-left"
                >
                    {
                        stats.map((stat, index) => (
                            <div
                                class:list={[
                                    "flex flex-col items-center px-2 sm:px-4 md:px-6 py-2 md:py-0 md:flex-1",
                                    index > 0 &&
                                        "md:border-l md:border-neutral-300",
                                ]}
                            >
                                <h3 class="font-heading font-medium text-[length:var(--fs-h4)] sm:text-[length:var(--fs-h3)] lg:text-[length:var(--fs-h2)] leading-[length:var(--lh-h4)] sm:leading-[length:var(--lh-h3)] lg:leading-[length:var(--lh-h2)] text-text-default mb-2">
                                    {stat.value}
                                </h3>
                                <p class="font-body font-normal text-[length:var(--fs-body-sm)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-sm)] lg:leading-[length:var(--lh-body-lg)] text-neutral-500">
                                    {stat.label}
                                </p>
                            </div>
                        ))
                    }
                </div>

                <!-- Mobile Segmented Plus Dividers -->
                <div
                    class="absolute md:hidden left-1/2 -translate-x-1/2 bottom-[calc(50%+16px)] h-14 sm:h-16 w-[1px] bg-neutral-300"
                >
                </div>
                <div
                    class="absolute md:hidden left-1/2 -translate-x-1/2 top-[calc(50%+16px)] h-14 sm:h-16 w-[1px] bg-neutral-300"
                >
                </div>
                <div
                    class="absolute md:hidden top-1/2 -translate-y-1/2 left-1/4 -translate-x-1/2 w-14 sm:w-16 h-[1px] bg-neutral-300"
                >
                </div>
                <div
                    class="absolute md:hidden top-1/2 -translate-y-1/2 left-3/4 -translate-x-1/2 w-14 sm:w-16 h-[1px] bg-neutral-300"
                >
                </div>
            </div>
        </div>
    </div>
</section>
