<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>
<script
    is:inline
    src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
></script>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const section = document.getElementById("partner-profiles-section");
        if (!section) return;

        const tabBtns = section.querySelectorAll(".partner-tab-btn");
        const swiperEl = section.querySelector(".partner-tabs-swiper");
        if (!swiperEl || !tabBtns.length) return;

        function updateActiveTab(index) {
            tabBtns.forEach((btn, i) => {
                const isActive = i === index;
                btn.setAttribute("aria-selected", isActive ? "true" : "false");
                if (isActive) {
                    btn.classList.add("active", "bg-generic-00", "text-navy-600", "shadow-[0px_1px_3px_0px_rgba(16,24,40,0.1)]");
                    btn.classList.remove("text-neutral-600", "bg-transparent");
                    btn.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
                } else {
                    btn.classList.remove("active", "bg-generic-00", "text-navy-600", "shadow-[0px_1px_3px_0px_rgba(16,24,40,0.1)]");
                    btn.classList.add("text-neutral-600", "bg-transparent");
                }
            });
        }

        function initSwiper() {
            if (typeof Swiper === "undefined") {
                setTimeout(initSwiper, 50);
                return;
            }

            const swiper = new Swiper(swiperEl, {
                slidesPerView: 1,
                speed: 400,
                grabCursor: true,
                autoHeight: false,
                on: {
                    slideChange: function () {
                        updateActiveTab(this.activeIndex);
                    },
                },
            });

            tabBtns.forEach((btn, index) => {
                btn.addEventListener("click", () => {
                    swiper.slideTo(index);
                });
            });
        }

        initSwiper();
    });
</script>
