---
/**
 * Stream-stack (Partner Profiles / Who Can Partner Tabs) Section for Partner Program Page.
 * Implements 3 partner profile tabs with 2-column layout:
 * Left: Headline + 3 icon bullet points
 * Right: Visual card container matching provided design
 */

interface BulletPoint {
    icon: "document" | "windows" | "mortarboard" | "connector" | "building" | "globe" | "layers" | "support" | "expert";
    text: string;
}

interface TabItem {
    id: string;
    tabLabel: string;
    title: string;
    points: BulletPoint[];
}

const tabsData: TabItem[] = [
    {
        id: "accounting-tax",
        tabLabel: "Accounting & Tax Consulting Firms",
        title: "Upgrade your compliance advisory with ClearTax's proven e-invoicing capabilities.",
        points: [
            {
                icon: "document",
                text: "Offer compliant e-invoicing automation solutions localised to 50+ countries",
            },
            {
                icon: "windows",
                text: "Pursue MNCs and RFPs with jointly positioned SKUs that combine your compliance advisory expertise with ClearTax's e-invoicing technology.",
            },
            {
                icon: "mortarboard",
                text: "Become the authority on e-invoicing and tax in your market through joint webinars, seminars and thought-leadership content.",
            },
        ],
    },
    {
        id: "system-integrators",
        tabLabel: "System Integrators & Resellers",
        title: "Add e-invoicing and tax automation solutions that integrate smoothly with your ERP or accounting system.",
        points: [
            {
                icon: "connector",
                text: "Complement your existing ERP/Accounting offerings with a pre-built, E-invoicing-compliant connector for 50+ countries.",
            },
            {
                icon: "building",
                text: "Receive integration projects for new businesses while expanding relationships with existing customers",
            },
            {
                icon: "globe",
                text: "Widen your scope of expertise by adding compliance knowledge with ClearTax as your global compliance partner.",
            },
        ],
    },
    {
        id: "tech-oems",
        tabLabel: "Tech OEMs – ERPs, POS, PMS, Accounting Systems",
        title: "Embed digital compliance directly into your system with a single, unified global solution.",
        points: [
            {
                icon: "layers",
                text: "Increase customer stickiness with an embedded e-invoicing solution that lives inside your product",
            },
            {
                icon: "support",
                text: "24×7 support available to ensure service upkeep and query assistance",
            },
            {
                icon: "expert",
                text: "Dedicated e-invoice and tax expert to provide access to compliance expertise.",
            },
        ],
    },
];
---

<section id="partner-profiles-section" class="bg-generic-00 py-16 md:py-24 overflow-hidden">
    <div class="min-[1400px]:container mx-auto w-full px-4 md:px-6">
        <!-- Section Header -->
        <div class="text-center mx-auto mb-8 md:mb-12">
            <h2 class="font-heading font-medium text-[30px] sm:text-[36px] md:text-[40px] leading-[1.2] text-neutral-900 max-w-2xl mx-auto m-0">
                Who can partner with ClearTax?
            </h2>
        </div>

        <!-- Tabs Navigation Pill Bar -->
        <div class="flex justify-center mb-10 md:mb-14">
            <div
                class="inline-flex items-center justify-start sm:justify-center p-1.5 bg-neutral-100 rounded-xl gap-2 max-w-full overflow-x-auto [scrollbar-width:_none] [-ms-overflow-style:_none] [&::-webkit-scrollbar]:hidden border border-neutral-200/80 shadow-[inset_0_1px_2px_rgba(0,0,0,0.03)]"
                role="tablist"
                aria-label="Partner Categories"
            >
                {
                    tabsData.map((tab, index) => (
                        <button
                            type="button"
                            role="tab"
                            id={`tab-btn-${tab.id}`}
                            aria-selected={index === 0 ? "true" : "false"}
                            aria-controls={`panel-${tab.id}`}
                            data-tab-index={index}
                            class:list={[
                                "partner-tab-btn shrink-0 whitespace-nowrap py-2.5 px-5 sm:px-6 text-sm md:text-[15px] font-medium rounded-lg font-body transition-all duration-200 cursor-pointer outline-none select-none border-0",
                                index === 0
                                    ? "active bg-generic-00 text-navy-600 shadow-[0px_1px_3px_0px_rgba(16,24,40,0.1)]"
                                    : "text-neutral-600 bg-transparent hover:text-neutral-900",
                            ]}
                        >
                            {tab.tabLabel}
                        </button>
                    ))
                }
            </div>
        </div>

        <!-- Tab Panels Swiper Container -->
        <div class="w-full">
            <div class="swiper partner-tabs-swiper w-full overflow-hidden">
                <div class="swiper-wrapper items-stretch">
                    {
                        tabsData.map((tab) => (
                            <div
                                id={`panel-${tab.id}`}
                                role="tabpanel"
                                aria-labelledby={`tab-btn-${tab.id}`}
                                class="swiper-slide w-full shrink-0 box-border"
                            >
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-14">
                                    <!-- Left Column: Content (Heading + 3 Bullet Points) -->
                                    <div class="flex flex-col md:max-w-140">
                                        <h3 class="font-heading font-medium text-[24px] leading-[1.33] text-text-default m-0 mb-6 lg:mb-8">
                                            {tab.title}
                                        </h3>

                                        <!-- Bullet Points List -->
                                        <div class="flex flex-col gap-3 sm:gap-5">
                                            {tab.points.map((point) => (
                                                <div class="flex items-start gap-3">
                                                    <!-- Icon -->
                                                    <div class="shrink-0 w-6 h-6 flex items-center justify-center text-nova-blue mt-0.5">
                                                        {point.icon === "document" && (
                                                            <svg width="22" height="21" viewBox="0 0 22 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                <path d="M16.4435 19.645H1.87499C1.18464 19.645 0.625 19.0854 0.625 18.395V1.875C0.625 1.18464 1.18464 0.625 1.87499 0.625H15.1935C15.8837 0.625 16.4435 1.18464 16.4435 1.875V8.55716" stroke="var(--color-vault-navy)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                                                                <path d="M6.62508 5.23145V6.4717C6.62508 6.86045 6.31108 7.17607 5.92245 7.1782L4.98295 7.18332C4.7257 7.1847 4.51783 7.39357 4.51758 7.65082C4.51745 7.8037 4.59195 7.94682 4.71708 8.03445L6.84308 9.52307" stroke="var(--color-vault-navy)" stroke-width="1.25" stroke-linecap="round"/>
                                                                <path d="M4.52344 5.23145H7.33206" stroke="var(--color-vault-navy)" stroke-width="1.25" stroke-linecap="round"/>
                                                                <path d="M4.52344 15.0361H8.93656" stroke="var(--color-vault-navy)" stroke-width="1.25" stroke-linecap="round"/>
                                                                <path d="M4.52344 12.4316H6.73094" stroke="var(--color-vault-navy)" stroke-width="1.25" stroke-linecap="round"/>
                                                                <path d="M21.0839 8.64062H11.875V11.8754H21.0839V8.64062Z" stroke="var(--color-nova-blue)" stroke-width="1.25" stroke-linecap="round"/>
                                                                <path d="M11.8809 7.82227V12.492" stroke="var(--color-nova-blue)" stroke-width="1.25" stroke-linecap="round"/>
                                                                <path d="M21.0898 7.82227V12.492" stroke="var(--color-nova-blue)" stroke-width="1.25" stroke-linecap="round"/>
                                                                <path d="M15.1816 12.0654L17.7444 12.0656V18.3621C17.7444 19.0698 17.1706 19.6436 16.4629 19.6434C15.7553 19.6433 15.1816 19.0697 15.1816 18.3621V12.0654Z" stroke="var(--color-nova-blue)" stroke-width="1.25" stroke-linecap="round"/>
                                                            </svg>
                                                        )}
                                                        {point.icon === "windows" && (
                                                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                <path d="M11.3695 0.625H0.625V11.3695H11.3695V0.625Z" stroke="var(--color-vault-navy)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                                                                <path d="M17.0531 6.37207H6.30859V17.1166H17.0531V6.37207Z" stroke="var(--color-nova-blue)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                                                            </svg>
                                                        )}
                                                        {point.icon === "mortarboard" && (
                                                            <svg width="25" height="23" viewBox="0 0 25 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                <path d="M16.5212 9.48827L23.1865 12.4879L11.9755 17.1124L0.625 12.4878L7.7717 9.31152" stroke="var(--color-vault-navy)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                                                                <path d="M4.95703 14.7581V19.1487L12.0389 21.9972L15.4568 20.5422L18.8748 19.0871V14.4541" stroke="var(--color-vault-navy)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                                                                <path d="M12.0739 11.3041C15.0229 11.3041 17.4135 8.91354 17.4135 5.96457C17.4135 3.01561 15.0229 0.625 12.0739 0.625C9.12498 0.625 6.73438 3.01561 6.73438 5.96457C6.73438 8.91354 9.12498 11.3041 12.0739 11.3041Z" stroke="var(--color-nova-blue)" stroke-width="1.25" stroke-linecap="round"/>
                                                                <path d="M12.8628 3.73926V5.14122C12.8628 5.5806 12.5078 5.9376 12.0685 5.93997L11.0065 5.94572C10.7157 5.94722 10.4807 6.18335 10.4805 6.47422C10.4803 6.64685 10.5646 6.80885 10.706 6.90785L13.1093 8.5906" stroke="var(--color-nova-blue)" stroke-width="1.25" stroke-linecap="round"/>
                                                                <path d="M10.4844 3.73926H13.6593" stroke="var(--color-nova-blue)" stroke-width="1.25" stroke-linecap="round"/>
                                                                <path d="M23.209 12.5293V16.5605" stroke="var(--color-vault-navy)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                                                                <path d="M23.1678 18.7908C23.7524 18.7908 24.2263 18.3169 24.2263 17.7323C24.2263 17.1477 23.7524 16.6738 23.1678 16.6738C22.5833 16.6738 22.1094 17.1477 22.1094 17.7323C22.1094 18.3169 22.5833 18.7908 23.1678 18.7908Z" stroke="var(--color-vault-navy)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                                                            </svg>
                                                        )}
                                                        {point.icon === "connector" && (
                                                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M12 2v6m0 8v6M8 8h8v5a4 4 0 0 1-8 0V8z" />
                                                                <path d="M9 2v3m6-3v3" />
                                                            </svg>
                                                        )}
                                                        {point.icon === "building" && (
                                                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                                <rect x="3" y="3" width="18" height="18" rx="2" />
                                                                <path d="M3 9h18M9 21V9" />
                                                            </svg>
                                                        )}
                                                        {point.icon === "globe" && (
                                                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                                <circle cx="12" cy="12" r="10" />
                                                                <line x1="2" y1="12" x2="22" y2="12" />
                                                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                                                            </svg>
                                                        )}
                                                        {point.icon === "layers" && (
                                                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0l8.57-3.908a1 1 0 0 0 0-1.832z" />
                                                                <path d="m2 12 10 4.5 10-4.5" />
                                                                <path d="m2 17 10 4.5 10-4.5" />
                                                            </svg>
                                                        )}
                                                        {point.icon === "support" && (
                                                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M3 18v-6a9 9 0 0 1 18 0v6" />
                                                                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" />
                                                            </svg>
                                                        )}
                                                        {point.icon === "expert" && (
                                                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                                                <circle cx="9" cy="7" r="4" />
                                                                <polyline points="16 11 18 13 22 9" />
                                                            </svg>
                                                        )}
                                                    </div>

                                                    <!-- Text -->
                                                    <p class="font-body font-normal text-neutral-500 leading-normal text-base m-0">
                                                        {point.text}
                                                    </p>
                                                </div>
                                            ))}
                                        </div>
                                    </div>

                                    <!-- Right Column: Visual Container matching design -->
                                    <div class="w-full">
                                        <div class="bg-visual-placeholder rounded-lg min-h-76 w-full">
                                            <!-- Ambient light decorative accent -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>
<script
    is:inline
    src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
></script>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const section = document.getElementById("partner-profiles-section");
        if (!section) return;

        const tabBtns = section.querySelectorAll(".partner-tab-btn");
        const swiperEl = section.querySelector(".partner-tabs-swiper");
        if (!swiperEl || !tabBtns.length) return;

        function updateActiveTab(index) {
            tabBtns.forEach((btn, i) => {
                const isActive = i === index;
                btn.setAttribute("aria-selected", isActive ? "true" : "false");
                if (isActive) {
                    btn.classList.add("active", "bg-generic-00", "text-navy-600", "shadow-[0px_1px_3px_0px_rgba(16,24,40,0.1)]");
                    btn.classList.remove("text-neutral-600", "bg-transparent");
                    btn.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
                } else {
                    btn.classList.remove("active", "bg-generic-00", "text-navy-600", "shadow-[0px_1px_3px_0px_rgba(16,24,40,0.1)]");
                    btn.classList.add("text-neutral-600", "bg-transparent");
                }
            });
        }

        function initSwiper() {
            if (typeof Swiper === "undefined") {
                setTimeout(initSwiper, 50);
                return;
            }

            const swiper = new Swiper(swiperEl, {
                slidesPerView: 1,
                speed: 400,
                grabCursor: true,
                autoHeight: false,
                on: {
                    slideChange: function () {
                        updateActiveTab(this.activeIndex);
                    },
                },
            });

            tabBtns.forEach((btn, index) => {
                btn.addEventListener("click", () => {
                    swiper.slideTo(index);
                });
            });
        }

        initSwiper();
    });
</script>
