---
interface Props {
    title?: string;
    description?: string;
    descriptionClass?: string;
    items?: {
        title: string;
        desc?: string;
        points?: string[];
        img?: string;
    }[];
}

const defaultItems = [
    {
        title: "In-built compliance and tech expertise",
        desc: "Enable a holistic view of the regulatory environment and infrastructure",
        points: [
            "Enable a holistic view of the regulatory environment and infrastructure",
        ],
    },
    {
        title: "Active on-ground relationship with govts. and regulators",
        desc: "Early visibility into regulatory changes, so your systems stay ahead of mandates",
        points: [
            "Early visibility into regulatory changes, so your systems stay ahead of mandates",
        ],
    },
    {
        title: "Single stack to manage digital compliance globally",
        desc: "Unified API and web portal to enable e-invoicing as per local mandates across 50+ countries",
        points: [
            "Unified API and web portal",
            "Enable e-invoicing as per local mandates",
            "Coverage across 50+ countries",
        ],
    },
    {
        title: "Accelerated business growth from e-invoicing",
        desc: "Earn a partner fee on every go-live with ClearTax , Co-build and sell a joint-SKU to your target enterprise segment, Preferred partner status with ClearTax globally",
        points: [
            "Earn a partner fee on every go-live with ClearTax",
            "Co-build and sell a joint-SKU to your target enterprise segment",
            "Preferred partner status with ClearTax globally",
        ],
    },
    {
        title: "Preferred Advisory Partner for ClearTax globall",
        desc: "Runs every day automatically. Discrepancies are surfaced with AI-recommended actions. You're notified only when something needs attention.",
        points: [
            "Runs every day automatically",
            "Discrepancies are surfaced with AI-recommended actions",
            "You're notified only when something needs attention",
        ],
    },
    {
        title: "Data security as per global standards",
        desc: "Active on-the-gISO 27001 | SOC-2 Compliant | VAPT, SSL Encryption & PCI compliance, AWS-powered cloud solution",
        points: [
            "ISO 27001 | SOC-2 Compliant",
            "VAPT, SSL Encryption & PCI compliance",
            "AWS-powered cloud solution",
        ],
    },
];

const {
    title = "ClearTax is a Continuous Compliance Platform",
    description = "Enterprise-grade infrastructure trusted by the world's largest organisations",
    descriptionClass = "",
    items = defaultItems,
} = Astro.props;
---

<div class="sticky-scroll-container">
    <section
        class="sticky top-0 flex flex-col justify-center bg-generic-00 py-12 md:py-16 xl:py-20 overflow-hidden min-h-[calc(100vh-80px)]"
    >
        <div class="mx-auto lg:container w-full px-4 lg:px-6">
            <div class="header-wrapper text-center mx-auto mb-8 md:mb-12">
                <h2
                    class="section-title text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-text-default max-w-216 mx-auto m-0"
                    class:list={[{ "mb-4": Boolean(description) }]}
                >
                    {title}
                </h2>
                {
                    description && (
                        <p
                            class={`section-desc text-neutral-500 font-normal text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-lg)] sm:leading-[length:var(--lh-body-lg)] mx-auto ${descriptionClass}`}
                        >
                            {description}
                        </p>
                    )
                }
            </div>

            <div class="w-full h-auto">
                <div
                    class="compliance-scroll-track flex items-stretch gap-6 w-max transition-transform duration-[250ms] ease-out will-change-transform"
                >
                    {
                        items.map((item) => {
                            const points =
                                item.points || (item.desc ? [item.desc] : []);
                            return (
                                <div class="card-item bg-generic-00 rounded-lg p-4 sm:p-6 xl:p-8 w-[calc(100vw-32px)] md:w-[48vw] lg:w-[45vw] border-2 border-neutral-300 flex flex-col select-none">
                                    <h3 class="card-title text-[24px] leading-[1.33] font-medium max-w-[564px] text-text-default mb-4 md:mb-6 pointer-events-none">
                                        {item.title}
                                    </h3>
                                    <div class="card-img w-full max-w-[564px] h-[320px] min-h-[320px] max-h-[440px] rounded-sm pointer-events-none bg-visual-placeholder" />
                                    <ul class="card-desc flex flex-col gap-2 lg:gap-4 mt-6 pointer-events-none p-0 m-0 list-none">
                                        {points.map((pt) => (
                                            <li class="flex items-start gap-2.5 text-neutral-500 font-normal text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-lg)] sm:leading-[length:var(--lh-body-lg)]">
                                                <span
                                                    class="w-1.5 h-1.5 rounded-full bg-neutral-500 shrink-0 mt-2.5"
                                                    aria-hidden="true"
                                                />
                                                <span>{pt}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            );
                        })
                    }
                </div>
            </div>
        </div>
    </section>
</div>

<style is:global>
    @media (max-height: 750px) {
        .sticky-scroll-container section {
            padding-top: 1.25rem !important;
            padding-bottom: 1.25rem !important;
        }
        .header-wrapper {
            margin-bottom: 1rem !important;
        }
        .card-item {
            padding: 1.25rem !important;
            max-width: calc(100vw - 32px) !important;
            width: calc(100vw - 32px) !important;
        }
        @media (min-width: 768px) {
            .card-item {
                max-width: 480px !important;
                width: 38vw !important;
            }
        }
        .card-title {
            font-size: 1.35rem !important;
            margin-bottom: 0.75rem !important;
        }
        .card-img {
            min-height: 180px !important;
            height: 25vh !important;
            max-height: 280px !important;
            object-position: center !important;
        }
        .card-desc,
        .card-desc li {
            margin-top: 0.75rem !important;
            font-size: 0.875rem !important;
            line-height: 1.35 !important;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const containers = document.querySelectorAll(
            ".sticky-scroll-container",
        );
        if (!containers.length) return;

        containers.forEach((container) => {
            const track = container.querySelector(".compliance-scroll-track");
            const section = container.querySelector("section");
            if (!container || !track || !section) return;

            const getHeaderHeight = () => {
                const header = document.querySelector(
                    "header, .navbar, .w-nav",
                );
                return header ? header.offsetHeight : 80;
            };

            let maxTranslate = 0;
            let totalScrollable = 0;
            let stickyTop = 0;

            const updateMeasurements = () => {
                const sectionHeight = section.offsetHeight;
                const windowHeight = window.innerHeight;
                const headerHeight = getHeaderHeight();

                const trackOffset =
                    track.parentElement.getBoundingClientRect().top -
                    section.getBoundingClientRect().top;
                const trackHeight = track.offsetHeight;
                const availableSpace = windowHeight - headerHeight;

                const idealTrackTop =
                    headerHeight +
                    Math.max(40, (availableSpace - trackHeight) / 2);
                let calculatedTop = idealTrackTop - trackOffset;

                // Position section flush under header when sticky, avoiding gap on large screens
                stickyTop = Math.min(headerHeight, calculatedTop);
                section.style.top = `${stickyTop}px`;

                const containerWidth =
                    track.parentElement.getBoundingClientRect().width;
                maxTranslate = Math.max(0, track.scrollWidth - containerWidth);
                container.style.height = `${maxTranslate + windowHeight}px`;
                totalScrollable =
                    container.getBoundingClientRect().height - sectionHeight;
            };

            updateMeasurements();

            if (window.ResizeObserver) {
                const ro = new ResizeObserver(updateMeasurements);
                ro.observe(section);
                ro.observe(track);
            }
            window.addEventListener("resize", updateMeasurements);

            let ticking = false;

            const handleScroll = () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const containerRect = container.getBoundingClientRect();
                        const scrolledDistance = Math.max(
                            0,
                            stickyTop - containerRect.top,
                        );

                        let progress =
                            totalScrollable > 0
                                ? scrolledDistance / totalScrollable
                                : 0;
                        progress = Math.max(0, Math.min(1, progress));

                        track.style.transform = `translate3d(-${progress * maxTranslate}px, 0, 0)`;

                        ticking = false;
                    });
                    ticking = true;
                }
            };

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            window.addEventListener("scroll", handleScroll, {
                                passive: true,
                            });
                            handleScroll();
                        } else {
                            window.removeEventListener("scroll", handleScroll);
                        }
                    });
                },
                {
                    rootMargin: "100% 0px 100% 0px",
                },
            );

            observer.observe(container);
        });
    });
</script>
