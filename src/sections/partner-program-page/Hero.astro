---
/**
 * Hero section for Indirect Tax page.
 * Uses interactive Dotgrid in Flux Lime with high-contrast radial wash,
 * brand typography, and tailored copy.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

interface Props {
    lineWidth?: number;
    gap?: number;
    maxLength?: number;
    lengthRadius?: number;
    tilt?: number;
    baseColor?: string;
    cursorRadius?: number;
    pull?: number;
    fadeRadius?: number;
    titlePrefix?: string;
    titleHighlight?: string;
    titleSuffix?: string;
    description?: string;
}

const {
    lineWidth = 3,
    gap = 24,
    maxLength = 6,
    lengthRadius = 260,
    tilt = 1,
    baseColor = "#C8F006",
    cursorRadius = 320,
    pull = 14,
    fadeRadius = 40,
    titlePrefix = "",
    titleHighlight = "Partner",
    titleSuffix = "with ClearTax",
    description = "Your Global Digital Compliance Partner",
} = Astro.props;

const icons = [
    {
        id: 1,
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa240210b95e62dd7b6ab39_innovice-icon.png",
        desc: "1B+ E-Invoices annually",
    },
    {
        id: 2,
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa2394447fb2cc739a96af1_10k-peak-icon.png",
        desc: "10K/s Peak invoice throughput",
    },
    {
        id: 3,
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa2401b2f1bebbb77f908e6_countries.png",
        desc: "50+ Countries covered",
    },
    {
        id: 4,
        image: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa24029e1e6804b0a5eb993_rupees.png",
        desc: "$500B+ Invoices processed",
    },
];
---

<section
    class="de-hero-section relative bg-generic-00 overflow-hidden flex flex-col max-lg:pt-32 max-lg:pb-16 lg:pt-[257px] lg:pb-[161px]"
    id="hero"
>
    <!-- Interactive Dot Grid Background -->
    <Dotgrid
        containerId="hero"
        lineWidth={lineWidth}
        gap={gap}
        maxLength={maxLength}
        lengthRadius={lengthRadius}
        tilt={tilt}
        baseColor={baseColor}
        cursorRadius={cursorRadius}
        pull={pull}
        fadeRadius={fadeRadius}
    />

    <!-- Radial wash, so the headline keeps its contrast over the field -->
    <div
        class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"
    >
    </div>

    <div
        class="relative z-10 mx-auto lg:container w-full h-full flex flex-col px-4 md:px-6 pointer-events-auto"
    >
        <div class="flex justify-center w-full h-full">
            <!-- Hero Content -->
            <div
                class="hero-content flex flex-col items-center mx-auto text-center w-full h-full"
            >
                <!-- Headline -->
                <h1
                    class="text-[length:var(--fs-h1)] sm:text-[length:var(--fs-display-sm)] lg:text-[length:var(--fs-display-lg)] leading-[length:var(--lh-h1)] sm:leading-[length:var(--lh-display-sm)] lg:leading-[length:var(--lh-display-lg)] text-generic-100 font-semibold font-heading max-w-144.25 mx-auto mb-4 m-0 text-center"
                >
                    {titlePrefix}
                    {
                        titleHighlight && (
                            <span class="text-generic-100 bg-flux-lime px-1 rounded-lg">
                                {titleHighlight}
                            </span>
                        )
                    }
                    {titleSuffix}
                </h1>

                <!-- Description -->
                <p
                    class="text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-lg)] sm:leading-[length:var(--lh-body-lg)] max-w-151 text-neutral-500 font-normal font-body mb-6 text-center"
                >
                    {description}
                </p>
                <!-- stats -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="flex gap-3 bg-generic-00/70 p-3 rounded-xl">
                        <img
                            src="/public/images/partner-program-page/Group.png"
                            alt=""
                            class="w-6 shrink-0 object-contain"
                        />
                        <p
                            class="text-start font-body font-medium text-neutral-500 max-w-57"
                        >
                            Access global compliance + local expertise
                        </p>
                    </div>
                    <div class="flex gap-3 bg-generic-00/70 p-3 rounded-xl">
                        <img
                            src="/public/images/partner-program-page/cash.png"
                            alt=""
                            class="w-6 shrink-0 object-contain"
                        />
                        <p
                            class="text-start font-body font-medium text-neutral-500 max-w-57"
                        >
                            New revenue streams with co-sell opportunities
                        </p>
                    </div>
                    <div
                        class="flex items-center gap-3 bg-generic-00/70 p-3 rounded-xl"
                    >
                        <img
                            src="/public/images/partner-program-page/growth.png"
                            alt=""
                            class="w-6 shrink-0 object-contain"
                        />
                        <p
                            class="text-start font-body font-medium text-neutral-500 max-w-57"
                        >
                            Stronger customer relationships and retention
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
