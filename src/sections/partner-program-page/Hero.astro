                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                            <path
                                d="M16.0005 24.4375C11.3482 24.4375 7.56299 20.6523 7.56299 16C7.56299 11.3478 11.3482 7.56252 16.0005 7.56252C20.6527 7.56252 24.438 11.3478 24.438 16C24.438 20.6523 20.6527 24.4375 16.0005 24.4375Z"
