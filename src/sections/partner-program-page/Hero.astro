                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                            <path
                                d="M16.3982 3.99991V7.90234"
                                stroke="#5446FF"
                                stroke-width="1.6"
                                stroke-miterlimit="10"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                            <path
                                d="M7.43018 7.51959L10.1896 10.2791"
