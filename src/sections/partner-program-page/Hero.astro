                                stroke-linejoin="round"></path>
                            <path
                                d="M8.00024 15.4375H23.9113"
                                stroke="#05022A"
                                stroke-width="1.6"
                                stroke-miterlimit="10"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                        </svg>

                        <p
                            class="text-start font-body font-medium text-neutral-500 max-w-57"
                        >
                            Access global compliance + local expertise
                        </p>
                    </div>
                    <div class="flex gap-3 bg-generic-00/70 p-3 rounded-xl">
                        <svg
                            width="32"
                            height="32"
