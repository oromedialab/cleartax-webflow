                            <path
                                d="M22.6069 10.2789L25.3663 7.51947"
                                stroke="#5446FF"
                                stroke-width="1.6"
                                stroke-miterlimit="10"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                        </svg>

                        <p
                            class="text-start font-body font-medium text-neutral-500 max-w-57"
                        >
                            Stronger customer relationships and retention
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style is:global>
    /* The single Flux Lime instance on this screen. Keeps the highlight intact
       with proportional horizontal padding and clearance from adjacent text. */
    .partner-hero-mark {
        display: inline-block;
        background-color: var(--color-flux-lime);
        padding: 4px 13px;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
        border-radius: 12px;
        vertical-align: baseline;
    }
</style>
