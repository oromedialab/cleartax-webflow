                                stroke-miterlimit="10"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                            <path
                                d="M8.59016 24.5165C8.9563 24.8827 8.9563 25.4762 8.59016 25.8423C8.22402 26.2085 7.63044 26.2085 7.26435 25.8423C6.89821 25.4762 6.89821 24.8827 7.26435 24.5165C7.63044 24.1504 8.22402 24.1504 8.59016 24.5165Z"
