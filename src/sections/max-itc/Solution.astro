---
/**
 * Solution section for Max ITC.
 */
---

<section id="solution" class="py-16 lg:py-24 bg-generic-00">
  <div class="mx-auto container px-4 lg:px-8">
    <div class="text-center max-w-[800px] mx-auto mb-12">
      <h2 class="font-heading font-semibold text-vault-navy text-2xl lg:text-4xl tracking-tight mb-4">
        An end-to-end reconciliation solution
      </h2>
      <p class="font-body text-neutral-500 text-base lg:text-lg">
        Ingest data, run multi-tier matching algorithms, generate reports, and push results back to your ERP seamlessly.
      </p>
    </div>
  </div>
</section>
