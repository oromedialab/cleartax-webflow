---
/**
 * Maximize section for Max ITC.
 */
---

<section class="bg-generic-00 py-16 md:py-20">
  <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
    <!-- Outer Card Container -->
    <div class="border border-neutral-200 rounded-lg p-6 sm:p-10 lg:p-16 bg-generic-00 flex flex-col items-center">
      <!-- Heading -->
      <h2 class="text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] max-w-150 mx-auto mb-8 sm:mb-12">
        Maximize your ITC claim by putting your ITC on autopilot with us
      </h2>

      <!-- Visual Placeholder Box with Stats Pill -->
      <div class="w-full max-w-[800px] aspect-[800/450] bg-visual-placeholder rounded-lg relative flex flex-col justify-end p-3 sm:p-4">
        <!-- Bottom Stats Pill -->
        <div class="w-full bg-generic-00 rounded-xl py-3.5 sm:py-4 px-4 sm:px-6 shadow-xs">
          <div class="grid grid-cols-2 divide-x divide-neutral-200 items-center text-center">
            <!-- Stat 1 -->
            <div class="flex items-center justify-center gap-2 sm:gap-3 px-2">
              <span class="font-heading font-medium text-vault-navy text-[length:var(--fs-h3)] leading-none">
                100%
              </span>
              <span class="font-body text-neutral-500 text-xs sm:text-sm leading-tight text-left">
                Automation
              </span>
            </div>

            <!-- Stat 2 -->
            <div class="flex items-center justify-center gap-2 sm:gap-3 px-2">
              <span class="font-heading font-medium text-vault-navy text-[length:var(--fs-h3)] leading-none">
                100%
              </span>
              <span class="font-body text-neutral-500 text-xs sm:text-sm leading-tight text-left">
                Compliant ITC claim
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
