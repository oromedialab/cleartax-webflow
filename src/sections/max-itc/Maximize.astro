---
/**
 * Maximize section for Max ITC.
 */
---

<section class="bg-generic-00 py-16 md:py-20">
  <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
    <!-- Outer Card Container -->
    <div class="border border-neutral-200 rounded-2xl md:rounded-lg p-4 sm:p-10 lg:p-16 bg-generic-00 flex flex-col items-center">
      <!-- Heading -->
      <h2 class="m-0 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] max-w-150 mx-auto mb-6 sm:mb-12">
        Maximize your ITC claim by putting your ITC on autopilot with us
      </h2>

      <!-- Visual Placeholder Box with Stats Pill -->
      <div class="w-full max-w-[800px] aspect-[4/3] md:aspect-[800/450] bg-visual-placeholder rounded-2xl md:rounded-lg relative flex flex-col justify-end p-3 sm:p-4">
        <!-- Bottom Stats Pill -->
        <div class="hidden md:block w-full bg-generic-00 rounded-xl py-3.5 sm:py-4 px-4 sm:px-6 shadow-xs">
          <div class="grid grid-cols-2 divide-x divide-neutral-200 items-center text-center">
            <!-- Stat 1 -->
            <div class="flex items-center justify-center gap-2 sm:gap-3 px-2">
              <span class="font-heading font-medium text-vault-navy text-[length:var(--fs-h3)] leading-none">
                100%
              </span>
              <span class="font-body text-neutral-500 text-[length:var(--fs-body-xs)] sm:text-[length:var(--fs-body-sm)] leading-tight text-left">
                Automation
              </span>
            </div>

            <!-- Stat 2 -->
            <div class="flex items-center justify-center gap-2 sm:gap-3 px-2">
              <span class="font-heading font-medium text-vault-navy text-[length:var(--fs-h3)] leading-none">
                100%
              </span>
              <span class="font-body text-neutral-500 text-[length:var(--fs-body-xs)] sm:text-[length:var(--fs-body-sm)] leading-tight text-left">
                Compliant ITC claim
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Stats Row  -->
    <div class="mt-8 md:hidden w-full max-w-[400px] mx-auto grid grid-cols-2 divide-x divide-neutral-200 items-start text-center">
      <!-- Stat 1 -->
      <div class="flex flex-col items-center justify-center px-3">
        <span class="font-heading font-medium text-vault-navy text-[length:var(--fs-h3)] leading-[length:var(--lh-h3)] tracking-normal">
          100%
        </span>
        <span class="font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] mt-1 text-center">
          Automation
        </span>
      </div>

      <!-- Stat 2 -->
      <div class="flex flex-col items-center justify-center px-3">
        <span class="font-heading font-medium text-vault-navy text-[length:var(--fs-h3)] leading-[length:var(--lh-h3)] tracking-normal">
          100%
        </span>
        <span class="font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] mt-1 text-center">
          Compliant ITC claim
        </span>
      </div>
    </div>
  </div>
</section>
