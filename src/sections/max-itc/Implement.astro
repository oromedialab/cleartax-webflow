---
/**
 * Implement section for Max ITC — "How do we make it happen?"
 */

interface Step {
  title: string;
  description: string;
}

const steps: Step[] = [
  {
    title: "We connect directly to your accounting system",
    description:
      "A two-way connect with your accounting system to schedule auto-recons of your GST data, and sync vendor payment decisions.",
  },
  {
    title: "We then match data with 100% accuracy",
    description:
      "Auto-reconciliations run in the background, if there is any missing data/invoices found, an automated communication is sent to your vendor.",
  },
  {
    title: "You save on taxes and unblock working capital",
    description:
      "With advanced data matching, vendor communication and intelligent reports, we help you save on taxes.",
  },
];
---

<section id="implement" class="py-16 md:py-24 bg-generic-00">
  <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
    <!-- Centered Section Heading -->
    <h2 class="text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] mb-10 md:mb-14">
      How do we make it happen?
    </h2>

    <!-- 3-Column Card with Inset Dividers -->
    <div class="border border-neutral-200 rounded-2xl bg-generic-00 p-6 sm:p-8 lg:p-10 shadow-xs">
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-neutral-200">
        {steps.map((step) => (
          <div class="py-6 first:pt-0 last:pb-0 md:py-0 md:px-8 lg:px-10 first:md:pl-0 last:md:pr-0 flex flex-col items-start justify-start">
            <div class="w-14 h-14 rounded-xl bg-visual-placeholder mb-6 shrink-0"></div>
            <h3 class="font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] md:text-[length:var(--fs-h5)] leading-[length:var(--lh-h6)] md:leading-[length:var(--lh-h5)] mb-3">
              {step.title}
            </h3>
            <p class="font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
