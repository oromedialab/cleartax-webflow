---
/**
 * Vendors section for Max ITC.
 */
---

<section id="vendors" class="py-16 lg:py-24 bg-generic-00">
  <div class="mx-auto container px-4 lg:px-8">
    <div class="text-center max-w-[800px] mx-auto mb-12">
      <h2 class="font-heading font-semibold text-vault-navy text-2xl lg:text-4xl tracking-tight mb-4">
        Automate vendor follow-ups and hold payments dynamically
      </h2>
      <p class="font-body text-neutral-500 text-base lg:text-lg">
        Keep vendors informed of missing invoices, discrepancies, and return filing statuses automatically.
      </p>
    </div>
  </div>
</section>
