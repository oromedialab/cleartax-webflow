---
/**
 * Business section for Max ITC.
 */

const tabs = [
  "e-Commerce",
  "Manufacturing",
  "Financial services",
  "Retail",
  "FMCG",
  "Healthcare & Pharmaceutical",
  "Hospitality & Real estate",
];

const cards = [1, 2, 3, 4];
---

<section id="business" class="bg-generic-00 py-16 md:py-20">
  <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
    <!-- Header -->
    <div class="text-center max-w-139 mx-auto mb-6 sm:mb-8">
      <h2 class="m-0 text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-vault-navy font-heading mb-3 sm:mb-4">
        India's first end-to-end solution to maximize ITC for businesses
      </h2>
      <p class="m-0 text-neutral-500 font-normal text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] font-body">
        We've unblocked over{" "}
        <span class="font-bold text-neutral-500">₹ 9000 crores</span> for{" "}
        <span class="font-bold text-neutral-500">3000+ businesses</span>
      </p>
    </div>

    <!-- Tabs Navigation Bar (Centered on desktop, smoothly scrollable on mobile) -->
    <div
      id="business-tabs-scroll"
      class="w-full overflow-x-auto overscroll-x-contain [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden py-2 mb-8 md:mb-10 flex"
      style="-webkit-overflow-scrolling: touch;"
    >
      <div
        id="business-tabs-container"
        class="inline-flex items-center gap-1 p-1.5 bg-neutral-100 rounded-xl sm:rounded-2xl shrink-0 min-w-max mx-auto"
        role="tablist"
      >
        {tabs.map((tab, index) => {
          const isActive = index === 0;
          return (
            <button
              type="button"
              role="tab"
              data-business-tab={index}
              aria-selected={isActive ? "true" : "false"}
              class={`px-3.5 sm:px-4 py-2 text-sm font-medium rounded-lg sm:rounded-xl border-0 transition-all duration-200 ease-in-out cursor-pointer outline-none select-none whitespace-nowrap shrink-0 ${
                isActive
                  ? "active bg-generic-00 text-nova-blue shadow-xs"
                  : "text-neutral-700 bg-transparent hover:text-vault-navy"
              }`}
            >
              {tab}
            </button>
          );
        })}
      </div>
    </div>

    <!-- 4 Cards Grid (2x2 on mobile, 4 columns on desktop) -->
    <div
      id="business-cards-grid"
      class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-6 mb-8 md:mb-10 transition-opacity duration-200 ease-out"
    >
      {cards.map((_) => (
        <div class="w-full aspect-[2/1] rounded-xl sm:rounded-2xl bg-visual-placeholder" />
      ))}
    </div>

    <!-- Download Whitepaper CTA -->
    <div class="flex justify-center">
      <a
        href="#"
        class="inline-flex items-center justify-center px-5 py-3.5 rounded-lg border border-neutral-200 bg-generic-00 font-body font-medium text-neutral-700 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] shadow-xs hover:bg-neutral-50 hover:border-neutral-300 transition-colors no-underline"
      >
        Download Whitepaper
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    let timer = null;
    let currentIndex = 0;
    const INTERVAL_MS = 4000;

    function setupBusinessTabs() {
      const section = document.getElementById("business");
      const scrollContainer = document.getElementById("business-tabs-scroll");
      const container = document.getElementById("business-tabs-container");
      const tabButtons = document.querySelectorAll("[data-business-tab]");
      const cardsGrid = document.getElementById("business-cards-grid");
      if (!tabButtons.length || !container || !scrollContainer) return;

      if (container.dataset.tabsInitialized === "true") return;
      container.dataset.tabsInitialized = "true";

      // Initialize current index based on active tab
      tabButtons.forEach((btn, idx) => {
        if (btn.getAttribute("aria-selected") === "true") {
          currentIndex = idx;
        }
      });

      function activateTab(index) {
        currentIndex = index;
        const targetBtn = tabButtons[index];
        if (!targetBtn) return;

        tabButtons.forEach((btn) => {
          btn.classList.remove(
            "active",
            "bg-generic-00",
            "text-nova-blue",
            "shadow-xs",
          );
          btn.classList.add(
            "text-neutral-700",
            "bg-transparent",
            "hover:text-vault-navy",
          );
          btn.setAttribute("aria-selected", "false");
        });

        targetBtn.classList.remove(
          "text-neutral-700",
          "bg-transparent",
          "hover:text-vault-navy",
        );
        targetBtn.classList.add(
          "active",
          "bg-generic-00",
          "text-nova-blue",
          "shadow-xs",
        );
        targetBtn.setAttribute("aria-selected", "true");

        // Subtle cross-fade animation feedback on cards
        if (cardsGrid) {
          cardsGrid.classList.add("opacity-70");
          setTimeout(() => {
            cardsGrid.classList.remove("opacity-70");
          }, 150);
        }

        // Scroll ONLY the horizontal tab container without affecting window scroll position
        const targetLeft =
          targetBtn.offsetLeft -
          scrollContainer.clientWidth / 2 +
          targetBtn.clientWidth / 2;

        scrollContainer.scrollTo({
          left: Math.max(0, targetLeft),
          behavior: "smooth",
        });
      }

      function nextTab() {
        const nextIndex = (currentIndex + 1) % tabButtons.length;
        activateTab(nextIndex);
      }

      function startTimer() {
        stopTimer();
        timer = setInterval(nextTab, INTERVAL_MS);
      }

      function stopTimer() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      // Manual click interaction: immediately switch and restart the 4s countdown
      tabButtons.forEach((button, idx) => {
        button.addEventListener("click", () => {
          activateTab(idx);
          startTimer();
        });
      });

      // Pause when browser tab is inactive, resume immediately when active
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          stopTimer();
        } else {
          startTimer();
        }
      });

      // Only auto-swap when the Business section is visible in the viewport
      if ("IntersectionObserver" in window && section) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                startTimer();
              } else {
                stopTimer();
              }
            });
          },
          { threshold: 0.1 }
        );
        observer.observe(section);
      } else {
        startTimer();
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupBusinessTabs);
    } else {
      setupBusinessTabs();
    }
  })();
</script>
