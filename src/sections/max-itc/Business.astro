// Default active tab: "Hospitality & Real estate" (matches the Figma design)
const defaultActiveIndex = 6;
---

<section id="business" class="bg-generic-00 py-16 md:py-20">
  <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
    <!-- Header -->
    <div class="text-center max-w-139 mx-auto mb-6 sm:mb-8">
      <h2 class="m-0 text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-vault-navy font-heading mb-3 sm:mb-4">
        India's first end-to-end solution to maximize ITC for businesses
      </h2>
      <p class="m-0 text-neutral-500 font-normal text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] font-body">
        We've unblocked over{" "}
        <span class="font-bold text-neutral-500">₹ 9000 crores</span> for{" "}
        <span class="font-bold text-neutral-500">3000+ businesses</span>
      </p>
    </div>

    <!-- Tabs Navigation Bar (Centered on desktop, smoothly scrollable on mobile) -->
    <div
      id="business-tabs-scroll"
      class="w-full overflow-x-auto overscroll-x-contain [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden py-2 mb-8 md:mb-10 flex [-webkit-overflow-scrolling:touch]"
    >
      <div
        id="business-tabs-container"
        class="inline-flex items-center gap-1 p-1.5 bg-neutral-100 rounded-xl sm:rounded-2xl shrink-0 min-w-max mx-auto"
        role="tablist"
      >
        {industries.map((item, index) => {
          const isActive = index === defaultActiveIndex;
          return (
            <button
              type="button"
              role="tab"
              data-business-tab={index}
              aria-selected={isActive ? "true" : "false"}
              class={`px-3.5 sm:px-4 py-2 font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium rounded-lg sm:rounded-xl border-0 transition-all duration-200 ease-in-out cursor-pointer outline-none select-none whitespace-nowrap shrink-0 ${
                isActive
                  ? "active bg-generic-00 text-nova-blue shadow-xs"
                  : "text-neutral-700 bg-transparent hover:text-vault-navy"
              }`}
            >
              {item.tab}
            </button>
          );
        })}
      </div>
    </div>

    <!-- 4 Cards Grid (one set per industry tab, active tab visible) -->
    <div id="business-cards-container" class="relative mb-6 sm:mb-8">
      {industries.map((item, index) => {
        const isActive = index === defaultActiveIndex;
        return (
          <div
            data-business-cards-group={index}
            class={`grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 md:gap-6 transition-opacity duration-200 ease-out ${
              isActive ? "" : "hidden"
            }`}
          >
            {item.logos.map((logo) => (
              <div class="w-full aspect-[16/9] rounded-xl border border-[#CCCCCC] bg-generic-00 flex items-center justify-center p-4 sm:p-6">
                <div class="w-full h-full flex items-center justify-center">
                  <img
                    src={logo.src}
                    alt={logo.name}
                    width={logo.width}
                    height={logo.height}
                    style={`--logo-width: ${logo.width}px; --logo-height: ${logo.height}px;`}
                    class="w-auto h-auto max-w-[75%] max-h-[48px] sm:max-w-[var(--logo-width)] sm:max-h-[var(--logo-height)] object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            ))}
          </div>
        );
      })}
    </div>

    <!-- Download Whitepaper CTA -->
    <div class="flex justify-center">
      <a
        href="#"
        class="inline-flex items-center justify-center px-4.5 py-2 rounded-lg border border-neutral-200 bg-generic-00 font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] shadow-xs hover:bg-neutral-50 hover:border-neutral-300 transition-colors no-underline"
      >
        Download Whitepaper
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    let timer = null;
    let currentIndex = 0;
    const INTERVAL_MS = 4000;

    function setupBusinessTabs() {
      const section = document.getElementById("business");
      const scrollContainer = document.getElementById("business-tabs-scroll");
      const container = document.getElementById("business-tabs-container");
      const tabButtons = document.querySelectorAll("[data-business-tab]");
      if (!tabButtons.length || !container || !scrollContainer) return;

      if (container.dataset.tabsInitialized === "true") return;
      container.dataset.tabsInitialized = "true";

      // Initialize current index based on active tab
      tabButtons.forEach((btn, idx) => {
        if (btn.getAttribute("aria-selected") === "true") {
          currentIndex = idx;
        }
      });

      // Scroll initial active tab into view horizontally if not the first tab
      if (currentIndex > 0) {
        const activeBtn = tabButtons[currentIndex];
        if (activeBtn) {
          const targetLeft =
            activeBtn.offsetLeft -
            scrollContainer.clientWidth / 2 +
            activeBtn.clientWidth / 2;
          scrollContainer.scrollTo({
            left: Math.max(0, targetLeft),
            behavior: "auto",
          });
        }
      }

      function activateTab(index) {
        currentIndex = index;
        const targetBtn = tabButtons[index];
        if (!targetBtn) return;

        tabButtons.forEach((btn) => {
          btn.classList.remove(
            "active",
            "bg-generic-00",
            "text-nova-blue",
            "shadow-xs",
          );
          btn.classList.add(
            "text-neutral-700",
            "bg-transparent",
            "hover:text-vault-navy",
          );
          btn.setAttribute("aria-selected", "false");
        });

        targetBtn.classList.remove(
          "text-neutral-700",
          "bg-transparent",
          "hover:text-vault-navy",
        );
        targetBtn.classList.add(
          "active",
          "bg-generic-00",
          "text-nova-blue",
          "shadow-xs",
        );
        targetBtn.setAttribute("aria-selected", "true");

        // Swap cards group with smooth subtle fade
        const allGroups = document.querySelectorAll(
          "[data-business-cards-group]",
        );
        allGroups.forEach((group) => {
          const groupIndex = group.getAttribute("data-business-cards-group");
          if (groupIndex === String(index)) {
            group.classList.remove("hidden");
            group.classList.add("opacity-70");
            setTimeout(() => {
              group.classList.remove("opacity-70");
            }, 150);
          } else {
            group.classList.add("hidden");
          }
        });

        // Scroll ONLY the horizontal tab container without affecting window scroll position
        const targetLeft =
          targetBtn.offsetLeft -
          scrollContainer.clientWidth / 2 +
          targetBtn.clientWidth / 2;

        scrollContainer.scrollTo({
          left: Math.max(0, targetLeft),
          behavior: "smooth",
        });
      }

      function nextTab() {
        const nextIndex = (currentIndex + 1) % tabButtons.length;
        activateTab(nextIndex);
      }

      function startTimer() {
        stopTimer();
        timer = setInterval(nextTab, INTERVAL_MS);
      }

      function stopTimer() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      // Manual click interaction: immediately switch and restart the 4s countdown
      tabButtons.forEach((button, idx) => {
        button.addEventListener("click", () => {
          activateTab(idx);
          startTimer();
        });
      });

      // Pause when browser tab is inactive, resume immediately when active
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          stopTimer();
        } else {
          startTimer();
        }
      });

      // Only auto-swap when the Business section is visible in the viewport
      if ("IntersectionObserver" in window && section) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                startTimer();
              } else {
                stopTimer();
              }
            });
          },
          { threshold: 0.1 },
        );
        observer.observe(section);
      } else {
        startTimer();
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupBusinessTabs);
    } else {
      setupBusinessTabs();
    }
  })();
</script>
