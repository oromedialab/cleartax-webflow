---
/**
 * Journey section for Max ITC — "Put your ITC journey on auto pilot".
 */

interface JourneyFeature {
  title: string;
  description: string;
}

const features: JourneyFeature[] = [
  {
    title: "Manage Vendor Payments",
    description: "Auto-manage payments using smart vendor risk categorisation",
  },
  {
    title: "Real Time ERP sync",
    description: "2-way flow with ERP to schedule auto-recon in the background",
  },
  {
    title: "AI-based matching",
    description: "Minimise manual reconciliation with industry-leading engine",
  },
  {
    title: "Vendor communication",
    description: "One-click communication with vendors across email, WhatsApp",
  },
  {
    title: "Cross-team collaboration",
    description: "Seamless collaboration across IDT, Procurement and AP teams",
  },
  {
    title: "Intelligent reports",
    description: "Smart suggestions to help you make decisions & avoid notices",
  },
];
---

<section id="journey" class="py-16 md:py-20 bg-generic-00">
  <div class="mx-auto w-full max-w-[var(--container-max)] px-4 md:px-6">
    <!-- Centered Header -->
    <div class="text-center max-w-150 mx-auto mb-10 md:mb-14">
      <h2 class="text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-vault-navy font-heading mb-3 md:mb-4">
        Put your ITC journey on auto pilot
      </h2>
      <p class="font-body text-neutral-500 text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)]">
        Exclusive features that completely automate the ITC claim process.
      </p>
    </div>

    <!-- 6-Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6 w-full">
      {features.map((item) => (
        <div class="bg-generic-00 border border-neutral-200 rounded-lg p-6 flex flex-col justify-start">
          <!-- Icon Placeholder -->
          <div
            class="w-14 h-14 bg-visual-placeholder rounded-lg mb-4 shrink-0"
            aria-hidden="true"
          />

          <!-- Feature Title -->
          <h3 class="font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] mb-2">
            {item.title}
          </h3>

          <!-- Feature Description -->
          <p class="font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] m-0">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
