---
/**
 * Hero — Max ITC.
 *
 * Two-column bordered hero card:
 * - Left column: "Did you know?" badge, headline with lime highlight "profits by 7%",
 *   supporting copy, and "Book a Demo" CTA button.
 * - Right column: Soft pastel green rounded visual placeholder.
 * - Bottom row: "Trusted by 6,000+ enterprises" + marquee of client logos.
 *
 * Over an interactive Dotgrid + radial wash.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

const logos: { src: string; alt: string }[] = [
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc646a365fcbc02c11af3_brand-13-img.png",
    alt: "Bosch logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc60a6c38dc1440e954cd_brand-3-img.png",
    alt: "3M logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc64da365fcbc02c11de4_brand-14-img.png",
    alt: "Honda logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc65af3eec20e67f5cd1c_brand-16-img.png",
    alt: "Marriott logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc628ad92208b0c0d0bcf_brand-8-img.png",
    alt: "ExxonMobil logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc6116c38dc1440e9643c_brand-4-img.png",
    alt: "Coca-Cola logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc623c06d0a708d98acf5_brand-7-img.png",
    alt: "Reckitt logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc5fd373e2872bd820152_brand-1-img.png",
    alt: "Schneider Electric logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc6046e7426adbd019ed6_brand-2-img.png",
    alt: "Acer logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc61609b3bd73c0f39c81_brand-5-img.png",
    alt: "Hitachi logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc61c3ca1726d5e2aa651_brand-6-img.png",
    alt: "Volvo logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc62fe6176c452e670d85_brand-9-img.png",
    alt: "Carlsberg Group logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc63571c2777eb595fc0a_brand-10-img.png",
    alt: "IKEA logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc63b994e6f0061916071_brand-11-img.png",
    alt: "L'Oréal logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc6410183fdb4f4d5dc99_brand-12-img.png",
    alt: "Lufthansa logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc654a4df647a7bb2f894_brand-15-img.png",
    alt: "Adidas logo",
  },
  {
    src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a2fc661da8cceda23ec5615_brand-17-img.png",
    alt: "Dolce & Gabbana logo",
  },
];

const marqueeLogos = [...logos, ...logos];
---

<section
  id="hero"
  class="relative bg-generic-00 overflow-hidden pt-32 pb-16 lg:pt-[calc(var(--nav-clear)+32px)] lg:pb-20"
>
  <Dotgrid containerId="hero" baseColor="#C8F006" />

  <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)] pointer-events-none"></div>

  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6 relative z-10">
    <div class="relative overflow-hidden rounded-xl border border-neutral-200 bg-generic-00 p-6 sm:p-8 lg:p-12 shadow-sm flex flex-col gap-8 lg:gap-10">
      <!-- Top 2-Column Section -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left Column: Copy & Actions -->
        <div class="lg:col-span-6 flex flex-col items-start gap-5 sm:gap-6">
          <!-- Pill badge -->
          <div class="inline-flex items-center gap-2.5 sm:gap-3 px-3.5 py-1.5 rounded-full border border-neutral-200 bg-generic-00">
            <span class="font-heading font-medium text-vault-navy text-[length:var(--fs-body-sm)]">
              Did you know?
            </span>
            <span class="w-px h-3.5 bg-neutral-200"></span>
            <span class="font-body text-vault-navy text-[length:var(--fs-body-sm)]">
              95% of Indian businesses claim less ITC
            </span>
          </div>

          <!-- Headline -->
          <h1 class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] lg:text-[length:var(--fs-display-lg)] lg:leading-[length:var(--lh-display-lg)] tracking-[-1px]">
            Our customers grow <br />
            their{" "}
            <span class="bg-[#D9FA3C] text-vault-navy px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-lg inline-block">
              profits by 7%
            </span>
          </h1>

          <!-- Subtitle -->
          <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] max-w-[500px]">
            We help enterprises unblock working capital through 100% ITC claims,
            which most tax teams face a challenge with.
          </p>

          <!-- CTA Button -->
          <div class="pt-1">
            <a
              href="https://www.cleartax.com/contact-us"
              data-demo-open
              class="inline-flex items-center justify-center gap-2 px-5 py-3.5 font-body rounded-lg font-medium text-nova-50 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] cursor-pointer bg-nova-blue border border-nova-blue hover:bg-nova-50 hover:text-nova-blue transition-all duration-150 ease-in-out no-underline"
            >
              Book a Demo
            </a>
          </div>
        </div>

        <!-- Right Column: Visual Placeholder Box -->
        <div class="lg:col-span-6 w-full flex items-center justify-center">
          <div class="w-full max-w-[553px] aspect-[553/311] bg-visual-placeholder rounded-lg"></div>
        </div>
      </div>

      <!-- Bottom Row: Trusted by 6,000+ enterprises + Logostrip -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 pt-4 sm:pt-6 w-full">
        <span class="shrink-0 font-heading font-semibold text-vault-navy text-sm sm:text-base">
          Trusted by 6,000+ enterprises
        </span>
        <div class="rc-hero-marquee relative w-full overflow-hidden flex-1">
          <div class="rc-hero-marquee-track flex items-center gap-2.5 sm:gap-3 w-max motion-reduce:animate-none">
            {marqueeLogos.map((logo, i) => (
              <span class="flex h-12 w-[104px] sm:w-[120px] shrink-0 items-center justify-center rounded-lg bg-neutral-100">
                <img
                  src={logo.src}
                  alt={logo.alt}
                  aria-hidden={i >= logos.length}
                  class="h-[24px] max-w-[80px] sm:max-w-[86px] object-contain mix-blend-multiply"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Prefixed rc-hero- so it can't collide with another section's marquee on
     the same page — see docs' "Section CSS is unscoped and shared per page". */
  .rc-hero-marquee {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 6%,
      #000 94%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 6%,
      #000 94%,
      transparent 100%
    );
  }

  .rc-hero-marquee-track {
    animation: rc-hero-marquee-scroll 40s linear infinite;
  }

  .rc-hero-marquee:hover .rc-hero-marquee-track {
    animation-play-state: paused;
  }

  @keyframes rc-hero-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
