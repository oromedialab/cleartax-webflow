---
/**
 * Hero section for Max ITC.
 */
---

<section id="hero" class="relative bg-generic-00 overflow-hidden flex items-center max-lg:pt-32 max-lg:pb-16 lg:pt-[200px] lg:pb-[120px]">
  <div class="relative z-10 mx-auto container w-full px-4 lg:px-8">
    <div class="flex flex-col items-center gap-6 mx-auto text-center max-w-[920px]">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-nova-blue bg-nova-50 border border-nova-100">
        Max ITC
      </span>
      <h1 class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h1)] lg:text-[length:var(--fs-display-sm)] xl:text-[length:var(--fs-display-lg)] leading-tight tracking-[-1px]">
        Maximize your Input Tax Credit with automated, 100% compliant reconciliation
      </h1>
      <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-relaxed max-w-[700px]">
        ClearTax Max ITC brings together every GST document, transaction, and matching rule across your entire business into one governed workflow. Never miss a credit, never duplicate an entry.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 mt-2">
        <a
          href="https://www.cleartax.com/contact-us"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg font-medium text-white bg-nova-blue hover:bg-nova-600 transition-colors shadow-sm"
        >
          Book a demo
        </a>
      </div>
    </div>
  </div>
</section>
