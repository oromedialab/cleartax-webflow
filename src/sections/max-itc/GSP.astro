---
/**
 * GSP section for Max ITC — "100% peace of mind".
 */

interface Pillar {
  title: string;
  description: string;
  icon:string;
}

const pillars: Pillar[] = [
  {
    title: "Encryption",
    description:
      "Your data is transmitted across SSL certified pathways. We are SOC 2 compliant.",
      icon:"images/max-itc/gsp-1.png"
  },
  {
    title: "Privacy",
    description:
      "We do not share your or your clients' data with unaffiliated third parties for their own purposes.",
      icon:"images/max-itc/gsp-2.png",
  },
  {
    title: "Data Storage",
    description:
      "We use ISO 27001 certified data centres, which are quarterly VAPT tested and externally audited.",
    icon:"images/max-itc/gsp-3.png",  
  },
];
---

<section id="gsp" class="py-16 md:py-20 bg-generic-00">
  <div class="mx-auto w-full max-w-[1000px] px-4 md:px-6">
    <!-- Centered Header -->
    <div class="text-center max-w-139 mx-auto mb-12">
      <h2 class="m-0 text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-vault-navy font-heading mb-4">
        100% peace of mind
      </h2>
      <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)]">
        We were awarded a GSP license after rigorous scrutiny of our
        technological and financial capabilities to serve our clients.
      </p>
    </div>

    <!-- 4 Visual Placeholder Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 md:mb-16">
      {[1, 2, 3, 4].map(() => (
        <div
          class="w-full aspect-[232/232] max-w-[232px] rounded-lg border border-neutral-300 bg-visual-placeholder"
          aria-hidden="true"
        />
      ))}
    </div>

    <!-- 3 Pillars Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 divide-y divide-neutral-200 md:divide-y-0 md:gap-8">
      {pillars.map((item) => (
        <div class="flex flex-row items-start gap-3.5 sm:gap-4 py-5 first:pt-0 last:pb-0 md:py-0 md:flex-col md:gap-0 justify-start">
          <!-- Icon Placeholder -->
          <img src={item.icon} alt="" class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 md:mb-4 shrink-0" />

          <div class="flex flex-col">
            <!-- Title (20px via var) -->
            <h3 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] mb-1 sm:mb-2">
              {item.title}
            </h3>

            <!-- Description (16px via var) -->
            <p class="font-body text-neutral-500 text-xs sm:text-[length:var(--fs-body)] leading-relaxed sm:leading-[length:var(--lh-body)] m-0 md:max-w-68">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
