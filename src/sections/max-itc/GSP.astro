---
/**
 * GSP section for Max ITC — "100% peace of mind".
 */

interface Pillar {
  title: string;
  description: string;
}

const pillars: Pillar[] = [
  {
    title: "Encryption",
    description:
      "Your data is transmitted across SSL certified pathways. We are SOC 2 compliant.",
  },
  {
    title: "Privacy",
    description:
      "We do not share your or your clients' data with unaffiliated third parties for their own purposes.",
  },
  {
    title: "Data Storage",
    description:
      "We use ISO 27001 certified data centres, which are quarterly VAPT tested and externally audited.",
  },
];
---

<section id="gsp" class="py-16 md:py-20 bg-generic-00">
  <div class="mx-auto w-full max-w-[1000px] px-4 md:px-6">
    <!-- Centered Header -->
    <div class="text-center max-w-139 mx-auto mb-12">
      <h2 class="text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-vault-navy font-heading mb-4">
        100% peace of mind
      </h2>
      <p class="font-body text-neutral-500 text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)]">
        We were awarded a GSP license after rigorous scrutiny of our
        technological and financial capabilities to serve our clients.
      </p>
    </div>

    <!-- 4 Visual Placeholder Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 md:mb-16">
      {[1, 2, 3, 4].map(() => (
        <div
          class="w-full aspect-[232/232] max-w-[232px] rounded-lg border border-neutral-300 bg-visual-placeholder"
          aria-hidden="true"
        />
      ))}
    </div>

    <!-- 3 Pillars Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {pillars.map((item) => (
        <div class="flex flex-col justify-start">
          <!-- Icon Placeholder -->
          <div
            class="w-14 h-14 bg-visual-placeholder rounded-lg mb-4 shrink-0"
            aria-hidden="true"
          />

          <!-- Title (20px via var) -->
          <h3 class="font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] mb-2">
            {item.title}
          </h3>

          <!-- Description (16px via var) -->
          <p class="font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] m-0 max-w-68">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
