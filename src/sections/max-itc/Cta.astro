---
/**
 * CTA section for Max ITC.
 */
---

<section id="cta" class="py-16 lg:py-24 bg-vault-navy text-white">
  <div class="mx-auto container px-4 lg:px-8 text-center max-w-[800px]">
    <h2 class="font-heading font-semibold text-3xl lg:text-5xl tracking-tight mb-6 text-white">
      Ready to claim 100% of your eligible ITC?
    </h2>
    <p class="font-body text-neutral-300 text-base lg:text-lg mb-8">
      Join leading enterprises that trust ClearTax for zero-loss GST reconciliation.
    </p>
    <a
      href="https://www.cleartax.com/contact-us"
      class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg font-medium text-vault-navy bg-white hover:bg-neutral-100 transition-colors shadow-sm"
    >
      Schedule a Consultation
    </a>
  </div>
</section>
