---
/**
 * FAQ section for Max ITC.
 * Built on `_shared/FaqRb.astro`.
 */
import FaqRb from "../_shared/FaqRb.astro";

const items = [
  {
    q: "How does ClearTax Max ITC help in maximizing Input Tax Credit?",
    a: "ClearTax Max ITC reconciles data across ERP purchase registers and GSTR-2B using advanced matching rules and AI. It flags missing invoices, unmatched values, and supplier non-compliance so you claim 100% of eligible ITC before deadlines.",
  },
  {
    q: "Can Max ITC integrate with our existing ERP?",
    a: "Yes. ClearTax provides pre-built, bi-directional connectors and APIs for major ERPs including SAP (ECC and S/4HANA), Oracle, Microsoft Dynamics, Tally, and custom ERP systems.",
  },
  {
    q: "How does Max ITC handle vendor communication?",
    a: "Max ITC automates communication with vendors via email and WhatsApp, sharing exact invoice discrepancies, return filing delays, and automated reminders to upload missing invoices.",
  },
  {
    q: "How does it protect against vendor non-compliance under GST laws?",
    a: "ClearTax Max ITC scores vendors on their GST compliance history, tracking whether suppliers have filed GSTR-1 and GSTR-3B. It enables dynamic payment blocking or withholding for defaulting suppliers.",
  },
];
---

<FaqRb items={items} subtitle="" />
