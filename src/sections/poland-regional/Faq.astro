---
/**
 * FAQ for the Poland regional page.
 *
 * Structure, styling and behaviour live in `_shared/FaqRb.astro`; this file
 * owns the content. Props must be supplied here, inside a section file,
 * because the embed route renders sections with no props.
 *
 * The Figma has no subtitle under the heading, so an empty one is passed —
 * `FaqRb` omits the paragraph when it is empty. Ten questions, first open,
 * remaining behind "Load more" after five.
 */
import FaqRb from "../_shared/FaqRb.astro";
import type { FaqItem } from "../_shared/FaqRb.astro";

const items: FaqItem[] = [
    {
        q: "Is e-invoicing mandatory in Poland?",
        a: [
            {
                kind: "p",
                html: "Yes, for taxpayers and invoices within the mandatory KSeF scope. Issuance began on 1 February 2026 for taxpayers whose 2024 sales including VAT exceeded PLN 200 million, and on 1 April 2026 for other in-scope taxpayers. Statutory exclusions and temporary relief apply; the PLN 10,000 monthly gross invoiced-sales relief ends on 31 December 2026.",
            },
        ],
    },
    {
        q: "What is KSeF?",
        a: [
            {
                kind: "p",
                html: "Krajowy System e-Faktur is Poland’s national system for structured invoice issuance, transmission, receipt, access and storage. It automatically assigns a unique identification number to an accepted invoice.",
            },
        ],
    },
    {
        q: "Which invoice format applies now?",
        a: [
            {
                kind: "p",
                html: "FA(3), in XML format, applies to structured invoices issued from 1 February 2026. It replaced FA(2), including for corrective invoices issued after the change where the original invoice used an earlier structure.",
            },
        ],
    },
    {
        q: "Can I just email a PDF invoice?",
        a: [
            {
                kind: "p",
                html: "An emailed PDF is not a KSeF structured invoice and does not, on its own, satisfy a mandatory KSeF issuance obligation. Paper or other electronic invoices may still be permitted where an applicable exclusion or transitional rule allows them. Certain buyers also receive a representation of a KSeF invoice outside the system under separate delivery rules.",
            },
        ],
    },
    {
        q: "Do I need to receive invoices through KSeF before I have to issue them?",
        a: [
            {
                kind: "p",
                html: "For relevant recipients, mandatory receipt began on 1 February 2026, independently of the later issuance phase. The exceptions in Article 106gb(4), including certain foreign entities and consumers, must be considered.",
            },
        ],
    },
    {
        q: "Are invoices to consumers mandatory in KSeF?",
        a: [
            {
                kind: "p",
                html: "No. Invoices to natural persons not conducting business are excluded from mandatory KSeF issuance, although they can be issued through KSeF voluntarily.",
            },
        ],
    },
    {
        q: "Does Polish VAT registration alone make a foreign business subject to mandatory KSeF?",
        a: [
            {
                kind: "p",
                html: "No. The VAT Act excludes issuance by taxpayers with neither a business establishment nor a fixed establishment in Poland. It also excludes certain foreign taxpayers whose Polish fixed establishment does not participate in the relevant supply. The Ministry’s tax explanations dated 28 January 2026 address fixed-establishment assessment.",
            },
        ],
    },
    {
        q: "What is the difference between my invoice number and a KSeF number?",
        a: [
            {
                kind: "p",
                html: "Your own invoice number identifies the document in your invoicing sequence. KSeF assigns a separate system reference on acceptance, returned in UPO. Keep the two references linked in your finance workflow.",
            },
        ],
    },
    {
        q: "What happens if I need to use offline24?",
        a: [
            {
                kind: "p",
                html: "Under offline24, issue an electronic invoice using the applicable structured format and transmit it to KSeF without delay, normally no later than the next working day after issuance. An officially announced outage can change the applicable procedure. Buyer-delivery and QR-code requirements also need to be assessed; offline24 is not an indefinite permission to invoice outside KSeF. Legal basis: VAT Act Article 106nda.",
            },
        ],
    },
    {
        q: "How does ClearTax support Poland e-invoicing?",
        a: [
            {
                kind: "p",
                html: "ClearTax’s public Poland offering describes ERP/API integration, invoice-data validation, direct KSeF integration, submission, status dashboards, reconciliation and onboarding support. Confirm the specific connectors, transaction coverage and operating requirements for your deployment during the demo.",
            },
        ],
    },
];
---

<FaqRb items={items} subtitle="" />
