---
/**
 * "5 Steps to Strengthen Your KSeF Workflow" — Poland regional page.
 * Heading, lede and five bordered accordion rows; the first is open by default
 * and carries a bullet list.
 *
 * Open/close behaviour is the FAQ's (`_shared/FaqRb.astro`): one row open at a
 * time, height animated over 320ms.
 *
 * Classes are `pl-steps-` prefixed: section CSS is one shared namespace per page.
 */
interface Step {
    title: string;
    points?: string[];
}

const steps: Step[] = [
    {
        title: "Assess your Polish invoice landscape",
        points: [
            "Map entities, invoice volumes, billing systems and supplier-invoice processes.",
            "Confirm which flows fall within mandatory KSeF and which rely on an exclusion or transitional rule.",
            "Include incoming invoices—not just sales-invoice submission—in the assessment.",
        ],
    },
    {
        title: "Set up access and ownership",
        points: [
            "Confirm who is authorised to act for each taxpayer in KSeF.",
            "Assign responsibilities across finance, tax, IT and implementation teams.",
            "Document how access is reviewed and how operational issues are escalated.",
        ],
    },
    {
        title: "Prepare and map your invoice data",
        points: [
            "Review customer and supplier identifiers, addresses, invoice references and transaction data.",
            "Map source-system data to the applicable FA(3) requirements.",
            "Assign owners for missing information and validation failures.",
        ],
    },
    {
        title: "Integrate and test the complete flow",
        points: [
            "Test representative sales and purchase scenarios, including corrective and advance invoices.",
            "Check acceptance statuses, rejection handling, KSeF references and access to submission confirmations.",
            "Include exception handling and the required offline or outage procedures in the test plan.",
        ],
    },
    {
        title: "Monitor, reconcile and improve",
        points: [
            "Review invoice statuses and unresolved exceptions regularly.",
            "Compare ERP records with the invoices processed through the government system.",
            "Keep an owner for regulatory updates and the end of temporary relief.",
        ],
    },
];
---

<section class="bg-generic-00 py-16 lg:py-20">
    <div
        class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12"
    >
        <div class="flex flex-col items-center gap-4 text-center">
            <h2
                class="m-0 max-w-183 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
            >
                5 Steps to Strengthen Your KSeF Workflow
            </h2>
            <p
                class="m-0 max-w-181 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]"
            >
                Whether you are improving an existing setup or moving from a
                temporary transition arrangement, start with your entities, data
                and day-to-day finance processes.
            </p>
        </div>

        <div class="flex w-full flex-col gap-3" data-pl-steps-root>
            {
                steps.map((s, i) =>
                    s.points ? (
                        <div
                            class={`pl-steps-item group rounded-xl border border-neutral-300 bg-generic-00 px-6 ${i === 0 ? "pl-steps-open" : ""}`}
                        >
                            <button
                                type="button"
                                class="pl-steps-trigger flex w-full appearance-none items-center justify-between gap-3 border-0 bg-transparent py-6 text-left cursor-pointer font-body font-medium text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                                aria-expanded={i === 0 ? "true" : "false"}
                            >
                                <span class="min-w-0 flex-1">{s.title}</span>
                                <svg
                                    class="size-6 shrink-0 transition-transform duration-300 ease-in-out group-[.pl-steps-open]:rotate-45"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    aria-hidden="true"
                                >
                                    <path d="M12 5v14M5 12h14" />
                                </svg>
                            </button>
                            <div
                                class={`pl-steps-panel overflow-hidden transition-[height] duration-[320ms] [transition-timing-function:cubic-bezier(.4,0,.2,1)] ${i === 0 ? "h-auto" : "h-0"}`}
                            >
                                <ul class="m-0 flex list-disc flex-col gap-3 pb-6 pl-[21px] font-body text-neutral-500 text-[length:var(--fs-label)] leading-[20px]">
                                    {s.points.map((p) => (
                                        <li>{p}</li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    ) : (
                        <div class="flex items-center justify-between gap-3 rounded-xl border border-neutral-300 bg-generic-00 p-6 font-body font-medium text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                            {s.title}
                            <svg
                                class="size-6 shrink-0"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                aria-hidden="true"
                            >
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                        </div>
                    ),
                )
            }
        </div>
    </div>
</section>

<script is:inline>
    /* Same open/close logic as `_shared/FaqRb.astro`: one row open at a time, and
     the panel's height is animated from 0 to its scrollHeight, then released to
     `auto` so it can reflow. Scoped to [data-pl-steps-root] so it never touches
     the FAQ's rows. */
    (function () {
        var root = document.querySelector("[data-pl-steps-root]");
        if (!root) return;
        var items = root.querySelectorAll(".pl-steps-item");

        function closeItem(item, panel, trigger) {
            panel.style.height = panel.scrollHeight + "px";
            requestAnimationFrame(function () {
                panel.style.height = "0px";
            });
            item.classList.remove("pl-steps-open");
            trigger.setAttribute("aria-expanded", "false");
        }

        function openItem(item, panel, trigger) {
            panel.style.height = panel.scrollHeight + "px";
            item.classList.add("pl-steps-open");
            trigger.setAttribute("aria-expanded", "true");
            panel.addEventListener("transitionend", function handler(e) {
                if (e.propertyName !== "height") return;
                panel.removeEventListener("transitionend", handler);
                if (item.classList.contains("pl-steps-open"))
                    panel.style.height = "auto";
            });
        }

        items.forEach(function (item) {
            var trigger = item.querySelector(".pl-steps-trigger");
            var panel = item.querySelector(".pl-steps-panel");
            if (!trigger || !panel) return;

            trigger.addEventListener("click", function () {
                if (item.classList.contains("pl-steps-open")) {
                    closeItem(item, panel, trigger);
                    return;
                }
                items.forEach(function (other) {
                    if (
                        other === item ||
                        !other.classList.contains("pl-steps-open")
                    )
                        return;
                    var otherPanel = other.querySelector(".pl-steps-panel");
                    var otherTrigger = other.querySelector(".pl-steps-trigger");
                    if (otherPanel && otherTrigger)
                        closeItem(other, otherPanel, otherTrigger);
                });
                openItem(item, panel, trigger);
            });

            window.addEventListener("resize", function () {
                if (item.classList.contains("pl-steps-open"))
                    panel.style.height = "auto";
            });
        });
    })();
</script>
