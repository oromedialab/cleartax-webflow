---
/**
 * "Key timelines" — Poland regional page.
 *
 * One bordered table: a header row on a divider, then body rows separated by hairlines.
 *
 * CSS grid so the rows can reflow to stacked label/value pairs on small screens.
 *
 * Classes are `pl-tl-` prefixed: section CSS is one shared namespace per page.
 */
interface Props {}

const timeline = [
    [
        "1 February 2026",
        "Mandatory issuance starts for in-scope taxpayers with 2024 gross sales (including VAT) above PLN 200 million. FA(3) applies to FA invoices. Mandatory receipt through KSeF starts for relevant recipients.",
    ],
    [
        "1 April 2026",
        "Mandatory issuance extends to other in-scope taxpayers, subject to exclusions and temporary relief.",
    ],
    [
        "1 April – 31 December 2026",
        "Qualifying taxpayers may issue invoices outside KSeF in Article 145m(1) permits qualifying taxpayers to issue paper or other electronic invoices where the monthly sales including VAT documented by the relevant invoices issued in that month do not exceed PLN 10,000. Count the invoices that would otherwise be subject to mandatory KSeF, not total business turnover.",
    ],
    [
        "If the limit is exceeded:",
        "KSeF is required from the invoice that crosses the limit under Article 145m(2). A later month below the limit does not restore this relief. Independent invoice exclusions still apply.",
    ],
    [
        "1 January 2027",
        "That temporary threshold relief is no longer available. You must still assess other statutory exclusions separately.",
    ],
];
---

<section class="bg-generic-00 pt-12 pb-16 lg:pb-20">
    <div class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6">
        <div class="flex flex-col items-center">
            <h3
                class="m-0 mb-8 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h4)] leading-[length:var(--lh-h4)] tracking-[-0.5px]"
            >
                Key timelines
            </h3>
            <div
                class="w-full overflow-hidden rounded-xl border border-neutral-300 bg-generic-00"
            >
                <div
                    class="grid grid-cols-1 gap-2 p-6 lg:grid-cols-[auto_1fr] lg:gap-x-12 lg:items-center border-b border-neutral-300 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]"
                >
                    <span>Date</span>
                    <span></span>
                </div>
                {
                    timeline.map(([date, text]) => (
                        <div class="grid grid-cols-1 gap-2 p-6 lg:grid-cols-[auto_1fr] lg:gap-x-12 lg:items-center [&:not(:first-of-type)]:border-t [&:not(:first-of-type)]:border-[#F2F1F0]">
                            <span class="font-body font-medium text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                                {date}
                            </span>
                            <span class="pl-tl-cell font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] max-w-[560px] lg:justify-self-end text-left">
                                {text}
                            </span>
                        </div>
                    ))
                }
            </div>

            <div class="w-full mx-auto mt-12 flex flex-col items-center">
                <h3
                    class="m-0 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px]"
                >
                    What disconnected invoicing leaves on your team’s desk
                </h3>
                <p
                    class="text-center m-0 mt-4 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] max-w-[890px]"
                >
                    Disconnected systems cause statuses to be elusive for
                    finance, leave data missing and unresolved, and more manual
                    comparison of invoice records. ClearTax brings validation,
                    status dashboards and reconciliation into the workflow,
                    helping your team focus on exceptions rather than repeated
                    checks.
                </p>
            </div>
        </div>
    </div>
</section>
