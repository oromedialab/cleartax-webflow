---
/**
 * "How ClearTax Supports Poland E-Invoicing" — Poland regional page.
 * Eight rows, title + sub-line on the left, explanation on the right, divided by hairlines.
 *
 * Every row is drawn at 50% opacity: it is the resting state of a
 * scroll-spotlight. A small script lifts the row nearest the middle of the
 * viewport to full opacity as the section scrolls past; without script (or with
 * reduced motion) all rows stay fully legible.
 *
 * The icon squares are unfilled "Visual placeholder" frames, so
 * they render as `bg-visual-placeholder` (#E8FFE1).
 *
 * Classes and ids are `pl-cov-` prefixed: embeds share one namespace per page.
 */
interface Row {
    title: string;
    lead: string;
    body: string;
    icon: string;
}

const rows: Row[] = [
    {
        title: "Connect the systems you already use",
        lead: "Use APIs and pre-built integration options to connect ERP and financial systems.",
        body: "Use APIs and pre-built integration options to connect ERP and financial systems. Scope the right connection approach for your data sources and invoice volumes.",
        icon:"https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af58d8f8c35bfedc4b707b8_e-1.png"
    },

    {
        title: "Define pre-submission validation",
        lead: "Agree on the invoice checks and data transformations required.",
        body: "Confirm which checks are supported and how missing or inconsistent data will be resolved.",
        icon:"https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af58d947eaff3fd5ba36e66_e-2.png"
    },
    {
        title: "Catch data issues before submission",
        lead: "Clean and enrich invoice master data and validate key information before transmission.",
        body: "Help your team identify missing or inconsistent data earlier in the process.",
        icon:"https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af58d98dfc23de1ad5566c8_e-3.png"
    },
    {
        title: "Automate invoice submission to KSeF",
        lead: "Move from disconnected manual steps to a platform that integrates directly",
        body: "with KSeF and supports invoice validation and submission.",
        icon:"https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af58d9ebb13b5715de51c84_e-4.png"
    },
    {
        title: "Make invoice status actionable",
        lead: "Use dashboards to monitor invoice",
        body: "statuses, spot bottlenecks, and identify the exceptions your finance team needs to resolve.",
        icon:"https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af58da0eeead51dae04b46d_e-5.png"
    },
    {
        title: "Reconcile ERP and government invoice records",
        lead: "Compare ERP entries with government-reported invoice records.",
        body: "Surface mismatches and differences for investigation through reconciliation workflows.",
        icon:"https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af58da5999b08546331db23_e-6.png"  
    },
    {
        title: "Connect invoicing with wider VAT workflows",
        lead: "Explore ClearTax’s VAT reporting, SAF-T, and reconciliation capabilities alongside e-invoicing.",
        body: "Confirm the filing scope and implementation requirements relevant to your entities.",
        icon:"https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af58daa7c3df613b27aefae_e-7.png"
    },
    {
        title: "Move forward with implementation support",
        lead: "Work with ClearTax on onboarding, integration and operational support.",
        body: "Agree the test plan, responsibilities and support arrangements for your deployment.",
        icon:"https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6af58dafd782b866c1071623_e-8.png"
    },
];
---

<section id="pl-cov" class="bg-generic-00 py-16 lg:py-20">
    <div
        class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12"
    >
        <div class="flex flex-col items-center gap-4 text-center">
            <h2
                class="m-0 max-w-185 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
            >
                How ClearTax Supports Poland E-Invoicing
            </h2>
            <p
                class="m-0 max-w-228 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)] text-balance"
            >
                ClearTax brings integration, validation, invoice submission and
                finance visibility into a connected e-invoicing approach. Build
                the implementation around your systems and the workflows your
                team needs to control.
            </p>
        </div>

        <div class="flex w-full flex-col">
            {
                rows.map((r) => (
                    <div class="pl-cov-row grid grid-cols-1 gap-4 py-6 lg:grid-cols-2 lg:gap-12">
                        <div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 lg:gap-y-2">
                            <img src={r.icon} alt="" class="size-[56px] shrink-0 self-center lg:self-start lg:row-span-2" />
                            <h3 class="m-0 font-heading font-medium text-[19px] leading-[26.6px] text-vault-navy self-center lg:self-start max-w-[370px]">
                                {r.title}
                            </h3>
                            <p class="m-0 font-body text-[13.3px] leading-[19px] text-vault-navy col-span-2 lg:col-span-1 lg:col-start-2 max-w-[370px]">
                                {r.lead}
                            </p>
                        </div>
                        <p class="m-0 self-center font-body text-neutral-500 w-full lg:w-114 max-w-114 text-[13.3px] leading-[19px] lg:justify-self-end">
                            {r.body}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style is:global>
    .pl-cov-row + .pl-cov-row {
        border-top: 1px solid var(--palette-ledger-white);
    }
    .pl-cov-js .pl-cov-row {
        opacity: 0.5;
        scale: 0.95;
        transition: all 0.3s ease-in-out;
    }
    .pl-cov-js .pl-cov-row.is-active {
        opacity: 1;
        scale: 1;
        transition: all 0.3s ease-in-out;
    }
</style>

<script is:inline>
    (function () {
        var section = document.getElementById("pl-cov");
        if (!section) return;
        if (
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        )
            return;
        var rows = section.querySelectorAll(".pl-cov-row");
        if (!rows.length) return;

        section.classList.add("pl-cov-js");

        // The row whose centre is closest to the middle of the viewport is "on".
        function update() {
            var mid = window.innerHeight / 2;
            var best = null;
            var bestDist = Infinity;
            rows.forEach(function (row) {
                var rect = row.getBoundingClientRect();
                var dist = Math.abs(rect.top + rect.height / 2 - mid);
                if (dist < bestDist) {
                    bestDist = dist;
                    best = row;
                }
            });
            rows.forEach(function (row) {
                row.classList.toggle("is-active", row === best);
            });
        }

        var ticking = false;
        function onScroll() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(function () {
                ticking = false;
                update();
            });
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();
    })();
</script>
