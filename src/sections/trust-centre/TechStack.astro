---
/**
 * Closing band — Figma node 15026:12594 ("Container - Partner program - WIP").
 *
 * Same background stack as the hero, in Nova Blue rather than Flux Lime: the
 * shared stroke field, then the page gradient over it. Flux Lime is spent on
 * the hero headline — one instance per screen.
 *
 * The right-hand panel is the Figma "Image holder" with nothing placed in it, so
 * it ships as the brand's Visual Placeholder tint at the drawn 600×314. Swap it
 * for an `<img>` when the artwork exists.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

const lineWidth = 3;
const gap = 24;
const maxLength = 6;
const lengthRadius = 260;
const tilt = 1;
const baseColor = "rgba(84, 70, 255, 0.5)";
const cursorRadius = 320;
const pull = 14;
const fadeRadius = 40;
---

<section
  id="tc-techstack"
  class="relative overflow-hidden bg-[linear-gradient(180deg,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(242,_241,_240,_0.25)_87.79%,_#FFF_100%)] py-12 lg:py-20"
>
  <Dotgrid
    containerId="tc-techstack"
    lineWidth={lineWidth}
    gap={gap}
    maxLength={maxLength}
    lengthRadius={lengthRadius}
    tilt={tilt}
    baseColor={baseColor}
    cursorRadius={cursorRadius}
    pull={pull}
    fadeRadius={fadeRadius}
  />

  <!-- Radial wash, so the copy keeps its contrast over the field. Same stops
       as `trust-centre/Hero.astro`, but NOT the same shape: the hero centres
       its text, this band puts it in a 540px column on the left. A
       `circle at center` wash would brighten the gap between the copy and the
       image panel and leave the words themselves over bare strokes, so on
       desktop it becomes an ellipse sitting over that column — 24% is roughly
       its centre once the 1280px content area is centred in the viewport.
       Below `lg` the layout stacks and the copy is full width, so the plain
       centred circle is correct again. -->
  <div
    class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_40.04%,_rgba(255,255,255,0)_75%)] lg:bg-[radial-gradient(ellipse_45%_80%_at_24%_50%,_#FFF_0%,_rgba(242,_241,_240,_0.25)_50%,_rgba(255,255,255,0)_72%)]"
  >
  </div>

  <div class="container pointer-events-auto relative z-10 mx-auto">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-[140px]">
      <div class="flex flex-col gap-6 lg:w-[540px] lg:shrink-0">
        <div class="flex flex-col gap-2">
          <p
            class="m-0 font-body font-semibold uppercase text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] tracking-[1px]"
          >
            Ecosystem and integrations
          </p>
          <h2
            class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] tracking-[-0.5px]"
          >
            Built-in security across your tech stack
          </h2>
        </div>

        <div class="flex flex-col gap-8 lg:gap-12">
          <p
            class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
          >
            Security does not stop at the platform boundary. When ClearTax
            connects to your ERP, procurement system, or government portal, those
            connections carry the same security standards as the core platform.
          </p>

          <a
            href="https://www.cleartax.com/contact-us"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 font-body font-medium text-nova-50 text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)] no-underline shadow-[0px_2px_3px_rgba(16,24,40,0.06)] transition-all duration-200 ease-in-out hover:bg-generic-00 hover:text-nova-blue sm:w-60"
          >
            Request a demo
          </a>
        </div>
      </div>

      <div
        class="h-[220px] w-full rounded-lg bg-visual-placeholder lg:h-[314px] lg:w-[600px] lg:shrink-0"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</section>
