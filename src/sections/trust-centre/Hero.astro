---
/**
 * Trust Centre hero — Figma node 15026:9973 ("Container - Hero").
 *
 * Two background layers over a white section, both lifted from
 * `scale-and-security-page/Hero.astro` because the mock draws the same thing:
 * the shared interactive stroke field in Flux Lime, then a radial white wash so
 * the headline keeps its contrast over it.
 *
 * "Trust Centre" carries the page's single Flux Lime highlight — the brand
 * allows one per screen, which is why nothing below this section uses it.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

/* Grid geometry. lineWidth + gap is the field's pitch (26px); maxLength must
   stay under it or the strokes knit into a mesh. The long explanation lives in
   `sections/blog-listing/Newsletter.astro`. */
const lineWidth = 3;
const gap = 24;
const maxLength = 6;
const lengthRadius = 260;
const tilt = 1;
const baseColor = "#C8F006";
const cursorRadius = 320;
const pull = 14;
const fadeRadius = 40;

const titlePrefix = "Global ";
const titleHighlight = "Trust Centre";
const description =
  "Our commitment to your security, privacy, and compliance.";
---

<section
  id="tc-hero"
  class="relative flex flex-col overflow-hidden bg-generic-00 max-lg:pt-32 max-lg:pb-16 lg:pt-[264px] lg:pb-[184px]"
>
  <Dotgrid
    containerId="tc-hero"
    lineWidth={lineWidth}
    gap={gap}
    maxLength={maxLength}
    lengthRadius={lengthRadius}
    tilt={tilt}
    baseColor={baseColor}
    cursorRadius={cursorRadius}
    pull={pull}
    fadeRadius={fadeRadius}
  />

  <!-- Radial wash, so the headline keeps its contrast over the field -->
  <div
    class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)]"
  >
  </div>

  <div class="container pointer-events-auto relative z-10 mx-auto">
    <div class="mx-auto flex max-w-[688px] flex-col items-center gap-6 text-center">
      <h1
        class="m-0 font-heading font-semibold text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] lg:text-[length:var(--fs-display-lg)] lg:leading-[length:var(--lh-display-lg)] tracking-[-1px]"
      >
        {titlePrefix}<span class="rounded-xl bg-flux-lime px-1 text-vault-navy"
          >{titleHighlight}</span
        >
      </h1>
      <p
        class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-lg)] sm:leading-[length:var(--lh-body-lg)]"
      >
        {description}
      </p>
    </div>
  </div>
</section>
