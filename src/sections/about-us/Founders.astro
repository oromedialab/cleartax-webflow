---
/**
 * Meet our founders — Figma node 14140:57001.
 *
 * Three equal cards: name and role at the top, portrait filling the rest. The
 * mock's card carries a left/right/top border and no bottom one, so the row
 * reads as three columns rising off the page rather than three closed boxes —
 * that asymmetry is deliberate and reproduced here.
 *
 * Portraits are the founder photos already published on the ClearTax CDN
 * (assets1.cleartax-cdn.com), not the Figma exports, which expire. They are
 * different crops of the same three people; swap the `photo` URLs if the newer
 * portraits in the mock get uploaded to Webflow assets.
 */

interface Founder {
    name: string;
    role: string;
    photo: string;
}

const heading = "Meet our founders";

const founders: Founder[] = [
    {
        name: "Ankit Solanki",
        role: "Co-founder",
        photo: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa91642cd5bb6e3c36af6cd_ankit.png",
    },
    {
        name: "Archit Gupta",
        role: "Founder & CEO",
        photo: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa9164281909ec612476108_archit.png",
    },
    {
        name: "Srivatsan Chari",
        role: "Co-founder, Head of Product",
        photo: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa916426b56f53e4b22daf3_srivatsan.png",
    },
];
---

<section class="au-founders bg-generic-00 py-12 lg:py-20">
    <div class="container">
        <h2
            class="m-0 mb-8 font-heading font-medium text-center text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] lg:mb-12"
        >
            {heading}
        </h2>

        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {
                founders.map((founder) => (
                    <article class="flex flex-col gap-6 rounded-xl border-x border-t border-neutral-300 bg-generic-00 p-6 lg:min-h-[480px]">
                        <div class="flex flex-col gap-2 text-center">
                            <h3 class="m-0 font-heading font-medium text-generic-100 text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px]">
                                {founder.name}
                            </h3>
                            <p class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                                {founder.role}
                            </p>
                        </div>

                        <div class="min-h-[280px] flex-1 overflow-hidden rounded-lg bg-visual-placeholder">
                            <img
                                src={founder.photo}
                                alt={founder.name}
                                loading="lazy"
                                decoding="async"
                                class="h-full w-full rounded-lg object-cover grayscale-100 hover:grayscale-0 transition-all duration-150 ease-in-out"
                            />
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
