---
/**
 * Regulatory & standards network — Figma node 14140:57007.
 *
 * Eight cards, four per row, icon left of a name/description stack.
 *
 * Same eight regulators, same copy and the same Webflow-hosted logos as the
 * "Compliance" panel inside `global-homepage/Seamless.astro`. Only the card
 * shape differs (that one stacks logo above text in a 4-up grid; this one sets
 * the logo beside the text), so the data is duplicated rather than the section
 * being shared. If a logo URL changes, change it in both places.
 */

interface Regulator {
    name: string;
    desc: string;
    logo: string;
}

const heading = "Our regulatory & standards network";

const regulators: Regulator[] = [
    {
        name: "Peppol",
        desc: "Pan-European e-invoicing & procurement network",
        logo: "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb07bef557c1cc2f582a53_peppol.png",
    },
    {
        name: "FTA",
        desc: "UAE Federal Tax Authority compliance",
        logo: "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb07be955837eded28eba4_fta.png",
    },
    {
        name: "ZATCA",
        desc: "Saudi e-invoicing mandate (Fatoorah)",
        logo: "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb07bee548ff1688c1c0d1_zatca.png",
    },
    {
        name: "OTA",
        desc: "Compliant with Oman Tax Authority",
        logo: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a14430f6a961afae55a59be_authority.png",
    },
    {
        name: "DGFiP",
        desc: "French tax administration",
        logo: "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb07bd0cea853c7a3a159b_dgfip.png",
    },
    {
        name: "FPS Finance",
        desc: "Belgian fiscal services",
        logo: "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb07bed8043fb1a64b6859_fps-finance.png",
    },
    {
        name: "NIC",
        desc: "National Informatics Centre",
        logo: "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb07be66482af8235e233a_nic.png",
    },
    {
        name: "LHDN",
        desc: "Malaysian tax authority",
        logo: "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69eb15cf0f335dfcecdfc9b5_lhdn.png",
    },
];
---

<section class="au-regulatory bg-generic-00 py-12 lg:py-20">
    <div class="container">
        <h2
            class="m-0 mb-8 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] lg:mb-12"
        >
            {heading}
        </h2>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
            {
                regulators.map((r) => (
                    <div class="flex items-center gap-6 overflow-hidden rounded-xl border border-neutral-300 bg-generic-00 p-6">
                        <img
                            src={r.logo}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            width="54"
                            height="54"
                            class="h-[54px] w-[54px] shrink-0 rounded-[9px] object-cover"
                        />
                        <div class="flex min-w-0 flex-1 flex-col gap-2">
                            <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-label-lg)] leading-[length:var(--lh-label-lg)]">
                                {r.name}
                            </p>
                            <p class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                                {r.desc}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
