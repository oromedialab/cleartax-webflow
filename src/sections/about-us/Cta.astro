---
/**
 * Closing CTA band — Figma node 14140:57087 ("Container - CTA").
 *
 * Same interactive stroke field as the hero, but in Nova Blue rather than Flux
 * Lime and spanning the full width. That is what the mock draws, and it is also
 * what the brand asks for: Flux Lime gets one appearance per screen, and the
 * hero headline highlight has already spent it.
 *
 * The field is the shared `_shared/Dotgrid.astro` primitive rather than a
 * hand-rolled copy of the loop. Two fields on one page means two rAF loops, but
 * Dotgrid only repaints on frames where something actually moved — a settled
 * field costs nothing — and duplicating ~300 lines of canvas script into this
 * embed would be a real cost against the 50 KB paste cap.
 */
import Dotgrid from "../_shared/Dotgrid.astro";

interface Props {
    heading?: string;
    description?: string;
    ctaLabel?: string;
    ctaHref?: string;
}

const {
    heading = "The future of finance is continuous.",
    description = "We’re building the technology to make that AI in finance simpler, smarter and more connected.",
    ctaLabel = "Book a demo",
    ctaHref = "https://www.cleartax.com/contact-us",
} = Astro.props;
---

<section
    id="au-cta"
    class="au-cta relative overflow-hidden bg-generic-00 py-12 lg:py-20"
>
    <!-- Interactive stroke field -->
    <div class="au-cta-field absolute inset-0 pointer-events-none">
        <Dotgrid
            containerId="au-cta"
            canvasId="au-cta-dots"
            lineWidth={3}
            gap={24}
            maxLength={6}
            lengthRadius={260}
            tilt={1}
            baseColor="rgba(84, 70, 255, 0.5)"
            cursorRadius={320}
            pull={14}
            fadeRadius={40}
        />
    </div>

    <!-- Radial wash, so the headline keeps its contrast over the field -->
    <div
        class="absolute inset-0 z-0 pointer-events-none bg-[radial-gradient(circle_at_center,_#FFF_20%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(255,255,255,0)_65%)]"
    >
    </div>

    <div class="container relative z-10">
        <div class="mx-auto flex max-w-[720px] flex-col items-center gap-6 text-center">
            <div class="flex flex-col items-center gap-2">
                <h2
                    class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)]"
                >
                    {heading}
                </h2>
                <p
                    class="m-0 max-w-[432px] font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
                >
                    {description}
                </p>
            </div>

            <a
                href={ctaHref}
                data-demo-open
                class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-nova-blue bg-nova-blue px-4 py-2.5 font-body font-medium text-nova-50 no-underline text-[length:var(--fs-label)] leading-[length:var(--lh-label)] transition-colors duration-200 hover:bg-generic-00 hover:text-nova-blue"
            >
                {ctaLabel}
            </a>
        </div>
    </div>
</section>

<style is:global>
    /* The field runs edge to edge but dies out top and bottom, so the band does
       not butt hard against the section above it or the footer below. */
    .au-cta-field {
        mask-image: linear-gradient(
            to bottom,
            transparent 0%,
            black 25%,
            black 75%,
            transparent 100%
        );
        -webkit-mask-image: linear-gradient(
            to bottom,
            transparent 0%,
            black 25%,
            black 75%,
            transparent 100%
        );
    }
</style>
