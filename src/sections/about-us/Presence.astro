---
/**
 * Global presence — Figma node 14140:56976 ("max-w-[var(--max-w-[var(--container-max)]-max)]: Our Presence").
 *
 * One bordered card: copy plus a wrapped row of country chips on the left, the
 * dotted globe on the right.
 *
 * COUNTRIES are the same list, in the same order, that `_shared/NavbarRb.astro`
 * ships as its country selector, and the flag URLs are lifted from there rather
 * than re-exported from Figma — those are already on the Webflow CDN, so the
 * embed works the moment it is pasted. Keep the two in step: if a country is
 * added to the navbar selector it belongs here too.
 *
 * ── ASSET TO UPLOAD ───────────────────────────────────────────────────────────
 * GLOBE_SRC is the only image on this page with no Webflow-hosted original. The
 * file is committed at `public/images/about-us/globe.png` (exported from the
 * Figma node) so the dev server and `dist/preview` render it, but a repo path
 * resolves to nothing once the embed is pasted. Upload that file to Webflow
 * assets and replace this ONE line with the CDN URL before pasting the section.
 * ──────────────────────────────────────────────────────────────────────────────
 *
 * ── INTERACTIVE GLOBE ─────────────────────────────────────────────────────────
 * GLOBE_SRC still renders first and stays the real fallback (no-JS, crawler,
 * WebGL unavailable). The rotating dot-matrix globe is a progressive
 * enhancement: a script below lazy-mounts it — via IntersectionObserver, the
 * same trigger the <img>'s native `loading="lazy"` already used — so Three.js
 * (loaded from a CDN, not bundled) and the globe's init cost are only paid once
 * this section nears the viewport. On init it renders over the poster image and
 * crossfades it out; if Three.js fails to load or WebGL init throws, the poster
 * simply stays put.
 * ──────────────────────────────────────────────────────────────────────────────
 */
const GLOBE_SRC =
    "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6aa916426f59ce0239f6282f_globe.png";

interface Country {
    name: string;
    flag?: string;
}

const heading = "Compliance doesn’t stop at borders.";
const leadBefore =
    "Today, ClearTax powers assured compliance for enterprises across 50+ countries, spanning ";
const leadStrong = "EMEA and APAC.";
const subLead = "Wherever business goes, compliance can follow.";

const countries: Country[] = [
    {
        name: "Bahrain",
        flag: "https://cdn.prod.website-files.com/6141e3720a248d2024615d96/63e29d6c2e1ddc75a632d00f_Group%201000003292.svg",
    },
    {
        name: "France",
        flag: "https://cdn.prod.website-files.com/6141e3720a248d2024615d96/64999768870655432964457d_france_flag.png",
    },
    {
        name: "India",
        flag: "https://cdn.prod.website-files.com/6141e3720a248d2024615d96/649999dbc3faf054134a1e01_India_flag.png",
    },
    {
        name: "Malaysia",
        flag: "https://cdn.prod.website-files.com/6141e3720a248d2024615d96/649a7b4653733f5dbda826ea_malaysia%20v1.png",
    },
    {
        name: "Oman",
        flag: "https://cdn.prod.website-files.com/6141e3720a248d2024615d96/63e29d499e782b5935404547_Group%201000003291.svg",
    },
    {
        name: "Singapore",
        flag: "https://cdn.prod.website-files.com/6141e3720a248d2024615d96/66716d4c6753fb52078bec02_singapore%20flag%203.png",
    },
    {
        name: "Spain",
        flag: "https://cdn.prod.website-files.com/6141e3720a248d2024615d96/64999a546cfce1e0515f0f60_spain%20flag.png",
    },
    {
        name: "Belgium",
        flag: "https://cdn.prod.website-files.com/6141e3720a248d2024615d96/67e3e6ae1e19488131f26dfd_belgium_flag.png",
    },
    {
        name: "Germany",
        flag: "https://assets.clear.in/cleartax/images/1771829770_flagforflaggermanysvgrepocom1.svg",
    },
    {
        name: "KSA",
        flag: "https://cdn.prod.website-files.com/6141e3720a248d2024615d96/63e28756aeabe12df79ff5d5_Rectangle%202515530.svg",
    },
    {
        name: "Norway",
        flag: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7999a2fdf9fde123422a1b_Flag_of_Norway.svg.webp",
    },
    {
        name: "Philippines",
        flag: "https://cdn.prod.website-files.com/6141e3720a248d2024615d96/6a2935c197e9e718191d8d34_Flag_of_the_Philippines.svg",
    },
    {
        name: "Slovakia",
        flag: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7c4a36ac18ccf3dcb998be_slovakia-flag.png",
    },
    {
        name: "UAE",
        flag: "https://cdn.prod.website-files.com/6141e3720a248d2024615d96/63e29d24f310792735ab4bba_Mask%20group%20(3).svg",
    },
    /* No flag — renders as a plain chip, which is what the mock draws. */
    { name: "+ more" },
];
---

<section class="au-presence bg-generic-00 py-12 lg:py-20">
    <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
        <div
            class="flex flex-col gap-8 rounded-xl border border-neutral-300 p-6 lg:flex-row lg:items-center lg:gap-12 lg:p-12"
        >
            <div class="flex flex-col gap-6 lg:w-[628px] lg:shrink-0">
                <div class="flex flex-col gap-6">
                    <h2
                        class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
                    >
                        {heading}
                    </h2>

                    <div class="flex flex-col gap-4">
                        <p
                            class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] lg:max-w-[481px]"
                        >
                            {leadBefore}<strong class="font-bold"
                                >{leadStrong}</strong
                            >
                        </p>
                        <p
                            class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
                        >
                            {subLead}
                        </p>
                    </div>
                </div>

                <ul
                    class="au-country-list m-0 flex list-none flex-wrap gap-2 p-0"
                >
                    {
                        countries.map((country) => (
                            <li class="flex items-center gap-2 overflow-hidden rounded-lg border-[0.8px] border-[#B8B7B6] bg-generic-00 px-3 py-2">
                                {country.flag && (
                                    <img
                                        src={country.flag}
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                        width="24"
                                        height="18"
                                        class="h-[18px] w-6 shrink-0 rounded-[2px] object-cover"
                                    />
                                )}
                                <span class="whitespace-nowrap font-body font-medium text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                                    {country.name}
                                </span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Globe. The mock oversizes and crops it inside the box rather than
                 fitting it, so the percentages below are the designed geometry.
                 The poster <img> is the real content and the no-JS/no-WebGL
                 fallback; the Three.js canvas is an enhancement layered on top,
                 see the frontmatter note above. -->
            <div
                class="au-presence-globe relative h-[260px] w-full overflow-hidden rounded-xl lg:h-[337px] lg:min-w-0 lg:flex-1"
            >
                <img
                    src={GLOBE_SRC}
                    alt="Dotted globe marking the countries ClearTax operates in"
                    loading="lazy"
                    decoding="async"
                    class="au-presence-globe-poster absolute left-[7.88%] top-[-6.59%] h-[113.18%] w-[84.24%] max-w-none object-contain"
                />
                <div class="au-presence-globe-stage absolute inset-0" aria-hidden="true">
                    <div class="au-presence-globe-canvas"></div>
                    <div class="au-presence-globe-tags"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<style is:global>
    /* Crossfade between the poster <img> (default, real fallback) and the
       Three.js canvas stage (enhancement, mounted lazily by the script below). */
    .au-presence-globe-poster {
        transition: opacity 0.3s ease-out;
    }

    .au-presence-globe-poster.au-presence-globe-hidden {
        opacity: 0;
    }

    .au-presence-globe-stage {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease-out;
    }

    .au-presence-globe-stage.au-presence-globe-visible {
        opacity: 1;
    }

    .au-presence-globe-canvas {
        position: absolute;
        inset: 0;
        touch-action: none;
    }

    .au-presence-globe-canvas canvas {
        display: block;
        width: 100%;
        height: 100%;
    }

    .au-presence-globe-tags {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 10;
    }

    .au-presence-globe-tag-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 5;
        opacity: 0;
        pointer-events: none;
        will-change: transform, opacity;
    }

    .au-presence-globe-tags.au-presence-globe-animated .au-presence-globe-tag-wrapper {
        transition: opacity 0.25s ease-out;
    }

    .au-presence-globe-tag-wrapper.au-presence-globe-visible {
        opacity: 1;
    }

    .au-presence-globe-tag-content {
        display: flex;
        align-items: center;
        justify-content: center;
        /* Nova Blue at 40% opacity. */
        border: 1px solid rgba(84, 70, 255, 0.4);
        border-radius: 50%;
        padding: 3px;
        background: rgba(255, 255, 255, 0.85);
        box-shadow: 0 2px 8px rgba(48, 65, 76, 0.1);
        backdrop-filter: blur(4px);
    }

    .au-presence-globe-tag-content img {
        display: block;
        width: 28px;
        height: 28px;
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 50%;
        background-color: #eee;
        object-fit: cover;
    }

    @media (max-width: 640px) {
        .au-presence-globe-tag-content {
            padding: 2px;
        }

        .au-presence-globe-tag-content img {
            width: 20px;
            height: 20px;
        }
    }
</style>

<script is:inline>
    /* Interactive globe — lazy-mounted Three.js enhancement over the poster
       <img>, see the frontmatter note at the top of this section.
       Ported from a standalone full-viewport demo: sizes come from the
       `.au-presence-globe` box (ResizeObserver) instead of window.innerWidth/
       innerHeight, and the renderer/tags mount inside the section instead of
       document.body. Rotation speed, geometry and country-tag placement are
       otherwise unchanged from the source. */
    (function () {
        var THREE_SRC =
            "https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js";
        var threePromise = null;

        function loadThree() {
            if (window.THREE) return Promise.resolve(window.THREE);
            if (threePromise) return threePromise;
            threePromise = new Promise(function (resolve, reject) {
                var script = document.createElement("script");
                script.src = THREE_SRC;
                script.async = true;
                script.onload = function () {
                    resolve(window.THREE);
                };
                script.onerror = reject;
                document.head.appendChild(script);
            });
            return threePromise;
        }

        var LAND_MASK_B64 =
            "";

        var COUNTRY_TAGS = [
            { name: "Argentina", code: "ar", lat: -38.4, lon: -63.6 },
            { name: "Australia", code: "au", lat: -25.2, lon: 133.7 },
            { name: "Brazil", code: "br", lat: -14.2, lon: -51.9 },
            { name: "Canada", code: "ca", lat: 56.1, lon: -106.3 },
            { name: "China", code: "cn", lat: 35.8, lon: 104.1 },
            { name: "Costa Rica", code: "cr", lat: 9.7, lon: -83.7 },
            { name: "European Union", code: "eu", lat: 49.5, lon: 12.0 },
            { name: "Hong Kong", code: "hk", lat: 22.3, lon: 114.1 },
            { name: "India", code: "in", lat: 20.5, lon: 78.9 },
            { name: "Israel", code: "il", lat: 31.0, lon: 34.8 },
            { name: "Japan", code: "jp", lat: 36.2, lon: 138.2 },
            { name: "Malaysia", code: "my", lat: 4.2, lon: 109.2 },
            { name: "Mauritius", code: "mu", lat: -20.3, lon: 57.5 },
            { name: "Mexico", code: "mx", lat: 23.6, lon: -102.5 },
            { name: "New Zealand", code: "nz", lat: -40.9, lon: 174.8 },
            { name: "Oman", code: "om", lat: 21.4, lon: 55.9 },
            { name: "Peru", code: "pe", lat: -9.1, lon: -75.0 },
            { name: "Philippines", code: "ph", lat: 12.8, lon: 121.7 },
            { name: "Puerto Rico", code: "pr", lat: 18.2, lon: -66.5 },
            { name: "Qatar", code: "qa", lat: 25.3, lon: 51.1 },
            { name: "Russia", code: "ru", lat: 61.5, lon: 105.3 },
            { name: "Saudi Arabia", code: "sa", lat: 23.8, lon: 45.0 },
            { name: "Singapore", code: "sg", lat: 1.3, lon: 103.8 },
            { name: "South Africa", code: "za", lat: -30.5, lon: 22.9 },
            { name: "South Korea", code: "kr", lat: 35.9, lon: 127.7 },
            { name: "Taiwan", code: "tw", lat: 23.6, lon: 120.9 },
            { name: "Turkey", code: "tr", lat: 38.9, lon: 35.2 },
            { name: "UAE", code: "ae", lat: 23.4, lon: 53.8 },
            { name: "UK", code: "gb", lat: 55.3, lon: -3.4 },
            { name: "USA", code: "us", lat: 37.0, lon: -95.7 },
        ];

        function initContinentDots(THREE, globeGroup, GLOBE_RADIUS) {
            var bin = atob(LAND_MASK_B64);
            var dotColumns = 376;
            var dotRows = 188;
            var dotRadius = GLOBE_RADIUS - 0.01;
            var positions = [];

            for (var row = 0; row < dotRows; row++) {
                var v = (row + 0.5) / dotRows;
                var phi = v * Math.PI;
                var cosPhi = Math.cos(phi);
                var sinPhi = Math.sin(phi);
                var y = dotRadius * cosPhi;
                var rSinPhi = -dotRadius * sinPhi;
                var rowOffset = row * dotColumns;

                for (var col = 0; col < dotColumns; col++) {
                    var bitIdx = rowOffset + col;
                    if ((bin.charCodeAt(bitIdx >> 3) & (1 << (bitIdx & 7))) === 0)
                        continue;

                    var theta = ((col + 0.5) / dotColumns) * (Math.PI * 2);
                    positions.push(
                        rSinPhi * Math.cos(theta),
                        y,
                        -rSinPhi * Math.sin(theta),
                    );
                }
            }

            var dotCount = positions.length / 3;
            var dotGeometry = new THREE.CylinderGeometry(0.0112, 0.0112, 0.006, 6);
            dotGeometry.translate(0, 0.003, 0);

            var extrudedDotMaterial = new THREE.RawShaderMaterial({
                vertexShader:
                    "precision highp float;\n" +
                    "uniform mat4 modelViewMatrix;\n" +
                    "uniform mat4 projectionMatrix;\n" +
                    "attribute vec3 position;\n" +
                    "attribute mat4 instanceMatrix;\n" +
                    "void main() {\n" +
                    "  gl_Position = projectionMatrix * modelViewMatrix * instanceMatrix * vec4(position, 1.0);\n" +
                    "}",
                fragmentShader:
                    "precision mediump float;\n" +
                    "void main() {\n" +
                    "  gl_FragColor = vec4(0.4196, 0.4471, 0.5020, 1.0);\n" +
                    "}",
            });

            var dotMesh = new THREE.InstancedMesh(
                dotGeometry,
                extrudedDotMaterial,
                dotCount,
            );
            var instanceMatrix = new THREE.Matrix4();
            var instanceQuaternion = new THREE.Quaternion();
            var cylinderAxis = new THREE.Vector3(0, 1, 0);
            var tempPos = new THREE.Vector3();
            var tempNorm = new THREE.Vector3();
            var scaleOne = new THREE.Vector3(1, 1, 1);

            for (var i = 0; i < dotCount; i++) {
                var idx = i * 3;
                tempPos.set(positions[idx], positions[idx + 1], positions[idx + 2]);
                tempNorm.copy(tempPos).normalize();
                instanceQuaternion.setFromUnitVectors(cylinderAxis, tempNorm);
                instanceMatrix.compose(tempPos, instanceQuaternion, scaleOne);
                dotMesh.setMatrixAt(i, instanceMatrix);
            }

            dotMesh.instanceMatrix.setUsage(THREE.StaticDrawUsage);
            dotMesh.instanceMatrix.needsUpdate = true;
            dotMesh.matrixAutoUpdate = false;
            dotMesh.renderOrder = 2;
            globeGroup.add(dotMesh);
        }

        function initGlobe(THREE, root) {
            var poster = root.querySelector(".au-presence-globe-poster");
            var stage = root.querySelector(".au-presence-globe-stage");
            var canvasMount = root.querySelector(".au-presence-globe-canvas");
            var tagsMount = root.querySelector(".au-presence-globe-tags");
            if (!poster || !stage || !canvasMount || !tagsMount) return;

            var width = canvasMount.clientWidth;
            var height = canvasMount.clientHeight;
            if (!width || !height) return;
            var halfWidth = width * 0.5;
            var halfHeight = height * 0.5;

            var scene = new THREE.Scene();
            var camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            camera.position.set(0, 0, 7.5);

            var renderer;
            try {
                renderer = new THREE.WebGLRenderer({
                    antialias: true,
                    alpha: true,
                    powerPreference: "high-performance",
                });
            } catch (e) {
                return;
            }
            renderer.setClearColor(0xffffff, 0);
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            canvasMount.appendChild(renderer.domElement);

            var globePivot = new THREE.Group();
            globePivot.rotation.z = THREE.MathUtils.degToRad(-11);
            globePivot.rotation.x = THREE.MathUtils.degToRad(12);
            scene.add(globePivot);

            var globeGroup = new THREE.Group();
            globeGroup.rotation.y = THREE.MathUtils.degToRad(-60);
            globePivot.add(globeGroup);

            var GLOBE_RADIUS = 2.2;

            var innerCore = new THREE.Mesh(
                new THREE.SphereGeometry(GLOBE_RADIUS - 0.015, 64, 64),
                new THREE.MeshBasicMaterial({
                    color: 0xffffff,
                    depthWrite: true,
                    depthTest: true,
                }),
            );
            innerCore.renderOrder = 0;
            innerCore.matrixAutoUpdate = false;
            globeGroup.add(innerCore);

            var gridRadius = GLOBE_RADIUS + 0.03;
            var wireframeSegments = 64;
            var wireframePositions = new Float32Array(7296);
            var wfPtr = 0;

            for (var i = 1; i < 12; i++) {
                var phi = (Math.PI * i) / 12;
                var y = gridRadius * Math.cos(phi);
                var r = gridRadius * Math.sin(phi);
                for (var j = 0; j < wireframeSegments; j++) {
                    var t1 = (j / wireframeSegments) * Math.PI * 2;
                    var t2 = ((j + 1) / wireframeSegments) * Math.PI * 2;
                    wireframePositions[wfPtr++] = r * Math.cos(t1);
                    wireframePositions[wfPtr++] = y;
                    wireframePositions[wfPtr++] = r * Math.sin(t1);
                    wireframePositions[wfPtr++] = r * Math.cos(t2);
                    wireframePositions[wfPtr++] = y;
                    wireframePositions[wfPtr++] = r * Math.sin(t2);
                }
            }

            for (var i2 = 0; i2 < 8; i2++) {
                var theta0 = (Math.PI * i2) / 8;
                var cosTheta = Math.cos(theta0);
                var sinTheta = Math.sin(theta0);
                for (var j2 = 0; j2 < wireframeSegments; j2++) {
                    var t1b = (j2 / wireframeSegments) * Math.PI * 2;
                    var t2b = ((j2 + 1) / wireframeSegments) * Math.PI * 2;
                    var x1 = gridRadius * Math.cos(t1b);
                    var y1 = gridRadius * Math.sin(t1b);
                    var x2 = gridRadius * Math.cos(t2b);
                    var y2 = gridRadius * Math.sin(t2b);
                    wireframePositions[wfPtr++] = x1 * cosTheta;
                    wireframePositions[wfPtr++] = y1;
                    wireframePositions[wfPtr++] = -x1 * sinTheta;
                    wireframePositions[wfPtr++] = x2 * cosTheta;
                    wireframePositions[wfPtr++] = y2;
                    wireframePositions[wfPtr++] = -x2 * sinTheta;
                }
            }

            var wireframeGeo = new THREE.BufferGeometry();
            wireframeGeo.setAttribute(
                "position",
                new THREE.BufferAttribute(wireframePositions, 3),
            );
            var gridMaterial = new THREE.LineBasicMaterial({
                color: 0x646867,
                transparent: true,
                opacity: 0.32,
            });
            var wireframeMesh = new THREE.LineSegments(wireframeGeo, gridMaterial);
            wireframeMesh.renderOrder = 3;
            wireframeMesh.matrixAutoUpdate = false;
            globeGroup.add(wireframeMesh);

            initContinentDots(THREE, globeGroup, GLOBE_RADIUS);

            var tagElements = [];
            var tagsFragment = document.createDocumentFragment();

            COUNTRY_TAGS.forEach(function (country) {
                var wrapper = document.createElement("div");
                wrapper.className = "au-presence-globe-tag-wrapper";

                var content = document.createElement("div");
                content.className = "au-presence-globe-tag-content";

                if (country.code) {
                    var flag = document.createElement("img");
                    flag.src = "https://flagcdn.com/w80/" + country.code + ".png";
                    flag.alt = country.name;
                    flag.width = 28;
                    flag.height = 28;
                    flag.loading = "lazy";
                    flag.decoding = "async";
                    content.appendChild(flag);
                }
                wrapper.appendChild(content);

                var phiT = (90 - country.lat) * (Math.PI / 180);
                var thetaT = (country.lon + 180) * (Math.PI / 180);
                var rT = GLOBE_RADIUS + 0.005;
                var position = new THREE.Vector3(
                    -rT * Math.sin(phiT) * Math.cos(thetaT),
                    rT * Math.cos(phiT),
                    rT * Math.sin(phiT) * Math.sin(thetaT),
                );

                tagsFragment.appendChild(wrapper);
                tagElements.push({ position: position, element: wrapper, isVisible: false });
            });

            tagsMount.appendChild(tagsFragment);

            var axisMat = new THREE.LineBasicMaterial({
                color: 0x646867,
                transparent: true,
                opacity: 0.45,
            });
            var arcMat = new THREE.MeshBasicMaterial({
                color: 0x646867,
                transparent: true,
                opacity: 0.65,
            });
            var arcThickness = 0.00675;
            var axisGeo = new THREE.BufferGeometry().setFromPoints([
                new THREE.Vector3(0, -GLOBE_RADIUS * 1.8, 0),
                new THREE.Vector3(0, GLOBE_RADIUS * 1.5, 0),
            ]);
            var axisLine = new THREE.Line(axisGeo, axisMat);
            axisLine.matrixAutoUpdate = false;
            globePivot.add(axisLine);

            var arcRadius = 0.65;
            var arcEndAngle = Math.PI * 1.35;
            var innerRingRadius = 0.28;
            var arcSegments = 48;
            var outerArcPoints = [];
            var innerArcPoints = [];
            for (var ai = 0; ai <= arcSegments; ai++) {
                var at = (ai / arcSegments) * arcEndAngle;
                outerArcPoints.push(
                    new THREE.Vector3(
                        arcRadius * Math.cos(at),
                        0,
                        -arcRadius * Math.sin(at),
                    ),
                );
                innerArcPoints.push(
                    new THREE.Vector3(
                        innerRingRadius * Math.cos(at),
                        0,
                        -innerRingRadius * Math.sin(at),
                    ),
                );
            }
            var outerArcGeo = new THREE.TubeGeometry(
                new THREE.CatmullRomCurve3(outerArcPoints),
                arcSegments,
                arcThickness,
                8,
                false,
            );
            var innerArcGeo = new THREE.TubeGeometry(
                new THREE.CatmullRomCurve3(innerArcPoints),
                arcSegments,
                arcThickness,
                8,
                false,
            );

            var rotatingArcs = [];
            var synchronizedArcs = [];

            function createRotationIndicators(direction) {
                var group = new THREE.Group();

                var arc = new THREE.Mesh(outerArcGeo, arcMat);
                arc.rotation.y = -Math.PI / 4;
                arc.position.y = direction === -1 ? -0.06 : 0;
                rotatingArcs.push(arc);
                group.add(arc);

                var innerRing = new THREE.Mesh(innerArcGeo, arcMat);
                innerRing.position.y = -direction * 0.25;
                synchronizedArcs.push(innerRing);
                group.add(innerRing);

                group.position.y =
                    direction * GLOBE_RADIUS * 1.5 + (direction === 1 ? -0.6 : 0.23);
                group.rotation.x =
                    direction === -1 ? THREE.MathUtils.degToRad(-45) : 0;
                return group;
            }

            globePivot.add(createRotationIndicators(1));
            globePivot.add(createRotationIndicators(-1));

            scene.add(new THREE.AmbientLight(0xffffff, 0.9));

            var tagWorldPos = new THREE.Vector3();
            var rotationClock = new THREE.Clock();
            var LOOP_DURATION = 16;
            var globeRotationSpeed = (Math.PI * 2) / LOOP_DURATION;
            var arcSpeed = globeRotationSpeed * 2;
            var syncSpeed = globeRotationSpeed * 4;
            var VISIBILITY_Z_THRESHOLD = 0.852;

            function updateTagPositions() {
                var mWorld = globeGroup.matrixWorld;

                for (var t = 0; t < tagElements.length; t++) {
                    var tag = tagElements[t];
                    tagWorldPos.copy(tag.position).applyMatrix4(mWorld);

                    var isVisible = tagWorldPos.z >= VISIBILITY_Z_THRESHOLD;
                    if (tag.isVisible !== isVisible) {
                        tag.isVisible = isVisible;
                        tag.element.classList.toggle(
                            "au-presence-globe-visible",
                            isVisible,
                        );
                    }

                    if (isVisible) {
                        tagWorldPos.project(camera);
                        var x = tagWorldPos.x * halfWidth + halfWidth;
                        var y = tagWorldPos.y * -halfHeight + halfHeight;
                        var px = ((x * 10 + 0.5) | 0) * 0.1;
                        var py = ((y * 10 + 0.5) | 0) * 0.1;

                        if (tag.px !== px || tag.py !== py) {
                            tag.px = px;
                            tag.py = py;
                            tag.element.style.transform =
                                "translate3d(" + px + "px, " + py + "px, 0) translate(-50%, -50%)";
                        }
                    }
                }
            }

            camera.updateMatrixWorld(true);
            globeGroup.updateMatrixWorld(true);
            renderer.render(scene, camera);
            updateTagPositions();

            stage.classList.add("au-presence-globe-visible");
            poster.classList.add("au-presence-globe-hidden");
            requestAnimationFrame(function () {
                tagsMount.classList.add("au-presence-globe-animated");
            });

            function animate() {
                requestAnimationFrame(animate);
                var deltaTime = Math.min(rotationClock.getDelta(), 0.05);

                globeGroup.rotation.y += globeRotationSpeed * deltaTime;

                var arcDelta = arcSpeed * deltaTime;
                for (var ra = 0; ra < rotatingArcs.length; ra++) {
                    rotatingArcs[ra].rotation.y += arcDelta;
                }

                var syncDelta = syncSpeed * deltaTime;
                for (var sa = 0; sa < synchronizedArcs.length; sa++) {
                    synchronizedArcs[sa].rotation.y += syncDelta;
                }

                globeGroup.updateMatrixWorld();
                renderer.render(scene, camera);
                updateTagPositions();
            }
            animate();

            if ("ResizeObserver" in window) {
                var resizeObserver = new ResizeObserver(function (entries) {
                    var entry = entries[0];
                    if (!entry) return;
                    var newWidth = entry.contentRect.width;
                    var newHeight = entry.contentRect.height;
                    if (!newWidth || !newHeight) return;

                    width = newWidth;
                    height = newHeight;
                    halfWidth = width * 0.5;
                    halfHeight = height * 0.5;

                    camera.aspect = width / height;
                    camera.updateProjectionMatrix();

                    renderer.setSize(width, height);
                    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                });
                resizeObserver.observe(canvasMount);
            }
        }

        function initPresenceGlobe() {
            var root = document.querySelector(".au-presence-globe");
            if (!root || root.dataset.globeReady) return;
            root.dataset.globeReady = "true";

            if (!("IntersectionObserver" in window) || !window.WebGLRenderingContext) {
                return;
            }

            var mountObserver = new IntersectionObserver(
                function (entries) {
                    if (!entries[0].isIntersecting) return;
                    mountObserver.disconnect();
                    loadThree()
                        .then(function (THREE) {
                            initGlobe(THREE, root);
                        })
                        .catch(function () {
                            /* Three.js failed to load — poster stays as-is. */
                        });
                },
                { rootMargin: "200px 0px", threshold: 0 },
            );
            mountObserver.observe(root);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initPresenceGlobe);
        } else {
            initPresenceGlobe();
        }
    })();
</script>
