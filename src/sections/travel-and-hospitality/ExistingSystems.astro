---
/**
 * "We speak the language of your existing systems." Travel and Hospitality
 * variant of banking-and-financial-services/ExistingSystems.astro — same
 * three-category card layout, re-skinned for PMS / booking / distribution
 * systems. None of these vendors have a hosted Webflow logo asset yet, so
 * every badge falls back to the neutral monogram swatch (same fallback
 * pattern banking's version uses for core-banking / policy-system vendors
 * without art).
 */
interface Logo {
  name: string;
  src?: string;
}

interface Category {
  title: string;
  desc: string;
  logos: Logo[];
}

const categories: Category[] = [
  {
    title: "Enterprise ERPs",
    desc: "Where your transactions originate.",
    logos: [
      {
        name: "SAP S/4HANA",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59be2ddedbf4b5615765_sap.png",
      },
      {
        name: "Oracle Fusion",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594b2872eeb6348efacd_oracle-fusion.png",
      },
      {
        name: "Microsoft D365",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594489cb38a8fe58819d_ms.png",
      },
      {
        name: "Oracle EBS",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594b2872eeb6348efacd_oracle-fusion.png",
      },
      {
        name: "SAP ECC",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59be2ddedbf4b5615765_sap.png",
      },
    ],
  },
  {
    title: "PMS & booking engines",
    desc: "Where the guest or passenger sees the bill.",
    logos: [
      {
        name: "Opera",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb594b2872eeb6348efacd_oracle-fusion.png",
      },
      {
        name: "Protel",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb596a99d8fdd55230e5cd_planet.png",
      },
      {
        name: "Mews",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb592c916092f4caabdde3_mews.png",
      },
      {
        name: "Cloudbeds",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58add5f95121f3cff5c3_cloud.png",
      },
      {
        name: "RMS (PMS)",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb599e95eac82bb2867d88_rms.png",
      },
      {
        name: "Hotelkey",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58e6cd18f09c52ef1566_hote.png",
      },
      {
        name: "Any PMS via REST / SFTP",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5977cd18f09c52ef82f0_pms.png",
      },
    ],
  },
  {
    title: "Distribution & middleware",
    desc: "Where the booking reaches you, and the document leaves.",
    logos: [
      {
        name: "SynXis",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59a6293b4547bfb5bc0a_sabre.png",
      },
      {
        name: "Amadeus",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb58941cc6deef8bbfa651_amadeus.png",
      },
      {
        name: "M-Files",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5932c6c71064ad1e50ac_mfiles.png",
      },
      {
        name: "TIBCO",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb59d4427628a740fc9cbc_tibco.png",
      },
      {
        name: "Unified API",
        src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adb5898427628a740fb9391_api.png",
      },
    ],
  },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div class="flex flex-col gap-12">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-left text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        We speak the language of your existing systems.
      </h2>

      <div
        class="grid grid-cols-1 lg:grid-cols-3 rounded-xl border border-neutral-200 divide-y divide-neutral-200 lg:divide-y-0 lg:divide-x"
      >
        {
          categories.map((cat) => (
            <div class="flex flex-col gap-12 p-6">
              <div class="flex flex-col gap-2">
                <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                  {cat.title}
                </p>
                <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                  {cat.desc}
                </p>
              </div>
              <div class="flex flex-wrap gap-2">
                {cat.logos.map((logo) => (
                  <span class="inline-flex items-center gap-x-3 gap-y-2 rounded-lg border border-neutral-200 px-3 py-1.5">
                    {logo.src ? (
                      <img
                        src={logo.src}
                        alt=""
                        class="max-h-6 w-full object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span
                        class="h-6 w-6 shrink-0 rounded-md bg-neutral-200"
                        aria-hidden="true"
                      />
                    )}
                    <span class="font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] whitespace-nowrap">
                      {logo.name}
                    </span>
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
