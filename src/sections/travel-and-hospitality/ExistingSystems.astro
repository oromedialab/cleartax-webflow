---
/**
 * "We speak the language of your existing systems." Travel and Hospitality
 * variant of banking-and-financial-services/ExistingSystems.astro — same
 * three-category card layout, re-skinned for PMS / booking / distribution
 * systems. None of these vendors have a hosted Webflow logo asset yet, so
 * every badge falls back to the neutral monogram swatch (same fallback
 * pattern banking's version uses for core-banking / policy-system vendors
 * without art).
 */
interface Logo {
  name: string;
  src?: string;
}

interface Category {
  title: string;
  desc: string;
  logos: Logo[];
}

const categories: Category[] = [
  {
    title: "Enterprise ERPs",
    desc: "Where your transactions originate.",
    logos: [
      { name: "SAP S/4HANA", src: "/images/service-logos/sap.png" },
      { name: "Oracle Fusion", src: "/images/service-logos/oracle-fusion.png" },
      {
        name: "Microsoft D365",
        src: "/images/service-logos/ms.png",
      },
      { name: "Oracle EBS", src: "/images/service-logos/oracle-fusion.png" },
      { name: "SAP ECC", src: "/images/service-logos/sap.png" },
    ],
  },
  {
    title: "PMS & booking engines",
    desc: "Where the guest or passenger sees the bill.",
    logos: [
      { name: "Opera", src: "/images/service-logos/oracle-fusion.png" },
      { name: "Protel", src: "/images/service-logos/planet.png" },
      { name: "Mews", src: "/images/service-logos/mews.png" },
      { name: "Cloudbeds", src: "/images/service-logos/cloud.png" },
      {
        name: "RMS (PMS)",
        src: "/images/service-logos/rms.png",
      },
      { name: "Hotelkey", src: "/images/service-logos/hote.png" },
      { name: "Any PMS via REST / SFTP", src: "/images/service-logos/pms.png" },
    ],
  },
  {
    title: "Distribution & middleware",
    desc: "Where the booking reaches you, and the document leaves.",
    logos: [
      { name: "SynXis", src: "/images/service-logos/sabre.png" },
      { name: "Amadeus", src: "/images/service-logos/amadeus.png" },
      { name: "M-Files", src: "/images/service-logos/mfiles.png" },
      { name: "TIBCO", src: "/images/service-logos/tibco.png" },
      { name: "Unified API", src: "/images/service-logos/api.png" },
    ],
  },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div class="flex flex-col gap-12">
      <h2
        class="m-0 font-heading font-medium text-vault-navy text-left text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
      >
        We speak the language of your existing systems.
      </h2>

      <div
        class="grid grid-cols-1 lg:grid-cols-3 rounded-xl border border-neutral-200 divide-y divide-neutral-200 lg:divide-y-0 lg:divide-x"
      >
        {
          categories.map((cat) => (
            <div class="flex flex-col gap-12 p-6">
              <div class="flex flex-col gap-2">
                <p class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                  {cat.title}
                </p>
                <p class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                  {cat.desc}
                </p>
              </div>
              <div class="flex flex-wrap gap-2">
                {cat.logos.map((logo) => (
                  <span class="inline-flex items-center gap-x-3 gap-y-2 rounded-lg border border-neutral-200 px-3 py-1.5">
                    {logo.src ? (
                      <img
                        src={logo.src}
                        alt=""
                        class="max-h-6 w-full object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span
                        class="h-6 w-6 shrink-0 rounded-md bg-neutral-200"
                        aria-hidden="true"
                      />
                    )}
                    <span class="font-body font-medium text-neutral-700 text-[length:var(--fs-label)] leading-[length:var(--lh-label)] whitespace-nowrap">
                      {logo.name}
                    </span>
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
