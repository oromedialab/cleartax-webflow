---
/**
 * "From every booking channel to one source of truth." Travel and
 * Hospitality variant of banking-and-financial-services/SourceOfTruth.astro
 * — same tabbed flow diagram mechanism (see FlowCanvas.astro's doc comment
 * for the shared skeleton), re-skinned with the Direct & Distribution /
 * Platforms & OTAs card content and wire routing from the source-doc mockup
 * screenshots (word/media/image7.png = Direct & Distribution, image8.png =
 * Platforms & OTAs).
 *
 * Direct & Distribution has 3 plain sources + 1 `directToGL` (Procurement /
 * AP) — one fewer than Platforms & OTAs' 4 plain + 1 `directToGL` — so its
 * rows stop at y:388 instead of y:556; the "Direct → GL" row still gets the
 * wider 40px gap above it either way (see FlowCanvas.astro's CANVAS_H
 * comment). Every purple source merges onto its tab's first billing card via
 * a true bus: one shared vertical trunk line (drawn once, spanning every
 * row's y) plus one shared exit stub into the card (drawn once), with each
 * source contributing only its own short stub up to the trunk — see
 * platformsWires' own comment for why duplicating the shared segment per
 * source produces a glitchy, out-of-phase-dashes overlap. Procurement/AP
 * (orange) bypasses the trunk entirely straight to ERP GL on both tabs, same
 * "orange-full" mechanic banking-and-financial-services/SourceOfTruth.astro
 * uses for its own Procurement/AP row. The billing cards' bill-exit wires
 * are untouched — both still emit to ERP GL exactly as before, even though
 * only the first of each pair has an incoming connection.
 */
import FlowCanvas, {
  CANVAS_W,
  CANVAS_H,
  type FlowCard,
  type FlowWire,
} from "./FlowCanvas.astro";

const directSources: FlowCard[] = [
  {
    x: 0,
    y: 52,
    w: 286,
    h: 144,
    tag: "purple",
    title: "Property · PMS",
    desc: "Opera · Protel · Mews · Cloudbeds",
  },
  {
    x: 0,
    y: 220,
    w: 286,
    h: 144,
    tag: "purple",
    title: "Booking channels",
    desc: "own web · SynXis (CRS) · Amadeus · Sabre (GDS)",
  },
  {
    x: 0,
    y: 388,
    w: 286,
    h: 144,
    tag: "purple",
    title: "Corporate · MICE",
    desc: "Negotiated rates and group blocks\nClearance or Peppol, per country",
  },
  {
    x: 0,
    y: 572,
    w: 286,
    h: 144,
    tag: "orange",
    title: "Procurement / AP",
    desc: "Vendor invoices\nReverse charge",
    directToGL: true,
  },
];

const directBilling: FlowCard[] = [
  {
    x: 332,
    y: 220,
    w: 286,
    h: 144,
    tag: "grey",
    title: "Guest folio · e-invoice",
    desc: "Structured e-invoice per country.\nRoom, F&B and city tax split.",
  },
  {
    x: 332,
    y: 368,
    w: 286,
    h: 164,
    tag: "grey",
    title: "Corporate invoice",
    desc: "Consolidated per account.\nTax where the property stands.",
  },
];

// All 3 purple sources (Property · PMS, Booking channels, Corporate · MICE)
// merge onto Guest folio · e-invoice's own center (292) via a TRUE bus: one
// shared vertical trunk line at x:310 (drawn ONCE, spanning every row's y)
// plus one shared exit stub into the card (drawn ONCE, at y:292), with each
// source contributing only its own short horizontal stub up to the trunk.
// This is deliberately NOT 3 full-length overlapping paths — when multiple
// <path> elements each redraw the same shared segment, their independent
// `stroke-dasharray` phases (each starts fresh from that path's own origin)
// fall out of sync and the overlap reads as a doubled/glitchy line. Drawing
// the shared geometry exactly once removes that artifact entirely.
const directWires: FlowWire[] = [
  {
    flow: "purple",
    stage: "src-entry",
    points: [
      { x: 286, y: 124 },
      { x: 310, y: 124 },
    ],
  },
  {
    flow: "purple",
    stage: "src-entry",
    points: [
      { x: 286, y: 292 },
      { x: 310, y: 292 },
    ],
  },
  {
    flow: "purple",
    stage: "src-entry",
    points: [
      { x: 286, y: 460 },
      { x: 310, y: 460 },
    ],
  },
  {
    flow: "purple",
    stage: "src-entry",
    points: [
      { x: 310, y: 124 },
      { x: 310, y: 460 },
    ],
  },
  {
    flow: "purple",
    stage: "src-entry",
    points: [
      { x: 310, y: 292 },
      { x: 332, y: 292 },
    ],
  },
  {
    flow: "orange",
    stage: "orange-full",
    from: { x: 286, y: 644 },
    to: { x: 668, y: 500 },
    turnX: 643,
  },
  {
    flow: "purple",
    stage: "bill-exit",
    points: [
      { x: 618, y: 292 },
      { x: 640, y: 292 },
      { x: 640, y: 371 },
      { x: 668, y: 371 },
    ],
  },
  {
    flow: "purple",
    stage: "bill-exit",
    points: [
      { x: 618, y: 450 },
      { x: 640, y: 450 },
      { x: 640, y: 371 },
      { x: 668, y: 371 },
    ],
  },
];

const directChecklist = [
  "Output tax, or margin scheme",
  "e-invoice per country model",
  "Input tax recovery",
  "Place of supply per property",
  "Tax reconciliation",
];

// 5 rows (4 plain + 1 directToGL), unlike directSources' 4 — see this file's
// doc comment and FlowCanvas.astro's CANVAS_H comment. Row y-values follow
// the same 24px gap (40px directly above the flagged last row) rule
// directSources' rows use.
const platformsSources: FlowCard[] = [
  {
    x: 0,
    y: 52,
    w: 286,
    h: 144,
    tag: "purple",
    title: "Booking.com · Expedia",
    desc: "Global accommodation OTAs\nViDA deemed-supplier test applies",
  },
  {
    x: 0,
    y: 220,
    w: 286,
    h: 144,
    tag: "purple",
    title: "Airbnb · Vrbo",
    desc: "Short-term accommodation\nPlatform tax model",
  },
  {
    x: 0,
    y: 388,
    w: 286,
    h: 144,
    tag: "purple",
    title: "Ride & transfer",
    desc: "Uber · Bolt · Grab · Careem\nPassenger transport by road · Also in ViDA scope",
  },
  {
    x: 0,
    y: 556,
    w: 286,
    h: 144,
    tag: "purple",
    title: "Tour operators",
    desc: "TUI · Jet2 · DER Touristik\nPackaged trips · Margin scheme, not normal rules",
  },
  {
    x: 0,
    y: 740,
    w: 286,
    h: 144,
    tag: "orange",
    title: "Procurement / AP",
    desc: "Vendor invoices\nReverse charge",
    directToGL: true,
  },
];

const platformsBilling: FlowCard[] = [
  {
    x: 332,
    y: 220,
    w: 286,
    h: 144,
    tag: "grey",
    title: "Platform tax doc",
    desc: "Deemed-supplier settlement.\nStructured e-invoice per country.",
  },
  {
    x: 332,
    y: 368,
    w: 286,
    h: 164,
    tag: "grey",
    title: "Commission / Fees Invoice",
    desc: "Tax on platform commission.\nInput tax on commissions.",
  },
];

// Same true-bus construction as directWires: one shared vertical trunk at
// x:310 (drawn once, spanning all 4 rows) plus one shared exit stub into
// Platform tax doc (drawn once, at y:292), each source contributing only
// its own short stub — see directWires' comment for why per-source
// duplication of the shared segment produces a glitchy overlap.
const platformsWires: FlowWire[] = [
  {
    flow: "purple",
    stage: "src-entry",
    points: [
      { x: 286, y: 124 },
      { x: 310, y: 124 },
    ],
  },
  {
    flow: "purple",
    stage: "src-entry",
    points: [
      { x: 286, y: 292 },
      { x: 310, y: 292 },
    ],
  },
  {
    flow: "purple",
    stage: "src-entry",
    points: [
      { x: 286, y: 460 },
      { x: 310, y: 460 },
    ],
  },
  {
    flow: "purple",
    stage: "src-entry",
    points: [
      { x: 286, y: 628 },
      { x: 310, y: 628 },
    ],
  },
  {
    flow: "purple",
    stage: "src-entry",
    points: [
      { x: 310, y: 124 },
      { x: 310, y: 628 },
    ],
  },
  {
    flow: "purple",
    stage: "src-entry",
    points: [
      { x: 310, y: 292 },
      { x: 332, y: 292 },
    ],
  },
  {
    flow: "orange",
    stage: "orange-full",
    from: { x: 286, y: 812 },
    to: { x: 668, y: 500 },
    turnX: 643,
  },
  {
    flow: "purple",
    stage: "bill-exit",
    points: [
      { x: 618, y: 292 },
      { x: 640, y: 292 },
      { x: 640, y: 371 },
      { x: 668, y: 371 },
    ],
  },
  {
    flow: "purple",
    stage: "bill-exit",
    points: [
      { x: 618, y: 450 },
      { x: 640, y: 450 },
      { x: 640, y: 371 },
      { x: 668, y: 371 },
    ],
  },
];

const platformsChecklist = [
  "Output tax, or margin scheme",
  "Platform-liable tax",
  "Input tax recovery",
  "e-invoice per country model",
  "Tax reconciliation",
];

const FLOW_COLOR: Record<string, string> = {
  purple: "bg-nova-blue",
  orange: "bg-warning-500",
  green: "bg-success-500",
  grey: "bg-neutral-500",
};

const receives = [
  { tag: "purple" as const, label: "Output VAT / GST" },
  { tag: "orange" as const, label: "Reverse charge" },
  { tag: "green" as const, label: "Input VAT • GL" },
];
---

<section class="bg-generic-00 border-t border-neutral-200 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div class="rounded-xl border border-neutral-200 p-6 lg:p-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8 md:mb-12">
        <h2
          class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] text-balance"
        >
          From every booking channel to one source of truth.
        </h2>
        <div
          class="inline-flex items-center gap-1 rounded-xl bg-neutral-100 p-1 max-w-[355px] w-full"
          data-sot-tabs
        >
          <button
            type="button"
            class="sot-tab inline-flex items-center justify-center rounded-lg px-6 py-2 font-body font-medium text-[length:var(--fs-label)] leading-[length:var(--lh-label)] cursor-pointer border-0 bg-generic-00 text-nova-blue shadow-[0px_1px_2px_0px_rgba(16,24,40,0.04)]"
            data-sot-tab="direct"
            aria-selected="true"
          >
            Direct & Distribution
          </button>
          <button
            type="button"
            class="sot-tab inline-flex items-center justify-center rounded-lg px-6 py-2 font-body font-medium text-[length:var(--fs-label)] leading-[length:var(--lh-label)] cursor-pointer border-0 bg-transparent text-neutral-700"
            data-sot-tab="platforms"
            aria-selected="false"
          >
            Platforms & OTAs
          </button>
        </div>
      </div>

      <!-- Desktop Flow Canvas (>= 768px) -->
      <div class="sot-stage relative w-full hidden md:block" data-sot-stage>
        <div
          class="sot-track absolute top-0 left-0"
          style={`width:${CANVAS_W}px;height:${CANVAS_H}px;`}
          data-sot-track
        >
          <FlowCanvas
            id="direct"
            active={true}
            middlewareLabel="Billing // Tax-doc"
            erpChecklist={directChecklist}
            sourceCards={directSources}
            billingCards={directBilling}
            wires={directWires}
          />
          <FlowCanvas
            id="platforms"
            active={false}
            middlewareLabel="Billing // Tax-doc"
            erpChecklist={platformsChecklist}
            sourceCards={platformsSources}
            billingCards={platformsBilling}
            wires={platformsWires}
          />
        </div>
      </div>

      <!-- Mobile Flow Layout (< 768px, matching mobile design reference) -->
      <div class="block md:hidden">
        {
          [
            {
              id: "direct",
              active: true,
              sourcesLabel: "DIRECT & DISTRIBUTION",
              sourceCards: directSources,
              billingCards: directBilling,
              erpChecklist: directChecklist,
            },
            {
              id: "platforms",
              active: false,
              sourcesLabel: "PLATFORMS & OTAS",
              sourceCards: platformsSources,
              billingCards: platformsBilling,
              erpChecklist: platformsChecklist,
            },
          ].map((panel) => (
            <div
              class:list={["flex flex-col", !panel.active && "hidden"]}
              data-sot-mobile-panel={panel.id}
            >
              <!-- 1. Sources Column -->
              <div class="flex flex-col">
                <p class="m-0 font-body font-semibold text-vault-navy text-xs tracking-[1px] uppercase mb-3">
                  {panel.sourcesLabel}
                </p>
                <div class="flex flex-col gap-3">
                  {panel.sourceCards.map((c) => (
                    <div class="flex gap-4 rounded-xl border border-neutral-200 bg-generic-00 p-4">
                      <span class={`w-1 shrink-0 rounded-lg ${FLOW_COLOR[c.tag]}`} />
                      <div class="flex flex-col gap-1.5">
                        <p class="m-0 font-body font-semibold text-vault-navy text-base leading-snug">
                          {c.title}
                        </p>
                        <p class="m-0 font-body text-neutral-500 text-xs sm:text-sm leading-relaxed whitespace-pre-line">
                          {c.desc}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Connector 1: Sources -> Billing -->
              <div class="flex justify-center py-3" data-sot-conn="1">
                <svg width="14" height="38" viewBox="0 0 14 38" fill="none" class="overflow-visible" aria-hidden="true">
                  <line
                    x1="7"
                    y1="0"
                    x2="7"
                    y2="28"
                    stroke="#5446FF"
                    stroke-width="2"
                    stroke-dasharray="5 4"
                    stroke-linecap="round"
                    data-sot-mobile-line
                  />
                  <path
                    d="M3.5 24L7 31L10.5 24"
                    stroke="#5446FF"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <!-- 2. Billing / Tax-Doc Column -->
              <div class="flex flex-col">
                <p class="m-0 font-body font-semibold text-vault-navy text-xs tracking-[1px] uppercase mb-3">
                  BILLING / TAX-DOC
                </p>
                <div class="flex flex-col gap-3">
                  {panel.billingCards.map((c) => (
                    <div class="flex gap-4 rounded-xl border border-neutral-200 bg-generic-00 p-4">
                      <span class={`w-1 shrink-0 rounded-lg ${FLOW_COLOR[c.tag]}`} />
                      <div class="flex flex-col gap-1.5">
                        <p class="m-0 font-body font-semibold text-vault-navy text-base leading-snug">
                          {c.title}
                        </p>
                        <p class="m-0 font-body text-neutral-500 text-xs sm:text-sm leading-relaxed whitespace-pre-line">
                          {c.desc}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Connector 2: Billing -> ERP GL + Middleware Badge -->
              <div class="flex items-center gap-3.5 my-3" data-sot-conn="2">
                <div class="flex flex-col items-center pl-7 sm:pl-8">
                  <svg width="14" height="36" viewBox="0 0 14 36" fill="none" class="overflow-visible" aria-hidden="true">
                    <line
                      x1="7"
                      y1="0"
                      x2="7"
                      y2="26"
                      stroke="#5446FF"
                      stroke-width="2"
                      stroke-dasharray="5 4"
                      stroke-linecap="round"
                      data-sot-mobile-line
                    />
                    <path
                      d="M3.5 22L7 29L10.5 22"
                      stroke="#5446FF"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </div>
                <div class="relative inline-flex items-center justify-center rounded-xl border border-dashed border-success-500 bg-generic-00 px-3.5 py-1.5">
                  <p class="m-0 font-body font-medium text-success-600 text-xs sm:text-sm whitespace-nowrap">
                    Middleware · feed as required
                  </p>
                </div>
              </div>

              <!-- 3. ERP · GL Column -->
              <div class="flex flex-col">
                <p class="m-0 font-body font-medium text-nova-blue text-xs tracking-wider uppercase mb-3">
                  ERP · GL
                </p>
                <div class="flex gap-4 rounded-xl border border-neutral-200 bg-generic-00 p-4">
                  <span class="w-1 shrink-0 rounded-lg bg-nova-blue" />
                  <div class="flex flex-col gap-3 flex-1">
                    <div class="flex flex-col gap-1">
                      <p class="m-0 font-body font-semibold text-vault-navy text-base leading-snug">
                        ERP GL
                      </p>
                      <p class="m-0 font-body text-neutral-500 text-xs sm:text-sm">
                        SAP · Oracle · Dynamics 365
                      </p>
                    </div>
                    <ul class="m-0 flex flex-col gap-2 list-none p-0 mt-1">
                      {panel.erpChecklist.map((item) => (
                        <li class="flex items-center gap-2 font-body text-neutral-500 text-xs sm:text-sm">
                          <svg
                            width="16"
                            height="16"
                            viewBox="0 0 16 16"
                            fill="none"
                            class="shrink-0"
                            aria-hidden="true"
                          >
                            <circle cx="8" cy="8" r="8" fill="#5446FF" />
                            <path
                              d="M4.5 8.2 6.8 10.5 11.5 5.5"
                              stroke="white"
                              stroke-width="1.3"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                    <div class="h-px w-full bg-neutral-200 my-1" />
                    <p class="m-0 font-body font-medium text-nova-blue text-[11px] sm:text-xs tracking-wide uppercase">
                      THE CONSTANT NODE - EVERY TXN SETTLES HERE
                    </p>
                  </div>
                </div>
              </div>

              <!-- Connector 3: ERP GL -> cleartax (3 vertical arrows: blue, orange, green) -->
              <div class="flex items-center justify-center gap-2.5 py-3" data-sot-conn="3">
                <!-- Blue Arrow -->
                <svg width="12" height="36" viewBox="0 0 12 36" fill="none" class="overflow-visible" aria-hidden="true">
                  <line
                    x1="6"
                    y1="0"
                    x2="6"
                    y2="26"
                    stroke="#5446FF"
                    stroke-width="2"
                    stroke-dasharray="5 4"
                    stroke-linecap="round"
                    data-sot-mobile-line
                  />
                  <path
                    d="M2.5 22L6 29L9.5 22"
                    stroke="#5446FF"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <!-- Orange Arrow -->
                <svg width="12" height="36" viewBox="0 0 12 36" fill="none" class="overflow-visible" aria-hidden="true">
                  <line
                    x1="6"
                    y1="0"
                    x2="6"
                    y2="26"
                    stroke="#F59E0B"
                    stroke-width="2"
                    stroke-dasharray="5 4"
                    stroke-linecap="round"
                    data-sot-mobile-line
                  />
                  <path
                    d="M2.5 22L6 29L9.5 22"
                    stroke="#F59E0B"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <!-- Green Arrow -->
                <svg width="12" height="36" viewBox="0 0 12 36" fill="none" class="overflow-visible" aria-hidden="true">
                  <line
                    x1="6"
                    y1="0"
                    x2="6"
                    y2="26"
                    stroke="#10B981"
                    stroke-width="2"
                    stroke-dasharray="5 4"
                    stroke-linecap="round"
                    data-sot-mobile-line
                  />
                  <path
                    d="M2.5 22L6 29L9.5 22"
                    stroke="#10B981"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <!-- 4. cleartax Multi-Mandate Engine Card -->
              <div class="flex flex-col gap-4 rounded-xl border-2 border-neutral-400 bg-generic-00 p-5">
                <div class="flex flex-col gap-1.5">
                  <p class="m-0 font-heading font-semibold text-vault-navy text-2xl tracking-tight">
                    cleartax
                  </p>
                  <p class="m-0 font-body font-semibold text-nova-blue text-base">
                    multi-mandate engine
                  </p>
                </div>
                <div class="h-px w-full bg-neutral-200" />
                <div class="flex flex-col gap-2.5">
                  <p class="m-0 font-body font-semibold text-vault-navy text-xs tracking-wider uppercase">
                    RECEIVES
                  </p>
                  <ul class="m-0 flex flex-col gap-2.5 list-none p-0">
                    {receives.map((r) => (
                      <li class="flex items-center gap-2.5 font-body text-neutral-600 text-xs sm:text-sm">
                        <span class={`h-3.5 w-3.5 shrink-0 rounded-xs ${FLOW_COLOR[r.tag]}`} />
                        <span>{r.label}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="h-px w-full bg-neutral-200" />
                <div class="flex flex-col gap-1">
                  <p class="m-0 font-body font-semibold text-vault-navy text-xs sm:text-sm">
                    Single source of tax truth
                  </p>
                  <p class="m-0 font-body text-neutral-500 text-xs sm:text-sm leading-relaxed whitespace-pre-line">
                    {"- Audit-proof\n- Reconciled\n- Archived"}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  .sot-tab[aria-selected="true"] {
    background-color: var(--color-generic-00);
    color: var(--color-nova-blue);
    box-shadow: 0px 1px 2px 0px rgba(16, 24, 40, 0.04);
  }
  .sot-tab[aria-selected="false"] {
    background-color: transparent;
    color: var(--color-neutral-700);
  }
</style>

<script is:inline>
  (function () {
    /**
     * Connector draw-in: no <mask>, no stroke-dashoffset-through-a-mask —
     * see FlowCanvas.astro's doc comment on `straightLines`/`bentWires` for
     * why (a real Chrome bug: `zoom` — this site's `--page-zoom`, shared.css
     * — breaks SVG masks outright). Instead GSAP animates the actual
     * geometry: a straight <line>'s `x2`/`y2` attributes grow from its
     * `x1`/`y1` (its own `6 5` dasharray is never touched, so the dots you
     * see are the same dots throughout — just more of them as the line
     * extends); a bent <path>'s `d` is rebuilt every frame from a
     * length-truncated copy of its point list (`data-points`), re-rounded
     * with the same `roundedPolylineJS` FlowCanvas.astro's build-time
     * `roundedPolyline` mirrors.
     *
     * Staged in the order data actually moves through the diagram (see
     * FlowCanvas.astro's `Stage` type for the exact grouping) — sources
     * emit, merge onto the purple bus, feed billing; billing emits, merges
     * onto the green bus (and taps the middleware feed), feeds ERP GL; ERP
     * GL emits to cleartax. The bypass source's `orange-full` wire skips
     * billing entirely in one continuous path, so it gets a longer duration
     * instead of its own stage, timed to land at ERP GL together with the
     * other colors rather than arriving early.
     *
     * Plays once, on first scroll into view. GSAP loads from the same CDN
     * this codebase already uses elsewhere (global-homepage/WhyGenericAi.astro),
     * self-injected here rather than assumed already present on the page,
     * so this section works even if pasted somewhere that doesn't load it.
     */
    const STAGE_DURATION = 0.45;
    const EASE = "sine.out";
    const STAGE_ORDER = [
      "src-entry",
      "src-trunk",
      "src-exit",
      "bill-entry",
      "bill-trunk",
      "bill-exit",
      "final",
    ];

    const prefersReducedMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function loadGsap(onReady) {
      if (window.gsap) return onReady();
      const existing = document.querySelector("script[data-gsap-cdn]");
      if (existing) {
        existing.addEventListener("load", onReady, { once: true });
        return;
      }
      const s = document.createElement("script");
      s.src = "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js";
      s.dataset.gsapCdn = "true";
      s.onload = onReady;
      document.head.appendChild(s);
    }

    // Mirrors FlowCanvas.astro's build-time `roundedPolyline` exactly.
    function roundedPolylineJS(points, r) {
      if (points.length < 2) return "";
      let d = `M ${points[0].x} ${points[0].y}`;
      for (let i = 1; i < points.length - 1; i++) {
        const prev = points[i - 1];
        const curr = points[i];
        const next = points[i + 1];
        const inLen = Math.hypot(curr.x - prev.x, curr.y - prev.y);
        const outLen = Math.hypot(next.x - curr.x, next.y - curr.y);
        const radius = Math.min(r, inLen / 2, outLen / 2);
        const inX = curr.x + ((prev.x - curr.x) / inLen) * radius;
        const inY = curr.y + ((prev.y - curr.y) / inLen) * radius;
        const outX = curr.x + ((next.x - curr.x) / outLen) * radius;
        const outY = curr.y + ((next.y - curr.y) / outLen) * radius;
        d += ` L ${inX} ${inY} Q ${curr.x} ${curr.y} ${outX} ${outY}`;
      }
      const last = points[points.length - 1];
      d += ` L ${last.x} ${last.y}`;
      return d;
    }

    function parsePoints(str) {
      return str.split(" ").map((pair) => {
        const [x, y] = pair.split(",").map(Number);
        return { x, y };
      });
    }

    function polylineLength(points) {
      let len = 0;
      for (let i = 0; i < points.length - 1; i++)
        len += Math.hypot(
          points[i + 1].x - points[i].x,
          points[i + 1].y - points[i].y,
        );
      return len;
    }

    // Points from the wire's start up to `targetLen` along it — the
    // truncated shape `roundedPolylineJS` re-rounds every frame.
    function pointsUpToLength(points, targetLen) {
      let acc = 0;
      const result = [points[0]];
      for (let i = 0; i < points.length - 1; i++) {
        const a = points[i];
        const b = points[i + 1];
        const segLen = Math.hypot(b.x - a.x, b.y - a.y);
        if (acc + segLen >= targetLen) {
          const t = segLen === 0 ? 0 : (targetLen - acc) / segLen;
          result.push({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t });
          return result;
        }
        result.push(b);
        acc += segLen;
      }
      return result;
    }

    function prepareLine(gsap, el) {
      const x1 = Number(el.getAttribute("x1"));
      const y1 = Number(el.getAttribute("y1"));
      const x2 = Number(el.getAttribute("x2"));
      const y2 = Number(el.getAttribute("y2"));
      gsap.set(el, { attr: { x2: x1, y2: y1 } });
      return { type: "line", el, final: { x2, y2 } };
    }

    function preparePath(el) {
      const points = parsePoints(el.getAttribute("data-points"));
      const radius = Number(el.getAttribute("data-radius"));
      const total = polylineLength(points);
      el.setAttribute("d", `M ${points[0].x} ${points[0].y}`);
      return { type: "path", el, points, radius, total };
    }

    function tweenItem(tl, item, duration, position) {
      if (item.type === "line") {
        tl.to(
          item.el,
          {
            attr: { x2: item.final.x2, y2: item.final.y2 },
            duration,
            ease: EASE,
          },
          position,
        );
      } else {
        const proxy = { p: 0 };
        tl.to(
          proxy,
          {
            p: 1,
            duration,
            ease: EASE,
            onUpdate: () =>
              item.el.setAttribute(
                "d",
                roundedPolylineJS(
                  pointsUpToLength(item.points, proxy.p * item.total),
                  item.radius,
                ),
              ),
          },
          position,
        );
      }
    }

    function animatePanel(panel) {
      if (!panel || panel.dataset.sotAnimated === "true") return;
      panel.dataset.sotAnimated = "true";
      const lines = Array.from(panel.querySelectorAll("[data-sot-line]"));
      if (!lines.length) return;

      if (prefersReducedMotion) return; // leave the static dashed lines as-is

      const gsap = window.gsap;
      const byStage = {};
      lines.forEach((line) => {
        const item =
          line.getAttribute("data-shape") === "line"
            ? prepareLine(gsap, line)
            : preparePath(line);
        const stage = line.getAttribute("data-stage");
        if (!byStage[stage]) byStage[stage] = [];
        byStage[stage].push(item);
      });

      const tl = gsap.timeline();
      STAGE_ORDER.forEach((stage, i) => {
        const group = byStage[stage];
        if (!group) return;
        group.forEach((item) =>
          tweenItem(tl, item, STAGE_DURATION, i * STAGE_DURATION),
        );
      });

      // The bypass source's wire skips billing in one continuous wire —
      // stretch its draw to land at ERP GL (stage index of "final") in step
      // with the other colors instead of finishing after just one stage.
      const orangeGroup = byStage["orange-full"];
      if (orangeGroup) {
        const finalIndex = STAGE_ORDER.indexOf("final");
        orangeGroup.forEach((item) =>
          tweenItem(tl, item, STAGE_DURATION * finalIndex, 0),
        );
      }

      // The middleware feed taps off the billing bus, so it plays alongside
      // that merge rather than getting its own place in STAGE_ORDER.
      const midFeedGroup = byStage["mid-feed"];
      if (midFeedGroup) {
        const billTrunkIndex = STAGE_ORDER.indexOf("bill-trunk");
        midFeedGroup.forEach((item) =>
          tweenItem(tl, item, STAGE_DURATION, billTrunkIndex * STAGE_DURATION),
        );
      }
    }

    function animateMobileLines(panel) {
      if (!panel || panel.dataset.sotAnimated === "true") return;
      panel.dataset.sotAnimated = "true";
      if (prefersReducedMotion) return;

      const gsap = window.gsap;
      if (!gsap) return;

      const lines = Array.from(panel.querySelectorAll("[data-sot-mobile-line]"));
      if (!lines.length) return;

      lines.forEach((line) => {
        const y1 = Number(line.getAttribute("y1"));
        const y2 = Number(line.getAttribute("y2"));
        line.dataset.finalY2 = String(y2);
        gsap.set(line, { attr: { y2: y1 } });
      });

      const tl = gsap.timeline({ delay: 0.15 });

      // Group 1: Connector 1 (Sources -> Billing)
      const conn1 = panel.querySelector("[data-sot-conn='1'] [data-sot-mobile-line]");
      if (conn1) {
        tl.to(conn1, {
          attr: { y2: Number(conn1.dataset.finalY2) },
          duration: 0.35,
          ease: EASE,
        });
      }

      // Group 2: Connector 2 (Billing -> ERP GL)
      const conn2 = panel.querySelector("[data-sot-conn='2'] [data-sot-mobile-line]");
      if (conn2) {
        tl.to(
          conn2,
          {
            attr: { y2: Number(conn2.dataset.finalY2) },
            duration: 0.35,
            ease: EASE,
          },
          "+=0.1",
        );
      }

      // Group 3: Connector 3 (ERP GL -> cleartax: 3 arrows)
      const conn3 = panel.querySelectorAll("[data-sot-conn='3'] [data-sot-mobile-line]");
      if (conn3.length) {
        tl.to(
          conn3,
          {
            attr: { y2: (i, target) => Number(target.dataset.finalY2) },
            duration: 0.35,
            stagger: 0.08,
            ease: EASE,
          },
          "+=0.1",
        );
      }
    }

    document.querySelectorAll("[data-sot-stage]").forEach((stage) => {
      const track = stage.querySelector("[data-sot-track]");
      if (!track) return;
      const designWidth = track.offsetWidth;
      const designHeight = track.offsetHeight;

      const resize = () => {
        if (!stage.offsetParent) return;
        const scale = stage.clientWidth / designWidth;
        track.style.transform = `scale(${scale})`;
        track.style.transformOrigin = "top left";
        stage.style.height = `${designHeight * scale}px`;
      };

      window.addEventListener("resize", resize);
      resize();

      const cardContainer = stage.parentElement;
      const tabsRoot = cardContainer.querySelector("[data-sot-tabs]");
      const tabs = tabsRoot ? tabsRoot.querySelectorAll("[data-sot-tab]") : [];
      const panels = track.querySelectorAll("[data-sot-panel]");
      const mobilePanels = cardContainer.querySelectorAll("[data-sot-mobile-panel]");

      let hasEnteredView = false;
      const activePanel = () =>
        Array.from(panels).find((p) => !p.classList.contains("hidden"));
      const activeMobilePanel = () =>
        Array.from(mobilePanels).find((p) => !p.classList.contains("hidden"));

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            hasEnteredView = true;
            loadGsap(() => {
              if (window.innerWidth >= 768) {
                animatePanel(activePanel());
              } else {
                animateMobileLines(activeMobilePanel());
              }
            });
            observer.disconnect();
          });
        },
        { threshold: 0.15 },
      );
      observer.observe(cardContainer);

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const key = tab.getAttribute("data-sot-tab");
          tabs.forEach((t) =>
            t.setAttribute("aria-selected", t === tab ? "true" : "false"),
          );
          panels.forEach((p) =>
            p.classList.toggle(
              "hidden",
              p.getAttribute("data-sot-panel") !== key,
            ),
          );
          mobilePanels.forEach((p) =>
            p.classList.toggle(
              "hidden",
              p.getAttribute("data-sot-mobile-panel") !== key,
            ),
          );
          if (hasEnteredView) {
            loadGsap(() => {
              if (window.innerWidth >= 768) {
                animatePanel(activePanel());
              } else {
                animateMobileLines(activeMobilePanel());
              }
            });
          }
        });
      });
    });
  })();
</script>
