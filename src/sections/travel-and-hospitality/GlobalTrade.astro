---
/**
 * "Solving the complexity of travel and hospitality." Travel and
 * Hospitality variant of banking-and-financial-services/GlobalTrade.astro's
 * sticky scroll-jack card track — same mechanism (see that file's doc
 * comment for the shared pattern across `_shared/UnderneathMandate.astro` /
 * `uae-regional/Network.astro` / `direct-tax-page/Filing.astro`), re-skinned
 * with the six travel & hospitality edge cases from the source doc. Each
 * card's `trade-card-img` slot stays a placeholder, same as
 * banking-and-financial-services — the source doc's mockup screenshots
 * (word/media/image1-6.png) are illustrative UI, not hosted Webflow assets
 * to paste in yet.
 */
interface TradeCard {
  title: string;
  text: string;
}

const cards: TradeCard[] = [
  {
    title: "Group and corporate accounts need one invoice across thousands of stays",
    text: "Folio data aggregates into one summary invoice per account per period, with every stay preserved as a distinct line, meeting each country's aggregation rules without losing the audit chain.",
  },
  {
    title: "A single folio can carry four different tax treatments at line level",
    text: "Every posting code in your PMS is validated against the code list of the country the property sits in, with rate as well as category checked before issuance.",
  },
  {
    title: "A no-show is taxable on a plane and not taxable in a hotel",
    text: "Each retained amount is classified by what it actually is: a forfeited deposit, a fare already earned, or a fee that replaces the price, and treated per market and product.",
  },
  {
    title: "A package is taxed on your margin, not on what the traveller paid",
    text: "The margin is computed per departure from actual bought-in cost, the scheme marker applied, and the tax line suppressed on the customer document where the scheme requires it.",
  },
  {
    title: "Agent or principal decides your entire tax position before the booking confirms",
    text: "The determination is held per contract and per supplier, applied at the moment of confirmation, issuing either a commission invoice or a full margin-scheme document. Versioned, so it moves when an agreement is renegotiated.",
  },
  {
    title: "The international leg is relieved; the domestic one is not",
    text: "A multi-sector itinerary splits by route at the point of issue. On accommodation, the property register drives the place of supply, so each hotel files where it stands.",
  },
];
---

<div class="trade-sticky-container">
  <section class="sticky top-0 flex flex-col justify-center bg-generic-00 border-t border-neutral-200 py-16 lg:py-20 overflow-hidden min-h-[calc(100vh-80px)]">
    <div class="container flex flex-col gap-12">
      <h2 class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]">
        Solving the complexity of travel and hospitality.
      </h2>

      <div class="flex flex-col gap-12">
        <div class="w-full h-auto">
          <div
            class="trade-track flex items-start gap-12 w-max transition-transform duration-[250ms] ease-out will-change-transform"
            data-trade-track
          >
            {
              cards.map((card) => (
                <div class="trade-card flex flex-col gap-6 shrink-0 w-[85vw] sm:w-105 lg:w-[560px] select-none">
                  <div class="trade-card-img aspect-[1280/720] w-full bg-visual-placeholder rounded-lg pointer-events-none"></div>
                  <div class="flex flex-col gap-4 pointer-events-none">
                    <p class="trade-card-title m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px]">
                      {card.title}
                    </p>
                    <p class="trade-card-desc m-0 font-body text-neutral-500 text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                      {card.text}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="relative h-2 w-full rounded-lg bg-neutral-300 overflow-hidden" aria-hidden="true">
          <div class="trade-progress-fill absolute inset-y-0 left-0 rounded-lg bg-nova-blue" data-trade-fill></div>
        </div>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    const initTradeScroll = () => {
      const containers = document.querySelectorAll(".trade-sticky-container");
      if (!containers.length) return;

      containers.forEach((container) => {
        const track = container.querySelector("[data-trade-track]");
        const section = container.querySelector("section");
        const fill = container.querySelector("[data-trade-fill]");
        if (!track || !section) return;

        const getHeaderHeight = () => {
          const header = document.querySelector("header, .navbar, .w-nav");
          return header ? header.offsetHeight : 80;
        };

        let maxTranslate = 0;
        let totalScrollable = 0;
        let stickyTop = 0;

        const updateMeasurements = () => {
          const sectionHeight = section.offsetHeight;
          const windowHeight = window.innerHeight;
          const headerHeight = getHeaderHeight();

          const trackOffset = track.parentElement.getBoundingClientRect().top - section.getBoundingClientRect().top;
          const trackHeight = track.offsetHeight;
          const availableSpace = windowHeight - headerHeight;

          const idealTrackTop = headerHeight + Math.max(40, (availableSpace - trackHeight) / 2);
          const calculatedTop = idealTrackTop - trackOffset;

          // Position section flush under header when sticky, avoiding gap on large screens
          stickyTop = Math.min(headerHeight, calculatedTop);
          section.style.top = `${stickyTop}px`;

          const containerWidth = track.parentElement.getBoundingClientRect().width;
          maxTranslate = Math.max(0, track.scrollWidth - containerWidth);
          container.style.height = `${maxTranslate + windowHeight}px`;
          totalScrollable = container.getBoundingClientRect().height - sectionHeight;
        };

        updateMeasurements();

        if (window.ResizeObserver) {
          const ro = new ResizeObserver(updateMeasurements);
          ro.observe(section);
          ro.observe(track);
        }
        window.addEventListener("resize", updateMeasurements);

        let ticking = false;

        const handleScroll = () => {
          if (ticking) return;
          window.requestAnimationFrame(() => {
            const containerRect = container.getBoundingClientRect();
            const scrolledDistance = Math.max(0, stickyTop - containerRect.top);

            let progress = totalScrollable > 0 ? scrolledDistance / totalScrollable : 0;
            progress = Math.max(0, Math.min(1, progress));

            track.style.transform = `translate3d(-${progress * maxTranslate}px, 0, 0)`;

            if (fill) {
              fill.style.width = `${progress * 100}%`;
            }

            ticking = false;
          });
          ticking = true;
        };

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                window.addEventListener("scroll", handleScroll, { passive: true });
                handleScroll();
              } else {
                window.removeEventListener("scroll", handleScroll);
              }
            });
          },
          { rootMargin: "100% 0px 100% 0px" },
        );

        observer.observe(container);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTradeScroll);
    } else {
      initTradeScroll();
    }
  })();
</script>
