---
/**
 * "Real-life examples" — same bordered two-column card shape as
 * accounts-payable/RealLifeExample.astro, content swapped for the duplicated
 * e-invoice posting example from the Tax Automation doc.
 */
const findings = [
  "RM349K recorded against RM184K invoiced",
  "Duplicate revenue entries across the ledger",
  "Revenue overstated by 0.22% each month",
  "Recurring tax overpayments of $121K annually",
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
    <div
      class="flex flex-col lg:flex-row gap-6 lg:gap-8 border border-neutral-200 rounded-xl p-6"
    >
      <div class="flex flex-col gap-6 flex-1">
        <div class="flex flex-col gap-4">
          <h2
            class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
          >
            Real life examples
          </h2>
          <p
            class="m-0 font-body text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
          >
            $2.31M in duplicate revenue postings. $121K in annual tax
            overpayments.
          </p>
        </div>

        <div class="h-px w-full bg-ledger-100"></div>

        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-4">
            <p
              class="m-0 font-body text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
            >
              AI matched every e-invoice against its underlying ledger entries,
              uncovering discrepancies too small to surface in aggregate
              reviews.
            </p>
            <div class="flex flex-col gap-2">
              <p
                class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
              >
                It identified 8,397 duplicate postings, including :
              </p>
              <ul class="list-none m-0 p-0 flex flex-col gap-2">
                {
                  findings.map((f) => (
                    <li class="flex items-center gap-2">
                      <span
                        class="shrink-0 w-2 h-2 rounded-full bg-nova-blue"
                        aria-hidden="true"
                      />
                      <span class="font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                        {f}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <p
            class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]"
          >
            By detecting these discrepancies at the transaction level, AI helps
            prevent small accounting errors from becoming recurring tax costs.
          </p>
        </div>
      </div>

      <div class="flex-1 flex items-center justify-center">
        <img
          src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adf666ebcf4459017e86cee_image-1.png"
          alt="Duplicate revenue postings detected"
          width="598"
          height="406"
          class="w-full h-auto object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
