---
/**
 * "Real-life examples" — same bordered two-column card shape as
 * accounts-payable/RealLifeExample.astro, content swapped for the plant
 * costing example from the Financial Planning & Analysis doc.
 */
const findings = [
  "Differences across 8 manufacturing plants",
  "Actual costs across 14 components",
  "Variations by plant, component and dye depth",
  "Savings opportunities hidden in aggregated costs",
];
---

<section class="bg-generic-00 py-16 lg:py-20">
  <div class="max-w-[var(--container-max)] w-full px-4 md:px-6 mx-auto">
    <div
      class="flex flex-col lg:flex-row gap-6 lg:gap-8 border border-neutral-200 rounded-xl p-6"
    >
      <div class="flex flex-col gap-6 flex-1">
        <div class="flex flex-col gap-4">
          <h2
            class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px]"
          >
            Real-life examples
          </h2>
          <p
            class="m-0 font-body text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]"
          >
            14 cost components. 8 plants. Up to 1.57M in annual EBITDA impact
            per 1% saved.
          </p>
        </div>

        <div class="h-px w-full bg-ledger-100"></div>

        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-4">
            <p
              class="m-0 font-body text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)] max-w-128"
            >
              Clarity AI replaced Excel-based costing assumptions with actual
              SAP data, revealing how production costs varied across plants.
            </p>
            <div class="flex flex-col gap-2">
              <p
                class="m-0 font-body text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
              >
                It broke down costs to uncover :
              </p>
              <ul class="list-none m-0 p-0 flex flex-col gap-2">
                {
                  findings.map((f) => (
                    <li class="flex items-center gap-2">
                      <span
                        class="shrink-0 w-2 h-2 rounded-full bg-nova-blue"
                        aria-hidden="true"
                      />
                      <span class="font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)]">
                        {f}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <p
            class="m-0 font-body text-neutral-500 text-[length:var(--fs-body-sm)] leading-[length:var(--lh-body-sm)] max-w-127.5"
          >
            By analysing actual consumption instead of assumptions, Clarity AI
            made even a 1% cost improvement measurable and actionable.
          </p>
        </div>
      </div>

      <div class="flex-1 flex items-center justify-center">
        <img
          src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6adf6b3691d427b7918afdd4_Icon.png"
          alt="Duplicate revenue postings detected"
          width="598"
          height="406"
          class="w-full h-auto object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
