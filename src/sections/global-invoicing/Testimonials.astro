---
/**
 * Testimonials — Figma "Trusted by industry leaders across the world".
 * Three cards in view on the shared .gi-rail, the rest scrolling past.
 */
interface Props {
  heading?: string;
  testimonials?: { quote: string; name: string; role: string; logo?: string; logoAlt?: string }[];
}

const {
  heading = 'Trusted by industry leaders across the world',
  testimonials = [
    { quote: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros.', name: 'Abdulbary Atassi', role: 'DIRECTOR OF IT, Zamil Industrial (KSA) — Saudi Arabia' },
    { quote: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros.', name: 'Abdulbary Atassi', role: 'DIRECTOR OF IT, Zamil Industrial (KSA) — Saudi Arabia' },
    { quote: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros.', name: 'Abdulbary Atassi', role: 'DIRECTOR OF IT, Zamil Industrial (KSA) — Saudi Arabia' },
  ],
} = Astro.props;
---

<section class="gi-testimonials">
  <div class="container">
    <div class="gi-section-head">
      <h2 class="gi-h2">{heading}</h2>
    </div>
  </div>

  <div class="gi-rail gi-testimonials-rail">
    <ul class="gi-rail-track">
      {testimonials.map((t) => (
        <li class="gi-tcard">
          <span class="gi-tcard-logo" aria-hidden="true">
            {t.logo && <img src={t.logo} alt={t.logoAlt ?? ''} loading="lazy" />}
          </span>
          <blockquote class="gi-tcard-quote">{t.quote}</blockquote>
          <div>
            <p class="gi-tcard-name">{t.name}</p>
            <p class="gi-tcard-role">{t.role}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style is:global>
  .gi-testimonials {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--spacing-xxx-lg);
  }

  .gi-testimonials-rail { margin-top: var(--spacing-lg); }

  .gi-tcard {
    scroll-snap-align: start;
    flex: 0 0 400px;
    max-width: 85vw;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding: var(--spacing-x-big);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--palette-generic-00);
  }

  .gi-tcard-logo {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: var(--palette-ledger-200);
  }

  .gi-tcard-logo img { max-width: 28px; height: auto; }

  .gi-tcard-quote {
    flex: 1;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--color-text-muted);
  }

  .gi-tcard-name {
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .gi-tcard-role {
    margin-top: var(--spacing-xx-sm);
    font-size: var(--fs-label-xs);
    line-height: var(--lh-label-xs);
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
