---
const erpLogos = [
    'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c03b3ca5a4e9c5f2a75dc_logo-mandate-1.png',
    'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c03b35e841506fe93ca61_logo-mandate-2.png',
    'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c03b3d1814377dfd2db31_logo-mandate-3.png',
    'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c03b3963e6b03d4317dfc_logo-mandate-4.png'
];

const mandates = [
    { flagUrl: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c06e7b6e2110cb896c07d_United%20Arab%20Emirates%20(AE).png' },
    { flagUrl: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c06e7ab3a72ddef175c4c_tax-flag-2.png' },
    { flagUrl: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c06e78a50d2d94421983b_tax-flag-3.png' },
    { flagUrl: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c06e7b0d97353e7425712_tax-flag-4.png' },
    { flagUrl: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c06e77e644cd54aaec868_tax-flag-5.png' },
    { flagUrl: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c06e73b86dda0c433f379_tax-flag-6.png' },
    { flagUrl: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c06e768c5aaebb11a62c0_tax-flag-7.png' },
    { flagUrl: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c06e71f1b9187ce88ff1e_tax-flag-8.png' },
];

// Dot counts per column, matching the Figma source exactly (wide near the card, tapering toward the hub).
const DOT_COUNTS = [12, 11, 10, 9, 8, 7, 5, 4];
const DOT_COLOR = '#A6C705';
---
<section class="bg-white py-20 overflow-hidden">
    <div class="wf-container mx-auto px-4">
        <div class="text-center mb-8 lg:mb-12">
            <h2 class="text-[28px]! sm:text-[36px]! lg:text-[40px]! lg:leading-[1.2]! font-medium! text-vault-navy! mb-4! mt-0">
                One API. Every Mandate.
            </h2>
            <p class="text-base! lg:text-lg! text-neutral-500 font-normal! max-w-3xl! mx-auto!">
                One API. Country mandates sit on top of it as configuration, not separate builds. When a new country goes live, you switch it on. Your integration doesn't change.
            </p>
        </div>

        <div class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:items-stretch gap-10">
            <!-- Your System Column -->
            <div class="w-full lg:w-67.25 shrink-0">
                <div class="bg-white rounded-xl border-2 border-neutral-300 p-6 h-full flex flex-col items-center gap-6 max-w-120 w-full mx-auto">
                    <h3 class="text-vault-navy text-xl font-medium m-0">Your System</h3>
                    <div class="flex-1 min-h-0 w-full flex flex-col gap-2">
                        {erpLogos.map((logo, i) => (
                            <div class="flex-1 min-h-0 bg-white rounded-lg border border-neutral-300 flex items-center justify-center px-4 py-3">
                                <img src={logo} alt={`ERP Logo ${i + 1}`} class="max-h-9 w-auto object-contain" loading="lazy" decoding="async" />
                            </div>
                        ))}
                    </div>
                    <p class="text-base text-neutral-500 font-medium m-0">and more</p>
                </div>
            </div>

            <!-- Connector / Hub -->
            <div class="w-full lg:flex-1 lg:min-w-0 flex items-center justify-center overflow-hidden">
                <div class="flex flex-col lg:flex-row items-center justify-center gap-6 xl:gap-10">
                    <!-- Desktop: wide column nearest the card, tapering toward the hub -->
                    <div class="hidden lg:flex items-center gap-6">
                        {DOT_COUNTS.map((count) => (
                            <div class="flex flex-col items-center gap-5.5">
                                {Array.from({ length: count }).map(() => (
                                    <span class="w-1 h-1 rounded-full shrink-0" style={`background-color:${DOT_COLOR}`}></span>
                                ))}
                            </div>
                        ))}
                    </div>
                    <!-- Mobile: wide row nearest the card above, tapering toward the hub below -->
                    <div class="flex lg:hidden flex-col items-center gap-6">
                        {DOT_COUNTS.map((count) => (
                            <div class="flex flex-row items-center gap-5.5">
                                {Array.from({ length: count }).map(() => (
                                    <span class="w-1 h-1 rounded-full shrink-0" style={`background-color:${DOT_COLOR}`}></span>
                                ))}
                            </div>
                        ))}
                    </div>

                    <!-- Global Unified API label + logo -->
                    <div class="flex flex-col items-center gap-2 shrink-0">
                        <span class="text-[22px] text-vault-navy font-medium">Global Unified API</span>
                        <img
                            src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8c2363dbd39f65f659c31a_cleartax-logo.png"
                            alt="ClearTax"
                            class="h-8 lg:h-9 w-auto object-contain"
                            loading="lazy"
                            decoding="async"
                        />
                    </div>

                    <!-- Desktop: mirrored, so the wide column sits nearest the Tax Authorities card -->
                    <div class="hidden lg:flex items-center gap-6 scale-x-[-1]">
                        {DOT_COUNTS.map((count) => (
                            <div class="flex flex-col items-center gap-5.5">
                                {Array.from({ length: count }).map(() => (
                                    <span class="w-1 h-1 rounded-full shrink-0" style={`background-color:${DOT_COLOR}`}></span>
                                ))}
                            </div>
                        ))}
                    </div>
                    <!-- Mobile: mirrored, so the wide row sits nearest the Tax Authorities card below -->
                    <div class="flex lg:hidden flex-col items-center gap-6 scale-y-[-1]">
                        {DOT_COUNTS.map((count) => (
                            <div class="flex flex-row items-center gap-5.5">
                                {Array.from({ length: count }).map(() => (
                                    <span class="w-1 h-1 rounded-full shrink-0" style={`background-color:${DOT_COLOR}`}></span>
                                ))}
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Tax Authorities Column -->
            <div class="w-full lg:w-66.75 shrink-0">
                <div class="bg-white rounded-xl border border-neutral-300 p-6 h-full flex flex-col items-center gap-6 max-w-120 w-full mx-auto">
                    <h3 class="text-vault-navy text-xl font-medium m-0">Tax Authorities</h3>
                    <div class="w-full flex flex-col gap-2">
                        {mandates.map((m) => (
                            <div class="h-12 shrink-0 bg-white rounded-lg border border-neutral-300 flex items-center justify-center">
                                <div class="w-6 h-6 rounded-sm border border-neutral-300 shrink-0 overflow-hidden">
                                    <img src={m.flagUrl} alt="flag" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                                </div>
                            </div>
                        ))}
                    </div>
                    <p class="text-base text-nova-blue m-0">
                        <span class="font-semibold">50+</span><span class="font-medium"> Countries &amp; Growing</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
