---
/**
 * Platform cards — Figma "ClearTax is a Continuous Compliance Platform".
 * A scroll-snap rail of cards: media panel, title, body. Three sit in view at
 * 1280 and the rest run past the right edge.
 *
 * Shared furniture (.gi-h2, .gi-section-head, .gi-btn, …) is declared once in
 * Hero.astro — every section on this page lives in one CSS namespace, so it
 * must not be redeclared here.
 */
interface Props {
  heading?: string;
  body?: string;
  cards?: { title: string; body: string; image?: string; imageAlt?: string }[];
}

const {
  heading = 'ClearTax is a Continuous Compliance Platform',
  body = 'Enterprise-grade infrastructure trusted by the world’s largest organisations',
  cards = [
    { title: 'Built for Your Busiest Day', body: '10,000+ e-invoices per second. Infrastructure auto-scales as transactions grow. Month-end peaks. POS surges handled without slowdown.' },
    { title: 'Connects to Everything You Run On', body: 'SAP, Oracle, MS Dynamics, OMS, POS billing systems — all through pre-built certified connectors you run on.' },
    { title: 'Always On, Always Watching', body: 'Detects mandate changes and schema updates without downtime. 99.98% uptime across every market.' },
  ],
} = Astro.props;
---

<section class="gi-platform">
  <div class="container">
    <div class="gi-section-head">
      <h2 class="gi-h2">{heading}</h2>
      <p class="gi-section-body">{body}</p>
    </div>
  </div>

  <div class="gi-rail">
    <ul class="gi-rail-track">
      {cards.map((c) => (
        <li class="gi-pcard">
          <h3 class="gi-h5">{c.title}</h3>
          <div class="gi-pcard-media">
            {c.image && <img src={c.image} alt={c.imageAlt ?? ''} loading="lazy" />}
          </div>
          <p class="gi-pcard-body">{c.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style is:global>
  .gi-platform {
    background: var(--color-surface);
    padding-block: var(--spacing-xxx-lg);
  }

  /* Full-bleed rail, reused by Testimonials. Cards run past the container. */
  .gi-rail {
    margin-top: var(--spacing-lg);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: max(var(--spacing-x-big), calc((100vw - var(--container-max)) / 2 + var(--spacing-x-big)));
  }

  .gi-rail::-webkit-scrollbar { display: none; }

  .gi-rail-track {
    display: flex;
    gap: var(--spacing-big);
    list-style: none;
    width: max-content;
  }

  .gi-pcard {
    scroll-snap-align: start;
    flex: 0 0 400px;
    max-width: 85vw;
    display: flex;
    flex-direction: column;
    padding: var(--spacing-x-big);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--palette-generic-00);
  }

  .gi-pcard-media {
    margin-block: var(--spacing-md);
    aspect-ratio: 352 / 200;
    border-radius: 8px;
    background: var(--palette-success-100);
    overflow: hidden;
  }

  .gi-pcard-media img { width: 100%; height: 100%; object-fit: cover; }

  .gi-pcard-body {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--color-text-muted);
  }
</style>
