---
/**
 * Footer for the Global Invoicing page — the paste unit.
 * Content only; layout lives in `_shared/FooterRb.astro`.
 *
 * The v2 mockup uses a short footer, so this carries the four primary links
 * from it, pointed at the real URLs used by the v1 footer.
 */
import FooterRb from '../_shared/FooterRb.astro';

const links = [
  { label: 'About us', href: 'https://www.cleartax.com/about-us' },
  { label: 'Resources', href: 'https://www.cleartax.com/electronic-invoicing#country-select' },
  { label: 'Partners', href: 'https://www.cleartax.com/global/partner-program' },
  { label: 'Contact', href: 'http://cleartax.com/contact-us' },
];

const legal = [
  { label: 'Privacy Policy', href: 'https://www.cleartax.com/meta/privacy' },
  { label: 'Terms of use', href: 'https://www.cleartax.com/meta/terms' },
];
---

<FooterRb
  links={links}
  legal={legal}
  copyright="© 2026 ClearTax Pvt. Ltd. All rights reserved"
  logoSrc="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
  logoAlt="cleartax"
/>
