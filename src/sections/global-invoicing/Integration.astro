---
/**
 * One API. Every Mandate. — Figma integration diagram.
 * Your System card, a fanned dot field converging on the API label, then the
 * Tax Authorities card. Dot fields are CSS gradients, not exported art.
 */
interface Props {
  heading?: string;
  body?: string;
  systemLabel?: string;
  systemFooter?: string;
  systems?: { src?: string; alt: string }[];
  apiLabel?: string;
  apiName?: string;
  authoritiesLabel?: string;
  authoritiesFooter?: string;
  authorities?: { flag?: string; name: string }[];
}

const {
  heading = 'One API. Every Mandate.',
  body = 'One API. Country mandates sit on top of it as configuration, not separate builds. When a new country goes live, you switch it on. Your integration doesn’t change.',
  systemLabel = 'Your System',
  systemFooter = 'and more',
  systems = [{ alt: 'SAP' }, { alt: 'Oracle' }, { alt: 'Microsoft Dynamics' }, { alt: 'NetSuite' }],
  apiLabel = 'Global Unified API',
  apiName = 'cleartax',
  authoritiesLabel = 'Tax Authorities',
  authoritiesFooter = '50+ Countries & Growing',
  authorities = [
    { name: 'United Arab Emirates' }, { name: 'Kuwait' }, { name: 'France' }, { name: 'Belgium' },
    { name: 'Malaysia' }, { name: 'Oman' }, { name: 'Poland' }, { name: 'Croatia' },
  ],
} = Astro.props;
---

<section class="gi-api">
  <div class="container">
    <div class="gi-section-head">
      <h2 class="gi-h2">{heading}</h2>
      <p class="gi-section-body">{body}</p>
    </div>

    <div class="gi-flow">
      <div class="gi-flow-card">
        <p class="gi-flow-title">{systemLabel}</p>
        <ul class="gi-flow-list">
          {systems.map((s) => (
            <li class="gi-flow-tile">
              {s.src ? <img src={s.src} alt={s.alt} loading="lazy" /> : <span>{s.alt}</span>}
            </li>
          ))}
        </ul>
        <p class="gi-flow-foot">{systemFooter}</p>
      </div>

      <div class="gi-flow-mid">
        <span class="gi-dots gi-dots-in" aria-hidden="true"></span>
        <div class="gi-flow-api">
          <p class="gi-flow-api-label">{apiLabel}</p>
          <p class="gi-flow-api-name">{apiName}</p>
        </div>
        <span class="gi-dots gi-dots-out" aria-hidden="true"></span>
      </div>

      <div class="gi-flow-card">
        <p class="gi-flow-title">{authoritiesLabel}</p>
        <ul class="gi-flow-list">
          {authorities.map((a) => (
            <li class="gi-flow-row">
              {a.flag
                ? <img src={a.flag} alt="" loading="lazy" />
                : <span class="gi-flow-flag" aria-hidden="true"></span>}
              <span class="gi-sr">{a.name}</span>
            </li>
          ))}
        </ul>
        <a class="gi-flow-foot gi-flow-link" href="#">{authoritiesFooter}</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .gi-api {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--spacing-xxx-lg);
  }

  .gi-sr {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .gi-flow {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 200px;
    gap: var(--spacing-x-big);
    align-items: stretch;
    margin-top: var(--spacing-lg);
  }

  .gi-flow-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-md);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--palette-generic-00);
  }

  .gi-flow-title {
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .gi-flow-list {
    list-style: none;
    width: 100%;
    margin-block: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-x-sm);
    flex: 1;
  }

  .gi-flow-tile,
  .gi-flow-row {
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }

  .gi-flow-tile {
    min-height: 56px;
    font-size: var(--fs-label-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }

  .gi-flow-tile img { max-height: 24px; width: auto; }

  .gi-flow-row { min-height: 34px; }
  .gi-flow-row img { width: 22px; height: auto; border-radius: 2px; }

  .gi-flow-flag {
    width: 22px;
    height: 15px;
    border-radius: 2px;
    background: var(--palette-ledger-300);
  }

  .gi-flow-foot {
    font-size: var(--fs-label-sm);
    line-height: var(--lh-label-sm);
    color: var(--color-text-muted);
  }

  .gi-flow-link { color: var(--color-text-link); font-weight: var(--font-weight-semibold); }

  .gi-flow-mid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spacing-md);
  }

  .gi-flow-api { text-align: center; }

  .gi-flow-api-label {
    font-size: var(--fs-label-sm);
    line-height: var(--lh-label-sm);
    color: var(--color-text-muted);
  }

  .gi-flow-api-name {
    font-family: var(--font-heading);
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
  }

  /* Fanned dot field: dots on a 22x20 lattice, masked into a converging wedge. */
  .gi-dots {
    display: block;
    height: 210px;
    background-image: radial-gradient(var(--palette-warning-300) 2px, transparent 2px);
    background-size: 22px 20px;
  }

  .gi-dots-in  { mask-image: radial-gradient(130% 100% at 100% 50%, #000 35%, transparent 72%); }
  .gi-dots-out { mask-image: radial-gradient(130% 100% at 0% 50%, #000 35%, transparent 72%); }

  @media (width < 1024px) {
    .gi-flow { grid-template-columns: 1fr; }
    .gi-flow-mid { grid-template-columns: 1fr; }
    .gi-dots { height: 64px; }
    .gi-dots-in  { mask-image: radial-gradient(100% 130% at 50% 100%, #000 35%, transparent 72%); }
    .gi-dots-out { mask-image: radial-gradient(100% 130% at 50% 0%, #000 35%, transparent 72%); }
  }
</style>
