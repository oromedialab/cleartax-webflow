const mobileTabs = [
  { key: "compliance", label: "Compliance" },
  { key: "integrations", label: "Integrations" },
  { key: "security", label: "Security" },
  { key: "support", label: "Service and Support" },
];
---

<section
  class="bg-generic-00 py-12 lg:py-20"
>
  <div class="max-w-[var(--container-max)] mx-auto px-6 w-full">
    <div class="text-center">
      <h2
        class="text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] mb-0 mt-0 font-medium text-black mb-12 tracking-[-0.02em] text-balance max-w-[732px] w-full mx-auto"
      >
        Seamless integrations, compliance &amp; dependable support
      </h2>
    </div>

    <!-- Mobile (<lg): sliding-pill tab bar + single switched panel. Same
         tablist pattern as india-homepage/MakingAiWork.astro — a moving
         `.gi-mtab-thumb` behind the active tab rather than per-tab background
         classes, inline `display` on the panels (not a class) so they can't
         race another unlayered utility once pasted into Webflow. -->
    <div class="lg:hidden" data-mobile-tabs-root>
      <div
        class="gi-mtab-tablist relative flex max-w-full items-center gap-1 overflow-x-auto rounded-xl bg-neutral-100 px-1 py-1.5"
        role="tablist"
        aria-label="Seamless integrations by category"
      >
        <span class="gi-mtab-thumb" aria-hidden="true"></span>
        {
          mobileTabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`gi-mtab-tab-${t.key}`}
              class="gi-mtab-tab relative z-10 shrink-0 cursor-pointer whitespace-nowrap rounded-lg border-0 bg-transparent px-6 py-2 text-center font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-neutral-700"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`gi-mtab-panel-${t.key}`}
              tabindex={i === 0 ? 0 : -1}
              data-gi-mtab={t.key}
            >
              {t.label}
            </button>
          ))
        }
      </div>

      <div class="mt-5">
        <div
          id="gi-mtab-panel-compliance"
          role="tabpanel"
          aria-labelledby="gi-mtab-tab-compliance"
          data-gi-mtab-panel="compliance"
        >
          <p class="text-[length:var(--fs-body)]! font-normal! text-black/50! leading-[length:var(--lh-body)]! m-0! mb-4!">
            Powering Global e-Invoicing Alongside Regulators
          </p>
          <div class="grid gap-3.5 grid-cols-1 sm:grid-cols-2 w-full">
            {
              complianceCardsRow1.map((c) => (
                <div class="bg-generic-00 rounded-[12px] p-4 flex flex-col transition-[transform,box-shadow] duration-200 border border-black/12">
                  <div class="flex gap-4 flex-wrap items-center min-h-[34px] mb-[36px] sm:gap-3">
                    {c.flags.map((f) => (
                      <img src={f.src} width={f.width} height={f.height} alt="" class="w-10 h-auto" loading="lazy" decoding="async" />
                    ))}
                  </div>
                  <div class="flex flex-col h-full justify-end">
                    <div class="text-[length:var(--fs-body)] font-semibold mb-2 leading-[length:var(--lh-body)] text-[var(--color-dark)]">
                      {c.name}
                    </div>
                    <p class="text-[length:var(--fs-body-sm)] text-[var(--color-gray-500)] leading-[length:var(--lh-body-sm)] font-normal m-0">
                      {c.desc}
                    </p>
