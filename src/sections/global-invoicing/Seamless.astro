                </div>
                <div class="bg-generic-00 rounded-[8px] shadow-sm border border-black/5 min-h-15 flex items-center justify-center p-3">
                  <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8d792b62ee0e705e570a67_integration-logo-7.png" alt="Logo 6" class="max-h-8 w-auto object-contain" />
                </div>
                <div class="bg-generic-00 rounded-[8px] shadow-sm border border-black/5 min-h-15 flex items-center justify-center p-3">
