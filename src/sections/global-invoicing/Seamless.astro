<style is:global>
  @keyframes ssrFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .integrations-text-panel::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -64px;
    height: 96px;
    pointer-events: none;
    z-index: 10;
    background: linear-gradient(
      to bottom,
      rgba(253, 253, 251, 0) 0%,
      rgba(253, 253, 251, 0.6) 50%,
      var(--palette-ledger-50) 100%
    );
    backdrop-filter: blur(24px) saturate(120%);
    -webkit-backdrop-filter: blur(24px) saturate(120%);
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 50%,
      black 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 50%,
      black 100%
    );
  }

  /* Mobile tab bar — same sliding-pill pattern as
     india-homepage/MakingAiWork.astro's .ih-maiw-tablist. */
  .gi-mtab-tab {
    transition: color 0.2s ease;
  }

  .gi-mtab-tab[aria-selected="true"] {
    color: var(--color-nova-blue);
  }

  .gi-mtab-thumb {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 0;
    width: 0;
    border-radius: 8px;
    background-color: var(--color-generic-00);
    box-shadow:
      0 1px 2px 0 rgba(16, 24, 40, 0.04),
      0 1px 2px 0 rgba(16, 24, 40, 0.04);
    opacity: 0;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }

  .gi-mtab-tablist.is-ready .gi-mtab-thumb {
    opacity: 1;
  }

  /* No JS, no thumb — so the current pill paints its own background instead. */
  .gi-mtab-tablist:not(.is-ready) .gi-mtab-tab[aria-selected="true"] {
    background-color: var(--color-generic-00);
    box-shadow:
      0 1px 2px 0 rgba(16, 24, 40, 0.04),
      0 1px 2px 0 rgba(16, 24, 40, 0.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .gi-mtab-thumb {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script is:inline>
  // Desktop (lg+): vertical accordion list driving the shared visual pane.
  (function () {
    const root = document.querySelector("[data-ssr-root]");
    if (!root) return;
    const items = root.querySelectorAll("[data-ssr]");
    const graphics = document.querySelectorAll("[data-ssr-graphic]");
    items.forEach((item) => {
      // The header is the first child of the item (the div containing the label and chevron)
      const header = item.firstElementChild;
      header?.addEventListener("click", () => {
        const key = item.getAttribute("data-ssr");
        if (item.classList.contains("active")) return;
        items.forEach((i) => i.classList.remove("active"));
        graphics.forEach((g) => g.classList.remove("active"));
        item.classList.add("active");
        document
          .querySelector(`[data-ssr-graphic="${key}"]`)
          ?.classList.add("active");
      });
    });
  })();

  // Mobile (<lg): sliding-pill tab bar, same mechanics as
  // india-homepage/MakingAiWork.astro's tablist — thumb follows the active
  // tab's measured position, panels toggle via inline `display`, roving
  // tabindex + arrow/Home/End keys, remeasure on resize and webfont load.
  (function () {
    const tablist = document.querySelector(".gi-mtab-tablist");
    if (!tablist) return;

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const tabs = Array.prototype.slice.call(tablist.querySelectorAll("[data-gi-mtab]"));
    const thumb = tablist.querySelector(".gi-mtab-thumb");
    const panels = tabs.map((tab) =>
      document.getElementById(`gi-mtab-panel-${tab.getAttribute("data-gi-mtab")}`)
    );
    let activeTab = 0;

    function moveThumb(i, instant) {
      if (!thumb) return;
      // Initial placement and remeasures (font load, resize) jump with no
      // transition — animating `width` isn't GPU-composited, and doing it
      // during page load is exactly the kind of main-thread work Lighthouse's
      // "avoid non-composited animations" audit flags. Only a real tab click
      // (selectTab, below) should slide.
      if (instant) thumb.style.transition = "none";
      thumb.style.width = tabs[i].offsetWidth + "px";
      thumb.style.transform = "translateX(" + tabs[i].offsetLeft + "px)";
      tablist.classList.add("is-ready");
      if (instant) {
        thumb.offsetWidth; // flush the instant position before restoring the transition
        thumb.style.transition = "";
      }
    }

    // Inline `display`, not a class swap — these panels get pasted into
    // Webflow's unlayered cascade, where a hiding class could race another
    // utility on source order. Inline always wins.
    function selectTab(i) {
      activeTab = i;
      tabs.forEach((tab, n) => {
        tab.setAttribute("aria-selected", n === i ? "true" : "false");
        tab.tabIndex = n === i ? 0 : -1;
        if (panels[n]) panels[n].style.display = n === i ? "block" : "none";
      });
      moveThumb(i);

      if (tablist.scrollWidth > tablist.clientWidth) {
        tablist.scrollTo({
          left: tabs[i].offsetLeft - (tablist.clientWidth - tabs[i].offsetWidth) / 2,
          behavior: reduceMotion ? "auto" : "smooth",
        });
      }
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => selectTab(i));
    });

    // Roving tabindex: role="tablist" promises arrow keys move between tabs
    // and Tab leaves the group entirely.
    tablist.addEventListener("keydown", (e) => {
      let next;
      if (e.key === "Home") next = 0;
      else if (e.key === "End") next = tabs.length - 1;
      else if (e.key === "ArrowRight") next = (activeTab + 1) % tabs.length;
      else if (e.key === "ArrowLeft") next = (activeTab - 1 + tabs.length) % tabs.length;
      else return;

      e.preventDefault();
      selectTab(next);
      tabs[next].focus();
    });

    moveThumb(0, true);
    // The bar can lay out before its webfont arrives, which changes every
    // tab's width — remeasure rather than leave the thumb on stale geometry.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => moveThumb(activeTab, true));
    }
    window.addEventListener("resize", () => moveThumb(activeTab, true));
  })();
</script>
