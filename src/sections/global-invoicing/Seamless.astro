            <h2
              class="text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] mb-0 mt-0 font-medium text-neutral-500 transition-[color,font-size,line-height] duration-300 group-[.active]:text-vault-navy group-[.active]:text-[length:var(--fs-h5)] group-[.active]:font-medium group-[.active]:leading-[length:var(--lh-h5)]"
