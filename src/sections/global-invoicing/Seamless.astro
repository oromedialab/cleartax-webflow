<style is:global>
  @keyframes ssrFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ssr-support-dots {
    background-image: radial-gradient(
      var(--palette-lime-500) 1.1px,
      transparent 1.1px
    );
    background-size: 13px 13px;
    opacity: 0.5;
  }

  /* The support diagram's cards/circle sit at fixed % positions inside a
     canvas that scales with the column width (aspect-[858/382], anywhere
     from ~604px to its 858px design width on lg+ screens). Sizing this text
     in cqw instead of px keeps it proportional to the canvas at every width
     it can actually render at — fixed px sizes here used to overflow their
     boxes and bleed into neighbouring cards once the canvas dropped below
     ~850px. clamp() keeps a legibility floor in case the canvas ever gets
     narrower than this page's lg column does today. */
  .ssr-support-canvas {
    container-type: inline-size;
  }

  .ssr-support-card-title {
    font-size: clamp(9px, 1.4cqw, 12px);
    line-height: clamp(12px, 1.87cqw, 16px);
  }

  .ssr-support-card-desc {
    font-size: clamp(8px, 1.17cqw, 10px);
    line-height: clamp(11px, 1.63cqw, 14px);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .ssr-support-center-heading {
    font-size: clamp(19px, 3.15cqw, 27px);
    line-height: clamp(25px, 4.2cqw, 36px);
  }

  .integrations-text-panel::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -64px;
    height: 96px;
    pointer-events: none;
    z-index: 10;
    background: linear-gradient(
      to bottom,
      rgba(253, 253, 251, 0) 0%,
      rgba(253, 253, 251, 0.6) 50%,
      var(--palette-ledger-50) 100%
    );
    backdrop-filter: blur(24px) saturate(120%);
    -webkit-backdrop-filter: blur(24px) saturate(120%);
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 50%,
      black 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 50%,
      black 100%
    );
  }

  /* Mobile vertical accordion (<lg) */
  .macc-item {
    border-left: 3px solid transparent;
    transition:
      border-color 0.28s ease,
      background-color 0.2s ease;
  }

  .macc-item.active {
    border-left-color: var(--color-nova-blue, #5446ff);
  }

  .macc-chevron {
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.2s ease;
  }

  .macc-item.active .macc-chevron {
    transform: rotate(180deg);
    color: var(--color-vault-navy, #0b0e1e);
  }

  .macc-item.active .macc-title {
    color: var(--color-vault-navy, #0b0e1e);
  }

  .macc-wrapper {
    display: none;
  }

  .macc-item.active .macc-wrapper {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .macc-wrapper,
    .macc-chevron,
    .macc-item {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script is:inline>
  // Desktop (lg+): vertical accordion list driving the shared visual pane.
  (function () {
    const root = document.querySelector("[data-ssr-root]");
    if (!root) return;
    const items = root.querySelectorAll("[data-ssr]");
    const graphics = document.querySelectorAll("[data-ssr-graphic]");
    items.forEach((item) => {
      // The header is the first child of the item (the div containing the label and chevron)
      const header = item.firstElementChild;
      header?.addEventListener("click", () => {
        const key = item.getAttribute("data-ssr");
        if (item.classList.contains("active")) return;
        items.forEach((i) => i.classList.remove("active"));
        graphics.forEach((g) => g.classList.remove("active"));
        item.classList.add("active");
        document
          .querySelector(`[data-ssr-graphic="${key}"]`)
          ?.classList.add("active");
      });
    });
  })();

  // Mobile (<lg): vertical accordion list with smooth slide and display: none when closed.
  (function () {
    const root = document.querySelector("[data-macc-root]");
    if (!root) return;

    const items = root.querySelectorAll("[data-macc]");

    function closeItem(item) {
      if (!item.classList.contains("active")) return;
      item.classList.remove("active");
      const trigger = item.querySelector(".macc-trigger");
      trigger?.setAttribute("aria-expanded", "false");

      const wrapper = item.querySelector(".macc-wrapper");
      if (!wrapper) return;

      if (wrapper._anim) cancelAnimationFrame(wrapper._anim);

      wrapper.style.display = "block";
      wrapper.style.overflow = "hidden";
      wrapper.style.height = wrapper.scrollHeight + "px";
      wrapper.style.opacity = "1";
      wrapper.style.transition =
        "height 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease";

      wrapper.offsetHeight; // Force reflow

      wrapper._anim = requestAnimationFrame(() => {
        wrapper.style.height = "0px";
        wrapper.style.opacity = "0";
      });

      const onEnd = (e) => {
        if (e.target !== wrapper || e.propertyName !== "height") return;
        wrapper.removeEventListener("transitionend", onEnd);
        if (!item.classList.contains("active")) {
          wrapper.style.display = "none";
          wrapper.style.height = "";
          wrapper.style.overflow = "";
          wrapper.style.opacity = "";
          wrapper.style.transition = "";
        }
      };
      wrapper.addEventListener("transitionend", onEnd);
    }

    function openItem(item) {
      item.classList.add("active");
      const trigger = item.querySelector(".macc-trigger");
      trigger?.setAttribute("aria-expanded", "true");

      const wrapper = item.querySelector(".macc-wrapper");
      if (!wrapper) return;

      if (wrapper._anim) cancelAnimationFrame(wrapper._anim);

      wrapper.style.display = "block";
      wrapper.style.overflow = "hidden";
      wrapper.style.height = "0px";
      wrapper.style.opacity = "0";
      wrapper.style.transition =
        "height 0.32s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.28s ease";

      const fullHeight = wrapper.scrollHeight;

      wrapper._anim = requestAnimationFrame(() => {
        wrapper.style.height = fullHeight + "px";
        wrapper.style.opacity = "1";
      });

      const onEnd = (e) => {
        if (e.target !== wrapper || e.propertyName !== "height") return;
        wrapper.removeEventListener("transitionend", onEnd);
        if (item.classList.contains("active")) {
          wrapper.style.height = "";
          wrapper.style.overflow = "";
          wrapper.style.opacity = "";
          wrapper.style.transition = "";
        }
      };
      wrapper.addEventListener("transitionend", onEnd);
    }

    items.forEach((item) => {
      const trigger = item.querySelector(".macc-trigger");

      trigger?.addEventListener("click", () => {
        const isCurrentlyActive = item.classList.contains("active");

        items.forEach((other) => {
          if (other !== item && other.classList.contains("active")) {
            closeItem(other);
          }
        });

        if (isCurrentlyActive) {
          closeItem(item);
        } else {
          openItem(item);
        }
      });
    });
  })();
</script>
