                </div>
                <div class="bg-generic-00 rounded-[8px] shadow-sm border border-black/5 min-h-15 flex items-center justify-center p-3">
                  <img src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a8d791276f0e1022c853905_integration-logo-4.png" alt="Logo 3" class="max-h-8 w-auto object-contain" loading="lazy" decoding="async" />
                </div>
              </div>
              <div class="grid grid-cols-4 gap-3 sm:gap-4">
