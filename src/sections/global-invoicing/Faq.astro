---
/**
 * FAQ — Figma "Frequently Asked Questions": media panel left, copy and
 * accordions right. Native <details>, so it works with no JS in a Webflow Embed.
 */
interface Props {
  heading?: string;
  body?: string;
  image?: string;
  imageAlt?: string;
  faqs?: { q: string; a: string }[];
}

const {
  heading = 'Frequently Asked Questions',
  body = 'Everything you need to know about global e-invoicing mandates, compliance, and the ClearTax platform.',
  image = '',
  imageAlt = '',
  faqs = [
    { q: 'What is global e-invoicing and how does it work?', a: 'Governments require invoices to be reported or cleared in a prescribed format. Cleartax converts, validates and files them per jurisdiction.' },
    { q: 'Why do multinational businesses need a global e-invoicing solution?', a: 'Each market has its own schema and timeline. One platform avoids running a separate build per country.' },
    { q: 'What is a global e-invoicing network, and how does businesses connect to it?', a: 'Networks such as Peppol route documents between trading parties. You connect once through Cleartax.' },
    { q: 'What is the Peppol e-invoicing network and which countries use it?', a: 'A standardised exchange network used across Europe and adopted well beyond it.' },
    { q: 'What are the biggest challenges businesses face with global e-invoicing regulations?', a: 'Keeping pace with schema changes, validation before filing, and archiving to each market’s retention rules.' },
  ],
} = Astro.props;
---

<section class="gi-faq">
  <div class="container gi-faq-cols">
    <div class="gi-faq-media">
      {image && <img src={image} alt={imageAlt} loading="lazy" />}
    </div>

    <div>
      <h2 class="gi-h2">{heading}</h2>
      <p class="gi-section-body gi-faq-body">{body}</p>

      <div class="gi-accordion">
        {faqs.map((f) => (
          <details class="gi-accordion-item">
            <summary class="gi-accordion-q">
              <span>{f.q}</span>
              <span class="gi-accordion-mark" aria-hidden="true"></span>
            </summary>
            <p class="gi-accordion-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .gi-faq {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--spacing-xxx-lg);
  }

  .gi-faq-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-x-lg);
    align-items: start;
  }

  .gi-faq-media {
    aspect-ratio: 616 / 464;
    border-radius: 12px;
    background: var(--palette-success-100);
    overflow: hidden;
  }

  .gi-faq-media img { width: 100%; height: 100%; object-fit: cover; }

  .gi-faq-body { text-align: left; margin-bottom: var(--spacing-x-big); }

  .gi-accordion-item { border-top: 1px solid var(--color-border); }
  .gi-accordion-item:last-child { border-bottom: 1px solid var(--color-border); }

  .gi-accordion-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    min-height: 52px;
    cursor: pointer;
    list-style: none;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
  }

  .gi-accordion-q::-webkit-details-marker { display: none; }

  .gi-accordion-mark {
    flex: 0 0 9px;
    height: 9px;
    border-right: 1.5px solid var(--color-text-muted);
    border-bottom: 1.5px solid var(--color-text-muted);
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--transition-base);
  }

  .gi-accordion-item[open] .gi-accordion-mark { transform: translateY(2px) rotate(225deg); }

  .gi-accordion-a {
    padding-bottom: var(--spacing-md);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--color-text-muted);
  }

  @media (width < 1024px) {
    .gi-faq-cols { grid-template-columns: 1fr; }
  }
</style>
