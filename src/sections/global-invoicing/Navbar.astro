---
/**
 * Navbar for the Global Invoicing page — the paste unit.
 *
 * All markup, styling and behaviour live in `_shared/NavbarRb.astro`; this file
 * only supplies content. Props have to be applied here, inside a section file,
 * because the embed route renders sections with no props.
 *
 * Links, country list and logo are carried over verbatim from the v1 page
 * (`global-invoicing-delivery-v1/Navbar.astro`) so nothing regresses when the
 * rebrand ships.
 */
import NavbarRb from '../_shared/NavbarRb.astro';
import type { NavLink, CountryOption } from '../_shared/NavbarRb.astro';

const links: NavLink[] = [
  {
    label: 'Products',
    dropdown: [
      { label: 'AI Reconciliation', href: 'http://cleartax.com/global/recon-ai' },
      { label: 'Compliance', href: 'http://cleartax.com/global/compliance' },
      { label: 'Global E-Invoicing', href: 'https://www.cleartax.com/global/e-invoicing-solution' },
      { label: 'Integration', href: 'http://cleartax.com/global/erp-integration' },
      { label: 'Scale & Security', href: 'http://cleartax.com/global/scale-security' },
    ],
  },
  {
    label: 'Resources',
    dropdown: [
      { label: 'Blogs', href: 'https://www.cleartax.com/electronic-invoicing#country-select' },
      { label: 'Case Studies', href: 'https://www.cleartax.com/case-studies' },
      { label: 'Press Releases', href: 'https://www.cleartax.com/ae/press' },
    ],
  },
  { label: 'Contact Us', href: 'https://www.cleartax.com/contact-us' },
  { label: 'Partners', href: 'https://www.cleartax.com/global/partner-program' },
];

const countries: CountryOption[] = [
  { name: 'INDIA', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/649999dbc3faf054134a1e01_India_flag.png', href: 'https://www.clear.in/' },
  { name: 'MALAYSIA', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/649a7b4653733f5dbda826ea_malaysia%20v1.png', href: 'https://www.cleartax.com/my/en' },
  { name: 'USA', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/64999a14db4af851a9f7ce5b_usa%20flag.png', href: 'https://www.clear.tech/' },
  { name: 'POLAND', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/64999b053b3f5248132a620d_poland%20flag.png', href: 'https://www.cleartax.com/pl/en', lang: 'English | Polish' },
  { name: 'SAUDI ARABIA', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/63e28756aeabe12df79ff5d5_Rectangle%202515530.svg', href: 'https://www.cleartax.com/sa', lang: 'English | العربية' },
  { name: 'OMAN', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/63e29d499e782b5935404547_Group%201000003291.svg', href: 'https://www.cleartax.com/om' },
  { name: 'FRANCE', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/64999768870655432964457d_france_flag.png', href: 'https://www.cleartax.com/fr/en', lang: 'English | French' },
  { name: 'BAHRAIN', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/63e29d6c2e1ddc75a632d00f_Group%201000003292.svg', href: 'https://www.cleartax.com/bh' },
  { name: 'SPAIN', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/64999a546cfce1e0515f0f60_spain%20flag.png', href: 'https://www.cleartax.com/es/en' },
  { name: 'UAE', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/63e29d24f310792735ab4bba_Mask%20group%20(3).svg', href: 'https://www.cleartax.com/ae' },
  { name: 'SINGAPORE', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/66716d4c6753fb52078bec02_singapore%20flag%203.png', href: 'https://www.cleartax.com/sg/e-invoicing-software' },
  { name: 'GERMANY', flag: 'https://assets.clear.in/cleartax/images/1771829770_flagforflaggermanysvgrepocom1.svg', href: 'https://www.cleartax.com/de/en' },
  { name: 'BELGIUM', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/67e3e6ae1e19488131f26dfd_belgium_flag.png', href: 'https://www.cleartax.com/be/en' },
  { name: 'JORDAN', flag: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a28fbf31fa87b7ea058b504_jordan-flag-icon%201.png', href: 'https://www.cleartax.com/jo/e-invoicing-software' },
  { name: 'PHILIPPINES', flag: 'https://cdn.prod.website-files.com/6141e3720a248d2024615d96/6a2935c197e9e718191d8d34_Flag_of_the_Philippines.svg', href: 'https://www.cleartax.com/ph' },
];
---

<NavbarRb
  links={links}
  countries={countries}
  logoSrc="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
  logoAlt="cleartax"
  ctaLabel="Request a demo"
  ctaHref="#gi-signup"
  idPrefix="gi-nav"
/>
