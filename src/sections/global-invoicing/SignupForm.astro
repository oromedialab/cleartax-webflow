---
/**
 * Signup — Figma "Ready to become Without Limits?".
 * Heading with a Lime-marked phrase, then a bordered card: three value points
 * on the left, lead form on the right.
 *
 * NOTE: this section carries the page's SECOND Lime mark. The brand allows one
 * per screen, so the hero's mark and this one are mutually exclusive — keep
 * whichever Cleartax signs off and drop the other. Tracked in
 * docs/brand/open-questions.md.
 *
 * Endpoint + reCAPTCHA key still to be confirmed by Cleartax.
 */
interface Props {
  headingLead?: string;
  headingHighlight?: string;
  body?: string;
  points?: { title: string; body: string }[];
  formTitle?: string;
  formBody?: string;
  consent?: string;
  submitLabel?: string;
  sheetName?: string;
  originCountry?: string;
  thankYouUrl?: string;
}

const {
  headingLead = 'Ready to become',
  headingHighlight = 'Without Limits?',
  body = 'Join 5,000+ global enterprises that trust ClearTax for uninterrupted, multi-jurisdiction e-invoicing compliance.',
  points = [
    { title: 'Enterprise Onboarding', body: 'Dedicated implementation support to help your teams go live faster.' },
    { title: 'Security-Led Setup', body: 'Built around zero-trust access, encryption, and role-based controls.' },
    { title: 'Global Integration', body: 'Custom-fit to your ERP, subsidiaries, and compliance workflows.' },
  ],
  formTitle = 'Sign Up',
  formBody = 'Insert an engaging description text for the form',
  consent = 'I agree to ClearTax’s Privacy Policy and Terms of Service. I consent to receiving communications about ClearTax products and e-invoicing updates.',
  submitLabel = 'Get in touch',
  sheetName = 'globalInvoicingRAD',
  originCountry = 'Global',
  thankYouUrl = 'https://www.cleartax.com/thank-you',
} = Astro.props;
---

<section class="gi-signup" id="gi-signup">
  <div class="container">
    <div class="gi-section-head">
      <h2 class="gi-h2">{headingLead} <span class="gi-mark">{headingHighlight}</span></h2>
      <p class="gi-section-body">{body}</p>
    </div>

    <div class="gi-signup-card">
      <ul class="gi-signup-points">
        {points.map((p) => (
          <li class="gi-signup-point">
            <span class="gi-signup-icon" aria-hidden="true"></span>
            <div>
              <p class="gi-signup-point-title">{p.title}</p>
              <p class="gi-signup-point-body">{p.body}</p>
            </div>
          </li>
        ))}
      </ul>

      <form
        class="gi-form"
        data-sheet-name={sheetName}
        data-origin-country={originCountry}
        data-thank-you={thankYouUrl}
      >
        <p class="gi-form-title">{formTitle}</p>
        <p class="gi-form-body">{formBody}</p>

        <div class="gi-form-grid">
          <label class="gi-field">
            <span class="gi-field-label">Name</span>
            <input class="gi-input" name="name" type="text" placeholder="John Jacob" autocomplete="name" required />
          </label>
          <label class="gi-field">
            <span class="gi-field-label">Phone Number</span>
            <input class="gi-input" name="phone" type="tel" placeholder="(000) 000-0000" autocomplete="tel" />
          </label>
          <label class="gi-field">
            <span class="gi-field-label">Email</span>
            <input class="gi-input" name="email" type="email" placeholder="youremail@mail.com" autocomplete="email" required />
          </label>
          <label class="gi-field">
            <span class="gi-field-label">Company name*</span>
            <input class="gi-input" name="company" type="text" placeholder="Cleartax" autocomplete="organization" required />
          </label>
        </div>

        <div class="gi-form-foot">
          <label class="gi-consent">
            <input type="checkbox" name="consent" required />
            <span>{consent}</span>
          </label>
          <button class="gi-btn" type="submit">{submitLabel}</button>
        </div>
      </form>
    </div>
  </div>
</section>

<style is:global>
  .gi-signup {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--spacing-xxx-lg);
  }

  .gi-signup-card {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: var(--spacing-lg);
    margin-top: var(--spacing-lg);
    padding: var(--spacing-xxx-big);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--palette-generic-00);
    align-items: start;
  }

  .gi-signup-points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-x-big);
  }

  .gi-signup-point { display: flex; gap: var(--spacing-sm); }

  .gi-signup-icon {
    flex: 0 0 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--palette-nova-50);
  }

  .gi-signup-point-title {
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .gi-signup-point-body {
    margin-top: var(--spacing-xx-sm);
    font-size: var(--fs-label-sm);
    line-height: var(--lh-label-sm);
    color: var(--color-text-muted);
  }

  .gi-form-title {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .gi-form-body {
    margin-top: var(--spacing-xx-sm);
    font-size: var(--fs-label-sm);
    line-height: var(--lh-label-sm);
    color: var(--color-text-muted);
  }

  .gi-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  .gi-field-label {
    display: block;
    margin-bottom: var(--spacing-xx-sm);
    font-size: var(--fs-label-sm);
    line-height: var(--lh-label-sm);
    color: var(--color-text-muted);
  }

  .gi-input {
    width: 100%;
    min-height: 40px;
    padding-inline: var(--spacing-sm);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: var(--color-text);
  }

  .gi-input::placeholder { color: var(--palette-ledger-400); }
  .gi-input:focus-visible { border-color: var(--color-nova-blue); }

  .gi-form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  .gi-consent {
    display: flex;
    gap: var(--spacing-x-sm);
    max-width: 60ch;
    font-size: var(--fs-label-xs);
    line-height: var(--lh-label-xs);
    color: var(--color-text-muted);
  }

  .gi-consent input { margin-top: 2px; accent-color: var(--color-nova-blue); }

  @media (width < 1024px) {
    .gi-signup-card { grid-template-columns: 1fr; }
    .gi-form-grid { grid-template-columns: 1fr; }
  }
</style>
