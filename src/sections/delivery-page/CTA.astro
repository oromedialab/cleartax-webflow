---
import Dotgrid from '../_shared/Dotgrid.astro';

interface Props {
    baseColor?: string;
}

const {
    baseColor = "#C8F006",
} = Astro.props;
---
<section class="relative py-24 md:py-32 bg-generic-00 overflow-hidden w-full flex items-center justify-center min-h-[400px]" id="footprint">
    <!-- Interactive Dot Grid Background -->
    <Dotgrid
        containerId="footprint"
        baseColor={baseColor}
        lineWidth={2}
        gap={24}
        maxLength={6}
        lengthRadius={260}
        tilt={1}
        cursorRadius={320}
        pull={14}
        fadeRadius={40}
    />

    <!-- Center White Radial Gradient Wash -->
    <div
        class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_20%_100%_at_50%_20%,_#FFFFFF_0%,_rgba(255,255,255,0.9)_30%,_transparent_60%)] pointer-events-none"
    >
    </div>

    <div class="relative z-10 lg:container mx-auto px-4 md:px-6 flex flex-col items-center text-center">
        <h2 class="text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium text-text-default max-w-[800px] m-0 mb-4 md:mb-6">
            <span class="bg-flux-lime px-2 py-0.5 rounded-lg inline-block">One dashboard.</span> 
            Every mandate. See it mapped to your footprint.
        </h2>
        
        <a
            href="javascript:void(0)" onclick="document.getElementById('contactForm')?.scrollIntoView({behavior:'smooth'})"
            class="inline-flex items-center justify-center px-8 py-3.5 font-body rounded-lg font-medium text-white text-[length:var(--fs-body)] leading-[length:var(--lh-body)] cursor-pointer bg-nova-blue border border-nova-blue hover:bg-generic-00 hover:text-nova-blue transition-all duration-150 ease-in-out"
            style="outline: none;"
        >
            Book a Demo
        </a>
    </div>
</section>


