---
/**
 * The dot field is the one from `sections/blog-listing/Newsletter.astro`, in the
 * hero's own lime. The long explanation of the geometry lives in that file; the
 * short version is that the field is a plain grid of dots until a pointer
 * enters, and each dot then draws out into a stroke aimed at the cursor, longest
 * right beside it and back to a dot by `lengthRadius`.
 *
 * These are rendered onto the section as `data-*` and read back by the script.
 * The old grid declared its numbers twice — as props here and again as a literal
 * `config` in the script — so editing a prop changed nothing. One source now.
 *
 * The props that drove the old spring physics (`speedTrigger`, `shockRadius`,
 * `maxSpeed`, `resistance`, `returnDuration`, `proximity`, `activeColor`) are
 * gone with it. No page passed any of them.
 */
import Dotgrid from '../_shared/Dotgrid.astro';

interface Props {
  lineWidth?: number;
  gap?: number;
  maxLength?: number;
  lengthRadius?: number;
  tilt?: number;
  baseColor?: string;
  cursorRadius?: number;
  pull?: number;
  fadeRadius?: number;
  titlePrefix?: string;
  titleHighlight?: string;
  titleSuffix?: string;
  description?: string;
}

const {
  /* lineWidth is the old dotSize: the width of a stroke, and so the diameter of
     the dot that stroke becomes at rest. 2 + 24 holds the hero's 26px pitch,
     with a finer dot than the 4px it used to draw. */
  lineWidth = 3,
  gap = 24,
  /* Longest a stroke gets, in px. Must stay under the 26px pitch or the field
     starts knitting into a mesh — the guarantee is spelt out in
     Newsletter.astro. */
  maxLength = 6,
  lengthRadius = 260,
  /* Leave at 1. A partial turn cannot be continuous, and strokes flip as the
     cursor crosses them — see the note in Newsletter.astro. */
  tilt = 1,
  baseColor = "#C8F006",
  cursorRadius = 320,
  pull = 14,
  fadeRadius = 40,
  titlePrefix = "The mandate",
  titleHighlight = "changes by country.",
  titleSuffix = "The delivery burden doesn't.",
  description = "Global e-invoicing succeeds on three things most vendors skip: understanding how mandates diverge, surviving what actually breaks multi-country delivery, and owning it after go-live — everywhere, not just market one.",
} = Astro.props;
---

<section
    class="de-hero-section relative min-h-[700px] bg-[linear-gradient(180deg,_#FFF_0%,_rgba(242,_241,_240,_0.25)_30.04%,_rgba(242,_241,_240,_0.25)_87.79%,_#FFF_100%)] overflow-hidden flex flex-col pt-28 pb-12 md:pt-30 md:pb-16 lg:pt-35 lg:pb-25"
    id="hero"
>
    <!-- Interactive Dot Grid Background -->
    <Dotgrid 
        containerId="hero" 
        lineWidth={lineWidth} 
        gap={gap} 
        maxLength={maxLength} 
        lengthRadius={lengthRadius} 
        tilt={tilt} 
        baseColor={baseColor} 
        cursorRadius={cursorRadius} 
        pull={pull} 
        fadeRadius={fadeRadius} 
    />
    
    <!-- Radial Gradient Mask to hide dots in the center (behind text) -->
    <div 
        class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_rgba(255,255,255,1)_30%,_rgba(255,255,255,0.7)_40%,_rgba(255,255,255,0)_65%)] pointer-events-none"
    >
    </div>

    <div
        class="absolute inset-0 z-0 bg-gradient-to-b from-white/85 via-white/50 to-transparent hidden max-[630px]:block pointer-events-none"
    >
    </div>

    <!-- Bottom fade to blend dots into the background seamlessly -->
    <div
        class="absolute bottom-0 inset-x-0 h-48 bg-gradient-to-t from-white via-white/50 to-transparent pointer-events-none z-0"
    >
    </div>

    <div class="relative z-10 mx-auto lg:container w-full h-full flex flex-col px-4 lg:px-8 pointer-events-auto">
        <div class="flex justify-center w-full h-full flex-1">
            <!-- Hero Content -->
            <div class="hero-content flex flex-col items-center mx-auto text-center w-full h-full">
                <!-- Spacer to perfectly center the text block against the mt-auto grid -->
                <div class="mb-auto"></div>

                <!-- Headline -->
                <h2
                    class="text-[length:var(--fs-h1)] lg:text-[length:var(--fs-display-sm)] xl:text-[length:var(--fs-display-xl)] leading-[length:var(--lh-h1)] lg:leading-[length:var(--lh-display-sm)] xl:leading-[length:var(--lh-display-xl)] max-w-310 text-generic-100 font-semibold font-heading mb-4 m-0 text-center"
                >
                    {titlePrefix} {titleHighlight && <span class="text-generic-100 bg-flux-lime px-1 rounded-lg">{titleHighlight}</span>} {titleSuffix}
                </h2>

                <!-- Description -->
                <p
                    class="text-[length:var(--fs-body)] leading-[length:var(--lh-body)] sm:text-[length:var(--fs-body-lg)] sm:leading-[length:var(--lh-body-lg)] max-w-235 text-neutral-500 font-medium font-body mb-7 text-center"
                >
                {description}
                </p>

                <!-- Call to Action buttons -->
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a
                        href="javascript:void(0)" onclick="document.getElementById('contactForm').scrollIntoView({behavior:'smooth'})"
                        class="inline-flex items-center justify-center gap-2 px-5 py-3.5 font-body rounded-lg font-medium text-white text-[length:var(--fs-body)] leading-[length:var(--lh-body)] cursor-pointer bg-nova-blue border border-nova-blue hover:bg-generic-00 hover:text-nova-blue transition-all duration-150 ease-in-out"
                        style="outline: none;"
                    >
                        Book a Demo
                        <svg width="14" height="9" viewBox="0 0 14 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M9.00628 0.256282C9.34799 -0.0854272 9.90201 -0.0854272 10.2437 0.256282L13.7437 3.75628C14.0854 4.09799 14.0854 4.65201 13.7437 4.99372L10.2437 8.49372C9.90201 8.83543 9.34799 8.83543 9.00628 8.49372C8.66457 8.15201 8.66457 7.59799 9.00628 7.25628L11.0126 5.25H0.875001C0.391751 5.25 -2.11235e-08 4.85825 0 4.375C2.11235e-08 3.89175 0.391751 3.5 0.875001 3.5H11.0126L9.00628 1.49372C8.66457 1.15201 8.66457 0.59799 9.00628 0.256282Z" fill="currentColor"/>
                        </svg>
                      </a>

                </div>

                <!-- Feature Grid Cards -->
                <div class="grid grid-cols-2 md:grid-cols-4 place-items-center gap-6 md:gap-12 w-full max-w-156 mx-auto z-10 relative mt-12 md:mt-16">
                    <div class="w-[100px] h-[100px] md:w-[120px] md:h-[120px] bg-visual-placeholder rounded-2xl"></div>
                    <div class="w-[100px] h-[100px] md:w-[120px] md:h-[120px] bg-visual-placeholder rounded-2xl"></div>
                    <div class="w-[100px] h-[100px] md:w-[120px] md:h-[120px] bg-visual-placeholder rounded-2xl"></div>
                    <div class="w-[100px] h-[100px] md:w-[120px] md:h-[120px] bg-visual-placeholder rounded-2xl"></div>
                </div>

            </div>
        </div>
    </div>
</section>

<script is:inline>
  // Smooth scroll logic
  window.scrollToContactForm = (e) => {
    e.preventDefault();
    const contactForm = document.getElementById('contact-form');
    if (contactForm) {
      contactForm.scrollIntoView({ behavior: 'smooth' });
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }
  };


</script>