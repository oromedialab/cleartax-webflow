---
---

<section class="py-16 md:py-20 bg-generic-00">
    <div class="lg:container mx-auto w-full px-4 md:px-6 lg:px-8">
        <!-- Heading -->
        <h2 class="text-center font-medium font-heading text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] text-text-default m-0 mb-8 md:mb-12">
            <span class="text-generic-100 bg-flux-lime px-1 rounded-lg">One</span> platform. Every market.
        </h2>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] gap-y-10 md:gap-y-0 items-center mx-auto mb-12">
            <div class="flex flex-col items-center justify-center px-4 text-center">
                <h3 class="text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] font-heading text-text-default mb-1 md:mb-2 font-medium">50+</h3>
               <p class="text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] font-body font-normal text-neutral-500">countries</p>
            </div>

            <!-- Divider -->
            <div class="hidden md:block w-px h-16 bg-gray-200"></div>

            <div class="flex flex-col items-center justify-center px-4 text-center">
                <h3 class="text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] font-heading text-text-default mb-1 md:mb-2 font-medium">5000+</h3>
                <p class="text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] font-body font-normal text-neutral-500">enterprises</p>
            </div>

            <!-- Divider -->
            <div class="hidden md:block w-px h-16 bg-gray-200"></div>

            <div class="flex flex-col items-center justify-center px-4 text-center">
                <h3 class="text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] font-heading text-text-default mb-1 md:mb-2 font-medium">1B+</h3>
                <p class="text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] font-body font-normal text-neutral-500">e-Invoices generated annually</p>
            </div>

            <!-- Divider -->
            <div class="hidden md:block w-px h-16 bg-gray-200"></div>

            <div class="flex flex-col items-center justify-center px-4 text-center">
                <h3 class="text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] font-heading text-text-default mb-1 md:mb-2 font-medium">$500B+</h3>
                <p class="text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)] font-body font-normal text-neutral-500">worth invoices processed</p>
            </div>
        </div>

        <!-- Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mx-auto mb-12">
            <!-- Card 1 -->
            <div class="border-2 border-neutral-300 rounded-xl p-6 md:p-8 flex flex-col bg-generic-00">
                <div class="w-12 h-12 rounded mb-6 bg-visual-placeholder"></div>
                <h3 class="text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] font-heading text-text-default mb-4 font-medium">One login</h3>
                <p class="font-body font-normal text-neutral-500/80 leading-relaxed text-sm md:text-base">
                    Every mandate you're on the hook for, on a single dashboard.
                </p>
            </div>

            <!-- Card 2 -->
            <div class="border-2 border-neutral-300 rounded-xl p-6 md:p-8 flex flex-col bg-generic-00">
                <div class="w-12 h-12 rounded mb-6 bg-visual-placeholder"></div>
                <h3 class="text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] font-heading text-text-default mb-4 font-medium">Local team, every market</h3>
                <p class="font-body font-normal text-neutral-500/80 leading-relaxed text-sm md:text-base">
                    A local contact in every market, one global owner for the program.
                </p>
            </div>

            <!-- Card 3 -->
            <div class="border-2 border-neutral-300 rounded-xl p-6 md:p-8 flex flex-col bg-generic-00">
                <div class="w-12 h-12 rounded mb-6 bg-visual-placeholder"></div>
                <h3 class="text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] font-heading text-text-default mb-4 font-medium">Automatic, everywhere</h3>
                <p class="font-body font-normal text-neutral-500/80 leading-relaxed text-sm md:text-base">
                    Nothing waits on your team when any mandate's requirement changes.
                </p>
            </div>
        </div>

        <!-- CTA Button -->
        <div class="flex justify-center mt-8 md:mt-12">
            <a href="#" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 text-generic-00 font-medium rounded-lg text-base font-body" style="background-color: var(--palette-primary-600, #5642FA);">
                See it mapped to your footprint
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3.33334 8H12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M8 3.33333L12.6667 7.99999L8 12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>
    </div>
</section>
