<section class="py-16 md:py-20 bg-generic-00">
    <div class="lg:container mx-auto w-full px-4 md:px-6 lg:px-8">
        <div class="text-center w-full mx-auto mb-12">
            <h2 class="font-heading font-medium text-[length:var(--fs-h2)] md:text-[length:var(--fs-display-sm)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-display-sm)] max-w-250 mx-auto mb-6">Same invoice. Different rulebook, every market.</h2>
            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] max-w-197 mx-auto">One invoice leaves your ERP. What it has to become — and how it has to travel — changes the moment it crosses a border.</p>
        </div>

        <!--
          Two-layer structure:
          - OUTER (.invoice-stack-sticky): position: sticky, native browser positioning.
            Never gets a JS transform, so measuring its position is always safe/stable.
          - INNER (.invoice-stack-card): the visible card. Only this gets scaled by JS.
        -->
        <div id="invoice-stack-container" class="mx-auto w-full flex flex-col gap-[30vh] md:gap-[50vh]">
            <div class="invoice-stack-sticky sticky" style="top: calc(var(--navbar-height, 72px) + 32px + 0px); z-index: 0;">
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-[#CCCCCC] rounded-xl min-h-[372px] bg-generic-00 will-change-transform" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-generic-900">Schema & mandatory fields</h3>
                            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-generic-600 max-w-xl">The structure and the required data differ per country. A field that's optional in one market rejects the invoice in the next.</p>
                        </div>
                        <div class="mt-auto hidden md:block">
                            <svg width="240" height="40" viewBox="0 0 240 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[45%] lg:w-[45%] p-4 md:p-6 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-[280px] rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <div class="invoice-stack-sticky sticky" style="top: calc(var(--navbar-height, 72px) + 32px + 16px); z-index: 1;">
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-[#CCCCCC] rounded-xl min-h-[372px] bg-generic-00 will-change-transform" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-generic-900">Validating authority & clearance model</h3>
                            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-generic-600 max-w-xl">Who checks the invoice, and when. Real-time clearance before it's legally valid (Malaysia LHDN, Poland's KSeF), or post-audit reporting after the transaction closes — every market draws the line differently.</p>
                        </div>
                        <div class="mt-auto hidden md:block">
                            <svg width="240" height="40" viewBox="0 0 240 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[45%] lg:w-[45%] p-4 md:p-6 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-[280px] rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <div class="invoice-stack-sticky sticky" style="top: calc(var(--navbar-height, 72px) + 32px + 32px); z-index: 2;">
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-[#CCCCCC] rounded-xl min-h-[372px] bg-generic-00 will-change-transform" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-generic-900">Transmission path</h3>
                            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-generic-600 max-w-xl">An open network (Peppol), a central government platform, or a direct authority connection. The road changes depending upon the country.</p>
                        </div>
                        <div class="mt-auto hidden md:block">
                            <svg width="240" height="40" viewBox="0 0 240 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[45%] lg:w-[45%] p-4 md:p-6 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-[280px] rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <div class="invoice-stack-sticky sticky" style="top: calc(var(--navbar-height, 72px) + 32px + 48px); z-index: 3;">
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-[#CCCCCC] rounded-xl min-h-[372px] bg-generic-00 will-change-transform" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-generic-900">Fallback delivery</h3>
                            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-generic-600 max-w-xl">Not every customer can receive a structured e-invoice yet. Where they can't, it still has to land — by email, by PDF, in print — without breaking the compliant flow.</p>
                        </div>
                        <div class="mt-auto hidden md:block">
                            <svg width="240" height="40" viewBox="0 0 240 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[45%] lg:w-[45%] p-4 md:p-6 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-[280px] rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <!-- Gap after the stack finishes -->
            <div style="height: 80px;"></div>
        </div>

    </div>
</section>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    const outers = Array.from(document.querySelectorAll('.invoice-stack-sticky')); // never transformed — safe to measure
    const inners = Array.from(document.querySelectorAll('.invoice-stack-card'));    // gets scaled

    if (!outers.length || outers.length !== inners.length) return;

    // How much scroll distance the shrink takes, once the next card starts closing in.
    const revealDistance = 260;

    // Card 0 shrinks the most (0.88), each subsequent card a little less.
    const targetScaleFor = (i) => 0.88 + i * 0.04;

    let ticking = false;

    const update = () => {
        // Read every outer wrapper's CURRENT position first (outers are never
        // transformed, so getBoundingClientRect on them is always accurate —
        // no feedback loop, unlike measuring a transformed element).
        const tops = outers.map((el) => el.getBoundingClientRect().top);

        inners.forEach((inner, i) => {
            const isLast = i === inners.length - 1;
            if (isLast) {
                inner.style.transform = 'scale(1)';
                return;
            }

            // sticky clamps an element's rect.top at its own `top` value once stuck,
            // and keeps decreasing beforehand — so this distance naturally goes to 0
            // and stays there once card i+1 is fully stuck. No further calc needed.
            const nextStickyTopPx = outers[i + 1].style.top
                ? parseFloat(getComputedStyle(outers[i + 1]).top)
                : 0;
            const distanceToStick = tops[i + 1] - nextStickyTopPx;

            const progress = Math.min(1, Math.max(0, 1 - distanceToStick / revealDistance));
            const targetScale = targetScaleFor(i);
            const scale = 1 - progress * (1 - targetScale);

            inner.style.transform = `scale(${scale.toFixed(4)})`;
        });

        ticking = false;
    };

    const onScroll = () => {
        if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
        }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    window.addEventListener('load', update, { once: true }); // catch late font/image layout shifts
    update();
});
</script>