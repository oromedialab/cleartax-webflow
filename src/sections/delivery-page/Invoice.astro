<section class="py-12 md:py-16 bg-generic-00">
    <div class="lg:container mx-auto w-full px-4 md:px-6">
        <!--
          Two-layer structure:
          - OUTER (.invoice-stack-sticky): position: sticky, native browser positioning.
            Never gets a JS transform, so measuring its position is always safe/stable.
          - INNER (.invoice-stack-card): the visible card. Only this gets scaled by JS.
        -->
        <!-- Mobile Header (Scrolls away) -->
        <div class="md:hidden text-center w-full mx-auto mb-8 bg-generic-00">
            <h2 class="font-heading font-medium text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] text-text-default max-w-250 mx-auto m-0 mb-3">Same invoice. Different rulebook, every market.</h2>
            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-neutral-500 max-w-197 mx-auto">One invoice leaves your ERP. What it has to become — and how it has to travel — changes the moment it crosses a border.</p>
        </div>

        <div id="invoice-stack-container" class="invoice-stack mx-auto w-full flex flex-col gap-[30vh] md:gap-[50vh]">
            <div class="invoice-stack-sticky sticky" style="top: 100px; z-index: 0;">
                <!-- Desktop Header (Sticky) -->
                <div id="invoice-header-text" class="hidden md:block text-center w-full mx-auto mb-3 bg-generic-00">
                    <h2 class="font-heading font-medium text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] max-w-250 mx-auto mb-3">Same invoice. Different rulebook, every market.</h2>
                    <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-neutral-500 max-w-197 mx-auto">One invoice leaves your ERP. What it has to become — and how it has to travel — changes the moment it crosses a border.</p>
                </div>
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-neutral-300 rounded-xl min-h-[372px] md:min-h-0 md:h-[clamp(300px,calc(100vh-280px),480px)] bg-generic-00 will-change-transform mx-auto" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-text-default font-medium">Schema & mandatory fields</h3>
                            <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] max-w-xl">The structure and the required data differ per country. A field that's optional in one market rejects the invoice in the next.</p>
                        </div>
                        <div class="mt-auto hidden lg:block">
                            <svg width="240" height="60" viewBox="0 0 240 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="52" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[40%] lg:w-[45%] p-4 md:p-5 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-0 rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <div class="invoice-stack-sticky sticky" style="top: 116px; z-index: 1;">
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-neutral-300 rounded-xl min-h-[372px] md:min-h-0 md:h-[clamp(300px,calc(100vh-280px),480px)] bg-generic-00 will-change-transform mx-auto" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-text-default font-medium">Validating authority & clearance model</h3>
                            <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] max-w-xl">Who checks the invoice, and when. Real-time clearance before it's legally valid (Malaysia LHDN, Poland's KSeF), or post-audit reporting after the transaction closes — every market draws the line differently.</p>
                        </div>
                        <div class="mt-auto hidden lg:block">
                            <svg width="240" height="60" viewBox="0 0 240 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="52" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[40%] lg:w-[45%] p-4 md:p-5 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-0 rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <div class="invoice-stack-sticky sticky" style="top: 132px; z-index: 2;">
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-neutral-300 rounded-xl min-h-[372px] md:min-h-0 md:h-[clamp(300px,calc(100vh-280px),480px)] bg-generic-00 will-change-transform mx-auto" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-text-default font-medium">Transmission path</h3>
                            <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] max-w-xl">An open network (Peppol), a central government platform, or a direct authority connection. The road changes depending upon the country.</p>
                        </div>
                        <div class="mt-auto hidden lg:block">
                            <svg width="240" height="60" viewBox="0 0 240 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="52" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[40%] lg:w-[45%] p-4 md:p-5 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-0 rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <div class="invoice-stack-sticky sticky" style="top: 148px; z-index: 3;">
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-neutral-300 rounded-xl min-h-[372px] md:min-h-0 md:h-[clamp(300px,calc(100vh-280px),480px)] bg-generic-00 will-change-transform mx-auto" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-text-default font-medium">Fallback delivery</h3>
                            <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] max-w-xl">Not every customer can receive a structured e-invoice yet. Where they can't, it still has to land — by email, by PDF, in print — without breaking the compliant flow.</p>
                        </div>
                        <div class="mt-auto hidden lg:block">
                            <svg width="240" height="60" viewBox="0 0 240 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="52" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[40%] lg:w-[45%] p-4 md:p-5 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-0 rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <!-- Gap after the stack finishes -->
            <div style="height: 80px;"></div>
        </div>

    </div>
</section>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    .invoice-stack {
      gap: 2rem !important;
    }
    .invoice-stack-sticky {
      position: static !important;
    }
    .invoice-stack-card {
      transform: none !important;
      height: auto !important;
    }
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    const stack = document.getElementById('invoice-stack-container');
    if (!stack) return;

    const textEl = document.getElementById('invoice-header-text');
    const outers = Array.from(stack.querySelectorAll('.invoice-stack-sticky'));
    const inners = Array.from(stack.querySelectorAll('.invoice-stack-card'));

    if (!outers.length || outers.length !== inners.length) return;

    const reduceMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    const STACK_OFFSET = 16;
    const REVEAL_DISTANCE = 260;

    const targetScaleFor = (i) => 0.88 + i * 0.03;

    const setTops = () => {
        const originalTransform = inners[0].style.transform;
        inners[0].style.transform = 'none';

        const outerTop = outers[0].getBoundingClientRect().top;
        const innerTop = inners[0].getBoundingClientRect().top;
        const cardOffset = innerTop - outerTop;

        inners[0].style.transform = originalTransform;

        let firstTop = 100;

        if (window.innerWidth >= 1280) {
            const cardHeight = inners[0].getBoundingClientRect().height;
            const totalStackHeight =
                cardOffset + cardHeight + (outers.length - 1) * STACK_OFFSET;
            firstTop = Math.max(100, (window.innerHeight - totalStackHeight) / 2);
        }

        outers[0].style.top = firstTop + 'px';

        const baseTop = firstTop + cardOffset;
        for (let i = 1; i < outers.length; i++) {
            outers[i].style.top = baseTop + i * STACK_OFFSET + 'px';
        }
    };

    let ticking = false;

    const update = () => {
        const tops = outers.map((el) => el.getBoundingClientRect().top);

        inners.forEach((inner, i) => {
            if (i === inners.length - 1) {
                inner.style.transform = 'scale(1)';
                return;
            }

            const nextStickyTopPx = parseFloat(getComputedStyle(outers[i + 1]).top) || 0;
            const distanceToStick = tops[i + 1] - nextStickyTopPx;

            const progress = Math.min(1, Math.max(0, 1 - distanceToStick / REVEAL_DISTANCE));
            const scale = 1 - progress * (1 - targetScaleFor(i));
            inner.style.transform = `scale(${scale.toFixed(4)})`;
        });

        ticking = false;
    };

    const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
    };

    const handleLayoutShift = () => {
        setTops();
        update();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', handleLayoutShift);
    window.addEventListener('load', handleLayoutShift, { once: true });

    if (textEl && typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(handleLayoutShift).observe(textEl);
    }

    setTops();
    update();
});
</script>