<section class="de-invoice-stack-section py-12 md:py-16 bg-generic-00">
    <div class="lg:container mx-auto w-full px-4 md:px-6">
        <!--
          Two-layer structure:
          - OUTER (.invoice-stack-sticky): position: sticky, native browser positioning.
            Never gets a JS transform, so measuring its position is always safe/stable.
          - INNER (.invoice-stack-card): the visible card. Only this gets scaled by JS.
        -->
        <!-- Mobile Header (Scrolls away) -->
        <div class="md:hidden text-center w-full mx-auto mb-8 bg-generic-00">
            <h2 class="font-heading font-medium text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] text-text-default max-w-250 mx-auto m-0 mb-3">Same invoice. Different <span class="text-generic-100 bg-flux-lime px-1 rounded-lg">rulebook,</span> every market.</h2>
            <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-neutral-500 max-w-197 mx-auto">One invoice leaves your ERP. What it has to become — and how it has to travel — changes the moment it crosses a border.</p>
        </div>

        <div id="de-invoice-stack-container" class="invoice-stack mx-auto w-full flex flex-col gap-[30vh] md:gap-[50vh]">
            <div class="invoice-stack-sticky sticky" style="top: calc(var(--nav-clear, 112px) + 0px); z-index: 0;">
                <!-- Desktop Header (Sticky) -->
                <div id="de-invoice-header-text" class="hidden md:block text-center w-full mx-auto mb-3 bg-generic-00">
                    <h2 class="font-heading font-medium text-[length:var(--fs-h2)] leading-[length:var(--lh-h2)] lg:text-[length:var(--fs-h1)] lg:leading-[length:var(--lh-h1)] max-w-250 mx-auto mb-3">Same invoice. Different <span class="text-generic-100 bg-flux-lime px-1 rounded-lg">rulebook,</span> every market.</h2>
                    <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-lg)] text-neutral-500 max-w-197 font-normal mx-auto">One invoice leaves your ERP. What it has to become — and how it has to travel — changes the moment it crosses a border.</p>
                </div>
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-neutral-300 rounded-xl min-h-[372px] md:min-h-0 md:h-[clamp(300px,calc(100vh-var(--nav-clear,112px)-180px),480px)] bg-generic-00 will-change-transform mx-auto" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-text-default font-medium">Schema & mandatory fields</h3>
                            <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] font-normal max-w-xl">The structure and the required data differ per country. A field that's optional in one market rejects the invoice in the next.</p>
                        </div>
                        <div class="mt-auto hidden lg:block">
                            <svg width="240" height="60" viewBox="0 0 240 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="52" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[40%] lg:w-[45%] p-4 md:p-5 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-0 rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <div class="invoice-stack-sticky sticky" style="top: calc(var(--nav-clear, 112px) + 16px); z-index: 1;">
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-neutral-300 rounded-xl min-h-[372px] md:min-h-0 md:h-[clamp(300px,calc(100vh-var(--nav-clear,112px)-180px),480px)] bg-generic-00 will-change-transform mx-auto" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-text-default font-medium">Validating authority & clearance model</h3>
                            <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] font-normal max-w-xl">Who checks the invoice, and when. Real-time clearance before it's legally valid (Malaysia LHDN, Poland's KSeF), or post-audit reporting after the transaction closes — every market draws the line differently.</p>
                        </div>
                        <div class="mt-auto hidden lg:block">
                            <svg width="240" height="60" viewBox="0 0 240 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="52" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[40%] lg:w-[45%] p-4 md:p-5 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-0 rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <div class="invoice-stack-sticky sticky" style="top: calc(var(--nav-clear, 112px) + 32px); z-index: 2;">
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-neutral-300 rounded-xl min-h-[372px] md:min-h-0 md:h-[clamp(300px,calc(100vh-var(--nav-clear,112px)-180px),480px)] bg-generic-00 will-change-transform mx-auto" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-text-default font-medium">Transmission path</h3>
                            <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] font-normal max-w-xl">An open network (Peppol), a central government platform, or a direct authority connection. The road changes depending upon the country.</p>
                        </div>
                        <div class="mt-auto hidden lg:block">
                            <svg width="240" height="60" viewBox="0 0 240 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="52" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[40%] lg:w-[45%] p-4 md:p-5 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-0 rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <div class="invoice-stack-sticky sticky" style="top: calc(var(--nav-clear, 112px) + 48px); z-index: 3;">
                <div class="invoice-stack-card flex flex-col md:flex-row max-w-[1280px] w-full border-2 border-neutral-300 rounded-xl min-h-[372px] md:min-h-0 md:h-[clamp(300px,calc(100vh-var(--nav-clear,112px)-180px),480px)] bg-generic-00 will-change-transform mx-auto" style="transform-origin: top center;">
                    <div class="flex-1 p-6 flex flex-col justify-between items-start">
                        <div class="w-full">
                            <h3 class="font-heading text-[length:var(--fs-h4)] md:text-[length:var(--fs-h3)] leading-[length:var(--lh-h4)] md:leading-[length:var(--lh-h3)] mb-4 text-text-default font-medium">Fallback delivery</h3>
                            <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] font-normal max-w-xl">Not every customer can receive a structured e-invoice yet. Where they can't, it still has to land — by email, by PDF, in print — without breaking the compliant flow.</p>
                        </div>
                        <div class="mt-auto hidden lg:block">
                            <svg width="240" height="60" viewBox="0 0 240 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {Array.from({ length: 8 }).map((_, i) => <circle cx={4 + i * 16} cy="4" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 11 }).map((_, i) => <circle cx={4 + i * 16} cy="20" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="36" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                                {Array.from({ length: 15 }).map((_, i) => <circle cx={4 + i * 16} cy="52" r="1.5" fill="var(--palette-primary-600, #3B46F1)" />)}
                            </svg>
                        </div>
                    </div>
                    <div class="w-full md:w-[40%] lg:w-[45%] p-4 md:p-5 lg:p-6 flex">
                        <div class="w-full h-full min-h-[200px] md:min-h-0 rounded-xl md:rounded-2xl bg-visual-placeholder"></div>
                    </div>
                </div>
            </div>

            <!-- Gap after the stack finishes -->
            <div style="height: 80px;"></div>
        </div>

    </div>
</section>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    .invoice-stack {
      gap: 2rem !important;
    }
    .invoice-stack-sticky {
      position: static !important;
    }
    .invoice-stack-card {
      transform: none !important;
      height: auto !important;
    }
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    const stack = document.getElementById('de-invoice-stack-container');
    if (!stack) return;

    const textEl = document.getElementById('de-invoice-header-text');
    const outers = Array.from(stack.querySelectorAll('.invoice-stack-sticky'));
    const inners = Array.from(stack.querySelectorAll('.invoice-stack-card'));

    if (!outers.length || outers.length !== inners.length) return;

    const reduceMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    const STACK_OFFSET = 16;
    const REVEAL_DISTANCE = 260;

    // Navbar clearance, from the shared token rather than a number of its own —
    // every pinned section on the site reads the same one. The fallback matches
    // the token so a missing shared.css degrades to the same offset.
    const NAV_CLEAR =
        parseFloat(
            getComputedStyle(document.documentElement).getPropertyValue('--nav-clear'),
        ) || 112;

    const targetScaleFor = (i) => 0.88 + i * 0.03;

    // TWO UNITS, and they are not the same one under `zoom`.
    // getBoundingClientRect() and window.innerHeight/innerWidth are RENDERED
    // pixels — what is on the glass. getComputedStyle().top, NAV_CLEAR,
    // STACK_OFFSET and anything written to `style.top` are CSS pixels.
    // shared.css puts `zoom` on the `body` element between tablet and 1440px, so the two
    // differ by that factor and this file mixes them in both directions: it
    // compares a rect against a computed top, and it derives a style.top from
    // rect measurements. Unconverted, the stack pinned at the wrong offsets and
    // the shrink triggered at the wrong scroll position.
    //
    // Walked rather than read off the `body` element, because zoom multiplies down the tree.
    const zoomFactor = () => {
        let z = 1;
        for (let n = stack; n && n.nodeType === 1; n = n.parentElement) {
            const v = parseFloat(getComputedStyle(n).zoom);
            // Unsupported -> NaN, unset -> 1. Both mean "no scaling here".
            if (v && v !== 1) z *= v;
        }
        return z;
    };

    // Recomputed by setTops, which handleLayoutShift calls on resize — that is
    // what covers crossing the 1440px bound where the zoom switches off.
    let zoom = zoomFactor();

    const setTops = () => {
        zoom = zoomFactor();

        const originalTransform = inners[0].style.transform;
        inners[0].style.transform = 'none';

        // Converted to CSS px at the point of measurement, so everything below
        // this line is CSS px and matches what style.top expects.
        const outerTop = outers[0].getBoundingClientRect().top;
        const innerTop = inners[0].getBoundingClientRect().top;
        const cardOffset = (innerTop - outerTop) / zoom;

        inners[0].style.transform = originalTransform;

        let firstTop = NAV_CLEAR;

        // The breakpoint test stays in RENDERED px — it is asking about the
        // window, not the layout, the same question a media query asks.
        if (window.innerWidth >= 1280) {
            const cardHeight = inners[0].getBoundingClientRect().height / zoom;
            const totalStackHeight =
                cardOffset + cardHeight + (outers.length - 1) * STACK_OFFSET;
            const viewportCss = window.innerHeight / zoom;
            firstTop = Math.max(NAV_CLEAR, (viewportCss - totalStackHeight) / 2);
        }

        outers[0].style.top = firstTop + 'px';

        const baseTop = firstTop + cardOffset;
        for (let i = 1; i < outers.length; i++) {
            outers[i].style.top = baseTop + i * STACK_OFFSET + 'px';
        }
    };

    let ticking = false;

    const update = () => {
        const tops = outers.map((el) => el.getBoundingClientRect().top);

        inners.forEach((inner, i) => {
            if (i === inners.length - 1) {
                inner.style.transform = 'scale(1)';
                return;
            }

            // Scaled into RENDERED px to match `tops`, which came from rects.
            const nextStickyTopPx =
                (parseFloat(getComputedStyle(outers[i + 1]).top) || 0) * zoom;
            const distanceToStick = tops[i + 1] - nextStickyTopPx;

            const progress = Math.min(1, Math.max(0, 1 - distanceToStick / REVEAL_DISTANCE));
            const scale = 1 - progress * (1 - targetScaleFor(i));
            inner.style.transform = `scale(${scale.toFixed(4)})`;
        });

        ticking = false;
    };

    const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
    };

    const handleLayoutShift = () => {
        setTops();
        update();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', handleLayoutShift);
    window.addEventListener('load', handleLayoutShift, { once: true });

    if (textEl && typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(handleLayoutShift).observe(textEl);
    }

    setTops();
    update();
});
</script>