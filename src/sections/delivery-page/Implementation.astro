---
/**
 * "Implementation, on a plan you see upfront" — Delivery Page
 *
 * 5-step implementation lifecycle process tracker:
 * - Desktop: Horizontal flex layout with 152px boxes and continuous animated connecting line.
 * - Mobile: Responsive flex-col where content flows down vertically with vertical animated connectors.
 */

interface StepItem {
    step: number;
    title: string;
    img: string;
    desc: string;
}

const steps: StepItem[] = [
    {
        step: 1,
        title: "Kick-off",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad5b71609c44abef3fd9351_imp-1.png",
        desc: "Stakeholders named. Escalation path agreed before work starts.",
    },
    {
        step: 2,
        title: "Project plan",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad5b71a1f8931ced081ffec_imp-2.png",
        desc: "Requirements confirmed. Access closed out.",
    },
    {
        step: 3,
        title: "Implementation",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad5b71fa8c40e40e2592ddf_imp-3.png",
        desc: "Your integration built against your ERP.",
    },
    {
        step: 4,
        title: "UAT",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad5b724b3e3cd3cf90118f3_imp-4.png",
        desc: "You test. We support. Sign-off before go-live.",
    },
    {
        step: 5,
        title: "Go-live",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad5b72a1f8931ced082039b_imp-5.png",
        desc: "Final push to production and you're live.",
    },
];
---

<section id="de-implementation-section" class="py-16 md:py-20 bg-generic-00 overflow-hidden">
    <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
        <!-- Section Heading -->
        <h2
            class="font-heading font-medium text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] text-text-default text-center m-0 mb-8 md:mb-12 max-w-[850px] mx-auto"
        >
            Implementation, on a plan you see upfront
        </h2>

        <!-- Steps Timeline Container -->
        <div class="relative w-full">
            <!-- Desktop Horizontal Background Line (passes through centers of the boxes) -->
            <div
                id="de-desktop-line-container"
                class="hidden md:block absolute h-[2px] z-0 pointer-events-none rounded-full overflow-hidden max-w-none"
            >
                <!-- Base Gray Line -->
                <div class="absolute inset-0 w-full h-full bg-[#E5E7EB] rounded-full"></div>
                <!-- Animated Purple Active Progress Line -->
                <div
                    id="de-progress-line-desktop"
                    class="absolute top-0 left-0 h-full bg-[#5446FF] origin-left rounded-full will-change-[width,opacity]"
                    style="width: 0%;"
                ></div>
            </div>

            <!-- Steps List: flex-col on mobile so content goes down, md:flex-row on desktop -->
            <div class="flex flex-col md:flex-row md:justify-between items-center md:items-start w-full relative z-10 gap-8 md:gap-0">
                {
                    steps.map((item, i) => (
                        <>
                            <!-- Step Item -->
                            <div
                                class="step-item w-full max-w-[228px] md:max-w-[124px] lg:max-w-[165px] xl:max-w-[228px] shrink-0 flex flex-col items-center text-center md:items-start md:text-left cursor-pointer group"
                                data-step-index={i}
                            >
                                <!-- Solid Rounded Visual Box -->
                                <div
                                    class="step-box w-[152px] h-[152px] md:w-[100px] md:h-[100px] lg:w-[124px] lg:h-[124px] xl:w-[152px] xl:h-[152px] shrink-0 mb-3 md:mb-3 lg:mb-5 xl:mb-6 relative z-10 overflow-hidden"
                                >
                                    <img src={item.img} alt={item.title} class="w-full h-full object-contain" />
                                </div>

                                <!-- Step Header (Pill + Title in a row on mobile, stacked in column on desktop) -->
                                <div class="flex flex-row md:flex-col items-center md:items-start justify-center md:justify-start gap-2 md:gap-0 mb-1.5 md:mb-2">
                                    <!-- Step Number Pill -->
                                    <div
                                        class="step-pill inline-flex items-center justify-center w-6 h-6 rounded-md border border-neutral-200/90 bg-[#FBFBFC] text-[length:var(--fs-body-sm)] font-medium text-neutral-500 shadow-[0_1px_2px_rgba(0,0,0,0.04)] md:mb-2 lg:mb-3 select-none transition-all duration-300 shrink-0"
                                        data-pill-index={i}
                                    >
                                        {item.step}
                                    </div>

                                    <!-- Step Title -->
                                    <h3 class="step-title font-heading font-medium text-[length:var(--fs-h6)] md:text-[length:var(--fs-body-sm)] lg:text-[length:var(--fs-body)] xl:text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)] md:leading-[length:var(--lh-body-sm)] lg:leading-[length:var(--lh-body)] xl:leading-[length:var(--lh-h6)] text-text-default m-0 transition-colors duration-300 whitespace-nowrap">
                                        {item.title}
                                    </h3>
                                </div>

                                <!-- Step Description -->
                                <p class="font-body text-[length:var(--fs-body)] md:text-[length:var(--fs-body-xs)] lg:text-[length:var(--fs-body-sm)] xl:text-[length:var(--fs-body)] leading-[length:var(--lh-body)] md:leading-[length:var(--lh-body-xs)] lg:leading-[length:var(--lh-body-sm)] xl:leading-[length:var(--lh-body)] text-neutral-500/80 font-normal w-full">
                                    {item.desc}
                                </p>
                            </div>

                            <!-- Mobile Vertical Connector Line (between steps in column flow) -->
                            {i < steps.length - 1 && (
                                <div class="de-mobile-connector-wrapper md:hidden flex items-center justify-center h-8 w-full -my-3 z-0">
                                    <div class="w-[2px] h-full bg-[#E5E7EB] relative overflow-hidden rounded-full">
                                        <div
                                            class="step-progress-line-mobile absolute top-0 left-0 w-full bg-[#5446FF] origin-top rounded-full will-change-[height,opacity]"
                                            data-mobile-line-index={i}
                                            style="height: 0%;"
                                        />
                                    </div>
                                </div>
                            )}
                        </>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style is:global>
    #de-desktop-line-container {
        position: absolute;
        height: 2px;
        z-index: 0;
        pointer-events: none;
        border-radius: 9999px;
        overflow: hidden;
    }

    @media (min-width: 768px) {
        #de-desktop-line-container {
            display: block !important;
            top: 50px;
            left: 42.5px;
            right: 42.5px;
            width: calc(100% - 85px) !important;
        }
        .de-mobile-connector-wrapper {
            display: none !important;
        }
    }

    @media (min-width: 1024px) {
        #de-desktop-line-container {
            top: 62px;
            left: 52px;
            right: 52px;
            width: calc(100% - 104px) !important;
        }
    }

    @media (min-width: 1280px) {
        #de-desktop-line-container {
            top: 76px;
            left: 76px;
            right: 76px;
            width: calc(100% - 152px) !important;
        }
    }

    @media (max-width: 767.98px) {
        #de-desktop-line-container {
            display: none !important;
        }
        .de-mobile-connector-wrapper {
            display: flex !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #de-progress-line-desktop,
        .step-progress-line-mobile {
            transition: none !important;
        }
    }
</style>

<script is:inline>
    const initImplementation = () => {
        const section = document.getElementById("de-implementation-section");
        if (!section) return;

        const desktopLine = document.getElementById("de-progress-line-desktop");
        const mobileLines = Array.from(section.querySelectorAll(".step-progress-line-mobile"));
        const stepItems = Array.from(section.querySelectorAll(".step-item"));
        const pills = Array.from(section.querySelectorAll(".step-pill"));

        if (!stepItems.length) return;

        const reduceMotion =
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Update pills up to active index
        const updatePills = (activeTargetIndex) => {
            pills.forEach((pill, idx) => {
                if (idx <= activeTargetIndex) {
                    pill.classList.add("border-[#5446FF]", "text-[#5446FF]", "font-medium");
                } else {
                    pill.classList.remove("border-[#5446FF]", "text-[#5446FF]", "font-medium");
                }
            });
        };

        let activeTimeouts = [];
        let isUserInteracting = false;
        let hasAnimated = false;

        const clearAllTimeouts = () => {
            activeTimeouts.forEach(clearTimeout);
            activeTimeouts = [];
        };

        // Runs sequential animation ONCE from Step 1 all the way to Step 5 (NO LOOP)
        const runFullSequence = () => {
            if (hasAnimated) return;
            hasAnimated = true;

            if (reduceMotion) {
                if (desktopLine) {
                    desktopLine.style.opacity = "1";
                    desktopLine.style.width = "100%";
                }
                mobileLines.forEach((l) => {
                    l.style.opacity = "1";
                    l.style.height = "100%";
                });
                updatePills(4);
                return;
            }

            clearAllTimeouts();

            // Initial state at Step 1
            if (desktopLine) {
                desktopLine.style.transition = "none";
                desktopLine.style.width = "0%";
                void desktopLine.offsetWidth;
                desktopLine.style.opacity = "1";
            }
            mobileLines.forEach((l) => {
                l.style.transition = "none";
                l.style.height = "0%";
                void l.offsetWidth;
                l.style.transition = "opacity 250ms ease";
                l.style.opacity = "1";
            });
            updatePills(0);

            // Begin stepping smoothly
            const stepDuration = 650; // smooth glide per step
            const stepGapPause = 350; // pause between milestones
            let currentDelay = 200;

            for (let i = 0; i < 4; i++) {
                const stepIdx = i;
                const nextStepIdx = i + 1;
                const targetPercentage = (nextStepIdx / 4) * 100;

                activeTimeouts.push(
                    setTimeout(() => {
                        if (isUserInteracting) return;

                        // Animate desktop line smoothly
                        if (desktopLine) {
                            desktopLine.style.transition = `width ${stepDuration}ms cubic-bezier(0.25, 1, 0.5, 1)`;
                            desktopLine.style.width = `${targetPercentage}%`;
                        }

                        // Animate mobile vertical line segment smoothly
                        if (mobileLines[stepIdx]) {
                            mobileLines[stepIdx].style.transition = `height ${stepDuration}ms cubic-bezier(0.25, 1, 0.5, 1)`;
                            mobileLines[stepIdx].style.height = "100%";
                        }

                        // When line reaches milestone:
                        activeTimeouts.push(
                            setTimeout(() => {
                                if (isUserInteracting) return;
                                updatePills(nextStepIdx);
                            }, stepDuration)
                        );
                    }, currentDelay)
                );

                currentDelay += stepDuration + stepGapPause;
            }
        };

        // Trigger strictly ONCE when scrolled into view
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting && !hasAnimated) {
                            observer.disconnect();
                            setTimeout(runFullSequence, 150);
                        }
                    });
                },
                { threshold: 0.2 }
            );
            observer.observe(section);
        } else {
            runFullSequence();
        }

        // Click handler for any step item to manually navigate (no loop restart)
        const handleStepClick = (targetIndex) => {
            isUserInteracting = true;
            clearAllTimeouts();

            const targetPercentage = (targetIndex / 4) * 100;

            if (desktopLine) {
                desktopLine.style.opacity = "1";
                desktopLine.style.transition = "width 600ms cubic-bezier(0.25, 1, 0.5, 1)";
                desktopLine.style.width = `${targetPercentage}%`;
            }

            mobileLines.forEach((l, idx) => {
                l.style.opacity = "1";
                l.style.transition = "height 600ms cubic-bezier(0.25, 1, 0.5, 1)";
                if (idx < targetIndex) {
                    l.style.height = "100%";
                } else {
                    l.style.height = "0%";
                }
            });

            updatePills(targetIndex);
        };

        stepItems.forEach((item, idx) => {
            item.addEventListener("click", () => handleStepClick(idx));
        });
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initImplementation);
    } else {
        initImplementation();
    }
</script>