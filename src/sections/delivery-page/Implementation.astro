---
/**
 * "Implementation, on a plan you see upfront" — Delivery Page
 *
 * 5-step implementation lifecycle process tracker:
 * - Desktop: Horizontal flex layout with 152px boxes and continuous animated connecting line.
 * - Mobile: Responsive flex-col where content flows down vertically with vertical animated connectors.
 */

interface StepItem {
    step: number;
    title: string;
    desc: string;
}

const steps: StepItem[] = [
    {
        step: 1,
        title: "Kick-off",
        desc: "Stakeholders named. Escalation path agreed before work starts.",
    },
    {
        step: 2,
        title: "Project plan",
        desc: "Requirements confirmed. Access closed out.",
    },
    {
        step: 3,
        title: "Implementation",
        desc: "Your integration built against your ERP.",
    },
    {
        step: 4,
        title: "UAT",
        desc: "You test. We support. Sign-off before go-live.",
    },
    {
        step: 5,
        title: "Go-live",
        desc: "Final push to production and you're live.",
    },
];
---

<section id="de-implementation-section" class="py-16 md:py-20 bg-generic-00 overflow-hidden">
    <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
        <!-- Section Heading -->
        <h2
            class="font-heading font-medium text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] text-text-default text-center m-0 mb-8 md:mb-12 max-w-[850px] mx-auto"
        >
            Implementation, on a plan you see upfront
        </h2>

        <!-- Steps Timeline Container -->
        <div class="relative w-full">
            <!-- Desktop Horizontal Background Line (passes through centers of the 152px boxes at 76px) -->
            <div
                class="hidden md:block absolute h-[2px] z-0 pointer-events-none"
                style="top: 76px; left: 76px; right: 152px;"
            >
                <!-- Base Gray Line -->
                <div class="absolute inset-0 w-full h-full bg-[#E5E7EB]"></div>
                <!-- Animated Purple Active Progress Line -->
                <div
                    id="de-progress-line-desktop"
                    class="absolute top-0 left-0 h-full bg-[#5446FF] origin-left"
                    style="width: 0%;"
                ></div>
            </div>

            <!-- Steps List: flex-col on mobile so content goes down, md:flex-row on desktop -->
            <div class="flex flex-col md:flex-row md:justify-between items-center md:items-start w-full relative z-10 gap-8 md:gap-0">
                {
                    steps.map((item, i) => (
                        <>
                            <!-- Step Item -->
                            <div
                                class="step-item w-full max-w-[228px] md:max-w-none md:w-[228px] shrink-0 flex flex-col items-center text-center md:items-start md:text-left cursor-pointer group"
                                data-step-index={i}
                            >
                                <!-- 152px Solid Rounded Visual Placeholder Box -->
                                <div
                                    class="step-box w-[152px] h-[152px] rounded-[22px] md:rounded-[24px] bg-visual-placeholder shrink-0 mb-4 md:mb-6 relative z-10"
                                >
                                </div>

                                <!-- Step Number Pill -->
                                <div
                                    class="step-pill inline-flex items-center justify-center w-6 h-6 rounded-md border border-neutral-200/90 bg-[#FBFBFC] text-sm font-medium text-neutral-500 shadow-[0_1px_2px_rgba(0,0,0,0.04)] mb-3 select-none transition-all duration-300"
                                    data-pill-index={i}
                                >
                                    {item.step}
                                </div>

                                <!-- Step Title -->
                                <h3 class="step-title font-heading font-medium text-base sm:text-[20px] leading-[1.3] text-text-default mb-2 transition-colors duration-300">
                                    {item.title}
                                </h3>

                                <!-- Step Description -->
                                <p class="font-body text-base leading-[1.5] text-neutral-500/80 font-normal w-full">
                                    {item.desc}
                                </p>
                            </div>

                            <!-- Mobile Vertical Connector Line (between steps in column flow) -->
                            {i < steps.length - 1 && (
                                <div class="md:hidden flex items-center justify-center h-8 w-full -my-3 z-0">
                                    <div class="w-[2px] h-full bg-[#E5E7EB] relative overflow-hidden">
                                        <div
                                            class="step-progress-line-mobile absolute top-0 left-0 w-full bg-[#5446FF] origin-top"
                                            data-mobile-line-index={i}
                                            style="height: 0%;"
                                        />
                                    </div>
                                </div>
                            )}
                        </>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style is:global>
    @media (prefers-reduced-motion: reduce) {
        #de-progress-line-desktop,
        .step-progress-line-mobile {
            transition: none !important;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const section = document.getElementById("de-implementation-section");
        if (!section) return;

        const desktopLine = document.getElementById("de-progress-line-desktop");
        const mobileLines = Array.from(section.querySelectorAll(".step-progress-line-mobile"));
        const stepItems = Array.from(section.querySelectorAll(".step-item"));
        const pills = Array.from(section.querySelectorAll(".step-pill"));

        if (!stepItems.length) return;

        const reduceMotion =
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Update pills up to active index
        const updatePills = (activeTargetIndex) => {
            pills.forEach((pill, idx) => {
                if (idx <= activeTargetIndex) {
                    pill.classList.add("border-[#5446FF]", "text-[#5446FF]", "font-medium");
                } else {
                    pill.classList.remove("border-[#5446FF]", "text-[#5446FF]", "font-medium");
                }
            });
        };

        let loopTimeout = null;
        let isUserInteracting = false;

        // Runs sequential animation from Step 1 all the way to Step 5
        const runFullSequence = () => {
            if (reduceMotion) {
                if (desktopLine) desktopLine.style.width = "100%";
                mobileLines.forEach((l) => (l.style.height = "100%"));
                updatePills(4);
                return;
            }

            if (isUserInteracting) return;

            // Reset lines to 0% and pills to Step 1 active
            if (desktopLine) {
                desktopLine.style.transition = "none";
                desktopLine.style.width = "0%";
            }
            mobileLines.forEach((l) => {
                l.style.transition = "none";
                l.style.height = "0%";
            });
            updatePills(0);

            const stepDuration = 550; // duration for line to reach next milestone
            const stepGapPause = 120; // brief pause before next segment begins

            let currentDelay = 250;

            for (let i = 0; i < 4; i++) {
                const stepIdx = i;
                const nextStepIdx = i + 1;
                const targetPercentage = (nextStepIdx / 4) * 100;

                setTimeout(() => {
                    if (isUserInteracting) return;

                    // Animate desktop line
                    if (desktopLine) {
                        desktopLine.style.transition = `width ${stepDuration}ms cubic-bezier(0.4, 0, 0.2, 1)`;
                        desktopLine.style.width = `${targetPercentage}%`;
                    }

                    // Animate mobile vertical line segment
                    if (mobileLines[stepIdx]) {
                        mobileLines[stepIdx].style.transition = `height ${stepDuration}ms cubic-bezier(0.4, 0, 0.2, 1)`;
                        mobileLines[stepIdx].style.height = "100%";
                    }

                    // When line reaches milestone:
                    setTimeout(() => {
                        if (isUserInteracting) return;

                        updatePills(nextStepIdx);

                        // If reached the final step (Box 5 / index 4), pause for 4.5s then smoothly loop
                        if (nextStepIdx === 4) {
                            clearTimeout(loopTimeout);
                            loopTimeout = setTimeout(() => {
                                if (!isUserInteracting) {
                                    runFullSequence();
                                }
                            }, 4500);
                        }
                    }, stepDuration);
                }, currentDelay);

                currentDelay += stepDuration + stepGapPause;
            }
        };

        // Trigger when scrolled into view
        let hasTriggered = false;
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting && !hasTriggered) {
                            hasTriggered = true;
                            setTimeout(runFullSequence, 200);
                        }
                    });
                },
                { threshold: 0.15 }
            );
            observer.observe(section);
        } else {
            runFullSequence();
        }

        // Click handler for any step item to manually navigate
        const handleStepClick = (targetIndex) => {
            isUserInteracting = true;
            clearTimeout(loopTimeout);

            const targetPercentage = (targetIndex / 4) * 100;

            if (desktopLine) {
                desktopLine.style.transition = "width 400ms cubic-bezier(0.4, 0, 0.2, 1)";
                desktopLine.style.width = `${targetPercentage}%`;
            }

            mobileLines.forEach((l, idx) => {
                l.style.transition = "height 400ms cubic-bezier(0.4, 0, 0.2, 1)";
                if (idx < targetIndex) {
                    l.style.height = "100%";
                } else {
                    l.style.height = "0%";
                }
            });

            updatePills(targetIndex);

            // Resume loop after 6s of inactivity
            loopTimeout = setTimeout(() => {
                isUserInteracting = false;
                runFullSequence();
            }, 6000);
        };

        stepItems.forEach((item, idx) => {
            item.addEventListener("click", () => handleStepClick(idx));
        });
    });
</script>