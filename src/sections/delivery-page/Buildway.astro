---
const loadContent = [
    {
        title: 'Build cost',
        desc: 'Every connector, every schema, every clearance flow — engineered in-house, then paid for again in upkeep.',
    },
    {
        title: 'Maintenance drag',
        desc: 'What you build once, you maintain forever. Every mandate tweak is a ticket, a sprint, a regression risk.',
    },
    {
        title: 'Manual gaps',
        desc: 'Someone rekeys between ERPs and government portals. Every hop is a chance to get it wrong.',
    },
    {
        title: 'Patchwork architecture',
        desc: 'Stitched together market by market. Every seam is a place it can break — and now you have dozens across geographies.',
    }
];
---

<section class="py-16 md:py-20 bg-generic-00">
    <div class="lg:container mx-auto px-4 md:px-6">
        <div class="text-center mb-16 md:mb-20">
            <h2 class="font-heading text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium max-w-[800px] mx-auto text-text-default">And building your way out costs more than the mandate ever did.</h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center mx-auto">
            <!-- Left Side: Tabs -->
            <div class="lg:col-span-5 flex flex-col space-y-2 relative" id="buildway-tabs">
                {
                    loadContent.map((item, i) => (
                        <div class="buildway-item flex flex-col cursor-pointer group" data-index={i}>
                            <h3 class="buildway-title font-heading text-[24px] leading-[length:var(--lh-h4)] font-medium text-text-default py-4 transition-all duration-300 group-hover:text-primary-600">{item.title}</h3>
                            
                            <div class="buildway-desc overflow-hidden max-w-132 transition-all duration-500 ease-in-out" style="max-height: 0px; opacity: 0;">
                                <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] pb-6">{item.desc}</p>
                            </div>
                            
                            <!-- Custom spaced dotted line loader -->
                            <div class="relative w-full h-[12px] mb-2">
                                <!-- Base gray dots -->
                                <div class="absolute inset-0 w-full h-full" style="background-image: radial-gradient(circle, #CCCCCC 1.5px, transparent 1.5px); background-size: 12px 6px; background-position: left top; background-repeat: repeat;"></div>
                                <!-- Active blue dots (fills up) -->
                                <div class="buildway-progress absolute left-0 top-0 h-full transition-none" style="width: 0%; -webkit-mask-image: linear-gradient(to left, transparent 0%, black 36px); mask-image: linear-gradient(to left, transparent 0%, black 36px); background-image: radial-gradient(circle, #5446FF 1.5px, transparent 1.5px); background-size: 12px 6px; background-position: left top; background-repeat: repeat;"></div>
                            </div>
                        </div>
                    ))
                }
            </div>

            <!-- Right Side: Sliding Visuals -->
            <div class="lg:col-span-7 w-full flex justify-center lg:justify-end">
                <div class="relative w-full max-w-[600px] min-h-[372px] rounded-2xl overflow-hidden aspect-video md:aspect-[4/3] lg:aspect-auto lg:h-[500px]">
                    <div id="buildway-slider" class="flex w-full h-full gap-4 transition-transform duration-700 ease-in-out">
                        <!-- Placeholder 1 -->
                        <div class="w-full max-w-[600px] shrink-0 h-full bg-visual-placeholder flex items-center justify-center">
                        </div>
                        <!-- Placeholder 2 -->
                        <div class="w-full max-w-[600px] shrink-0 h-full bg-visual-placeholder flex items-center justify-center">
                        </div>
                        <!-- Placeholder 3 -->
                        <div class="w-full max-w-[600px] shrink-0 h-full bg-visual-placeholder flex items-center justify-center">
                        </div>
                        <!-- Placeholder 4 -->
                        <div class="w-full max-w-[600px] shrink-0 h-full bg-visual-placeholder flex items-center justify-center">
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.buildway-item');
    const slider = document.getElementById('buildway-slider');
    if (!items.length || !slider) return;

    let currentIndex = 0;
    let timer = null;
    const duration = 5000; // 5 seconds per tab

    const activateTab = (index, instant = false) => {
        currentIndex = index;
        
        // Slide right panel (100% width + 16px gap per index)
        slider.style.transform = `translateX(calc(-${index * 100}% - ${index * 16}px))`;

        items.forEach((item, i) => {
            const desc = item.querySelector('.buildway-desc');
            const progress = item.querySelector('.buildway-progress');
            const title = item.querySelector('.buildway-title');
            
            if (i === index) {
                // Active state
                desc.style.maxHeight = desc.scrollHeight + 'px';
                desc.style.opacity = '1';
                
                title.classList.remove('text-[24px]');
                title.classList.add('text-[32px]');
                
                // Reset progress line to 0, then animate to 100%
                progress.style.transition = 'none';
                progress.style.width = '0%';
                
                // Force reflow to ensure the transition restart works
                void progress.offsetWidth;
                
                if (!instant) {
                    progress.style.transition = `width ${duration}ms linear`;
                    progress.style.width = '100%';
                }
            } else {
                // Inactive state
                desc.style.maxHeight = '0px';
                desc.style.opacity = '0';

                title.classList.remove('text-[32px]');
                title.classList.add('text-[24px]');
                
                // Keep the progress line filled for past items, empty for future items
                progress.style.transition = 'width 0.3s ease';
                progress.style.width = '0%';
            }
        });
    };

    const nextTab = () => {
        const next = (currentIndex + 1) % items.length;
        activateTab(next);
    };

    const startTimer = () => {
        clearInterval(timer);
        activateTab(currentIndex);
        timer = setInterval(nextTab, duration);
    };

    // Allow user to click to switch tabs manually
    items.forEach((item, i) => {
        item.addEventListener('click', () => {
            clearInterval(timer);
            activateTab(i);
            // Restart timer for the new tab
            timer = setInterval(nextTab, duration);
        });
    });

    // Start auto-play
    startTimer();
});
</script>