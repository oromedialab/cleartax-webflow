---
const loadContent = [
    {
        title: 'A workaround, on a clock',
        desc: 'P0 issues get a workaround within 24 hours. P1 within 48 hours. Not just an acknowledgment. Something that lets you keep working while the fix lands.',
    },
    {
        title: 'Root cause, not just a patch',
        desc: 'Fixes address what\'s actually broken: design, logic, or configuration. The goal is restoring normal operation, not covering the symptom.',
    },
    {
        title: 'The same team, before and after',
        desc: 'Your Customer Success Manager and technical support are the same people throughout. No handoff to someone new when something breaks.',
    }
];
---

<section class="py-16 md:py-20 bg-generic-00">
    <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
        <div class="text-center mb-8 md:mb-12">
            <h2 class="font-heading text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium max-w-[800px] mx-auto m-0 text-text-default"
            >When something goes wrong</h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 lg:items-center mx-auto">
            <!-- Left Side: Tabs -->
            <div class="lg:col-span-5 flex flex-col justify-center relative" id="buildway-tabs">
                {
                    loadContent.map((item, i) => (
                        <div class={`de-buildway-item flex flex-col cursor-pointer group ${i === 0 ? 'active' : ''}`} data-index={i}>
                            <h3 class="de-buildway-title font-heading text-[24px] leading-[32px] font-medium text-neutral-500 group-[.active]:text-text-default pt-1 transition-colors duration-200">
                                {item.title}
                            </h3>
                            
                            <div 
                                class="de-buildway-desc overflow-hidden max-w-[480px] transition-all duration-500 ease-in-out" 
                                style={i === 0 ? "max-height: 120px; opacity: 1;" : "max-height: 0px; opacity: 0;"}
                            >
                                <p class="font-body text-sm md:text-[15px] leading-relaxed text-[#6B7280CC] font-normal pt-2.5 pb-2">
                                    {item.desc}
                                </p>
                            </div>
                            
                            <!-- Progress line loader -->
                            <div class="relative w-full h-[2px] bg-neutral-200 mt-2.5 mb-3.5 rounded-full overflow-hidden">
                                <!-- Active blue line (fills up) -->
                                <div class="de-buildway-progress absolute left-0 top-0 h-full bg-nova-blue rounded-full transition-none" style="width: 0%;"></div>
                            </div>
                        </div>
                    ))
                }
            </div>

            <!-- Right Side: Visual -->
            <div class="lg:col-span-7 w-full flex justify-center lg:justify-end">
                <div class="relative w-full max-w-[548px] h-[314px] overflow-hidden flex items-center justify-center">
                    <img 
                        src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad5b408d131b1b7d7e6b761_img-icon.png" 
                        alt="img-icon"
                        width="548"
                        height="314"
                        loading="lazy"
                        class="w-full h-full object-contain pointer-events-none select-none"
                    />
                </div>
            </div>
        </div>

    </div>
</section>

<script is:inline>
(() => {
    const init = () => {
        const tabsContainer = document.getElementById('buildway-tabs');
        if (!tabsContainer) return;
        const items = tabsContainer.querySelectorAll('.de-buildway-item');
        if (!items.length) return;

        let currentIndex = 0;
        let timer = null;
        const duration = 5000; // 5 seconds per tab

        const activateTab = (index, instant = false) => {
            currentIndex = index;

            items.forEach((item, i) => {
                const desc = item.querySelector('.de-buildway-desc');
                const progress = item.querySelector('.de-buildway-progress');
                
                if (i === index) {
                    // Active state
                    item.classList.add('active');
                    if (desc) {
                        desc.style.maxHeight = desc.scrollHeight + 'px';
                        desc.style.opacity = '1';
                    }
                    
                    if (progress) {
                        // Reset progress line to 0, then animate to 100%
                        progress.style.transition = 'none';
                        progress.style.width = '0%';
                        
                        // Force reflow to ensure the transition restart works
                        void progress.offsetWidth;
                        
                        if (!instant) {
                            progress.style.transition = `width ${duration}ms linear`;
                            progress.style.width = '100%';
                        }
                    }
                } else {
                    // Inactive state
                    item.classList.remove('active');
                    if (desc) {
                        desc.style.maxHeight = '0px';
                        desc.style.opacity = '0';
                    }
                    
                    if (progress) {
                        progress.style.transition = 'width 0.2s ease';
                        progress.style.width = '0%';
                    }
                }
            });
        };

        const nextTab = () => {
            const next = (currentIndex + 1) % items.length;
            activateTab(next);
        };

        const startTimer = () => {
            clearInterval(timer);
            activateTab(currentIndex);
            timer = setInterval(nextTab, duration);
        };

        // Allow user to click to switch tabs manually
        items.forEach((item, i) => {
            item.addEventListener('click', () => {
                clearInterval(timer);
                activateTab(i);
                // Restart timer for the new tab
                timer = setInterval(nextTab, duration);
            });
        });

        // Recalculate active description max-height on window resize
        window.addEventListener('resize', () => {
            const activeDesc = items[currentIndex]?.querySelector('.de-buildway-desc');
            if (activeDesc) {
                activeDesc.style.maxHeight = activeDesc.scrollHeight + 'px';
            }
        });

        // Start auto-play
        startTimer();
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>