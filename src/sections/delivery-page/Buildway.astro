---
const loadContent = [
    {
        title: 'A workaround, on a clock',
        desc: 'P0 issues get a workaround within 24 hours. P1 within 48 hours. Not just an acknowledgment. Something that lets you keep working while the fix lands.',
    },
    {
        title: 'Root cause, not just a patch',
        desc: 'Fixes address what\'s actually broken: design, logic, or configuration. The goal is restoring normal operation, not covering the symptom.',
    },
    {
        title: 'The same team, before and after',
        desc: 'Your Customer Success Manager and technical support are the same people throughout. No handoff to someone new when something breaks.',
    }
];
---

<section class="py-16 md:py-20 bg-generic-00">
    <div class="max-w-[var(--container-max)] w-full mx-auto px-4 md:px-6">
        <div class="text-center mb-8 md:mb-12">
            <h2 class="font-heading text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] font-medium max-w-[800px] mx-auto m-0 text-text-default"
            >When something goes wrong</h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center mx-auto">
            <!-- Left Side: Tabs -->
            <div class="lg:col-span-5 flex flex-col space-y-1 relative" id="buildway-tabs">
                {
                    loadContent.map((item, i) => (
                        <div class="de-buildway-item flex flex-col cursor-pointer group" data-index={i}>
                            <h3 class="de-buildway-title font-heading text-[24px] leading-[length:var(--lh-h4)] font-medium text-text-default py-4 transition-all duration-300 group-hover:text-primary-600">{item.title}</h3>
                            
                            <div class="de-buildway-desc overflow-hidden max-w-132 transition-all duration-500 ease-in-out" style="max-height: 0px; opacity: 0;">
                                <p class="font-body text-[length:var(--fs-body)] leading-[length:var(--lh-body)] text-[#6B7280CC] font-normal pb-6">{item.desc}</p>
                            </div>
                            
                            <!-- Progress line loader -->
                            <div class="relative w-full h-[1px] mt-2 mb-2">
                                <!-- Base gray line -->
                                <div class="absolute inset-0 w-full h-full bg-neutral-200"></div>
                                <!-- Active blue line (fills up) -->
                                <div class="de-buildway-progress absolute left-0 top-0 h-full transition-none" style="width: 0%;"></div>
                            </div>
                        </div>
                    ))
                }
            </div>

            <!-- Right Side: Sliding Visuals -->
            <div class="lg:col-span-7 w-full flex justify-center lg:justify-end">
                <div class="relative w-full max-w-[548px] h-[314px] rounded-2xl overflow-hidden">
                    <div id="de-buildway-slider" class="flex w-full h-full gap-4 transition-transform duration-700 ease-in-out">
                        {
                            loadContent.map((_, i) => (
                                <div class="w-full max-w-[548px] shrink-0 h-full bg-visual-placeholder flex items-center justify-center">
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.de-buildway-item');
    const slider = document.getElementById('de-buildway-slider');
    if (!items.length || !slider) return;

    let currentIndex = 0;
    let timer = null;
    const duration = 5000; // 5 seconds per tab

    const activateTab = (index, instant = false) => {
        currentIndex = index;
        
        // Slide right panel (100% width + 16px gap per index)
        slider.style.transform = `translateX(calc(-${index * 100}% - ${index * 16}px))`;

        items.forEach((item, i) => {
            const desc = item.querySelector('.de-buildway-desc');
            const progress = item.querySelector('.de-buildway-progress');
            const title = item.querySelector('.de-buildway-title');
            
            if (i === index) {
                // Active state
                desc.style.maxHeight = desc.scrollHeight + 'px';
                desc.style.opacity = '1';
                
                title.classList.remove('text-[24px]');
                title.classList.add('text-[32px]');
                
                // Reset progress line to 0, then animate to 100%
                progress.style.transition = 'none';
                progress.style.width = '0%';
                
                // Force reflow to ensure the transition restart works
                void progress.offsetWidth;
                
                if (!instant) {
                    progress.style.transition = `width ${duration}ms linear`;
                    progress.style.width = '100%';
                }
            } else {
                // Inactive state
                desc.style.maxHeight = '0px';
                desc.style.opacity = '0';

                title.classList.remove('text-[32px]');
                title.classList.add('text-[24px]');
                
                // Keep the progress line filled for past items, empty for future items
                progress.style.transition = 'width 0.3s ease';
                progress.style.width = '0%';
            }
        });
    };

    const nextTab = () => {
        const next = (currentIndex + 1) % items.length;
        activateTab(next);
    };

    const startTimer = () => {
        clearInterval(timer);
        activateTab(currentIndex);
        timer = setInterval(nextTab, duration);
    };

    // Allow user to click to switch tabs manually
    items.forEach((item, i) => {
        item.addEventListener('click', () => {
            clearInterval(timer);
            activateTab(i);
            // Restart timer for the new tab
            timer = setInterval(nextTab, duration);
        });
    });

    // Start auto-play
    startTimer();
});
</script>