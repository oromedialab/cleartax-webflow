---
import UnderneathMandate from '../_shared/UnderneathMandate.astro';

const ComplianceData = [
    {
        title: 'Systems that don\'t talk to each other',
        img: 'var(--palette-visual-placeholder)',
        desc: 'Multiple ERPs, multiple POS systems, an aging landscape that predates this regulation',
    },
    {
        title: 'Records that don’t match across systems',
        img: 'var(--palette-visual-placeholder)',
        desc: 'Vendor IDs and tax references that look fine in isolation, invisible until an invoice fails at the border of a new mandate.',
    },
    {
        title: 'The right expertise, never in the same room',
        img: 'var(--palette-visual-placeholder)',
        desc: 'ERP knowledge and tax knowledge rarely sit on the same team. A schema change needs both, fast.',
    },
    {
        title: 'Every country multiplies; it doesn’t add',
        img: 'var(--palette-visual-placeholder)',
        desc: 'A new vendor, a new build, per geography. Complexity compounds instead of stacking.',
    }
];
---

<UnderneathMandate 
    title="It's never the mandate. It's what's underneath."
    items={ComplianceData}
/>