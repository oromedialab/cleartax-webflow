---
/**
 * "What Crea y Crece in Spain Requires, and How ClearTax Delivers It"
 *
 * Eight cards in a 2-column grid. A card is a button: clicking it opens ONE
 * overlay dialog showing that card's heading and body, with prev/next chevrons
 * to walk the other seven without closing.
 *
 * Ids and data attributes are `sp-supports-` prefixed: embeds share one
 * namespace per page.
 */
interface Card {
    heading: string;
    body: string;
}

const cards: Card[] = [
    {
        heading: "Applicability",
        body: `<p class="m-0">Applies to Spanish-established entities in domestic B2B transactions. Foreign entities are in scope only if they hold a Spanish permanent establishment. B2C and B2G (which remains under FACe) are excluded.</p>`,
    },
    {
        heading: "Issue and Receive Electronic Invoices",
        body: `<p class="m-0">Invoices must be issued and received electronically in a structured, machine-processable format for in-scope B2B transactions.</p><p class="m-0">The requirement generally applies when an invoice is required for a business transaction and the recipient is a business or professional established in Spain, subject to the applicable rules and exceptions.</p>`,
    },
    {
        heading: "Acceptable Formats in EN 16931",
        body: `<p class="m-0">The framework recognises structured invoice messages aligned with the European EN 16931 semantic data model.</p><p class="m-0">The specified syntaxes are: UBL (Universal Business Language), CII (Cross Industry Invoice), EDIFACT invoice messages, and Facturae.</p><p class="m-0">UBL is mandatory for the copia fiel to AEAT. ClearTax converts from your native ERP format, and no restructuring of your data model is required.</p>`,
    },
    {
        heading: "Connect Through the Public Solution or Private Platforms",
        body: `<p class="m-0">Businesses are permitted to use the public electronic invoicing solution or private invoice exchange platforms.</p><p class="m-0">Private platforms must support the prescribed interoperability requirements, including exchanging invoices and the copia fiel in UBL format to AEAT. Your solution should support your chosen operating model and enable invoices to move between counterparties using the required formats and exchange routes.</p>`,
    },
    {
        heading: "True Copy Obligation (Copia Fiel)",
        body: `<p class="m-0">A faithful UBL copy of every invoice must reach AEAT simultaneously with delivery to the buyer. This applies regardless of which delivery channel you use. ClearTax automates this dual-path transmission so nothing falls through the gap.</p>`,
    },
    {
        heading: "Report Invoice Lifecycle",
        body: `<p class="m-0">The Crea y Crece framework requires invoice lifecycle reporting alongside structured invoice exchange. Buyers must report invoice acceptance, rejection, and payment status to AEAT within 4 calendar days (excluding weekends and national public holidays) of receipt. The mandatory statuses communicated to the invoice issuer include:</p><ul class="m-0 pl-5 list-disc space-y-1"><li>Commercial acceptance or rejection of the invoice, with the date.</li><li>Full payment of the invoice, with the effective payment date.</li></ul><p class="m-0">Optional reporting is also allowed for partial payments and acceptances or rejections.</p><p class="m-0">ClearTax tracks every invoice through its full lifecycle and surfaces exceptions before they become audit triggers.</p>`,
    },
    {
        heading: "Meet the Applicable Reporting Timelines",
        body: `<p class="m-0">For status information exchanged under the private-platform provisions, the prescribed reporting window is a maximum of four natural days, excluding Saturdays, Sundays and national holidays, from the date of the reported event.</p>`,
    },
    {
        heading: "Interoperability",
        body: `<p class="m-0">Private platforms must interoperate with each other and with the AEAT public solution. Automated retrieval from AEAT is a platform obligation, not a business one. ClearTax is built for it.</p>`,
    },
];
---

<section class="bg-generic-00 pt-16 pb-12 lg:pt-20">
    <div
        class="w-full max-w-[var(--container-max)] mx-auto px-4 md:px-6 flex flex-col items-center gap-12"
    >
        <div class="flex flex-col items-center gap-6 text-center">
            <h2
                class="m-0 font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] max-w-191 tracking-[-0.5px]"
            >
                What Crea y Crece in Spain Requires, and How ClearTax Delivers
                It
            </h2>
        </div>

        <div
            class="grid w-full grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-8"
        >
            {
                cards.map((card, i) => (
                    <button
                        type="button"
                        class="group m-0 flex h-full w-full cursor-pointer items-center justify-between gap-3 sm:gap-4 md:gap-5 rounded-xl border border-neutral-300 bg-generic-00 p-4 sm:p-5 md:p-6 text-left transition-all duration-150 ease-in-out hover:border-nova-blue"
                        aria-haspopup="dialog"
                        data-sp-supports-open
                        data-sp-supports-index={i}
                    >
                        <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-body)] leading-[length:var(--lh-body)] md:text-[length:var(--fs-body-lg)] md:leading-[length:var(--lh-body-lg)] lg:text-[length:var(--fs-h6)] lg:leading-[length:var(--lh-h6)]">
                            {card.heading}
                        </span>
                        <span
                            class="ml-auto flex h-10 w-10 sm:h-12 sm:w-12 lg:h-14 lg:w-14 shrink-0 items-center justify-center rounded-lg p-1.5 sm:p-2 text-vault-navy transition-colors duration-150 ease-in-out group-hover:text-nova-blue"
                            aria-hidden="true"
                        >
                            <svg
                                class="h-6 w-6 sm:h-8 sm:w-8 lg:h-10 lg:w-10"
                                viewBox="0 0 40 40"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20 10V30"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                                <path
                                    d="M30 20L10 20"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </span>
                    </button>
                ))
            }
        </div>
    </div>
</section>

<!-- Detail overlay. Lives outside the section's container so the scrim covers
     the viewport rather than the 1280px column. -->
<div
    id="sp-supports-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sp-supports-overlay-title"
    aria-hidden="true"
    class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
>
    <div
        class="relative max-h-[90vh] w-full max-w-[500px] overflow-y-auto rounded-xl border-2 border-[#CCCCCC] bg-generic-00 p-6"
        data-sp-supports-panel
    >
        <button
            type="button"
            aria-label="Close"
            class="absolute right-6 top-6 z-10 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-0 text-vault-navy transition-opacity duration-150 hover:opacity-70 lg:right-5 lg:top-5"
            data-sp-supports-close
        >
            <svg
                width="40"
                height="40"
                viewBox="0 0 40 40"
                fill="none"
                class="rotate-45"
                aria-hidden="true"
                focusable="false"
            >
                <path
                    d="M20 10V30"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                <path
                    d="M30 20L10 20"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </button>

        <div class="flex flex-col items-start gap-6">
            <div
                class="flex w-full flex-col justify-between gap-6 lg:w-[440px] lg:shrink-0 lg:self-stretch"
            >
                <div class="flex flex-col gap-6">
                    <div id="sp-supports-overlay-title">
                        {
                            cards.map((card, i) => (
                                <h3
                                    class="m-0 pr-12 font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[length:var(--lh-h5)] tracking-[-0.5px] lg:pr-0 text-balance"
                                    style={
                                        i === 0
                                            ? "display: block;"
                                            : "display: none;"
                                    }
                                    hidden={i !== 0}
                                    data-sp-supports-heading
                                >
                                    {card.heading}
                                </h3>
                            ))
                        }
                    </div>
                </div>

                <div
                    class="aspect-[510/286] w-full rounded-lg overflow-hidden bg-visual-placeholder"
                >
                    {
                        cards.map((card, i) => (
                            <div
                                class="h-full w-full bg-visual-placeholder"
                                style={
                                    i === 0
                                        ? "display: block;"
                                        : "display: none;"
                                }
                                hidden={i !== 0}
                                data-sp-supports-image
                                aria-hidden="true"
                            />
                        ))
                    }
                </div>

                <div class="flex flex-col gap-6">
                    <div>
                        {
                            cards.map((card, i) => (
                                <div
                                    class="m-0 flex flex-col gap-3 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]"
                                    style={
                                        i === 0
                                            ? "display: flex;"
                                            : "display: none;"
                                    }
                                    hidden={i !== 0}
                                    data-sp-supports-body
                                    set:html={card.body}
                                />
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style is:global>
    [data-sp-supports-heading][hidden],
    [data-sp-supports-body][hidden],
    [data-sp-supports-icon][hidden],
    [data-sp-supports-image][hidden] {
        display: none !important;
    }
</style>

<script is:inline>
    /* Card -> detail overlay, with the chevrons walking the eight without closing. */
    (function () {
        var overlay = document.getElementById("sp-supports-overlay");
        if (!overlay) return;

        var panel = overlay.querySelector("[data-sp-supports-panel]");
        var closeBtn = overlay.querySelector("[data-sp-supports-close]");
        var prevBtn = overlay.querySelector("[data-sp-supports-prev]");
        var nextBtn = overlay.querySelector("[data-sp-supports-next]");
        var headings = overlay.querySelectorAll("[data-sp-supports-heading]");
        var bodies = overlay.querySelectorAll("[data-sp-supports-body]");
        var icons = overlay.querySelectorAll("[data-sp-supports-icon]");
        var images = overlay.querySelectorAll("[data-sp-supports-image]");
        if (!panel || !headings.length || headings.length !== bodies.length)
            return;

        var count = headings.length;
        var current = 0;
        var lastFocused = null;

        function show(index) {
            current = ((index % count) + count) % count;
            for (var i = 0; i < count; i++) {
                headings[i].hidden = i !== current;
                headings[i].style.display = i === current ? "block" : "none";
                bodies[i].hidden = i !== current;
                bodies[i].style.display = i === current ? "flex" : "none";
                if (icons[i]) {
                    icons[i].hidden = i !== current;
                    icons[i].style.display = i === current ? "flex" : "none";
                }
                if (images[i]) {
                    images[i].hidden = i !== current;
                    images[i].style.display = i === current ? "block" : "none";
                }
            }
            panel.scrollTop = 0;
        }

        function open(index, opener) {
            lastFocused = opener || document.activeElement;
            show(index);
            overlay.style.display = "flex";
            overlay.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
            if (closeBtn) closeBtn.focus();
        }

        function close() {
            overlay.style.display = "none";
            overlay.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
            if (lastFocused && lastFocused.focus) lastFocused.focus();
        }

        function isOpen() {
            return overlay.style.display === "flex";
        }

        document.addEventListener("click", function (e) {
            if (!e.target.closest) return;
            var opener = e.target.closest("[data-sp-supports-open]");
            if (!opener) return;
            open(
                parseInt(opener.getAttribute("data-sp-supports-index"), 10) || 0,
                opener,
            );
        });

        if (closeBtn) closeBtn.addEventListener("click", close);
        if (prevBtn)
            prevBtn.addEventListener("click", function () {
                show(current - 1);
            });
        if (nextBtn)
            nextBtn.addEventListener("click", function () {
                show(current + 1);
            });

        overlay.addEventListener("click", function (e) {
            if (e.target === overlay) close();
        });

        document.addEventListener("keydown", function (e) {
            if (!isOpen()) return;

            if (e.key === "Escape") {
                close();
                return;
            }

            if (e.key === "ArrowLeft") {
                show(current - 1);
                return;
            }
            if (e.key === "ArrowRight") {
                show(current + 1);
                return;
            }

            if (e.key !== "Tab") return;
            var focusable = panel.querySelectorAll(
                'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
            );
            if (!focusable.length) return;
            var first = focusable[0];
            var last = focusable[focusable.length - 1];

            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });
    })();
</script>
