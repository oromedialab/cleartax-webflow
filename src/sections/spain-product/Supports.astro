---
/**
 * "What Crea y Crece in Spain Requires, and How ClearTax Delivers It"
 *
 * 2 independent columns of accordion cards:
 * - Left column holds even cards, right column holds odd cards.
 * - Opening a card in one column naturally shifts items below it in that column only,
 *   preventing empty vertical spacing or stretching in the adjacent column.
 * - Cards start closed and only open when clicked.
 * - Opening any card automatically closes any other currently open card.
 * - Plus icon smoothly rotates to an "x" (45deg) when open.
 * - Single outer border (neutral-300) wraps the entire card.
 */
interface SupportCard {
    heading: string;
    body: string[];
    icon: string;
}

const cards: SupportCard[] = [
    {
        heading: "Applicability",
        body: [
            "Applies to Spanish-established entities in domestic B2B transactions. Foreign entities are in scope only if they hold a Spanish permanent establishment. B2C and B2G (which remains under FACe) are excluded.",
        ],
        icon: "/images/spain-product/icon-1.png",
    },
    {
        heading: "Issue and Receive Electronic Invoices",
        body: [
            "Invoices must be issued and received electronically in a structured, machine-processable format for in-scope B2B transactions.",
            "The requirement generally applies when an invoice is required for a business transaction and the recipient is a business or professional established in Spain, subject to the applicable rules and exceptions.",
        ],
        icon: "/images/spain-product/icon-2.png",
    },
    {
        heading: "Acceptable Formats in EN 16931",
        body: [
            "The framework recognises structured invoice messages aligned with the European EN 16931 semantic data model.",
            "The specified syntaxes are: UBL (Universal Business Language), CII (Cross Industry Invoice), EDIFACT invoice messages, and Facturae.",
            "UBL is mandatory for the copia fiel to AEAT. ClearTax converts from your native ERP format, and no restructuring of your data model is required.",
        ],
        icon: "/images/spain-product/icon-3.png",
    },
    {
        heading: "Connect Through the Public Solution or Private Platforms",
        body: [
            "Businesses are permitted to use the public electronic invoicing solution or private invoice exchange platforms.",
            "Private platforms must support the prescribed interoperability requirements, including exchanging invoices and the copia fiel in UBL format to AEAT. Your solution should support your chosen operating model and enable invoices to move between counterparties using the required formats and exchange routes.",
        ],
        icon: "/images/spain-product/icon-4.png",
    },
    {
        heading: "True Copy Obligation (Copia Fiel)",
        body: [
            "A faithful UBL copy of every invoice must reach AEAT simultaneously with delivery to the buyer. This applies regardless of which delivery channel you use. ClearTax automates this dual-path transmission so nothing falls through the gap.",
        ],
        icon: "/images/spain-product/icon-5.png",
    },
    {
        heading: "Report Invoice Lifecycle",
        body: [
            "The Crea y Crece framework requires invoice lifecycle reporting alongside structured invoice exchange. Buyers must report invoice acceptance, rejection, and payment status to AEAT within 4 calendar days (excluding weekends and national public holidays) of receipt. The mandatory statuses communicated to the invoice issuer include:",
            "• Commercial acceptance or rejection of the invoice, with the date.",
            "• Full payment of the invoice, with the effective payment date.",
            "Optional reporting is also allowed for partial payments and acceptances or rejections.",
            "ClearTax tracks every invoice through its full lifecycle and surfaces exceptions before they become audit triggers.",
        ],
        icon: "/images/spain-product/icon-6.png",
    },
    {
        heading: "Meet the Applicable Reporting Timelines",
        body: [
            "For status information exchanged under the private-platform provisions, the prescribed reporting window is a maximum of four natural days, excluding Saturdays, Sundays and national holidays, from the date of the reported event.",
        ],
        icon: "/images/spain-product/icon-7.png",
    },
    {
        heading: "Interoperability",
        body: [
            "Private platforms must interoperate with each other and with the AEAT public solution. Automated retrieval from AEAT is a platform obligation, not a business one. ClearTax is built for it.",
        ],
        icon: "/images/spain-product/icon-8.png",
    },
];

const leftCards = cards
    .map((card, index) => ({ ...card, index }))
    .filter((_, i) => i % 2 === 0);

const rightCards = cards
    .map((card, index) => ({ ...card, index }))
    .filter((_, i) => i % 2 === 1);
---

<section class="bg-generic-00 py-16 lg:py-20">
    <div class="max-w-[var(--container-max)] w-full px-4 md:px-6 mx-auto">
        <div class="flex flex-col items-center w-full mb-6 lg:mb-12 mx-auto">
            <h2 class="m-0 text-center mx-auto font-heading font-medium text-vault-navy text-[length:var(--fs-h1)] leading-[length:var(--lh-h1)] tracking-[-0.5px] max-w-191.5">
                Everything You Need for B2B E-Invoicing
            </h2>
            <p class="m-0 max-auto text-center mt-4 max-w-[683px] font-body font-normal text-neutral-500 text-[length:var(--fs-body)] lg:text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body)] lg:leading-[length:var(--lh-body-lg)]">
                AI powered e-invoicing solutions​ work alongside your ERP,
                covering issuing, exchange, reporting and archiving.
            </p>
        </div>

        {/* 2 independent columns: prevents open card in one column from stretching or pushing items in the other column */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
            {[leftCards, rightCards].map((columnCards) => (
                <div class="flex flex-col gap-6">
                    {columnCards.map((card) => (
                        <div
                            class="group/card flex flex-col rounded-xl border border-neutral-300 bg-generic-00 overflow-hidden"
                            data-au-glance-card={card.index}
                        >
                            <button
                                type="button"
                                class="group flex w-full cursor-pointer items-center justify-between gap-4 md:gap-6 p-6 text-left transition-all duration-150 ease-in-out bg-generic-00 border-0 outline-none focus:outline-none focus:ring-0"
                                data-au-glance-toggle={card.index}
                                aria-expanded="false"
                            >
                                <img
                                    src={card.icon}
                                    alt=""
                                    width="56"
                                    height="56"
                                    class="block h-14 w-14 shrink-0 rounded-lg object-contain"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <span class="min-w-0 flex-1 font-heading font-medium text-vault-navy text-[length:var(--fs-h6)] leading-[length:var(--lh-h6)]">
                                    {card.heading}
                                </span>
                                <svg
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    class="shrink-0 text-vault-navy transition-transform duration-200 ease-in-out"
                                    aria-hidden="true"
                                    focusable="false"
                                    data-au-glance-icon={card.index}
                                    style="transform: rotate(0deg);"
                                >
                                    <path
                                        d="M12 5V19"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                    <path
                                        d="M5 12H19"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </button>
                            <div
                                class="grid overflow-hidden transition-[grid-template-rows,opacity] duration-300 ease-out border-0"
                                style="grid-template-rows: 0fr; opacity: 0;"
                                data-au-glance-content={card.index}
                                data-open="false"
                            >
                                <div class="overflow-hidden border-0">
                                    <div class="px-6 pb-6 pt-1 flex flex-col gap-2">
                                        {card.body.map((text) => (
                                            <p class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                                                {text}
                                            </p>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            ))}
        </div>
    </div>
</section>

<script is:inline>
    (function () {
        function openCard(index) {
            var openContents = document.querySelectorAll(
                '[data-au-glance-content][data-open="true"]',
            );
            for (var i = 0; i < openContents.length; i++) {
                var idx = openContents[i].getAttribute(
                    "data-au-glance-content",
                );
                if (idx !== String(index)) {
                    closeCard(idx);
                }
            }

            var content = document.querySelector(
                '[data-au-glance-content="' + index + '"]',
            );
            var btn = document.querySelector(
                '[data-au-glance-toggle="' + index + '"]',
            );
            var icon = document.querySelector(
                '[data-au-glance-icon="' + index + '"]',
            );
            if (!content || !btn) return;

            content.style.gridTemplateRows = "1fr";
            content.style.opacity = "1";
            content.setAttribute("data-open", "true");
            btn.setAttribute("aria-expanded", "true");
            btn.classList.add("pb-3");
            if (icon) icon.style.transform = "rotate(45deg)";
        }

        function closeCard(index) {
            var content = document.querySelector(
                '[data-au-glance-content="' + index + '"]',
            );
            var btn = document.querySelector(
                '[data-au-glance-toggle="' + index + '"]',
            );
            var icon = document.querySelector(
                '[data-au-glance-icon="' + index + '"]',
            );
            if (!content || !btn) return;

            content.style.gridTemplateRows = "0fr";
            content.style.opacity = "0";
            content.setAttribute("data-open", "false");
            btn.setAttribute("aria-expanded", "false");
            btn.classList.remove("pb-3");
            if (icon) icon.style.transform = "rotate(0deg)";
        }

        function toggle(index) {
            var content = document.querySelector(
                '[data-au-glance-content="' + index + '"]',
            );
            if (!content) return;

            var isOpen = content.getAttribute("data-open") === "true";

            if (isOpen) {
                closeCard(index);
            } else {
                openCard(index);
            }
        }

        document.addEventListener("click", function (e) {
            if (!e.target.closest) return;
            var toggleBtn = e.target.closest("[data-au-glance-toggle]");
            if (!toggleBtn) return;
            var index = toggleBtn.getAttribute("data-au-glance-toggle");
            toggle(index);
        });
    })();
</script>
