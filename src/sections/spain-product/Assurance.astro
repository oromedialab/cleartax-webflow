---
<section id="assusrance" class="bg-[#FFFFFF] py-12 lg:py-25 w-full">
    <div class="lg:container mx-auto px-4 lg:px-6">
        
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-12">
            <div class=" w-full lg:max-w-158">
       
        <div class='w-full max-w-158'>
        <h2
          class="m-0 text-[26px] sm:text-[32px] lg:text-[44px] font-semibold leading-[1.18] text-black"
        >
          Beyond Compliance, ClearTax <span class="text-black">VAT Assurance <span
            class="text-[#655DFF]"
            >Finds Gaps Before AEAT Does</span
          >
        </h2>
        <p class=" max-w-158 text-base lg:text-lg mt-4 text-black/80">
          Filing on time is the floor. Knowing your VAT position is accurate is
          the ceiling.
        </p>
      </div>
    </div>
    
    <div class="max-w-102 justify-end">
        <ul class="mt-4 max-lg:md:mt-0 lg:mt-0 flex flex-col gap-2 list-none p-0 m-0">
          {[
            "Invoice data mismatches across counterparties",
            "Purchase ledger gaps against SII records",
            "Missing acceptance, rejection, or payment status",
            "Audit exposure from unresolved VAT discrepancies"
          ].map((text) => (
            <li class="flex gap-3 md:gap-4 items-start">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M6.15999 7.44048C5.83999 7.12048 5.35999 7.12048 5.03999 7.44048C4.71999 7.76048 4.71999 8.24048 5.03999 8.56048L7.43999 10.9605C7.59999 11.1205 7.75999 11.2005 7.99999 11.2005C8.23999 11.2005 8.39999 11.1205 8.55999 10.9605L14.16 4.56048C14.4 4.16048 14.4 3.68048 14 3.44048C13.68 3.20048 13.2 3.20048 12.96 3.52048L7.99999 9.20048L6.15999 7.44048Z" fill="#F92B2E"/>
<path d="M15.2 7.20049C14.72 7.20049 14.4 7.52049 14.4 8.00049C14.4 11.5205 11.52 14.4005 8 14.4005C4.48 14.4005 1.6 11.5205 1.6 8.00049C1.6 6.32049 2.24 4.72049 3.44 3.52049C4.64 2.24049 6.24 1.60049 8 1.60049C8.48 1.60049 9.04 1.68049 9.52 1.76049C9.92 1.92049 10.4 1.68049 10.56 1.20049C10.72 0.720488 10.4 0.400488 10 0.240488H9.92C9.28 0.0804882 8.64 0.000488281 8 0.000488281C3.6 0.000488281 0 3.60049 0 8.08049C0 10.1605 0.88 12.2405 2.32 13.6805C3.84 15.2005 5.84 16.0005 7.92 16.0005C12.32 16.0005 15.92 12.4005 15.92 8.00049C16 7.52049 15.6 7.20049 15.2 7.20049Z" fill="#F92B2E"/>
</svg>

              <p class="text-base lg:text-lg text-black leading-[1.44] opacity-80 my-auto">
                {text}
              </p>
            </li>
          ))}
        </ul>
      </div>
        </div>

    <!-- Bottom Accordion Section -->
    <div class="grid grid-cols-1 gap-4 lg:flex lg:flex-row lg:gap-4 w-full lg:h-[320px]" id="assurance-accordion">
      {assuranceCards.map((card, idx) => (
        <div 
          data-id={card.id}
          class={`assurance-card group relative flex flex-col justify-between overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.4,0,0.2,1)] rounded-[20px] ${card.bg} max-lg:w-full max-lg:p-6
            ${idx === 0 ? 'flex-1 p-6 lg:p-7 cursor-default' : 'w-[80px] shrink-0 p-3 hover:brightness-95 cursor-pointer lg:cursor-pointer'}`}
        >
          <!-- Top Row (Icon + Link) -->
          <div class="flex flex-row items-center md:items-start justify-between w-full">
            <div class="shrink-0 flex items-center border-white border shadow-sm rounded-[14px] justify-center transition-all duration-500" set:html={card.iconCode}>
            </div>
            
            <div class={`link-wrapper overflow-hidden transition-all duration-500 flex justify-end shrink-0 max-lg:w-32 max-lg:opacity-100
                ${idx === 0 ? 'opacity-100 w-32' : 'opacity-0 w-0'}`}>
              <a href="#contact-form" class={`contact-trigger ${card.text} font-semibold text-sm lg:text-base flex items-center hover:opacity-80 whitespace-nowrap`}>
                <span class="underline decoration-current decoration-1 underline-offset-4">Book A Demo</span> <span class="text-base inline-block ml-1">↗</span>
              </a>
            </div>
          </div>

          <!-- Bottom Content -->
          <div class={`text-wrapper flex flex-col justify-end transition-all max-lg:opacity-100 max-lg:pointer-events-auto max-lg:mt-6 max-lg:translate-y-0
              ${idx === 0 ? 'opacity-100 translate-y-0 duration-500 delay-[400ms] ease-out' : 'opacity-0 translate-y-4 duration-0 pointer-events-none'}`}>
            <div class="w-full lg:min-w-[500px] xl:min-w-[600px]">
              <h3 class={`${card.text} text-xl lg:text-[22px] font-medium mb-2 lg:mb-3 whitespace-nowrap`}>{card.title}</h3>
              <p class="text-[#000000]/80 text-lg leading-relaxed font-normal pr-4 lg:pr-8">
                {card.desc}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
</section>

<script is:inline>
  (function () {
    let assuranceInitialized = false;

    function initAssurance() {
      if (assuranceInitialized) return;
      assuranceInitialized = true;

      // Cleanup listeners
      assuranceEvents.forEach(function (event) {
        window.removeEventListener(event, initAssurance, { passive: true });
      });

      const run = () => {
        const cardsArray = Array.from(document.querySelectorAll('.assurance-card'));
        let autoplayTimer;
        let currentIndex = 0;

        function activateCard(card) {
          if (window.innerWidth < 1024) return;
          if (card.classList.contains('flex-1')) return;

          cardsArray.forEach(c => {
            c.classList.remove('flex-1', 'p-6', 'lg:p-7', 'cursor-default');
            c.classList.add('w-[80px]', 'shrink-0', 'p-3', 'hover:brightness-95', 'cursor-pointer');

            const link = c.querySelector('.link-wrapper');
            link?.classList.remove('opacity-100', 'w-32');
            link?.classList.add('opacity-0', 'w-0');

            const text = c.querySelector('.text-wrapper');
            text?.classList.remove('opacity-100', 'translate-y-0', 'duration-500', 'delay-[400ms]', 'ease-out', 'duration-300', 'delay-500', 'delay-100');
            text?.classList.add('opacity-0', 'translate-y-4', 'duration-0', 'pointer-events-none');
          });

          card.classList.remove('w-[80px]', 'shrink-0', 'p-3', 'hover:brightness-95', 'cursor-pointer');
          card.classList.add('flex-1', 'p-6', 'lg:p-7', 'cursor-default');

          const link = card.querySelector('.link-wrapper');
          link?.classList.remove('opacity-0', 'w-0');
          link?.classList.add('opacity-100', 'w-32');

          const text = card.querySelector('.text-wrapper');
          text?.classList.remove('opacity-0', 'translate-y-4', 'duration-0', 'pointer-events-none');
          text?.classList.add('opacity-100', 'translate-y-0', 'duration-500', 'delay-[400ms]', 'ease-out');
        }

        cardsArray.forEach((card, idx) => {
          card.addEventListener('click', () => {
            currentIndex = idx;
            activateCard(card);
          });
        });

        const startAutoplay = () => {
          if (autoplayTimer) clearInterval(autoplayTimer);
          autoplayTimer = setInterval(() => {
            if (window.innerWidth < 1024) return;
            currentIndex = (currentIndex + 1) % cardsArray.length;
            activateCard(cardsArray[currentIndex]);
          }, 5000);
        };

        const stopAutoplay = () => {
          if (autoplayTimer) clearInterval(autoplayTimer);
        };

        const accordion = document.getElementById('assurance-accordion');
        if (accordion) {
          accordion.addEventListener('mouseenter', stopAutoplay);
          accordion.addEventListener('mouseleave', startAutoplay);
          accordion.addEventListener('touchstart', stopAutoplay, { passive: true });
        }

        startAutoplay();

        const contactTriggers = document.querySelectorAll(".contact-trigger");
        contactTriggers.forEach((trigger) => {
          trigger.addEventListener("click", (e) => {
            e.preventDefault();
            const targetId = trigger.getAttribute("href")?.replace("#", "");
            if (targetId) {
              const contactSection = document.getElementById(targetId);
              if (contactSection) {
                contactSection.scrollIntoView({ behavior: "smooth" });
              }
            }
          });
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", run);
      } else {
        run();
      }
    }

    const assuranceEvents = ["mousemove", "mouseenter", "mouseover", "touchstart", "scroll", "keydown"];
    assuranceEvents.forEach(function (event) {
      window.addEventListener(event, initAssurance, { passive: true });
    });
  })();
</script>
