---

<section class="py-20 lg:py-25 bg-[#F3F1F9]">
    <div class="lg:container mx-auto px-4 md:px-6">
        <div class="text-center mb-12">
            <h2
                class="text-[26px] md:text-[36px] lg:text-[44px] max-w-189 mx-auto font-semibold text-[#000000] leading-[1.18] m-0"
            >
                100+ Clients In The EU.
                <span class="block text-[#655DFF]"
                    >5,000+ Enterprises Worldwide.</span
                >
            </h2>
            <p
                class="text-base md:text-[18px] text-[#000000]/80 mt-4 max-w-170 mx-auto leading-[1.5]"
            >
                From global conglomerates to EU-headquartered enterprises,
                finance teams trust ClearTax to keep them compliant — across
                every mandate, in every market.
            </p>
        </div>

        <!-- Row 1: 4 Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 mb-3">
            {
                items.slice(0, 4).map((item) => (
                    <div class="group relative overflow-hidden bg-[#E7E2F3] h-[180px] rounded-[16px] flex flex-col justify-center items-center transition-all duration-300">
                        <!-- Background Images (opacity 0, reveals on hover) -->
                        <div class="absolute inset-0 z-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            {item.bgImgs?.topLeft?.src && (
                                <img
                                    src={item.bgImgs.topLeft.src}
                                    width={item.bgImgs.topLeft.width}
                                    height={item.bgImgs.topLeft.height}
                                    class="absolute top-0 left-0 pointer-events-none"
                                    alt=""
                                />
                            )}
                            {item.bgImgs?.topRight?.src && (
                                <img
                                    src={item.bgImgs.topRight.src}
                                    width={item.bgImgs.topRight.width}
                                    height={item.bgImgs.topRight.height}
                                    class="absolute top-0 right-0 pointer-events-none"
                                    alt=""
                                />
                            )}
                            {item.bgImgs?.bottomLeft?.src && (
                                <img
                                    src={item.bgImgs.bottomLeft.src}
                                    width={item.bgImgs.bottomLeft.width}
                                    height={item.bgImgs.bottomLeft.height}
                                    class="absolute bottom-0 left-0 pointer-events-none"
                                    alt=""
                                />
                            )}
                            {item.bgImgs?.bottomRight?.src && (
                                <img
                                    src={item.bgImgs.bottomRight.src}
                                    width={item.bgImgs.bottomRight.width}
                                    height={item.bgImgs.bottomRight.height}
                                    class="absolute bottom-0 right-0 pointer-events-none"
                                    alt=""
                                />
                            )}
                        </div>

                        <!-- Card Content Wrapper -->
                        <div class="relative z-10 w-full h-full flex flex-col items-center justify-center gap-3">
                            <!-- Logo container -->
                            <div class="max-w-19 max-h-19 md:max-w-27 md:max-h-27 flex justify-center items-center transition-transform duration-300 group-hover:scale-[1.05]">
                                <img
                                    src={item.img}
                                    alt={item.title}
                                    class="object-contain w-full h-full"
                                />
                            </div>

                            <!-- Text Title -->
                            <div class="text-center px-2 pointer-events-none">
                                <h3 class="text-base font-normal text-black leading-[1.44] m-0">
                                    {item.title}
                                </h3>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Row 2: 3 Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 w-full">
            {
                items.slice(4).map((item, index) => (
                    <div class="group relative overflow-hidden bg-[#E7E2F3] h-[180px] rounded-[16px] flex flex-col justify-center items-center px-4 transition-all duration-300">
                        <!-- Background Images (opacity 0, reveals on hover) -->
                        <div class="absolute inset-0 z-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            {item.bgImgs?.topLeft?.src && (
                                <img
                                    src={item.bgImgs.topLeft.src}
                                    width={item.bgImgs.topLeft.width}
                                    height={item.bgImgs.topLeft.height}
                                    class="absolute top-0 left-0 pointer-events-none"
                                    alt=""
                                />
                            )}
                            {item.bgImgs?.topRight?.src && (
                                <img
                                    src={item.bgImgs.topRight.src}
                                    width={item.bgImgs.topRight.width}
                                    height={item.bgImgs.topRight.height}
                                    class="absolute top-0 right-0 pointer-events-none"
                                    alt=""
                                />
                            )}
                            {item.bgImgs?.bottomLeft?.src && (
                                <img
                                    src={item.bgImgs.bottomLeft.src}
                                    width={item.bgImgs.bottomLeft.width}
                                    height={item.bgImgs.bottomLeft.height}
                                    class="absolute bottom-0 left-0 pointer-events-none"
                                    alt=""
                                />
                            )}
                            {item.bgImgs?.bottomRight?.src && (
                                <img
                                    src={item.bgImgs.bottomRight.src}
                                    width={item.bgImgs.bottomRight.width}
                                    height={item.bgImgs.bottomRight.height}
                                    class="absolute bottom-0 right-0 pointer-events-none"
                                    alt=""
                                />
                            )}
                        </div>

                        <!-- Card Content Wrapper -->
                        <div class="relative z-10 w-full h-full flex flex-col items-center justify-center gap-3">
                            <!-- Logo container -->
                            <div class={`flex justify-center items-center transition-transform duration-300 group-hover:scale-[1.05] ${index === 2 ? 'max-w-36 max-h-19 md:max-w-38 md:max-h-27 w-full' : 'max-w-19 max-h-19 md:max-w-27 md:max-h-27'}`}>
                                <img
                                    src={item.img}
                                    alt={item.title}
                                    class="object-contain w-full h-full"
                                />
                            </div>

                            <!-- Text Title -->
                            <div class="text-center px-2 pointer-events-none">
                                <h3 class="text-base font-normal text-black leading-[1.44] m-0">
                                    {item.title}
                                </h3>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
