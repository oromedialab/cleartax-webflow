        bgImgs: {
            topLeft: { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a74761ce79c2d020c653679_bgsvg-1-1.png", width: 51, height: 51 },
            bottomLeft: { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7476222063d4a78b334bc6_bgsvg-1-2.png", width: 49, height: 37 },
            bottomRight: { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7476296abe67d8b33a1ea6_bgsvg-1-3.png", width: 40, height: 45 }
        }
    },
    {
        title: "SOC 2 Type II",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a3a45006078291fafc211bc_logo-4.png",
        bgImgs: {
            bottomLeft: { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a747631877b7eb35bd1b768_bgsvg-2-1.png", width: 29, height: 33 },
            topRight: { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a747639dc18d86eaa531eaf_bgsvg-2-2.png", width: 33, height: 49 },
