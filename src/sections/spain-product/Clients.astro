    },
    {
        title: "Peppol Access Point",
        img: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a3a44f0e2e7d26264cc5505_logo-2.png",
        bgImgs: {
            bottomLeft: { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a747678414f8af61ee42d76_bgsvg-6-1.png", width: 48, height: 68 },
            bottomRight: { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a74767fa9b02f5de8386afa_bgsvg-6-2.png", width: 68, height: 72 }
