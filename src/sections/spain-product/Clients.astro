        bgImgs: {
            topLeft: { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a7476858c077f8fd5b53921_bgsvg-7-1.png", width: 38, height: 46 },
            bottomRight: { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a747690f2afa7efc1d803d1_bgsvg-7-2.png", width: 47, height: 58 }
