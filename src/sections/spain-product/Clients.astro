        bgImgs: {
            bottomLeft: { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a74764af7f4af0f3fd235bc_bgsvg-3-1.png", width: 55, height: 50 },
            topRight: { src: "https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6a747650546784c4b6831efd_bgsvg-3-2.png", width: 40, height: 54 }
