---
/**
 * "France e-invoicing resource centre" — Figma node 13600:29596.
 *
 * Six cards in a 3-column grid. Each is a category chip, an optional "New" chip,
 * a title and a one-line summary, and the whole card is the link.
 *
 * PLACEHOLDER CONTENT: the Figma repeats one card six times. The titles, links
 * and categories below are that placeholder verbatim — they come from the
 * resource CMS in Webflow, so replace `resources` with the real six before the
 * page ships.
 */
interface Resource {
    category: string;
    badge?: "Popular" | "New";
    title: string;
    desc: string;
    href: string;
}

const resources: Resource[] = Array(6).fill({
    category: "Case study",
    badge: "New",
    title: "Spain VAT Code for E-Invoicing: Key Rules, Requirements & Compliance…",
    desc: "A practical framework to get ahead of the mandate",
    href: "#",
});
---

<section class="bg-generic-00 py-16 lg:py-20">
    <div class="max-w-[var(--container-max)] w-full px-4 md:px-6 mx-auto">
        <h2
            class="m-0 mb-8 text-center font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] md:text-[length:var(--fs-h1)] leading-[length:var(--lh-h2)] md:leading-[length:var(--lh-h1)] tracking-[-0.5px] lg:mb-12"
        >
            Spain e-invoicing resource centre
        </h2>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
                resources.map((r) => (
                    <a
                        href={r.href}
                        class="flex flex-col gap-4 rounded-2xl border border-neutral-300 bg-generic-00 p-6 no-underline transition-all duration-200 ease-in-out hover:border-nova-blue"
                    >
                        <div class="flex items-start justify-between gap-3 min-h-[26px]">
                            <span class="inline-flex items-center justify-center rounded-[8px] bg-neutral-100 px-3 py-1.5 font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-neutral-700">
                                {r.category}
                            </span>
                            {r.badge === "Popular" && (
                                <span class="inline-flex items-center justify-center rounded-[8px] bg-flux-lime px-3 py-1.5 font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-vault-navy">
                                    Popular
                                </span>
                            )}
                            {r.badge === "New" && (
                                <span class="inline-flex items-center justify-center rounded-[8px] bg-nova-blue px-3 py-1.5 font-body text-[length:var(--fs-label)] leading-[length:var(--lh-label)] font-medium text-generic-00">
                                    New
                                </span>
                            )}
                        </div>

                        <div class="flex flex-col gap-2.5">
                            <h3 class="m-0 font-body font-semibold text-vault-navy text-[length:var(--fs-body-lg)] leading-[length:var(--lh-body-lg)]">
                                {r.title}
                            </h3>
                            <p class="m-0 font-body font-normal text-neutral-500 text-[length:var(--fs-body)] leading-[length:var(--lh-body)]">
                                {r.desc}
                            </p>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</section>
