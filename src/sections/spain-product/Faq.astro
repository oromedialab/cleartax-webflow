const items: FaqItem[] = [
    {
        q: "Is e-invoicing mandatory in Australia?",
        a: [
            {
                kind: "p",
                html: "Not for businesses. Non-corporate Commonwealth entities  must be able to receive e-invoices, and e-invoicing is becoming the default in Commonwealth procurement, so agencies may ask suppliers to switch in new or renewed contracts. B2B e-invoicing is voluntary.",
            },
        ],
    },
    {
        q: "What is Peppol and who runs it in Australia?",
        a: [
            {
                kind: "p",
                html: "Peppol is an international network for exchanging e-invoices between businesses' systems. In Australia, the ATO is the Peppol Authority: it sets the rules and accredits Access Points, but it doesn't receive or see your invoices.",
            },
        ],
    },
    {
        q: "What format do Australian e-invoices use?",
        a: [
            {
                kind: "p",
                html: "PINT A-NZ. It replaced the earlier A-NZ Peppol BIS Billing 3.0 specification and has been the only supported format since 15 May 2025.",
            },
        ],
    },
    {
        q: "Is an e-invoice a valid tax invoice?",
        a: [
            {
                kind: "p",
                html: "Yes, if it follows the PINT A-NZ specification and includes all the information a GST tax invoice requires. It doesn't need to say 'tax invoice.'",
            },
        ],
    },
    {
        q: "How fast do government agencies pay e-invoices?",
        a: [
            {
                kind: "p",
                html: "Under the policy in force until 31 December 2026, non-corporate Commonwealth entities must pay eligible Peppol e-invoices within 5 calendar days after satisfactory delivery is acknowledged and a correctly rendered invoice is received, regardless of contract value, subject to policy exclusions.",
            },
        ],
    },
    {
        q: "How do I start e-invoicing?",
        a: [
            {
                kind: "p",
                html: "Choose an ATO-accredited Peppol Access Point, register your ABN as your Peppol ID, connect your ERP or accounting software, and tell your customers and suppliers you're ready to exchange e-invoices.",
            },
        ],
    },
    {
        q: "How do I choose the right e-invoicing software for Australia?",
        a: [
            {
                kind: "p",
                html: "Look for an ATO-accredited Access Point that supports PINT A-NZ, integrates with your ERP, validates invoices before sending, receives incoming invoices and automates AP. If you operate in countries where e-invoicing is mandatory, one platform for all of them cuts long-term cost.",
            },
        ],
    },
];
