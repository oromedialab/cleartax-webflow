        No articles match those filters yet. Try a broader search.
      </p>

      <button
        type="button"
        data-blog-load-more
        class="rounded-lg border border-nova-blue bg-generic-00 px-5 py-3.5 font-body font-medium text-nova-blue text-[length:var(--fs-label-lg)] leading-[var(--lh-label-lg)] shadow-[0px_2px_6px_0px_rgba(16,24,40,0.06)] cursor-pointer transition-colors duration-150 hover:bg-nova-blue hover:text-ledger-white"
      >
        Load more
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-blog-articles]');
    if (!root) return;

    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-blog-card]'));
    var moreBtn = root.querySelector('[data-blog-load-more]');
    var empty = root.querySelector('[data-blog-empty]');

    var PAGE_SIZE = 9;
    var shown = PAGE_SIZE;

    // Visibility is toggled inline, not with a class: the utilities pasted into
    // Webflow are unlayered, so a `.hidden` class would have to out-order
    // `.flex` on the same element. An inline style always wins.
    function setVisible(el, visible) {
      if (!el) return;
      el.style.display = visible ? '' : 'none';
    }

    function readFilters() {
      var form = document.querySelector('[data-blog-filter]');
      if (!form) return { q: '', topic: '', country: '' };
      var search = form.querySelector('[data-blog-search]');
      var topic = form.querySelector('[data-blog-topic]');
      var country = form.querySelector('[data-blog-country]');
      return {
        q: search ? search.value.trim().toLowerCase() : '',
        topic: topic ? topic.value : '',
        country: country ? country.value : '',
      };
    }

    function matches(card, f) {
      if (f.topic && card.getAttribute('data-topic') !== f.topic) return false;
      if (f.country && card.getAttribute('data-country') !== f.country) return false;
      if (f.q && (card.getAttribute('data-search') || '').indexOf(f.q) === -1) return false;
      return true;
    }

    function render() {
      var f = readFilters();
      var hits = [];

      cards.forEach(function (card) {
        if (matches(card, f)) hits.push(card);
        setVisible(card, false);
      });

      hits.slice(0, shown).forEach(function (card) {
        setVisible(card, true);
      });

      setVisible(empty, hits.length === 0);
      setVisible(moreBtn, hits.length > shown);
    }

    function reset() {
      shown = PAGE_SIZE;
      render();
    }

    // Delegated on `document` so the filter bar can live in a different Webflow
    // Embed, mount later, or not exist at all.
    document.addEventListener('input', function (e) {
      if (e.target.closest && e.target.closest('[data-blog-filter]')) reset();
    });

    document.addEventListener('change', function (e) {
      if (e.target.closest && e.target.closest('[data-blog-filter]')) reset();
    });

    document.addEventListener('submit', function (e) {
      if (e.target.closest && e.target.closest('[data-blog-filter]')) {
        e.preventDefault();
        reset();
      }
    });

    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('[data-blog-load-more]')) {
        shown += PAGE_SIZE;
        render();
      }
    });

    render();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', render);
    }
  })();
</script>
