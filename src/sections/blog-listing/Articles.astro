  <div class="container">
    <div class="flex flex-col items-center gap-12">
      <div
        class="grid w-full grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3"
        data-blog-grid
      >
        {
          posts.map((post, index) => (
            <a
              href={post.href}
              data-blog-card
              data-topic={post.topic}
              data-country={post.country}
              data-search={`${post.title} ${post.excerpt} ${post.topic} ${post.country}`.toLowerCase()}
