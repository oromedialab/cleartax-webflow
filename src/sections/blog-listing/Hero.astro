---
/**
 * Blog listing hero — Figma node 12289:26897.
 *
 * Type sizes come from the brand tokens rather than literal px, so the mobile
 * step-down in tokens.css (`--fs-h1-lg` 56 → 48 below 768px) applies for free.
 * The top padding clears the fixed navbar from `_shared/NavbarRb.astro`.
 */
const heading = 'Perspectives That Matter';
const subheading = 'Get the latest insights from our experts';
---

<section class="bg-generic-00 border-b border-ledger-200 pt-32 pb-12 md:pt-[200px] md:pb-20">
  <div class="container">
    <div class="flex flex-col items-center gap-4 text-center">
      <h1
        class="font-heading font-semibold text-vault-navy text-[length:var(--fs-h1-lg)] leading-[var(--lh-h1-lg)] tracking-[var(--tracking-heading)] m-0"
      >
        {heading}
      </h1>
      <p
        class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-lg)] leading-[var(--lh-body-lg)] max-w-[505px] m-0"
      >
        {subheading}
      </p>
    </div>
  </div>
</section>
