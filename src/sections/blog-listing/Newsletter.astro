---
/**
 * "Stay ahead of every compliance update" CTA — Figma node 12289:26940.
 *
 * The dotted field is a vanilla port of React Bits' <DotField /> (MIT), grafted
 * onto the canvas grid this section already had. Ported rather than installed:
 * sections compile to standalone HTML pasted into Webflow Embeds, so there is
 * no React runtime on the page and no bundle to import from — see the
 * portability rules in CLAUDE.md.
 *
 * What came across from DotField:
 *   - dots ease toward a target derived from the cursor, never a velocity, so
 *     they cannot overshoot or oscillate;
 *   - a speed-driven `engagement` value, so the field reacts to a moving
 *     pointer and settles under a parked one;
 *   - one diagonal gradient filling every dot in a single path.
 * Its dots bulge *away* from the cursor; these lean *toward* it and fade out as
 * they go, which is the effect this section wants. Its cursor glow, `sparkle`
 * and `waveAmplitude` are not ported — the glow is unwanted here, the other two
 * default to off upstream, and dead code still costs Embed budget.
 *
 * A radial mask clears the middle so the copy sits on plain ground, and
 * top/bottom fades blend the field into the white sections either side.
 *
 * The tunables below are rendered onto the section as `data-*` and read back by
 * the script, rather than being restated inside it — they are this component's
 * props. The hero declares the same values twice — as props and again as a
 * literal `config` — so editing the prop there changes nothing. One source here.
 *
 * IDs are prefixed `blog-cta-` so this can never collide with the hero's
 * `hero-dots-canvas` if both ever land on one Webflow page.
 */
const heading = 'Stay ahead of every compliance update';
const body =
  'Get expert insights, e-invoicing updates, and tax compliance guides delivered to your inbox.';
const ctaLabel = 'Book a demo';
/* Kept as a real href so the CTA still goes somewhere if JS never runs — the
   click handler calls preventDefault and opens the modal instead. */
const ctaHref = 'https://www.cleartax.com/global/book-a-demo';

/* HubSpot demo form. Same portal/form the site's other CTAs use — see
   `_shared/ContactFormRb.astro`. The embed script is NOT loaded on page load:
   it is injected the first time the modal opens, so this Embed stays
   self-contained in Webflow and visitors who never click pay nothing. */
const hubspotPortalId = '245744706';
const hubspotFormId = '5c52d4ba-5345-413a-b3cd-0ccec450aa30';
const hubspotRegion = 'na2';
const modalTitle = 'Book a demo';
const modalBlurb = 'Tell us little about you and we will be in touch.';

/* dotSize + gap = 26px pitch, matching the hero's 4 + 22. The dot itself is a
   touch finer here because this field sits behind body copy, not a headline. */
const dotSize = 3;
const gap = 23;
/* Every dot is filled from one gradient laid corner to corner across the
   canvas, so the field shades Nova Blue → Nova 300 across the section. */
const gradientFrom = 'rgba(84, 70, 255, 0.55)'; /* --palette-nova-blue */
const gradientTo = 'rgba(156, 163, 255, 0.35)'; /* --palette-nova-300 */
/* How far the cursor's pull reaches, in px. Wide and soft — the whole
   neighbourhood leans in, rather than a tight ring snapping around. */
const cursorRadius = 320;
/* Peak displacement toward the cursor, in px. Kept under one grid pitch (26px),
   so the dots lean without ever crowding into their neighbours' places. */
const pull = 18;
/* Radius of the hole the cursor clears, in px — smaller than `cursorRadius`, so
   dots start leaning in well before they start fading out. Falloff is a
   smoothstep: gone under the pointer, untouched at the rim. */
const fadeRadius = 120;
---

<section
  id="blog-cta"
  class="relative flex min-h-[400px] items-center overflow-hidden bg-generic-00 py-16 md:py-20"
  data-dot-size={String(dotSize)}
  data-gap={String(gap)}
  data-gradient-from={gradientFrom}
  data-gradient-to={gradientTo}
  data-cursor-radius={String(cursorRadius)}
  data-pull={String(pull)}
  data-fade-radius={String(fadeRadius)}
>
  <!-- Interactive dot grid -->
  <div class="pointer-events-none absolute inset-0 z-0 h-full w-full">
    <canvas id="blog-cta-dots-canvas" class="absolute inset-0 h-full w-full"></canvas>
  </div>

  <!-- Radial clearing so the dots never run under the copy -->
  <div
    class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_rgba(255,255,255,1)_25%,_rgba(255,255,255,0.7)_40%,_rgba(255,255,255,0)_65%)]"
  >
  </div>

  <!-- Edge fades into the white sections above and below -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-0 h-20 bg-gradient-to-b from-generic-00 to-transparent"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-20 bg-gradient-to-t from-generic-00 to-transparent"
  >
  </div>

  <div class="container relative z-10">
    <div class="mx-auto flex max-w-[764px] flex-col items-center gap-6 text-center">
      <div class="flex flex-col items-center gap-4">
        <h2
          class="font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[var(--lh-h2)] tracking-[var(--tracking-body)] m-0"
        >
          {heading}
        </h2>
        <p
          class="font-body font-medium text-vault-navy/60 text-[length:var(--fs-body-lg)] leading-[var(--lh-body-lg)] m-0"
        >
          {body}
        </p>
      </div>

      <a
        href={ctaHref}
        data-demo-open
        class="inline-flex w-full max-w-[240px] cursor-pointer items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 font-body font-medium text-ledger-white text-[length:var(--fs-label-lg)] leading-[var(--lh-label-lg)] no-underline shadow-[0px_2px_3px_0px_rgba(16,24,40,0.06)] transition-colors duration-150 hover:bg-nova-600 hover:border-nova-600"
      >
        {ctaLabel}
      </a>
    </div>
  </div>

  <!-- Demo modal. `fixed`, so the section's overflow-hidden does not clip it. -->
  <div
    data-demo-modal
    id="contactForm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="blog-cta-demo-title"
    aria-hidden="true"
    class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
  >
    <div
      class="relative max-h-[90vh] w-full max-w-[560px] overflow-y-auto rounded-xl bg-generic-00 p-6 shadow-[0_24px_64px_rgba(5,2,42,0.24)] md:p-8"
    >
      <button
        type="button"
        data-demo-close
        aria-label="Close"
        class="absolute right-4 top-4 inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent text-neutral-500 transition-colors duration-150 hover:bg-ledger-100 hover:text-vault-navy"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 14 14"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M13 1L1 13M1 1L13 13"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      <h3
        id="blog-cta-demo-title"
        class="font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[var(--lh-h5)] tracking-[var(--tracking-heading)] m-0 pr-10"
      >
        {modalTitle}
      </h3>
      <p
        class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)] m-0 mt-2"
      >
        {modalBlurb}
      </p>

      <!-- HubSpot mounts here on first open -->
      <div
        id="blog-cta-hs-form"
        class="blog-cta-hs-form mt-6"
        data-portal-id={hubspotPortalId}
        data-form-id={hubspotFormId}
        data-region={hubspotRegion}
      >
        <p
          data-demo-loading
          class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)] m-0"
        >
          Loading form…
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.getElementById('blog-cta');
    if (!section) return;
    var canvas = document.getElementById('blog-cta-dots-canvas');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');

    function num(name, fallback) {
      var v = parseFloat(section.getAttribute(name));
      return isNaN(v) ? fallback : v;
    }

    var config = {
      dotSize: num('data-dot-size', 3),
      gap: num('data-gap', 23),
      gradientFrom: section.getAttribute('data-gradient-from') || 'rgba(84, 70, 255, 0.55)',
      gradientTo: section.getAttribute('data-gradient-to') || 'rgba(156, 163, 255, 0.35)',
      cursorRadius: num('data-cursor-radius', 320),
      pull: num('data-pull', 40),
      fadeRadius: num('data-fade-radius', 120),
      fadeSpeed: 12, // how fast a dot eases to its target opacity
      // Slower than the fade on purpose: the dots lag the cursor slightly, and
      // that lag is what reads as following rather than as the grid snapping.
      followSpeed: 7,
      engageSpeed: 4, // how fast the field wakes to a moving cursor and settles
    };

    var width = 0;
    var height = 0;
    var dots = [];
    var mouse = { x: -9999, y: -9999, prevX: -9999, prevY: -9999 };
    var hover = false;
    var speed = 0; // smoothed cursor travel, px per frame
    var engagement = 0; // 0–1, how awake the field is
    var dotFill = null; // one gradient shared by every dot — rebuilt on resize

    function initGrid() {
      var parent = canvas.parentElement;
      width = parent.offsetWidth;
      height = parent.offsetHeight;
      if (!width || !height) return;

      var dpr = window.devicePixelRatio || 1;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      // setTransform, not scale: scale() multiplies the existing matrix, so
      // every resize would compound the DPR and shrink the grid.
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Corner to corner, so the shading follows the section, not the viewport.
      dotFill = ctx.createLinearGradient(0, 0, width, height);
      dotFill.addColorStop(0, config.gradientFrom);
      dotFill.addColorStop(1, config.gradientTo);

      dots = [];
      var spacing = config.dotSize + config.gap;
      var cols = Math.floor(width / spacing);
      var rows = Math.floor(height / spacing);
      var startX = (width - cols * spacing) / 2 + config.dotSize / 2;
      var startY = (height - rows * spacing) / 2 + config.dotSize / 2;

      for (var y = 0; y <= rows; y++) {
        for (var x = 0; x <= cols; x++) {
          var cx = startX + x * spacing;
          var cy = startY + y * spacing;
          // ox/oy is the dot's home in the grid; x/y is where it is right now.
          dots.push({ x: cx, y: cy, ox: cx, oy: cy, alpha: 1 });
        }
      }
    }

    function paint() {
      ctx.clearRect(0, 0, width, height);
      var radius = config.dotSize / 2;
      var tau = Math.PI * 2;
      ctx.fillStyle = dotFill;

      // Two passes. Only the few dozen dots the cursor is touching have an
      // alpha of their own; the rest of the field is untouched and goes down as
      // a single path in one fill. Setting globalAlpha per dot across ~900 dots
      // is what made this stutter.
      ctx.globalAlpha = 1;
      ctx.beginPath();
      for (var i = 0; i < dots.length; i++) {
        var dot = dots[i];
        if (dot.alpha < 0.995) continue;
        ctx.moveTo(dot.x + radius, dot.y); // moveTo, or arcs chain into one blob
        ctx.arc(dot.x, dot.y, radius, 0, tau);
      }
      ctx.fill();

      for (var j = 0; j < dots.length; j++) {
        var fading = dots[j];
        if (fading.alpha >= 0.995 || fading.alpha < 0.01) continue;
        ctx.globalAlpha = fading.alpha;
        ctx.beginPath();
        ctx.arc(fading.x, fading.y, radius, 0, tau);
        ctx.fill();
      }

      ctx.globalAlpha = 1;
    }

    var reduceMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      // Static field. No animation loop, no cursor reaction.
      initGrid();
      paint();
      window.addEventListener('resize', function () {
        initGrid();
        paint();
      });
      return;
    }

    var lastTime = performance.now();

    function draw(time) {
      var dt = (time - lastTime) / 1000;
      if (dt > 0.05) dt = 0.05; // cap so a backgrounded tab can't jolt the grid
      lastTime = time;

      var fadeEase = Math.min(1, config.fadeSpeed * dt);
      var followEase = Math.min(1, config.followSpeed * dt);
      var engageEase = Math.min(1, config.engageSpeed * dt);

      // How fast the cursor is travelling, smoothed. DotField samples this on a
      // 20ms interval; a frame is close enough and needs no second timer.
      var travelX = mouse.x - mouse.prevX;
      var travelY = mouse.y - mouse.prevY;
      mouse.prevX = mouse.x;
      mouse.prevY = mouse.y;
      speed += (Math.sqrt(travelX * travelX + travelY * travelY) - speed) * 0.5;
      if (speed < 0.01) speed = 0;

      engagement += ((hover ? Math.min(speed / 6, 1) : 0) - engagement) * engageEase;
      if (engagement < 0.001) engagement = 0;

      // A parked cursor still holds the field open, it just holds it more
      // gently — the pull ranges over the top 60% as the cursor speeds up.
      // Without the floor the dots would slump home whenever you stopped, which
      // reads as the effect breaking rather than as the field resting.
      var grip = hover ? 0.4 + 0.6 * engagement : 0;

      var crSq = config.cursorRadius * config.cursorRadius;
      var moving = false;

      for (var i = 0; i < dots.length; i++) {
        var dot = dots[i];

        // Measured from the dot's home, not its current position — otherwise a
        // dot that has moved toward the cursor reads as closer, pulls harder,
        // and runs away into the pointer.
        var dx = mouse.x - dot.ox;
        var dy = mouse.y - dot.oy;
        var distSq = dx * dx + dy * dy;

        var targetAlpha = 1;
        var targetX = dot.ox;
        var targetY = dot.oy;

        if (distSq < crSq) {
          var dist = Math.sqrt(distSq);

          if (grip > 0.001) {
            // Squared falloff, zero at the rim, so a dot entering the radius
            // starts from no displacement instead of jumping.
            var t = 1 - dist / config.cursorRadius;
            var push = t * t * config.pull * grip;
            // A dot must never reach the cursor: past it, it would cross to the
            // far side and the field would knot up around the pointer.
            if (push > dist * 0.75) push = dist * 0.75;
            var step = dist > 0.01 ? push / dist : 0;
            targetX += dx * step;
            targetY += dy * step;
          }

          if (dist < config.fadeRadius) {
            // Smoothstep, not a linear ramp: flat at both ends, so the hole has
            // no visible crease at its rim and no hard edge at its centre.
            var ft = dist / config.fadeRadius;
            targetAlpha = ft * ft * (3 - 2 * ft);
          }
        }

        var offX = targetX - dot.x;
        var offY = targetY - dot.y;
        if (offX > 0.05 || offX < -0.05 || offY > 0.05 || offY < -0.05) {
          dot.x += offX * followEase;
          dot.y += offY * followEase;
          moving = true;
        } else if (dot.x !== targetX || dot.y !== targetY) {
          dot.x = targetX;
          dot.y = targetY;
          moving = true;
        }

        var diff = targetAlpha - dot.alpha;
        if (diff > 0.002 || diff < -0.002) {
          dot.alpha += diff * fadeEase;
          moving = true;
        } else if (dot.alpha !== targetAlpha) {
          // Snap the last hundredth rather than easing at it forever, so the
          // field can go fully idle once the cursor is away.
          dot.alpha = targetAlpha;
          moving = true;
        }
      }

      // A settled field is repainted zero times a second, not sixty.
      if (moving) paint();
      requestAnimationFrame(draw);
    }

    window.addEventListener('resize', initGrid);
    initGrid();
    requestAnimationFrame(draw);

    // Scoped to the section, not the window as DotField does: several of these
    // Embeds can share a Webflow page, and a global listener would have each
    // one reacting to a cursor nowhere near it.
    section.addEventListener('mousemove', function (e) {
      var rect = canvas.getBoundingClientRect();
      var nx = e.clientX - rect.left;
      var ny = e.clientY - rect.top;
      if (!hover) {
        // Re-entering: seed prev with the entry point, or the jump from the
        // parked -9999 would register as a colossal cursor speed.
        mouse.prevX = nx;
        mouse.prevY = ny;
      }
      hover = true;
      mouse.x = nx;
      mouse.y = ny;
    });

    section.addEventListener('mouseleave', function () {
      // Parked far outside, so every dot's target is its own home again.
      hover = false;
      speed = 0;
      mouse.x = -9999;
      mouse.y = -9999;
      mouse.prevX = -9999;
      mouse.prevY = -9999;
    });
  })();
</script>

<script is:inline>
  /* Book a demo → HubSpot form in a modal. The embed script is fetched on the
     first open, not on page load. */
  (function () {
    var section = document.getElementById('blog-cta');
    if (!section) return;

    var modal = section.querySelector('[data-demo-modal]');
    var mount = section.querySelector('#blog-cta-hs-form');
    if (!modal || !mount) return;

    var panel = modal.firstElementChild;
    var closeBtn = modal.querySelector('[data-demo-close]');

    var lastFocused = null;
    var scriptRequested = false;
    var formCreated = false;

    function createForm() {
      if (formCreated || !window.hbspt || !window.hbspt.forms) return;
      formCreated = true;

      window.hbspt.forms.create({
        portalId: mount.getAttribute('data-portal-id'),
        formId: mount.getAttribute('data-form-id'),
        region: mount.getAttribute('data-region') || 'na2',
        target: '#blog-cta-hs-form',
        onFormReady: function ($form) {
          var loading = mount.querySelector('[data-demo-loading]');
          if (loading && loading.parentNode) loading.parentNode.removeChild(loading);

          // Carry campaign attribution through, same as the site's other forms.
          var formEl = $form && $form[0] ? $form[0] : $form;
          if (!formEl || !formEl.querySelector) return;
          var params = new URLSearchParams(window.location.search);
          var utms = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
          for (var i = 0; i < utms.length; i++) {
            var value = params.get(utms[i]);
            if (!value) continue;
            var input = formEl.querySelector('input[name="' + utms[i] + '"]');
            if (input) input.value = value;
          }
        },
      });
    }

    function loadHubspot() {
      if (scriptRequested) return;
      scriptRequested = true;

      if (window.hbspt && window.hbspt.forms) {
        createForm();
        return;
      }

      // Reuse the loader if the page already has one (e.g. another form
      // section, or a paste in Webflow's page head) rather than adding a second.
      var loader = document.querySelector('script[src*="hsforms.net"]');
      if (!loader) {
        loader = document.createElement('script');
        loader.src = 'https://js-na2.hsforms.net/forms/embed/v2.js';
        loader.charset = 'utf-8';
        loader.async = true;
        document.head.appendChild(loader);
      }
      loader.addEventListener('load', createForm);

      // Backstop: a cached loader may have fired `load` before we listened.
      var tries = 0;
      var poll = setInterval(function () {
        tries++;
        if (window.hbspt && window.hbspt.forms) {
          clearInterval(poll);
          createForm();
        } else if (tries > 100) {
          clearInterval(poll);
        }
      }, 100);
    }

    // Inline display, not a class swap: the utilities pasted into Webflow are
    // unlayered, so `flex` and `hidden` on one element would race on source
    // order. Inline always wins.
    function openModal(e, opener) {
      if (e) e.preventDefault();
      // The clicked opener, not activeElement: browsers differ on whether a
      // click focuses an anchor, and on close focus has to land somewhere
      // predictable rather than on the document root.
      lastFocused = opener || document.activeElement;
      modal.style.display = 'flex';
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      loadHubspot();
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function isOpen() {
      return modal.style.display === 'flex';
    }

    // Delegated, so it does not matter which Embed mounts first or whether the
    // opener existed when this ran.
    document.addEventListener('click', function (e) {
      if (!e.target.closest) return;
      var opener = e.target.closest('[data-demo-open]');
      if (!opener) return;
      openModal(e, opener);
    });

    // The navbar's "Book a demo" buttons — desktop and mobile — live in
    // `_shared/NavbarRb.astro`, which Global Invoicing also uses, so they can't
    // be changed at the source: there `#contactForm` is a real section and the
    // scroll is correct. Here it resolves to this modal, which is fixed and
    // display:none, so the inline handler is a no-op. Adopt them instead —
    // strip the dead handler and mark them as openers.
    function adoptNavbarCtas() {
      var ctas = document.querySelectorAll('a[onclick*="contactForm"]');
      for (var i = 0; i < ctas.length; i++) {
        ctas[i].removeAttribute('onclick');
        ctas[i].onclick = null;
        ctas[i].setAttribute('data-demo-open', '');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', adoptNavbarCtas);
    } else {
      adoptNavbarCtas();
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', function (e) {
      if (!isOpen()) return;

      if (e.key === 'Escape') {
        closeModal();
        return;
      }

      // Keep Tab inside the dialog — `aria-modal` claims the rest is inert, so
      // focus must not walk out into the page behind it.
      if (e.key !== 'Tab' || !panel) return;
      var focusable = panel.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>

<style is:global>
  /* Styling for HubSpot's injected markup — utilities can't reach a form that
     does not exist at build time. Prefixed `blog-cta-` per the section-CSS
     rule; the shape follows `_shared/ContactFormRb.astro` so both forms on the
     site read the same. */
  .blog-cta-hs-form form {
    display: flex !important;
    flex-direction: column !important;
    gap: 16px !important;
  }
  .blog-cta-hs-form .hs-form-field {
    margin-bottom: 0 !important;
  }
  .blog-cta-hs-form .hs-form-field > label {
    display: block !important;
    font-family: var(--font-body) !important;
    font-size: var(--fs-label) !important;
    font-weight: var(--font-weight-medium) !important;
    color: var(--color-vault-navy) !important;
    margin-bottom: var(--spacing-x-sm) !important;
  }
  .blog-cta-hs-form .hs-form-field > label .hs-form-required {
    color: var(--palette-destructive-500) !important;
    margin-left: 2px !important;
  }
  .blog-cta-hs-form input[type="text"],
  .blog-cta-hs-form input[type="email"],
  .blog-cta-hs-form input[type="tel"],
  .blog-cta-hs-form input[type="number"],
  .blog-cta-hs-form select,
  .blog-cta-hs-form textarea {
    width: 100% !important;
