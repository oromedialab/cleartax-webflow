---
/**
 * "Stay ahead of every compliance update" CTA — Figma node 12289:26940.
 *
 * The field is a plain grid of dots until a pointer enters the section. The
 * strokes are entirely the cursor's doing: length, angle and the cleared hole
 * all scale by `presence`, which is 0 with no pointer over the section, so with
 * nothing to react to the field is exactly a dot grid and completely still. A
 * static field of strokes reads as a texture someone chose; a static field of
 * dots reads as ground for the copy, which is what this section wants.
 *
 * With a pointer, each dot draws out into a stroke that does two things:
 *   - LENGTH GROWS WITH DISTANCE from the focus — still a dot underneath the
 *     pointer, full length out at the edges;
 *   - ANGLE TILTS TOWARD the pointer — every stroke in the field, by the same
 *     fraction, so they all lie along their own line to it. The tilt holds while
 *     the cursor is parked and unwinds when it leaves, so a still pointer keeps
 *     its field.
 * The tilt deliberately has NO distance falloff. Aiming the near strokes while
 * leaving the far ones upright makes the angle change gradually across the grid,
 * and a gradual change in angle is a curve: the field reads as bent streamlines
 * rather than as a straight tilt. Every stroke turns by the same fraction, so
 * the only thing distance controls is length.
 *
 * The turn is interpolated as an ANGLE, not as a blend of two direction vectors.
 * Blending vectors and renormalising sweeps through the angles unevenly — fast
 * at one end, slow at the other — which reads as a bend while it winds up.
 * The focus is the cursor while the pointer is over the section, and the
 * section's own centre otherwise. That resting position is not visible — nothing
 * scales by distance while `presence` is 0 — it is just where the field is
 * already pointed when you arrive, so the strokes draw out from a sensible
 * place instead of from wherever the last visitor left the cursor.
 *
 * NO TWO STROKES MAY EVER TOUCH. That is guaranteed geometrically, not by
 * eyeballing it: each stroke is drawn centred on its grid home, so whatever
 * angle it takes it stays inside a circle of radius `maxLength / 2` — 8px —
 * around that home. Grid pitch is 26px, and `pull`, which does move homes closer
 * together, leaves ~23px between neighbours at worst. 8 + 8 is comfortably under
 * that, at every angle, so the field can never knit itself into a mesh. Raising
 * `maxLength` or `pull` spends that budget.
 *
 * The motion model is a vanilla port of React Bits' <DotField /> (MIT), kept
 * from the dot version of this section: strokes ease toward a target derived
 * from where the cursor is now, never a velocity, so nothing can overshoot or
 * oscillate; a speed-driven `engagement` wakes the field to a moving pointer
 * and settles it under a parked one; one diagonal gradient paints the whole
 * field in a single stroke call. Ported rather than installed — sections compile
 * to standalone HTML pasted into Webflow Embeds, so there is no React runtime on
 * the page and nothing to import from. See the portability rules in CLAUDE.md.
 *
 * A radial mask clears the middle so the copy sits on plain ground, and
 * top/bottom fades blend the field into the white sections either side.
 *
 * The tunables below are rendered onto the section as `data-*` and read back by
 * the script, rather than being restated inside it — they are this component's
 * props. The hero declares the same values twice — as props and again as a
 * literal `config` — so editing the prop there changes nothing. One source here.
 *
 * IDs are prefixed `blog-cta-` so this can never collide with the hero's
 * `hero-dots-canvas` if both ever land on one Webflow page.
 */
const heading = 'Stay ahead of every compliance update';
const body =
  'Get expert insights, e-invoicing updates, and tax compliance guides delivered to your inbox.';
const ctaLabel = 'Book a demo';
/* Kept as a real href so the CTA still goes somewhere if JS never runs — the
   click handler calls preventDefault and opens the modal instead. */
const ctaHref = 'https://www.cleartax.com/global/book-a-demo';

/* HubSpot demo form. Same portal/form the site's other CTAs use — see
   `_shared/ContactFormRb.astro`. The embed script is NOT loaded on page load:
   it is injected the first time the modal opens, so this Embed stays
   self-contained in Webflow and visitors who never click pay nothing. */
const hubspotPortalId = '245744706';
const hubspotFormId = '5c52d4ba-5345-413a-b3cd-0ccec450aa30';
const hubspotRegion = 'na2';
const modalTitle = 'Book a demo';
const modalBlurb = 'Tell us little about you and we will be in touch.';

/* lineWidth + gap = the 26px pitch this section has always used, matching the
   hero's 4 + 22. Stroke ends are round, so a zero-length stroke is a dot. */
const lineWidth = 2;
const gap = 24;
/* Longest a stroke ever gets, in px. Must stay under the 26px pitch — see the
   no-touching guarantee above. */
const maxLength = 10;
/* Distance from the focus at which a stroke reaches `maxLength`. Beyond it,
   strokes stay at full length rather than growing further. */
const lengthRadius = 260;
/* How far a stroke turns from upright toward the pointer. 1 aims it straight at
   the pointer; 0.5 leaves it halfway. Applied to every stroke equally — see the
   note on falloff above. */
const tilt = 1;
/* Ceiling on that turn, in degrees from upright. A stroke way off to one side
   has a near-horizontal line to the pointer, and a whole flank of the section
   lying flat reads as dashed rules rather than as a field. The approach is
   asymptotic, so nothing bands up at exactly this angle and strokes that were
   never near horizontal keep pointing where they were. */
const maxTilt = 45;
/* Every stroke is painted from one gradient laid corner to corner across the
   canvas, so the field shades Nova Blue → Nova 300 across the section. */
const gradientFrom = 'rgba(84, 70, 255, 0.55)'; /* --palette-nova-blue */
const gradientTo = 'rgba(156, 163, 255, 0.35)'; /* --palette-nova-300 */
/* How far the cursor's pull reaches, in px. Wide and soft — the whole
   neighbourhood leans in, rather than a tight ring snapping around. */
const cursorRadius = 320;
/* Peak displacement toward the cursor, in px. Small: it moves the homes the
   no-touching guarantee is measured from, so it eats into that budget. */
const pull = 14;
/* Radius of the hole the focus clears, in px. Strokes are already shrinking to
   dots here; the fade takes them the rest of the way out. */
const fadeRadius = 90;
---

<section
  id="blog-cta"
  class="relative flex min-h-[400px] items-center overflow-hidden bg-generic-00 py-16 md:py-20"
  data-line-width={String(lineWidth)}
  data-gap={String(gap)}
  data-max-length={String(maxLength)}
  data-length-radius={String(lengthRadius)}
  data-tilt={String(tilt)}
  data-max-tilt={String(maxTilt)}
  data-gradient-from={gradientFrom}
  data-gradient-to={gradientTo}
  data-cursor-radius={String(cursorRadius)}
  data-pull={String(pull)}
  data-fade-radius={String(fadeRadius)}
>
  <!-- Interactive dot grid -->
  <div class="pointer-events-none absolute inset-0 z-0 h-full w-full">
    <canvas id="blog-cta-dots-canvas" class="absolute inset-0 h-full w-full"></canvas>
  </div>

  <!-- Radial clearing so the dots never run under the copy -->
  <div
    class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_rgba(255,255,255,1)_25%,_rgba(255,255,255,0.7)_40%,_rgba(255,255,255,0)_65%)]"
  >
  </div>

  <!-- Edge fades into the white sections above and below -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-0 h-20 bg-gradient-to-b from-generic-00 to-transparent"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-20 bg-gradient-to-t from-generic-00 to-transparent"
  >
  </div>

  <div class="container relative z-10">
    <div class="mx-auto flex max-w-[764px] flex-col items-center gap-6 text-center">
      <div class="flex flex-col items-center gap-4">
        <h2
          class="font-heading font-medium text-vault-navy text-[length:var(--fs-h2)] leading-[var(--lh-h2)] tracking-[var(--tracking-body)] m-0"
        >
          {heading}
        </h2>
        <p
          class="font-body font-medium text-vault-navy/60 text-[length:var(--fs-body-lg)] leading-[var(--lh-body-lg)] m-0"
        >
          {body}
        </p>
      </div>

      <a
        href={ctaHref}
        data-demo-open
        class="inline-flex w-full max-w-[240px] cursor-pointer items-center justify-center gap-2 rounded-lg border border-nova-blue bg-nova-blue px-5 py-3.5 font-body font-medium text-ledger-white text-[length:var(--fs-label-lg)] leading-[var(--lh-label-lg)] no-underline shadow-[0px_2px_3px_0px_rgba(16,24,40,0.06)] transition-colors duration-150 hover:bg-nova-600 hover:border-nova-600"
      >
        {ctaLabel}
      </a>
    </div>
  </div>

  <!-- Demo modal. `fixed`, so the section's overflow-hidden does not clip it. -->
  <div
    data-demo-modal
    id="contactForm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="blog-cta-demo-title"
    aria-hidden="true"
    class="fixed inset-0 z-[2000] hidden items-center justify-center bg-generic-100/70 p-4 backdrop-blur-sm"
  >
    <div
      class="relative max-h-[90vh] w-full max-w-[560px] overflow-y-auto rounded-xl bg-generic-00 p-6 shadow-[0_24px_64px_rgba(5,2,42,0.24)] md:p-8"
    >
      <button
        type="button"
        data-demo-close
        aria-label="Close"
        class="absolute right-4 top-4 inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent text-neutral-500 transition-colors duration-150 hover:bg-ledger-100 hover:text-vault-navy"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 14 14"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M13 1L1 13M1 1L13 13"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      <h3
        id="blog-cta-demo-title"
        class="font-heading font-medium text-vault-navy text-[length:var(--fs-h5)] leading-[var(--lh-h5)] tracking-[var(--tracking-heading)] m-0 pr-10"
      >
        {modalTitle}
      </h3>
      <p
        class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)] m-0 mt-2"
      >
        {modalBlurb}
      </p>

      <!-- HubSpot mounts here on first open -->
      <div
        id="blog-cta-hs-form"
        class="blog-cta-hs-form mt-6"
        data-portal-id={hubspotPortalId}
        data-form-id={hubspotFormId}
        data-region={hubspotRegion}
      >
        <p
          data-demo-loading
          class="font-body font-normal text-neutral-500 text-[length:var(--fs-body-sm)] leading-[var(--lh-body-sm)] m-0"
        >
          Loading form…
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.getElementById('blog-cta');
    if (!section) return;
    var canvas = document.getElementById('blog-cta-dots-canvas');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');

    function num(name, fallback) {
      var v = parseFloat(section.getAttribute(name));
      return isNaN(v) ? fallback : v;
    }

    var config = {
      lineWidth: num('data-line-width', 2),
      gap: num('data-gap', 24),
      maxLength: num('data-max-length', 16),
      lengthRadius: num('data-length-radius', 260),
      tilt: num('data-tilt', 1),
      maxTilt: num('data-max-tilt', 45),
      gradientFrom: section.getAttribute('data-gradient-from') || 'rgba(84, 70, 255, 0.55)',
      gradientTo: section.getAttribute('data-gradient-to') || 'rgba(156, 163, 255, 0.35)',
      cursorRadius: num('data-cursor-radius', 320),
      pull: num('data-pull', 14),
      fadeRadius: num('data-fade-radius', 90),
      fadeSpeed: 12, // how fast a stroke eases to its target opacity
      // Slower than the fade on purpose: the strokes lag the cursor slightly,
      // and that lag is what reads as following rather than as the grid
      // snapping.
      followSpeed: 7,
      engageSpeed: 4, // how fast the field wakes to a moving cursor and settles
      // How fast the focus travels between the cursor and its resting place at
      // the centre. Slow, because every stroke in the section swings with it.
      focusSpeed: 5,
    };

    var width = 0;
    var height = 0;
    var dots = [];
    var mouse = { x: -9999, y: -9999, prevX: -9999, prevY: -9999 };
    var hover = false;
    var speed = 0; // smoothed cursor travel, px per frame
    var engagement = 0; // 0–1, how awake the field is
    // The single point every stroke aims at: the cursor, or the section's centre
    // once the pointer leaves. Eased, so the field swings rather than snaps.
    var focusX = 0;
    var focusY = 0;
    // 0–1, whether the pointer is over the section at all. Separate from
    // `engagement`, which tracks its speed: the tilt has to hold under a parked
    // cursor, and only unwind when the pointer actually leaves.
    var presence = 0;
    var strokeFill = null; // one gradient for the whole field — rebuilt on resize

    function initGrid() {
      var parent = canvas.parentElement;
      width = parent.offsetWidth;
      height = parent.offsetHeight;
      if (!width || !height) return;

      var dpr = window.devicePixelRatio || 1;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      // setTransform, not scale: scale() multiplies the existing matrix, so
      // every resize would compound the DPR and shrink the grid.
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Corner to corner, so the shading follows the section, not the viewport.
      strokeFill = ctx.createLinearGradient(0, 0, width, height);
      strokeFill.addColorStop(0, config.gradientFrom);
      strokeFill.addColorStop(1, config.gradientTo);

      dots = [];
      var spacing = config.lineWidth + config.gap;
      var cols = Math.floor(width / spacing);
      var rows = Math.floor(height / spacing);
      var startX = (width - cols * spacing) / 2 + config.lineWidth / 2;
      var startY = (height - rows * spacing) / 2 + config.lineWidth / 2;

      for (var y = 0; y <= rows; y++) {
        for (var x = 0; x <= cols; x++) {
          var cx = startX + x * spacing;
          var cy = startY + y * spacing;
          // ox/oy is the stroke's home in the grid and the point it is drawn
          // centred on; x/y is where that centre is right now. hx/hy is half its
          // segment vector, so it runs from (x-hx, y-hy) to (x+hx, y+hy) — that
          // carries its angle and its length in one pair.
          dots.push({ x: cx, y: cy, ox: cx, oy: cy, alpha: 1, hx: 0, hy: 0 });
        }
      }

      if (!hover) {
        focusX = width / 2;
        focusY = height / 2;
      }
      aim();
    }

    // Give every stroke its length and its angle, both from where the focus is.
    // The focus and `presence` are already eased, so neither needs easing here.
    var HALF_PI = Math.PI / 2; // straight down — the resting angle

    function aim() {
      var longest = config.maxLength / 2;
      // One value for the whole field: how far through the turn it is.
      var turn = presence * config.tilt;
      var ceiling = (config.maxTilt * Math.PI) / 180;

      for (var i = 0; i < dots.length; i++) {
        var dot = dots[i];
        var dx = focusX - dot.ox;
        var dy = focusY - dot.oy;
        var dist = Math.sqrt(dx * dx + dy * dy);

        var t = dist / config.lengthRadius;
        if (t > 1) t = 1;
        // Smoothstep again: a stroke leaves the focus as a dot and eases up to
        // full length, rather than ramping linearly and creasing at both ends.
        // Scaled by `presence`, so length is something the pointer brings with
        // it: with no cursor on the section every stroke is a plain dot.
        var reach = longest * t * t * (3 - 2 * t) * presence;
        // A canvas subpath of exactly zero length is not reliably painted, even
        // with a round cap. A quarter pixel is a dot and is always drawn.
        if (reach < 0.25) reach = 0.25;

        // Upright, unless the pointer is here to turn it.
        var ux = 0;
        var uy = 1;

        if (turn > 0.001 && dist > 0.01) {
          // How far this stroke's line to the pointer sits from vertical. A
          // segment drawn about its centre looks the same pointed either way,
          // so fold that offset into a quarter turn either side: the stroke
          // always takes the short way round and never sweeps past horizontal.
          var off = Math.atan2(dy, dx) - HALF_PI;
          while (off > HALF_PI) off -= Math.PI;
          while (off < -HALF_PI) off += Math.PI;

          // Squash that offset into ±`maxTilt`. tanh, not a clamp: a clamp puts
          // every stroke past the limit at exactly the limit, and a whole flank
          // of the grid sharing one angle looks like a printed hatch. tanh is
          // near-linear for small offsets — so strokes that were never going to
          // lie flat barely move — and closes on the ceiling without reaching it.
          if (ceiling > 0) off = ceiling * Math.tanh(off / ceiling);

          // Interpolate the ANGLE. Every stroke turns by the same fraction of
          // its own offset, so the whole field tilts at once instead of bending
          // across the grid.
          var angle = HALF_PI + off * turn;
          ux = Math.cos(angle);
          uy = Math.sin(angle);
        }

        dot.hx = ux * reach;
        dot.hy = uy * reach;
      }
    }

    function paint() {
      ctx.clearRect(0, 0, width, height);
      ctx.strokeStyle = strokeFill;
      ctx.lineWidth = config.lineWidth;
      ctx.lineCap = 'round'; // so a stroke shrunk to nothing reads as a dot

      // Two passes. Only the few dozen strokes the cursor is touching have an
      // alpha of their own; the rest of the field is untouched and goes down as
      // a single path in one stroke call. Setting globalAlpha per stroke across
      // ~900 of them is what made this stutter.
      ctx.globalAlpha = 1;
      ctx.beginPath();
      for (var i = 0; i < dots.length; i++) {
        var dot = dots[i];
        if (dot.alpha < 0.995) continue;
        ctx.moveTo(dot.x - dot.hx, dot.y - dot.hy);
        ctx.lineTo(dot.x + dot.hx, dot.y + dot.hy);
      }
      ctx.stroke();

      for (var j = 0; j < dots.length; j++) {
        var fading = dots[j];
        if (fading.alpha >= 0.995 || fading.alpha < 0.01) continue;
        ctx.globalAlpha = fading.alpha;
        ctx.beginPath();
        ctx.moveTo(fading.x - fading.hx, fading.y - fading.hy);
        ctx.lineTo(fading.x + fading.hx, fading.y + fading.hy);
        ctx.stroke();
      }

      ctx.globalAlpha = 1;
    }

    var reduceMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      // Static field. No animation loop, no cursor reaction.
      initGrid();
      paint();
      window.addEventListener('resize', function () {
        initGrid();
        paint();
      });
      return;
    }

    var lastTime = performance.now();

    function draw(time) {
      var dt = (time - lastTime) / 1000;
      if (dt > 0.05) dt = 0.05; // cap so a backgrounded tab can't jolt the grid
      lastTime = time;

      var fadeEase = Math.min(1, config.fadeSpeed * dt);
      var followEase = Math.min(1, config.followSpeed * dt);
      var engageEase = Math.min(1, config.engageSpeed * dt);
      var focusEase = Math.min(1, config.focusSpeed * dt);

      // How fast the cursor is travelling, smoothed. DotField samples this on a
      // 20ms interval; a frame is close enough and needs no second timer.
      var travelX = mouse.x - mouse.prevX;
      var travelY = mouse.y - mouse.prevY;
      mouse.prevX = mouse.x;
      mouse.prevY = mouse.y;
      speed += (Math.sqrt(travelX * travelX + travelY * travelY) - speed) * 0.5;
      if (speed < 0.01) speed = 0;

      engagement += ((hover ? Math.min(speed / 6, 1) : 0) - engagement) * engageEase;
      if (engagement < 0.001) engagement = 0;

      // A parked cursor still holds the field open, it just holds it more
      // gently — the pull ranges over the top 60% as the cursor speeds up.
      // Without the floor the dots would slump home whenever you stopped, which
      // reads as the effect breaking rather than as the field resting.
      var grip = hover ? 0.4 + 0.6 * engagement : 0;

      // Chase the cursor, or fall back to the middle of the section once it
      // leaves. Everything downstream aims at this, not at the raw pointer.
      var wantX = hover ? mouse.x : width / 2;
      var wantY = hover ? mouse.y : height / 2;
      var swungX = wantX - focusX;
      var swungY = wantY - focusY;
      var swung = swungX > 0.05 || swungX < -0.05 || swungY > 0.05 || swungY < -0.05;
      if (swung) {
        focusX += swungX * focusEase;
        focusY += swungY * focusEase;
      } else if (focusX !== wantX || focusY !== wantY) {
        focusX = wantX;
        focusY = wantY;
        swung = true;
      }

      // The tilt winds up when the pointer arrives and unwinds when it leaves,
      // on the same clock as the focus swing.
      var wantPresence = hover ? 1 : 0;
      var presenceDiff = wantPresence - presence;
      if (presenceDiff > 0.002 || presenceDiff < -0.002) {
        presence += presenceDiff * focusEase;
        swung = true;
      } else if (presence !== wantPresence) {
        presence = wantPresence;
        swung = true;
      }

      // Every stroke's length and angle hang off those two, so they only need
      // recomputing on the frames one of them actually moved.
      if (swung) aim();

      var crSq = config.cursorRadius * config.cursorRadius;
      var moving = swung;

      for (var i = 0; i < dots.length; i++) {
        var dot = dots[i];

        // Measured from the stroke's home, not its current position —
        // otherwise one that has moved toward the focus reads as closer, pulls
        // harder, and runs away into it.
        var dx = focusX - dot.ox;
        var dy = focusY - dot.oy;
        var distSq = dx * dx + dy * dy;

        var targetAlpha = 1;
        var targetX = dot.ox;
        var targetY = dot.oy;

        if (distSq < crSq) {
          var dist = Math.sqrt(distSq);

          if (grip > 0.001) {
            // Squared falloff, zero at the rim, so a stroke entering the radius
            // starts from no displacement instead of jumping.
            var t = 1 - dist / config.cursorRadius;
            var push = t * t * config.pull * grip;
            // A stroke must never reach the cursor: past it, it would cross to
            // the far side and the field would knot up around the pointer.
            if (push > dist * 0.75) push = dist * 0.75;
            var step = dist > 0.01 ? push / dist : 0;
            targetX += dx * step;
            targetY += dy * step;
          }

          if (dist < config.fadeRadius) {
            // Smoothstep, not a linear ramp: flat at both ends, so the hole has
            // no visible crease at its rim and no hard edge at its centre.
            var ft = dist / config.fadeRadius;
            var hole = ft * ft * (3 - 2 * ft);
            // Also the pointer's doing, so the resting grid keeps every dot
            // rather than carrying a bald patch where the focus parks.
            targetAlpha = 1 - (1 - hole) * presence;
          }
        }

        var offX = targetX - dot.x;
        var offY = targetY - dot.y;
        if (offX > 0.05 || offX < -0.05 || offY > 0.05 || offY < -0.05) {
          dot.x += offX * followEase;
          dot.y += offY * followEase;
          moving = true;
        } else if (dot.x !== targetX || dot.y !== targetY) {
          dot.x = targetX;
          dot.y = targetY;
          moving = true;
        }

        var diff = targetAlpha - dot.alpha;
        if (diff > 0.002 || diff < -0.002) {
          dot.alpha += diff * fadeEase;
          moving = true;
        } else if (dot.alpha !== targetAlpha) {
          // Snap the last hundredth rather than easing at it forever, so the
          // field can go fully idle once the cursor is away.
          dot.alpha = targetAlpha;
          moving = true;
        }
      }

      // A settled field is repainted zero times a second, not sixty.
      if (moving) paint();
      requestAnimationFrame(draw);
    }

    window.addEventListener('resize', initGrid);
    initGrid();
    requestAnimationFrame(draw);

    // Scoped to the section, not the window as DotField does: several of these
    // Embeds can share a Webflow page, and a global listener would have each
    // one reacting to a cursor nowhere near it.
    section.addEventListener('mousemove', function (e) {
      var rect = canvas.getBoundingClientRect();
      var nx = e.clientX - rect.left;
      var ny = e.clientY - rect.top;
      if (!hover) {
        // Re-entering: seed prev with the entry point, or the jump from the
        // parked -9999 would register as a colossal cursor speed.
        mouse.prevX = nx;
        mouse.prevY = ny;
      }
      hover = true;
      mouse.x = nx;
      mouse.y = ny;
    });

    section.addEventListener('mouseleave', function () {
      // Dropping `hover` is what matters: the focus starts its swing back to the
      // centre and the pull lets go. The parked coordinates just keep a stale
      // pointer position from being read as a real one.
      hover = false;
      speed = 0;
      mouse.x = -9999;
      mouse.y = -9999;
      mouse.prevX = -9999;
      mouse.prevY = -9999;
    });
  })();
</script>

<script is:inline>
  /* Book a demo → HubSpot form in a modal. The embed script is fetched on the
     first open, not on page load. */
  (function () {
    var section = document.getElementById('blog-cta');
    if (!section) return;

    var modal = section.querySelector('[data-demo-modal]');
    var mount = section.querySelector('#blog-cta-hs-form');
    if (!modal || !mount) return;

    var panel = modal.firstElementChild;
    var closeBtn = modal.querySelector('[data-demo-close]');

    var lastFocused = null;
    var scriptRequested = false;
    var formCreated = false;

    function createForm() {
      if (formCreated || !window.hbspt || !window.hbspt.forms) return;
      formCreated = true;

      window.hbspt.forms.create({
        portalId: mount.getAttribute('data-portal-id'),
        formId: mount.getAttribute('data-form-id'),
        region: mount.getAttribute('data-region') || 'na2',
        target: '#blog-cta-hs-form',
        onFormReady: function ($form) {
          var loading = mount.querySelector('[data-demo-loading]');
          if (loading && loading.parentNode) loading.parentNode.removeChild(loading);

          // Carry campaign attribution through, same as the site's other forms.
          var formEl = $form && $form[0] ? $form[0] : $form;
          if (!formEl || !formEl.querySelector) return;
          var params = new URLSearchParams(window.location.search);
          var utms = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
          for (var i = 0; i < utms.length; i++) {
            var value = params.get(utms[i]);
            if (!value) continue;
            var input = formEl.querySelector('input[name="' + utms[i] + '"]');
            if (input) input.value = value;
          }
        },
      });
    }

    function loadHubspot() {
      if (scriptRequested) return;
      scriptRequested = true;

      if (window.hbspt && window.hbspt.forms) {
        createForm();
        return;
      }

      // Reuse the loader if the page already has one (e.g. another form
      // section, or a paste in Webflow's page head) rather than adding a second.
      var loader = document.querySelector('script[src*="hsforms.net"]');
      if (!loader) {
        loader = document.createElement('script');
        loader.src = 'https://js-na2.hsforms.net/forms/embed/v2.js';
        loader.charset = 'utf-8';
        loader.async = true;
        document.head.appendChild(loader);
      }
      loader.addEventListener('load', createForm);

      // Backstop: a cached loader may have fired `load` before we listened.
      var tries = 0;
      var poll = setInterval(function () {
        tries++;
        if (window.hbspt && window.hbspt.forms) {
          clearInterval(poll);
          createForm();
        } else if (tries > 100) {
          clearInterval(poll);
        }
      }, 100);
    }

    // Inline display, not a class swap: the utilities pasted into Webflow are
    // unlayered, so `flex` and `hidden` on one element would race on source
    // order. Inline always wins.
    function openModal(e, opener) {
      if (e) e.preventDefault();
      // The clicked opener, not activeElement: browsers differ on whether a
      // click focuses an anchor, and on close focus has to land somewhere
      // predictable rather than on the document root.
      lastFocused = opener || document.activeElement;
      modal.style.display = 'flex';
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      loadHubspot();
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function isOpen() {
      return modal.style.display === 'flex';
    }

    // Delegated, so it does not matter which Embed mounts first or whether the
    // opener existed when this ran.
    document.addEventListener('click', function (e) {
      if (!e.target.closest) return;
      var opener = e.target.closest('[data-demo-open]');
      if (!opener) return;
      openModal(e, opener);
    });

    // The navbar's "Book a demo" buttons — desktop and mobile — live in
    // `_shared/NavbarRb.astro`, which Global Invoicing also uses, so they can't
    // be changed at the source: there `#contactForm` is a real section and the
    // scroll is correct. Here it resolves to this modal, which is fixed and
    // display:none, so the inline handler is a no-op. Adopt them instead —
    // strip the dead handler and mark them as openers.
    function adoptNavbarCtas() {
      var ctas = document.querySelectorAll('a[onclick*="contactForm"]');
      for (var i = 0; i < ctas.length; i++) {
        ctas[i].removeAttribute('onclick');
        ctas[i].onclick = null;
        ctas[i].setAttribute('data-demo-open', '');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', adoptNavbarCtas);
    } else {
      adoptNavbarCtas();
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', function (e) {
      if (!isOpen()) return;

      if (e.key === 'Escape') {
        closeModal();
        return;
      }

      // Keep Tab inside the dialog — `aria-modal` claims the rest is inert, so
      // focus must not walk out into the page behind it.
      if (e.key !== 'Tab' || !panel) return;
      var focusable = panel.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>

