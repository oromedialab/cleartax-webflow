---
/**
 * Events / Webinars — brand v2. Figma node 14777:26964
 * (https://www.cleartax.com/resources/events).
 *
 * Navbar and Footer are thin wrappers over the `_shared/*Rb` primitives, the
 * same pair every other v2 page uses. Hero, Upcoming, Filters and Events are
 * page-local: each one is a Webflow Embed paste unit and supplies its own
 * content, because the embed route renders sections with no props.
 *
 * THE PAGE IS TWO HALVES. `Upcoming` is the bordered panel of sessions still to
 * come; `Filters` + `Events` are the filterable archive of past ones, and the
 * heading for that half lives in `Filters` because it has to stay put while the
 * filter bar pins. They read `upcomingEvents` and `pastEvents` respectively, so
 * an event can never show up in both.
 *
 * Figma hides the "Partner program" band (node 14777:27070) on this page, so it
 * is not built — the footer follows the grid directly.
 *
 * No fonts.css import — that bundle self-hosts the v1 faces. Brand v2 loads
 * Inter Tight + Google Sans from Google Fonts via the <link> in the head.
 */
import "../styles/shared.css";
import "../styles/.build/events.css";

import Navbar from "../sections/events/Navbar.astro";
import Hero from "../sections/events/Hero.astro";
import Upcoming from "../sections/events/Upcoming.astro";
import Filters from "../sections/events/Filters.astro";
import Events from "../sections/events/Events.astro";
import Footer from "../sections/events/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClearTax — Events &amp; Webinars</title>
    <meta
      name="description"
      content="Live webinars and events from ClearTax — e-invoicing mandates, ERP integration and tax compliance, explained by the experts who ship it. Filter by topic and country."
    />
    <meta content="noindex, nofollow" name="robots" />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400..700&family=Google+Sans:opsz,wght@17..18,400..700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />
  </head>
  <body class="bg-generic-00">
    <Navbar />
    <Hero />
    <Upcoming />
    <Filters />
    <Events />
    <Footer />
  </body>
</html>
