---
/**
 * Global homepage (non-India) — brand v2. Figma node 13049:21171.
 *
 * Head plumbing (fonts, favicons, deferred GTM/Usercentrics loader, HubSpot)
 * mirrors src/pages/global-invoicing.astro so the two v2 pages behave the same
 * in Webflow. No fonts.css import — that bundle self-hosts the v1 faces; brand
 * v2 loads Inter Tight + Google Sans from Google Fonts via the <link> below.
 */
import "../styles/shared.css";
import "../styles/.build/global-homepage.css";

import Navbar from "../sections/global-homepage/Navbar.astro";
import Hero from "../sections/global-homepage/Hero.astro";
import SocialProof from "../sections/global-homepage/SocialProof.astro";
import WhyGenericAi from "../sections/global-homepage/WhyGenericAi.astro";
import ClarityAi from "../sections/global-homepage/ClarityAi.astro";
import Proven from "../sections/global-homepage/Proven.astro";
import Einvoicing from "../sections/global-homepage/Einvoicing.astro";
import Seamless from "../sections/global-homepage/Seamless.astro";
import Cta from "../sections/global-homepage/Cta.astro";
import Footer from "../sections/global-homepage/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClearTax — Close the gap between AI’s promise and finance reality</title>
    <meta
      name="description"
      content="ClearTax gives finance teams clean data and the business context AI needs. E-invoicing compliance across 50+ countries with one API, plus the financial context layer behind AI output you can trust."
    />
    <meta
      name="keywords"
      content="AI for finance, finance data foundation, global e-invoicing solution, e-invoicing compliance, finance AI agents, ERP integration, tax compliance automation, ClearTax global"
    />
    <meta content="noindex, nofollow" name="robots" />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Preload critical above-the-fold assets -->
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />

    <!-- Deferred script loader for performance -->
    <script is:inline>
      (function () {
        let scriptsLoaded = false;
        function loadHeavyScripts() {
          if (scriptsLoaded) return;
          scriptsLoaded = true;

          triggerEvents.forEach((e) =>
            window.removeEventListener(e, loadHeavyScripts, { passive: true }),
          );

          // Google Tag Manager
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");

          var blockScript = document.createElement("script");
          blockScript.src =
            "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
          document.head.appendChild(blockScript);

          var cmpScript = document.createElement("script");
          cmpScript.id = "usercentrics-cmp";
          cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
          cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
          cmpScript.async = true;
          document.head.appendChild(cmpScript);
        }

        const triggerEvents = [
          "mouseover",
          "mouseenter",
          "mousemove",
          "touchstart",
          "scroll",
          "keydown",
        ];
        triggerEvents.forEach((e) =>
          window.addEventListener(e, loadHeavyScripts, { passive: true }),
        );

        // Safety timeout so crawlers still get the scripts without interaction.
        setTimeout(loadHeavyScripts, 4000);

        const setupHashCleaner = () => {
          try {
            document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
              anchor.addEventListener("click", function (e) {
                const targetId = this.getAttribute("href");
                if (targetId === "#") return;
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                  e.preventDefault();
                  targetElement.scrollIntoView({ behavior: "smooth" });
                  history.pushState(
                    null,
                    document.title,
                    window.location.pathname + window.location.search,
                  );
                }
              });
            });

            if (window.location.hash) {
              setTimeout(() => {
                history.replaceState(
                  null,
                  document.title,
                  window.location.pathname + window.location.search,
                );
              }, 1000);
            }
          } catch (e) {
            console.error("Anchor hash handler failed", e);
          }
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", setupHashCleaner);
        } else {
          setupHashCleaner();
        }
      })();
    </script>

    <link rel="preconnect" href="https://js-na2.hsforms.net" />
    <link rel="preconnect" href="https://forms.hsforms.com" />
    <link rel="preconnect" href="https://forms-na2.hsforms.com" />
    <script is:inline src="https://js-na2.hsforms.net/forms/embed/v2.js"></script>
  </head>
  <body class="bg-white">
    <!-- Google Tag Manager (noscript). Does not ship in any embed — it belongs
         in Webflow's page custom code. -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <Navbar />
    <Hero />
    <SocialProof />
    <WhyGenericAi />
    <ClarityAi />
    <Proven />
    <Einvoicing />
    <Seamless />
    <Cta />
    <Footer />
  </body>
</html>
