---
/**
 * Global Invoicing — brand v2.
 * Figma: "Website Mockup 7 — Global Invoicing WIP" (12105:6322).
 *
 * The v1 page it replaces is src/pages/v1-global-invoicing-delivery.astro.
 * Delete that (and src/sections/v1-global-invoicing-delivery/, its CSS entry
 * and its PAGE_TARGETS row) once this ships to Webflow.
 *
 * No fonts.css import — that bundle self-hosts the v1 faces. Brand v2 loads
 * Inter Tight + Google Sans from Google Fonts via the <link> below, which is
 * the same tag to paste into the Webflow page head.
 *
 * NOTE: this page passes NO props. It cannot. The embed route renders each
 * section standalone as `<Component />`, so the HTML pasted into Webflow is
 * always the section's DEFAULT render — props supplied here would never reach
 * production. Content therefore lives in each section's `Astro.props`
 * defaults, and this file is pure composition. See CLAUDE.md.
 */
import "../styles/shared.css";
import "../styles/.build/global-invoicing.css";

import Navbar from "../sections/global-invoicing/Navbar.astro";
import Hero from "../sections/global-invoicing/Hero.astro";
import SocialProof from "../sections/global-invoicing/SocialProof.astro";
import Features from "../sections/global-invoicing/Features.astro";
import Integration from "../sections/global-invoicing/Integration.astro";
import Integrations from "../sections/global-invoicing/Integrations.astro";
import Testimonials from "../sections/global-invoicing/Testimonials.astro";
import SignupForm from "../sections/global-invoicing/SignupForm.astro";
import Faq from "../sections/global-invoicing/Faq.astro";
import Footer from "../sections/global-invoicing/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cleartax — Global e-invoicing compliance</title>
    <meta
      name="description"
      content="One integration for e-invoicing compliance across 50+ countries. Connect your ERP once and stay ahead of every mandate as the rules change."
    />
    <meta content="noindex, nofollow" name="robots" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400..700&family=Google+Sans:opsz,wght@17..18,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navbar />
    <Hero />
    <SocialProof />
    <Features />
    <Integration />
    <Integrations />
    <Testimonials />
    <SignupForm />
    <Faq />
    <Footer />
  </body>
</html>
