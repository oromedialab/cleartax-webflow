---
/**
 * Brand v2 parity test page.
 *
 * Compare these two renders — they must be identical:
 *   dev     http://localhost:4321/brand-test
 *   preview dist/preview/brand-test.html   (open in a browser after `npm run build`)
 *
 * Note: no `../styles/fonts.css` import. That bundle self-hosts the v1 brand
 * faces (Nohemi / Gilroy). Brand v2 uses Inter Tight + Google Sans, both on
 * Google Fonts under SIL OFL 1.1, loaded by the <link> below — which is the
 * same tag to paste into the Webflow page head.
 */
import "../styles/shared.css";
import "../styles/.build/brand-test.css";
import BrandSpecimen from "../sections/brand-test/BrandSpecimen.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cleartax — brand v2 specimen</title>
    <meta name="description" content="Token and typography parity test for Cleartax brand v2." />
    <meta content="noindex, nofollow" name="robots" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400..700&family=Google+Sans:opsz,wght@17..18,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <BrandSpecimen />
  </body>
</html>
