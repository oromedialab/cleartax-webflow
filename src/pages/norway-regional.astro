---
/**
 * Norway regional page (cleartax.com/no) — brand v2. Figma node 17103:81791.
 *
 * Head plumbing (fonts, favicons, deferred GTM/Usercentrics loader, HubSpot)
 * mirrors `spain-regional.astro` / `france-regional.astro` / `oman-regional.astro`
 * so every v2 regional page behaves the same in Webflow. No fonts.css import —
 * that bundle self-hosts the v1 faces; brand v2 loads Inter Tight + Google
 * Sans from Google Fonts via the <link> below.
 *
 * Navbar, Footer and DemoModal are byte-identical copies of the Spain/France/
 * Oman regional sections — the global nav/footer/demo modal are shared across
 * every brand v2 page, and a page's CSS entry only sources its own section
 * folder, so importing across folders would compile none of their utilities
 * into this bundle. Testimonials and Faq are thin wrappers on the `_shared`
 * primitives, SocialProof on `_shared/LogostripRb`.
 *
 * Hero, Glance, Roadmap, Features, Security and Faq content are this page's
 * own, transcribed from the Figma. The Figma has no "Seamless" accordion
 * section like the France/Oman/UAE pages, and no Resources/Cta band — see
 * each section file's docblock for what maps to what.
 */
import "../styles/shared.css";
import "../styles/.build/norway-regional.css";

import Navbar from "../sections/norway-regional/Navbar.astro";
import Hero from "../sections/norway-regional/Hero.astro";
import SocialProof from "../sections/norway-regional/SocialProof.astro";
import Glance from "../sections/norway-regional/Glance.astro";
import Roadmap from "../sections/norway-regional/Roadmap.astro";
import Features from "../sections/norway-regional/Features.astro";
import Security from "../sections/norway-regional/Security.astro";
import Testimonials from "../sections/norway-regional/Testimonials.astro";
import Faq from "../sections/norway-regional/Faq.astro";
import Footer from "../sections/norway-regional/Footer.astro";
import DemoModal from "../sections/norway-regional/DemoModal.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      ClearTax Norway — Get Ready for 2027 Norway E-Invoicing
    </title>
    <meta
      name="description"
      content="ClearTax helps businesses in Norway prepare for the 2027 B2B e-invoicing mandate and the 2030 digital bookkeeping deadline — EHF Fakturering 3.0, Peppol BIS Billing 3.0 and ERP integration on one AI-powered platform."
    />
    <meta
      name="keywords"
      content="Norway e-invoicing, Norway e-invoicing 2027, EHF Fakturering, Peppol BIS Billing, ELMA, SAF-T Norway, Bookkeeping Act Norway, e-invoicing software Norway, ClearTax Norway"
    />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Preload critical above-the-fold assets -->
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />

    <!-- Usercentrics CMP loads immediately (not deferred) so the consent
         banner and autoblocker are in place before other scripts run. -->
    <script is:inline>
      (function () {
        var blockScript = document.createElement("script");
        blockScript.src =
          "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
        document.head.appendChild(blockScript);

        var cmpScript = document.createElement("script");
        cmpScript.id = "usercentrics-cmp";
        cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
        cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
        cmpScript.async = true;
        document.head.appendChild(cmpScript);
      })();
    </script>

    <!-- Deferred script loader for performance -->
    <script is:inline>
      (function () {
        let scriptsLoaded = false;
        function loadHeavyScripts() {
          if (scriptsLoaded) return;
          scriptsLoaded = true;

          triggerEvents.forEach((e) =>
            window.removeEventListener(e, loadHeavyScripts, { passive: true }),
          );

          // Google Tag Manager
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");
        }

        const triggerEvents = [
          "mouseover",
          "mouseenter",
          "mousemove",
          "touchstart",
          "scroll",
          "keydown",
        ];
        triggerEvents.forEach((e) =>
          window.addEventListener(e, loadHeavyScripts, { passive: true }),
        );

        // Safety timeout so crawlers still get the scripts without interaction.
        setTimeout(loadHeavyScripts, 4000);

        const setupHashCleaner = () => {
          try {
            document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
              anchor.addEventListener("click", function (e) {
                const targetId = this.getAttribute("href");
                if (targetId === "#") return;
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                  e.preventDefault();
                  targetElement.scrollIntoView({ behavior: "smooth" });
                  history.pushState(
                    null,
                    document.title,
                    window.location.pathname + window.location.search,
                  );
                }
              });
            });

            if (window.location.hash) {
              setTimeout(() => {
                history.replaceState(
                  null,
                  document.title,
                  window.location.pathname + window.location.search,
                );
              }, 1000);
            }
          } catch (e) {
            console.error("Anchor hash handler failed", e);
          }
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", setupHashCleaner);
        } else {
          setupHashCleaner();
        }
      })();
    </script>

    <link rel="preconnect" href="https://js-na2.hsforms.net" />
    <link rel="preconnect" href="https://forms.hsforms.com" />
    <script is:inline defer src="https://js-na2.hsforms.net/forms/embed/v2.js"
    ></script>
  </head>
  <body class="bg-generic-00">
    <!-- Google Tag Manager (noscript). Does not ship in any embed — it belongs
         in Webflow's page custom code. -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <Navbar />
    <Hero />
    <SocialProof />
    <Glance />
    <Roadmap />
    <Features />
    <Security />
    <Testimonials />
    <Faq />
    <Footer />
    <!-- Renders nothing visible: the "Book a demo" dialog every CTA above
         opens. Last so its markup can't affect the flow above it. -->
    <DemoModal />
  </body>
</html>
