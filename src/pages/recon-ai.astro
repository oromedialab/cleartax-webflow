---
import "../styles/shared.css";
import "../styles/.build/recon-ai.css";

import Navbar from "../sections/recon-ai/Navbar.astro";
import Hero from "../sections/recon-ai/Hero.astro";
import SocialProof from "../sections/recon-ai/SocialProof.astro";
import Cta from "../sections/recon-ai/Cta.astro";
import Stack from "../sections/recon-ai/Stack.astro";
import Footer from "../sections/recon-ai/Footer.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>ClearTax — Recon AI</title>
        <meta
            name="description"
            content="ClearTax Recon AI helps businesses automatically reconcile GST returns, invoices, and financial data to ensure accuracy, compliance, and efficiency in tax management. Leverage intelligent matching and automated workflows to streamline GST reconciliation processes."
        />
        <meta content="index, follow" name="robots" />
        <link
            rel="shortcut icon"
            type="image/png"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="256x256"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
        />
        <link
            rel="apple-touch-icon"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="preload"
            href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
            as="image"
            type="image/svg+xml"
            fetchpriority="high"
        />
        <!-- 1. Usercentrics CMP — loads immediately, before anything else -->
        <script is:inline>
            (function () {
                var blockScript = document.createElement("script");
                blockScript.src =
                    "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
                document.head.appendChild(blockScript);

                var cmpScript = document.createElement("script");
                cmpScript.id = "usercentrics-cmp";
                cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
                cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
                cmpScript.async = true;
                document.head.appendChild(cmpScript);
            })();
        </script>

        <!-- 2. GTM — loads only after the visitor responds to the consent banner -->
        <script is:inline>
            (function () {
                function loadGTM() {
                    (function (w, d, s, l, i) {
                        w[l] = w[l] || [];
                        w[l].push({
                            "gtm.start": new Date().getTime(),
                            event: "gtm.js",
                        });
                        var f = d.getElementsByTagName(s)[0],
                            j = d.createElement(s),
                            dl = l != "dataLayer" ? "&l=" + l : "";
                        j.async = true;
                        j.src =
                            "https://www.googletagmanager.com/gtm.js?id=" +
                            i +
                            dl;
                        f.parentNode.insertBefore(j, f);
                    })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");
                }

                window.addEventListener("UC_UI_CMP_EVENT", function (event) {
                    if (
                        event.detail &&
                        ["ACCEPT_ALL", "DENY_ALL", "SAVE"].indexOf(
                            event.detail.type,
                        ) !== -1
                    ) {
                        loadGTM();
                    }
                });
            })();
        </script>
    </head>
    <body class="bg-generic-00">
        <!-- Google Tag Manager (noscript) -->
        <noscript>
            <iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
                height="0"
                width="0"
                style="display:none;visibility:hidden"
            ></iframe>
        </noscript>
        <!-- End Google Tag Manager (noscript) -->
        <Navbar />
        <Hero />
        <SocialProof />
        <Stack />
        <Cta />
        <Footer />
    </body>
</html>
