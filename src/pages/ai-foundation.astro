---
/**
 * AI Foundation — brand v2 Clarity AI page.
 *
 * Figma: https://www.figma.com/design/c6vfsoBMO135m1Nql8oiGy/Cleartax-%7C--Oro?node-id=16985-61464
 *
 * Scaffolded from src/pages/cfo-insights.astro per
 * docs/adding-a-new-page.md. Section components live in
 * src/sections/ai-foundation/.
 *
 * No fonts.css import — that bundle self-hosts the v1 faces. Brand v2 loads
 * Inter Tight + Google Sans from Google Fonts via the <link> in the head.
 */
import "../styles/shared.css";
import "../styles/.build/ai-foundation.css";

import Navbar from "../sections/ai-foundation/Navbar.astro";
import Hero from "../sections/ai-foundation/Hero.astro";
import Logostrip from "../sections/ai-foundation/Logostrip.astro";
import WorkBreakdown from "../sections/ai-foundation/WorkBreakdown.astro";
import DataLayer from "../sections/ai-foundation/DataLayer.astro";
import ContextLayer from "../sections/ai-foundation/ContextLayer.astro";
import Surfaces from "../sections/ai-foundation/Surfaces.astro";
import Comparison from "../sections/ai-foundation/Comparison.astro";
import Security from "../sections/ai-foundation/Security.astro";
import CtaBand from "../sections/ai-foundation/CtaBand.astro";
import Footer from "../sections/ai-foundation/Footer.astro";
import DemoModal from "../sections/ai-foundation/DemoModal.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClearTax — Clarity AI: The Foundation for Finance AI</title>
    <meta
      name="description"
      content="Clarity AI connects to every data source you need, embeds your business context, and gives you the surface to build your own finance AI workflows."
    />
    <meta content="noindex, nofollow" name="robots" />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />

    <!-- Deferred script loader for performance -->
    <script is:inline>
      (function () {
        let scriptsLoaded = false;
        function loadHeavyScripts() {
          if (scriptsLoaded) return;
          scriptsLoaded = true;

          triggerEvents.forEach((e) =>
            window.removeEventListener(e, loadHeavyScripts, { passive: true }),
          );

          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");

          var blockScript = document.createElement("script");
          blockScript.src =
            "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
          document.head.appendChild(blockScript);

          var cmpScript = document.createElement("script");
          cmpScript.id = "usercentrics-cmp";
          cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
          cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
          cmpScript.async = true;
          document.head.appendChild(cmpScript);
        }

        const triggerEvents = [
          "mouseover",
          "mouseenter",
          "mousemove",
          "touchstart",
          "scroll",
          "keydown",
        ];
        triggerEvents.forEach((e) =>
          window.addEventListener(e, loadHeavyScripts, { passive: true }),
        );

        setTimeout(loadHeavyScripts, 4000);

        const setupHashCleaner = () => {
          try {
            document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
              anchor.addEventListener("click", function (e) {
                const targetId = this.getAttribute("href");
                if (targetId === "#") return;
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                  e.preventDefault();
                  targetElement.scrollIntoView({ behavior: "smooth" });
                  history.pushState(
                    null,
                    document.title,
                    window.location.pathname + window.location.search,
                  );
                }
              });
            });

            if (window.location.hash) {
              setTimeout(() => {
                history.replaceState(
                  null,
                  document.title,
                  window.location.pathname + window.location.search,
                );
              }, 1000);
            }
          } catch (e) {
            console.error("Anchor hash handler failed", e);
          }
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", setupHashCleaner);
        } else {
          setupHashCleaner();
        }
      })();
    </script>
  </head>
  <body class="bg-generic-00">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <Navbar />
    <Hero />
    <Logostrip />
    <WorkBreakdown />
    <DataLayer />
    <ContextLayer />
    <Surfaces />
    <Comparison />
    <Security />
    <CtaBand />
    <Footer />
    <DemoModal />
  </body>
</html>
