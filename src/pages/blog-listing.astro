---
/**
 * Blog listing — brand v2. Figma node 12289:26896 ("Blog - List").
 *
 * Navbar and Footer are thin wrappers over the `_shared/*Rb` primitives, the
 * same pair the Global Invoicing page uses. Hero, Featured, Filters, Articles
 * and Newsletter are page-local: each one is a Webflow Embed paste unit and
 * supplies its own content, because the embed route renders sections with no
 * props.
 *
 * No fonts.css import — that bundle self-hosts the v1 faces. Brand v2 loads
 * Inter Tight + Google Sans from Google Fonts via the <link> in the head.
 */
import "../styles/shared.css";
import "../styles/.build/blog-listing.css";

import Navbar from "../sections/blog-listing/Navbar.astro";
import Hero from "../sections/blog-listing/Hero.astro";
import Featured from "../sections/blog-listing/Featured.astro";
import Filters from "../sections/blog-listing/Filters.astro";
import Articles from "../sections/blog-listing/Articles.astro";
import Newsletter from "../sections/blog-listing/Newsletter.astro";
import Footer from "../sections/blog-listing/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClearTax — Perspectives That Matter</title>
    <meta
      name="description"
      content="Expert insights, e-invoicing updates and tax compliance guides from the ClearTax team — filtered by topic and country."
    />
    <meta content="noindex, nofollow" name="robots" />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400..700&family=Google+Sans:opsz,wght@17..18,400..700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />
  </head>
  <body class="bg-generic-00">
    <Navbar />
    <Hero />
    <Featured />
    <Filters />
    <Articles />
    <Newsletter />
    <Footer />
  </body>
</html>
