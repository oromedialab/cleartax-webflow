---
/**
 * UAE regional page (cleartax.com/uae) — brand v2. Figma node 13600:27939.
 *
 * Head plumbing (fonts, favicons, deferred GTM/Usercentrics loader, HubSpot)
 * mirrors src/pages/global-homepage.astro so the v2 pages behave the same in
 * Webflow. No fonts.css import — that bundle self-hosts the v1 faces; brand v2
 * loads Inter Tight + Google Sans from Google Fonts via the <link> below.
 *
 * Navbar, SocialProof, Seamless, Cta, Footer and DemoModal are copies of the
 * Global homepage sections — the designs share them, and a page’s CSS entry only
 * sources its own section folder, so importing across folders would compile none
 * of their utilities into this bundle. Testimonials and Faq are thin wrappers on
 * the `_shared` primitives. Hero, Mandate, Supports and Resources are this
 * page’s own.
 */
import "../styles/shared.css";
import "../styles/.build/uae-regional.css";

import Navbar from "../sections/uae-regional/Navbar.astro";
import Hero from "../sections/uae-regional/Hero.astro";
import Faq from "../sections/uae-regional/Faq.astro";
import CTA from "../sections/uae-regional/CTA.astro";
import Logos from "../sections/uae-regional/Logos.astro";
import ASP from "../sections/uae-regional/ASP.astro";
import Integration from "../sections/uae-regional/Integration.astro";
import ResourceCenter from "../sections/uae-regional/ResourceCenter.astro";
import Network from "../sections/uae-regional/Network.astro";
import Testimonial from "../sections/uae-regional/Testimonial.astro";
import Footer from "../sections/uae-regional/Footer.astro";
import DemoModal from "../sections/uae-regional/DemoModal.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>ClearTax UAE — Get Ready for 2026 UAE E-invoicing</title>
        <meta
            name="description"
            content="Get ready for the 2026 UAE e-invoicing mandate with ClearTax — a DGFiP-certified Plateforme Agréée (PA), Y-model compliant, with AI-powered ERP/POS integration and one unified API covering 40+ country mandates."
        />
        <meta
            name="keywords"
            content="UAE e-invoicing, e-invoicing UAE 2026, DGFiP, Plateforme Agréée, PA France, PDP, Chorus Pro, Y-model, e-reporting France, French VAT compliance, ClearTax France"
        />
        <link
            rel="shortcut icon"
            type="image/png"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="256x256"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
        />
        <link
            rel="apple-touch-icon"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <!-- Preload critical above-the-fold assets -->
        <link
            rel="preload"
            href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
            as="image"
            type="image/svg+xml"
            fetchpriority="high"
        />

         <!-- 1. Usercentrics CMP — loads immediately, before anything else -->
        <script is:inline>
        (function () {
            var blockScript = document.createElement("script");
            blockScript.src = "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
            document.head.appendChild(blockScript);

            var cmpScript = document.createElement("script");
            cmpScript.id = "usercentrics-cmp";
            cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
            cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
            cmpScript.async = true;
            document.head.appendChild(cmpScript);
        })();
        </script>

        <!-- 2. GTM — loads only after the visitor responds to the consent banner -->
        <script is:inline>
        (function () {
            function loadGTM() {
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
                var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s),
                dl = l != "dataLayer" ? "&l=" + l : "";
                j.async = true;
                j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");
            }

            window.addEventListener("UC_UI_CMP_EVENT", function (event) {
            if (
                event.detail &&
                ["ACCEPT_ALL", "DENY_ALL", "SAVE"].indexOf(event.detail.type) !== -1
            ) {
                loadGTM();
            }
            });
        })();
        </script>
        <link rel="preconnect" href="https://js-na2.hsforms.net" />
        <link rel="preconnect" href="https://forms.hsforms.com" />
        <link rel="preconnect" href="https://forms-na2.hsforms.com" />
        <script is:inline src="https://js-na2.hsforms.net/forms/embed/v2.js"
        ></script>
    </head>
    <body class="bg-white">
        <!-- Google Tag Manager (noscript). Does not ship in any embed — it belongs
         in Webflow's page custom code. -->
        <noscript
            ><iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
                height="0"
                width="0"
                style="display:none;visibility:hidden"></iframe></noscript
        >
        <Navbar />
        <Hero />
        <Logos />
        <ASP />
        <Integration />
        <ResourceCenter />
        <Network />
        <Testimonial />
        <CTA />
        <Faq />
        <Footer />
        <!-- Renders nothing visible: the "Book a demo" dialog every CTA above
         opens. Last so its markup can't affect the flow above it. -->
        <DemoModal />
    </body>
</html>
