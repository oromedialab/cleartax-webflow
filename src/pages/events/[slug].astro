---
/**
 * Event / webinar detail — one page per entry in `src/data/events.ts`.
 * Figma node 14851:46962 ("Events / Webinar — Content page").
 *
 * THE SIBLING OF `blog-listing/[slug].astro`, AND BUILT THE SAME WAY.
 * NO CLASSES IN THE MARKUP except three region hooks — `ct-event`,
 * `ct-event-speakers`, `ct-event-related` — plus `container`, which carries
 * page width so the 1328px identity stays defined once in theme.css.
 * Everything else is styled by tag from `src/styles/event-detail.css`.
 *
 * That is deliberate. In Webflow an event is a CMS collection item whose
 * description and agenda are Rich Text fields, and a Rich Text field emits
 * classless `<h2>`/`<p>`/`<ul>`. Only element selectors can reach those, so an
 * editor can add a webinar and have it come out designed without touching a
 * single class.
 *
 * THE STRUCTURE IS THE API. The stylesheet reads this DOM shape:
 *
 *   .ct-event > header    breadcrumb, badges, h1, speakers, date/time/place
 *   .ct-event > aside     the registration card — thumbnail, CTA, share row
 *   .ct-event > article   the description and agenda — the WYSIWYG zone
 *
 * Three grid children, not two: splitting the copy into <header> and <article>
 * is what lets the <aside> land BETWEEN them on mobile — title, then the card
 * you register from, then the detail — while sitting beside both on desktop.
 * Reordering or nesting these will silently unstyle things.
 *
 * Navbar and Footer are the listing page's own wrappers, imported rather than
 * copied. This route lives *inside* /events/, so the two pages are one family
 * and their chrome should never drift; `discoverSharedSources` follows the
 * relative import chain (page -> events/Navbar -> _shared/NavbarRb), so both
 * primitives still get their `@source` line and their utilities.
 */
import '../../styles/shared.css';
import '../../styles/.build/event-detail.css';

import Navbar from '../../sections/events/Navbar.astro';
import Footer from '../../sections/events/Footer.astro';
import {
  allEvents,
  upcomingEvents,
  eventPath,
  isUpcoming,
  resolveSpeakers,
} from '../../data/events';
import type { EventItem } from '../../data/events';

export function getStaticPaths() {
  return allEvents.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

interface Props {
  event: EventItem;
}

const { event } = Astro.props;

const upcoming = isUpcoming(event);
const speakers = resolveSpeakers(event);

/* A carousel only earns its keep — and its 150 KB of CDN JavaScript — when
   there is more than one speaker to move between. One speaker renders as a
   plain block with no Swiper classes, no nav buttons and no library request. */
const useSwiper = speakers.length > 1;

/* Initials stand in for a missing avatar, the same way the placeholder tint
   stands in for a missing thumbnail on the listing cards. */
function initialsOf(name: string): string {
  return name
    .split(' ')
    .map((part) => part.charAt(0))
    .join('')
    .slice(0, 2)
    .toUpperCase();
}

/* Six other upcoming sessions, wrapping round the end so the last event still
   gets a full grid instead of a short row. `filter` first, so an event never
   appears in its own "up next" rail. */
const pool = upcomingEvents.filter((e) => e.slug !== event.slug);
const related = pool.length
  ? Array.from({ length: Math.min(6, pool.length) }, (_, i) => pool[i % pool.length])
  : [];

/* The canonical URL the share links point at. Webflow serves this collection
   under /resources/events/, which is NOT the dev route (`/events/<slug>`) —
   the two differ on purpose and only this constant knows about it. */
const shareUrl = `https://www.cleartax.com/resources/events/${event.slug}`;
const encodedUrl = encodeURIComponent(shareUrl);
const encodedTitle = encodeURIComponent(event.title);

const shareLinks = [
  { label: 'WhatsApp', icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab249b08dadf09d6cf24ccf_whatsapp-icon.png', href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}` },
  { label: 'Facebook', icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab249b09a873b15d2a4dfef_facebook-icon.png', href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
  { label: 'X', icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab249b02ed6fb96143a0f85_x-icon.png', href: `https://x.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}` },
  { label: 'LinkedIn', icon: 'https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab249b196c5fb62e0af7c11_linkedin-icon.png', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
];

/* ONE LABEL, ALWAYS. A past session keeps the same button and renders it
   disabled — registration has closed — rather than swapping in different copy.
   The recording is reached from the play control drawn over the thumbnail
   instead, which is the only affordance that changes between the two states. */
const ctaLabel = 'Register now';
---

