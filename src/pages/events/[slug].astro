          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2.4375C10.1087 2.4375 8.25992 2.99833 6.68736 4.04908C5.11482 5.09981 3.88917 6.59327 3.16541 8.34059C2.44164 10.0879 2.25227 12.0106 2.62125 13.8655C2.99022 15.7205 3.90096 17.4244 5.2383 18.7618C6.57564 20.099 8.27951 21.0098 10.1345 21.3787C11.9894 21.7477 13.9121 21.5584 15.6594 20.8346C17.4067 20.1108 18.9002 18.8852 19.951 17.3126C21.0017 15.74 21.5626 13.8913 21.5626 12C21.5596 9.46478 20.5511 7.03426 18.7584 5.24158C16.9657 3.44891 14.5352 2.44048 12 2.4375ZM6.6975 18.5626C7.24762 17.6478 8.02503 16.8908 8.95418 16.3655C9.88331 15.84 10.9326 15.5639 12 15.5639C13.0674 15.5639 14.1167 15.84 15.0458 16.3655C15.975 16.8908 16.7524 17.6478 17.3026 18.5626C15.8028 19.7785 13.9308 20.4422 12 20.4422C10.0693 20.4422 8.19717 19.7785 6.6975 18.5626ZM8.8125 11.25C8.8125 10.6196 8.99945 10.0033 9.3497 9.47912C9.69994 8.95494 10.1978 8.54639 10.7802 8.30514C11.3626 8.06388 12.0036 8.00076 12.6218 8.12375C13.2402 8.24674 13.8082 8.55031 14.254 8.9961C14.6996 9.44188 15.0032 10.0098 15.1262 10.6281C15.2492 11.2465 15.1861 11.8874 14.9449 12.4698C14.7036 13.0523 14.2951 13.55 13.7708 13.9003C13.2467 14.2506 12.6305 14.4374 12 14.4374C11.1546 14.4374 10.3439 14.1017 9.7461 13.504C9.14834 12.9061 8.8125 12.0954 8.8125 11.25ZM18.1416 17.7787C17.2578 16.4045 15.9367 15.3682 14.3916 14.8369C15.162 14.3237 15.7469 13.5762 16.0597 12.705C16.3726 11.8337 16.3967 10.8849 16.1287 9.99882C15.8606 9.11276 15.3145 8.33648 14.5711 7.78476C13.8278 7.23304 12.9266 6.93515 12.001 6.93515C11.0752 6.93515 10.1741 7.23304 9.43072 7.78476C8.68737 8.33648 8.1413 9.11276 7.87322 9.99882C7.60515 10.8849 7.62932 11.8337 7.94214 12.705C8.25497 13.5762 8.83985 14.3237 9.61032 14.8369C8.06519 15.3682 6.74414 16.4045 5.86032 17.7787C4.73048 16.5798 3.97635 15.0762 3.69099 13.4537C3.40563 11.8311 3.60152 10.1605 4.25448 8.64799C4.90745 7.13546 5.98894 5.84718 7.36551 4.94209C8.74206 4.037 10.3535 3.5547 12.001 3.5547C13.6484 3.5547 15.2598 4.037 16.6364 4.94209C18.013 5.84718 19.0944 7.13546 19.7474 8.64799C20.4004 10.1605 20.5963 11.8311 20.311 13.4537C20.0256 15.0762 19.2714 16.5798 18.1416 17.7787Z" fill="#05022A"/>
          </svg>
          {event.speakers.map((speaker) => <span>{speaker}</span>)}
        </p>

        <p>
          <time datetime={event.datetime}>
            <svg aria-hidden="true" focusable="false"><use href="#ct-evd-calendar"></use></svg>
            {event.date}
          </time>
          <span></span>
          <span>
            <svg aria-hidden="true" focusable="false"><use href="#ct-evd-clock"></use></svg>
            {event.time}
          </span>
          <span></span>
          <span>
            <svg aria-hidden="true" focusable="false"><use href="#ct-evd-pin"></use></svg>
            {event.location}
          </span>
        </p>

        <hr />
      </header>

      {
        /* An empty <figure> renders the Figma "Visual Placeholder" tint at
           16:9 — the stylesheet handles it. Set `event.image` to a Webflow
           asset URL to fill it; never a `data:` URI, that alone can blow the
           50 KB Embed budget. */
      }
      <aside>
        <figure>
          {event.image && <img src={event.image} alt={event.title} width="1280" height="720" />}
          {
            /* Play control, past sessions only. The event is over, so the
               thumbnail IS the action — this is what `event.href` points at
               once the button beside it has gone dead. */
            !upcoming && (
              <a
                href={event.href}
                target="_blank"
                rel="noopener"
                aria-label={`Play the recording of ${event.title}`}
              >
                <img
                  src="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ab246685e37e413aa90378a_play-button.png"
                  alt=""
                  width="72"
                  height="72"
                  loading="lazy"
                />
              </a>
            )
          }
        </figure>

        {
          /* A real <button disabled>, not a link styled to look dead. Only the
             disabled attribute takes the element out of the tab order and has
             a screen reader announce it as unavailable; `pointer-events: none`
             on an <a> does neither, and the link would still be followed by
             anyone navigating with a keyboard. */
          upcoming ? (
            <p><a href={event.href} target="_blank" rel="noopener">{ctaLabel}</a></p>
          ) : (
            <p><button type="button" disabled>{ctaLabel}</button></p>
          )
        }

        <hr />

        <p>Share</p>
        <ul>
          {
            shareLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener" aria-label={`Share on ${link.label}`}>
                    <img src={link.icon} alt="icon" />
                </a>
              </li>
            ))
          }
        </ul>
      </aside>

      <article>
        <h2>{upcoming ? 'About the Webinar' : 'About the session'}</h2>
        <p>{event.summary ?? `${event.title}. ${event.date}, ${event.time} — ${event.location}.`}</p>

        {
          event.agenda && event.agenda.length > 0 && (
            <>
              <h2>Things we will discuss</h2>
              <ul>{event.agenda.map((item) => <li>{item}</li>)}</ul>
            </>
          )
        }

      </article>

      {
        /* SPEAKERS ARE A FOURTH GRID CHILD, NOT PART OF <article>.
           They used to live inside it and that was a real bug, not just an
           organisational preference: `.ct-event > article ol` scores (0,1,2)
           while `.ct-event-speakers > ol` scores only (0,1,1) — a child
           combinator adds nothing to specificity — so the agenda list's
           `flex-direction: column` beat the carousel's `row` and every speaker
           stacked vertically no matter what order the rules were written in.
           Out here, the WYSIWYG rules cannot reach this block at all.

           It also belongs out here on the merits: <article> is the Rich Text
           zone, and in Webflow the speakers are a multi-reference field
           rendered by a Collection List, not prose an editor types. That is
           why this is the one region allowed to carry Swiper's classes. */
        speakers.length > 0 && (
          <section class="ct-event-speakers">
            {/* Figma 14851:47046 — the agenda and the speaker block are
                separated by the same 2px rule that closes the header. */}
            <hr />

            {/* <header>, not <p> — the heading row holds an <h2>, and an
                <h2> inside a <p> is parse-error markup: the browser closes
                the paragraph before it, which would strand the pager outside
                the row it is supposed to sit in. */}
            <header>
              <h2>{useSwiper ? 'About the Speakers' : 'About the Speaker'}</h2>
              {/* Only rendered when there is somewhere to page to — two dead
                  buttons read as a broken control. Swiper binds to these by
                  class and adds `swiper-button-disabled` at either end. */}
              {useSwiper && (
                <span>
                  <button type="button" class="ct-speaker-prev" aria-label="Previous speaker">
                    <svg aria-hidden="true" focusable="false">
                      <use href="#ct-evd-chevron-left" />
                    </svg>
                  </button>
                  <button type="button" class="ct-speaker-next" aria-label="Next speaker">
                    <svg aria-hidden="true" focusable="false">
                      <use href="#ct-evd-chevron-right" />
                    </svg>
                  </button>
                </span>
              )}
            </header>

            {/* Swiper's classes appear ONLY when there is more than one
                speaker. A single speaker is a plain block — no carousel, and
                no reason to pull 150 KB of library down to slide between one
                thing. The DOM shape is identical either way, so the styling
                below is written against the tags, not the classes. */}
            <div class={useSwiper ? 'swiper ct-speaker-swiper' : undefined}>
              <div class={useSwiper ? 'swiper-wrapper' : undefined}>
                {speakers.map((speaker) => (
                  <article class={useSwiper ? 'swiper-slide' : undefined}>
                    <p>{speaker.bio}</p>
                    <div>
                      <address>
                        <span>
                          {speaker.image ? (
                            <img src={speaker.image} alt={speaker.name} width="48" height="48" />
                          ) : (
                            initialsOf(speaker.name)
                          )}
                        </span>
                        <span>
                          <strong>{speaker.name}</strong>
                          <span>{speaker.role}</span>
                        </span>
                      </address>
                      {speaker.profile && (
                        <a href={speaker.profile} target="_blank" rel="noopener">
                          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M1.16721 0H14.8334C15.4778 0.00033738 16 0.522818 16 1.16721V14.8334C15.9997 15.4778 15.4772 16 14.8328 16H1.16721C0.52258 16 0 15.4774 0 14.8328V1.16721C0 0.52258 0.52258 0 1.16721 0ZM2.33321 13.6668H4.66641V5.99985H2.33321V13.6668ZM5.00008 3.49981C5.00008 2.67123 4.32838 1.99954 3.49981 1.99954C2.67123 1.99954 1.99954 2.67123 1.99954 3.49981C1.99954 4.32838 2.67123 5.00008 3.49981 5.00008C4.32838 5.00008 5.00008 4.32838 5.00008 3.49981ZM6.33351 5.99985V13.6668H8.66672V9.9531C8.66672 8.70827 9.12505 7.91689 10.2269 7.91689C11.0213 7.91689 11.333 8.65083 11.333 9.9531V13.6668H13.6668V9.43182C13.6668 7.14628 13.1199 5.89963 10.8148 5.89963C9.61271 5.89963 8.81216 6.46246 8.49989 7.08884V5.99985H6.33351Z" fill="#05022A"/>
                          </svg>
                          View Profile
                        </a>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </section>
        )
      }
    </div>

    {
      /* Swiper from the CDN, loaded next to the markup that needs it rather
         than in <head> — the same arrangement `about-us/Testimonials.astro`
         and `press/Hero.astro` use, and the one that survives being pasted
         into a Webflow Embed, which has no access to the page head.
         Only emitted when a carousel is actually on the page.

         THE INIT SCRIPT LIVES HERE TOO, not at the end of <body>. Everything
         a Webflow Embed needs has to be one contiguous block — down there it
         would be separated from the markup by the footer, and whoever pastes
         this would have to know to go and fetch it. */
      useSwiper && (
        <>
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
          <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
          <script is:inline>
            {/* One slide at a time, drag or buttons. `autoHeight` because the
                bios differ in length by several lines and a fixed track height
                would either clip the longest or leave a gap under the shortest.
                Guarded on `typeof Swiper` and on a ready flag: the CDN script is
                a separate request that may not have landed yet, and in a Webflow
                Embed this whole block can be evaluated more than once. */}
            (function () {
              function initSpeakers() {
                if (typeof Swiper === 'undefined') return;
                var root = document.querySelector('.ct-speaker-swiper');
                if (!root || root.dataset.swiperReady) return;
                root.dataset.swiperReady = 'true';

                new Swiper('.ct-speaker-swiper', {
                  slidesPerView: 1,
                  spaceBetween: 24,
                  autoHeight: true,
                  grabCursor: true,
                  navigation: { prevEl: '.ct-speaker-prev', nextEl: '.ct-speaker-next' },
                  keyboard: { enabled: true },
                });
              }

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initSpeakers);
              } else {
                initSpeakers();
              }
            })();
          </script>
        </>
      )
    }

    {
      related.length > 0 && (
        <section class="container ct-event-related">
          <h2>Upcoming Events &amp; Webinars</h2>
          <p>Learn from the people building compliance every day.</p>
          <ul>
            {related.map((item) => (
              <li>
                <a href={eventPath(item.slug)}>
                  <figure>
                    {item.image && (
                      <img src={item.image} alt={item.title} width="1280" height="720" loading="lazy" />
                    )}
                    <span>
                      <svg aria-hidden="true" focusable="false">
                        <use href={item.type === 'Online' ? '#ct-evd-globe' : '#ct-evd-user'} />
                      </svg>
                      {item.type}
                    </span>
                    <span>
                      <svg aria-hidden="true" focusable="false">
                        <use href="#ct-evd-arrow" />
                      </svg>
                    </span>
                    <span>{item.speakers[0]}</span>
                  </figure>
                  <h3>{item.title}</h3>
                  <p>
                    <time datetime={item.datetime}>
                      <svg aria-hidden="true" focusable="false">
                        <use href="#ct-evd-calendar" />
                      </svg>
                      {item.date}
                    </time>
                    <span />
                    <span>
                      <svg aria-hidden="true" focusable="false">
                        <use href="#ct-evd-clock" />
                      </svg>
                      {item.time}
                    </span>
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <Footer />
  </body>
</html>
