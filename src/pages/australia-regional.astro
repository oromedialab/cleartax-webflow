---
/**
 * Australia regional page (cleartax.com/au) — brand v2.
 *
 * Head plumbing (fonts, favicons, deferred GTM/Usercentrics loader, HubSpot)
 * mirrors `france-regional.astro` / `oman-regional.astro` so every v2 regional
 * page behaves the same in Webflow. No fonts.css import — that bundle
 * self-hosts the v1 faces; brand v2 loads Inter Tight + Google Sans from
 * Google Fonts via the <link> below.
 *
 * Navbar, Footer, DemoModal, SocialProof and Testimonials are byte-identical
 * copies of the France/Oman regional sections — the global nav/footer/demo
 * modal are shared across every brand v2 page, and a page's CSS entry only
 * sources its own section folder, so importing across folders would compile
 * none of their utilities into this bundle.
 *
 * Hero, Glance, Supports, Assurance, Resources, Faq and Cta are this page's
 * own. The Figma has no "Seamless" (integrations/compliance accordion) section
 * unlike the France/Oman/UAE pages — it is intentionally not ported here.
 */
import "../styles/shared.css";
import "../styles/.build/australia-regional.css";

import Navbar from "../sections/australia-regional/Navbar.astro";
import Hero from "../sections/australia-regional/Hero.astro";
import Glance from "../sections/australia-regional/Glance.astro";
import Supports from "../sections/australia-regional/Supports.astro";
import SocialProof from "../sections/australia-regional/SocialProof.astro";
import Seamless from "../sections/australia-regional/Seamless.astro";
import Faq from "../sections/australia-regional/Faq.astro";
import Cta from "../sections/australia-regional/Cta.astro";
import Timelines from "../sections/australia-regional/Timelines.astro";
import Resource from "../sections/australia-regional/Resource.astro";
import Footer from "../sections/australia-regional/Footer.astro";
import Platform from "../sections/australia-regional/Platform.astro";
import DemoModal from "../sections/australia-regional/DemoModal.astro";
import Testimonial from "../sections/australia-regional/Testimonial.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>ClearTax Australia — Get Ready for E-Invoicing</title>
        <meta
            name="description"
            content="ClearTax's enterprise e-invoicing platform helps businesses in Australia comply with E-Invoicing, the Crea y Crece B2B mandate, VERI*FACTU, Facturae and TicketBAI — on one AI-powered, ERP-integrated system."
        />
        <meta
            name="keywords"
            content="Australia e-invoicing, SII, Crea y Crece, VERI*FACTU, RRSIF, Facturae, FACe, TicketBAI, Batuz, e-invoicing software Australia, ClearTax Australia"
        />
        <link
            rel="shortcut icon"
            type="image/png"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="256x256"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
        />
        <link
            rel="apple-touch-icon"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Inter+Tight:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <!-- Preload critical above-the-fold assets -->
        <link
            rel="preload"
            href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
            as="image"
            type="image/svg+xml"
            fetchpriority="high"
        />

        <!-- 1. Usercentrics CMP — loads immediately, before anything else -->
        <script is:inline>
            (function () {
                var blockScript = document.createElement("script");
                blockScript.src =
                    "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
                document.head.appendChild(blockScript);

                var cmpScript = document.createElement("script");
                cmpScript.id = "usercentrics-cmp";
                cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
                cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
                cmpScript.async = true;
                document.head.appendChild(cmpScript);
            })();
        </script>

        <!-- 2. GTM — loads only after the visitor responds to the consent banner -->
        <script is:inline>
            (function () {
                function loadGTM() {
                    (function (w, d, s, l, i) {
                        w[l] = w[l] || [];
                        w[l].push({
                            "gtm.start": new Date().getTime(),
                            event: "gtm.js",
                        });
                        var f = d.getElementsByTagName(s)[0],
                            j = d.createElement(s),
                            dl = l != "dataLayer" ? "&l=" + l : "";
                        j.async = true;
                        j.src =
                            "https://www.googletagmanager.com/gtm.js?id=" +
                            i +
                            dl;
                        f.parentNode.insertBefore(j, f);
                    })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");
                }

                window.addEventListener("UC_UI_CMP_EVENT", function (event) {
                    if (
                        event.detail &&
                        ["ACCEPT_ALL", "DENY_ALL", "SAVE"].indexOf(
                            event.detail.type,
                        ) !== -1
                    ) {
                        loadGTM();
                    }
                });
            })();
        </script>

        <link rel="preconnect" href="https://js-na2.hsforms.net" />
        <link rel="preconnect" href="https://forms.hsforms.com" />
        <script
            is:inline
            defer
            src="https://js-na2.hsforms.net/forms/embed/v2.js"></script>
    </head>
    <body class="bg-generic-00">
        <!-- Google Tag Manager (noscript). Does not ship in any embed — it belongs
         in Webflow's page custom code. -->
        <noscript
            ><iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
                height="0"
                width="0"
                style="display:none;visibility:hidden"></iframe></noscript
        >
        <Navbar />
        <Hero />
        <SocialProof />
        <Supports />
        <Timelines />
        <Glance />
        <Platform />
        <Seamless />
        <Resource />
        <Testimonial />
        <Faq />
        <Cta />
        <Footer />
        <!-- Renders nothing visible: the "Book a demo" dialog every CTA above
         opens. Last so its markup can't affect the flow above it. -->
        <DemoModal />
    </body>
</html>
