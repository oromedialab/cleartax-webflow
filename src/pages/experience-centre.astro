---
/**
 * Experience Centre — brand v2. Figma node 15070:52961
 * ("Experience Centre - {{insert link}}").
 *
 * The Figma frame is a TEMPLATE: one tool page out of the six listed in its
 * sidebar. This build instantiates it as the KSA VAT Calculator, which is the
 * content the mock carries end to end (intro, "What is VAT?", the two
 * calculation methods, the worked example, the benefits list, the six FAQs).
 *
 * Head plumbing (favicons, font links, deferred GTM/Usercentrics loader,
 * HubSpot embed) is the same block every v2 page carries, copied from
 * src/pages/trust-centre.astro. Navbar and Footer are thin wrappers over the
 * `_shared` *Rb primitives; `Experience.astro` owns everything between them.
 *
 * No fonts.css import — that bundle self-hosts the v1 faces. Brand v2 loads
 * Inter Tight + Google Sans from Google Fonts via the <link> in the head.
 */
import "../styles/shared.css";
import "../styles/.build/experience-centre.css";

import Navbar from "../sections/experience-centre/Navbar.astro";
import Experience from "../sections/experience-centre/Experience.astro";
import Footer from "../sections/experience-centre/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClearTax — VAT Calculator Saudi Arabia | Experience Centre</title>
    <meta
      name="description"
      content="Calculate VAT in Saudi Arabia instantly. Add VAT to an exclusive price or extract it from a VAT-inclusive amount at the 15% KSA rate — with the formulas, a worked example and answers to the questions finance teams ask."
    />
    <meta
      name="keywords"
      content="VAT calculator, KSA VAT calculator, Saudi Arabia VAT, VAT inclusive calculator, VAT exclusive calculator, 15% VAT Saudi Arabia, cleartax experience centre, tax calculators"
    />
    <meta content="noindex, nofollow" name="robots" />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Preload critical above-the-fold assets -->
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />

     <!-- 1. Usercentrics CMP — loads immediately, before anything else -->
    <script is:inline>
      (function () {
        var blockScript = document.createElement("script");
        blockScript.src = "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
        document.head.appendChild(blockScript);

        var cmpScript = document.createElement("script");
        cmpScript.id = "usercentrics-cmp";
        cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
        cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
        cmpScript.async = true;
        document.head.appendChild(cmpScript);
      })();
    </script>

    <!-- 2. GTM — loads only after the visitor responds to the consent banner -->
    <script is:inline>
      (function () {
        function loadGTM() {
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");
        }

        window.addEventListener("UC_UI_CMP_EVENT", function (event) {
          if (
            event.detail &&
            ["ACCEPT_ALL", "DENY_ALL", "SAVE"].indexOf(event.detail.type) !== -1
          ) {
            loadGTM();
          }
        });
      })();
    </script>
    <!-- Preconnect to HubSpot CDNs -->
    <link rel="preconnect" href="https://js-na2.hsforms.net" />
    <link rel="preconnect" href="https://forms.hsforms.com" />
    <link rel="preconnect" href="https://forms-na2.hsforms.com" />

    <!-- HubSpot Embed Script -->
    <script is:inline src="https://js-na2.hsforms.net/forms/embed/v2.js"
    ></script>
  </head>
  <body class="bg-generic-00">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <Navbar />
    <Experience />
    <Footer />
  </body>
</html>
