---
/**
 * Indirect Tax Page — brand v2.
 *
 * Scaffolding follows docs/adding-a-new-page.md and references
 * src/pages/direct-tax-page.astro. Section components live in
 * src/sections/indirect-tax-page/.
 *
 * No fonts.css import — that bundle self-hosts the v1 faces. Brand v2 loads
 * Inter Tight + Google Sans from Google Fonts via the <link> in the head.
 */
import "../styles/shared.css";
import "../styles/.build/indirect-tax-page.css";

import Navbar from "../sections/indirect-tax-page/Navbar.astro";
import Hero from "../sections/indirect-tax-page/Hero.astro";
import Footer from "../sections/indirect-tax-page/Footer.astro";
import Walkthrough from "../sections/indirect-tax-page/Walkthrough.astro";
import Filing from "../sections/indirect-tax-page/Filing.astro";
import Streamstack from "../sections/indirect-tax-page/Stream-stack.astro";
import Cta from "../sections/indirect-tax-page/Cta.astro";
import Capability from "../sections/indirect-tax-page/Capability.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClearTax — Indirect Tax Page</title>
    <meta
      name="description"
      content="Simplify GST compliance with ClearTax’s Indirect Tax Page. Automate GSTR filing, 100% 2B ITC reconciliation, instant e-invoicing & e-way bill generation, and streamline multi-GSTIN operations."
    />
    <meta
      name="keywords"
      content="indirect tax page, GST compliance solution, GSTR-1 filing, GSTR-3B filing, 2B reconciliation, ITC matching, e-invoicing software, e-way bill solution, multi-GSTIN management, cleartax gst"
    />
    <meta content="noindex, nofollow" name="robots" />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Preload critical above-the-fold assets -->
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="https://img.youtube.com/vi/UX0Yt61EdfY/maxresdefault.jpg"
      as="image"
      type="image/jpeg"
      fetchpriority="high"
    />

    <!-- Deferred script loader for performance -->
    <script is:inline>
      (function () {
        let scriptsLoaded = false;
        function loadHeavyScripts() {
          if (scriptsLoaded) return;
          scriptsLoaded = true;

          // Remove event listeners
          triggerEvents.forEach((e) =>
            window.removeEventListener(e, loadHeavyScripts, { passive: true }),
          );

          // Load Google Tag Manager
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");

          // Load Usercentrics autoblocker
          var blockScript = document.createElement("script");
          blockScript.src =
            "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
          document.head.appendChild(blockScript);

          // Load Usercentrics loader
          var cmpScript = document.createElement("script");
          cmpScript.id = "usercentrics-cmp";
          cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
          cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
          cmpScript.async = true;
          document.head.appendChild(cmpScript);
        }

        const triggerEvents = [
          "mouseover",
          "mouseenter",
          "mousemove",
          "touchstart",
          "scroll",
          "keydown",
        ];
        triggerEvents.forEach((e) =>
          window.addEventListener(e, loadHeavyScripts, { passive: true }),
        );

        // Safety timeout to ensure scripts load even without interaction (e.g. for crawlers)
        setTimeout(loadHeavyScripts, 4000);

        // Clean URL hash on anchor link clicks & initial landing
        const setupHashCleaner = () => {
          try {
            document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
              anchor.addEventListener("click", function (e) {
                const targetId = this.getAttribute("href");
                if (targetId === "#") return;
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                  e.preventDefault();
                  targetElement.scrollIntoView({ behavior: "smooth" });
                  history.pushState(
                    null,
                    document.title,
                    window.location.pathname + window.location.search,
                  );
                }
              });
            });

            if (window.location.hash) {
              setTimeout(() => {
                history.replaceState(
                  null,
                  document.title,
                  window.location.pathname + window.location.search,
                );
              }, 1000);
            }
          } catch (e) {
            console.error("Anchor hash handler failed", e);
          }
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", setupHashCleaner);
        } else {
          setupHashCleaner();
        }
      })();
    </script>
    <!-- Preconnect to HubSpot CDNs -->
    <link rel="preconnect" href="https://js-na2.hsforms.net" />
    <link rel="preconnect" href="https://forms.hsforms.com" />
    <link rel="preconnect" href="https://forms-na2.hsforms.com" />

    <!-- HubSpot Embed Script -->
    <script is:inline src="https://js-na2.hsforms.net/forms/embed/v2.js"
    ></script>
  </head>
  <body class="bg-generic-00">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <Navbar />
    <Hero />
    <Walkthrough />
    <Streamstack />
    <Filing />
    <Capability />
    <Cta />
    <Footer />
  </body>
</html>
