---
/**
 * India homepage — brand v2. Figma node 13275:26864.
 *
 * Head plumbing (fonts, favicons, deferred GTM/Usercentrics loader, HubSpot)
 * mirrors src/pages/global-homepage.astro so the v2 pages behave the same in
 * Webflow. No fonts.css import — that bundle self-hosts the v1 faces; brand v2
 * loads Inter Tight + Google Sans from Google Fonts via the <link> below.
 *
 * Hero, SocialProof, ClarityAi, Seamless, Cta, Footer, Navbar and DemoModal are
 * copies of the Global homepage sections — the two designs share them, and a
 * page's CSS entry only sources its own section folder, so importing across
 * folders would compile none of their utilities into this bundle. The India
 * page owns MakingAiWork, DataLayer and Outputs.
 */
import "../styles/shared.css";
import "../styles/.build/india-homepage.css";

import Navbar from "../sections/india-homepage/Navbar.astro";
import Hero from "../sections/india-homepage/Hero.astro";
import SocialProof from "../sections/india-homepage/SocialProof.astro";
import MakingAiWork from "../sections/india-homepage/MakingAiWork.astro";
import ClarityAi from "../sections/india-homepage/ClarityAi.astro";
import DataLayer from "../sections/india-homepage/DataLayer.astro";
import Outputs from "../sections/india-homepage/Outputs.astro";
import Seamless from "../sections/india-homepage/Seamless.astro";
import Cta from "../sections/india-homepage/Cta.astro";
import Footer from "../sections/india-homepage/Footer.astro";
import DemoModal from "../sections/india-homepage/DemoModal.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClearTax India | Enterprise Tax Compliance Platform</title>
    <meta
      name="description"
      content="ClearTax India helps enterprises automate GST, e-invoicing, TDS, e-way bill, ITC reconciliation, vendor compliance, and tax workflows through one unified compliance platform. Trusted by 5,000+ enterprises across India."
    />
    <meta
      name="keywords"
      content="cleartax, cleartax india, cleartax for business, cleartax enterprise, cleartax compliance platform, cleartax gst, cleartax gst software, cleartax e invoice, cleartax e invoicing india, cleartax itc, cleartax e way bill, cleartax tds software, clear compliance cloud, gst compliance​, tax compliance, gst tax compliance​, gst software, e invoice software, e way bill software, input tax credit solution, gst automation software, enterprise gst solution"
    />
    <!-- Served at cleartax.com/home-in only as the source the Global homepage swaps
         in for Indian visitors (docs/region-swap.md). Never indexed or visited. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://www.cleartax.com/" />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Preload critical above-the-fold assets -->
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />

     <!-- 1. Usercentrics CMP — loads immediately, before anything else -->
    <script is:inline>
      (function () {
        var blockScript = document.createElement("script");
        blockScript.src = "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
        document.head.appendChild(blockScript);

        var cmpScript = document.createElement("script");
        cmpScript.id = "usercentrics-cmp";
        cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
        cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
        cmpScript.async = true;
        document.head.appendChild(cmpScript);
      })();
    </script>

    <!-- 2. GTM — loads only after the visitor responds to the consent banner -->
    <script is:inline>
      (function () {
        function loadGTM() {
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");
        }

        window.addEventListener("UC_UI_CMP_EVENT", function (event) {
          if (
            event.detail &&
            ["ACCEPT_ALL", "DENY_ALL", "SAVE"].indexOf(event.detail.type) !== -1
          ) {
            loadGTM();
          }
        });
      })();
    </script>

    <link rel="preconnect" href="https://js-na2.hsforms.net" />
    <link rel="preconnect" href="https://forms.hsforms.com" />
    <link rel="preconnect" href="https://forms-na2.hsforms.com" />
    <script is:inline src="https://js-na2.hsforms.net/forms/embed/v2.js"></script>
  </head>
  <body class="bg-white">
    <!-- Google Tag Manager (noscript). Does not ship in any embed — it belongs
         in Webflow's page custom code. -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <Navbar />
    <Hero />
    <SocialProof />
    <MakingAiWork />
    <ClarityAi />
    <DataLayer />
    <Outputs />
    <Seamless />
    <Cta />
    <Footer />
    <!-- Renders nothing visible: the "Book a demo" dialog every CTA above
         opens. Last so its markup can't affect the flow above it. -->
    <DemoModal />
  </body>
</html>
