---
/**
 * Legal — every ClearTax customer agreement, one jurisdiction per tab. Brand v2.
 *
 * Content is lifted verbatim from the per-country legal pages (India, Malaysia,
 * KSA, Germany, France, Belgium, UAE and the Other Jurisdictions page). The
 * left rail picks the jurisdiction; DocTabs picks MSSA / ISA where a jurisdiction publishes both.
 *
 * The agreement text is GENERATED into the `<Country><Doc><n>.astro` sections
 * (~46 KB each, so every one fits a single Webflow Embed). Layout across
 * embeds is explained at the top of sections/legal/Tabs.astro.
 *
 * Head plumbing (favicons, font links, deferred GTM/Usercentrics loader) is the
 * block every v2 page carries, copied from src/pages/trust-centre.astro. No
 * fonts.css import — Brand v2 loads Inter Tight + Google Sans from Google Fonts.
 */
import "../styles/shared.css";
import "../styles/.build/legal.css";

import Navbar from "../sections/legal/Navbar.astro";
import Tabs from "../sections/legal/Tabs.astro";
import DocTabs from "../sections/legal/DocTabs.astro";
import InMssa1 from "../sections/legal/InMssa1.astro";
import InMssa2 from "../sections/legal/InMssa2.astro";
import InIsa1 from "../sections/legal/InIsa1.astro";
import InIsa2 from "../sections/legal/InIsa2.astro";
import MyMssa1 from "../sections/legal/MyMssa1.astro";
import MyMssa2 from "../sections/legal/MyMssa2.astro";
import KsaMssa1 from "../sections/legal/KsaMssa1.astro";
import KsaMssa2 from "../sections/legal/KsaMssa2.astro";
import DeMssa1 from "../sections/legal/DeMssa1.astro";
import DeMssa2 from "../sections/legal/DeMssa2.astro";
import FrMssa1 from "../sections/legal/FrMssa1.astro";
import FrMssa2 from "../sections/legal/FrMssa2.astro";
import BeMssa1 from "../sections/legal/BeMssa1.astro";
import BeMssa2 from "../sections/legal/BeMssa2.astro";
import AeMssa1 from "../sections/legal/AeMssa1.astro";
import AeMssa2 from "../sections/legal/AeMssa2.astro";
import OtherMssa1 from "../sections/legal/OtherMssa1.astro";
import OtherIsa1 from "../sections/legal/OtherIsa1.astro";
import OtherIsa2 from "../sections/legal/OtherIsa2.astro";
import Footer from "../sections/legal/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClearTax — Legal | MSSA &amp; ISA Agreements by Jurisdiction</title>
    <meta
      name="description"
      content="ClearTax legal agreements by jurisdiction: the Master Subscription and Services Agreement and Integration Services Agreement for India, Malaysia, KSA, Germany, France, Belgium, UAE and other jurisdictions."
    />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Preload critical above-the-fold assets -->
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />

   <!-- 1. Usercentrics CMP — loads immediately, before anything else -->
    <script is:inline>
      (function () {
        var blockScript = document.createElement("script");
        blockScript.src = "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
        document.head.appendChild(blockScript);

        var cmpScript = document.createElement("script");
        cmpScript.id = "usercentrics-cmp";
        cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
        cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
        cmpScript.async = true;
        document.head.appendChild(cmpScript);
      })();
    </script>

    <!-- 2. GTM — loads only after the visitor responds to the consent banner -->
    <script is:inline>
      (function () {
        function loadGTM() {
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");
        }

        window.addEventListener("UC_UI_CMP_EVENT", function (event) {
          if (
            event.detail &&
            ["ACCEPT_ALL", "DENY_ALL", "SAVE"].indexOf(event.detail.type) !== -1
          ) {
            loadGTM();
          }
        });
      })();
    </script>
  </head>
  <body class="bg-generic-00">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <Navbar />
    <Tabs />
    <DocTabs />
    <InMssa1 />
    <InMssa2 />
    <InIsa1 />
    <InIsa2 />
    <MyMssa1 />
    <MyMssa2 />
    <KsaMssa1 />
    <KsaMssa2 />
    <DeMssa1 />
    <DeMssa2 />
    <FrMssa1 />
    <FrMssa2 />
    <BeMssa1 />
    <BeMssa2 />
    <AeMssa1 />
    <AeMssa2 />
    <OtherMssa1 />
    <OtherIsa1 />
    <OtherIsa2 />
    <Footer />
  </body>
</html>
