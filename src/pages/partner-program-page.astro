---
/**
 * Indirect Tax Page — brand v2.
 *
 * Scaffolding follows docs/adding-a-new-page.md and references
 * src/pages/direct-tax-page.astro. Section components live in
 * src/sections/indirect-tax-page/.
 *
 * No fonts.css import — that bundle self-hosts the v1 faces. Brand v2 loads
 * Inter Tight + Google Sans from Google Fonts via the <link> in the head.
 */
import "../styles/shared.css";
import "../styles/.build/partner-program-page.css";

import Navbar from "../sections/partner-program-page/Navbar.astro";
import Hero from "../sections/partner-program-page/Hero.astro";
import Walkthrough from "../sections/partner-program-page/Walkthrough.astro";
import Streamstack from "../sections/partner-program-page/Stream-stack.astro";
import Cta from "../sections/partner-program-page/Cta.astro";
import Footer from "../sections/partner-program-page/Footer.astro";
import Partner from "../sections/partner-program-page/Partner.astro";
import DemoModal from "../sections/partner-program-page/DemoModal.astro";
import Logostrip from "../sections/partner-program-page/Logostrip.astro";
import PartnerTier from "../sections/partner-program-page/partner-tier.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>ClearTax — Program Tax Page</title>
        <meta
            name="description"
            content="Simplify GST compliance with ClearTax’s partner program page. Automate GSTR filing, 100% 2B ITC reconciliation, instant e-invoicing & e-way bill generation, and streamline multi-GSTIN operations."
        />
        <meta
            name="keywords"
            content="partner program page, GST compliance solution, GSTR-1 filing, GSTR-3B filing, 2B reconciliation, ITC matching, e-invoicing software, e-way bill solution, multi-GSTIN management, cleartax gst"
        />
        <meta content="index, follow" name="robots" />
        <link
            rel="shortcut icon"
            type="image/png"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="256x256"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
        />
        <link
            rel="apple-touch-icon"
            href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@400;500;600;700&display=swap"
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript>
            <link
                rel="stylesheet"
                href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@400;500;600;700&display=swap"
            />
        </noscript>
        <!-- Preload critical above-the-fold assets -->
        <link
            rel="preload"
            href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
            as="image"
            type="image/svg+xml"
            fetchpriority="high"
        />

        <!-- Deferred script loader for performance -->
        <script is:inline>
            (function () {
                let scriptsLoaded = false;
                function loadHeavyScripts() {
                    if (scriptsLoaded) return;
                    scriptsLoaded = true;

                    // Remove event listeners
                    triggerEvents.forEach((e) =>
                        window.removeEventListener(e, loadHeavyScripts, {
                            passive: true,
                        }),
                    );

                    // Load Google Tag Manager
                    (function (w, d, s, l, i) {
                        w[l] = w[l] || [];
                        w[l].push({
                            "gtm.start": new Date().getTime(),
                            event: "gtm.js",
                        });
                        var f = d.getElementsByTagName(s)[0],
                            j = d.createElement(s),
                            dl = l != "dataLayer" ? "&l=" + l : "";
                        j.async = true;
                        j.src =
                            "https://www.googletagmanager.com/gtm.js?id=" +
                            i +
                            dl;
                        f.parentNode.insertBefore(j, f);
                    })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");

                    // Load Usercentrics autoblocker
                    var blockScript = document.createElement("script");
                    blockScript.src =
                        "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
                    document.head.appendChild(blockScript);

                    // Load Usercentrics loader
                    var cmpScript = document.createElement("script");
                    cmpScript.id = "usercentrics-cmp";
                    cmpScript.src =
                        "https://web.cmp.usercentrics.eu/ui/loader.js";
                    cmpScript.setAttribute(
                        "data-settings-id",
                        "utqqyaEbvbzrTk",
                    );
                    cmpScript.async = true;
                    document.head.appendChild(cmpScript);
                }

                const triggerEvents = [
                    "mouseover",
                    "mouseenter",
                    "mousemove",
                    "touchstart",
                    "scroll",
                    "keydown",
                ];
                triggerEvents.forEach((e) =>
                    window.addEventListener(e, loadHeavyScripts, {
                        passive: true,
                    }),
                );

                // Safety timeout to ensure scripts load even without interaction (e.g. for crawlers)
                setTimeout(loadHeavyScripts, 4000);

                // Clean URL hash on anchor link clicks & initial landing
                const setupHashCleaner = () => {
                    try {
                        document
                            .querySelectorAll('a[href^="#"]')
                            .forEach((anchor) => {
                                anchor.addEventListener("click", function (e) {
                                    const targetId = this.getAttribute("href");
                                    if (targetId === "#") return;
                                    const targetElement =
                                        document.querySelector(targetId);
                                    if (targetElement) {
                                        e.preventDefault();
                                        targetElement.scrollIntoView({
                                            behavior: "smooth",
                                        });
                                        history.pushState(
                                            null,
                                            document.title,
                                            window.location.pathname +
                                                window.location.search,
                                        );
                                    }
                                });
                            });

                        if (window.location.hash) {
                            setTimeout(() => {
                                history.replaceState(
                                    null,
                                    document.title,
                                    window.location.pathname +
                                        window.location.search,
                                );
                            }, 1000);
                        }
                    } catch (e) {
                        console.error("Anchor hash handler failed", e);
                    }
                };

                if (document.readyState === "loading") {
                    document.addEventListener(
                        "DOMContentLoaded",
                        setupHashCleaner,
                    );
                } else {
                    setupHashCleaner();
                }
            })();
        </script>
        <!-- Preconnect to HubSpot CDNs -->
        <link rel="preconnect" href="https://js-na2.hsforms.net" />
        <link rel="preconnect" href="https://forms.hsforms.com" />
        <link rel="preconnect" href="https://forms-na2.hsforms.com" />

        <!-- HubSpot Embed Script -->
        <script
            is:inline
            defer
            src="https://js-na2.hsforms.net/forms/embed/v2.js"></script>
    </head>
    <body class="bg-generic-00">
        <!-- Google Tag Manager (noscript) -->
        <noscript
            ><iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
                height="0"
                width="0"
                style="display:none;visibility:hidden"></iframe></noscript
        >
        <!-- End Google Tag Manager (noscript) -->
        <Navbar />
        <Hero />
        <Walkthrough />
        <Streamstack />
        <Logostrip />
        <Partner />
        <PartnerTier />
        <Cta />
        <DemoModal />
        <Footer />
    </body>
</html>
