---
/**
 * French-language France regional page (cleartax.com/fr) — brand v2. Same template as
 * france-regional.astro; copy from "Regional Pages - Master Doc - Aug 26".
 *
 * Head plumbing (fonts, favicons, deferred GTM/Usercentrics loader, HubSpot)
 * mirrors src/pages/global-homepage.astro so the v2 pages behave the same in
 * Webflow. No fonts.css import — that bundle self-hosts the v1 faces; brand v2
 * loads Inter Tight + Google Sans from Google Fonts via the <link> below.
 *
 * Navbar, SocialProof, Seamless, Cta, Footer and DemoModal are copies of the
 * Global homepage sections — the designs share them, and a page’s CSS entry only
 * sources its own section folder, so importing across folders would compile none
 * of their utilities into this bundle. Testimonials and Faq are thin wrappers on
 * the `_shared` primitives. Hero, Mandate, Supports and Resources are this
 * page’s own.
 */
import "../styles/shared.css";
import "../styles/.build/france-regional-fr.css";

import Navbar from "../sections/france-regional-fr/Navbar.astro";
import Hero from "../sections/france-regional-fr/Hero.astro";
import SocialProof from "../sections/france-regional-fr/SocialProof.astro";
import Mandate from "../sections/france-regional-fr/Mandate.astro";
import Supports from "../sections/france-regional-fr/Supports.astro";
import Seamless from "../sections/france-regional-fr/Seamless.astro";
import Resources from "../sections/france-regional-fr/Resources.astro";
import Testimonials from "../sections/france-regional-fr/Testimonials.astro";
import Faq from "../sections/france-regional-fr/Faq.astro";
import ContactForm from "../sections/france-regional-fr/ContactForm.astro";
import Footer from "../sections/france-regional-fr/Footer.astro";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logiciel de facturation électronique en France | PA certifié DGFiP | ClearTax</title>
    <meta
      name="description"
      content="Meilleur logiciel de facturation électronique en France. La solution de facturation électronique ClearTax, basée sur l'IA et approuvée par la DGFiP, garantit une conformité totale avec la réforme B2B française."
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://www.cleartax.com/fr"/>
    <link rel="alternate" hreflang="fr" href="https://www.cleartax.com/fr" />
    <link rel="alternate" hreflang="en" href="https://www.cleartax.com/fr/en" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Logiciel de facturation électronique en France | PA certifié DGFiP | ClearTax" />
    <meta property="og:description" content="Meilleur logiciel de facturation électronique en France. La solution de facturation électronique ClearTax, basée sur l'IA et approuvée par la DGFiP, garantit une conformité totale avec la réforme B2B française." />
    <meta property="og:url" content="https://www.cleartax.com/fr" />
    <meta property="og:image" content="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad5b71609c44abef3fd9351_imp-1.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Logiciel de facturation électronique en France | PA certifié DGFiP | ClearTax" />
    <meta name="twitter:description" content="Meilleur logiciel de facturation électronique en France. La solution de facturation électronique ClearTax, basée sur l'IA et approuvée par la DGFiP, garantit une conformité totale avec la réforme B2B française." />
    <meta name="twitter:image" content="https://cdn.prod.website-files.com/69fda2cd307dcc6cf810e935/6ad5b71609c44abef3fd9351_imp-1.png" />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@400;500;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <!-- Preload critical above-the-fold assets -->
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />

    <!-- 1. Usercentrics CMP — loads immediately, before anything else -->
    <script is:inline>
      (function () {
        var blockScript = document.createElement("script");
        blockScript.src = "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
        document.head.appendChild(blockScript);

        var cmpScript = document.createElement("script");
        cmpScript.id = "usercentrics-cmp";
        cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
        cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
        cmpScript.async = true;
        document.head.appendChild(cmpScript);
      })();
    </script>

    <!-- 2. GTM — loads only after the visitor responds to the consent banner -->
    <script is:inline>
      (function () {
        function loadGTM() {
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");
        }

        window.addEventListener("UC_UI_CMP_EVENT", function (event) {
          if (
            event.detail &&
            ["ACCEPT_ALL", "DENY_ALL", "SAVE"].indexOf(event.detail.type) !== -1
          ) {
            loadGTM();
          }
        });
      })();
    </script>


    <!-- Preconnect to HubSpot CDNs -->
    <link rel="preconnect" href="https://js-na2.hsforms.net" />
    <link rel="preconnect" href="https://forms.hsforms.com" />
    <link rel="preconnect" href="https://forms-na2.hsforms.com" />

    <!-- HubSpot Embed Script (deferred for CWV / non-blocking) -->
    <script is:inline defer src="https://js-na2.hsforms.net/forms/embed/v2.js"
    ></script>
  </head>
  <body class="bg-generic-00">
    <!-- Google Tag Manager (noscript). Does not ship in any embed — it belongs
         in Webflow's page custom code. -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
        title="Google Tag Manager"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <Navbar />
    <Hero />
    <SocialProof />
    <Mandate />
    <Supports />
    <Seamless />
    <Resources />
    <Testimonials />
    <Faq />
    <ContactForm />
    <Footer />
  </body>
</html>
