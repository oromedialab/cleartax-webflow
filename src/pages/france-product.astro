---
/**
 * France product page (cleartax.com/fr/en/e-invoicing-software) — brand v2.
 * Figma node 16433:45630.
 *
 * Head plumbing (fonts, favicons, deferred GTM/Usercentrics loader, HubSpot)
 * mirrors `france-regional.astro` / `spain-regional.astro` so every v2 page
 * behaves the same in Webflow. No fonts.css import — that bundle self-hosts
 * the v1 faces; brand v2 loads Inter Tight + Google Sans from Google Fonts
 * via the <link> below.
 *
 * Navbar and Footer are byte-identical copies of the France regional
 * sections — the global nav/footer are shared across every brand v2 page,
 * and a page's CSS entry only sources its own section folder, so importing
 * across folders would compile none of their utilities into this bundle.
 * SocialProof and Cta follow the same established v2 pattern
 * (`global-homepage/SocialProof.astro`, `france-regional/Cta.astro`) with
 * this page's own copy. Hero, RegulatoryTimeline, YModel, Platform,
 * ComplianceRisk and EReporting are this page's own, new for this product
 * page's Figma.
 *
 * No `DemoModal.astro`: unlike the other v2 pages, the hero here carries its
 * own inline lead-gen form (`#fp-hero-contact`), so there is no second form to
 * put behind a modal. Every "Book a demo" on the page — the navbar's two and
 * the closing Cta band's — scrolls to that id instead (`NavbarRb`'s
 * `ctaScrollTo` prop and an inline `onclick` on the Cta band respectively).
 */
import "../styles/shared.css";
import "../styles/.build/france-product.css";

import Navbar from "../sections/france-product/Navbar.astro";
import Hero from "../sections/france-product/Hero.astro";
import SocialProof from "../sections/france-product/SocialProof.astro";
import RegulatoryTimeline from "../sections/france-product/RegulatoryTimeline.astro";
import YModel from "../sections/france-product/YModel.astro";
import Platform from "../sections/france-product/Platform.astro";
import ComplianceRisk from "../sections/france-product/ComplianceRisk.astro";
import EReporting from "../sections/france-product/EReporting.astro";
import Cta from "../sections/france-product/Cta.astro";
import Footer from "../sections/france-product/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Best E-Invoicing Software in France | PDP-Compliant E-Invoicing Solution - ClearTax</title>
    <meta
      name="description"
      content="ClearTax is a DGFiP compliant e-Invoicing software for France. Certified PDP solution for sending, receiving and reporting. Supports Factur-X, UBL and CII formats. Live in 4 to 6 weeks."
    />
    <link rel="canonical" href="https://www.cleartax.com/fr/en/e-invoicing-software"/>
    <meta content="index, follow" name="robots" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Best E-Invoicing Software in France | PDP-Compliant E-Invoicing Solution - ClearTax" />
    <meta property="og:description" content="ClearTax is a DGFiP compliant e-Invoicing software for France. Certified PDP solution for sending, receiving and reporting. Supports Factur-X, UBL and CII formats. Live in 4 to 6 weeks." />
    <meta property="og:url" content="https://www.cleartax.com/fr/en/e-invoicing-software" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Best E-Invoicing Software in France | PDP-Compliant E-Invoicing Solution - ClearTax" />
    <meta name="twitter:description" content="ClearTax is a DGFiP compliant e-Invoicing software for France. Certified PDP solution for sending, receiving and reporting. Supports Factur-X, UBL and CII formats. Live in 4 to 6 weeks." />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://www.cleartax.com/#organization",
            "name": "ClearTax",
            "url": "https://www.cleartax.com",
            "logo": "https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
          },
          {
            "@type": "WebPage",
            "@id": "https://www.cleartax.com/fr/en/e-invoicing-software#webpage",
            "url": "https://www.cleartax.com/fr/en/e-invoicing-software",
            "name": "Best E-Invoicing Software in France | PDP-Compliant E-Invoicing Solution - ClearTax",
            "description": "ClearTax is a DGFiP compliant e-Invoicing software for France. Certified PDP solution for sending, receiving and reporting. Supports Factur-X, UBL and CII formats. Live in 4 to 6 weeks."
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://www.cleartax.com"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "France E-Invoicing",
                "item": "https://www.cleartax.com/fr/en/e-invoicing-software"
              }
            ]
          }
        ]
      }
    </script>
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Preload critical above-the-fold assets -->
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />

    <!-- 1. Usercentrics CMP — loads immediately, before anything else -->
    <link rel="preconnect" href="https://web.cmp.usercentrics.eu" />
    <link rel="dns-prefetch" href="https://web.cmp.usercentrics.eu" />
    <script is:inline>
      (function () {
        var blockScript = document.createElement("script");
        blockScript.src = "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
        document.head.appendChild(blockScript);

        var cmpScript = document.createElement("script");
        cmpScript.id = "usercentrics-cmp";
        cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
        cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
        cmpScript.async = true;
        document.head.appendChild(cmpScript);
      })();
    </script>

    <!-- 2. GTM — loads only after the visitor responds to the consent banner -->
    <script is:inline>
      (function () {
        function loadGTM() {
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");
        }

        window.addEventListener("UC_UI_CMP_EVENT", function (event) {
          if (
            event.detail &&
            ["ACCEPT_ALL", "DENY_ALL", "SAVE"].indexOf(event.detail.type) !== -1
          ) {
            loadGTM();
          }
        });
      })();
    </script>

    <link rel="preconnect" href="https://js-na2.hsforms.net" />
    <link rel="preconnect" href="https://forms.hsforms.com" />
    <link rel="preconnect" href="https://forms-na2.hsforms.com" />
    <script is:inline defer src="https://js-na2.hsforms.net/forms/embed/v2.js"></script>
  </head>
  <body class="bg-generic-00">
    <!-- Google Tag Manager (noscript). Does not ship in any embed — it belongs
         in Webflow's page custom code. -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
        title="Google Tag Manager"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <Navbar />
    <Hero />
    <SocialProof />
    <RegulatoryTimeline />
    <YModel />
    <Platform />
    <ComplianceRisk />
    <EReporting />
    <Cta />
    <Footer />
  </body>
</html>
