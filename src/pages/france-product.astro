---
/**
 * France product page (cleartax.com/fr/en/e-invoicing-software) — brand v2.
 * Figma node 16433:45630.
 *
 * Head plumbing (fonts, favicons, deferred GTM/Usercentrics loader, HubSpot)
 * mirrors `france-regional.astro` / `spain-regional.astro` so every v2 page
 * behaves the same in Webflow. No fonts.css import — that bundle self-hosts
 * the v1 faces; brand v2 loads Inter Tight + Google Sans from Google Fonts
 * via the <link> below.
 *
 * Navbar and Footer are byte-identical copies of the France regional
 * sections — the global nav/footer are shared across every brand v2 page,
 * and a page's CSS entry only sources its own section folder, so importing
 * across folders would compile none of their utilities into this bundle.
 * SocialProof and Cta follow the same established v2 pattern
 * (`global-homepage/SocialProof.astro`, `france-regional/Cta.astro`) with
 * this page's own copy. Hero, RegulatoryTimeline, YModel, Platform,
 * ComplianceRisk and EReporting are this page's own, new for this product
 * page's Figma.
 *
 * No `DemoModal.astro`: unlike the other v2 pages, the hero here carries its
 * own inline lead-gen form (`#fp-hero-contact`), so there is no second form to
 * put behind a modal. Every "Book a demo" on the page — the navbar's two and
 * the closing Cta band's — scrolls to that id instead (`NavbarRb`'s
 * `ctaScrollTo` prop and an inline `onclick` on the Cta band respectively).
 */
import "../styles/shared.css";
import "../styles/.build/france-product.css";

import Navbar from "../sections/france-product/Navbar.astro";
import Hero from "../sections/france-product/Hero.astro";
import SocialProof from "../sections/france-product/SocialProof.astro";
import RegulatoryTimeline from "../sections/france-product/RegulatoryTimeline.astro";
import YModel from "../sections/france-product/YModel.astro";
import Platform from "../sections/france-product/Platform.astro";
import ComplianceRisk from "../sections/france-product/ComplianceRisk.astro";
import EReporting from "../sections/france-product/EReporting.astro";
import Cta from "../sections/france-product/Cta.astro";
import Footer from "../sections/france-product/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClearTax France — E-Invoicing Software for DGFiP Compliance</title>
    <meta
      name="description"
      content="Comply with France's 2026 e-invoicing mandate with ClearTax — a DGFiP-certified Plateforme Agréée (PA), Y-model compliant, with AI-powered ERP integration and one unified API covering 40+ country mandates."
    />
    <meta
      name="keywords"
      content="France e-invoicing software, DGFiP, Plateforme Agréée, PA France, PDP, Y-model, e-reporting France, French VAT compliance, ClearTax France"
    />
    <meta content="noindex, nofollow" name="robots" />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Preload critical above-the-fold assets -->
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />

    <!-- Deferred script loader for performance -->
    <script is:inline>
      (function () {
        let scriptsLoaded = false;
        function loadHeavyScripts() {
          if (scriptsLoaded) return;
          scriptsLoaded = true;

          triggerEvents.forEach((e) =>
            window.removeEventListener(e, loadHeavyScripts, { passive: true }),
          );

          // Google Tag Manager
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");

          var blockScript = document.createElement("script");
          blockScript.src =
            "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
          document.head.appendChild(blockScript);

          var cmpScript = document.createElement("script");
          cmpScript.id = "usercentrics-cmp";
          cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
          cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
          cmpScript.async = true;
          document.head.appendChild(cmpScript);
        }

        const triggerEvents = [
          "mouseover",
          "mouseenter",
          "mousemove",
          "touchstart",
          "scroll",
          "keydown",
        ];
        triggerEvents.forEach((e) =>
          window.addEventListener(e, loadHeavyScripts, { passive: true }),
        );

        // Safety timeout so crawlers still get the scripts without interaction.
        setTimeout(loadHeavyScripts, 4000);

        const setupHashCleaner = () => {
          try {
            document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
              anchor.addEventListener("click", function (e) {
                const targetId = this.getAttribute("href");
                if (targetId === "#") return;
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                  e.preventDefault();
                  targetElement.scrollIntoView({ behavior: "smooth" });
                  history.pushState(
                    null,
                    document.title,
                    window.location.pathname + window.location.search,
                  );
                }
              });
            });

            if (window.location.hash) {
              setTimeout(() => {
                history.replaceState(
                  null,
                  document.title,
                  window.location.pathname + window.location.search,
                );
              }, 1000);
            }
          } catch (e) {
            console.error("Anchor hash handler failed", e);
          }
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", setupHashCleaner);
        } else {
          setupHashCleaner();
        }
      })();
    </script>

    <link rel="preconnect" href="https://js-na2.hsforms.net" />
    <link rel="preconnect" href="https://forms.hsforms.com" />
    <link rel="preconnect" href="https://forms-na2.hsforms.com" />
    <script is:inline src="https://js-na2.hsforms.net/forms/embed/v2.js"></script>
  </head>
  <body class="bg-generic-00">
    <!-- Google Tag Manager (noscript). Does not ship in any embed — it belongs
         in Webflow's page custom code. -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <Navbar />
    <Hero />
    <SocialProof />
    <RegulatoryTimeline />
    <YModel />
    <Platform />
    <ComplianceRisk />
    <EReporting />
    <Cta />
    <Footer />
  </body>
</html>
