---
/**
 * Bahrain regional page — brand v2. Figma "Website Revamp v1.0" node 5095:49784.
 *
 * Head plumbing (fonts, favicons, deferred GTM/Usercentrics loader, HubSpot)
 * mirrors `france-regional.astro` / `uae-regional.astro` so every v2 regional
 * page behaves the same in Webflow. No fonts.css import — that bundle
 * self-hosts the v1 faces; brand v2 loads Inter Tight + Google Sans from
 * Google Fonts via the <link> below.
 *
 * Navbar, Footer and DemoModal are byte-identical copies of the France
 * regional sections — the global nav/footer/demo-modal are shared across
 * every brand v2 page, and a page's CSS entry only sources its own section
 * folder, so importing across folders would compile none of their utilities
 * into this bundle. Hero and SocialProof derive from the Oman regional ones;
 * Phases, InvoiceFlows, InvoiceData, ZatcaComparison, Benefits, Checklist,
 * Integration and ContactForm are this page's own; Faq is a wrapper over
 * `_shared/FaqRb.astro`.
 *
 * Section order follows the Figma frame "Bahrain Regional Page"
 * (node 18261:62933, Fold 3 → 11 → 13 → 16 → 15 → 14 → 8 alt → form → FAQ).
 */
import "../styles/shared.css";
import "../styles/.build/bahrain-regional.css";

import Navbar from "../sections/bahrain-regional/Navbar.astro";
import Hero from "../sections/bahrain-regional/Hero.astro";
import SocialProof from "../sections/bahrain-regional/SocialProof.astro";
import Phases from "../sections/bahrain-regional/Phases.astro";
import InvoiceFlows from "../sections/bahrain-regional/InvoiceFlows.astro";
import InvoiceData from "../sections/bahrain-regional/InvoiceData.astro";
import ZatcaComparison from "../sections/bahrain-regional/ZatcaComparison.astro";
import Benefits from "../sections/bahrain-regional/Benefits.astro";
import Checklist from "../sections/bahrain-regional/Checklist.astro";
import Integration from "../sections/bahrain-regional/Integration.astro";
import ContactForm from "../sections/bahrain-regional/ContactForm.astro";
import Faq from "../sections/bahrain-regional/Faq.astro";
import Footer from "../sections/bahrain-regional/Footer.astro";
import DemoModal from "../sections/bahrain-regional/DemoModal.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClearTax Bahrain — Get Ready for the NBR E-Invoicing Mandate</title>
    <meta
      name="description"
      content="ClearTax generates, validates and clears NBR-compliant Standard (B2B) and Simplified (B2C) e-invoices for VAT-registered businesses in Bahrain."
    />
    <meta
      name="keywords"
      content="Bahrain e-invoicing, NBR e-invoicing mandate, National Bureau for Revenue, e-invoicing software Bahrain, ClearTax Bahrain"
    />
    <link
      rel="shortcut icon"
      type="image/png"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd7162c46439_32by32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="256x256"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link
      rel="apple-touch-icon"
      href="https://cdn.prod.website-files.com/63ede4a3da6dbd6b05c4612f/63ede4a3da6dbd8997c46450_256by256.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Preload critical above-the-fold assets -->
    <link
      rel="preload"
      href="https://cdn.prod.website-files.com/6093bce33d9b4bae841b04e3/69dfcff6071b983201f5f097_logo-cleartax.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />

    <!-- 1. Usercentrics CMP — loads immediately, before anything else -->
        <script is:inline>
        (function () {
            var blockScript = document.createElement("script");
            blockScript.src = "https://web.cmp.usercentrics.eu/modules/autoblocker.js";
            document.head.appendChild(blockScript);

            var cmpScript = document.createElement("script");
            cmpScript.id = "usercentrics-cmp";
            cmpScript.src = "https://web.cmp.usercentrics.eu/ui/loader.js";
            cmpScript.setAttribute("data-settings-id", "utqqyaEbvbzrTk");
            cmpScript.async = true;
            document.head.appendChild(cmpScript);
        })();
        </script>

        <!-- 2. GTM — loads only after the visitor responds to the consent banner -->
        <script is:inline>
        (function () {
            function loadGTM() {
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
                var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s),
                dl = l != "dataLayer" ? "&l=" + l : "";
                j.async = true;
                j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, "script", "dataLayer", "GTM-P5NDQXGH");
            }

            window.addEventListener("UC_UI_CMP_EVENT", function (event) {
            if (
                event.detail &&
                ["ACCEPT_ALL", "DENY_ALL", "SAVE"].indexOf(event.detail.type) !== -1
            ) {
                loadGTM();
            }
            });
        })();
        </script>

    <link rel="preconnect" href="https://js-na2.hsforms.net" />
    <link rel="preconnect" href="https://forms.hsforms.com" />
    <link rel="preconnect" href="https://forms-na2.hsforms.com" />
    <script is:inline src="https://js-na2.hsforms.net/forms/embed/v2.js"
    ></script>
  </head>
  <body class="bg-generic-00">
    <!-- Google Tag Manager (noscript). Does not ship in any embed — it belongs
         in Webflow's page custom code. -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P5NDQXGH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <Navbar />
    <Hero />
    <SocialProof />
    <Phases />
    <InvoiceFlows />
    <InvoiceData />
    <ZatcaComparison />
    <Benefits />
    <Checklist />
    <Integration />
    <ContactForm />
    <Faq />
    <Footer />
    <!-- Renders nothing visible: the "Book a demo" dialog every CTA above
         opens. Last so its markup can't affect the flow above it. -->
    <DemoModal />
  </body>
</html>
